<%- include('../partials/header') %>

<section class="bg-brand-softBg/30 border-b border-brand-light/15 py-8 animate-fade-in">
  <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
      <div>
        <span class="text-[10px] font-bold uppercase tracking-widest text-brand-gold font-mono block">Painel Administrativo</span>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-brand-dark tracking-tight">Avaliações & Satisfação do Cliente (NPS)</h1>
      </div>
      <div class="flex items-center gap-3">
        <a href="/admin" class="text-xs font-bold bg-white hover:bg-gray-50 text-gray-700 border border-gray-200 px-4 py-2.5 rounded-xl transition-all font-mono flex items-center h-10">
          Voltar ao Painel
        </a>
      </div>
    </div>
  </div>
</section>

<section class="py-12 bg-brand-neutralLight/45 flex-grow">
  <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
    
    <!-- Grid de Métricas de Satisfação -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6">
      
      <!-- Card: Média de Notas -->
      <div class="bg-white p-6 rounded-3xl border border-brand-light/15 shadow-sm space-y-4">
        <span class="text-xs font-bold text-gray-400 font-mono uppercase tracking-wider block">Índice Geral de Satisfação</span>
        <div class="flex items-baseline gap-2">
          <p class="text-5xl font-black text-brand-dark font-mono"><%= stats.averageRating.toFixed(1) %></p>
          <p class="text-sm font-semibold text-gray-400">/ 5.0</p>
        </div>
        <div class="flex items-center space-x-1">
          <% const fullStars = Math.floor(stats.averageRating) %>
          <% for(let i = 1; i <= 5; i++) { %>
            <svg class="w-5 h-5 <%= i <= fullStars ? 'text-amber-400 fill-current' : 'text-gray-200 fill-current' %>" viewBox="0 0 24 24">
              <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
            </svg>
          <% } %>
        </div>
        <p class="text-[11px] text-gray-500 leading-relaxed">Média ponderada baseada em todas as avaliações recebidas.</p>
      </div>

      <!-- Card: Avaliações Promotoras (Google) -->
      <div class="bg-white p-6 rounded-3xl border border-brand-light/15 shadow-sm space-y-4">
        <span class="text-xs font-bold text-[#284701] font-mono uppercase tracking-wider block">Promotores (4-5★)</span>
        <div class="flex items-baseline gap-2">
          <p class="text-5xl font-black text-[#284701] font-mono"><%= stats.promoterCount %></p>
          <p class="text-sm font-semibold text-gray-400">clientes (<%= stats.totalCount ? Math.round((stats.promoterCount / stats.totalCount) * 100) : 0 %>%)</p>
        </div>
        <div class="w-full bg-gray-100 h-2 rounded-full overflow-hidden">
          <div class="bg-[#284701] h-full" style="width: <%= stats.totalCount ? (stats.promoterCount / stats.totalCount) * 100 : 0 %>%"></div>
        </div>
        <p class="text-[11px] text-gray-500 leading-relaxed">Clientes extremamente satisfeitos que foram convidados a avaliar no Google Business.</p>
      </div>

      <!-- Card: Avaliações Críticas (Privadas) -->
      <div class="bg-white p-6 rounded-3xl border border-brand-light/15 shadow-sm space-y-4">
        <span class="text-xs font-bold text-rose-600 font-mono uppercase tracking-wider block">Críticas (1-3★)</span>
        <div class="flex items-baseline gap-2">
          <p class="text-5xl font-black text-rose-600 font-mono"><%= stats.criticCount %></p>
          <p class="text-sm font-semibold text-gray-400">clientes (<%= stats.totalCount ? Math.round((stats.criticCount / stats.totalCount) * 100) : 0 %>%)</p>
        </div>
        <div class="w-full bg-gray-100 h-2 rounded-full overflow-hidden">
          <div class="bg-rose-500 h-full" style="width: <%= stats.totalCount ? (stats.criticCount / stats.totalCount) * 100 : 0 %>%"></div>
        </div>
        <p class="text-[11px] text-gray-500 leading-relaxed">Mensagens privadas e feedbacks construtivos destinados apenas à gerência do laboratório.</p>
      </div>

      <!-- Card: Pendentes / Não Avaliaram -->
      <div class="bg-white p-6 rounded-3xl border border-brand-light/15 shadow-sm space-y-4">
        <span class="text-xs font-bold text-amber-600 font-mono uppercase tracking-wider block">Acompanhamento de Links</span>
        <div class="flex items-baseline gap-2">
          <p class="text-5xl font-black text-amber-600 font-mono"><%= pendingAccessesCount %></p>
          <p class="text-xs font-bold text-gray-400 font-sans leading-none uppercase tracking-wide">Sem Resposta</p>
        </div>
        <div class="space-y-3">
          <div class="flex flex-col gap-1.5 text-xs text-gray-500 font-semibold font-sans">
            <div class="flex justify-between items-center">
              <span class="inline-flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                <span>Não Abriu</span>
              </span>
              <strong class="text-amber-600 font-mono text-xs"><%= notOpenedCount %></strong>
            </div>
            <div class="flex justify-between items-center">
              <span class="inline-flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-blue-500"></span>
                <span>Aberto (Sem Enviar)</span>
              </span>
              <strong class="text-blue-600 font-mono text-xs"><%= openedNotSubmittedCount %></strong>
            </div>
          </div>
          <div class="w-full bg-gray-100 h-2 rounded-full overflow-hidden flex">
            <% const totalPending = notOpenedCount + openedNotSubmittedCount %>
            <% const notOpenedPct = totalPending ? (notOpenedCount / totalPending) * 100 : 0 %>
            <% const openedNotSubPct = totalPending ? (openedNotSubmittedCount / totalPending) * 100 : 0 %>
            <div class="bg-amber-500 h-full" style="width: <%= notOpenedPct %>%"></div>
            <div class="bg-blue-500 h-full" style="width: <%= openedNotSubPct %>%"></div>
          </div>
        </div>
        <p class="text-[11px] text-gray-500 leading-relaxed">Status de envio dos links gerados pela recepção que ainda não foram convertidos em avaliação.</p>
      </div>

      <!-- Card: Conversão Google (5★) -->
      <div class="bg-white p-6 rounded-3xl border border-brand-light/15 shadow-sm space-y-4">
        <span class="text-xs font-bold text-emerald-600 font-mono uppercase tracking-wider block">Interesse no Google</span>
        <div class="flex items-baseline gap-2">
          <p class="text-5xl font-black text-emerald-600 font-mono"><%= stats.googleClickedCount %></p>
          <p class="text-xs font-semibold text-gray-400 leading-none">clicaram (<%= stats.googleEligibleCount ? Math.round((stats.googleClickedCount / stats.googleEligibleCount) * 100) : 0 %>%)</p>
        </div>
        <div class="space-y-1.5">
          <div class="flex justify-between text-[10px] text-gray-500 font-mono font-semibold">
            <span>Não clicaram: <strong class="text-amber-600"><%= stats.googleNotClickedCount %></strong></span>
            <span>Total 5★: <strong><%= stats.googleEligibleCount %></strong></span>
          </div>
          <div class="w-full bg-gray-100 h-1.5 rounded-full overflow-hidden flex">
            <% const clickedPct = stats.googleEligibleCount ? (stats.googleClickedCount / stats.googleEligibleCount) * 100 : 0 %>
            <% const notClickedPct = stats.googleEligibleCount ? (stats.googleNotClickedCount / stats.googleEligibleCount) * 100 : 0 %>
            <div class="bg-emerald-500 h-full" style="width: <%= clickedPct %>%"></div>
            <div class="bg-amber-500 h-full" style="width: <%= notClickedPct %>%"></div>
          </div>
        </div>
        <p class="text-[11px] text-gray-500 leading-relaxed">Cliques no botão "Avaliar 5 estrelas no Google" vs. os que ignoraram e não clicaram.</p>
      </div>

    </div>

    <!-- Seleção de Abas -->
    <div class="flex border-b border-gray-200 gap-6 mb-6">
      <button onclick="switchTab('reviews')" id="tab-btn-reviews" class="pb-4 text-sm font-bold border-b-2 border-[#284701] text-[#284701] transition-all cursor-pointer flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.907c.961 0 1.36 1.24.588 1.81l-3.97 2.88a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.971-2.88a1 1 0 00-1.18 0l-3.97 2.88c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.97-2.88c-.772-.57-.373-1.81.587-1.81H7.89a1 1 0 00.95-.69l1.519-4.674z"/>
        </svg>
        Avaliações Recebidas (<%= evaluations.length %>)
      </button>
      <button onclick="switchTab('conversion')" id="tab-btn-conversion" class="pb-4 text-sm font-bold border-b-2 border-transparent text-gray-400 hover:text-gray-600 transition-all cursor-pointer flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
        </svg>
        Acompanhamento de Links (<%= accesses.length %>)
      </button>
    </div>

    <!-- Painel de Filtros Unificado (Mês e Dia) -->
    <div class="bg-white p-5 rounded-3xl border border-brand-light/15 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5 text-[#284701]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/>
        </svg>
        <div class="space-y-0.5">
          <span class="text-[10px] font-bold uppercase tracking-widest text-[#284701] font-mono block">Filtro Rápido</span>
          <h3 class="text-sm font-extrabold text-brand-dark">Filtrar por Mês e Dia</h3>
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-3 w-full sm:w-auto">
        <!-- Seletor de Mês -->
        <div class="flex items-center gap-2 bg-gray-50 px-3 py-1.5 rounded-xl border border-gray-200 h-10 shadow-xs">
          <span class="text-[9px] font-extrabold uppercase tracking-widest text-gray-400 font-mono">Mês:</span>
          <select id="filter-period-month" onchange="applyGlobalDateFilters()" class="text-xs font-bold text-brand-dark bg-transparent border-none focus:outline-none cursor-pointer font-sans">
            <option value="all">Todos os meses</option>
          </select>
        </div>

        <!-- Seletor de Dia -->
        <div class="flex items-center gap-2 bg-gray-50 px-3 py-1.5 rounded-xl border border-gray-200 h-10 shadow-xs">
          <span class="text-[9px] font-extrabold uppercase tracking-widest text-gray-400 font-mono">Dia:</span>
          <select id="filter-period-day" onchange="applyGlobalDateFilters()" class="text-xs font-bold text-brand-dark bg-transparent border-none focus:outline-none cursor-pointer font-sans">
            <option value="all">Todos os dias</option>
            <% for(let d = 1; d <= 31; d++) { %>
              <% const dayStr = String(d).padStart(2, '0'); %>
              <option value="<%= dayStr %>"><%= dayStr %></option>
            <% } %>
          </select>
        </div>

        <!-- Botão Limpar -->
        <button onclick="clearGlobalDateFilters()" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-600 transition-colors text-xs font-bold rounded-xl cursor-pointer font-sans">
          Limpar Filtros
        </button>
      </div>
    </div>

    <!-- Conteúdo da Aba 1: Avaliações Recebidas -->
    <div id="tab-content-reviews" class="space-y-6">

      <!-- Seção de Evolução Mensal (Histórico) -->
      <div class="bg-white p-6 sm:p-8 rounded-3xl border border-brand-light/15 shadow-sm space-y-6">
      <div class="flex justify-between items-center border-b border-gray-100 pb-4">
        <div class="space-y-0.5">
          <span class="text-[10px] font-bold uppercase tracking-widest text-brand-gold font-mono block">Métricas Históricas</span>
          <h2 class="text-base sm:text-lg font-extrabold text-brand-dark">Evolução Mensal da Satisfação</h2>
        </div>
        <span class="text-[10px] sm:text-[11px] font-mono font-bold text-gray-400 bg-brand-softBg px-2.5 py-1 rounded-lg">Acompanhamento Temporal</span>
      </div>
      
      <% if (evolution.length === 0) { %>
        <p class="text-xs text-gray-400 font-medium text-center py-4">Aguardando dados suficientes para gerar histórico.</p>
      <% } else { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
          <!-- Card de Todos os Meses -->
          <div class="relative p-4 rounded-2xl border <%= selectedMonth === 'all' ? 'border-brand-dark bg-brand-softBg/30 ring-2 ring-brand-dark/10' : 'border-gray-100 bg-white hover:border-gray-200' %> transition-all cursor-pointer flex flex-col justify-between space-y-3 shadow-xs" onclick="window.location.href='/admin/avaliacoes?month=all'">
            <div class="flex justify-between items-start">
              <span class="text-xs font-bold text-brand-dark font-sans leading-tight">Todos os Meses</span>
              <% if (selectedMonth === 'all') { %>
                <span class="text-[9px] bg-brand-dark text-white font-extrabold px-1.5 py-0.5 rounded-md font-mono uppercase">Ativo</span>
              <% } %>
            </div>
            <div class="flex items-baseline gap-1.5">
              <span class="text-3xl font-black text-brand-dark font-mono">Geral</span>
            </div>
            <div class="text-[10px] text-gray-500 font-mono font-semibold">
              Ver histórico completo
            </div>
          </div>

          <!-- Cards de cada mês -->
          <% evolution.forEach(m => { %>
            <div class="relative p-4 rounded-2xl border <%= selectedMonth === m.key ? 'border-[#284701] bg-[#284701]/5 ring-2 ring-[#284701]/10' : 'border-gray-100 bg-white hover:border-gray-200' %> transition-all cursor-pointer flex flex-col justify-between space-y-3 shadow-xs" onclick="window.location.href='/admin/avaliacoes?month=<%= m.key %>'">
              <div class="flex justify-between items-start">
                <span class="text-xs font-bold text-brand-dark font-sans leading-tight"><%= m.label %></span>
                <% if (selectedMonth === m.key) { %>
                  <span class="text-[9px] bg-[#284701] text-white font-extrabold px-1.5 py-0.5 rounded-md font-mono uppercase">Ativo</span>
                <% } %>
              </div>
              
              <div class="flex items-baseline gap-1.5">
                <span class="text-3xl font-black text-brand-dark font-mono"><%= m.average.toFixed(1) %></span>
                <span class="text-xs text-amber-500 font-bold">★</span>
              </div>

              <div class="space-y-1">
                <div class="flex justify-between text-[10px] text-gray-500 font-mono font-semibold">
                  <span><%= m.total %> <%= m.total === 1 ? 'avaliação' : 'avaliações' %></span>
                  <span class="text-emerald-700 font-bold"><%= Math.round((m.promoters / m.total) * 100) %>% Prom.</span>
                </div>
                <!-- Progress bar -->
                <div class="w-full bg-gray-100 h-1.5 rounded-full overflow-hidden flex">
                  <div class="bg-emerald-600 h-full" style="width: <%= (m.promoters / m.total) * 100 %>%"></div>
                  <div class="bg-rose-500 h-full" style="width: <%= (m.critics / m.total) * 100 %>%"></div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

    <!-- Filtros de Visualização -->
    <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-4">
      <div class="flex flex-wrap items-center gap-3 w-full lg:w-auto">
        <div class="flex flex-wrap items-center gap-2 bg-white p-1 rounded-2xl border border-brand-light/15">
          <button onclick="filterReviews('all')" id="filter-all" class="filter-btn px-4 py-2 text-xs font-bold rounded-xl transition-all cursor-pointer bg-brand-dark text-white">
            Todas (<%= stats.totalCount %>)
          </button>
          <button onclick="filterReviews('positive')" id="filter-positive" class="filter-btn px-4 py-2 text-xs font-bold rounded-xl text-gray-600 hover:text-brand-dark hover:bg-gray-50 transition-all cursor-pointer">
            Promotores 4-5★ (<%= stats.promoterCount %>)
          </button>
          <button onclick="filterReviews('constructive')" id="filter-constructive" class="filter-btn px-4 py-2 text-xs font-bold rounded-xl text-gray-600 hover:text-brand-dark hover:bg-gray-50 transition-all cursor-pointer">
            Privadas 1-3★ (<%= stats.criticCount %>)
          </button>
        </div>

        <!-- Seletor Rápido de Período / Mês -->
        <div class="flex items-center gap-2 bg-white px-3 py-1.5 rounded-2xl border border-brand-light/15 h-[42px] shadow-sm">
          <span class="text-[9px] font-extrabold uppercase tracking-widest text-gray-400 font-mono">Período:</span>
          <select onchange="window.location.href='/admin/avaliacoes?month=' + this.value" class="text-xs font-bold text-brand-dark bg-transparent border-none focus:outline-none cursor-pointer font-sans">
            <option value="all" <%= selectedMonth === 'all' ? 'selected' : '' %>>Todos os meses</option>
            <% evolution.forEach(m => { %>
              <option value="<%= m.key %>" <%= selectedMonth === m.key ? 'selected' : '' %>><%= m.label %> (<%= m.total %>)</option>
            <% }) %>
          </select>
        </div>
      </div>

      <!-- Filtro por Código / Nome do Paciente -->
      <div class="flex items-center gap-2 w-full lg:w-auto">
        <div class="relative w-full lg:w-72">
          <input type="text" id="code-search-input" oninput="searchReviews()" placeholder="Filtrar por nome ou código do paciente..." class="w-full px-4 py-2.5 text-xs font-semibold bg-white border border-brand-light/15 rounded-xl focus:outline-none focus:border-[#284701] font-sans" />
          <button id="clear-search" onclick="clearSearch()" class="hidden absolute right-3 top-2.5 text-gray-400 hover:text-gray-600 text-xs font-bold font-mono">✕</button>
        </div>
      </div>
    </div>

    <!-- Lista de Avaliações -->
    <div class="space-y-4" id="reviews-list">
      <% if (evaluations.length === 0) { %>
        <div class="bg-white rounded-3xl p-12 border border-brand-light/15 text-center space-y-3">
          <p class="text-gray-400 text-sm font-medium">Nenhuma avaliação recebida até o momento.</p>
        </div>
      <% } else { %>
        <% evaluations.forEach(review => { %>
          <div class="review-card bg-white p-6 sm:p-8 rounded-3xl border border-brand-light/15 shadow-sm flex flex-col md:flex-row gap-6 justify-between transition-all hover:shadow-md" data-type="<%= review.rating >= 4 ? 'positive' : 'constructive' %>" data-code="<%= review.code || '' %>" data-name="<%= (review.name || '').toLowerCase() %>" data-date="<%= review.date %>">
            
            <!-- Conteúdo da Avaliação -->
            <div class="space-y-4 max-w-4xl">
              <div class="flex items-center flex-wrap gap-3">
                <!-- Estrelas -->
                <div class="flex items-center space-x-0.5">
                  <% for(let i = 1; i <= 5; i++) { %>
                    <svg class="w-4 h-4 <%= i <= review.rating ? 'text-amber-400 fill-current' : 'text-gray-200 fill-current' %>" viewBox="0 0 24 24">
                      <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                    </svg>
                  <% } %>
                </div>

                <!-- Tag de Tipo -->
                <span class="text-[9px] font-extrabold uppercase tracking-wider px-2.5 py-0.5 rounded-full <%= review.rating >= 4 ? 'bg-emerald-50 text-emerald-800' : 'bg-rose-50 text-rose-800' %>">
                  <%= review.rating >= 4 ? 'Público / Google' : 'Privado / Gerência' %>
                </span>

                <!-- Código do Paciente -->
                <% if (review.code) { %>
                  <button onclick="searchByCode('<%= review.code %>')" class="text-[9px] font-extrabold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-blue-50 hover:bg-blue-100 text-blue-800 font-mono transition-colors cursor-pointer" title="Clique para filtrar apenas avaliações deste paciente">
                    Código: <%= review.code %>
                  </button>
                <% } %>

                <!-- Status de Clique no Google (Apenas para 5 Estrelas) -->
                <% if (review.rating === 5) { %>
                  <% if (review.googleClicked) { %>
                    <span class="text-[9px] font-extrabold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-sans inline-flex items-center gap-1">
                      <span class="w-1 h-1 rounded-full bg-emerald-600"></span>
                      Clicou no Google
                    </span>
                  <% } else { %>
                    <span class="text-[9px] font-extrabold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-800 font-sans inline-flex items-center gap-1">
                      <span class="w-1 h-1 rounded-full bg-amber-500"></span>
                      Ignorou o Google
                    </span>
                  <% } %>
                <% } %>

                <span class="text-xs text-gray-400 font-mono"><%= review.date %><%= review.time ? ' às ' + review.time : '' %></span>
              </div>

              <div class="space-y-1">
                <p class="text-xs font-bold text-brand-dark flex items-center gap-2">
                  <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                  <%= review.name || 'Anônimo' %>
                  <% if (review.phone) { %>
                    <span class="text-[10px] text-gray-400 font-mono font-normal">(WhatsApp: <%= review.phone %>)</span>
                  <% } %>
                </p>
                <blockquote class="text-xs text-gray-600 italic bg-brand-softBg/20 p-4 rounded-2xl border-l-4 border-brand-light/30 leading-relaxed font-sans">
                  "<%= review.comment %>"
                </blockquote>
              </div>
            </div>

            <!-- Ações -->
            <div class="flex items-center md:self-center gap-2 shrink-0">
              <% if (review.phone) { %>
                <a href="https://wa.me/55<%= review.phone.replace(/\D/g, '') %>?text=Olá, agradecemos o seu feedback no InovaLab Cambará!" target="_blank" rel="noopener noreferrer" class="px-4 py-2 border border-[#284701] text-[#284701] hover:bg-[#284701] hover:text-white transition-colors text-xs font-bold rounded-xl inline-flex items-center gap-1.5 font-mono">
                  Responder no WhatsApp
                </a>
              <% } %>
              
              <!-- Formulário para exclusão se necessário -->
              <form action="/admin/avaliacoes/deletar" method="POST" onsubmit="return confirm('Deseja realmente remover esta avaliação do painel?')" class="inline">
                <input type="hidden" name="id" value="<%= review.id %>">
                <button type="submit" class="p-2 text-rose-600 hover:bg-rose-50 rounded-xl transition-colors cursor-pointer" title="Deletar Avaliação">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                </button>
              </form>
            </div>

          </div>
        <% }) %>
      <% } %>
    </div>
    </div>

    <!-- Conteúdo da Aba 2: Gerar Mensagens & Links -->
    <div id="tab-content-generator" class="hidden space-y-6">
      <div class="bg-white p-6 sm:p-8 rounded-3xl border border-brand-light/15 shadow-sm space-y-6">
        <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-4 border-b border-gray-100 pb-4">
          <div class="space-y-0.5">
            <span class="text-[10px] font-bold uppercase tracking-widest text-[#284701] font-mono block">Nova Solicitação</span>
            <h2 class="text-lg font-extrabold text-brand-dark">Gerador de Mensagens Automatizadas</h2>
            <p class="text-xs text-gray-400 mt-1">Copie as mensagens de resultado de exames prontos e convites de avaliação de forma 100% automática a partir do cadastro.</p>
          </div>
          <!-- Botão Configurar Templates de Mensagem inline no card -->
          <button onclick="toggleTemplatesPanel()" class="text-xs font-bold bg-gray-50 hover:bg-gray-100 text-gray-700 border border-gray-200 px-4 py-2.5 rounded-xl transition-all font-sans flex items-center gap-2 self-start sm:self-auto cursor-pointer shadow-xs">
            <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            Editar Modelos de Mensagem
          </button>
        </div>

        <!-- Painel de Configuração de Mensagens (Oculto por padrão, mas agora dentro desta aba) -->
        <div id="templates-config-panel" class="hidden bg-gray-50/50 p-6 rounded-2xl border border-gray-200 space-y-6 animate-fade-in mb-6">
          <div class="flex justify-between items-center border-b border-gray-200 pb-4">
            <div>
              <span class="text-[10px] font-bold uppercase tracking-widest text-[#284701] font-mono block">Personalização</span>
              <h2 class="text-base font-extrabold text-brand-dark">Configurar Mensagens do WhatsApp</h2>
            </div>
            <button onclick="toggleTemplatesPanel()" class="p-2 text-gray-400 hover:text-gray-600 transition-colors cursor-pointer" title="Fechar">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
          </div>

          <div class="grid grid-cols-1 gap-6">
            <!-- Template de Resultado Pronto -->
            <div class="space-y-2">
              <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider font-mono">Mensagem de Resultado Pronto</label>
              <p class="text-[11px] text-gray-500 leading-relaxed">Mensagem enviada informando que o resultado está pronto. Use os marcadores <strong class="text-brand-gold font-mono">{nome}</strong> para o nome, <strong class="text-brand-gold font-mono">{codigo}</strong> para o código da requisição, <strong class="text-brand-gold font-mono">{usuario}</strong> para o usuário e <strong class="text-brand-gold font-mono">{senha}</strong> para a senha.</p>
              <textarea id="template-result-ready-input" rows="3" class="w-full text-xs font-sans p-3 border border-gray-200 rounded-xl focus:border-[#284701] focus:ring-1 focus:ring-[#284701] focus:outline-none bg-white"><%= messageTemplates.resultReady || "Olá, {nome}! Seu resultado do exame do InovaLab já está disponível. Código da requisição: *{codigo}*. Usuário para acesso: *{usuario}* e Senha: *{senha}*." %></textarea>
            </div>

            <!-- Template de Convite Inicial -->
            <div class="space-y-2">
              <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider font-mono">Mensagem de Convite de Avaliação</label>
              <p class="text-[11px] text-gray-500 leading-relaxed">Mensagem enviada com o link gerado pela primeira vez. Use o marcador <strong class="text-brand-gold font-mono">{link}</strong> para o link de avaliação e <strong class="text-brand-gold font-mono">{nome}</strong> para o nome do paciente.</p>
              <textarea id="template-invite-input" rows="3" class="w-full text-xs font-sans p-3 border border-gray-200 rounded-xl focus:border-[#284701] focus:ring-1 focus:ring-[#284701] focus:outline-none bg-white"><%= messageTemplates.invite %></textarea>
            </div>

            <!-- Template de Cobrança / Lembrete -->
            <div class="space-y-2">
              <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider font-mono">Mensagem de Cobrança (Lembrete)</label>
              <p class="text-[11px] text-gray-500 leading-relaxed">Mensagem de reenvio amigável ao clicar em "Cobrar" na lista. Use o marcador <strong class="text-brand-gold font-mono">{link}</strong> para o link de avaliação e <strong class="text-brand-gold font-mono">{nome}</strong> para o nome do paciente.</p>
              <textarea id="template-reminder-input" rows="3" class="w-full text-xs font-sans p-3 border border-gray-200 rounded-xl focus:border-[#284701] focus:ring-1 focus:ring-[#284701] focus:outline-none bg-white"><%= messageTemplates.reminder %></textarea>
            </div>
          </div>

          <div class="flex justify-end gap-3 pt-2">
            <button onclick="toggleTemplatesPanel()" class="px-4 py-2 border border-gray-200 text-gray-600 hover:bg-white text-xs font-bold rounded-xl transition-colors cursor-pointer bg-white">
              Cancelar
            </button>
            <button onclick="saveMessageTemplates()" class="px-5 py-2 bg-[#284701] hover:bg-[#3b661d] text-white text-xs font-bold rounded-xl transition-colors shadow-xs cursor-pointer inline-flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              Salvar Configurações
            </button>
          </div>
        </div>

        <!-- LISTA DE PACIENTES CADASTRADOS -->
        <div class="space-y-4">
          <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-gray-100 pb-4">
            <div>
              <h3 class="text-sm font-bold font-mono text-brand-dark uppercase tracking-wider">Selecione o Paciente para Envio</h3>
              <p class="text-[11px] text-gray-400 mt-0.5">Use o campo de busca rápida para filtrar por nome ou código.</p>
            </div>
            <input type="text" id="msg-search-input" onkeyup="filterGeneratorList()" placeholder="Buscar por nome ou código..." class="w-full sm:w-64 px-3 py-2 rounded-xl border border-brand-light/30 text-xs font-medium focus:outline-none focus:ring-1 focus:ring-[#284701] bg-white">
          </div>

          <div class="grid grid-cols-1 gap-3.5" id="generator-requisitions-list">
            <% if (requisitions.length === 0) { %>
              <div class="text-center py-12 text-gray-400 italic text-xs">
                Nenhum paciente cadastrado no sistema de requisições.
              </div>
            <% } else { %>
              <% [...requisitions].reverse().forEach(req => { %>
                <div class="generator-card bg-brand-neutralLight/40 p-5 rounded-2xl border border-brand-light/10 hover:border-[#284701]/20 hover:bg-white transition-all space-y-4" 
                     data-name="<%= req.patientName.toLowerCase() %>" 
                     data-code="<%= (req.requisitionCode || req.id).toLowerCase() %>">
                  
                  <div class="flex flex-col lg:flex-row justify-between lg:items-center gap-4">
                    <!-- Info do Paciente -->
                    <div class="space-y-1">
                      <div class="flex items-center gap-2 flex-wrap">
                        <h4 class="text-sm font-extrabold text-brand-dark"><%= req.patientName %></h4>
                        
                        <!-- Badge Status -->
                        <span class="text-[10px] font-bold px-2 py-0.5 rounded-full inline-block font-mono uppercase border
                          <%= req.status === 'Pronto' ? 'text-emerald-700 border-emerald-200 bg-emerald-50' : 
                              req.status === 'Coletado' ? 'text-blue-700 border-blue-200 bg-blue-50' : 
                              req.status === 'Em Processamento' ? 'text-amber-700 border-amber-200 bg-amber-50' : 
                              'text-gray-500 border-gray-200 bg-gray-50' %>">
                          <%= req.status %>
                        </span>
                      </div>
                      
                      <!-- Dados de Credencial e Acesso -->
                      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] text-gray-500 font-mono">
                        <span>Cód: <strong class="text-brand-dark"><%= req.requisitionCode || req.id %></strong></span>
                        <% if (req.patientUsername) { %>
                          <span class="text-gray-300">|</span>
                          <span>Usuário: <strong class="text-brand-dark"><%= req.patientUsername %></strong></span>
                        <% } %>
                        <% if (req.patientPassword) { %>
                          <span class="text-gray-300">|</span>
                          <span>Senha: <strong class="text-brand-dark"><%= req.patientPassword %></strong></span>
                        <% } %>
                        <% if (req.patientPhone) { %>
                          <span class="text-gray-300">|</span>
                          <span>Cel: <strong><%= req.patientPhone %></strong></span>
                        <% } %>
                      </div>
                    </div>

                    <!-- Botões de Ação de Cópia Rápida -->
                    <div class="flex flex-wrap items-center gap-2">
                      <!-- Botão 1: Copiar Resultado Pronto (WhatsApp) -->
                      <button onclick="copyResultReadyMessage('<%= req.patientName.replace(/'/g, `\\'`) %>', '<%= (req.requisitionCode || req.id).replace(/'/g, `\\'`) %>', '<%= (req.patientUsername || '').replace(/'/g, `\\'`) %>', '<%= (req.patientPassword || '').replace(/'/g, `\\'`) %>')"
                              class="px-3.5 py-2 text-xs font-bold rounded-xl border border-gray-200 hover:border-blue-500 hover:bg-blue-50/50 hover:text-blue-700 text-gray-600 transition-all flex items-center gap-1.5 cursor-pointer bg-white">
                        <svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                        <span>Copiar Resultado Pronto</span>
                      </button>

                      <!-- Botão 2: Copiar Link de Avaliar -->
                      <button onclick="copyReviewInviteMessage('<%= req.patientName.replace(/'/g, `\\'`) %>', '<%= (req.requisitionCode || req.id).replace(/'/g, `\\'`) %>')"
                              class="px-3.5 py-2 text-xs font-bold rounded-xl bg-[#284701] hover:bg-[#3b661d] text-white transition-all flex items-center gap-1.5 cursor-pointer shadow-xs">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.907c.961 0 1.36 1.242.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.771-.568-.372-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
                        <span>Copiar Link Avaliação</span>
                      </button>
                    </div>
                  </div>

                </div>
              <% }) %>
            <% } %>
          </div>
        </div>

        <!-- GERADOR DE LINK MANUAL (Fallback ocultável) -->
        <div class="bg-gray-50 border border-gray-200 rounded-2xl p-5 space-y-4">
          <div class="flex justify-between items-center cursor-pointer" onclick="toggleManualGenerator()">
            <div class="flex items-center gap-2 text-gray-700">
              <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3m0 0v3m0-3h3m-3 0H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <span class="text-xs font-bold uppercase tracking-wider font-mono">Gerador Manual de Link de Avaliação (Ficha avulsa)</span>
            </div>
            <span id="manual-toggle-icon" class="text-[11px] text-[#284701] font-bold font-mono">▲ recolher</span>
          </div>

          <div id="manual-generator-container" class="space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-end">
              <div class="space-y-1.5">
                <label class="block text-[10px] font-bold text-gray-600 uppercase tracking-wider font-mono">Cód. Paciente / Ficha</label>
                <input type="text" id="generator-patient-code" placeholder="Ex: 12345" class="w-full px-3 py-2 rounded-xl border border-gray-200 bg-white text-xs font-semibold focus:outline-none focus:border-[#284701] font-mono h-10" />
              </div>
              <div class="space-y-1.5">
                <label class="block text-[10px] font-bold text-gray-600 uppercase tracking-wider font-mono">Nome do Paciente</label>
                <input type="text" id="generator-patient-name" placeholder="Ex: Maria Souza" class="w-full px-3 py-2 rounded-xl border border-gray-200 bg-white text-xs font-semibold focus:outline-none focus:border-[#284701] h-10" />
              </div>
              <div>
                <button id="copy-link-btn" class="w-full text-xs font-bold bg-[#284701] hover:bg-[#3b661d] text-white px-4 py-2 rounded-xl transition-all flex items-center justify-center gap-2 h-10 cursor-pointer">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/></svg>
                  Copiar Link Manual
                </button>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Conteúdo da Aba 3: Acompanhamento de Conversão -->
    <div id="tab-content-conversion" class="hidden space-y-6">
      <!-- Controle de Links de Pacientes (Acessos) -->
      <div class="bg-white p-6 sm:p-8 rounded-3xl border border-brand-light/15 shadow-sm space-y-6">
      <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-4 border-b border-gray-100 pb-4">
        <div class="space-y-0.5">
          <span class="text-[10px] font-bold uppercase tracking-widest text-[#284701] font-mono block">Status de Conversão</span>
          <h2 class="text-base sm:text-lg font-extrabold text-brand-dark">Acompanhamento de Links de Pacientes</h2>
        </div>
        
        <!-- Input para filtrar os códigos de acesso -->
        <div class="flex items-center bg-gray-50 border border-gray-200 rounded-xl px-3 py-1.5 w-full sm:w-64">
          <svg class="w-4 h-4 text-gray-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <input type="text" id="access-search" oninput="filterAccessTable()" placeholder="Buscar por código..." class="text-xs bg-transparent border-none focus:outline-none w-full font-mono text-brand-dark" />
        </div>
      </div>

      <% if (accesses.length === 0) { %>
        <div class="text-center py-8">
          <p class="text-xs text-gray-400 font-medium font-sans">Nenhum código de paciente acessou o link de avaliação ainda.</p>
          <p class="text-[10px] text-gray-400 mt-1">Os acessos serão listados aqui assim que os pacientes clicarem no link enviado com código.</p>
        </div>
      <% } else { %>
        <div class="overflow-x-auto rounded-2xl border border-gray-100">
          <div class="max-h-96 overflow-y-auto">
            <table class="w-full text-left border-collapse font-sans">
              <thead>
                <tr class="bg-brand-softBg text-[10px] font-extrabold uppercase tracking-wider text-brand-dark border-b border-gray-100 font-mono">
                  <th class="px-6 py-4">Código do Paciente</th>
                  <th class="px-6 py-4">Nome do Paciente</th>
                  <th class="px-6 py-4">Primeiro Acesso</th>
                  <th class="px-6 py-4">Último Acesso</th>
                  <th class="px-6 py-4 text-center">Status</th>
                  <th class="px-6 py-4 text-right">Ações</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100 text-xs text-gray-700" id="access-table-body">
                <% [...accesses].reverse().forEach(acc => { %>
                  <tr class="access-row hover:bg-gray-50 transition-colors" data-code="<%= acc.code %>" data-name="<%= (acc.patientName || '').toLowerCase() %>" data-date="<%= acc.createdDate || acc.firstAccessDate || '-' %>">
                    <td class="px-6 py-4 font-mono font-bold text-brand-dark">
                      <%= acc.code %>
                    </td>
                    <td class="px-6 py-4 font-sans font-semibold text-gray-800">
                      <%= acc.patientName || '-' %>
                    </td>
                    <td class="px-6 py-4 font-mono text-gray-500">
                      <%= acc.firstAccessDate === '-' || !acc.firstAccessDate ? '-' : `${acc.firstAccessDate} às ${acc.firstAccessTime}` %>
                    </td>
                    <td class="px-6 py-4 font-mono text-gray-500">
                      <%= acc.lastAccessDate === '-' || !acc.lastAccessDate ? '-' : `${acc.lastAccessDate} às ${acc.lastAccessTime}` %>
                    </td>
                    <td class="px-6 py-4 text-center">
                      <% if (acc.status === 'submitted') { %>
                        <span class="inline-flex items-center gap-1 text-[10px] font-extrabold uppercase tracking-wide bg-emerald-50 text-emerald-800 px-2.5 py-1 rounded-full font-sans">
                          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                          Avaliado
                        </span>
                      <% } else if (acc.status === 'created') { %>
                        <span class="inline-flex items-center gap-1 text-[10px] font-extrabold uppercase tracking-wide bg-amber-50 text-amber-800 px-2.5 py-1 rounded-full font-sans">
                          <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                          Não Abriu
                        </span>
                      <% } else if (acc.status === 'not_invited') { %>
                        <span class="inline-flex items-center gap-1 text-[10px] font-extrabold uppercase tracking-wide bg-gray-50 text-gray-500 px-2.5 py-1 rounded-full font-sans">
                          <span class="w-1.5 h-1.5 rounded-full bg-gray-400"></span>
                          Não Convidado
                        </span>
                      <% } else { %>
                        <span class="inline-flex items-center gap-1 text-[10px] font-extrabold uppercase tracking-wide bg-blue-50 text-blue-800 px-2.5 py-1 rounded-full font-sans">
                          <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                          Não Avaliou
                        </span>
                      <% } %>
                    </td>
                    <td class="px-6 py-4 text-right flex justify-end gap-2">
                      <% if (acc.status === 'submitted') { %>
                        <button onclick="searchByCode('<%= acc.code %>')" class="px-3 py-1.5 bg-brand-dark hover:bg-brand-dark/90 text-white font-bold rounded-lg transition-all text-[10px] cursor-pointer font-sans shadow-xs" title="Ver avaliação feita por este código">
                          Ver Avaliação
                        </button>
                      <% } else if (acc.status === 'not_invited') { %>
                        <button onclick="sendInviteFromConversion('<%= acc.code %>', '<%= acc.patientName.replace(/'/g, `\\'`) %>', '<%= acc.patientPhone %>')" class="px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-lg transition-all text-[10px] cursor-pointer font-sans inline-flex items-center gap-1 shadow-xs" title="Enviar convite de avaliação inicial">
                          Convidar
                        </button>
                      <% } else { %>
                        <!-- Reenviar WhatsApp -->
                        <button onclick="shareWhatsAppWithCode('<%= acc.code %>', '<%= acc.patientPhone %>')" class="px-3 py-1.5 bg-[#284701] hover:bg-[#3b661d] text-white font-bold rounded-lg transition-all text-[10px] cursor-pointer font-mono inline-flex items-center gap-1 shadow-xs" title="Copiar mensagem de cobrança amigável">
                          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/></svg>
                          Cobrar
                        </button>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>
    </div>

  </div>
</section>

<!-- Feedback de link copiado -->
<div id="toast-message" class="fixed bottom-6 right-6 bg-brand-dark text-white text-xs font-bold px-4 py-3 rounded-xl shadow-lg border border-brand-light/20 transform translate-y-12 opacity-0 transition-all duration-300 z-50 pointer-events-none flex items-center gap-2">
  <svg class="w-4 h-4 text-brand-gold animate-bounce" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
  Mensagem e Link copiados para transferência!
</div>

<script>
  let currentTypeFilter = 'all';
  let currentMonthFilter = '<%= selectedMonth %>';
  let currentDayFilter = 'all';

  function switchTab(tab) {
    const reviewsTabBtn = document.getElementById('tab-btn-reviews');
    const generatorTabBtn = document.getElementById('tab-btn-generator');
    const conversionTabBtn = document.getElementById('tab-btn-conversion');

    const reviewsContent = document.getElementById('tab-content-reviews');
    const generatorContent = document.getElementById('tab-content-generator');
    const conversionContent = document.getElementById('tab-content-conversion');

    const activeClass = "pb-4 text-sm font-bold border-b-2 border-[#284701] text-[#284701] transition-all cursor-pointer flex items-center gap-2";
    const inactiveClass = "pb-4 text-sm font-bold border-b-2 border-transparent text-gray-400 hover:text-gray-600 transition-all cursor-pointer flex items-center gap-2";

    if (reviewsTabBtn && reviewsContent) {
      if (tab === 'reviews') {
        reviewsTabBtn.className = activeClass;
        reviewsContent.classList.remove('hidden');
      } else {
        reviewsTabBtn.className = inactiveClass;
        reviewsContent.classList.add('hidden');
      }
    }

    if (generatorTabBtn && generatorContent) {
      if (tab === 'generator') {
        generatorTabBtn.className = activeClass;
        generatorContent.classList.remove('hidden');
      } else {
        generatorTabBtn.className = inactiveClass;
        generatorContent.classList.add('hidden');
      }
    }

    if (conversionTabBtn && conversionContent) {
      if (tab === 'conversion') {
        conversionTabBtn.className = activeClass;
        conversionContent.classList.remove('hidden');
      } else {
        conversionTabBtn.className = inactiveClass;
        conversionContent.classList.add('hidden');
      }
    }

    localStorage.setItem('selected_eval_tab', tab);
  }

  function populateMonthFilter() {
    const monthSelect = document.getElementById('filter-period-month');
    if (!monthSelect) return;

    const monthsSet = new Set();
    const monthLabels = {};

    const monthNamesBR = [
      "Janeiro", "Fevereiro", "Março", "Abril", "Maio", "Junho",
      "Julho", "Agosto", "Setembro", "Outubro", "Novembro", "Dezembro"
    ];

    // Ler de review-card
    document.querySelectorAll('.review-card').forEach(card => {
      const dateStr = card.getAttribute('data-date');
      if (dateStr && dateStr.includes('/')) {
        const parts = dateStr.split('/');
        if (parts.length === 3) {
          const key = `${parts[2]}-${parts[1]}`; // YYYY-MM
          monthsSet.add(key);
          const monthIndex = parseInt(parts[1], 10) - 1;
          monthLabels[key] = `${monthNamesBR[monthIndex]} / ${parts[2]}`;
        }
      }
    });

    // Ler de access-row
    document.querySelectorAll('.access-row').forEach(row => {
      const dateStr = row.getAttribute('data-date');
      if (dateStr && dateStr.includes('/') && dateStr !== '-') {
        const parts = dateStr.split('/');
        if (parts.length === 3) {
          const key = `${parts[2]}-${parts[1]}`; // YYYY-MM
          monthsSet.add(key);
          const monthIndex = parseInt(parts[1], 10) - 1;
          monthLabels[key] = `${monthNamesBR[monthIndex]} / ${parts[2]}`;
        }
      }
    });

    // Ordenar chaves de forma decrescente
    const sortedKeys = Array.from(monthsSet).sort((a, b) => b.localeCompare(a));

    monthSelect.innerHTML = '<option value="all">Todos os meses</option>';
    sortedKeys.forEach(key => {
      const opt = document.createElement('option');
      opt.value = key;
      opt.textContent = monthLabels[key];
      if (key === currentMonthFilter) {
        opt.selected = true;
      }
      monthSelect.appendChild(opt);
    });
  }

  function applyGlobalDateFilters() {
    const monthSelect = document.getElementById('filter-period-month');
    const daySelect = document.getElementById('filter-period-day');
    if (!monthSelect || !daySelect) return;

    currentMonthFilter = monthSelect.value;
    currentDayFilter = daySelect.value;

    applyFilters();
    filterAccessTable();
  }

  function clearGlobalDateFilters() {
    const monthSelect = document.getElementById('filter-period-month');
    const daySelect = document.getElementById('filter-period-day');
    if (monthSelect) monthSelect.value = 'all';
    if (daySelect) daySelect.value = 'all';

    currentMonthFilter = 'all';
    currentDayFilter = 'all';

    applyFilters();
    filterAccessTable();
  }

  document.addEventListener('DOMContentLoaded', () => {
    const lastTab = localStorage.getItem('selected_eval_tab') || 'reviews';
    switchTab(lastTab);

    populateMonthFilter();
    applyGlobalDateFilters();
  });

  // Filtro de Avaliações por Tipo
  function filterReviews(type) {
    currentTypeFilter = type;
    const buttons = document.querySelectorAll('.filter-btn');
    
    // Atualizar botões
    buttons.forEach(btn => {
      btn.className = "filter-btn px-4 py-2 text-xs font-bold rounded-xl text-gray-600 hover:text-brand-dark hover:bg-gray-50 transition-all cursor-pointer";
    });
    
    document.getElementById('filter-' + type).className = "filter-btn px-4 py-2 text-xs font-bold rounded-xl transition-all cursor-pointer bg-brand-dark text-white";

    applyFilters();
  }

  // Busca e Filtro Unificado
  function applyFilters() {
    const cards = document.querySelectorAll('.review-card');
    const searchQuery = document.getElementById('code-search-input').value.trim().toLowerCase();
    const clearBtn = document.getElementById('clear-search');
    
    if (searchQuery) {
      clearBtn.classList.remove('hidden');
    } else {
      clearBtn.classList.add('hidden');
    }

    cards.forEach(card => {
      const cardType = card.getAttribute('data-type');
      const cardCode = (card.getAttribute('data-code') || '').toLowerCase();
      const cardName = (card.getAttribute('data-name') || '').toLowerCase();
      const cardDate = card.getAttribute('data-date') || '';

      const matchesType = (currentTypeFilter === 'all' || cardType === currentTypeFilter);
      const matchesSearch = (!searchQuery || cardCode.includes(searchQuery) || cardName.includes(searchQuery));
      
      let matchesMonth = true;
      let matchesDay = true;

      if (cardDate && cardDate.includes('/')) {
        const parts = cardDate.split('/');
        if (parts.length === 3) {
          const cardDay = parts[0];
          const cardMonthKey = `${parts[2]}-${parts[1]}`;
          
          if (currentMonthFilter !== 'all') {
            matchesMonth = (cardMonthKey === currentMonthFilter);
          }
          if (currentDayFilter !== 'all') {
            matchesDay = (cardDay === currentDayFilter);
          }
        }
      } else {
        if (currentMonthFilter !== 'all' || currentDayFilter !== 'all') {
          matchesMonth = false;
          matchesDay = false;
        }
      }

      if (matchesType && matchesSearch && matchesMonth && matchesDay) {
        card.classList.remove('hidden');
      } else {
        card.classList.add('hidden');
      }
    });
  }

  function searchReviews() {
    applyFilters();
  }

  function searchByCode(code) {
    switchTab('reviews');
    const input = document.getElementById('code-search-input');
    input.value = code;
    applyFilters();
    document.getElementById('reviews-list').scrollIntoView({ behavior: 'smooth' });
  }

  function clearSearch() {
    const input = document.getElementById('code-search-input');
    input.value = '';
    applyFilters();
  }

  function filterAccessTable() {
    const query = document.getElementById('access-search').value.trim().toLowerCase();
    const rows = document.querySelectorAll('.access-row');
    rows.forEach(row => {
      const code = (row.getAttribute('data-code') || '').toLowerCase();
      const name = (row.getAttribute('data-name') || '').toLowerCase();
      const createdDate = row.getAttribute('data-date') || '';

      const matchesSearch = (!query || code.includes(query) || name.includes(query));

      let matchesMonth = true;
      let matchesDay = true;

      if (createdDate && createdDate.includes('/')) {
        const parts = createdDate.split('/');
        if (parts.length === 3) {
          const rowDay = parts[0];
          const rowMonthKey = `${parts[2]}-${parts[1]}`;
          
          if (currentMonthFilter !== 'all') {
            matchesMonth = (rowMonthKey === currentMonthFilter);
          }
          if (currentDayFilter !== 'all') {
            matchesDay = (rowDay === currentDayFilter);
          }
        }
      } else {
        if (currentMonthFilter !== 'all' || currentDayFilter !== 'all') {
          matchesMonth = false;
          matchesDay = false;
        }
      }

      if (matchesSearch && matchesMonth && matchesDay) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });
  }

  function toggleTemplatesPanel() {
    const panel = document.getElementById('templates-config-panel');
    if (panel.classList.contains('hidden')) {
      panel.classList.remove('hidden');
      panel.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } else {
      panel.classList.add('hidden');
    }
  }

  function saveMessageTemplates() {
    const invite = document.getElementById('template-invite-input').value.trim();
    const reminder = document.getElementById('template-reminder-input').value.trim();
    const resultReady = document.getElementById('template-result-ready-input').value.trim();

    if (!invite || !reminder || !resultReady) {
      alert('Todos os três templates de mensagem devem ser preenchidos!');
      return;
    }

    if (!invite.includes('{link}') || !reminder.includes('{link}')) {
      if (!confirm('Atenção: Um ou ambos os templates de avaliação não contêm o marcador {link}. Sem esse marcador, o paciente não receberá o link para a pesquisa. Deseja salvar mesmo assim?')) {
        return;
      }
    }

    fetch('/api/avaliar/save-templates', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ invite, reminder, resultReady })
    })
    .then(r => r.json())
    .then(data => {
      if (data.success) {
        const toast = document.getElementById('toast-message');
        const originalText = toast.innerHTML;
        toast.innerHTML = `<svg class="w-4 h-4 text-brand-gold animate-bounce" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Templates salvos com sucesso!`;
        toast.classList.remove('translate-y-12', 'opacity-0');
        toast.classList.add('translate-y-0', 'opacity-100');
        
        setTimeout(() => {
          toast.classList.remove('translate-y-0', 'opacity-100');
          toast.classList.add('translate-y-12', 'opacity-0');
          setTimeout(() => {
            toast.innerHTML = originalText;
          }, 300);
        }, 3000);

        setTimeout(() => {
          document.getElementById('templates-config-panel').classList.add('hidden');
        }, 800);
      } else {
        alert('Erro ao salvar templates: ' + (data.error || 'Erro desconhecido'));
      }
    })
    .catch(err => {
      console.error('Erro ao salvar templates:', err);
      alert('Erro de conexão ao salvar templates.');
    });
  }

  // Filtragem de pacientes no gerador automático
  function filterGeneratorList() {
    const q = document.getElementById('msg-search-input').value.trim().toLowerCase();
    document.querySelectorAll('.generator-card').forEach(card => {
      const name = card.getAttribute('data-name') || '';
      const code = card.getAttribute('data-code') || '';
      if (name.includes(q) || code.includes(q)) {
        card.classList.remove('hidden');
      } else {
        card.classList.add('hidden');
      }
    });
  }

  // Alternar visualização do gerador manual
  function toggleManualGenerator() {
    const container = document.getElementById('manual-generator-container');
    const toggleIcon = document.getElementById('manual-toggle-icon');
    if (container.classList.contains('hidden')) {
      container.classList.remove('hidden');
      toggleIcon.textContent = '▲ recolher';
    } else {
      container.classList.add('hidden');
      toggleIcon.textContent = '▼ expandir';
    }
  }

  // Copiar Mensagem de Resultado Pronto
  function copyResultReadyMessage(name, code, username, password) {
    const templateElement = document.getElementById('template-result-ready-input');
    const template = templateElement ? templateElement.value : "Olá, {nome}! Seu resultado do exame do InovaLab já está disponível. Código da requisição: *{codigo}*. Usuário para acesso: *{usuario}* e Senha: *{senha}*.";
    
    let msg = template.replace(/{nome}/g, name);
    msg = msg.replace(/{codigo}/g, code);
    msg = msg.replace(/{usuario}/g, username);
    msg = msg.replace(/{senha}/g, password);

    copyToClipboard(msg);
  }

  // Copiar Mensagem de Convite para Avaliação
  function copyReviewInviteMessage(name, code) {
    const inviteTemplate = document.getElementById('template-invite-input').value;
    
    // Gerar link seguro na API
    fetch('/api/avaliar/gerar-link', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ patientCode: code, patientName: name })
    })
    .then(r => r.json())
    .then(data => {
      const link = data.link;
      let msg = inviteTemplate.replace('{link}', link);
      const namePlaceholder = name ? name : 'paciente';
      msg = msg.replace(/{nome}/g, namePlaceholder).replace(/{NOME}/g, namePlaceholder);
      copyToClipboard(msg);
    })
    .catch(err => {
      console.error('Erro ao gerar link com hash:', err);
      // Fallback
      const domain = window.location.origin;
      const link = `${domain}/avaliar/${code}`;
      let msg = inviteTemplate.replace('{link}', link);
      const namePlaceholder = name ? name : 'paciente';
      msg = msg.replace(/{nome}/g, namePlaceholder).replace(/{NOME}/g, namePlaceholder);
      copyToClipboard(msg);
    });
  }

  function sendInviteFromConversion(code, name, phone = '') {
    const domain = window.location.origin;
    const inviteTemplate = document.getElementById('template-invite-input').value;
    
    // Desativar clique duplo e indicar progresso
    const toast = document.getElementById('toast-message');
    const originalToastHTML = toast.innerHTML;
    toast.innerHTML = `<span class="flex items-center gap-1.5"><svg class="animate-spin h-3.5 w-3.5 text-brand-gold" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Gerando link seguro com hash...</span>`;
    toast.classList.remove('translate-y-12', 'opacity-0');
    toast.classList.add('translate-y-0', 'opacity-100');

    fetch('/api/avaliar/gerar-link', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ patientCode: code, patientName: name })
    })
    .then(r => r.json())
    .then(data => {
      const link = data.link;
      let msg = inviteTemplate.replace('{link}', link);
      const namePlaceholder = name ? name : 'paciente';
      msg = msg.replace(/{nome}/g, namePlaceholder).replace(/{NOME}/g, namePlaceholder);
      
      copyToClipboard(msg);

      // Marcar como convidado no backend
      fetch('/admin/requisicoes/mark-notified', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: code, type: 'invite' })
      })
      .then(() => {
        toast.innerHTML = `<svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Convite copiado! Atualizando status...`;
        
        if (phone) {
          const cleanPhone = phone.replace(/\D/g, '');
          const formattedPhone = (cleanPhone.length === 10 || cleanPhone.length === 11) ? '55' + cleanPhone : cleanPhone;
          if (formattedPhone) {
            window.open(`https://api.whatsapp.com/send?phone=${formattedPhone}&text=${encodeURIComponent(msg)}`, '_blank');
          }
        }
        
        setTimeout(() => {
          window.location.reload();
        }, 1500);
      })
      .catch(err => {
        console.error(err);
        setTimeout(() => { window.location.reload(); }, 1000);
      });
    })
    .catch(err => {
      console.error('Erro ao gerar link com hash:', err);
      const link = `${domain}/avaliar/${code}`;
      let msg = inviteTemplate.replace('{link}', link);
      const namePlaceholder = name ? name : 'paciente';
      msg = msg.replace(/{nome}/g, namePlaceholder).replace(/{NOME}/g, namePlaceholder);
      copyToClipboard(msg);
      toast.innerHTML = originalToastHTML;
    });
  }

  function shareWhatsAppWithCode(code, phone = '') {
    const domain = window.location.origin;
    const reminderTemplate = document.getElementById('template-reminder-input').value;
    
    fetch('/api/avaliar/obter-hash', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ patientCode: code })
    })
    .then(r => r.json())
    .then(data => {
      const hash = data.hash || code;
      const patientName = data.patientName || '';
      const link = `${domain}/avaliar/${hash}`;
      
      let msg = reminderTemplate.replace('{link}', link);
      const namePlaceholder = patientName ? patientName : 'paciente';
      msg = msg.replace(/{nome}/g, namePlaceholder).replace(/{NOME}/g, namePlaceholder);
      
      copyToClipboard(msg);

      if (phone) {
        const cleanPhone = phone.replace(/\D/g, '');
        const formattedPhone = (cleanPhone.length === 10 || cleanPhone.length === 11) ? '55' + cleanPhone : cleanPhone;
        if (formattedPhone) {
          setTimeout(() => {
            window.open(`https://api.whatsapp.com/send?phone=${formattedPhone}&text=${encodeURIComponent(msg)}`, '_blank');
          }, 300);
        }
      }
    })
    .catch(err => {
      console.error('Erro ao obter hash para cobrança:', err);
      // Fallback para o código comum
      const link = `${domain}/avaliar/${code}`;
      let msg = reminderTemplate.replace('{link}', link);
      msg = msg.replace(/{nome}/g, 'paciente').replace(/{NOME}/g, 'paciente');
      
      copyToClipboard(msg);
    });
  }

  // Copiar link e mensagem de WhatsApp Manual
  document.getElementById('copy-link-btn').addEventListener('click', () => {
    const domain = window.location.origin;
    const code = document.getElementById('generator-patient-code').value.trim();
    const name = document.getElementById('generator-patient-name').value.trim();
    const inviteTemplate = document.getElementById('template-invite-input').value;
    
    if (code) {
      // Desabilitar botão temporariamente para evitar cliques repetidos rápidos
      const btn = document.getElementById('copy-link-btn');
      const originalTextBtn = btn.innerHTML;
      btn.innerHTML = 'Gerando link...';
      btn.disabled = true;

      fetch('/api/avaliar/gerar-link', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ patientCode: code, patientName: name })
      })
      .then(r => r.json())
      .then(data => {
        btn.innerHTML = originalTextBtn;
        btn.disabled = false;
        
        const link = data.link;
        let msg = inviteTemplate.replace('{link}', link);
        const namePlaceholder = name ? name : 'paciente';
        msg = msg.replace(/{nome}/g, namePlaceholder).replace(/{NOME}/g, namePlaceholder);
        copyToClipboard(msg);

        // Limpar os campos do gerador para facilitar a rotatividade de pacientes
        document.getElementById('generator-patient-code').value = '';
        document.getElementById('generator-patient-name').value = '';
      })
      .catch(err => {
        btn.innerHTML = originalTextBtn;
        btn.disabled = false;
        console.error('Erro ao gerar link com hash:', err);
        // Fallback para o link comum
        const link = `${domain}/avaliar/${code}`;
        let msg = inviteTemplate.replace('{link}', link);
        const namePlaceholder = name ? name : 'paciente';
        msg = msg.replace(/{nome}/g, namePlaceholder).replace(/{NOME}/g, namePlaceholder);
        copyToClipboard(msg);
      });
    } else {
      const link = `${domain}/avaliar`;
      let msg = inviteTemplate.replace('{link}', link);
      const namePlaceholder = name ? name : 'paciente';
      msg = msg.replace(/{nome}/g, namePlaceholder).replace(/{NOME}/g, namePlaceholder);
      copyToClipboard(msg);
    }
  });

  function copyToClipboard(text) {
    navigator.clipboard.writeText(text).then(() => {
      const toast = document.getElementById('toast-message');
      toast.classList.remove('translate-y-12', 'opacity-0');
      toast.classList.add('translate-y-0', 'opacity-100');
      
      setTimeout(() => {
        toast.classList.remove('translate-y-0', 'opacity-100');
        toast.classList.add('translate-y-12', 'opacity-0');
      }, 3000);
    }).catch(err => {
      alert("Erro ao copiar: " + err);
    });
  }
</script>

