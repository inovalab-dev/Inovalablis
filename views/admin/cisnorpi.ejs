<script>
  // Variáveis globais para armazenar os dados importados do Excel
  let parsedExcelData = null;
  let excelHeaders = [];

  // Alternar entre as abas Cadastro Manual / Importar Planilha
  function switchTab(tab) {
    const tabManualBtn = document.getElementById('tab-manual-btn');
    const tabImportBtn = document.getElementById('tab-import-btn');
    const tabContentManual = document.getElementById('tab-content-manual');
    const tabContentImport = document.getElementById('tab-content-import');

    if (tab === 'manual') {
      tabManualBtn.className = "px-4 py-2 text-xs font-bold font-mono uppercase tracking-wider rounded-lg text-[#284701] bg-white shadow-sm transition-all cursor-pointer";
      tabImportBtn.className = "px-4 py-2 text-xs font-bold font-mono uppercase tracking-wider rounded-lg text-gray-500 hover:text-gray-700 transition-all flex items-center gap-1.5 cursor-pointer";
      tabContentManual.classList.remove('hidden');
      tabContentImport.classList.add('hidden');
    } else {
      tabManualBtn.className = "px-4 py-2 text-xs font-bold font-mono uppercase tracking-wider rounded-lg text-gray-500 hover:text-gray-700 transition-all cursor-pointer";
      tabImportBtn.className = "px-4 py-2 text-xs font-bold font-mono uppercase tracking-wider rounded-lg text-[#284701] bg-white shadow-sm transition-all flex items-center gap-1.5 cursor-pointer";
      tabContentManual.classList.add('hidden');
      tabContentImport.classList.remove('hidden');
      
      // Registrar ouvintes de Drag & Drop se ainda não registrados
      initDragAndDrop();
    }
  }

  // Inicializar suporte a Drag & Drop no dropzone
  function initDragAndDrop() {
    const dropzone = document.getElementById('import-dropzone');
    if (dropzone && !dropzone.dataset.dragInit) {
      dropzone.dataset.dragInit = "true";
      
      ['dragenter', 'dragover'].forEach(eventName => {
        dropzone.addEventListener(eventName, e => {
          e.preventDefault();
          dropzone.classList.add('border-[#284701]', 'bg-green-50/20');
        }, false);
      });

      ['dragleave', 'drop'].forEach(eventName => {
        dropzone.addEventListener(eventName, e => {
          e.preventDefault();
          dropzone.classList.remove('border-[#284701]', 'bg-green-50/20');
        }, false);
      });

      dropzone.addEventListener('drop', e => {
        const dt = e.dataTransfer;
        const files = dt.files;
        if (files.length) {
          document.getElementById('excel-file-input').files = files;
          handleExcelUpload({ target: { files: files } });
        }
      }, false);
    }
  }

  // Processar o upload e parsing do Excel/CSV
  function handleExcelUpload(event) {
    const file = event.target.files[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = function(e) {
      try {
        const data = new Uint8Array(e.target.result);
        const workbook = XLSX.read(data, { type: 'array' });
        const firstSheetName = workbook.SheetNames[0];
        const worksheet = workbook.Sheets[firstSheetName];
        
        // Obter dados estruturados como array bidimensional (linhas e colunas)
        const jsonData = XLSX.utils.sheet_to_json(worksheet, { header: 1 });
        if (jsonData.length < 2) {
          alert("A planilha parece estar vazia ou não contém dados suficientes.");
          return;
        }

        // Cabeçalhos (primeira linha)
        excelHeaders = jsonData[0].map(h => String(h || '').trim());
        
        // Linhas de dados (filtramos vazias)
        parsedExcelData = jsonData.slice(1).filter(row => row.some(cell => cell !== null && cell !== undefined && cell !== ''));

        if (parsedExcelData.length === 0) {
          alert("Planilha não possui registros válidos de exames.");
          return;
        }

        document.getElementById('import-filename').innerText = file.name;
        document.getElementById('import-total-rows').innerText = parsedExcelData.length + " exames encontrados";

        // Preencher seletores de mapeamento das colunas
        setupMappingDropdowns();
        
        // Mostrar seção de processamento e esconder o Dropzone
        document.getElementById('import-dropzone').classList.add('hidden');
        document.getElementById('import-parser-section').classList.remove('hidden');

        // Atualizar a visualização prévia da tabela
        updateImportPreview();
      } catch (err) {
        console.error("Erro ao ler arquivo:", err);
        alert("Ocorreu um erro ao processar esta planilha. Certifique-se de que o arquivo não esteja corrompido.");
      }
    };
    reader.readAsArrayBuffer(file);
  }

  // Auto-mapear cabeçalhos comuns e preencher seletores dropdown
  function setupMappingDropdowns() {
    const mappings = {
      'map_codJalis': ['jalis', 'cod jalis', 'codigo jalis', 'cod. jalis', 'código jalis', 'codjalis'],
      'map_codCisnorpi': ['cisnorpi', 'cod cisnorpi', 'codigo cisnorpi', 'cod. cisnorpi', 'código cisnorpi', 'codcisnorpi', 'tabela cisnorpi'],
      'map_codAlvaro': ['alvaro', 'cod alvaro', 'codigo alvaro', 'cod. alvaro', 'código alvaro', 'codalvaro'],
      'map_codPardini': ['pardini', 'hermes pardini', 'cod pardini', 'cod. pardini', 'codpardini'],
      'map_name': ['nome', 'exame', 'descricao', 'descrição', 'procedimento', 'nome do exame', 'nome_exame', 'procedimentos'],
      'map_priceCisnorpi': ['valor', 'preco', 'preço', 'valor cisnorpi', 'preco cisnorpi', 'preço cisnorpi', 'valores', 'custo']
    };

    for (const [selectId, keywords] of Object.entries(mappings)) {
      const select = document.getElementById(selectId);
      select.innerHTML = '<option value="">-- Ignorar ou Não Consta --</option>';
      
      let matchedIndex = -1;
      excelHeaders.forEach((header, idx) => {
        const option = document.createElement('option');
        option.value = idx;
        option.innerText = header;
        select.appendChild(option);

        // Algoritmo de auto-detecção por palavra-chave aproximada
        const headerLower = header.toLowerCase();
        if (matchedIndex === -1 && keywords.some(kw => headerLower === kw || headerLower.includes(kw))) {
          matchedIndex = idx;
        }
      });

      // Selecionar por padrão se detectado automaticamente
      if (matchedIndex !== -1) {
        select.value = matchedIndex;
      }
    }
  }

  // Atualizar a visualização dinâmica (amostra de 5 linhas)
  function updateImportPreview() {
    const mapJalisIdx = document.getElementById('map_codJalis').value;
    const mapCisnorpiIdx = document.getElementById('map_codCisnorpi').value;
    const mapAlvaroIdx = document.getElementById('map_codAlvaro').value;
    const mapPardiniIdx = document.getElementById('map_codPardini').value;
    const mapNameIdx = document.getElementById('map_name').value;
    const mapPriceIdx = document.getElementById('map_priceCisnorpi').value;

    const tbody = document.getElementById('import-preview-tbody');
    tbody.innerHTML = '';

    // Amostra dos primeiros 5 exames
    const previewRows = parsedExcelData.slice(0, 5);
    
    previewRows.forEach(row => {
      const tr = document.createElement('tr');
      tr.className = "border-b border-gray-100 hover:bg-gray-50/50";

      const valJalis = mapJalisIdx !== "" ? (row[mapJalisIdx] !== undefined ? row[mapJalisIdx] : '') : '-';
      const valCisnorpi = mapCisnorpiIdx !== "" ? (row[mapCisnorpiIdx] !== undefined ? row[mapCisnorpiIdx] : '') : '-';
      const valAlvaro = mapAlvaroIdx !== "" ? (row[mapAlvaroIdx] !== undefined ? row[mapAlvaroIdx] : '') : '-';
      const valPardini = mapPardiniIdx !== "" ? (row[mapPardiniIdx] !== undefined ? row[mapPardiniIdx] : '') : '-';
      const valName = mapNameIdx !== "" ? (row[mapNameIdx] !== undefined ? row[mapNameIdx] : '') : '-';
      
      let valPrice = '-';
      if (mapPriceIdx !== "") {
        const rawPrice = row[mapPriceIdx];
        if (rawPrice !== undefined && rawPrice !== null) {
          if (typeof rawPrice === 'number') {
            valPrice = "R$ " + rawPrice.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
          } else {
            valPrice = String(rawPrice);
          }
        }
      }

      tr.innerHTML = `
        <td class="py-2.5 px-4 font-mono font-bold text-gray-500">${valJalis}</td>
        <td class="py-2.5 px-4 font-mono font-bold text-brand-dark">${valCisnorpi}</td>
        <td class="py-2.5 px-4 font-mono text-gray-500">${valAlvaro}</td>
        <td class="py-2.5 px-4 font-mono text-gray-500">${valPardini}</td>
        <td class="py-2.5 px-4 font-semibold text-gray-800">${valName}</td>
        <td class="py-2.5 px-4 text-right font-mono font-bold text-brand-dark">${valPrice}</td>
      `;
      tbody.appendChild(tr);
    });
  }

  // Cancelar importação atual e voltar ao Dropzone
  function resetImport() {
    parsedExcelData = null;
    excelHeaders = [];
    document.getElementById('excel-file-input').value = '';
    document.getElementById('import-dropzone').classList.remove('hidden');
    document.getElementById('import-parser-section').classList.add('hidden');
  }

  // Enviar os dados mapeados para o servidor em lote
  async function submitImport() {
    const mapJalisIdx = document.getElementById('map_codJalis').value;
    const mapCisnorpiIdx = document.getElementById('map_codCisnorpi').value;
    const mapAlvaroIdx = document.getElementById('map_codAlvaro').value;
    const mapPardiniIdx = document.getElementById('map_codPardini').value;
    const mapNameIdx = document.getElementById('map_name').value;
    const mapPriceIdx = document.getElementById('map_priceCisnorpi').value;

    // Nome do Exame e Preço são campos absolutamente obrigatórios
    if (mapNameIdx === "") {
      alert("Por favor, selecione qual coluna da planilha corresponde ao 'Nome do Exame'!");
      return;
    }
    if (mapPriceIdx === "") {
      alert("Por favor, selecione qual coluna da planilha corresponde ao 'Valor Cisnorpi'!");
      return;
    }

    const replaceStrategy = document.getElementById('strategy-replace').checked;
    
    // Mapeamento final
    const mappedItems = parsedExcelData.map(row => {
      return {
        codJalis: mapJalisIdx !== "" ? row[mapJalisIdx] : "",
        codCisnorpi: mapCisnorpiIdx !== "" ? row[mapCisnorpiIdx] : "",
        codAlvaro: mapAlvaroIdx !== "" ? row[mapAlvaroIdx] : "",
        codPardini: mapPardiniIdx !== "" ? row[mapPardiniIdx] : "",
        name: mapNameIdx !== "" ? row[mapNameIdx] : "",
        priceCisnorpi: mapPriceIdx !== "" ? row[mapPriceIdx] : 0
      };
    }).filter(item => item.name && String(item.name).trim() !== "");

    if (mappedItems.length === 0) {
      alert("Não foi encontrado nenhum exame válido (com nome preenchido) na planilha.");
      return;
    }

    const confirmMsg = replaceStrategy 
      ? `ALERTA CRÍTICO: Esta ação excluirá permanentemente todos os registros atuais da Tabela Cisnorpi e importará os novos ${mappedItems.length} registros. Tem certeza que deseja prosseguir?`
      : `Confirma a importação de ${mappedItems.length} exames para a tabela atual?`;

    if (!confirm(confirmMsg)) return;

    const btnSubmit = document.getElementById('confirm-import-btn');
    const btnCancel = document.getElementById('cancel-import-btn');
    
    btnSubmit.disabled = true;
    btnCancel.disabled = true;
    btnSubmit.innerText = "Sincronizando com o Servidor...";

    try {
      const response = await fetch('/admin/cisnorpi/import', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          items: mappedItems,
          replace: replaceStrategy
        })
      });

      const result = await response.json();
      if (result.success) {
        alert(`${result.count} exames importados e catalogados com sucesso!`);
        window.location.reload();
      } else {
        alert("Erro ao realizar importação: " + (result.message || "Erro de resposta desconhecido."));
        btnSubmit.disabled = false;
        btnCancel.disabled = false;
        btnSubmit.innerHTML = `
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          <span>Confirmar e Importar</span>
        `;
      }
    } catch (err) {
      console.error("Erro ao enviar dados mapeados:", err);
      alert("Falha ao comunicar com o servidor. Verifique sua conexão de rede.");
      btnSubmit.disabled = false;
      btnCancel.disabled = false;
      btnSubmit.innerHTML = `
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
        <span>Confirmar e Importar</span>
      `;
    }
  }


  // ==========================================
  // LISTAGEM, EDICÃO E EXCLUSÃO
  // ==========================================

  // Filtragem local/instantânea em tempo real na listagem
  function filterCisnorpiTable() {
    const searchVal = document.getElementById('cisnorpiSearchInput').value.toLowerCase().trim();
    const rows = document.querySelectorAll('.cisnorpi-row');
    const emptyRow = document.getElementById('empty-row');
    const noResultsRow = document.getElementById('no-search-results');
    
    let visibleCount = 0;
    
    rows.forEach(row => {
      const jalis = (row.dataset.jalis || '').toLowerCase();
      const cisnorpi = (row.dataset.cisnorpi || '').toLowerCase();
      const alvaro = (row.dataset.alvaro || '').toLowerCase();
      const pardini = (row.dataset.pardini || '').toLowerCase();
      const name = (row.dataset.name || '').toLowerCase();
      
      const match = !searchVal || 
                    jalis.includes(searchVal) || 
                    cisnorpi.includes(searchVal) || 
                    alvaro.includes(searchVal) || 
                    pardini.includes(searchVal) || 
                    name.includes(searchVal);
                    
      if (match) {
        row.classList.remove('hidden');
        visibleCount++;
      } else {
        row.classList.add('hidden');
      }
    });

    if (emptyRow) {
      return;
    }

    if (visibleCount === 0) {
      noResultsRow.classList.remove('hidden');
    } else {
      noResultsRow.classList.add('hidden');
    }
  }

  // Abrir o Modal de Edição preenchido
  function openEditModal(itemJsonString) {
    try {
      const item = JSON.parse(itemJsonString);
      
      document.getElementById('edit_id').value = item.id;
      document.getElementById('edit_codJalis').value = item.codJalis || '';
      document.getElementById('edit_codCisnorpi').value = item.codCisnorpi || '';
      document.getElementById('edit_codAlvaro').value = item.codAlvaro || '';
      document.getElementById('edit_codPardini').value = item.codPardini || '';
      document.getElementById('edit_name').value = item.name || '';
      document.getElementById('edit_priceCisnorpi').value = item.priceCisnorpi || 0;
      
      // Mostrar modal removendo class hidden
      document.getElementById('editCisnorpiModal').classList.remove('hidden');
    } catch (err) {
      console.error("Erro ao abrir modal de edição:", err);
    }
  }

  // Fechar o Modal de Edição
  function closeEditModal() {
    document.getElementById('editCisnorpiModal').classList.add('hidden');
  }
</script>

