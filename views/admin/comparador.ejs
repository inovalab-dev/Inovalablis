          <select id="select-col-name" onchange="onMappingChanged()" class="w-full bg-white border border-brand-light/15 rounded-lg px-2.5 py-1.5 text-xs font-bold text-brand-dark focus:ring-emerald-500 focus:border-emerald-500 cursor-pointer shadow-sm">
