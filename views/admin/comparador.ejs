      <button onclick="setActiveTab('pardini')" id="tab-btn-pardini" class="flex-1 sm:flex-none flex items-center justify-center gap-3 px-8 py-4 text-sm font-extrabold uppercase font-mono tracking-wider border-b-2 transition-all duration-300 cursor-pointer">
