    <!-- LISTAGEM DE PREÇOS CADASTRADOS DA TABELA ATIVA -->
    <div class="bg-white rounded-3xl border border-brand-light/15 overflow-hidden shadow-sm">
      
      <!-- Topo da Tabela de Cadastrados -->
      <div class="px-6 py-5 border-b border-brand-light/10 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-brand-softBg/20">
        <div>
          <h2 class="text-base font-extrabold text-brand-dark font-mono uppercase tracking-wider flex items-center gap-2">
            <span id="active-table-indicator-dot" class="w-3 h-3 rounded-full"></span>
            Listagem de Itens: <span id="active-lab-title-name" class="text-emerald-700">Álvaro Apoio</span>
          </h2>
          <p class="text-[11px] text-gray-500 mt-0.5">Exibe todos os códigos, nomes e preços de custo importados para esta tabela.</p>
        </div>
        
