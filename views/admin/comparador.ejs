            <textarea id="paste-csv-area" rows="4" placeholder="COD301;Hemograma Completo;12.50&#10;COD302;Glicose de Jejum;6.20" class="w-full px-4 py-3 rounded-xl border border-brand-light/30 focus:outline-none bg-brand-neutralLight text-xs font-mono"></textarea>
