      <!-- Blank State Container -->
      <div id="catalog-blank-state" class="hidden py-12 text-center max-w-md mx-auto space-y-3">
        <div class="inline-block p-4 bg-gray-100 rounded-full text-gray-400">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        </div>
