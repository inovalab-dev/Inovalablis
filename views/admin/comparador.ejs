<script>
  // Dados de laboratórios e exames vindos do Express
  const labsList = <%- JSON.stringify(labs) %>;
  const localExams = <%- JSON.stringify(exams) %>;

  let currentParsedRows = []; 
  let activeImportExams = []; 
  let activeLabId = "1"; // "1" = Alvaro, "2" = Pardini

  // Configuração das abas e laboratórios
  const labsConfig = {
    "alvaro": {
      id: "1",
      name: "Álvaro Apoio",
      desc: "Laboratório de apoio especializado. Sincronize preços de custo usando a planilha oficial do Álvaro.",
      colorClass: "bg-emerald-500",
      borderColor: "border-emerald-500",
      textColor: "text-emerald-700",
      cardBorder: "border-emerald-100 bg-emerald-50/20"
    },
    "pardini": {
      id: "2",
      name: "Hermes Pardini",
      desc: "Grupo Hermes Pardini. Sincronize preços de custo usando a planilha oficial do Pardini.",
      colorClass: "bg-indigo-500",
      borderColor: "border-indigo-500",
      textColor: "text-indigo-700",
      cardBorder: "border-indigo-100 bg-indigo-50/20"
    }
  };

  function setActiveTab(tabKey) {
    const config = labsConfig[tabKey];
    if (!config) return;

    activeLabId = config.id;

    // Atualiza botões de aba
    const btnAlvaro = document.getElementById('tab-btn-alvaro');
    const btnPardini = document.getElementById('tab-btn-pardini');

    if (tabKey === 'alvaro') {
      btnAlvaro.className = "flex-1 sm:flex-none flex items-center justify-center gap-3 px-8 py-4 text-sm font-extrabold uppercase font-mono tracking-wider border-b-2 border-emerald-500 text-emerald-700 bg-white shadow-sm rounded-t-2xl cursor-pointer";
      btnPardini.className = "flex-1 sm:flex-none flex items-center justify-center gap-3 px-8 py-4 text-sm font-bold uppercase font-mono tracking-wider border-b-2 border-transparent text-gray-400 hover:text-gray-600 cursor-pointer";
    } else {
      btnAlvaro.className = "flex-1 sm:flex-none flex items-center justify-center gap-3 px-8 py-4 text-sm font-bold uppercase font-mono tracking-wider border-b-2 border-transparent text-gray-400 hover:text-gray-600 cursor-pointer";
      btnPardini.className = "flex-1 sm:flex-none flex items-center justify-center gap-3 px-8 py-4 text-sm font-extrabold uppercase font-mono tracking-wider border-b-2 border-indigo-500 text-indigo-700 bg-white shadow-sm rounded-t-2xl cursor-pointer";
    }

    // Atualiza o subtítulo de importação
    document.getElementById('active-lab-import-subtitle').innerText = config.name;
    
    // Altera a cor do dot do subtítulo
    const dotEl = document.getElementById('active-lab-dot');
    dotEl.className = `w-2.5 h-2.5 rounded-full ${config.colorClass}`;

    // Altera o indicador do topo da listagem
    const listDotEl = document.getElementById('active-table-indicator-dot');
    listDotEl.className = `w-3 h-3 rounded-full ${config.colorClass}`;

    // Atualiza o card informativo lateral
    const infoCard = document.getElementById('active-lab-card-info');
    infoCard.className = `rounded-3xl border p-6 shadow-sm space-y-4 transition-all duration-300 ${config.cardBorder}`;
    document.getElementById('active-lab-info-name').innerText = config.name;
    document.getElementById('active-lab-info-desc').innerText = config.desc;

    // Atualiza o título da listagem
    const titleEl = document.getElementById('active-lab-title-name');
    titleEl.innerText = config.name;
    titleEl.className = config.textColor;

    // Limpa estado de importação anterior se houver
    cancelImportPreview();

    // Renderiza listagem de preços
    renderCatalogPrices();
  }

  // Trigger file select click
  function triggerFileSelect() {
    document.getElementById('file-input').click();
  }

  // Handle file import
  function handleFileImport(event) {
    const file = event.target.files[0];
    if (file) {
      processUploadedFile(file);
    }
  }

  // Parse price values cleanly
  function parsePriceValue(val) {
    if (val === undefined || val === null) return 0;
    if (typeof val === 'number') return val;
    
    let str = String(val).replace('R$', '').replace(/\s/g, '').trim();
    if (!str) return 0;

    if (str.includes(',') && str.includes('.')) {
      const lastComma = str.lastIndexOf(',');
      const lastDot = str.lastIndexOf('.');
      if (lastComma > lastDot) {
        str = str.replace(/\./g, '').replace(',', '.');
      } else {
        str = str.replace(/,/g, '');
      }
    } else if (str.includes(',')) {
      str = str.replace(',', '.');
    } else if (str.includes('.')) {
      const parts = str.split('.');
      const lastPart = parts[parts.length - 1];
      if (lastPart.length === 3 && parts[0].length > 0) {
        str = str.replace(/\./g, '');
      }
    }
    
    const num = parseFloat(str);
    return isNaN(num) ? 0 : num;
  }

  // Process uploaded file
  async function processUploadedFile(file) {
    if (!file) return;

    const dropZone = document.getElementById('drop-zone');
    const originalContent = dropZone.innerHTML;
    
    dropZone.innerHTML = `
      <div class="flex items-center justify-center gap-2 text-brand-dark">
        <svg class="animate-spin h-4 w-4 text-brand-dark inline-block" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span class="text-xs font-bold">Lendo e mapeando arquivo...</span>
      </div>
    `;

    try {
      const skipRowsInput = document.getElementById('import-skip-rows');
      const skipRows = skipRowsInput ? skipRowsInput.value : '0';

      const formData = new FormData();
      formData.append('file', file);
      formData.append('skipRows', skipRows);

      const response = await fetch('/admin/exames/parse', {
        method: 'POST',
        body: formData
      });

      const result = await response.json();
      if (!result.success) {
        throw new Error(result.message || 'Erro ao processar planilha no servidor.');
      }

      dropZone.innerHTML = originalContent;

      currentParsedRows = result.rows || [];
      const indices = result.mappedIndices || { codeCol: 0, nameCol: 1, priceCol: 2 };
      const firstRow = result.firstRow || [];

      // Exibe pré-visualização
      const previewSection = document.getElementById('import-preview-section');
      previewSection.classList.remove('hidden');

      // Popula dropdowns De-Para
      populateDropdowns(firstRow, indices);

      // Reprocessa linhas com mapeamento inicial
      onMappingChanged();

      previewSection.scrollIntoView({ behavior: 'smooth' });

    } catch (err) {
      console.error(err);
      alert("Erro ao processar planilha: " + err.message);
      document.getElementById('file-input').value = '';
      dropZone.innerHTML = originalContent;
    }
  }

  // Paste CSV manually
  function importPastedCSV() {
    const text = document.getElementById('paste-csv-area').value;
    if (!text.trim()) {
      alert("Por favor, cole dados válidos antes de processar.");
      return;
    }
    
    const lines = text.split('\n');
    const parsedRows = [];
    
    parsedRows.push(["Código do Apoio", "Nome do Exame", "Preço do Apoio"]);
    
    lines.forEach(line => {
      if (!line.trim()) return;
      const cleanLine = line.replace(/"/g, '');
      const parts = cleanLine.split(';');
      if (parts.length < 3) return;
      
      parsedRows.push([
        parts[0] ? parts[0].trim() : '',
        parts[1] ? parts[1].trim() : '',
        parts[2] ? parts[2].trim() : ''
      ]);
    });
    
    if (parsedRows.length <= 1) {
      alert("Nenhum dado válido encontrado. Utilize o formato: Código;Nome;Preço");
      return;
    }
    
    currentParsedRows = parsedRows;
    const firstRow = parsedRows[0];
    const indices = { codeCol: 0, nameCol: 1, priceCol: 2 };
    
    document.getElementById('import-preview-section').classList.remove('hidden');
    populateDropdowns(firstRow, indices);
    onMappingChanged();
    
    document.getElementById('paste-csv-area').value = '';
    document.getElementById('import-preview-section').scrollIntoView({ behavior: 'smooth' });
  }

  // Get Excel Column letters dynamically
  function getColumnLetter(colIndex) {
    let temp = colIndex;
    let letter = '';
    while (temp >= 0) {
      letter = String.fromCharCode((temp % 26) + 65) + letter;
      temp = Math.floor(temp / 26) - 1;
    }
    return letter;
  }

  // Populate drop-downs for mapping columns
  function populateDropdowns(firstRow, indices) {
    const codeSelect = document.getElementById('select-col-code');
    const nameSelect = document.getElementById('select-col-name');
    const priceSelect = document.getElementById('select-col-price');

    if (!codeSelect || !nameSelect || !priceSelect) return;

    codeSelect.innerHTML = '';
    nameSelect.innerHTML = '';
    priceSelect.innerHTML = '';

    const maxCols = Math.max(firstRow.length, 10);

    for (let idx = 0; idx < maxCols; idx++) {
      const colLetter = getColumnLetter(idx);
      const headerName = firstRow[idx] ? String(firstRow[idx]).trim() : '';
      const optionText = headerName ? `${colLetter} - "${headerName}"` : `${colLetter} (coluna vazia)`;

      codeSelect.add(new Option(optionText, idx));
      nameSelect.add(new Option(optionText, idx));
      priceSelect.add(new Option(optionText, idx));
    }

    codeSelect.value = indices.codeCol !== undefined ? indices.codeCol : 0;
    nameSelect.value = indices.nameCol !== undefined ? indices.nameCol : 1;
    priceSelect.value = indices.priceCol !== undefined ? indices.priceCol : 2;
  }

  function onMappingChanged() {
    const codeCol = parseInt(document.getElementById('select-col-code').value);
    const nameCol = parseInt(document.getElementById('select-col-name').value);
    const priceCol = parseInt(document.getElementById('select-col-price').value);

    reprocessRowsWithMapping(codeCol, nameCol, priceCol);
  }

  function reprocessRowsWithMapping(codeCol, nameCol, priceCol) {
    if (!currentParsedRows || currentParsedRows.length < 2) return;

    const validExams = [];

    for (let i = 1; i < currentParsedRows.length; i++) {
      const row = currentParsedRows[i];
      if (!row || row.length === 0) continue;

      const codeVal = codeCol !== -1 && row[codeCol] !== undefined && row[codeCol] !== null ? String(row[codeCol]).trim() : '';
      const nameVal = nameCol !== -1 && row[nameCol] !== undefined && row[nameCol] !== null ? String(row[nameCol]).trim() : '';
      const priceVal = row[priceCol];

      if (!nameVal) continue;

      const priceNum = parsePriceValue(priceVal);

      validExams.push({
        code: codeVal,
        name: nameVal,
        price: priceNum
      });
    }

    activeImportExams = validExams;
    renderImportPreview();
  }

  function renderImportPreview() {
    const tbody = document.getElementById('import-preview-tbody');
    tbody.innerHTML = '';

    if (activeImportExams.length === 0) {
      tbody.innerHTML = `<tr><td colspan="3" class="py-4 text-center text-gray-400 italic">Nenhum registro elegível encontrado.</td></tr>`;
      document.getElementById('confirm-import-btn').disabled = true;
      document.getElementById('confirm-import-btn').classList.add('opacity-50', 'cursor-not-allowed');
    } else {
      document.getElementById('confirm-import-btn').disabled = false;
      document.getElementById('confirm-import-btn').classList.remove('opacity-50', 'cursor-not-allowed');

      activeImportExams.slice(0, 15).forEach(item => {
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-brand-softBg/10 border-b border-brand-light/5 text-xs';
        tr.innerHTML = `
          <td class="py-2.5 px-4 font-mono font-bold text-gray-600">${item.code || '<span class="text-gray-300 font-normal italic">vazio</span>'}</td>
          <td class="py-2.5 px-4 font-extrabold text-brand-dark">${item.name}</td>
          <td class="py-2.5 px-4 text-right font-mono font-bold text-emerald-700">R$ ${item.price.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}</td>
        `;
        tbody.appendChild(tr);
      });

      if (activeImportExams.length > 15) {
        const trMore = document.createElement('tr');
        trMore.className = 'text-[11px] text-gray-400 italic bg-gray-50/30';
        trMore.innerHTML = `
          <td colspan="3" class="py-2 px-4 text-center">... e mais ${activeImportExams.length - 15} exames nesta planilha ...</td>
        `;
        tbody.appendChild(trMore);
      }
    }

    document.getElementById('preview-total-count').innerText = activeImportExams.length;
  }

  function cancelImportPreview() {
    activeImportExams = [];
    currentParsedRows = [];
    document.getElementById('import-preview-section').classList.add('hidden');
    document.getElementById('file-input').value = '';
  }

  // Enviar preços mapeados para salvar no laboratório correspondente
  async function confirmImportPreview() {
    if (activeImportExams.length === 0) return;

    const labName = activeLabId === "1" ? "Álvaro Apoio" : "Hermes Pardini";
    
    const btn = document.getElementById('confirm-import-btn');
    const originalText = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = `<span>Importando ${activeImportExams.length} itens...</span>`;

    try {
      const response = await fetch('/admin/comparador/import-precos', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          lab: labName,
          items: activeImportExams
        })
      });

      const result = await response.json();
      if (result.success) {
        alert(`Sucesso! ${result.count} preços foram cadastrados com sucesso para a tabela do "${labName}".`);
        window.location.reload();
      } else {
        alert("Erro ao salvar preços: " + (result.message || "Erro desconhecido"));
        btn.disabled = false;
        btn.innerHTML = originalText;
      }
    } catch (err) {
      console.error(err);
      alert("Erro de conexão ao salvar preços.");
      btn.disabled = false;
      btn.innerHTML = originalText;
    }
  }

  // Renderiza a listagem dos preços cadastrados na aba ativa
  function renderCatalogPrices() {
    const tbody = document.getElementById('catalog-prices-tbody');
    const blankState = document.getElementById('catalog-blank-state');
    const tableEl = document.getElementById('catalog-prices-table');
    
    tbody.innerHTML = '';

    const lab = labsList.find(l => String(l.id) === String(activeLabId));
    
    // Atualiza estatísticas do card lateral informativo
    const infoCountEl = document.getElementById('active-lab-info-count');
    const pricesCount = (lab && lab.prices) ? Object.keys(lab.prices).length : 0;
    infoCountEl.innerText = `${pricesCount} exame${pricesCount === 1 ? '' : 's'} cadastrado${pricesCount === 1 ? '' : 's'}`;

    if (!lab || !lab.prices || Object.keys(lab.prices).length === 0) {
      blankState.classList.remove('hidden');
      tableEl.classList.add('hidden');
      return;
    }

    blankState.classList.add('hidden');
    tableEl.classList.remove('hidden');

    const searchVal = document.getElementById('catalog-search-input').value.toLowerCase().trim();

    let count = 0;
    Object.keys(lab.prices).forEach(codeKey => {
      const item = lab.prices[codeKey];
      const codeUpper = codeKey.toUpperCase();
      const nameLower = item.name.toLowerCase();

      if (searchVal && !codeUpper.includes(searchVal) && !nameLower.includes(searchVal)) {
        return;
      }

      const tr = document.createElement('tr');
      tr.className = 'hover:bg-brand-softBg/10 transition-colors text-xs border-b border-gray-100';
      tr.innerHTML = `
        <td class="py-3.5 px-6 font-mono font-bold text-gray-500">${codeUpper}</td>
        <td class="py-3.5 px-6 font-bold text-brand-dark">${item.name}</td>
        <td class="py-3.5 px-6 text-right font-mono font-extrabold text-emerald-700 text-sm">R$ ${parseFloat(item.price).toLocaleString('pt-BR', { minimumFractionDigits: 2 })}</td>
        <td class="py-3.5 px-6 text-center">
          <div class="flex items-center justify-center gap-2">
            <!-- Botão Editar -->
            <button onclick="openEditPriceModal('${codeKey}')" title="Editar Preço" class="p-1.5 hover:bg-gray-100 text-gray-500 hover:text-brand-dark rounded-lg transition-colors cursor-pointer">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10"/></svg>
            </button>
            <!-- Botão Excluir -->
            <button onclick="deletePriceItem('${codeKey}')" title="Excluir Preço" class="p-1.5 hover:bg-rose-50 text-gray-500 hover:text-rose-600 rounded-lg transition-colors cursor-pointer">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            </button>
          </div>
        </td>
      `;
      tbody.appendChild(tr);
      count++;
    });

    if (count === 0) {
      tbody.innerHTML = `<tr><td colspan="3" class="py-6 text-center text-gray-400 italic">Nenhum item corresponde à busca efetuada.</td></tr>`;
    }
  }

  function applyCatalogFilter() {
    renderCatalogPrices();
  }

  // Limpar catálogo de preços da tabela ativa
  async function clearActiveLabPrices() {
    const labName = activeLabId === "1" ? "Álvaro Apoio" : "Hermes Pardini";
    
    if (!confirm(`ATENÇÃO! Deseja realmente limpar TODOS os preços importados para a "${labName}"? Esta ação não pode ser desfeita.`)) {
      return;
    }

    try {
      const response = await fetch('/admin/comparador/clear-precos', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ labId: activeLabId })
      });

      const result = await response.json();
      if (result.success) {
        alert(`Sucesso! Todos os preços da tabela "${labName}" foram excluídos.`);
        window.location.reload();
      } else {
        alert("Erro ao excluir preços: " + (result.message || "Erro desconhecido"));
      }
    } catch (err) {
      console.error(err);
      alert("Falha de comunicação com o servidor.");
    }
  }



  // Modal de Adicionar / Editar preço
  function openAddPriceModal() {
    const labName = activeLabId === "1" ? "Álvaro Apoio" : "Hermes Pardini";
    document.getElementById('modal-title').innerText = "Adicionar Preço de Custo";
    document.getElementById('modal-subtitle').innerText = "Tabela: " + labName;
    document.getElementById('modal-old-code').value = "";
    document.getElementById('modal-code').value = "";
    document.getElementById('modal-code').disabled = false;
    document.getElementById('modal-name').value = "";
    document.getElementById('modal-price').value = "";
    
    document.getElementById('price-modal').classList.remove('hidden');
  }

  function openEditPriceModal(codeKey) {
    const labName = activeLabId === "1" ? "Álvaro Apoio" : "Hermes Pardini";
    const lab = labsList.find(l => String(l.id) === String(activeLabId));
    if (!lab || !lab.prices || !lab.prices[codeKey]) return;

    const item = lab.prices[codeKey];

    document.getElementById('modal-title').innerText = "Editar Preço de Custo";
    document.getElementById('modal-subtitle').innerText = "Tabela: " + labName;
    document.getElementById('modal-old-code').value = codeKey;
    document.getElementById('modal-code').value = codeKey.toUpperCase();
    document.getElementById('modal-code').disabled = false; 
    document.getElementById('modal-name').value = item.name;
    document.getElementById('modal-price').value = item.price;

    document.getElementById('price-modal').classList.remove('hidden');
  }

  function closePriceModal() {
    document.getElementById('price-modal').classList.add('hidden');
  }

  async function savePriceItem(event) {
    event.preventDefault();
    
    const labId = activeLabId;
    const oldCode = document.getElementById('modal-old-code').value;
    const code = document.getElementById('modal-code').value;
    const name = document.getElementById('modal-name').value;
    const price = document.getElementById('modal-price').value;

    if (!code || !name || price === "") {
      alert("Por favor, preencha todos os campos.");
      return;
    }

    try {
      const response = await fetch('/admin/comparador/save-preco', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          labId,
          oldCode,
          code,
          name,
          price: parseFloat(price)
        })
      });

      const result = await response.json();
      if (result.success) {
        alert(result.message || "Preço salvo com sucesso!");
        window.location.reload();
      } else {
        alert("Erro ao salvar: " + (result.message || "Erro desconhecido"));
      }
    } catch (err) {
      console.error(err);
      alert("Erro de conexão ao salvar preço.");
    }
  }

  async function deletePriceItem(codeKey) {
    const labName = activeLabId === "1" ? "Álvaro Apoio" : "Hermes Pardini";
    if (!confirm(`Tem certeza de que deseja excluir o código "${codeKey.toUpperCase()}" da tabela do "${labName}"?`)) {
      return;
    }

    try {
      const response = await fetch('/admin/comparador/delete-preco', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          labId: activeLabId,
          code: codeKey
        })
      });

      const result = await response.json();
      if (result.success) {
        alert(result.message || "Preço excluído com sucesso!");
        window.location.reload();
      } else {
        alert("Erro ao excluir: " + (result.message || "Erro desconhecido"));
      }
    } catch (err) {
      console.error(err);
      alert("Erro de conexão ao excluir preço.");
    }
  }

  // Inicialização
  window.addEventListener('DOMContentLoaded', () => {
    // Detecta aba inicial via query string ?tab=...
    const urlParams = new URLSearchParams(window.location.search);
    const initialTab = urlParams.get('tab');
    
    if (initialTab === 'pardini') {
      setActiveTab('pardini');
    } else {
      setActiveTab('alvaro');
    }

    // Configuração de Drag & Drop para planilha
    const dropZone = document.getElementById('drop-zone');
    if (dropZone) {
      ['dragenter', 'dragover'].forEach(eventName => {
        dropZone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropZone.classList.add('bg-brand-softBg/80', 'border-brand-dark');
        }, false);
      });

      ['dragleave', 'drop'].forEach(eventName => {
        dropZone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropZone.classList.remove('bg-brand-softBg/80', 'border-brand-dark');
        }, false);
      });

      dropZone.addEventListener('drop', (e) => {
        const dt = e.dataTransfer;
        const file = dt.files[0];
        if (file) {
          processUploadedFile(file);
        }
      }, false);
    }
  });
</script>

<!-- MODAL PARA ADICIONAR / EDITAR PREÇO DE CUSTO -->
<div id="price-modal" class="fixed inset-0 bg-brand-dark/50 backdrop-blur-sm flex items-center justify-center z-50 hidden animate-fade-in">
  <div class="bg-white rounded-3xl border border-brand-light/10 shadow-2xl p-6 sm:p-8 max-w-md w-full mx-4 space-y-6 relative animate-scale-up">
    
    <div class="flex justify-between items-start">
      <div>
        <h3 id="modal-title" class="text-lg font-extrabold text-brand-dark font-mono uppercase tracking-wider">Adicionar Preço de Custo</h3>
