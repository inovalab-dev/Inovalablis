        <div class="relative w-full max-w-md">
          <label class="text-[9px] font-extrabold text-gray-400 uppercase tracking-wider block mb-1 font-mono">Buscar na Tabela Ativa</label>
          <input type="text" id="catalog-search-input" oninput="applyCatalogFilter()" placeholder="Buscar por código de apoio ou nome do exame..." class="w-full bg-white border border-brand-light/15 rounded-xl pl-3 pr-10 py-2.5 text-xs font-semibold text-brand-dark focus:ring-emerald-500 focus:border-emerald-500 transition shadow-sm">
          <div class="absolute right-3 top-8 text-gray-400">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          </div>
        </div>
