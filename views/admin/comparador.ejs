        <span>&rsaquo;</span>
        <span class="text-brand-dark font-bold font-mono uppercase text-[10px]">Preços de Custo</span>
      </div>
      <h1 class="text-2xl font-extrabold text-brand-dark tracking-tight">Tabela de Custo</h1>
    </div>
    
    <a href="/admin" class="text-xs font-bold bg-brand-softBg hover:bg-brand-light/30 text-brand-dark px-4 py-2.5 rounded-xl border border-brand-light/20 transition-all flex items-center space-x-1.5 cursor-pointer">
