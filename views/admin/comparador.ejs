        <input type="number" step="0.01" min="0" id="modal-price" required class="w-full px-4 py-2.5 rounded-xl border border-brand-light/30 focus:outline-none focus:ring-1 focus:ring-brand-dark text-xs font-semibold text-brand-dark bg-brand-neutralLight" placeholder="Ex: 12.50">
      </div>

      <div class="flex gap-3 pt-3">
        <button type="button" onclick="closePriceModal()" class="flex-1 py-3 border border-brand-light/25 hover:bg-gray-50 text-gray-700 text-xs font-bold rounded-xl transition cursor-pointer">
          Cancelar
        </button>
        <button type="submit" class="flex-1 py-3 bg-brand-dark hover:bg-brand-light text-white text-xs font-bold rounded-xl shadow transition cursor-pointer">
          Salvar Registro
        </button>
      </div>
    </form>
  </div>
</div>

