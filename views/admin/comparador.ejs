            <tr class="bg-brand-softBg/30 text-[10px] font-bold uppercase tracking-widest text-brand-dark/75 border-b border-brand-light/10 font-mono">
              <th class="py-4 px-6 w-1/5">Código Apoio</th>
              <th class="py-4 px-6 w-2/5">Nome do Exame (Planilha)</th>
              <th class="py-4 px-6 w-1/5 text-right">Valor Custo</th>
