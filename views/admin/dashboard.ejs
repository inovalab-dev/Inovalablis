<%- include('../partials/header') %>

<section class="bg-brand-softBg/30 border-b border-brand-light/15 py-8 animate-fade-in">
  <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
      <div>
        <span class="text-[10px] font-bold uppercase tracking-widest text-brand-gold font-mono block">Painel de Controle</span>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-brand-dark tracking-tight">Administração InovaLab</h1>
      </div>
      <div class="flex items-center gap-3">
        <span class="text-xs bg-emerald-50 text-emerald-700 font-semibold px-3 py-1.5 rounded-full border border-emerald-100 flex items-center gap-1.5 font-mono">
          <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-ping"></span>
          Sessão Segura
        </span>
        <a href="/admin/logout" class="text-xs font-bold bg-white hover:bg-rose-50 text-rose-600 border border-rose-100 px-4 py-2 rounded-xl transition-all font-mono">
          Efetuar Logout
        </a>
      </div>
    </div>
  </div>
</section>

<section class="py-12 bg-brand-neutralLight/45">
  <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      <!-- Grid de Estatísticas Rápidas -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-6">
      
      <!-- Card: Total Exames -->
      <div class="bg-white p-6 rounded-3xl border border-brand-light/15 shadow-sm flex items-center justify-between">
        <div class="space-y-1">
          <span class="text-xs font-bold text-gray-400 font-mono uppercase tracking-wider">Exames Cadastrados</span>
          <p class="text-3xl font-extrabold text-brand-dark font-mono"><%= stats.totalExams %></p>
          <p class="text-[11px] text-gray-400">Instruções de preparo</p>
        </div>
        <div class="w-12 h-12 bg-brand-dark/10 rounded-2xl flex items-center justify-center text-brand-dark">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        </div>
      </div>

      <!-- Card: Total Orçamentos -->
      <div class="bg-white p-6 rounded-3xl border border-brand-light/15 shadow-sm flex items-center justify-between">
        <div class="space-y-1">
          <span class="text-xs font-bold text-gray-400 font-mono uppercase tracking-wider">Orçamentos</span>
          <p class="text-3xl font-extrabold text-brand-dark font-mono"><%= stats.totalBudgets %></p>
          <p class="text-[11px] text-gray-400">Guias de preços e preparos</p>
        </div>
        <div class="w-12 h-12 bg-brand-gold/10 rounded-2xl flex items-center justify-center text-brand-gold">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M12 16c1.657 0 3-.895 3-2s-1.343-2-3-2m-3-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2M14 4h6a2 2 0 012 2v1M14 4a2 2 0 00-2 2v1M14 4v4m6-4v4a2 2 0 01-2 2h-3"/></svg>
        </div>
      </div>

      <!-- Card: Total Requisições (Recepção) -->
      <div class="bg-white p-6 rounded-3xl border border-brand-light/15 shadow-sm flex items-center justify-between">
        <div class="space-y-1">
          <span class="text-xs font-bold text-gray-400 font-mono uppercase tracking-wider">Requisições</span>
          <p class="text-3xl font-extrabold text-brand-dark font-mono"><%= stats.totalRequisitions %></p>
          <p class="text-[11px] text-gray-400">Resultados e logins ativos</p>
        </div>
        <div class="w-12 h-12 bg-emerald-50 rounded-2xl flex items-center justify-center text-emerald-700">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
        </div>
      </div>

      <!-- Card: Total Blog -->
      <div class="bg-white p-6 rounded-3xl border border-brand-light/15 shadow-sm flex items-center justify-between">
        <div class="space-y-1">
          <span class="text-xs font-bold text-gray-400 font-mono uppercase tracking-wider">Matérias no Blog</span>
          <p class="text-3xl font-extrabold text-brand-dark font-mono"><%= stats.totalPosts %></p>
          <p class="text-[11px] text-gray-400">Engajamento ativo nas redes</p>
        </div>
        <div class="w-12 h-12 bg-brand-dark/10 rounded-2xl flex items-center justify-center text-brand-dark">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1M9 9h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        </div>
      </div>

      <!-- Card: Total Profissionais -->
      <div class="bg-white p-6 rounded-3xl border border-brand-light/15 shadow-sm flex items-center justify-between">
        <div class="space-y-1">
          <span class="text-xs font-bold text-gray-400 font-mono uppercase tracking-wider">Corpo Técnico</span>
          <p class="text-3xl font-extrabold text-brand-dark font-mono"><%= stats.totalProfessionals %></p>
          <p class="text-[11px] text-gray-400">Profissionais ativos no site</p>
        </div>
        <div class="w-12 h-12 bg-brand-gold/10 rounded-2xl flex items-center justify-center text-brand-gold">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
        </div>
      </div>

      <!-- Card: Avaliações / NPS (LIVE) -->
      <a href="/admin/avaliacoes" class="bg-white p-6 rounded-3xl border border-brand-light/15 shadow-sm flex items-center justify-between hover:border-[#284701] transition-all group">
        <div class="space-y-1">
          <span class="text-xs font-bold text-gray-400 font-mono uppercase tracking-wider block">Avaliações / NPS</span>
          <p class="text-2xl font-black text-brand-dark font-mono flex items-center gap-1">
            <%= stats.averageRating.toFixed(1) %> 
            <span class="text-amber-400 text-base group-hover:animate-pulse">★</span>
          </p>
          <p class="text-[11px] text-[#284701] font-semibold"><%= stats.totalEvaluations %> feedbacks</p>
        </div>
        <div class="w-12 h-12 bg-amber-50 rounded-2xl flex items-center justify-center text-amber-500 group-hover:bg-amber-100 transition-colors">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
        </div>
      </a>

    </div>

    <!-- SEÇÃO: RECEPÇÃO & ATENDIMENTO AO PACIENTE -->
    <div class="space-y-4 animate-fade-in">
      <h3 class="text-xs font-extrabold text-brand-gold font-mono uppercase tracking-widest flex items-center gap-2">
        <span class="w-2.5 h-2.5 bg-brand-gold rounded-full inline-block animate-pulse"></span>
        Atendimento & Recepção do Paciente
      </h3>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        <!-- Bloco: Leitor de Guia (IA) -->
        <div class="bg-brand-neutralDark text-white rounded-3xl border border-white/10 p-8 shadow-md flex flex-col justify-between space-y-6 relative overflow-hidden">
          <span class="absolute top-4 right-4 bg-brand-gold text-brand-neutralDark text-[9px] font-extrabold px-2.5 py-0.5 rounded-full uppercase tracking-wider font-mono shadow">
            Leitura de Guia (IA)
          </span>
          <div class="space-y-4">
            <div class="w-10 h-10 bg-brand-light text-brand-dark rounded-2xl flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <div class="space-y-1">
              <h2 class="text-xl font-extrabold text-brand-light">Leitor de Guia Inteligente</h2>
              <p class="text-xs text-gray-300 leading-relaxed">Fotografe ou envie a requisição médica para identificar automaticamente os exames solicitados, códigos de faturamento Jalis e roteamento para o laboratório de apoio correto.</p>
            </div>
          </div>
          <a href="/admin/leitor" class="w-full text-center py-3 bg-brand-light hover:bg-white text-brand-dark font-extrabold rounded-xl text-xs uppercase tracking-wider font-mono transition-all hover:scale-[1.01] cursor-pointer shadow">
            Acessar Leitor Inteligente &rarr;
          </a>
        </div>

        <!-- Bloco: Orçamentos & Requisições (Split) -->
        <div class="bg-white rounded-3xl border border-brand-light/20 p-8 shadow-sm flex flex-col justify-between space-y-6 relative">
          <span class="absolute top-4 right-4 bg-emerald-100 text-emerald-800 text-[9px] font-extrabold px-2.5 py-0.5 rounded-full uppercase tracking-wider font-mono">
            Recepcionista
          </span>
          <div class="space-y-4">
            <div class="w-10 h-10 bg-brand-dark text-white rounded-2xl flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
            </div>
            <div class="space-y-1">
              <h2 class="text-xl font-extrabold text-brand-dark">Orçamentos e Requisições</h2>
              <p class="text-xs text-gray-500 leading-relaxed">Gerencie as duas pontas da recepção de forma otimizada. Calcule orçamentos detalhados de exames com preparos integrados ou emita requisições diretas com login de resultados para os pacientes.</p>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <a href="/admin/orcamentos" class="text-center py-3 bg-brand-softBg hover:bg-brand-light hover:text-white text-brand-dark font-extrabold rounded-xl text-[11px] uppercase tracking-wider font-mono transition-all hover:scale-[1.01] cursor-pointer">
              Orçamentos &rsaquo;
            </a>
            <a href="/admin/requisicoes" class="text-center py-3 bg-brand-dark hover:bg-brand-light text-white font-extrabold rounded-xl text-[11px] uppercase tracking-wider font-mono transition-all hover:scale-[1.01] cursor-pointer">
              Requisições &rsaquo;
            </a>
          </div>
        </div>

      </div>
    </div>

    <!-- SEÇÃO: CADASTROS & CONFIGURAÇÕES ADMINISTRATIVAS -->
    <div class="space-y-4">
      <h3 class="text-xs font-bold text-gray-400 font-mono uppercase tracking-widest flex items-center gap-2">
        <span class="w-2 h-2 bg-gray-400 rounded-full inline-block"></span>
        Administração & Banco de Dados
      </h3>
      
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Bloco: Exames e Orientações -->
        <div class="bg-white rounded-3xl border border-brand-light/20 p-8 shadow-sm flex flex-col justify-between space-y-6">
          <div class="space-y-4">
            <div class="w-10 h-10 bg-brand-dark text-white rounded-2xl flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
            </div>
            <div class="space-y-1">
              <h2 class="text-xl font-extrabold text-brand-dark">Guia de Exames & Orientações</h2>
              <p class="text-xs text-gray-500 leading-relaxed">Cadastre novos exames, atualize prazos, defina a obrigatoriedade de jejum ou edite as orientações médicas de preparo diretamente no banco.</p>
            </div>
            <div class="bg-brand-softBg/50 p-4 rounded-2xl border border-brand-light/10 text-xs text-gray-600 space-y-1">
              <p class="font-bold text-brand-dark">Últimos exames cadastrados:</p>
              <ul class="list-disc pl-4 space-y-0.5 text-[11px]">
                <% stats.recentExams.forEach(exam => { %>
                  <li><%= exam.name %> (<%= exam.category %>)</li>
                <% }) %>
              </ul>
            </div>
          </div>
          <a href="/admin/exames" class="w-full text-center py-3 bg-brand-dark hover:bg-brand-light text-white font-bold rounded-xl text-xs uppercase tracking-wider font-mono transition-all hover:scale-[1.01] cursor-pointer">
            Gerenciar Exames &rarr;
          </a>
        </div>

        <!-- Bloco: Tabela Álvaro -->
        <div class="bg-white rounded-3xl border border-brand-light/20 p-8 shadow-sm flex flex-col justify-between space-y-6">
          <div class="space-y-4">
            <div class="w-10 h-10 bg-brand-dark text-white rounded-2xl flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
            </div>
            <div class="space-y-1">
              <h2 class="text-xl font-extrabold text-brand-dark">Tabela Álvaro Apoio</h2>
              <p class="text-xs text-gray-500 leading-relaxed">Gerencie os preços de custo do laboratório Álvaro. Importe planilhas oficiais (Excel, CSV, PDF) e consulte os valores cadastrados.</p>
            </div>
          </div>
          <a href="/admin/comparador?tab=alvaro" class="w-full text-center py-3 bg-brand-dark hover:bg-brand-light text-white font-bold rounded-xl text-xs uppercase tracking-wider font-mono transition-all hover:scale-[1.01] cursor-pointer border border-brand-light/10">
            Acessar Tabela Álvaro &rarr;
          </a>
        </div>

        <!-- Bloco: Tabela Pardini -->
        <div class="bg-white rounded-3xl border border-brand-light/20 p-8 shadow-sm flex flex-col justify-between space-y-6">
          <div class="space-y-4">
            <div class="w-10 h-10 bg-brand-dark text-white rounded-2xl flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 002 2h2a2 2 0 002-2z"/></svg>
            </div>
            <div class="space-y-1">
              <h2 class="text-xl font-extrabold text-brand-dark">Tabela Hermes Pardini</h2>
              <p class="text-xs text-gray-500 leading-relaxed">Gerencie os preços de custo do laboratório Hermes Pardini. Importe planilhas oficiais (Excel, CSV, PDF) e consulte os valores cadastrados.</p>
            </div>
          </div>
          <a href="/admin/comparador?tab=pardini" class="w-full text-center py-3 bg-brand-dark hover:bg-brand-light text-white font-bold rounded-xl text-xs uppercase tracking-wider font-mono transition-all hover:scale-[1.01] cursor-pointer">
            Acessar Tabela Pardini &rarr;
          </a>
        </div>

      </div>
    </div>

    <!-- SEÇÃO: COMUNICAÇÃO & CONTEÚDO -->
    <div class="space-y-4">
      <h3 class="text-xs font-bold text-gray-400 font-mono uppercase tracking-widest flex items-center gap-2">
        <span class="w-2 h-2 bg-gray-400 rounded-full inline-block"></span>
        Conteúdo Institucional & Comunicação
      </h3>
      
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Bloco: Blog & Dicas -->
        <div class="bg-white rounded-3xl border border-brand-light/20 p-8 shadow-sm flex flex-col justify-between space-y-6">
          <div class="space-y-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-brand-dark text-white rounded-2xl flex items-center justify-center">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1M9 9h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
              </div>
              <div>
                <h2 class="text-xl font-extrabold text-brand-dark">Blog & Dicas</h2>
                <p class="text-xs text-gray-500">Prevenção, nutrição e bem-estar.</p>
              </div>
            </div>
            <div class="bg-brand-softBg/50 p-4 rounded-2xl border border-brand-light/10 text-xs text-gray-600 space-y-1">
              <p class="font-bold text-brand-dark">Matérias ativas no blog:</p>
              <ul class="list-disc pl-4 space-y-0.5 text-[11px] line-clamp-2">
                <% stats.recentPosts.forEach(post => { %>
                  <li><%= post.title %> (<%= post.category %>)</li>
                <% }) %>
              </ul>
            </div>
          </div>
          <a href="/admin/blog" class="w-full text-center py-3 bg-brand-dark hover:bg-brand-light text-white font-bold rounded-xl text-xs uppercase tracking-wider font-mono transition-all hover:scale-[1.01] block">
            Gerenciar Postagens &rarr;
          </a>
        </div>

        <!-- Bloco: Profissionais -->
        <div class="bg-white rounded-3xl border border-brand-light/20 p-8 shadow-sm flex flex-col justify-between space-y-6">
          <div class="space-y-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-brand-gold text-brand-dark rounded-2xl flex items-center justify-center">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
              </div>
              <div>
                <h2 class="text-xl font-extrabold text-brand-dark">Equipe de Especialistas</h2>
                <p class="text-xs text-gray-500">Informações dos profissionais.</p>
              </div>
            </div>
            <div class="bg-brand-softBg/50 p-4 rounded-2xl border border-brand-light/10 text-xs text-gray-600 space-y-1">
              <p class="font-bold text-brand-dark">Profissionais de destaque:</p>
              <ul class="list-disc pl-4 space-y-0.5 text-[11px]">
                <% stats.recentProfessionals.forEach(prof => { %>
                  <li><%= prof.name %> (<%= prof.role %>)</li>
                <% }) %>
              </ul>
            </div>
          </div>
          <a href="/admin/profissionais" class="w-full text-center py-3 bg-brand-dark hover:bg-brand-light text-white font-bold rounded-xl text-xs uppercase tracking-wider font-mono transition-all hover:scale-[1.01] block">
            Gerenciar Especialistas &rarr;
          </a>
        </div>

        <!-- Bloco: Avaliações (NPS) -->
        <div class="bg-white rounded-3xl border border-brand-light/20 p-8 shadow-sm flex flex-col justify-between space-y-6">
          <div class="space-y-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-amber-400 text-brand-dark rounded-2xl flex items-center justify-center">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
              </div>
              <div>
                <h2 class="text-xl font-extrabold text-brand-dark">Avaliações & NPS</h2>
                <p class="text-xs text-gray-500">Opinião e nível de satisfação.</p>
              </div>
            </div>
            <div class="bg-brand-softBg/50 p-4 rounded-2xl border border-brand-light/10 text-xs text-gray-600 space-y-1 flex flex-col justify-center">
              <p class="font-bold text-brand-dark">Índice de Qualidade:</p>
              <div class="flex items-baseline gap-1 mt-1">
                <span class="text-2xl font-black text-brand-dark font-mono"><%= stats.averageRating.toFixed(1) %></span>
                <span class="text-xs text-gray-400 font-semibold">/ 5.0 estrelas</span>
              </div>
              <p class="text-[10px] text-gray-500 mt-1">Total de <%= stats.totalEvaluations %> avaliações de pacientes registradas.</p>
            </div>
          </div>
