<!-- 🧠 SCRIPTS INTERATIVOS DA GESTÃO DE DOCUMENTOS -->
<script>
  // Carregar lista de documentos do servidor
  const allDocuments = <%- JSON.stringify(documents) %>;
  let currentFilter = 'all';

  // Drag & Drop Configs
  const dropZone = document.getElementById('drop-zone');
  const fileInput = document.getElementById('file-input');

  if (dropZone && fileInput) {
    // Abrir seletor de arquivos ao clicar
    dropZone.addEventListener('click', () => fileInput.click());

    // Eventos de arraste
    ['dragenter', 'dragover'].forEach(eventName => {
      dropZone.addEventListener(eventName, (e) => {
        e.preventDefault();
        dropZone.classList.add('border-brand-dark', 'bg-brand-softBg/30');
      }, false);
    });

    ['dragleave', 'drop'].forEach(eventName => {
      dropZone.addEventListener(eventName, (e) => {
        e.preventDefault();
        dropZone.classList.remove('border-brand-dark', 'bg-brand-softBg/30');
      }, false);
    });

    // Tratar drop de arquivo
    dropZone.addEventListener('drop', (e) => {
      const dt = e.dataTransfer;
      const files = dt.files;
      if (files.length > 0) {
        handleSelectedFile(files[0]);
      }
    });

    // Tratar seleção manual de arquivo
    fileInput.addEventListener('change', (e) => {
      if (fileInput.files.length > 0) {
        handleSelectedFile(fileInput.files[0]);
      }
    });
  }

  // Converter e Processar o arquivo em Base64
  function handleSelectedFile(file) {
    if (!file) return;

    // Indicador visual de loading
    const previewFilename = document.getElementById('preview-filename');
    const previewFilesize = document.getElementById('preview-filesize');
    const previewIndicator = document.getElementById('file-preview-indicator');
    
    previewFilename.innerText = "Lendo arquivo...";
    previewFilesize.innerText = "Aguarde...";
    previewIndicator.classList.remove('hidden');

    const reader = new FileReader();
    reader.onload = function(event) {
      const rawResult = event.target.result;
      // Isolar apenas a string base64 pura (remover o prefixo data:*/*;base64,)
      const base64Content = rawResult.split(',')[1];
      
      // Armazenar nos inputs ocultos do formulário
      document.getElementById('doc-form-fileContent').value = base64Content;
      document.getElementById('doc-form-fileName').value = file.name;
      document.getElementById('doc-form-mimeType').value = file.type;
      
      // Formata tamanho amigável
      let sizeStr = '';
      if (file.size >= 1024 * 1024) {
        sizeStr = (file.size / (1024 * 1024)).toFixed(1) + ' MB';
      } else {
        sizeStr = (file.size / 1024).toFixed(0) + ' KB';
      }
      document.getElementById('doc-form-fileSize').value = sizeStr;

      // Exibe indicador final
      previewFilename.innerText = file.name;
      previewFilesize.innerText = sizeStr + ' - pronto para salvar';
    };

    reader.onerror = function(err) {
      alert("Falha ao ler o arquivo selecionado.");
      clearSelectedFile();
    };

    // Lê como URL de dados para converter automaticamente em Base64
    reader.readAsDataURL(file);
  }

  function clearSelectedFile() {
    document.getElementById('doc-form-fileContent').value = '';
    document.getElementById('doc-form-fileName').value = '';
    document.getElementById('doc-form-fileSize').value = '';
    document.getElementById('doc-form-mimeType').value = '';
    
    if (fileInput) fileInput.value = '';
    document.getElementById('file-preview-indicator').classList.add('hidden');
  }

  function toggleExpirationDateInput() {
    const checkbox = document.getElementById('doc-form-hasNoExpiration');
    const inputContainer = document.getElementById('expiration-date-container');
    const input = document.getElementById('doc-form-expirationDate');
    if (checkbox.checked) {
      inputContainer.classList.add('hidden');
      input.required = false;
      input.value = '';
    } else {
      inputContainer.classList.remove('hidden');
      input.required = true;
      if (!input.value) {
        input.value = new Date().toISOString().split('T')[0];
      }
    }
  }

  // Controle do Modal
  function openAddDocModal() {
    document.getElementById('modal-title').innerText = "Fazer Upload de Documento";
    document.getElementById('btn-submit-text').innerText = "Salvar Documento";
    document.getElementById('doc-form').action = "/admin/documentos/add";
    
    // Limpar campos
    document.getElementById('doc-form-id').value = '';
    document.getElementById('doc-form-title').value = '';
    document.getElementById('doc-form-expirationDate').value = new Date().toISOString().split('T')[0];
    document.getElementById('doc-form-hasNoExpiration').checked = false;
    toggleExpirationDateInput();
    clearSelectedFile();
    
    // Arquivo é obrigatório na criação
    document.getElementById('doc-form-fileContent').required = true;

    document.getElementById('doc-modal').classList.remove('hidden');
  }

  function editDocument(docData) {
    document.getElementById('modal-title').innerText = "Editar Documento";
    document.getElementById('btn-submit-text').innerText = "Atualizar Metadados";
    document.getElementById('doc-form').action = "/admin/documentos/edit";
    
    document.getElementById('doc-form-id').value = docData.id;
    document.getElementById('doc-form-title').value = docData.title;
    document.getElementById('doc-form-expirationDate').value = docData.expirationDate;
    
    document.getElementById('doc-form-hasNoExpiration').checked = !!docData.hasNoExpiration;
    toggleExpirationDateInput();
    
    clearSelectedFile();
    // Arquivo não é obrigatório na edição (mantém o existente se não subir novo)
    document.getElementById('doc-form-fileContent').required = false;

    document.getElementById('doc-modal').classList.remove('hidden');
  }

  function closeDocModal() {
    document.getElementById('doc-modal').classList.add('hidden');
  }

  // Filtragem Dinâmica da Tabela no Frontend
  function setFilterStatus(status) {
    currentFilter = status;
    
    // Atualiza botões ativos
    const buttons = ['all', 'expired', 'warning', 'valid'];
    buttons.forEach(btn => {
      const el = document.getElementById(`filter-btn-${btn}`);
      if (btn === status) {
        el.className = "px-3.5 py-1.5 rounded-lg transition-all cursor-pointer bg-brand-dark text-white shadow-sm";
      } else {
        el.className = "px-3.5 py-1.5 rounded-lg transition-all cursor-pointer text-gray-500 hover:text-brand-dark";
      }
    });

    filterTable();
  }

  function filterTable() {
    const searchVal = document.getElementById('search-input').value.toLowerCase().trim();
    const rows = document.querySelectorAll('#documents-tbody tr:not(#empty-state-row)');
    let visibleCount = 0;

    rows.forEach(row => {
      const title = row.getAttribute('data-title').toLowerCase();
      const filename = row.getAttribute('data-filename').toLowerCase();
      const status = row.getAttribute('data-status');

      const matchesSearch = title.includes(searchVal) || filename.includes(searchVal);
      const matchesStatus = (currentFilter === 'all') || (status === currentFilter);

      if (matchesSearch && matchesStatus) {
        row.style.display = '';
        visibleCount++;
      } else {
        row.style.display = 'none';
      }
    });

    // Se a tabela estiver totalmente vazia por filtros, exibe mensagem
    const emptyRow = document.getElementById('empty-state-row');
    if (emptyRow) {
      if (visibleCount === 0 && allDocuments.length > 0) {
        // Cria mensagem temporária ou apenas não faz nada se for o real empty state
      }
    }
  }

  // 👁 Abrir e ler o conteúdo do arquivo na gaveta (Read Drawer)
  function readDocument(id) {
    const doc = allDocuments.find(d => d.id === id);
    if (!doc) return;

    document.getElementById('read-title').innerText = doc.title;
    document.getElementById('read-filename').innerText = doc.fileName;
    
    // Format validade
    let formattedExpDate = '';
    if (doc.hasNoExpiration) {
      formattedExpDate = 'Não expira';
    } else {
      const dateParts = doc.expirationDate.split('-');
      formattedExpDate = dateParts.length === 3 ? `${dateParts[2]}/${dateParts[1]}/${dateParts[0]}` : doc.expirationDate;
    }
    document.getElementById('read-expiration').innerText = formattedExpDate;
    document.getElementById('read-uploadedby').innerText = doc.uploadedBy;

    // Configurar botão de download
    const dlBtn = document.getElementById('download-btn');
    dlBtn.onclick = function() {
      downloadBase64File(doc.fileContent, doc.fileName, doc.mimeType);
    };

    // Renderizar visualizador
    const container = document.getElementById('viewer-container');
    container.innerHTML = ''; // limpa

    const mime = doc.mimeType || 'text/plain';

    if (mime.startsWith('image/')) {
      // Exibe Imagem
      container.className = "bg-white rounded-2xl border border-brand-light/10 shadow-sm p-4 flex-1 flex items-center justify-center overflow-auto";
      container.innerHTML = `
        <div class="text-center space-y-4 max-w-full">
          <img src="data:${mime};base64,${doc.fileContent}" class="max-h-[500px] rounded-xl shadow-md border mx-auto object-contain max-w-full" referrerPolicy="no-referrer">
          <p class="text-[10px] text-gray-400 font-mono">${doc.fileName} (${doc.fileSize})</p>
        </div>
      `;
    } else if (mime.startsWith('text/') || mime === 'application/json' || mime === 'application/javascript') {
      // Exibe Texto Decodificado
      container.className = "bg-slate-50 rounded-2xl border border-brand-light/10 shadow-sm p-4 flex-1 flex flex-col overflow-auto font-mono text-xs leading-relaxed";
      try {
        const decodedText = atob(doc.fileContent);
        container.innerHTML = `
          <div class="flex justify-between items-center pb-2 mb-3 border-b border-gray-200 text-[10px] text-gray-400 font-bold shrink-0">
            <span>CONTEÚDO TEXTUAL DETECTADO</span>
            <span>${doc.fileSize}</span>
          </div>
          <pre class="whitespace-pre-wrap break-all text-gray-700 flex-1 overflow-y-auto">${escapeHtml(decodedText)}</pre>
        `;
      } catch (e) {
        container.innerHTML = `<p class="text-red-500 font-bold text-center py-10">Falha ao decodificar arquivo de texto em Base64.</p>`;
      }
    } else if (mime === 'application/pdf') {
      // PDF - Exibe visualizador nativo ou uma folha elegante de laboratório
      container.className = "bg-white rounded-2xl border border-brand-light/10 shadow-sm flex-1 flex flex-col";
      container.innerHTML = `
        <!-- Tentativa de embed PDF -->
        <object data="data:application/pdf;base64,${doc.fileContent}" type="application/pdf" class="w-full h-full min-h-[500px] rounded-xl">
          <div class="p-10 text-center space-y-6 max-w-md mx-auto my-auto">
            <div class="w-16 h-16 bg-red-50 text-red-600 rounded-full flex items-center justify-center mx-auto">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
            </div>
            <h3 class="text-sm font-bold text-brand-dark">Visualizador PDF incorporado</h3>
            <p class="text-xs text-gray-500">Seu navegador não suporta visualização direta de PDFs incorporados de forma segura neste ambiente de frame.</p>
            <button onclick="downloadBase64File('${doc.fileContent}', '${doc.fileName}', '${doc.mimeType}')" class="px-5 py-2.5 bg-brand-dark text-white rounded-xl text-xs font-bold hover:bg-brand-neutralDark transition-all flex items-center justify-center gap-1.5 mx-auto">
              <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
              <span>Baixar PDF para ler localmente</span>
            </button>
          </div>
        </object>
      `;
    } else {
      // Outros formatos: exibe folha de metadados refinada e download
      container.className = "bg-white rounded-2xl border border-brand-light/10 shadow-sm p-6 flex-1 flex items-center justify-center";
      container.innerHTML = `
        <div class="text-center space-y-5 max-w-sm">
          <div class="w-20 h-20 bg-brand-softBg rounded-full flex items-center justify-center mx-auto text-brand-dark">
            <svg class="w-10 h-10 text-brand-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/></svg>
          </div>
          <div class="space-y-1">
            <h4 class="text-sm font-bold text-brand-dark">${doc.fileName}</h4>
            <p class="text-xs text-gray-400">Tipo: <span class="font-mono font-semibold">${doc.mimeType}</span> | Tamanho: <span class="font-mono font-semibold">${doc.fileSize}</span></p>
          </div>
          <p class="text-xs text-gray-500 leading-relaxed">Este arquivo de extensão binária ou de planilha não possui visualizador direto interativo em tempo de execução no navegador. Faça o download para visualizá-lo localmente.</p>
          <button onclick="downloadBase64File('${doc.fileContent}', '${doc.fileName}', '${doc.mimeType}')" class="px-5 py-2.5 bg-brand-dark hover:bg-brand-neutralDark text-white text-xs font-bold rounded-xl shadow-md transition-all flex items-center justify-center gap-1.5 mx-auto cursor-pointer">
            <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
            <span>Fazer Download</span>
          </button>
        </div>
      `;
    }

    document.getElementById('read-drawer').classList.remove('hidden');
  }

  function closeReadDrawer() {
    document.getElementById('read-drawer').classList.add('hidden');
  }

  // Auxiliares de visualização e download no cliente
  function escapeHtml(text) {
    return text
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  function downloadBase64File(base64Data, filename, contentType) {
    if (!base64Data) {
      alert("Nenhum arquivo anexado para download.");
      return;
    }
    const sliceSize = 1024;
    const byteCharacters = atob(base64Data);
    const bytesLength = byteCharacters.length;
    const slicesCount = Math.ceil(bytesLength / sliceSize);
    const byteArrays = new Array(slicesCount);

    for (let sliceIndex = 0; sliceIndex < slicesCount; ++sliceIndex) {
      const begin = sliceIndex * sliceSize;
      const end = Math.min(begin + sliceSize, bytesLength);

      const bytes = new Array(end - begin);
      for (let offset = begin, i = 0; offset < end; ++offset, ++i) {
        bytes[i] = byteCharacters.charCodeAt(offset);
      }
      byteArrays[sliceIndex] = new Uint8Array(bytes);
    }

    const blob = new Blob(byteArrays, { type: contentType });
    const link = document.createElement('a');
    link.href = window.URL.createObjectURL(blob);
    link.download = filename;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  }
</script>

