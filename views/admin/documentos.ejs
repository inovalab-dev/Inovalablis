    <!-- Área de Exibição / Conteúdo do Arquivo -->
    <div class="flex-1 overflow-y-auto p-6 bg-slate-50 flex flex-col">
      <div id="viewer-container" class="bg-white rounded-2xl border border-brand-light/10 shadow-sm p-6 flex-1 flex flex-col overflow-y-auto min-h-[400px]">
        <!-- Conteúdo do visualizador dinâmico gerado por JS -->
      </div>
    </div>

    <!-- Rodapé da Gaveta -->
    <div class="p-5 border-t border-brand-light/10 bg-white text-center shrink-0">
      <button onclick="closeReadDrawer()" class="w-full py-3 bg-brand-dark hover:bg-brand-neutralDark text-white text-xs font-bold rounded-xl transition-all cursor-pointer">
