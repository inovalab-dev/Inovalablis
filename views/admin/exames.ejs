            <input type="checkbox" ${isEtqTri ? 'checked' : ''} onchange="updateSetorFlag(${idx}, 'etqTri', this.checked)" class="w-4 h-4 text-emerald-600 rounded border-gray-300">
          </td>
          <td class="p-2 text-center">
            <button type="button" onclick="removeSetorRow(${idx})" class="text-rose-600 font-bold hover:bg-rose-50 p-1 rounded transition-colors" title="Remover Setor">✖</button>
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    const setoresJsonElem = document.getElementById('form-exam-setores-json');
    if (setoresJsonElem) {
      setoresJsonElem.value = JSON.stringify(currentSetoresList);
