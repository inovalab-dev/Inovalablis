    document.getElementById('form-exam-amostras').value = exam.amostras || '0';
    document.getElementById('form-exam-tagsResultado').value = exam.tagsResultado || '';
    document.getElementById('form-exam-category').value = exam.category || 'Geral';

    document.getElementById('form-exam-bloquearExame').checked = !!exam.bloquearExame;
    document.getElementById('form-exam-permitirSalvarParcialmente').checked = !!exam.permitirSalvarParcialmente;
    document.getElementById('form-exam-servico').checked = !!exam.servico;
    document.getElementById('form-exam-importarPdf').checked = exam.importarPdf !== false;

    document.getElementById('form-exam-tipoBPA').value = exam.tipoBPA || 'Individualizado';
