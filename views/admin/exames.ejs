    if (document.getElementById('mod-valor-referencia-laudo')) document.getElementById('mod-valor-referencia-laudo').value = exam.valorReferenciaLaudo || exam.valorReferencia || exam.referencia || '';

    // Materiais
    if (Array.isArray(exam.materiaisColetados) && exam.materiaisColetados.length > 0) {
      currentMateriaisList = exam.materiaisColetados;
    } else {
      currentMateriaisList = [
