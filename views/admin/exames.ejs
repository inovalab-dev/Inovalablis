          </tbody>
        </table>
      </div>
    </div>

    <!-- Footer -->
    <div class="px-5 py-3 bg-gray-50 border-t border-gray-200 flex justify-end shrink-0">
      <button type="button" onclick="closeSupportLabsModal()" class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold text-xs uppercase tracking-wider rounded-xl transition-all cursor-pointer">
        Fechar
      </button>
    </div>

  </div>
</div>

