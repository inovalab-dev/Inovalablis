  function filterExams() {
    const q = (document.getElementById('exam-search').value || '').toLowerCase();
    const cat = document.getElementById('exam-filter-category').value;
    const link = document.getElementById('exam-filter-link').value;

    let visibleCount = 0;
    document.querySelectorAll('.exam-row').forEach(row => {
      const name = row.getAttribute('data-name') || '';
      const code = row.getAttribute('data-code') || '';
      const sinonimia = row.getAttribute('data-sinonimia') || '';
      const rowCat = row.getAttribute('data-category') || '';
      const hasLink = row.getAttribute('data-has-any-link') === 'true';

      const matchesQuery = !q || name.includes(q) || code.includes(q) || sinonimia.includes(q);
      const matchesCat = cat === 'all' || rowCat.includes(cat);
      const matchesLink = link === 'all' || (link === 'linked' ? hasLink : !hasLink);

      if (matchesQuery && matchesCat && matchesLink) {
        row.classList.remove('hidden');
        visibleCount++;
      } else {
        row.classList.add('hidden');
      }
    });

    document.getElementById('exam-count').innerText = visibleCount;
  }

