          </button>
          <button type="button" id="deleteExamModalBtn" onclick="deleteCurrentModalExam()" class="px-4 py-2.5 bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 font-bold text-xs uppercase tracking-wider rounded-xl transition-all cursor-pointer hidden flex items-center gap-1.5" title="Remover este Exame">
