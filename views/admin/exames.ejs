      <tr class="hover:bg-slate-50"><td class="py-1 px-2 border-r border-slate-200 text-slate-600 font-bold">fonte</td><td class="py-1 px-2"><select onchange="updateLisCompPropExames('fonte', this.value)" class="w-full px-1 py-0.5 border border-slate-300 rounded text-xs font-mono"><option value="Courier New" ${comp.fonte === 'Courier New' ? 'selected' : ''}>Courier New</option><option value="Arial" ${comp.fonte === 'Arial' ? 'selected' : ''}>Arial</option><option value="Times New Roman" ${comp.fonte === 'Times New Roman' ? 'selected' : ''}>Times New Roman</option></select></td></tr>
