      <!-- ========================================================================= -->
      <!-- TAB 1: MAT. COLETADO                                                     -->
      <!-- ========================================================================= -->
      <div id="mat-main-panel-mat-coletado" class="mat-main-panel space-y-4">
        <!-- Grid de Campos do Material -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-3">
