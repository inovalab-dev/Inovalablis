              <% if (locals.materiaisColetadosMaster && materiaisColetadosMaster.length > 0) { %>
                <% materiaisColetadosMaster.forEach(m => { %>
                  <option value="<%= m.descricao %>" data-abrev="<%= m.abreviatura %>" data-codigo="<%= m.codigo %>">
                    [<%= m.codigo %>] <%= m.descricao %> <%= m.abreviatura ? ('(' + m.abreviatura + ')') : '' %>
                  </option>
                <% }) %>
              <% } else { %>
                <option value="Sangue Total">Sangue Total</option>
                <option value="Plasma Citratado">Plasma Citratado</option>
                <option value="Soro">Soro</option>
                <option value="Urina Amostra Isolada">Urina Amostra Isolada</option>
                <option value="Urina 24h">Urina 24h</option>
                <option value="Fezes">Fezes</option>
