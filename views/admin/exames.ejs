  // =========================================================
  // SISTEMA DE EDITAR MODELO DO LAUDO POR ORIGEM (INTERNO, ÁLVARO, PARDINI)
  // =========================================================
  let lisComponentsExames = [];
  let selectedLisCompIndexExames = null;
  let isDraggingLisCompExames = false;
  let dragOffsetXExames = 0;
  let dragOffsetYExames = 0;
  let activeLisProviderExames = 'interno';

  function updateExamesModelBadges() {
    const examCode = document.getElementById('form-exam-jalisCode')?.value?.trim() || 'EXAME';
    
    const hasInterno = !!localStorage.getItem(`lis_layout_${examCode}_interno`) || !!localStorage.getItem(`lis_layout_${examCode}`);
    const hasAlvaro = !!localStorage.getItem(`lis_layout_${examCode}_alvaro`);
    const hasPardini = !!localStorage.getItem(`lis_layout_${examCode}_pardini`);

    const bInt = document.getElementById('badge-model-status-interno');
    if (bInt) {
      if (hasInterno) {
        bInt.className = 'px-2 py-0.5 bg-emerald-100 text-emerald-800 text-[10px] font-bold rounded font-mono';
        bInt.textContent = '✓ Layout Personalizado';
      } else {
        bInt.className = 'px-2 py-0.5 bg-slate-100 text-slate-700 text-[10px] font-bold rounded font-mono';
        bInt.textContent = '● Padrão Interno';
      }
    }

    const bAlv = document.getElementById('badge-model-status-alvaro');
    if (bAlv) {
      if (hasAlvaro) {
        bAlv.className = 'px-2 py-0.5 bg-blue-100 text-blue-800 text-[10px] font-bold rounded font-mono';
        bAlv.textContent = '✓ Layout Álvaro Ativo';
      } else {
        bAlv.className = 'px-2 py-0.5 bg-slate-100 text-slate-700 text-[10px] font-bold rounded font-mono';
        bAlv.textContent = '● Usar Modelo Base';
      }
    }

    const bPar = document.getElementById('badge-model-status-pardini');
    if (bPar) {
      if (hasPardini) {
        bPar.className = 'px-2 py-0.5 bg-purple-100 text-purple-800 text-[10px] font-bold rounded font-mono';
        bPar.textContent = '✓ Layout Pardini Ativo';
      } else {
        bPar.className = 'px-2 py-0.5 bg-slate-100 text-slate-700 text-[10px] font-bold rounded font-mono';
        bPar.textContent = '● Usar Modelo Base';
      }
    }
  }

  function openLisLayoutModalFromExames(providerKey = 'interno') {
    activeLisProviderExames = providerKey || 'interno';
    const examCodeInput = document.getElementById('form-exam-jalisCode');
    const examCode = (examCodeInput && examCodeInput.value.trim()) ? examCodeInput.value.trim() : 'EXAME';

    document.getElementById('lis-modal-exam-title-exames').textContent = examCode;
    document.getElementById('lis-footer-exam-code-exames').textContent = examCode;

    const selectEl = document.getElementById('lis-provider-select-exames');
    if (selectEl) selectEl.value = activeLisProviderExames;

    loadLisLayoutModelFromExames(examCode, activeLisProviderExames);

    const modal = document.getElementById('modal-lis-layout-editor-exames');
    if (modal) modal.classList.remove('hidden');
  }

  function switchLisProviderModelExames(providerKey) {
    activeLisProviderExames = providerKey || 'interno';
    const examCodeInput = document.getElementById('form-exam-jalisCode');
    const examCode = (examCodeInput && examCodeInput.value.trim()) ? examCodeInput.value.trim() : 'EXAME';

    loadLisLayoutModelFromExames(examCode, activeLisProviderExames);
  }

  function closeLisLayoutModalExames() {
    const modal = document.getElementById('modal-lis-layout-editor-exames');
    if (modal) modal.classList.add('hidden');
    updateExamesModelBadges();
  }

  function loadLisLayoutModelFromExames(examCode, providerKey = 'interno') {
    let saved = null;
    if (editingMaterialIndex >= 0 && currentMateriaisList[editingMaterialIndex] && currentMateriaisList[editingMaterialIndex].lisLayouts) {
      const matLayout = currentMateriaisList[editingMaterialIndex].lisLayouts[providerKey];
      if (matLayout) {
        saved = typeof matLayout === 'string' ? matLayout : JSON.stringify(matLayout);
      }
    }
    if (!saved && window.tempMaterialLisLayouts && window.tempMaterialLisLayouts[providerKey]) {
      saved = typeof window.tempMaterialLisLayouts[providerKey] === 'string'
        ? window.tempMaterialLisLayouts[providerKey]
        : JSON.stringify(window.tempMaterialLisLayouts[providerKey]);
    }
    if (!saved) {
      saved = localStorage.getItem(`lis_layout_${examCode}_${providerKey}`);
    }
    if (!saved && providerKey !== 'interno') {
      saved = localStorage.getItem(`lis_layout_${examCode}_interno`);
    }
    if (!saved) {
      saved = localStorage.getItem(`lis_layout_${examCode}`);
    }

    if (saved) {
      try {
        lisComponentsExames = JSON.parse(saved);
      } catch (e) {
        lisComponentsExames = getDefaultLisComponentsExames(examCode);
      }
    } else {
      lisComponentsExames = getDefaultLisComponentsExames(examCode);
    }

    selectedLisCompIndexExames = 0;
    renderLisCanvasExames();
  }

  function saveLisLayoutModelExames() {
    const examCodeInput = document.getElementById('form-exam-jalisCode');
    const examCode = (examCodeInput && examCodeInput.value.trim()) ? examCodeInput.value.trim() : 'EXAME';
    const providerKey = activeLisProviderExames || 'interno';
    const provNames = { interno: 'Interno', alvaro: 'Álvaro', pardini: 'Pardini' };

    localStorage.setItem(`lis_layout_${examCode}_${providerKey}`, JSON.stringify(lisComponentsExames));
    if (providerKey === 'interno') {
      localStorage.setItem(`lis_layout_${examCode}`, JSON.stringify(lisComponentsExames));
    }

    if (!window.tempMaterialLisLayouts) window.tempMaterialLisLayouts = {};
    window.tempMaterialLisLayouts[providerKey] = lisComponentsExames;

    if (editingMaterialIndex >= 0 && currentMateriaisList[editingMaterialIndex]) {
      if (!currentMateriaisList[editingMaterialIndex].lisLayouts) {
        currentMateriaisList[editingMaterialIndex].lisLayouts = {};
      }
      currentMateriaisList[editingMaterialIndex].lisLayouts[providerKey] = lisComponentsExames;
    }

    updateExamesModelBadges();
    alert(`Modelo de laudo (${provNames[providerKey]}) salvo com sucesso para o exame ${examCode}!`);
  }

  function resetLisLayoutModelForProvider(providerKey = 'interno') {
    const examCodeInput = document.getElementById('form-exam-jalisCode');
    const examCode = (examCodeInput && examCodeInput.value.trim()) ? examCodeInput.value.trim() : 'EXAME';
    const provNames = { interno: 'Interno', alvaro: 'Álvaro', pardini: 'Pardini' };

    localStorage.removeItem(`lis_layout_${examCode}_${providerKey}`);
    if (providerKey === 'interno') {
      localStorage.removeItem(`lis_layout_${examCode}`);
    }

    if (window.tempMaterialLisLayouts) delete window.tempMaterialLisLayouts[providerKey];
    if (editingMaterialIndex >= 0 && currentMateriaisList[editingMaterialIndex] && currentMateriaisList[editingMaterialIndex].lisLayouts) {
      delete currentMateriaisList[editingMaterialIndex].lisLayouts[providerKey];
    }

    if (activeLisProviderExames === providerKey) {
      lisComponentsExames = getDefaultLisComponentsExames(examCode);
      selectedLisCompIndexExames = 0;
      renderLisCanvasExames();
    }

    updateExamesModelBadges();
    alert(`Modelo de laudo (${provNames[providerKey]}) restaurado para os padrões do sistema.`);
  }

  function getDefaultLisComponentsExames(examCode) {
    return [
      { id: 'c1', nome: 'NOME_EXAME', componente: 'Texto', texto: `EXAME: ${examCode}`, esquerda: 40, topo: 30, largura: 600, altura: 24, fonte: 'Courier New', tamanho: '14px', negrito: true, maiusculas: true, alinhamento: 'left', corFonte: '#0f172a', corFundo: 'transparent', imprimir: true, opaco: false },
      { id: 'c2', nome: 'LINHA_TOP', componente: 'Linha', texto: '----------------------------------------------------------------------------------', esquerda: 40, topo: 55, largura: 600, altura: 12, fonte: 'Courier New', tamanho: '10px', negrito: false, maiusculas: false, alinhamento: 'left', corFonte: '#64748b', corFundo: 'transparent', imprimir: true, opaco: false },
      { id: 'c3', nome: 'RESULTADO_DESCR', componente: 'Resultado Simples', texto: 'RESULTADO: {{resultado}}', unidade: 'mg/dL', esquerda: 40, topo: 75, largura: 400, altura: 28, fonte: 'Courier New', tamanho: '15px', negrito: true, maiusculas: true, alinhamento: 'left', corFonte: '#047857', corFundo: 'transparent', imprimir: true, opaco: false },
      { id: 'c4', nome: 'METODO', componente: 'Texto', texto: 'Método: Automatizado / Enzimático', esquerda: 40, topo: 110, largura: 600, altura: 20, fonte: 'Courier New', tamanho: '10px', negrito: false, maiusculas: false, alinhamento: 'left', corFonte: '#475569', corFundo: 'transparent', imprimir: true, opaco: false },
      { id: 'c5', nome: 'VALOR_REF', componente: 'Val. Referência', texto: 'VALORES DE REFERÊNCIA:\nDesejável....: 70 a 99 mg/dL\nJejum alterado: 100 a 125 mg/dL\nDiabetes......: Maior ou igual a 126 mg/dL', esquerda: 40, topo: 135, largura: 600, altura: 65, fonte: 'Courier New', tamanho: '10px', negrito: false, maiusculas: false, alinhamento: 'left', corFonte: '#334155', corFundo: 'transparent', imprimir: true, opaco: false },
      { id: 'c6', nome: 'OBSERVACOES', componente: 'Texto', texto: 'Observações do Exame:\nValores confirmados em duplicata.', esquerda: 40, topo: 215, largura: 600, altura: 45, fonte: 'Courier New', tamanho: '10px', negrito: false, maiusculas: false, alinhamento: 'left', corFonte: '#64748b', corFundo: 'transparent', imprimir: true, opaco: false }
    ];
  }

  function renderLisCanvasExames() {
    const container = document.getElementById('lis-canvas-elements-container-exames');
    if (!container) return;

    container.innerHTML = lisComponentsExames.map((comp, idx) => {
      const isSelected = selectedLisCompIndexExames === idx;
      const borderStyle = isSelected ? 'border-2 border-indigo-600 shadow-md ring-2 ring-indigo-400/50 z-20' : 'border border-slate-400/70 hover:border-slate-600 z-10';
      
      const handles = isSelected ? `
        <div onmousedown="onStartResizeLisCompExames(event, ${idx}, 'nw')" class="absolute -top-1.5 -left-1.5 w-3.5 h-3.5 bg-indigo-600 border-2 border-white rounded-full cursor-nwse-resize z-30 hover:scale-125 transition-transform" title="Redimensionar Canto Superior Esquerdo"></div>
        <div onmousedown="onStartResizeLisCompExames(event, ${idx}, 'top')" class="absolute -top-1.5 left-1/2 -translate-x-1/2 w-3.5 h-3.5 bg-indigo-600 border-2 border-white rounded-full cursor-ns-resize z-30 hover:scale-125 transition-transform" title="Redimensionar Altura Superior"></div>
        <div onmousedown="onStartResizeLisCompExames(event, ${idx}, 'ne')" class="absolute -top-1.5 -right-1.5 w-3.5 h-3.5 bg-indigo-600 border-2 border-white rounded-full cursor-nesw-resize z-30 hover:scale-125 transition-transform" title="Redimensionar Canto Superior Direito"></div>
        <div onmousedown="onStartResizeLisCompExames(event, ${idx}, 'right')" class="absolute top-1/2 -right-1.5 -translate-y-1/2 w-3.5 h-3.5 bg-indigo-600 border-2 border-white rounded-full cursor-ew-resize z-30 hover:scale-125 transition-transform" title="Redimensionar Largura (Direita)"></div>
        <div onmousedown="onStartResizeLisCompExames(event, ${idx}, 'se')" class="absolute -bottom-1.5 -right-1.5 w-3.5 h-3.5 bg-indigo-600 border-2 border-white rounded-full cursor-nwse-resize z-30 hover:scale-125 transition-transform" title="Redimensionar Canto Inferior Direito"></div>
        <div onmousedown="onStartResizeLisCompExames(event, ${idx}, 'bottom')" class="absolute -bottom-1.5 left-1/2 -translate-x-1/2 w-3.5 h-3.5 bg-indigo-600 border-2 border-white rounded-full cursor-ns-resize z-30 hover:scale-125 transition-transform" title="Redimensionar Altura (Inferior)"></div>
        <div onmousedown="onStartResizeLisCompExames(event, ${idx}, 'sw')" class="absolute -bottom-1.5 -left-1.5 w-3.5 h-3.5 bg-indigo-600 border-2 border-white rounded-full cursor-nesw-resize z-30 hover:scale-125 transition-transform" title="Redimensionar Canto Inferior Esquerdo"></div>
        <div onmousedown="onStartResizeLisCompExames(event, ${idx}, 'left')" class="absolute top-1/2 -left-1.5 -translate-y-1/2 w-3.5 h-3.5 bg-indigo-600 border-2 border-white rounded-full cursor-ew-resize z-30 hover:scale-125 transition-transform" title="Redimensionar Largura (Esquerda)"></div>
      ` : '';

      const textTransform = comp.maiusculas ? 'uppercase' : 'none';
      const fontWeight = comp.negrito ? 'bold' : 'normal';

      let displayText = comp.texto;
      if (comp.componente === 'Resultado Simples' || comp.unidade) {
        const valStr = comp.texto || '{{resultado}}';
        const unitStr = comp.unidade ? ` ${comp.unidade}` : '';
        displayText = `${valStr}${unitStr}`;
      }

      return `
        <div
          id="lis-element-exames-${idx}"
          onmousedown="onStartDragLisCompExames(event, ${idx})"
          onclick="selectLisComponentExames(${idx})"
          class="absolute p-2 cursor-move flex items-center justify-${comp.alinhamento === 'center' ? 'center' : comp.alinhamento === 'right' ? 'end' : 'start'} ${borderStyle} transition-shadow"
          style="
            left: ${comp.esquerda}px;
            top: ${comp.topo}px;
            width: ${comp.largura}px;
            height: ${comp.altura}px;
            font-family: '${comp.fonte}', monospace;
            font-size: ${comp.tamanho};
            font-weight: ${fontWeight};
            text-transform: ${textTransform};
            color: ${comp.corFonte};
            background-color: ${comp.corFundo};
            white-space: pre-wrap;
          "
        >
          <span>${escapeLisHtmlExames(displayText)}</span>
          ${handles}
        </div>
      `;
    }).join('');

    renderLisPropertiesGridExames();
  }

  function escapeLisHtmlExames(str) {
    if (!str) return '';
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function selectLisComponentExames(index) {
    selectedLisCompIndexExames = index;
    renderLisCanvasExames();
  }

  function renderLisPropertiesGridExames() {
    const gridBody = document.getElementById('lis-properties-grid-body-exames');
    const badge = document.getElementById('lis-selected-comp-badge-exames');
    if (!gridBody) return;

    if (selectedLisCompIndexExames === null || !lisComponentsExames[selectedLisCompIndexExames]) {
      if (badge) badge.textContent = 'Nenhum';
      gridBody.innerHTML = `<tr><td colspan="2" class="p-4 text-center text-slate-400 italic">Clique em um elemento na folha para editar suas propriedades.</td></tr>`;
      return;
    }

    const comp = lisComponentsExames[selectedLisCompIndexExames];
    if (badge) badge.textContent = comp.nome || 'Componente';

    gridBody.innerHTML = `
      <tr class="hover:bg-slate-50"><td class="py-1 px-2 border-r border-slate-200 text-slate-600 font-bold">componente</td><td class="py-1 px-2 font-bold text-indigo-900">${comp.componente}</td></tr>
