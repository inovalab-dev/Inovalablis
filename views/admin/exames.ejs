      <tr class="hover:bg-slate-50"><td class="py-1 px-2 border-r border-slate-200 text-slate-600 font-bold">largura (W)</td><td class="py-1 px-2"><input type="number" value="${comp.largura}" onchange="updateLisCompPropExames('largura', parseInt(this.value)||0)" class="w-20 px-1 py-0.5 border border-slate-300 rounded font-mono text-xs"/></td></tr>
