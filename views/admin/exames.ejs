            </button>
            <button type="button" onclick="switchMaterialTab('preparo')" id="mat-tab-btn-preparo" class="mat-tab-btn px-3 py-1.5 rounded-lg text-gray-600 hover:bg-gray-100 cursor-pointer whitespace-nowrap">
