  function editModalSupportLab(id, codigo, descricao) {
    document.getElementById('modal-lab-id').value = id;
    document.getElementById('modal-lab-codigo').value = codigo;
    document.getElementById('modal-lab-descricao').value = descricao;
    document.getElementById('modal-lab-descricao').focus();
  }

  async function saveModalSupportLab(e) {
    if (e) e.preventDefault();
    const id = document.getElementById('modal-lab-id').value;
    const codigo = document.getElementById('modal-lab-codigo').value.trim();
    const descricao = document.getElementById('modal-lab-descricao').value.trim();

    if (!descricao) {
      alert('Preencha a descrição do laboratório.');
      return;
    }

    try {
      const res = await fetch('/admin/laboratorios/save', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({ id, codigo, descricao })
      });

      if (res.ok) {
        await fetchAndUpdateSupportLabsDropdown();
        renderModalSupportLabsTable();
        resetModalSupportLabForm();
      } else {
        alert('Erro ao salvar laboratório.');
      }
    } catch (err) {
      console.error(err);
      alert('Erro de conexão ao salvar.');
    }
  }

  async function deleteModalSupportLab(id, desc) {
    if (!confirm(`Deseja realmente excluir o laboratório "${desc}"?`)) return;

    try {
      const res = await fetch('/admin/laboratorios/delete/' + encodeURIComponent(id), {
        method: 'POST',
        headers: {
          'Accept': 'application/json'
        }
      });

      if (res.ok) {
        await fetchAndUpdateSupportLabsDropdown();
        renderModalSupportLabsTable();
        resetModalSupportLabForm();
      } else {
        alert('Erro ao excluir laboratório.');
      }
    } catch (err) {
      console.error(err);
      alert('Erro de conexão ao excluir.');
    }
  }

  window.globalRecipientesList = <%- JSON.stringify(locals.recipientes || []) %>;
  window.globalMateriaisColetadosMasterList = <%- JSON.stringify(locals.materiaisColetadosMaster || []) %>;

  function populateMateriaisColetadosSelect(selectedVal) {
    const sel = document.getElementById('mat-input-nome');
    if (!sel) return;

    const list = window.globalMateriaisColetadosMasterList || [];
    const currentValue = selectedVal !== undefined ? selectedVal : sel.value;
    sel.innerHTML = '';

    if (list.length === 0) {
      const defaultOptions = ['Sangue Total', 'Plasma Citratado', 'Soro', 'Urina Amostra Isolada', 'Urina 24h', 'Fezes', 'Líquor', 'Secreção'];
      defaultOptions.forEach(op => {
        const o = document.createElement('option');
        o.value = op;
        o.textContent = op;
        sel.appendChild(o);
      });
    } else {
      list.forEach(m => {
        const opt = document.createElement('option');
        opt.value = m.descricao;
        opt.setAttribute('data-abrev', m.abreviatura || '');
        opt.setAttribute('data-codigo', m.codigo || '');
        const abrevStr = m.abreviatura ? ` (${m.abreviatura})` : '';
        opt.textContent = `[${m.codigo}] ${m.descricao}${abrevStr}`;
        sel.appendChild(opt);
      });
    }

    if (currentValue) {
      const curStr = String(currentValue).trim().toUpperCase();
      let matched = Array.from(sel.options).find(opt => opt.value.trim().toUpperCase() === curStr);
      if (matched) {
        sel.value = matched.value;
      } else {
        let matchByCodeOrAbrev = list.find(m => String(m.codigo).trim() === String(currentValue).trim() || (m.abreviatura && m.abreviatura.trim().toUpperCase() === curStr));
        if (matchByCodeOrAbrev) {
          sel.value = matchByCodeOrAbrev.descricao;
        } else {
          const customOpt = document.createElement('option');
          customOpt.value = currentValue;
          customOpt.textContent = currentValue;
          sel.appendChild(customOpt);
          sel.value = currentValue;
        }
      }
    }
  }

  async function fetchAndUpdateMateriaisColetadosDropdowns(selectedVal) {
    try {
      const res = await fetch('/api/materiais-coletados');
      if (res.ok) {
        const list = await res.json();
        if (Array.isArray(list) && list.length > 0) {
          window.globalMateriaisColetadosMasterList = list;
          populateMateriaisColetadosSelect(selectedVal);
        }
      }
    } catch (e) {
      console.warn("Não foi possível atualizar a lista de materiais coletados:", e);
      populateMateriaisColetadosSelect(selectedVal);
    }
  }

  async function fetchAndUpdateRecipientesDropdowns() {
    try {
      const res = await fetch('/api/recipientes');
      if (res.ok) {
        const list = await res.json();
        if (Array.isArray(list) && list.length > 0) {
          window.globalRecipientesList = list;
          
          const selColeta = document.getElementById('rec-coleta-nome');
          const selTriagem = document.getElementById('rec-triagem-nome');

          if (selColeta) {
            const curColeta = selColeta.value;
            selColeta.innerHTML = '';
            list.forEach(r => {
              const opt = document.createElement('option');
              opt.value = r.descricao;
              opt.setAttribute('data-codigo', r.codigo);
              opt.textContent = `#${r.codigo} - ${r.descricao}`;
              selColeta.appendChild(opt);
            });
            if (curColeta && list.some(r => r.descricao === curColeta)) {
              selColeta.value = curColeta;
            }
          }

          if (selTriagem) {
            const curTriagem = selTriagem.value;
            selTriagem.innerHTML = '';
            list.forEach(r => {
              const opt = document.createElement('option');
              opt.value = r.descricao;
              opt.setAttribute('data-codigo', r.codigo);
              opt.textContent = `#${r.codigo} - ${r.descricao}`;
              selTriagem.appendChild(opt);
            });
            if (curTriagem && list.some(r => r.descricao === curTriagem)) {
              selTriagem.value = curTriagem;
            }
          }
        }
      }
    } catch (e) {
      console.warn("Não foi possível atualizar a lista de recipientes:", e);
    }
  }

