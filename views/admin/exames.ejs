    document.getElementById('form-exam-codigoAlvaro').value = exam.codigoAlvaro || '';
    document.getElementById('form-exam-codigoPardini').value = exam.codigoPardini || '';

    document.getElementById('form-exam-historico').value = exam.historico || '';

    // Tab 5 - Modelos e Predefinições do Laudo Interno
    if (document.getElementById('mod-modelo-laudo')) document.getElementById('mod-modelo-laudo').value = exam.modeloLaudo || 'Padrão LIS InovaLab';
    if (document.getElementById('mod-formulario-coleta')) document.getElementById('mod-formulario-coleta').value = exam.formularioColeta || 'Ficha Padrão de Coleta';
