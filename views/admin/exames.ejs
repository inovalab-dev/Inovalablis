  // Global states for sheet import
  window.rawExamSheetRows = [];
  window.rawDeparaSheetRows = [];
  window.examHeaderRowIdx = 0;

  function safeStr(val) {
    if (val === undefined || val === null) return '';
    return String(val).trim();
  }

  function parsePriceValueClient(val) {
    if (val === undefined || val === null) return 0;
    if (typeof val === 'number') return isNaN(val) ? 0 : val;
    
    let str = String(val).replace(/R\$/i, '').replace(/\s/g, '').trim();
    if (!str) return 0;

    if (str.includes(',') && str.includes('.')) {
      const lastComma = str.lastIndexOf(',');
      const lastDot = str.lastIndexOf('.');
      if (lastComma > lastDot) {
        str = str.replace(/\./g, '').replace(',', '.');
      } else {
        str = str.replace(/,/g, '');
      }
    } else if (str.includes(',')) {
      str = str.replace(',', '.');
    } else if (str.includes('.')) {
      const parts = str.split('.');
      if (parts.length > 2) {
        str = str.replace(/\./g, '');
      } else if (parts.length === 2 && parts[1].length === 3) {
        str = parts.join('');
      }
    }

    const num = parseFloat(str);
    return isNaN(num) ? 0 : num;
  }

  function parseSpreadsheetRows(rawDataArray) {
    if (!Array.isArray(rawDataArray) || rawDataArray.length === 0) return [];

    // Check if rows are single string elements (e.g., semicolon-separated CSV)
    const isSingleStringRows = rawDataArray.some(row => 
      Array.isArray(row) && row.length === 1 && typeof row[0] === 'string' && (row[0].includes(';') || row[0].includes(',') || row[0].includes('\t'))
    );

    if (isSingleStringRows) {
      let delimiter = ';';
      const sampleLine = rawDataArray.find(r => r && r[0] && typeof r[0] === 'string')?.[0] || '';
      if (sampleLine.includes(';')) delimiter = ';';
      else if (sampleLine.includes('\t')) delimiter = '\t';
      else if (sampleLine.includes(',')) delimiter = ',';

      return rawDataArray.map(row => {
        if (Array.isArray(row) && row.length === 1 && typeof row[0] === 'string') {
          return row[0].split(delimiter).map(cell => safeStr(cell).replace(/^["']|["']$/g, ''));
        }
        if (Array.isArray(row)) {
          return row.map(cell => safeStr(cell));
        }
        return [];
      });
    }

    return rawDataArray.map(row => {
      if (Array.isArray(row)) {
        return row.map(cell => safeStr(cell));
      }
      return [];
    });
  }

  // Processamento de planilha no cliente (Exames)
  function handleExamSpreadsheet(e) {
    const file = e.target.files[0];
    if (!file) return;

    // Se for PDF ou se falhar cliente, tenta servidor
    const isPdf = file.name.toLowerCase().endsWith('.pdf') || file.type === 'application/pdf';

    if (isPdf) {
      const formData = new FormData();
      formData.append('file', file);
      fetch('/admin/exames/parse', { method: 'POST', body: formData })
        .then(res => res.json())
        .then(data => {
          if (!data.success) {
            alert('Erro ao analisar arquivo PDF: ' + (data.message || 'Erro no servidor'));
            return;
          }
          let rows = [];
          if (data.rows && data.rows.length > 0) {
            rows = parseSpreadsheetRows(data.rows);
          } else if (data.exams && data.exams.length > 0) {
            rows = [
              ['Código', 'Nome do Exame', 'Particular'],
              ...data.exams.map(ex => [ex.code || ex.jalisCode || '', ex.name || '', ex.pricePrivate || 0])
            ];
          }
          if (rows.length < 2) {
            alert('Nenhum exame pôde ser extraído do arquivo enviado.');
            return;
          }
          window.rawExamSheetRows = rows;
          populateExamColumnSelects(rows);
          onMappingChanged();
          document.getElementById('import-preview-box').classList.remove('hidden');
        })
        .catch(err => {
          console.error(err);
          alert('Erro ao enviar PDF para análise no servidor.');
        });
      return;
    }

    const reader = new FileReader();
    reader.onload = function(evt) {
      let rawData = [];
      try {
        const data = new Uint8Array(evt.target.result);
        const workbook = XLSX.read(data, { type: 'array' });
        const firstSheet = workbook.Sheets[workbook.SheetNames[0]];
        rawData = XLSX.utils.sheet_to_json(firstSheet, { header: 1 });
      } catch (err) {
        console.error(err);
        alert('Erro ao ler a planilha no navegador. Tentando pelo servidor...');
        
        // Fallback para servidor
        const formData = new FormData();
        formData.append('file', file);
        fetch('/admin/exames/parse', { method: 'POST', body: formData })
          .then(res => res.json())
          .then(data => {
            if (data.success && data.rows && data.rows.length > 1) {
              const rows = parseSpreadsheetRows(data.rows);
              window.rawExamSheetRows = rows;
              populateExamColumnSelects(rows);
              onMappingChanged();
              document.getElementById('import-preview-box').classList.remove('hidden');
            } else {
              alert('Não foi possível ler os dados do arquivo.');
            }
          });
        return;
      }

      const rows = parseSpreadsheetRows(rawData);
      if (rows.length < 2) {
        alert('A planilha está vazia ou não possui linhas de dados suficientes.');
        return;
      }

      window.rawExamSheetRows = rows;
      populateExamColumnSelects(rows);
      onMappingChanged();
      document.getElementById('import-preview-box').classList.remove('hidden');
    };
    reader.readAsArrayBuffer(file);
  }

  function populateExamColumnSelects(rows) {
    if (!rows || rows.length === 0) return;

    // Detectar linha de cabeçalho (máximo de colunas preenchidas nas primeiras 5 linhas)
    let headerRowIdx = 0;
    let maxNonEmpty = 0;
    for (let r = 0; r < Math.min(rows.length, 5); r++) {
      const row = rows[r];
      if (Array.isArray(row)) {
        const nonEmptyCount = row.filter(cell => safeStr(cell).length > 0).length;
        if (nonEmptyCount > maxNonEmpty) {
          maxNonEmpty = nonEmptyCount;
          headerRowIdx = r;
        }
      }
    }

    window.examHeaderRowIdx = headerRowIdx;
    const headers = rows[headerRowIdx] || [];
    const selects = ['select-col-jalis', 'select-col-name', 'select-col-price', 'select-col-cat', 'select-col-code'];

    selects.forEach(selId => {
      const sel = document.getElementById(selId);
      if (!sel) return;
      sel.innerHTML = '<option value="-1">(Nenhum / Padrão)</option>';
      headers.forEach((h, idx) => {
        const opt = document.createElement('option');
        opt.value = idx;
        const hStr = safeStr(h);
        opt.textContent = `Col ${idx + 1}: ${hStr || '(Sem título)'}`;
        sel.appendChild(opt);
      });
      sel.value = '-1';
    });

    // 1. Mapeamento por NOME de cabeçalho
    headers.forEach((h, idx) => {
      const text = safeStr(h).toLowerCase();
      const normText = text.normalize("NFD").replace(/[\u0300-\u036f]/g, "");

      if (/c[oó]digo|cod|jalis|cd_exame|id_exame/i.test(normText) && !/alvaro|pardini|ma|mat/i.test(normText)) {
        const sel = document.getElementById('select-col-jalis');
        if (sel && sel.value === '-1') sel.value = idx;
      }
      if (/descri[cç][aã]o|nome|exame|procedimento|desc/i.test(normText)) {
        const sel = document.getElementById('select-col-name');
        if (sel && sel.value === '-1') sel.value = idx;
      }
      if (/valor|pre[cç]o|price|particular|vlr|custo/i.test(normText)) {
        const sel = document.getElementById('select-col-price');
        if (sel && sel.value === '-1') sel.value = idx;
      }
      if (/categoria|setor|grupo|filtro|material|especialidade/i.test(normText)) {
        const sel = document.getElementById('select-col-cat');
        if (sel && sel.value === '-1') sel.value = idx;
      }
      if (/gest[aã]o|interno|amb|tuss/i.test(normText)) {
        const sel = document.getElementById('select-col-code');
        if (sel && sel.value === '-1') sel.value = idx;
      }
    });

    // 2. Mapeamento inteligente por CONTEÚDO das células se não encontrou por título
    const dataRows = rows.slice(headerRowIdx + 1, headerRowIdx + 11);
    if (dataRows.length > 0) {
      const selName = document.getElementById('select-col-name');
      const selJalis = document.getElementById('select-col-jalis');
      const selPrice = document.getElementById('select-col-price');

      if (selName && selName.value === '-1') {
        let bestCol = -1;
        let maxAvgLen = 0;
        headers.forEach((_, cIdx) => {
          let totalLen = 0;
          let count = 0;
          dataRows.forEach(r => {
            const val = safeStr(r[cIdx]);
            if (val && !/^\d+(\.\d+)?$/.test(val)) {
              totalLen += val.length;
              count++;
            }
          });
          const avg = count > 0 ? totalLen / count : 0;
          if (avg > maxAvgLen) {
            maxAvgLen = avg;
            bestCol = cIdx;
          }
        });
        if (bestCol !== -1) selName.value = bestCol;
      }

      if (selJalis && selJalis.value === '-1') {
        let bestCol = -1;
        headers.forEach((_, cIdx) => {
          if (cIdx === parseInt(selName?.value ?? -1)) return;
          let isCodeLike = true;
          let matchCount = 0;
          dataRows.forEach(r => {
            const val = safeStr(r[cIdx]);
            if (val) {
              matchCount++;
              if (val.length > 20) isCodeLike = false;
            }
          });
          if (isCodeLike && matchCount > 0 && bestCol === -1) {
            bestCol = cIdx;
          }
        });
        if (bestCol !== -1) selJalis.value = bestCol;
      }

      if (selPrice && selPrice.value === '-1') {
        let bestCol = -1;
        headers.forEach((_, cIdx) => {
          if (cIdx === parseInt(selName?.value ?? -1) || cIdx === parseInt(selJalis?.value ?? -1)) return;
          let priceMatches = 0;
          dataRows.forEach(r => {
            const p = parsePriceValueClient(r[cIdx]);
            if (p > 0) priceMatches++;
          });
          if (priceMatches > 0 && bestCol === -1) {
            bestCol = cIdx;
          }
        });
        if (bestCol !== -1) selPrice.value = bestCol;
      }
    }
  }

  function onMappingChanged() {
    const rows = window.rawExamSheetRows || [];
    const headerRowIdx = window.examHeaderRowIdx || 0;
    if (rows.length <= headerRowIdx) return;

    const colJalis = parseInt(document.getElementById('select-col-jalis')?.value ?? -1);
    const colName = parseInt(document.getElementById('select-col-name')?.value ?? -1);
    const colPrice = parseInt(document.getElementById('select-col-price')?.value ?? -1);
    const colCat = parseInt(document.getElementById('select-col-cat')?.value ?? -1);
    const colCode = parseInt(document.getElementById('select-col-code')?.value ?? -1);

    const dataRows = rows.slice(headerRowIdx + 1);
    const tbody = document.getElementById('import-preview-tbody');
    tbody.innerHTML = '';

    let validCount = 0;
    dataRows.forEach((row, rIdx) => {
      const jalis = colJalis >= 0 ? safeStr(row[colJalis]) : '';
      const code = colCode >= 0 ? safeStr(row[colCode]) : jalis;
      let name = colName >= 0 ? safeStr(row[colName]) : '';
      if (!name) {
        name = safeStr(row[1]) || safeStr(row[0]);
      }
      const cat = colCat >= 0 ? (safeStr(row[colCat]) || 'Geral') : 'Geral';
      const price = colPrice >= 0 ? parsePriceValueClient(row[colPrice]) : 0;

      if (name || code || jalis) validCount++;

      if (rIdx < 20) {
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-slate-50';
        tr.innerHTML = `
          <td class="p-2 font-mono font-bold text-slate-800">${code || jalis || '—'}</td>
          <td class="p-2 font-bold text-slate-900">${name || '<span class="text-rose-400">Sem descrição</span>'}</td>
          <td class="p-2 text-slate-600">${cat || 'Geral'}</td>
          <td class="p-2 font-mono text-emerald-700 font-bold">R$ ${price.toFixed(2)}</td>
        `;
        tbody.appendChild(tr);
      }
    });

    const badge = document.getElementById('preview-summary-badge');
    if (badge) badge.innerText = `${validCount} exames válidos para importar`;
  }

  function submitImportedExams() {
    const rows = window.rawExamSheetRows || [];
    const headerRowIdx = window.examHeaderRowIdx || 0;
    if (rows.length <= headerRowIdx) {
      alert('Nenhuma planilha carregada.');
      return;
    }

    const colJalis = parseInt(document.getElementById('select-col-jalis')?.value ?? -1);
    const colName = parseInt(document.getElementById('select-col-name')?.value ?? -1);
    const colPrice = parseInt(document.getElementById('select-col-price')?.value ?? -1);
    const colCat = parseInt(document.getElementById('select-col-cat')?.value ?? -1);
    const colCode = parseInt(document.getElementById('select-col-code')?.value ?? -1);

    const dataRows = rows.slice(headerRowIdx + 1);
    const exams = [];

    dataRows.forEach(row => {
      const jalis = colJalis >= 0 ? safeStr(row[colJalis]) : '';
      const code = colCode >= 0 ? safeStr(row[colCode]) : jalis;
      let name = colName >= 0 ? safeStr(row[colName]) : '';
      if (!name) {
        name = safeStr(row[1]) || safeStr(row[0]);
      }
      const category = colCat >= 0 ? (safeStr(row[colCat]) || 'Geral') : 'Geral';
      const pricePrivate = colPrice >= 0 ? parsePriceValueClient(row[colPrice]) : 0;

      if (name || code || jalis) {
        exams.push({
          code: code || jalis,
          jalisCode: jalis || code,
          name: name || (code || jalis),
          category: category || 'Geral',
          pricePrivate
        });
      }
    });

    if (exams.length === 0) {
      alert('Nenhum exame válido foi encontrado para importação.');
      return;
    }

    const confirmBtn = document.getElementById('confirm-import-btn');
    if (confirmBtn) {
      confirmBtn.disabled = true;
      confirmBtn.innerHTML = `
        <svg class="animate-spin h-4 w-4 text-white inline-block mr-1" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        Importando...
      `;
    }

    fetch('/admin/exames/import', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ exams, clearFirst: false })
    })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        alert(`✅ ${data.count} exames cadastrados / atualizados com sucesso!`);
        window.location.reload();
      } else {
        alert('❌ Erro ao importar: ' + (data.message || 'Erro no servidor'));
        if (confirmBtn) {
          confirmBtn.disabled = false;
          confirmBtn.innerHTML = 'Confirmar Importação';
        }
      }
    })
    .catch(err => {
      console.error(err);
      alert('❌ Erro de conexão com o servidor.');
      if (confirmBtn) {
        confirmBtn.disabled = false;
        confirmBtn.innerHTML = 'Confirmar Importação';
      }
    });
  }

  // Processamento de planilha (De/Para)
  function handleDeparaSpreadsheet(e) {
    const file = e.target.files[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = function(evt) {
      let rawData = [];
      try {
        const data = new Uint8Array(evt.target.result);
        const workbook = XLSX.read(data, { type: 'array' });
        const firstSheet = workbook.Sheets[workbook.SheetNames[0]];
        rawData = XLSX.utils.sheet_to_json(firstSheet, { header: 1 });
      } catch (err) {
        console.error(err);
        alert('Erro ao ler a planilha de De/Para.');
        return;
      }

      const rows = parseSpreadsheetRows(rawData);
      if (rows.length < 2) {
        alert('A planilha está vazia ou não possui linhas suficientes.');
        return;
      }

      window.rawDeparaSheetRows = rows;
      populateDeparaColumnSelects(rows);
      onDeparaMappingChanged();
      document.getElementById('depara-preview-box').classList.remove('hidden');
    };
    reader.readAsArrayBuffer(file);
  }

  function populateDeparaColumnSelects(rows) {
    const headers = rows[0] || [];
    const selects = ['select-depara-jalis', 'select-depara-alvaro', 'select-depara-pardini'];

    selects.forEach(selId => {
      const sel = document.getElementById(selId);
      if (!sel) return;
      sel.innerHTML = '<option value="-1">(Nenhum)</option>';
      headers.forEach((h, idx) => {
        const opt = document.createElement('option');
        opt.value = idx;
        opt.textContent = `Col ${idx + 1}: ${h || '(Sem título)'}`;
        sel.appendChild(opt);
      });
    });

    headers.forEach((h, idx) => {
      const text = String(h || '').toLowerCase().trim();
      if (/jalis|local|interno|nosso/i.test(text)) {
        const sel = document.getElementById('select-depara-jalis');
        if (sel && sel.value === '-1') sel.value = idx;
      }
      if (/alvaro|[áa]lvaro/i.test(text)) {
        const sel = document.getElementById('select-depara-alvaro');
        if (sel && sel.value === '-1') sel.value = idx;
      }
      if (/pardini/i.test(text)) {
        const sel = document.getElementById('select-depara-pardini');
        if (sel && sel.value === '-1') sel.value = idx;
      }
    });
  }

