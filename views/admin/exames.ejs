    }
    if (!abrev) {
      const masterList = window.globalMateriaisColetadosMasterList || [];
      const foundMaster = masterList.find(m => (m.descricao || '').trim().toUpperCase() === nome.trim().toUpperCase());
      if (foundMaster && foundMaster.abreviatura) {
        abrev = foundMaster.abreviatura;
      } else {
        abrev = nome.slice(0, 3).toUpperCase();
      }
    }
    const prazo = document.getElementById('mat-input-prazo').value;
    const metodo = document.getElementById('mat-input-metodo').value;
    const amb = document.getElementById('mat-input-amb').value;
    const cbhpm = document.getElementById('mat-input-cbhpm').value;
    const pagina = document.getElementById('mat-input-pagina').value;
    const ordem = document.getElementById('mat-input-ordem').value;
    const copias = document.getElementById('mat-input-copias').value;

    const proibir = document.getElementById('mat-check-proibir').checked;
    const naoImprimir = document.getElementById('mat-check-nao-imprimir').checked;
    const proibidoApoio = document.getElementById('mat-check-proibido-apoio').checked;
    const paginaSeparada = document.getElementById('mat-check-pagina-separada').checked;

    const coleta = document.getElementById('mat-text-coleta').value;
    const preparo = document.getElementById('mat-text-preparo').value;
    const amostra = document.getElementById('mat-text-amostra').value;
    const inadequada = document.getElementById('mat-text-inadequada') ? document.getElementById('mat-text-inadequada').value : '';
    const referencia = document.getElementById('mat-text-referencia').value;
    const procedimento = document.getElementById('mat-text-procedimento') ? document.getElementById('mat-text-procedimento').value : '';
    const conservacao = document.getElementById('mat-text-conservacao').value;
    const mensagem = document.getElementById('mat-text-mensagem') ? document.getElementById('mat-text-mensagem').value : '';
    const planilha = document.getElementById('mat-text-planilha') ? document.getElementById('mat-text-planilha').value : '';

    const newMat = {
      id: editingMaterialIndex >= 0 && currentMateriaisList[editingMaterialIndex] ? currentMateriaisList[editingMaterialIndex].id : Date.now(),
      nome,
      abrev,
      prazo,
      metodo,
      amb,
      cbhpm,
      pagina,
      ordem,
      copias,
      proibir,
      naoImprimir,
      proibidoApoio,
      paginaSeparada,
      coleta,
      preparo,
      amostra,
      inadequada,
      referencia,
      procedimento,
      conservacao,
      mensagem,
      planilha,
      // Tab 2
      sorotecaDias: document.getElementById('rec-soroteca-dias').value,
      sorotecaUnidade: document.getElementById('rec-soroteca-unidade').value,
      sorotecaConservacao: document.getElementById('rec-soroteca-conservacao').value,
      recipientesColeta: recipientesColetaList,
      recipientesTriagem: recipientesTriagemList,
      // Tab 3
      insumos: insumosList,
      taxas: taxasList,
      custoSimples: document.getElementById('custo-simples').value,
      // Tab 4
      precoCusto: document.getElementById('preco-custo').value,
      precoBase: document.getElementById('preco-base').value,
      precoFator: document.getElementById('preco-fator').value,
      precoCh: document.getElementById('preco-ch').value,
      precoFilme: document.getElementById('preco-filme').value,
      priceTableValues: materialPriceTableValues,
      // Tab 5
      modeloLaudo: document.getElementById('mod-modelo-laudo') ? document.getElementById('mod-modelo-laudo').value : 'Padrão LIS InovaLab',
      formularioColeta: document.getElementById('mod-formulario-coleta') ? document.getElementById('mod-formulario-coleta').value : 'Ficha Padrão de Coleta',
      cabecalho: document.getElementById('mod-cabecalho') ? document.getElementById('mod-cabecalho').value : '',
      tituloLaudo: document.getElementById('mod-titulo-laudo') ? document.getElementById('mod-titulo-laudo').value : '',
      materialLaudo: document.getElementById('mod-material-laudo') ? document.getElementById('mod-material-laudo').value : '',
      metodoLaudo: document.getElementById('mod-metodo-laudo') ? document.getElementById('mod-metodo-laudo').value : '',
      valorReferenciaLaudo: document.getElementById('mod-valor-referencia-laudo') ? document.getElementById('mod-valor-referencia-laudo').value : '',
      lisLayouts: (editingMaterialIndex >= 0 && currentMateriaisList[editingMaterialIndex] && currentMateriaisList[editingMaterialIndex].lisLayouts) ? currentMateriaisList[editingMaterialIndex].lisLayouts : (window.tempMaterialLisLayouts || {}),
      // Tab 6
      medInterferentes: document.getElementById('med-interferentes').value,
      medSuspender: document.getElementById('med-suspender').value,
      // Tab 7
      conveniosRegras: conveniosRegrasList,
      // Tab 8
      setorBancada: document.getElementById('adic-setor-bancada').value,
      loinc: document.getElementById('adic-loinc').value,
      unidadeMedida: document.getElementById('adic-unidade-medida').value,
      validadeLaudo: document.getElementById('adic-validade-laudo').value,
      // Tab 9
      labApoio: document.getElementById('ext-lab-apoio') ? document.getElementById('ext-lab-apoio').value : '',
      codigoApoio: document.getElementById('ext-codigo-apoio') ? document.getElementById('ext-codigo-apoio').value : '',
      tempTransporte: document.getElementById('ext-temp-transporte').value,
      recipienteTransporte: document.getElementById('ext-recipiente-transporte').value,
      labExternoList: labExternoList,
      // Tab 10
      codigoHl7: document.getElementById('integ-codigo-hl7').value,
      equipamento: document.getElementById('integ-equipamento').value,
      canal: document.getElementById('integ-canal').value,
      pacs: document.getElementById('integ-pacs').checked
    };

    // Sincronizar preços com a lista global de tabelas e persistir no servidor
    if (Array.isArray(materialPriceTableValues) && materialPriceTableValues.length > 0) {
      const examCode = (document.getElementById('form-exam-jalisCode')?.value || document.getElementById('form-exam-code-hidden')?.value || 'EXAME').trim().toUpperCase();
      const examName = (document.getElementById('form-exam-name')?.value || 'Exame').trim();
      const matName = (newMat.nome || newMat.material || newMat.abrev || 'SGE').trim();
      const matKey = matName.toUpperCase();

      materialPriceTableValues.forEach(item => {
        const targetPt = rawPriceTables.find(pt => String(pt.id) === String(item.tableId));
        if (targetPt) {
          if (!targetPt.precios) targetPt.precios = [];
          const pIdx = targetPt.precios.findIndex(p => 
            String(p.examCode).toUpperCase().trim() === examCode &&
            String(p.material).toUpperCase().trim() === matKey
          );

          const precioObj = {
            examCode: examCode,
            material: matName,
            examName: examName,
            amb: item.amb || '',
            valor: parseFloat(item.valor) || 0.00,
            proibir: item.proibir === true
          };

          if (pIdx >= 0) {
            targetPt.precios[pIdx] = precioObj;
          } else {
            targetPt.precios.push(precioObj);
          }

          // Persistir no backend
          fetch(`/admin/tabela-precos/save-prices/${targetPt.id}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ precios: targetPt.precios })
          }).catch(err => console.error('Erro ao salvar preços:', err));
        }
      });
    }

    if (editingMaterialIndex >= 0 && editingMaterialIndex < currentMateriaisList.length) {
      currentMateriaisList[editingMaterialIndex] = newMat;
    } else {
      currentMateriaisList.push(newMat);
    }

    renderMateriaisTable();
    closeMaterialModal();
  }

