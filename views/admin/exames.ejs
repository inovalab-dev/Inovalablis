  <div class="bg-white w-full max-w-2xl rounded-2xl shadow-2xl border border-gray-200 overflow-hidden transform transition-all flex flex-col max-h-[85vh]">
    
    <!-- Header -->
    <div class="px-5 py-3.5 bg-slate-900 text-white flex items-center justify-between shrink-0">
      <div class="flex items-center gap-2.5">
        <span class="text-xl">🔍</span>
        <div>
          <div class="flex items-center gap-2 flex-wrap">
            <h3 class="text-xs font-black uppercase font-mono tracking-wider text-brand-gold">
              Pesquisar Exame de Apoio
            </h3>
            <div id="modal-support-exam-lab-badge"></div>
          </div>
          <p class="text-[10px] text-gray-400">Selecione o exame do laboratório parceiro para vincular</p>
        </div>
      </div>
      <button type="button" onclick="closeSearchSupportExamModal()" class="text-gray-400 hover:text-white text-2xl font-bold p-1 cursor-pointer">&times;</button>
    </div>

    <!-- Campo para filtrar por código ou descrição do exame (acima da listagem) -->
    <div class="p-4 bg-slate-50 border-b border-gray-200 shrink-0">
      <label class="block text-[11px] font-extrabold text-slate-700 uppercase font-mono mb-1.5">
        Filtrar por código ou descrição do exame:
      </label>
      <div class="relative">
        <input type="text" id="search-support-exam-input" oninput="filterSupportExamsTable()" placeholder="Digite o código ou nome do exame para filtrar..." class="w-full pl-9 pr-3 py-2 bg-white border border-gray-300 rounded-xl font-bold text-xs text-slate-800 outline-none focus:ring-2 focus:ring-emerald-500 shadow-2xs">
        <span class="absolute left-3 top-2.5 text-gray-400 text-sm">🔍</span>
      </div>
    </div>

    <!-- Tabela contendo os exames do laboratório selecionado -->
    <div class="p-4 overflow-y-auto flex-1">
      <div class="border border-gray-200 rounded-xl overflow-hidden shadow-2xs">
        <table class="w-full text-left font-mono text-xs">
          <thead class="bg-gray-100 border-b border-gray-200 text-[10px] font-black text-gray-600 uppercase">
            <tr>
              <th class="p-2.5 w-24 text-center">Código</th>
              <th class="p-2.5">Exame</th>
              <th class="p-2.5 w-28 text-right">Valor</th>
              <th class="p-2.5 w-36">Material</th>
              <th class="p-2.5 w-24 text-center">Ação</th>
            </tr>
          </thead>
          <tbody id="searchSupportExamsTableBody" class="divide-y divide-gray-100 bg-white">
            <!-- Renderizado via JS -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- Footer -->
    <div class="px-5 py-3 bg-gray-50 border-t border-gray-200 flex justify-end shrink-0">
      <button type="button" onclick="closeSearchSupportExamModal()" class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold text-xs uppercase tracking-wider rounded-xl transition-all cursor-pointer">
        Fechar
      </button>
    </div>

  </div>
</div>

<!-- MODAL SELECIONAR MATERIAL DO EXAME DE APOIO -->
<div id="modalSelectSupportMaterial" class="fixed inset-0 z-[90] bg-black/75 backdrop-blur-sm flex items-center justify-center p-3 sm:p-5 hidden">
  <div class="bg-white w-full max-w-lg rounded-2xl shadow-2xl border border-gray-200 overflow-hidden transform transition-all flex flex-col max-h-[85vh]">
    
    <!-- Header -->
    <div class="px-5 py-3.5 bg-slate-900 text-white flex items-center justify-between shrink-0">
      <div class="flex items-center gap-2.5">
        <span class="text-xl">🧪</span>
        <div>
          <h3 class="text-xs font-black uppercase font-mono tracking-wider text-brand-gold">
            Selecionar Material do Exame
          </h3>
          <p id="modal-select-mat-exam-info" class="text-[11px] font-mono text-gray-300 font-bold truncate max-w-[320px]">
            Exame de Apoio
          </p>
        </div>
      </div>
      <button type="button" onclick="closeSelectSupportMaterialModal()" class="text-gray-400 hover:text-white text-2xl font-bold p-1 cursor-pointer">&times;</button>
    </div>

    <!-- Body -->
    <div class="p-5 space-y-4 overflow-y-auto flex-1">
      <div class="bg-amber-50 border border-amber-200 p-3 rounded-xl flex items-start gap-2.5">
        <span class="text-amber-600 text-lg shrink-0">ℹ️</span>
        <div class="text-xs text-amber-900 font-sans leading-relaxed">
          <p class="font-bold mb-0.5">Mais de um material disponível no cadastro!</p>
          <p>Escolha qual dos materiais cadastrados para este exame de apoio será configurado:</p>
        </div>
      </div>

      <!-- Materials Options List -->
      <div id="support-materials-options-container" class="space-y-2.5">
        <!-- Renderizado via JS -->
      </div>
    </div>

    <!-- Footer -->
    <div class="px-5 py-3 bg-gray-50 border-t border-gray-200 flex items-center justify-between shrink-0">
      <button type="button" onclick="closeSelectSupportMaterialModal()" class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-700 font-bold text-xs uppercase tracking-wider rounded-xl transition-all cursor-pointer">
        Cancelar
      </button>
      <button type="button" onclick="confirmSelectedSupportMaterial()" class="px-5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-black text-xs uppercase tracking-wider rounded-xl transition-all shadow-md cursor-pointer flex items-center gap-1.5">
        <span>✓</span> Confirmar Escolha
      </button>
    </div>

  </div>
</div>

<script>
  const existingExams = <%- JSON.stringify(exams) %>;
  let rawPriceTables = <%- JSON.stringify(typeof priceTables !== 'undefined' ? priceTables : []) %>;
  let materialPriceTableValues = [];
  let currentMateriaisList = [];
  let currentSetoresList = [{ id: 1, codigo: '1', nome: 'Hematologia', mapa: true, etqCol: true, etqTri: true }];

  // --- CONTROLE DE NAVEGAÇÃO DE ABAS PRINCIPAIS ---
  function switchExamTab(tabName) {
    document.querySelectorAll('.exam-tab-panel').forEach(panel => panel.classList.add('hidden'));
    document.querySelectorAll('.exam-tab-btn').forEach(btn => {
      btn.classList.remove('bg-white', 'border-t-2', 'border-emerald-600', 'text-emerald-800', 'shadow-2xs');
      btn.classList.add('text-gray-600');
    });

    const activePanel = document.getElementById('tab-exam-' + tabName);
    const activeBtn = document.getElementById('exam-tab-btn-' + tabName);
    if (activePanel) activePanel.classList.remove('hidden');
    if (activeBtn) {
      activeBtn.classList.add('bg-white', 'border-t-2', 'border-emerald-600', 'text-emerald-800', 'shadow-2xs');
      activeBtn.classList.remove('text-gray-600');
    }
  }

  // --- CONTROLE DE SUB-ABAS DE DADOS CADASTRAIS ---
  function switchSubTab(subName) {
    document.querySelectorAll('.subtab-panel').forEach(p => p.classList.add('hidden'));
    document.querySelectorAll('.subtab-btn').forEach(b => {
      b.classList.remove('bg-white', 'text-emerald-800', 'shadow-2xs');
      b.classList.add('text-gray-600');
    });

    const targetPanel = document.getElementById('subtab-panel-' + subName);
    const targetBtn = document.getElementById('subtab-btn-' + subName);
    if (targetPanel) targetPanel.classList.remove('hidden');
    if (targetBtn) {
      targetBtn.classList.add('bg-white', 'text-emerald-800', 'shadow-2xs');
      targetBtn.classList.remove('text-gray-600');
    }
  }

  // --- CONTROLE DE ABAS INTERNAS DO MATERIAL COLETADO ---
  function switchMaterialTab(matTabName) {
    document.querySelectorAll('.mat-panel').forEach(p => p.classList.add('hidden'));
    document.querySelectorAll('.mat-tab-btn').forEach(b => {
      b.classList.remove('bg-emerald-100', 'text-emerald-800');
      b.classList.add('text-gray-600');
    });

    const panel = document.getElementById('mat-panel-' + matTabName);
    const btn = document.getElementById('mat-tab-btn-' + matTabName);
    if (panel) panel.classList.remove('hidden');
    if (btn) {
      btn.classList.add('bg-emerald-100', 'text-emerald-800');
      btn.classList.remove('text-gray-600');
    }
  }

  // --- CONTROLE DAS 10 ABAS PRINCIPAIS DO MATERIAL COLETADO ---
  function switchMaterialMainTab(tabName) {
    document.querySelectorAll('.mat-main-panel').forEach(p => p.classList.add('hidden'));
    document.querySelectorAll('.mat-main-tab-btn').forEach(b => {
      b.classList.remove('bg-white', 'border-t-2', 'border-emerald-600', 'text-emerald-800', 'shadow-2xs');
      b.classList.add('text-gray-600');
    });

    const panel = document.getElementById('mat-main-panel-' + tabName);
    const btn = document.getElementById('mat-main-tab-btn-' + tabName);
    if (panel) panel.classList.remove('hidden');
    if (btn) {
      btn.classList.add('bg-white', 'border-t-2', 'border-emerald-600', 'text-emerald-800', 'shadow-2xs');
      btn.classList.remove('text-gray-600');
    }

    if (tabName === 'modelos') {
      updateExamesModelBadges();
    }
  }

  // --- ARRAYS DE SUBTABELAS DO MATERIAL ---
  let recipientesColetaList = [];
  let recipientesTriagemList = [];
  let insumosList = [];
  let taxasList = [];
  let conveniosRegrasList = [];
  let labExternoList = [];
  let selectedLabExternoIdx = -1;

  function selectLabExternoRow(idx) {
    selectedLabExternoIdx = idx;
    renderLabExternoTable();
  }

  function setLabExternoPadrao(idx, event) {
    if (event) event.stopPropagation();
    if (idx < 0 || idx >= labExternoList.length) return;

    labExternoList.forEach((item, i) => {
      item.padrao = (i === idx);
    });
    selectedLabExternoIdx = idx;

    const defaultLab = labExternoList[idx];
    if (defaultLab) {
      if (document.getElementById('ext-lab-apoio')) {
        document.getElementById('ext-lab-apoio').value = defaultLab.lab;
      }
      if (document.getElementById('ext-codigo-apoio')) {
        document.getElementById('ext-codigo-apoio').value = defaultLab.exame || '';
      }
    }

    renderLabExternoTable();
  }

  function setLabExternoPadraoFromButton() {
    if (selectedLabExternoIdx >= 0 && selectedLabExternoIdx < labExternoList.length) {
      setLabExternoPadrao(selectedLabExternoIdx);
    } else if (labExternoList.length > 0) {
      const currentDefault = labExternoList.findIndex(i => i.padrao);
      setLabExternoPadrao(currentDefault >= 0 ? currentDefault : 0);
    } else {
      alert('Adicione pelo menos um laboratório externo para definir como padrão.');
    }
  }

  function renderLabExternoTable() {
    const tbody = document.getElementById('labExternoTableBody');
    if (!tbody) return;
    tbody.innerHTML = '';

    if (labExternoList.length === 0) {
      tbody.innerHTML = `
        <tr>
          <td colspan="10" class="p-6 text-center text-gray-400 font-sans italic text-xs">
            Nenhum laboratório de apoio vinculado a este exame.
          </td>
        </tr>
      `;
      return;
    }

    // Se nenhum item estiver marcado como padrão e houver pelo menos 1 item, ajusta automaticamente o primeiro não-bloqueado
    if (!labExternoList.some(i => i.padrao)) {
      const firstActive = labExternoList.findIndex(i => !i.bloq);
      if (firstActive >= 0) labExternoList[firstActive].padrao = true;
      else labExternoList[0].padrao = true;
    }

    labExternoList.forEach((item, idx) => {
      const isPadrao = !!item.padrao;
      const isSelected = (idx === selectedLabExternoIdx);
      const isBloq = !!item.bloq;

      const tr = document.createElement('tr');
      tr.onclick = function() { selectLabExternoRow(idx); };

      let rowBgClass = 'hover:bg-slate-50 text-slate-800 border-l-4 border-transparent cursor-pointer transition-all';
      if (isPadrao) {
        rowBgClass = 'bg-emerald-50/90 hover:bg-emerald-100/80 text-emerald-950 font-bold border-l-4 border-emerald-600 cursor-pointer transition-all shadow-2xs';
      } else if (isBloq) {
        rowBgClass = 'bg-rose-50/70 hover:bg-rose-100/70 text-rose-900 border-l-4 border-rose-300 cursor-pointer transition-all';
      } else if (isSelected) {
        rowBgClass = 'bg-blue-50/90 hover:bg-blue-100/80 text-blue-950 border-l-4 border-blue-500 font-semibold cursor-pointer transition-all';
      }

      tr.className = rowBgClass;

      const padraoBtnHtml = isPadrao
        ? `<button type="button" onclick="setLabExternoPadrao(${idx}, event)" class="px-2 py-0.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-full font-black text-[10px] uppercase shadow-2xs cursor-pointer inline-flex items-center gap-1 transition-all" title="Laboratório Padrão Selecionado">⭐ PADRÃO</button>`
        : `<button type="button" onclick="setLabExternoPadrao(${idx}, event)" class="px-2 py-0.5 bg-slate-100 hover:bg-emerald-100 hover:text-emerald-800 text-slate-600 border border-slate-200 rounded-full font-bold text-[10px] transition-all cursor-pointer inline-flex items-center gap-1" title="Definir como Padrão">Definir</button>`;

      const labBadgeHtml = isPadrao
        ? `<span class="inline-flex items-center gap-1 text-emerald-950"><span class="font-extrabold">${item.lab || ''}</span><span class="px-1.5 py-0.2 bg-emerald-700 text-white font-mono font-black text-[9px] rounded uppercase">PADRÃO</span></span>`
        : `<span class="font-bold text-slate-800">${item.lab || ''}</span>`;

      const matBadgeHtml = item.material 
        ? `<span class="inline-flex items-center gap-1 px-2 py-0.5 bg-amber-50 text-amber-900 border border-amber-200 text-[10px] font-bold rounded-md shadow-2xs">🧪 ${item.material}</span>`
        : `<span class="text-gray-400 italic text-[10px]">-</span>`;

      tr.innerHTML = `
        <td class="p-2 text-center" onclick="event.stopPropagation()">${padraoBtnHtml}</td>
        <td class="p-2 text-center font-mono font-bold text-gray-600">#${item.codigo || (idx + 1)}</td>
        <td class="p-2">${labBadgeHtml}</td>
        <td class="p-2 font-medium">${item.exame || ''}</td>
        <td class="p-2">${matBadgeHtml}</td>
        <td class="p-2 text-center font-mono">${item.prazo || '0'}</td>
        <td class="p-2 text-right font-mono font-bold text-slate-700">R$ ${item.valor || '0,0000'}</td>
        <td class="p-2 text-gray-600">${item.metodo || ''}</td>
        <td class="p-2 text-center" onclick="event.stopPropagation()">
          <input type="checkbox" ${isBloq ? 'checked' : ''} onchange="toggleLabExternoBloq(${idx})" class="w-4 h-4 text-rose-600 rounded cursor-pointer" title="Bloquear laboratório">
        </td>
        <td class="p-2 text-center" onclick="event.stopPropagation()">
          <div class="flex items-center justify-center gap-1.5">
            <button type="button" onclick="openSearchSupportExamModal(${idx})" class="px-2 py-1 bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-200 rounded-lg font-bold text-xs transition-all cursor-pointer" title="Configurar / Selecionar Exame no Apoio">
              ⚙️
            </button>
            <button type="button" onclick="removeLabExternoItem(${idx})" class="px-2 py-1 bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 rounded-lg font-bold text-xs transition-all cursor-pointer" title="Excluir item">
              🗑️
            </button>
          </div>
        </td>
      `;
      tbody.appendChild(tr);
    });
  }

  function addLabExternoItem() {
    const lab = document.getElementById('ext-lab-nome').value.trim();
    const exame = document.getElementById('ext-lab-exame').value.trim();
    const prazo = document.getElementById('ext-lab-prazo').value.trim() || '0';
    const valor = document.getElementById('ext-lab-valor').value.trim() || '0,0000';
    const metodo = document.getElementById('ext-lab-metodo').value.trim();
    const bloq = document.getElementById('ext-lab-bloq').checked;
    const material = window.currentSelectedSupportMaterial || '';

    if (!lab) {
      alert('Informe o nome do laboratório de apoio.');
      return;
    }

    const isFirst = labExternoList.length === 0;

    labExternoList.push({
      codigo: labExternoList.length + 1,
      lab,
      exame,
      material,
      prazo,
      valor,
      metodo,
      bloq,
      padrao: isFirst
    });

    if (isFirst) {
      selectedLabExternoIdx = 0;
      if (document.getElementById('ext-lab-apoio')) {
        document.getElementById('ext-lab-apoio').value = lab;
      }
    }

    document.getElementById('ext-lab-nome').value = '';
    document.getElementById('ext-lab-exame').value = '';
    document.getElementById('ext-lab-prazo').value = '0';
    document.getElementById('ext-lab-valor').value = '0,0000';
    document.getElementById('ext-lab-metodo').value = '';
    document.getElementById('ext-lab-bloq').checked = false;
    window.currentSelectedSupportMaterial = '';

    renderLabExternoTable();
  }

  function removeLabExternoItem(idx) {
    const wasPadrao = labExternoList[idx] && labExternoList[idx].padrao;
    labExternoList.splice(idx, 1);
    if (wasPadrao && labExternoList.length > 0) {
      labExternoList[0].padrao = true;
    }
    selectedLabExternoIdx = -1;
    renderLabExternoTable();
  }

  function toggleLabExternoBloq(idx) {
    if (labExternoList[idx]) {
      labExternoList[idx].bloq = !labExternoList[idx].bloq;
      renderLabExternoTable();
    }
  }

  window.globalSupportLabsList = <%- JSON.stringify(locals.labs || []) %>;

  async function fetchAndUpdateSupportLabsDropdown() {
    try {
      const res = await fetch('/api/laboratorios');
      if (res.ok) {
        const list = await res.json();
        if (Array.isArray(list)) {
          window.globalSupportLabsList = list;
          const select = document.getElementById('ext-lab-nome');
          if (select) {
            const currentVal = select.value;
            select.innerHTML = '<option value="">-- Selecione o Laboratório --</option><option value="Interno">Interno</option>';
            list.forEach(l => {
              const desc = l.descricao || l.name || l.codigo;
              if (desc && desc.trim().toLowerCase() !== 'interno') {
                const opt = document.createElement('option');
                opt.value = desc;
                opt.textContent = desc;
                select.appendChild(opt);
              }
            });
            if (currentVal && Array.from(select.options).some(o => o.value === currentVal)) {
              select.value = currentVal;
            }
          }
        }
      }
    } catch (e) {
      console.warn("Não foi possível atualizar a lista de laboratórios de apoio:", e);
    }
  }

  // --- FUNÇÕES DO MODAL DE PESQUISA DE EXAME DE APOIO ---
  let examesAlvaroCatalog = <%- JSON.stringify(locals.examesAlvaro || []) %>;
  let examesPardiniCatalog = <%- JSON.stringify(locals.examesPardini || []) %>;

  let catalogSupportExams = [];
  let currentTargetRowIdx = -1;

  async function openSearchSupportExamModal(targetIdx = -1) {
    currentTargetRowIdx = targetIdx;
    let targetLabName = '';

    if (targetIdx >= 0 && targetIdx < labExternoList.length) {
      targetLabName = labExternoList[targetIdx].lab || '';
    } else {
      const selectLab = document.getElementById('ext-lab-nome');
      if (selectLab) {
        targetLabName = selectLab.value || '';
      }
    }

    // Tentar atualizar catálogos com dados mais recentes do servidor
    try {
      const [resAlvaro, resPardini] = await Promise.all([
        fetch('/api/lab-externo/alvaro/exames').then(r => r.ok ? r.json() : null).catch(() => null),
        fetch('/api/lab-externo/pardini/exames').then(r => r.ok ? r.json() : null).catch(() => null)
      ]);
      if (resAlvaro && resAlvaro.success && Array.isArray(resAlvaro.exames) && resAlvaro.exames.length > 0) {
        examesAlvaroCatalog = resAlvaro.exames;
      }
      if (resPardini && resPardini.success && Array.isArray(resPardini.exames) && resPardini.exames.length > 0) {
        examesPardiniCatalog = resPardini.exames;
      }
    } catch (e) {
      console.warn("Usando catálogo inicial pré-carregado.");
    }

    buildCatalogSupportExams(targetLabName);
    document.getElementById('modalSearchSupportExam').classList.remove('hidden');
    const input = document.getElementById('search-support-exam-input');
    if (input) {
      input.value = '';
      setTimeout(() => input.focus(), 100);
    }
    renderSupportExamsTable(catalogSupportExams);
  }

  function closeSearchSupportExamModal() {
    document.getElementById('modalSearchSupportExam').classList.add('hidden');
  }

  function buildCatalogSupportExams(labName = '') {
    const list = [];
    const setCodes = new Set();
    const lowerLab = String(labName || '').toLowerCase().trim();

    let sourceCatalog = [];
    const isAlvaro = lowerLab.includes('alvaro') || lowerLab.includes('álvaro');
    const isPardini = lowerLab.includes('pardini') || lowerLab.includes('hermes');

    const badgeEl = document.getElementById('modal-support-exam-lab-badge');

    if (isAlvaro) {
      sourceCatalog = Array.isArray(examesAlvaroCatalog) ? examesAlvaroCatalog : [];
      if (badgeEl) {
        badgeEl.innerHTML = `<span class="inline-flex items-center gap-1 px-2.5 py-0.5 bg-amber-100 text-amber-900 border border-amber-300 text-[11px] font-extrabold rounded-lg shadow-2xs">🧪 Álvaro (${sourceCatalog.length} exames)</span>`;
      }
    } else if (isPardini) {
      sourceCatalog = Array.isArray(examesPardiniCatalog) ? examesPardiniCatalog : [];
      if (badgeEl) {
        badgeEl.innerHTML = `<span class="inline-flex items-center gap-1 px-2.5 py-0.5 bg-cyan-100 text-cyan-900 border border-cyan-300 text-[11px] font-extrabold rounded-lg shadow-2xs">🧪 Pardini (${sourceCatalog.length} exames)</span>`;
      }
    } else {
      if (badgeEl) {
        const titleText = labName ? `Lab: ${labName}` : 'Geral';
        badgeEl.innerHTML = `<span class="inline-flex items-center gap-1 px-2.5 py-0.5 bg-slate-700 text-slate-100 border border-slate-600 text-[11px] font-bold rounded-lg shadow-2xs">🧪 Exames Álvaro & Pardini (${titleText})</span>`;
      }
      const alvList = Array.isArray(examesAlvaroCatalog) ? examesAlvaroCatalog : [];
      const parList = Array.isArray(examesPardiniCatalog) ? examesPardiniCatalog : [];
      sourceCatalog = [...alvList, ...parList];
    }

    sourceCatalog.forEach(e => {
      const cod = String(e.codigo || e.id || '').trim();
      let nome = String(e.descricao || e.exame || e.nome || '').trim();
      if (!nome && cod) {
        nome = cod;
      }

      let matsList = [];
      if (Array.isArray(e.possibleMaterials) && e.possibleMaterials.length > 0) {
        matsList = e.possibleMaterials.map(pm => {
          if (typeof pm === 'object' && pm !== null) {
            const c = String(pm.code || pm.codigo || '').trim();
            const d = String(pm.description || pm.descricao || '').trim();
            if (c && d && c.toLowerCase() !== d.toLowerCase()) return `${c} - ${d}`;
            return c || d;
          }
          return String(pm).trim();
        }).filter(Boolean);
      } else if (Array.isArray(e.materiais) && e.materiais.length > 0) {
        matsList = e.materiais.map(m => String(m).trim()).filter(Boolean);
      } else if (e.material) {
        matsList = String(e.material).split(/[,;]/).map(s => s.trim()).filter(Boolean);
      }

      const defaultMatCode = e.materialDefault != null ? String(e.materialDefault).trim() : null;
      const defaultMatDesc = e.materialDefaultDesc ? String(e.materialDefaultDesc).trim() : '';

      const matSummary = matsList.length > 0 ? matsList.join(', ') : 'Soro';
      const val = parseFloat(e.valor) || 0;

      const key = (cod + '___' + nome).toUpperCase();
      if ((cod || nome) && !setCodes.has(key)) {
        setCodes.add(key);
        list.push({
          codigo: cod || 'EXAM',
          exame: nome,
          material: matSummary,
          valor: val,
          materiaisList: matsList,
          materialDefault: defaultMatCode,
          materialDefaultDesc: defaultMatDesc
        });
      }
    });

    if (list.length === 0) {
      const defaultCatalog = [
        { codigo: 'TSH', exame: 'Hormônio Tireoestimulante (TSH)', material: 'Soro', valor: 28.5 },
        { codigo: 'T4L', exame: 'T4 Livre (Tetraiodotironina Livre)', material: 'Soro', valor: 32 },
        { codigo: 'HEMOG', exame: 'Hemograma Completo com Contagem de Plaquetas', material: 'Sangue Total (EDTA)', valor: 18 },
        { codigo: 'GLUC', exame: 'Glicose em Jejum', material: 'Plasma Fluorretado / Soro', valor: 12 },
        { codigo: 'LIPID', exame: 'Perfil Lipídico Completo', material: 'Soro', valor: 45 },
        { codigo: 'URINA1', exame: 'EAS - Urina Tipo 1', material: 'Urina Jato Médio', valor: 15 },
        { codigo: 'VITD', exame: '25-Hidroxi Vitamina D', material: 'Soro', valor: 65 },
        { codigo: 'BHCG', exame: 'Beta HCG Quantitativo SÉRICO', material: 'Soro', valor: 35 },
        { codigo: 'PSA', exame: 'PSA Total e Livre', material: 'Soro', valor: 58 }
      ];
      defaultCatalog.forEach(item => {
        const key = (item.codigo + '___' + item.exame).toUpperCase();
        if (!setCodes.has(key)) {
          setCodes.add(key);
          list.push({
            codigo: item.codigo,
            exame: item.exame,
            material: item.material,
            valor: item.valor,
            materiaisList: [item.material]
          });
        }
      });
    }

    catalogSupportExams = list;
  }

  function filterSupportExamsTable() {
    const input = document.getElementById('search-support-exam-input');
    const query = (input ? input.value : '').toLowerCase().trim();

    if (!query) {
      renderSupportExamsTable(catalogSupportExams);
      return;
    }

    const filtered = catalogSupportExams.filter(item => {
      const cod = (item.codigo || '').toLowerCase();
      const ex = (item.exame || '').toLowerCase();
      const mat = (item.material || '').toLowerCase();
      return cod.includes(query) || ex.includes(query) || mat.includes(query);
    });

    renderSupportExamsTable(filtered);
  }

  function renderSupportExamsTable(list) {
    const tbody = document.getElementById('searchSupportExamsTableBody');
    if (!tbody) return;
    tbody.innerHTML = '';

    if (!list || list.length === 0) {
      tbody.innerHTML = `
        <tr>
          <td colspan="5" class="p-6 text-center text-gray-400 font-sans italic text-xs">
            Nenhum exame encontrado com o filtro informado.
          </td>
        </tr>
      `;
      return;
    }

    const itemsToRender = list.slice(0, 150);

    itemsToRender.forEach((item, idx) => {
      const tr = document.createElement('tr');
      tr.className = 'hover:bg-emerald-50/60 transition-colors cursor-pointer';
      tr.onclick = function() {
        selectSupportExamItemObj(item);
      };

      const valFormatted = (item.valor || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 4 });
      const hasMultipleMats = Array.isArray(item.materiaisList) && item.materiaisList.length > 1;

      let matCellHtml = item.material;
      if (hasMultipleMats) {
        matCellHtml = `
          <div class="flex items-center gap-1.5 flex-wrap">
            <span class="font-medium text-slate-800">${item.material}</span>
            <span class="inline-flex items-center px-1.5 py-0.5 bg-amber-100 text-amber-900 border border-amber-300 text-[10px] font-extrabold rounded-md shadow-2xs" title="${item.materiaisList.length} materiais disponíveis">
              ⚡ ${item.materiaisList.length} materiais
            </span>
          </div>
        `;
      }

      tr.innerHTML = `
        <td class="p-2.5 text-center font-bold font-mono text-slate-700 bg-slate-50/50">#${item.codigo}</td>
        <td class="p-2.5 font-bold text-slate-800">${item.exame}</td>
        <td class="p-2.5 text-right font-bold font-mono text-emerald-700">R$ ${valFormatted}</td>
        <td class="p-2.5 text-slate-600 font-medium">${matCellHtml}</td>
      `;

      const tdAction = document.createElement('td');
      tdAction.className = 'p-2.5 text-center';
      tdAction.onclick = function(e) { e.stopPropagation(); };

      const btnSel = document.createElement('button');
      btnSel.type = 'button';
      btnSel.className = 'px-3 py-1 bg-emerald-600 hover:bg-emerald-700 text-white font-black text-xs rounded-lg transition-all shadow-2xs cursor-pointer uppercase tracking-wider';
      btnSel.textContent = 'Selecionar';
      btnSel.onclick = function(e) {
        e.stopPropagation();
        selectSupportExamItemObj(item);
      };
      tdAction.appendChild(btnSel);
      tr.appendChild(tdAction);

      tbody.appendChild(tr);
    });

    if (list.length > 150) {
      const trMore = document.createElement('tr');
      trMore.innerHTML = `
        <td colspan="5" class="p-3 text-center text-slate-500 font-mono text-xs bg-slate-50 font-bold border-t border-slate-200">
          Exibindo os primeiros 150 de ${list.length} exames. Digite no campo acima para filtrar por código, nome ou material.
        </td>
      `;
      tbody.appendChild(trMore);
    }
  }

  let pendingSupportExamItem = null;
  let selectedSupportMaterialChoice = '';

  function selectSupportExamItemObj(item) {
    if (!item) return;

    if (Array.isArray(item.materiaisList) && item.materiaisList.length > 1) {
      openSelectSupportMaterialModal(item);
    } else {
      const chosenMat = (Array.isArray(item.materiaisList) && item.materiaisList.length === 1)
        ? item.materiaisList[0]
        : (item.material || 'Soro');
      applySupportExamSelection(item.codigo, item.exame, chosenMat, item.valor);
    }
  }

  function selectSupportExamItem(codigo, exame, material, valor) {
    const item = (catalogSupportExams || []).find(x => x.codigo === codigo || x.exame === exame);
    if (item) {
      selectSupportExamItemObj(item);
    } else {
      applySupportExamSelection(codigo, exame, material, valor);
    }
  }

  function openSelectSupportMaterialModal(item) {
    pendingSupportExamItem = item;
    selectedSupportMaterialChoice = '';

    const infoEl = document.getElementById('modal-select-mat-exam-info');
    if (infoEl) {
      infoEl.textContent = `#${item.codigo} - ${item.exame}`;
    }

    const container = document.getElementById('support-materials-options-container');
    if (container) {
      container.innerHTML = '';

      const mats = Array.isArray(item.materiaisList) && item.materiaisList.length > 0 
        ? item.materiaisList 
        : [item.material || 'Soro'];

      const defCode = item.materialDefault ? String(item.materialDefault).trim().toLowerCase() : '';
      const defDesc = item.materialDefaultDesc ? String(item.materialDefaultDesc).trim().toLowerCase() : '';

      mats.forEach((mStr, idx) => {
        const lowerM = mStr.toLowerCase();
        const isDefault = (defCode && lowerM.includes(defCode)) || (defDesc && lowerM.includes(defDesc));

        if (idx === 0 || isDefault) {
          selectedSupportMaterialChoice = mStr;
        }
      });

      mats.forEach((mStr) => {
        const lowerM = mStr.toLowerCase();
        const isDefault = (defCode && lowerM.includes(defCode)) || (defDesc && lowerM.includes(defDesc));
        const isSelected = selectedSupportMaterialChoice === mStr;

        const optionCard = document.createElement('div');
        optionCard.className = `support-mat-card p-3.5 border-2 rounded-xl cursor-pointer transition-all flex items-center justify-between ${
          isSelected 
            ? 'border-emerald-500 bg-emerald-50/60 shadow-xs' 
            : 'border-gray-200 hover:border-amber-400 bg-white'
        }`;
        optionCard.onclick = () => {
          selectSupportMaterialCard(mStr);
        };
        optionCard.ondblclick = () => {
          selectSupportMaterialCard(mStr);
          confirmSelectedSupportMaterial();
        };

        const defBadge = isDefault 
          ? `<span class="px-2 py-0.5 bg-blue-100 text-blue-900 border border-blue-300 font-extrabold text-[10px] rounded-md shadow-2xs">PADRÃO</span>`
          : '';

        optionCard.innerHTML = `
          <div class="flex items-center gap-3">
            <input type="radio" name="supportMatRadioChoice" value="${mStr.replace(/"/g, '&quot;')}" ${
              isSelected ? 'checked' : ''
            } class="w-4 h-4 text-emerald-600 focus:ring-emerald-500 cursor-pointer">
            <div>
              <span class="font-bold text-xs text-slate-900">${mStr}</span>
            </div>
          </div>
          ${defBadge}
        `;

        container.appendChild(optionCard);
      });
    }

    document.getElementById('modalSelectSupportMaterial').classList.remove('hidden');
  }

  function selectSupportMaterialCard(mStr) {
    selectedSupportMaterialChoice = mStr;
    const cards = document.querySelectorAll('.support-mat-card');
    cards.forEach(card => {
      const radio = card.querySelector('input[type="radio"]');
      if (radio) {
        if (radio.value === mStr) {
          radio.checked = true;
          card.className = 'support-mat-card p-3.5 border-2 rounded-xl cursor-pointer transition-all flex items-center justify-between border-emerald-500 bg-emerald-50/60 shadow-xs';
        } else {
          radio.checked = false;
          card.className = 'support-mat-card p-3.5 border-2 rounded-xl cursor-pointer transition-all flex items-center justify-between border-gray-200 hover:border-amber-400 bg-white';
        }
      }
    });
  }

  function confirmSelectedSupportMaterial() {
    if (!pendingSupportExamItem) return;
    const chosenMat = selectedSupportMaterialChoice || pendingSupportExamItem.material;

    applySupportExamSelection(
      pendingSupportExamItem.codigo,
      pendingSupportExamItem.exame,
      chosenMat,
      pendingSupportExamItem.valor
    );

    closeSelectSupportMaterialModal();
  }

  function closeSelectSupportMaterialModal() {
    document.getElementById('modalSelectSupportMaterial').classList.add('hidden');
    pendingSupportExamItem = null;
    selectedSupportMaterialChoice = '';
  }

  function applySupportExamSelection(codigo, exame, material, valor) {
    const valFormatted = (parseFloat(valor) || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 4 });

    if (currentTargetRowIdx >= 0 && currentTargetRowIdx < labExternoList.length) {
      labExternoList[currentTargetRowIdx].exame = exame;
      labExternoList[currentTargetRowIdx].material = material;
      if (codigo) labExternoList[currentTargetRowIdx].codigo = codigo;
      if (valor > 0) labExternoList[currentTargetRowIdx].valor = valFormatted;
      renderLabExternoTable();
    } else {
      const inputExame = document.getElementById('ext-lab-exame');
      if (inputExame) {
        inputExame.value = exame;
      }
      const inputValor = document.getElementById('ext-lab-valor');
      if (inputValor && valor > 0) {
        inputValor.value = valFormatted;
      }
      const inputCodigoApoio = document.getElementById('ext-codigo-apoio');
      if (inputCodigoApoio) {
        inputCodigoApoio.value = codigo;
      }
      window.currentSelectedSupportMaterial = material;
    }

    closeSearchSupportExamModal();
  }

  // --- FUNÇÕES DO MODAL DE LABORATÓRIOS DE APOIO ---
  function openSupportLabsModal() {
    document.getElementById('modalSupportLabs').classList.remove('hidden');
    fetchAndUpdateSupportLabsDropdown().then(() => {
      renderModalSupportLabsTable();
      resetModalSupportLabForm();
    });
  }

  function closeSupportLabsModal() {
    document.getElementById('modalSupportLabs').classList.add('hidden');
  }

  function resetModalSupportLabForm() {
    document.getElementById('modal-lab-id').value = '';
    document.getElementById('modal-lab-descricao').value = '';
    let maxCod = 0;
    (window.globalSupportLabsList || []).forEach(l => {
      const num = parseInt(l.codigo || l.id, 10);
      if (!isNaN(num) && num > maxCod) maxCod = num;
    });
    document.getElementById('modal-lab-codigo').value = String(maxCod + 1);
  }

  function renderModalSupportLabsTable() {
    const tbody = document.getElementById('modalSupportLabsTableBody');
    if (!tbody) return;
    tbody.innerHTML = '';

    const list = window.globalSupportLabsList || [];
    if (list.length === 0) {
      tbody.innerHTML = `
        <tr>
          <td colspan="3" class="p-6 text-center text-gray-400 font-sans italic text-xs">
            Nenhum laboratório de apoio cadastrado.
          </td>
        </tr>
