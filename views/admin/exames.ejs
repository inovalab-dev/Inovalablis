<%- include('../partials/header', { page: 'admin-exames' }) %>

<!-- Biblioteca SheetJS para Leitura de Excel (.xlsx e .xls) no Cliente -->
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

<div class="p-4 sm:p-6 lg:p-8 max-w-[98vw] xl:max-w-[96vw] mx-auto w-full flex-1 space-y-6">

  <!-- Cabeçalho Principal da Tela (Padrão LIS / InovaLab) -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 text-xs text-brand-neutral/60 font-mono uppercase tracking-wider mb-1">
        <a href="/admin" class="hover:text-brand-neutralDark transition-colors">Administração</a>
        <span>•</span>
        <span>Catálogo Diagnóstico</span>
        <span>•</span>
        <span class="text-emerald-700 font-bold">Exames</span>
      </div>
      
      <div class="flex items-center gap-3">
        <!-- Ícone do Cadastro de Exames -->
        <div class="w-11 h-11 rounded-2xl bg-white border border-gray-200 shadow-sm flex items-center justify-center shrink-0 relative">
          <svg class="w-6 h-6 text-emerald-700" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m3.75 9v6m3-3H9m1.5-12H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>
          </svg>
          <div class="absolute -bottom-1 -right-1 w-5 h-5 bg-emerald-600 rounded-lg text-white font-black text-xs flex items-center justify-center border-2 border-white shadow-xs">
            +
          </div>
        </div>
        <div>
          <h1 class="text-2xl font-black text-brand-neutralDark tracking-tight">
            Cadastro e Guia de Exames
          </h1>
          <p class="text-xs text-brand-neutral/70">
            Gerencie o catálogo de exames, códigos, materiais coletados, setores e orçamentos da Inovalab
          </p>
        </div>
      </div>
    </div>

    <!-- Botões Principais de Ação -->
    <div class="flex flex-wrap items-center gap-2.5">
      <button type="button" onclick="toggleImportForm()" class="px-4 py-2.5 bg-slate-800 hover:bg-slate-900 text-white font-bold text-xs uppercase tracking-wider rounded-xl shadow-md transition-all active:scale-95 cursor-pointer flex items-center gap-2">
        <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        <span>Importar Planilha</span>
      </button>

      <button type="button" onclick="toggleImportDeparaForm()" class="px-4 py-2.5 bg-indigo-700 hover:bg-indigo-800 text-white font-bold text-xs uppercase tracking-wider rounded-xl shadow-md transition-all active:scale-95 cursor-pointer flex items-center gap-2">
        <svg class="w-4 h-4 text-indigo-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
        <span>Importar De/Para</span>
      </button>

      <button type="button" onclick="openExamModal()" class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs uppercase tracking-wider rounded-xl shadow-lg shadow-emerald-600/20 transition-all active:scale-95 cursor-pointer flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
        <span>+ Novo Exame</span>
      </button>
    </div>
  </div>

  <!-- Cards de Métricas / Resumo dos Exames -->
  <% 
    const totalExamsCount = exams.length;
    const linkedExamsCount = exams.filter(e => e.codigoAlvaro || e.codigoPardini || (e.supportLabsData && Object.keys(e.supportLabsData).length > 0)).length;
    const unlinkedExamsCount = totalExamsCount - linkedExamsCount;
    const activeExamsCount = exams.filter(e => e.ativo !== false).length;
  %>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
    <div class="bg-white p-4 rounded-2xl border border-gray-200 shadow-2xs flex items-center justify-between">
      <div>
        <p class="text-[11px] font-bold text-gray-500 uppercase font-mono tracking-wider">Total Cadastrado</p>
        <p class="text-2xl font-black text-slate-800 font-mono mt-0.5" id="hero-total-exams"><%= totalExamsCount %></p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-slate-100 flex items-center justify-center text-slate-600 text-lg">🧪</div>
    </div>

    <div class="bg-white p-4 rounded-2xl border border-gray-200 shadow-2xs flex items-center justify-between">
      <div>
        <p class="text-[11px] font-bold text-emerald-600 uppercase font-mono tracking-wider">Vinculados (Apoio)</p>
        <p class="text-2xl font-black text-emerald-700 font-mono mt-0.5"><%= linkedExamsCount %></p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-600 text-lg">🔗</div>
    </div>

    <div class="bg-white p-4 rounded-2xl border border-gray-200 shadow-2xs flex items-center justify-between">
      <div>
        <p class="text-[11px] font-bold text-indigo-600 uppercase font-mono tracking-wider">Exames Ativos</p>
        <p class="text-2xl font-black text-indigo-700 font-mono mt-0.5"><%= activeExamsCount %></p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-indigo-50 flex items-center justify-center text-indigo-600 text-lg">✅</div>
    </div>

    <div class="bg-white p-4 rounded-2xl border border-gray-200 shadow-2xs flex items-center justify-between">
      <div>
        <p class="text-[11px] font-bold text-amber-600 uppercase font-mono tracking-wider">Sem Vínculo Apoio</p>
        <p class="text-2xl font-black text-amber-700 font-mono mt-0.5"><%= unlinkedExamsCount %></p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-amber-50 flex items-center justify-center text-amber-600 text-lg">⚠️</div>
    </div>
  </div>

  <!-- Painel de Importação de Exames via Planilha (Oculto por Padrão) -->
  <div id="import-exam-panel" class="hidden bg-white p-6 rounded-2xl border-2 border-emerald-600/30 shadow-md space-y-6">
    <div class="flex justify-between items-center pb-4 border-b border-gray-200">
      <div class="space-y-1">
        <h2 class="text-lg font-extrabold text-slate-900 flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
          Importar Exames via Planilha (Excel)
        </h2>
        <p class="text-xs text-gray-500">Faça o upload de planilhas XLS, XLSX ou CSV para cadastrar ou atualizar exames de forma massiva.</p>
      </div>
      <button onclick="hideImportForm()" class="text-gray-400 hover:text-gray-600 text-sm font-bold cursor-pointer">Cancelar ✖</button>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <div class="lg:col-span-4 bg-emerald-50/60 rounded-xl border border-emerald-100 p-5 space-y-3">
        <h3 class="text-xs font-extrabold text-emerald-800 uppercase tracking-widest font-mono">Estrutura Recomendada</h3>
        <p class="text-xs text-gray-600 leading-relaxed">Sua planilha deve conter pelo menos as colunas para Código, Descrição/Nome e Valor Particular.</p>
        <ul class="space-y-1.5 text-xs text-gray-700 font-mono">
          <li class="bg-white p-2 rounded border border-emerald-100">● <strong>Código</strong> (Max 6 caracteres)</li>
          <li class="bg-white p-2 rounded border border-emerald-100">● <strong>Descrição do Exame</strong></li>
          <li class="bg-white p-2 rounded border border-emerald-100">● <strong>Valor Particular (R$)</strong></li>
          <li class="bg-white p-2 rounded border border-emerald-100">● <strong>Filtro / Categoria</strong></li>
        </ul>
      </div>

      <div class="lg:col-span-8 space-y-4">
        <div id="exam-drop-zone" class="border-2 border-dashed border-emerald-600/30 bg-emerald-50/20 hover:bg-emerald-50/40 rounded-xl p-6 text-center transition-all cursor-pointer" onclick="triggerExamFileSelect()">
          <input type="file" id="exam-file-input" class="hidden" accept=".xlsx,.xls,.csv" onchange="handleExamSpreadsheet(event)">
          <div class="flex flex-col items-center justify-center gap-2">
            <span class="text-3xl">📄</span>
            <p class="text-xs font-extrabold text-slate-800">Clique ou arraste sua planilha (.xlsx, .xls, .csv) aqui</p>
            <p class="text-[10px] text-gray-400">Leitura automatizada no navegador</p>
          </div>
        </div>

        <div id="import-preview-box" class="hidden space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="text-xs font-extrabold text-slate-800 uppercase font-mono">Pré-visualização dos Exames Encontrados</h3>
            <span id="preview-summary-badge" class="bg-emerald-100 text-emerald-800 font-extrabold font-mono text-xs px-3 py-1 rounded-full"></span>
          </div>

          <div class="bg-gray-50 border border-gray-200 rounded-xl p-3 space-y-2">
            <h4 class="text-xs font-bold text-slate-800 uppercase font-mono">Mapear Colunas da Planilha</h4>
            <div class="grid grid-cols-2 sm:grid-cols-5 gap-2 text-xs">
              <div>
                <label class="text-[10px] font-bold text-gray-500 block font-mono">Código</label>
                <select id="select-col-jalis" onchange="onMappingChanged()" class="w-full bg-white border border-gray-300 rounded px-2 py-1 text-xs"></select>
              </div>
              <div>
                <label class="text-[10px] font-bold text-gray-500 block font-mono">Nome / Descrição</label>
                <select id="select-col-name" onchange="onMappingChanged()" class="w-full bg-white border border-gray-300 rounded px-2 py-1 text-xs"></select>
              </div>
              <div>
                <label class="text-[10px] font-bold text-gray-500 block font-mono">Valor Particular</label>
                <select id="select-col-price" onchange="onMappingChanged()" class="w-full bg-white border border-gray-300 rounded px-2 py-1 text-xs"></select>
              </div>
              <div>
                <label class="text-[10px] font-bold text-gray-500 block font-mono">Categoria</label>
                <select id="select-col-cat" onchange="onMappingChanged()" class="w-full bg-white border border-gray-300 rounded px-2 py-1 text-xs"></select>
              </div>
              <div>
                <label class="text-[10px] font-bold text-gray-500 block font-mono">Cód. Gestão</label>
                <select id="select-col-code" onchange="onMappingChanged()" class="w-full bg-white border border-gray-300 rounded px-2 py-1 text-xs"></select>
              </div>
            </div>
          </div>

          <div class="border border-gray-200 rounded-xl overflow-hidden max-h-52 overflow-y-auto font-mono text-xs">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="bg-gray-100 text-[10px] font-bold uppercase text-gray-600 border-b border-gray-200">
                  <th class="p-2">Código</th>
                  <th class="p-2">Descrição</th>
                  <th class="p-2">Categoria</th>
                  <th class="p-2">Valor</th>
                </tr>
              </thead>
              <tbody id="import-preview-tbody" class="divide-y divide-gray-100 bg-white"></tbody>
            </table>
          </div>

          <div class="flex justify-end gap-3 pt-2 border-t border-gray-200">
            <button type="button" onclick="resetImportForm()" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-bold rounded-xl">Limpar</button>
            <button type="button" id="confirm-import-btn" onclick="submitImportedExams()" class="px-5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl shadow-md">Confirmar Importação</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Painel de Importação De/Para (Oculto por Padrão) -->
  <div id="import-depara-panel" class="hidden bg-white p-6 rounded-2xl border-2 border-indigo-600/30 shadow-md space-y-6">
    <div class="flex justify-between items-center pb-4 border-b border-gray-200">
      <div class="space-y-1">
        <h2 class="text-lg font-extrabold text-indigo-900 flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-indigo-500 animate-pulse"></span>
          Importar Mapeamento De/Para de Códigos
        </h2>
        <p class="text-xs text-gray-500">Vincule os códigos internos dos exames com os códigos dos laboratórios Álvaro e Pardini.</p>
      </div>
      <button onclick="hideImportDeparaForm()" class="text-gray-400 hover:text-gray-600 text-sm font-bold cursor-pointer">Cancelar ✖</button>
    </div>

    <div class="space-y-4">
      <div id="depara-drop-zone" class="border-2 border-dashed border-indigo-600/30 bg-indigo-50/20 hover:bg-indigo-50/40 rounded-xl p-6 text-center transition-all cursor-pointer" onclick="triggerDeparaFileSelect()">
        <input type="file" id="depara-file-input" class="hidden" accept=".xlsx,.xls,.csv" onchange="handleDeparaSpreadsheet(event)">
        <div class="flex flex-col items-center justify-center gap-2">
          <span class="text-3xl">🔄</span>
          <p class="text-xs font-extrabold text-slate-800">Clique ou arraste a planilha de De/Para (.xlsx, .xls, .csv)</p>
          <p class="text-[10px] text-gray-400">Vinculação direta por correspondência de código</p>
        </div>
      </div>

      <div id="depara-preview-box" class="hidden space-y-4">
        <div class="bg-gray-50 border border-gray-200 rounded-xl p-3 space-y-2">
          <h4 class="text-xs font-bold text-slate-800 uppercase font-mono">Selecione as Colunas do De/Para</h4>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 text-xs">
            <div>
              <label class="text-[10px] font-bold text-gray-500 block font-mono">Código Local</label>
              <select id="select-depara-jalis" onchange="onDeparaMappingChanged()" class="w-full bg-white border border-gray-300 rounded px-2 py-1 text-xs"></select>
            </div>
            <div>
              <label class="text-[10px] font-bold text-gray-500 block font-mono">Cód. Álvaro</label>
              <select id="select-depara-alvaro" onchange="onDeparaMappingChanged()" class="w-full bg-white border border-gray-300 rounded px-2 py-1 text-xs"></select>
            </div>
            <div>
              <label class="text-[10px] font-bold text-gray-500 block font-mono">Cód. Pardini</label>
              <select id="select-depara-pardini" onchange="onDeparaMappingChanged()" class="w-full bg-white border border-gray-300 rounded px-2 py-1 text-xs"></select>
            </div>
          </div>
        </div>

        <div class="border border-gray-200 rounded-xl overflow-hidden max-h-52 overflow-y-auto font-mono text-xs">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-gray-100 text-[10px] font-bold uppercase text-gray-600 border-b border-gray-200">
                <th class="p-2">Código Local</th>
                <th class="p-2">Cód. Álvaro</th>
                <th class="p-2">Cód. Pardini</th>
                <th class="p-2">Exame Encontrado</th>
              </tr>
            </thead>
            <tbody id="depara-preview-tbody" class="divide-y divide-gray-100 bg-white"></tbody>
          </table>
        </div>

        <div class="flex justify-end gap-3 pt-2 border-t border-gray-200">
          <button type="button" onclick="resetDeparaForm()" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-bold rounded-xl">Limpar</button>
          <button type="button" id="confirm-depara-btn" onclick="submitDeparaMappings()" class="px-5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-xl shadow-md">Confirmar De/Para</button>
        </div>
      </div>
    </div>
  </div>

  <!-- TABELA / LISTA PRINCIPAL DE EXAMES -->
  <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
    
    <!-- Barra de Filtros e Busca -->
    <div class="p-4 bg-slate-50/80 border-b border-gray-200 flex flex-col md:flex-row items-center justify-between gap-3">
      <div class="flex items-center gap-2 w-full md:w-auto">
        <span class="text-sm font-black text-slate-800 uppercase tracking-wide shrink-0">Catálogo de Exames</span>
        <span id="exam-count-badge" class="px-2.5 py-0.5 bg-emerald-100 text-emerald-800 rounded-full text-xs font-bold font-mono">
          <span id="exam-count"><%= totalExamsCount %></span> cadastrados
        </span>
      </div>

      <div class="flex flex-col sm:flex-row items-center gap-2.5 w-full md:w-auto">
        <!-- Busca de Exames -->
        <div class="relative w-full sm:w-80">
          <input type="text" id="exam-search" oninput="filterExams()" placeholder="Buscar por código, descrição ou sinonímia..." class="w-full pl-8 pr-3 py-1.5 bg-white border border-gray-300 rounded-xl text-xs outline-none focus:ring-2 focus:ring-emerald-500 shadow-2xs font-medium">
          <span class="absolute left-2.5 top-2 text-gray-400 text-xs">🔍</span>
        </div>

        <!-- Filtro Categoria -->
        <select id="exam-filter-category" onchange="filterExams()" class="w-full sm:w-40 py-1.5 px-2.5 bg-white border border-gray-300 rounded-xl text-xs font-bold text-gray-700 outline-none focus:ring-2 focus:ring-emerald-500">
          <option value="all">Todas Categorias</option>
          <% 
            const uniqueCats = [...new Set(exams.map(e => e.category).filter(Boolean))].sort();
            uniqueCats.forEach(c => { 
          %>
            <option value="<%= c.toLowerCase() %>"><%= c %></option>
          <% }) %>
        </select>

        <!-- Filtro Vínculo -->
        <select id="exam-filter-link" onchange="filterExams()" class="w-full sm:w-40 py-1.5 px-2.5 bg-white border border-gray-300 rounded-xl text-xs font-bold text-gray-700 outline-none focus:ring-2 focus:ring-emerald-500">
          <option value="all">Todos os Vínculos</option>
          <option value="linked">Apenas Vinculados</option>
          <option value="unlinked">Não Vinculados</option>
        </select>
      </div>
    </div>

    <!-- Tabela de Exames -->
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-gray-100/90 border-b border-gray-200 text-[10px] font-black text-gray-500 uppercase font-mono tracking-wider">
            <th class="p-3.5 w-28 text-center">Código</th>
            <th class="p-3.5">Nome</th>
            <th class="p-3.5 w-28 text-center">Status</th>
            <th class="p-3.5 w-28 text-center">Ações</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 text-xs font-medium text-gray-700" id="examsTableBody">
          <% exams.forEach((exam) => { %>
            <%
              const displayCode = (exam.code || exam.jalisCode || '').slice(0, 6);
              const hasLink = !!(exam.codigoAlvaro || exam.codigoPardini || (exam.supportLabsData && Object.keys(exam.supportLabsData).length > 0));
              const supportCodesList = [];
              if (exam.codigoAlvaro) supportCodesList.push(exam.codigoAlvaro.toLowerCase());
              if (exam.codigoPardini) supportCodesList.push(exam.codigoPardini.toLowerCase());
            %>
            <tr class="hover:bg-emerald-50/40 transition-colors exam-row cursor-pointer"
                data-name="<%= (exam.name || '').toLowerCase() %>"
                data-code="<%= displayCode.toLowerCase() %>"
                data-sinonimia="<%= (exam.sinonimia || '').toLowerCase() %>"
                data-category="<%= (exam.category || '').toLowerCase() %>"
                data-support-codes="<%= supportCodesList.join(',') %>"
                data-has-any-link="<%= hasLink ? 'true' : 'false' %>"
                onclick="editExamById('<%= exam.id || exam.code || exam.jalisCode %>')">
              
              <!-- Código (Max 6 Caracteres) -->
              <td class="p-3.5 text-center font-mono">
                <% if (displayCode) { %>
                  <span class="px-2 py-1 bg-slate-800 text-emerald-300 font-extrabold rounded text-[11px] font-mono tracking-wide shadow-2xs">
                    <%= displayCode %>
                  </span>
                <% } else { %>
                  <span class="text-gray-400 italic text-[11px]">—</span>
                <% } %>
              </td>

              <!-- Nome / Descrição / Sinonímia -->
              <td class="p-3.5">
                <div class="font-bold text-slate-800 text-sm"><%= exam.name %></div>
                <% if (exam.sinonimia) { %>
                  <div class="text-[11px] text-gray-500 font-normal truncate max-w-md mt-0.5">
                    <span class="font-bold text-slate-600">Sin.:</span> <%= exam.sinonimia %>
                  </div>
                <% } %>
              </td>

              <!-- Status -->
              <td class="p-3.5 text-center">
                <% if (exam.ativo === false) { %>
                  <span class="px-2.5 py-0.5 bg-gray-100 text-gray-600 font-bold text-[10px] rounded-full inline-flex items-center gap-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-gray-400"></span> Inativo
                  </span>
                <% } else { %>
                  <span class="px-2.5 py-0.5 bg-emerald-100 text-emerald-800 font-bold text-[10px] rounded-full inline-flex items-center gap-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span> Ativo
                  </span>
                <% } %>
              </td>

              <!-- Ações -->
              <td class="p-3.5 text-center" onclick="event.stopPropagation()">
                <div class="flex items-center justify-center gap-1.5">
                  <button type="button" onclick="editExamById('<%= exam.id || exam.code || exam.jalisCode %>')" class="p-1.5 bg-emerald-50 text-emerald-700 hover:bg-emerald-600 hover:text-white rounded-lg transition-colors cursor-pointer" title="Editar Ficha Completa do Exame">
                    ✏️
                  </button>
                  <button type="button" onclick="deleteExamFromRow('<%= exam.id || exam.code || exam.jalisCode %>', event)" class="p-1.5 bg-rose-50 text-rose-600 hover:bg-rose-600 hover:text-white rounded-lg transition-colors cursor-pointer" title="Remover Exame">
                    🗑️
                  </button>
                </div>
              </td>
            </tr>
          <% }) %>

          <% if (exams.length === 0) { %>
            <tr>
              <td colspan="6" class="p-12 text-center text-gray-400 font-medium">
                Nenhum exame cadastrado. Clique em "+ Novo Exame" para cadastrar o primeiro.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<!-- ========================================================= -->
<!-- MODAL DE POPUP COMPLETO - CADASTRO E EVOLUÇÃO DE EXAMES   -->
<!-- ========================================================= -->
<div id="examModal" class="fixed inset-0 z-50 bg-black/75 backdrop-blur-sm flex items-center justify-center p-2 sm:p-4 lg:p-6 hidden">
  <div class="bg-white rounded-2xl max-w-[98vw] xl:max-w-[95vw] 2xl:max-w-[90vw] w-full h-[95vh] max-h-[95vh] shadow-2xl overflow-hidden flex flex-col border border-gray-200">
    
    <!-- Cabeçalho do Modal LIS -->
    <div class="bg-gradient-to-r from-gray-50 via-gray-100 to-gray-50 px-6 py-3.5 border-b border-gray-200 flex items-center justify-between shrink-0">
      <div class="flex items-center gap-3">
        <div class="p-2 bg-emerald-600 text-white rounded-xl shadow-md">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m3.75 9v6m3-3H9m1.5-12H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>
          </svg>
        </div>
        <div>
          <h2 class="text-lg font-black text-gray-900 tracking-tight" id="modalExamTitle">Cadastro de exames</h2>
          <p class="text-xs text-gray-500 font-mono">Cadastro de exames realizados • Formulário LIS InovaLab</p>
        </div>
      </div>
      <button onclick="closeExamModal()" type="button" class="text-gray-400 hover:text-gray-700 p-2 hover:bg-gray-200 rounded-xl transition-colors cursor-pointer" title="Fechar (ESC)">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <!-- Barra de Abas Principais do Cadastro de Exames -->
    <div class="bg-gray-100/90 border-b border-gray-200 px-6 pt-2 flex items-center gap-1 text-xs font-extrabold font-mono shrink-0 overflow-x-auto">
      <button type="button" onclick="switchExamTab('dados-cadastrais')" id="exam-tab-btn-dados-cadastrais" class="exam-tab-btn px-4 py-2.5 rounded-t-xl bg-white border-t-2 border-emerald-600 text-emerald-800 shadow-2xs transition-all cursor-pointer">
        Dados cadastrais
      </button>
      <button type="button" onclick="switchExamTab('material-coletado')" id="exam-tab-btn-material-coletado" class="exam-tab-btn px-4 py-2.5 rounded-t-xl text-gray-600 hover:bg-white/60 transition-all cursor-pointer">
        Material coletado
      </button>
      <button type="button" onclick="switchExamTab('historicos')" id="exam-tab-btn-historicos" class="exam-tab-btn px-4 py-2.5 rounded-t-xl text-gray-600 hover:bg-white/60 transition-all cursor-pointer">
        Históricos
      </button>
      <button type="button" onclick="switchExamTab('web')" id="exam-tab-btn-web" class="exam-tab-btn px-4 py-2.5 rounded-t-xl text-gray-600 hover:bg-white/60 transition-all cursor-pointer">
        Web
      </button>
    </div>

    <!-- FORMULÁRIO PRINCIPAL COM CONTAINERS INTERNOS -->
    <form id="examMainForm" action="/admin/exames/add" method="POST" class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-5 text-xs">
      <input type="hidden" name="id" id="form-exam-id">
      <input type="hidden" name="code" id="form-exam-code-hidden">
      <input type="hidden" name="setores" id="form-exam-setores-json" value="[]">
      <input type="hidden" name="materiaisColetados" id="form-exam-materiais-json" value="[]">
      <input type="hidden" name="webConfig" id="form-exam-web-json" value="{}">
      <input type="hidden" name="modeloLaudo" id="form-exam-modeloLaudo" value="Padrão LIS InovaLab">
      <input type="hidden" name="formularioColeta" id="form-exam-formularioColeta" value="Ficha Padrão de Coleta">
      <input type="hidden" name="cabecalho" id="form-exam-cabecalho" value="">
      <input type="hidden" name="tituloLaudo" id="form-exam-tituloLaudo" value="">
      <input type="hidden" name="materialLaudo" id="form-exam-materialLaudo" value="">
      <input type="hidden" name="metodoLaudo" id="form-exam-metodoLaudo" value="">
      <input type="hidden" name="valorReferenciaLaudo" id="form-exam-valorReferenciaLaudo" value="">

      <!-- ========================================================================= -->
      <!-- TAB 1: DADOS CADASTRAIS                                                  -->
      <!-- ========================================================================= -->
      <div id="tab-exam-dados-cadastrais" class="exam-tab-panel space-y-4">
        
        <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-2xs space-y-4">
          <!-- Linha 1: Código, Descrição -->
          <div class="grid grid-cols-1 md:grid-cols-12 gap-3 items-center">
            <div class="md:col-span-3 lg:col-span-2">
              <label for="form-exam-jalisCode" class="block font-bold text-gray-700 uppercase font-mono mb-1">
                Código: <span class="text-rose-600">*</span> <span id="code-readonly-warning" class="text-[10px] text-amber-600 font-bold hidden">(Fixo)</span>
              </label>
              <input type="text" name="jalisCode" id="form-exam-jalisCode" required maxlength="6" placeholder="HEMOG" oninput="document.getElementById('form-exam-code-hidden').value = this.value" class="w-full px-3 py-2 bg-gray-50 border border-gray-300 rounded-lg text-xs font-black font-mono uppercase text-slate-900 focus:ring-2 focus:ring-emerald-500 focus:bg-white outline-none">
              <span class="text-[9px] text-gray-400 font-mono">Texto (Máx 6 dígitos)</span>
            </div>

            <div class="md:col-span-9 lg:col-span-10">
              <label for="form-exam-name" class="block font-bold text-gray-700 uppercase font-mono mb-1">
                Descrição: <span class="text-rose-600">*</span>
              </label>
              <input type="text" name="name" id="form-exam-name" required placeholder="Hemograma com contagem de plaquetas ou frações (eritrograma, leucograma, plaquetas)" class="w-full px-3 py-2 bg-gray-50 border border-gray-300 rounded-lg text-xs font-bold text-slate-900 focus:ring-2 focus:ring-emerald-500 focus:bg-white outline-none">
            </div>
          </div>

          <!-- Linha 2: Sinonímia -->
          <div>
            <label for="form-exam-sinonimia" class="block font-bold text-gray-700 uppercase font-mono mb-1">
              Sinonímia:
            </label>
            <input type="text" name="sinonimia" id="form-exam-sinonimia" placeholder="na com Plaquetas;Hemograma Completo;HMG;HG;Exame Hematológico;Hematológico" class="w-full px-3 py-2 bg-gray-50 border border-gray-300 rounded-lg text-xs font-medium text-slate-800 focus:ring-2 focus:ring-emerald-500 focus:bg-white outline-none">
          </div>

          <!-- Linha 3: Idade Mín, Idade Máx, Sexo -->
          <div class="grid grid-cols-1 sm:grid-cols-3 md:grid-cols-12 gap-3 items-center">
            <div class="md:col-span-4 flex items-center gap-2">
              <label class="font-bold text-gray-700 font-mono whitespace-nowrap">Idade Mín.:</label>
              <input type="number" name="idadeMin" id="form-exam-idadeMin" value="0" min="0" class="w-20 px-2 py-1.5 bg-gray-50 border border-gray-300 rounded-lg text-xs font-bold font-mono text-center">
              <select name="idadeMinUnidade" id="form-exam-idadeMinUnidade" class="px-2 py-1.5 bg-gray-50 border border-gray-300 rounded-lg text-xs font-bold">
                <option value="Anos">Anos</option>
                <option value="Meses">Meses</option>
                <option value="Dias">Dias</option>
              </select>
            </div>

            <div class="md:col-span-4 flex items-center gap-2">
              <label class="font-bold text-gray-700 font-mono whitespace-nowrap">Idade Máx.:</label>
              <input type="number" name="idadeMax" id="form-exam-idadeMax" value="0" min="0" class="w-20 px-2 py-1.5 bg-gray-50 border border-gray-300 rounded-lg text-xs font-bold font-mono text-center">
              <select name="idadeMaxUnidade" id="form-exam-idadeMaxUnidade" class="px-2 py-1.5 bg-gray-50 border border-gray-300 rounded-lg text-xs font-bold">
                <option value="Anos">Anos</option>
                <option value="Meses">Meses</option>
                <option value="Dias">Dias</option>
              </select>
            </div>

            <div class="md:col-span-4 flex items-center gap-2">
              <label class="font-bold text-gray-700 font-mono whitespace-nowrap">Sexo:</label>
              <select name="sexo" id="form-exam-sexo" class="w-full px-3 py-1.5 bg-gray-50 border border-gray-300 rounded-lg text-xs font-bold text-slate-800">
                <option value="Ambos">Ambos</option>
                <option value="Masculino">Masculino</option>
                <option value="Feminino">Feminino</option>
              </select>
            </div>
          </div>

          <!-- Linha 4: Amostras, Tags de resultado, Filtro / Categoria -->
          <div class="grid grid-cols-1 md:grid-cols-12 gap-3 items-center">
            <div class="md:col-span-3 flex items-center gap-2">
              <label class="font-bold text-gray-700 font-mono whitespace-nowrap">Amostras:</label>
              <input type="number" name="amostras" id="form-exam-amostras" value="0" min="0" class="w-full px-2.5 py-1.5 bg-gray-50 border border-gray-300 rounded-lg text-xs font-bold font-mono">
            </div>

            <div class="md:col-span-5 flex items-center gap-2">
              <label class="font-bold text-gray-700 font-mono whitespace-nowrap">Tags de resultado:</label>
              <input type="text" name="tagsResultado" id="form-exam-tagsResultado" class="w-full px-2.5 py-1.5 bg-gray-50 border border-gray-300 rounded-lg text-xs">
            </div>

            <div class="md:col-span-4 flex items-center gap-2">
              <label class="font-bold text-gray-700 font-mono whitespace-nowrap">Filtro / Categoria:</label>
              <input type="text" name="category" id="form-exam-category" placeholder="Hematologia, Sangue" class="w-full px-2.5 py-1.5 bg-gray-50 border border-gray-300 rounded-lg text-xs font-bold">
            </div>
          </div>

          <!-- Linha 5: Checkboxes e Opções de Parâmetros -->
          <div class="flex flex-wrap items-center gap-4 pt-2 border-t border-gray-100">
            <label class="flex items-center gap-2 cursor-pointer font-bold text-gray-700">
              <input type="checkbox" name="bloquearExame" id="form-exam-bloquearExame" class="w-4 h-4 text-emerald-600 rounded">
              <span>Bloquear exame</span>
            </label>

            <label class="flex items-center gap-2 cursor-pointer font-bold text-gray-700">
              <input type="checkbox" name="permitirSalvarParcialmente" id="form-exam-permitirSalvarParcialmente" class="w-4 h-4 text-emerald-600 rounded">
              <span>Permitir salvar exame parcialmente</span>
            </label>

            <label class="flex items-center gap-2 cursor-pointer font-bold text-gray-700">
              <input type="checkbox" name="servico" id="form-exam-servico" class="w-4 h-4 text-emerald-600 rounded">
              <span>Serviço</span>
            </label>

            <label class="flex items-center gap-2 cursor-pointer font-bold text-emerald-800">
              <input type="checkbox" name="importarPdf" id="form-exam-importarPdf" checked class="w-4 h-4 text-emerald-600 rounded">
              <span>Importar PDF</span>
            </label>
          </div>

          <!-- Linha 6: Tipo BPA, Vínculos Apoio -->
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 pt-2 border-t border-gray-100">
            <div>
              <label class="block font-bold text-gray-700 font-mono text-[11px] mb-1">Tipo BPA:</label>
              <select name="tipoBPA" id="form-exam-tipoBPA" class="w-full px-2.5 py-1.5 bg-gray-50 border border-gray-300 rounded-lg text-xs font-bold">
                <option value="Individualizado">Individualizado</option>
                <option value="Consolidado">Consolidado</option>
              </select>
              <input type="hidden" name="pricePrivate" id="form-exam-pricePrivate" value="0">
            </div>

            <div>
              <label class="block font-bold text-blue-800 font-mono text-[11px] mb-1">Cód. Álvaro Apoio:</label>
              <input type="text" name="codigoAlvaro" id="form-exam-codigoAlvaro" placeholder="Ex: ALV-102" class="w-full px-2.5 py-1.5 bg-blue-50/30 border border-blue-200 rounded-lg text-xs font-bold font-mono">
            </div>

            <div>
              <label class="block font-bold text-purple-800 font-mono text-[11px] mb-1">Cód. Pardini Apoio:</label>
              <input type="text" name="codigoPardini" id="form-exam-codigoPardini" placeholder="Ex: PAR-302" class="w-full px-2.5 py-1.5 bg-purple-50/30 border border-purple-200 rounded-lg text-xs font-bold font-mono">
            </div>
          </div>
        </div>

        <!-- SUB-ABAS DE DADOS CADASTRAIS (Setores | Diagnóstico | Interferência | Destino Padrão) -->
        <div class="bg-white rounded-xl border border-gray-200 shadow-2xs overflow-hidden">
          <div class="bg-gray-100 px-4 py-2 border-b border-gray-200 flex items-center gap-2 font-mono text-xs font-bold">
            <button type="button" onclick="switchSubTab('setores')" id="subtab-btn-setores" class="subtab-btn px-3 py-1.5 rounded-lg bg-white text-emerald-800 shadow-2xs">
              Setores
            </button>
            <button type="button" onclick="switchSubTab('diagnostico')" id="subtab-btn-diagnostico" class="subtab-btn px-3 py-1.5 rounded-lg text-gray-600 hover:bg-white/60">
              Diagnóstico
            </button>
            <button type="button" onclick="switchSubTab('interferencia')" id="subtab-btn-interferencia" class="subtab-btn px-3 py-1.5 rounded-lg text-gray-600 hover:bg-white/60">
              Interferência
            </button>
            <button type="button" onclick="switchSubTab('destino-padrao')" id="subtab-btn-destino-padrao" class="subtab-btn px-3 py-1.5 rounded-lg text-gray-600 hover:bg-white/60">
              Destino Padrão
            </button>
          </div>

          <div class="p-4">
            <!-- Sub-aba Setores -->
            <div id="subtab-panel-setores" class="subtab-panel space-y-3">
              <div class="flex items-center gap-2">
                <label class="font-bold text-gray-700 font-mono">Setor:</label>
                <select id="select-add-setor" class="px-3 py-1.5 bg-gray-50 border border-gray-300 rounded-lg text-xs font-bold w-64">
                  <% if (locals.setores && setores.length > 0) { %>
                    <% setores.forEach(s => { %>
                      <option value="<%= s.descricao %>" data-codigo="<%= s.codigo %>" data-sigla="<%= s.sigla || '' %>">
                        <%= s.codigo %> - <%= s.descricao %><% if (s.sigla) { %> (<%= s.sigla %>)<% } %>
                      </option>
                    <% }) %>
                  <% } else { %>
                    <option value="Hematologia">Hematologia</option>
                    <option value="Bioquímica">Bioquímica</option>
                    <option value="Imunologia">Imunologia</option>
                    <option value="Urinálise">Urinálise</option>
                    <option value="Parasitologia">Parasitologia</option>
                    <option value="Microbiologia">Microbiologia</option>
                    <option value="Citologia">Citologia</option>
                  <% } %>
                </select>
                <button type="button" onclick="addSetorToExam()" class="px-3 py-1.5 bg-emerald-600 text-white font-bold rounded-lg text-xs shadow-2xs hover:bg-emerald-700">
                  OK
                </button>
              </div>

              <!-- Tabela de Setores Mapeados -->
              <div class="border border-gray-200 rounded-xl overflow-hidden font-mono text-xs">
                <table class="w-full text-left border-collapse">
                  <thead>
                    <tr class="bg-gray-100 text-[10px] font-black text-gray-500 uppercase border-b border-gray-200">
                      <th class="p-2 w-16">Código</th>
                      <th class="p-2">Setor</th>
                      <th class="p-2 w-16 text-center">Mapa</th>
                      <th class="p-2 w-16 text-center">Etq.Col.</th>
                      <th class="p-2 w-16 text-center">Etq.Tri.</th>
                      <th class="p-2 w-20 text-center">Ações</th>
                    </tr>
                  </thead>
                  <tbody id="setoresTableBody" class="divide-y divide-gray-100">
                    <tr>
                      <td class="p-2 font-bold text-gray-600">1</td>
                      <td class="p-2 font-bold text-slate-800">Hematologia</td>
                      <td class="p-2 text-center"><input type="checkbox" checked class="w-4 h-4 text-emerald-600"></td>
                      <td class="p-2 text-center"><input type="checkbox" checked class="w-4 h-4 text-emerald-600"></td>
                      <td class="p-2 text-center"><input type="checkbox" checked class="w-4 h-4 text-emerald-600"></td>
                      <td class="p-2 text-center"><button type="button" onclick="removeSetorRow(this)" class="text-rose-600 font-bold">✖</button></td>
                    </tr>
                  </tbody>
                </table>
              </div>

              <div class="flex justify-start">
                <button type="button" class="px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold text-xs rounded-lg border border-gray-300">
                  Definir como padrão
                </button>
              </div>
            </div>

            <!-- Sub-aba Diagnostico -->
            <div id="subtab-panel-diagnostico" class="subtab-panel hidden space-y-2">
              <label class="block font-bold text-gray-700 font-mono">Orientação Diagnóstica:</label>
              <textarea name="diagnosticoNote" rows="3" placeholder="Critérios diagnósticos e orientações técnicas para o laudo..." class="w-full p-2.5 bg-gray-50 border border-gray-300 rounded-lg text-xs"></textarea>
            </div>

            <!-- Sub-aba Interferencia -->
            <div id="subtab-panel-interferencia" class="subtab-panel hidden space-y-2">
              <label class="block font-bold text-gray-700 font-mono">Interferências e Medicamentos:</label>
              <textarea name="interferenciaNote" rows="3" placeholder="Fatores de interferência (medicamentos, hemólise, lipemia)..." class="w-full p-2.5 bg-gray-50 border border-gray-300 rounded-lg text-xs"></textarea>
            </div>

            <!-- Sub-aba Destino Padrao -->
            <div id="subtab-panel-destino-padrao" class="subtab-panel hidden space-y-2">
              <label class="block font-bold text-gray-700 font-mono">Destino Padrão da Amostra:</label>
              <input type="text" name="destinoPadrao" placeholder="Laboratório Central InovaLab / Apoio" class="w-full p-2.5 bg-gray-50 border border-gray-300 rounded-lg text-xs font-bold">
            </div>
          </div>
        </div>

      </div>

      <!-- ========================================================================= -->
      <!-- TAB 2: MATERIAL COLETADO                                                 -->
      <!-- ========================================================================= -->
      <div id="tab-exam-material-coletado" class="exam-tab-panel hidden space-y-4">
        
        <!-- Tabela com Lista de Materiais Coletados Cadastrados -->
        <div class="bg-white rounded-xl border border-gray-200 shadow-2xs overflow-hidden">
          <div class="p-3 bg-gray-100/80 border-b border-gray-200 flex items-center justify-between font-mono text-xs">
            <div class="flex items-center gap-2">
              <span class="text-base">🧪</span>
              <span class="font-extrabold text-slate-800 uppercase">Materiais Coletados do Exame</span>
            </div>
            <button type="button" onclick="openMaterialSubModal(-1)" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-lg text-xs shadow-2xs flex items-center gap-1 cursor-pointer">
              <span>+ Adicionar Material</span>
            </button>
          </div>

          <div class="overflow-x-auto font-mono text-xs">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="bg-gray-50 text-[10px] font-black text-gray-500 uppercase border-b border-gray-200">
                  <th class="p-2.5 w-16">Código</th>
                  <th class="p-2.5 w-24">Abrev</th>
                  <th class="p-2.5">Material coletado</th>
                  <th class="p-2.5 w-28">Prazo</th>
                  <th class="p-2.5 w-44">Método</th>
                  <th class="p-2.5 w-24 text-center">Ações</th>
                </tr>
              </thead>
              <tbody id="materiaisColetadosTableBody" class="divide-y divide-gray-100">
                <!-- Preenchido dinamicamente por JS -->
              </tbody>
            </table>
          </div>
        </div>

      </div>

      <!-- ========================================================================= -->
      <!-- TAB 3: HISTÓRICOS                                                        -->
      <!-- ========================================================================= -->
      <div id="tab-exam-historicos" class="exam-tab-panel hidden space-y-4">
        <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-2xs space-y-3">
          <h3 class="font-extrabold text-slate-800 text-xs uppercase font-mono">Histórico Clínico e Alterações do Exame</h3>
          <p class="text-xs text-gray-500">Registre notas internas de histórico, atualizações metodológicas ou logs de alteração deste exame.</p>
          <textarea name="historico" id="form-exam-historico" rows="8" placeholder="Ex: 27/07/2026 - Atualizada sinonímia e adicionado laboratório de apoio..." class="w-full p-3 bg-gray-50 border border-gray-300 rounded-lg text-xs font-mono leading-relaxed"></textarea>
        </div>
      </div>

      <!-- ========================================================================= -->
      <!-- TAB 4: WEB                                                               -->
      <!-- ========================================================================= -->
      <div id="tab-exam-web" class="exam-tab-panel hidden space-y-4">
        <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-2xs space-y-4 text-xs">
          <h3 class="font-extrabold text-slate-800 text-xs uppercase font-mono">Publicação no Portal Web (Resultados de Exames)</h3>
          
          <div class="space-y-3">
            <label class="flex items-center gap-2 font-bold text-slate-800 cursor-pointer">
              <input type="checkbox" id="web-check-disponivel" checked class="w-4 h-4 text-emerald-600 rounded">
              <span>Exibir resultados deste exame no Portal Web dos Pacientes e Médicos</span>
            </label>

            <div>
              <label class="block font-bold text-gray-700 font-mono mb-1">Prazo Web para Liberação:</label>
              <input type="text" id="web-input-prazo" placeholder="Mesmo dia até as 18h" value="24 horas" class="w-full px-3 py-2 bg-gray-50 border border-gray-300 rounded-lg font-bold">
            </div>

            <div>
              <label class="block font-bold text-gray-700 font-mono mb-1">Orientação / Mensagem de Resultado no Portal Web:</label>
              <textarea id="web-text-mensagem" rows="3" placeholder="Laudo liberado eletronicamente e assinado digitalmente..." class="w-full p-2.5 bg-gray-50 border border-gray-300 rounded-lg"></textarea>
            </div>
          </div>
        </div>
      </div>

      <!-- Rodapé com Botões de Ação do Modal -->
      <div class="bg-gray-50 px-6 py-4 border-t border-gray-200 flex items-center justify-between shrink-0">
        <div class="flex items-center gap-2">
          <button type="button" onclick="closeExamModal()" class="px-5 py-2.5 bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold text-xs uppercase tracking-wider rounded-xl transition-all cursor-pointer">
