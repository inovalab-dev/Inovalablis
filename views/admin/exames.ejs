  function submitDeparaMappings() {
    const rows = window.rawDeparaSheetRows || [];
    if (rows.length < 2) {
      alert('Nenhuma planilha de De/Para carregada.');
      return;
    }

    const colJalis = parseInt(document.getElementById('select-depara-jalis')?.value ?? -1);
    const colAlvaro = parseInt(document.getElementById('select-depara-alvaro')?.value ?? -1);
    const colPardini = parseInt(document.getElementById('select-depara-pardini')?.value ?? -1);

    const dataRows = rows.slice(1);
    const mappings = [];

    dataRows.forEach(row => {
      const jalisCode = colJalis >= 0 ? (row[colJalis] || '').trim() : '';
      const codigoAlvaro = colAlvaro >= 0 ? (row[colAlvaro] || '').trim() : '';
      const codigoPardini = colPardini >= 0 ? (row[colPardini] || '').trim() : '';

      if (jalisCode) {
        mappings.push({ jalisCode, codigoAlvaro, codigoPardini });
      }
    });

    if (mappings.length === 0) {
      alert('Nenhum mapeamento válido foi encontrado.');
      return;
    }

    const confirmBtn = document.getElementById('confirm-depara-btn');
    if (confirmBtn) {
      confirmBtn.disabled = true;
      confirmBtn.innerHTML = 'Gravando De/Para...';
    }

    fetch('/admin/exames/import-depara', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ mappings })
    })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        alert(`✅ ${data.count} vinculações de De/Para atualizadas com sucesso!`);
        window.location.reload();
      } else {
        alert('❌ Erro ao importar De/Para: ' + (data.message || 'Erro no servidor'));
        if (confirmBtn) {
          confirmBtn.disabled = false;
          confirmBtn.innerHTML = 'Confirmar De/Para';
        }
      }
    })
    .catch(err => {
      console.error(err);
      alert('❌ Erro de conexão com o servidor.');
      if (confirmBtn) {
        confirmBtn.disabled = false;
        confirmBtn.innerHTML = 'Confirmar De/Para';
      }
    });
  }

