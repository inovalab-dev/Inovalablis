  function updateSetorFlag(idx, flag, val) {
    if (currentSetoresList && currentSetoresList[idx]) {
      currentSetoresList[idx][flag] = val;
      const setoresJsonElem = document.getElementById('form-exam-setores-json');
      if (setoresJsonElem) setoresJsonElem.value = JSON.stringify(currentSetoresList);
    }
  }

  function addSetorToExam() {
    const sel = document.getElementById('select-add-setor');
    if (!sel) return;
    const opt = sel.options[sel.selectedIndex];
    if (!opt) return;
    const val = opt.value;
    const cod = opt.getAttribute('data-codigo') || '';
    const sigla = opt.getAttribute('data-sigla') || '';

    if (!val) return;

    // Verificar se o setor já foi adicionado
    const exists = currentSetoresList.some(s => 
      (s.descricao && s.descricao.trim().toLowerCase() === val.trim().toLowerCase()) ||
      (s.codigo && cod && String(s.codigo) === String(cod))
    );

    if (exists) {
      alert('O setor "' + val + '" já foi adicionado a este exame.');
      return;
    }

    currentSetoresList.push({
      id: Date.now(),
      codigo: cod || String(currentSetoresList.length + 1),
      descricao: val,
      sigla: sigla,
      mapa: true,
      etqCol: true,
      etqTri: true
    });

    renderSetoresTable();
  }

  function removeSetorRow(idx) {
    if (typeof idx === 'number' && currentSetoresList[idx]) {
      currentSetoresList.splice(idx, 1);
    } else if (idx && idx.closest) {
      const tr = idx.closest('tr');
      if (tr && tr.parentNode) {
        const trIndex = Array.from(tr.parentNode.children).indexOf(tr);
        if (trIndex !== -1 && currentSetoresList[trIndex]) {
          currentSetoresList.splice(trIndex, 1);
        }
      }
    }
    renderSetoresTable();
  }

