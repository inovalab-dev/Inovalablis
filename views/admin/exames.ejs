      <tr class="hover:bg-slate-50"><td class="py-1 px-2 border-r border-slate-200 text-slate-600 font-bold">alinhamento</td><td class="py-1 px-2"><select onchange="updateLisCompPropExames('alinhamento', this.value)" class="w-full px-1 py-0.5 border border-slate-300 rounded text-xs font-mono"><option value="left" ${comp.alinhamento === 'left' ? 'selected' : ''}>Esquerda</option><option value="center" ${comp.alinhamento === 'center' ? 'selected' : ''}>Centro</option><option value="right" ${comp.alinhamento === 'right' ? 'selected' : ''}>Direita</option></select></td></tr>
      <tr class="hover:bg-slate-50"><td class="py-1 px-2 border-r border-slate-200 text-slate-600 font-bold">cor texto</td><td class="py-1 px-2"><input type="color" value="${comp.corFonte || '#0f172a'}" onchange="updateLisCompPropExames('corFonte', this.value)" class="w-10 h-6 border border-slate-300 rounded cursor-pointer"/></td></tr>
      <tr class="hover:bg-slate-50"><td class="py-1 px-2 border-r border-slate-200 text-slate-600 font-bold">cor fundo</td><td class="py-1 px-2"><select onchange="updateLisCompPropExames('corFundo', this.value)" class="w-full px-1 py-0.5 border border-slate-300 rounded text-xs font-mono"><option value="transparent" ${comp.corFundo === 'transparent' ? 'selected' : ''}>Transparente</option><option value="#ffffff" ${comp.corFundo === '#ffffff' ? 'selected' : ''}>Branca</option><option value="#f8fafc" ${comp.corFundo === '#f8fafc' ? 'selected' : ''}>Cinza Claro</option></select></td></tr>
    `;
  }

  function updateLisCompPropExames(prop, val) {
    if (selectedLisCompIndexExames === null || !lisComponentsExames[selectedLisCompIndexExames]) return;
    lisComponentsExames[selectedLisCompIndexExames][prop] = val;
    renderLisCanvasExames();
  }

  // DESELECIONAR AO CLICAR FORA DE QUALQUER COMPONENTE NO CANVAS (EXAMES)
  function deselectLisComponentIfPaperExames(e) {
    if (e && e.target && e.target.closest && e.target.closest('[id^="lis-element-exames-"]')) {
      return;
    }
    selectLisComponentExames(null);
  }

  function onStartDragLisCompExames(e, index) {
    if (e && e.stopPropagation) e.stopPropagation();
    selectLisComponentExames(index);
    isDraggingLisCompExames = true;

    const paper = document.getElementById('lis-canvas-paper-exames');
    if (!paper) return;

    const paperRect = paper.getBoundingClientRect();
    const comp = lisComponentsExames[index];

    dragOffsetXExames = e.clientX - (paperRect.left + comp.esquerda);
    dragOffsetYExames = e.clientY - (paperRect.top + comp.topo);

    document.addEventListener('mousemove', onMouseMoveLisDragExames);
    document.addEventListener('mouseup', onMouseUpLisDragExames);
  }

  function onMouseMoveLisDragExames(e) {
    if (!isDraggingLisCompExames || selectedLisCompIndexExames === null) return;
    const paper = document.getElementById('lis-canvas-paper-exames');
    if (!paper) return;

    const paperRect = paper.getBoundingClientRect();
    let newX = Math.round((e.clientX - paperRect.left - dragOffsetXExames) / 5) * 5;
    let newY = Math.round((e.clientY - paperRect.top - dragOffsetYExames) / 5) * 5;

    newX = Math.max(0, Math.min(newX, 680 - lisComponentsExames[selectedLisCompIndexExames].largura));
    newY = Math.max(0, Math.min(newY, 880 - lisComponentsExames[selectedLisCompIndexExames].altura));

    lisComponentsExames[selectedLisCompIndexExames].esquerda = newX;
    lisComponentsExames[selectedLisCompIndexExames].topo = newY;

    renderLisCanvasExames();
  }

  function onMouseUpLisDragExames() {
    isDraggingLisCompExames = false;
    document.removeEventListener('mousemove', onMouseMoveLisDragExames);
    document.removeEventListener('mouseup', onMouseUpLisDragExames);
  }

  // EVENTOS DE REDIMENSIONAR COMPONENTES NO CANVAS (EXAMES)
  let isResizingLisCompExames = false;
  let resizeHandleTypeExames = null;
  let resizeInitXExames = 0;
  let resizeInitYExames = 0;
  let resizeInitWExames = 0;
  let resizeInitHExames = 0;
  let resizeInitLeftExames = 0;
  let resizeInitTopExames = 0;

  function onStartResizeLisCompExames(e, index, handle) {
    e.stopPropagation();
    e.preventDefault();
    selectLisComponentExames(index);

    isResizingLisCompExames = true;
    resizeHandleTypeExames = handle;
    resizeInitXExames = e.clientX;
    resizeInitYExames = e.clientY;

    const comp = lisComponentsExames[index];
    resizeInitWExames = comp.largura;
    resizeInitHExames = comp.altura;
    resizeInitLeftExames = comp.esquerda;
    resizeInitTopExames = comp.topo;

    document.addEventListener('mousemove', onMouseMoveLisResizeExames);
    document.addEventListener('mouseup', onMouseUpLisResizeExames);
  }

  function onMouseMoveLisResizeExames(e) {
    if (!isResizingLisCompExames || selectedLisCompIndexExames === null) return;
    const comp = lisComponentsExames[selectedLisCompIndexExames];
    if (!comp) return;

    const dx = e.clientX - resizeInitXExames;
    const dy = e.clientY - resizeInitYExames;

    let newW = resizeInitWExames;
    let newH = resizeInitHExames;
    let newX = resizeInitLeftExames;
    let newY = resizeInitTopExames;

    if (resizeHandleTypeExames.includes('right')) {
      newW = Math.max(20, Math.round((resizeInitWExames + dx) / 5) * 5);
    }
    if (resizeHandleTypeExames.includes('left')) {
      const wRaw = resizeInitWExames - dx;
      newW = Math.max(20, Math.round(wRaw / 5) * 5);
      newX = resizeInitLeftExames + (resizeInitWExames - newW);
    }
    if (resizeHandleTypeExames.includes('bottom') || resizeHandleTypeExames === 'se' || resizeHandleTypeExames === 'sw') {
      newH = Math.max(15, Math.round((resizeInitHExames + dy) / 5) * 5);
    }
    if (resizeHandleTypeExames.includes('top') || resizeHandleTypeExames === 'ne' || resizeHandleTypeExames === 'nw') {
      const hRaw = resizeInitHExames - dy;
      newH = Math.max(15, Math.round(hRaw / 5) * 5);
      newY = resizeInitTopExames + (resizeInitHExames - newH);
    }

    comp.largura = newW;
    comp.altura = newH;
    comp.esquerda = newX;
    comp.topo = newY;

    renderLisCanvasExames();
  }

  function onMouseUpLisResizeExames() {
    isResizingLisCompExames = false;
    resizeHandleTypeExames = null;
    document.removeEventListener('mousemove', onMouseMoveLisResizeExames);
    document.removeEventListener('mouseup', onMouseUpLisResizeExames);
  }

  function addLisComponentExames(type) {
    const id = 'comp_' + Date.now();
    const count = lisComponentsExames.length + 1;
    let label = 'NovoTexto' + count;
    let defaultText = 'Novo Campo';
    let compType = 'Texto';

    if (type === 'variavel') {
      label = 'CampoVariavel' + count;
      defaultText = '{{resultado}}';
      compType = 'Campo Variável';
    } else if (type === 'resultado_simples') {
      label = 'ResultadoSimples' + count;
      defaultText = '{{resultado}}';
      compType = 'Resultado Simples';
    } else if (type === 'dinamico') {
      label = 'Expressao' + count;
      defaultText = 'Expressão: [Normal]';
      compType = 'Expressão';
    } else if (type === 'linha') {
      label = 'LinhaDivisoria' + count;
      defaultText = '------------------------------------------------------------';
      compType = 'Linha';
    } else if (type === 'caixa') {
      label = 'Retangulo' + count;
      defaultText = 'CAIXA / DESTRIÇÃO';
      compType = 'Caixa';
    } else if (type === 'referencia') {
      label = 'ValorReferencia' + count;
      defaultText = 'VALORES DE REFERÊNCIA:\nNormal: < 99 mg/dL';
      compType = 'Val. Referência';
    } else if (type === 'grafico') {
      label = 'GraficoHistorico' + count;
      defaultText = '[Gráfico de Histórico de Resultados]';
      compType = 'Gráfico';
    }

    const newComp = {
      id: id,
      nome: label,
      componente: compType,
      texto: defaultText,
      esquerda: 50,
      topo: 50 + (count * 20),
      largura: type === 'referencia' ? 500 : type === 'grafico' ? 320 : 250,
      altura: type === 'referencia' ? 60 : type === 'grafico' ? 120 : 30,
      fonte: 'Courier New',
      tamanho: '11px',
      negrito: false,
      maiusculas: false,
      alinhamento: 'left',
      corFonte: '#0f172a',
      corFundo: (type === 'caixa' || type === 'grafico') ? '#f8fafc' : 'transparent',
      unidade: type === 'resultado_simples' ? 'mg/dL' : '',
      imprimir: true,
      opaco: type === 'caixa' || type === 'grafico'
    };
    lisComponentsExames.push(newComp);
    selectLisComponentExames(lisComponentsExames.length - 1);
  }

  function deleteSelectedLisComponentExames() {
    if (selectedLisCompIndexExames === null) return;
    lisComponentsExames.splice(selectedLisCompIndexExames, 1);
    selectedLisCompIndexExames = null;
    renderLisCanvasExames();
  }

  function centerSelectedLisComponentExames() {
    if (selectedLisCompIndexExames === null || !lisComponentsExames[selectedLisCompIndexExames]) return;
    lisComponentsExames[selectedLisCompIndexExames].esquerda = Math.round((680 - lisComponentsExames[selectedLisCompIndexExames].largura) / 2);
    renderLisCanvasExames();
  }

  // ATALHO DE TECLADO: EXCLUIR ELEMENTO COM TECLA DEL OU BACKSPACE QUANDO SELECIONADO (EXAMES)
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Delete' || e.key === 'Del' || (e.key === 'Backspace' && !['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement?.tagName) && !document.activeElement?.isContentEditable)) {
      const modal = document.getElementById('modal-lis-layout-editor-exames');
      if (!modal || modal.classList.contains('hidden')) return;

      const active = document.activeElement;
      if (active && (active.tagName === 'INPUT' || active.tagName === 'TEXTAREA' || active.tagName === 'SELECT' || active.isContentEditable)) {
        return;
      }

      if (selectedLisCompIndexExames !== null && typeof lisComponentsExames[selectedLisCompIndexExames] !== 'undefined') {
        e.preventDefault();
        deleteSelectedLisComponentExames();
      }
    }
  });
</script>

