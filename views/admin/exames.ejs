  async function initMaterialPriceTables(idx) {
    try {
      const res = await fetch('/api/tabela-precos');
      if (res.ok) {
        const freshTables = await res.json();
        if (Array.isArray(freshTables) && freshTables.length > 0) {
          rawPriceTables = freshTables;
        }
      }
    } catch (e) {
      console.warn('Usando rawPriceTables locais:', e);
    }

    const examCodeInput = document.getElementById('form-exam-jalisCode')?.value || document.getElementById('form-exam-code-hidden')?.value || '';
    const examNameInput = document.getElementById('form-exam-name')?.value || '';
    const examIdInput = document.getElementById('form-exam-id')?.value || '';

    const examCode = examCodeInput.trim().toUpperCase();
    const examName = examNameInput.trim().toUpperCase();
    const examId = examIdInput.trim().toUpperCase();

    let currentMat = (idx >= 0 && currentMateriaisList[idx]) ? currentMateriaisList[idx] : null;

    const matName = (currentMat ? (currentMat.nome || currentMat.material || '') : '').trim().toUpperCase();
    const matMnemo = (currentMat ? (currentMat.mnemotecnico || currentMat.codigo || '') : '').trim().toUpperCase();
    const matAbrev = (currentMat ? (currentMat.abrev || '') : '').trim().toUpperCase();

    materialPriceTableValues = [];
    if (Array.isArray(rawPriceTables) && rawPriceTables.length > 0) {
      rawPriceTables.forEach(pt => {
        let ambVal = currentMat ? (currentMat.amb || '') : '';
        let valorVal = 0.00;
        let proibirVal = false;

        // 1. Tentar obter valor salvo previamente no próprio material
        if (currentMat && Array.isArray(currentMat.priceTableValues)) {
          const savedPv = currentMat.priceTableValues.find(pv => String(pv.tableId) === String(pt.id));
          if (savedPv) {
            ambVal = savedPv.amb || ambVal;
            valorVal = parseFloat(savedPv.valor || 0);
            proibirVal = !!savedPv.proibir;
          }
        }

        // 2. Buscar na tabela de preço global (pt.precios) filtrando estritamente pelo exame + material
        if (Array.isArray(pt.precios)) {
          // Busca Nível 1: Nome exato do material ("Sangue" === "Sangue", "Sangue Total" === "Sangue Total")
          let pFound = pt.precios.find(p => {
            const pExamCode = String(p.examCode || '').trim().toUpperCase();
            const pExamName = String(p.examName || '').trim().toUpperCase();
            const pMat = String(p.material || '').trim().toUpperCase();

            const examMatches = (examCode && pExamCode === examCode) ||
                                (examId && pExamCode === examId) ||
                                (examName && pExamName === examName) ||
                                (examName && (pExamName.includes(examName) || examName.includes(pExamName)));

            if (!examMatches) return false;
            return matName && pMat === matName;
          });

          // Busca Nível 2: Mnemotécnico ou Código exato
          if (!pFound && matMnemo) {
            pFound = pt.precios.find(p => {
              const pExamCode = String(p.examCode || '').trim().toUpperCase();
              const pExamName = String(p.examName || '').trim().toUpperCase();
              const pMat = String(p.material || '').trim().toUpperCase();

              const examMatches = (examCode && pExamCode === examCode) ||
                                  (examId && pExamCode === examId) ||
                                  (examName && pExamName === examName);

              return examMatches && pMat === matMnemo;
            });
          }

          // Busca Nível 3: Abreviação exata ("SAN" === "SAN")
          if (!pFound && matAbrev) {
            pFound = pt.precios.find(p => {
              const pExamCode = String(p.examCode || '').trim().toUpperCase();
              const pExamName = String(p.examName || '').trim().toUpperCase();
              const pMat = String(p.material || '').trim().toUpperCase();

              const examMatches = (examCode && pExamCode === examCode) ||
                                  (examId && pExamCode === examId) ||
                                  (examName && pExamName === examName);

              return examMatches && pMat === matAbrev;
            });
          }

          if (pFound) {
            ambVal = pFound.amb || ambVal;
            valorVal = parseFloat(pFound.valor || 0);
            proibirVal = pFound.proibir === true || pFound.proibir === 'true';
          }
        }

        materialPriceTableValues.push({
          tableId: pt.id,
          tableCode: pt.codigo || pt.id,
          tableName: pt.descricao || 'Tabela de Preço',
          convenioNome: pt.convenioNome || 'Sem Convênio',
          amb: ambVal,
          valor: valorVal,
          proibir: proibirVal
        });
      });
    }

    renderMaterialPriceTablesList();
  }

  function renderMaterialPriceTablesList() {
    const tbody = document.getElementById('matPriceTablesBody');
    if (!tbody) return;
    tbody.innerHTML = '';

    if (!materialPriceTableValues || materialPriceTableValues.length === 0) {
      tbody.innerHTML = `<tr><td colspan="6" class="p-4 text-center text-gray-500 font-medium">Nenhuma tabela de preço cadastrada no sistema.</td></tr>`;
      return;
    }

    materialPriceTableValues.forEach((item, idx) => {
      const tr = document.createElement('tr');
      tr.className = item.proibir ? 'bg-rose-50/60 hover:bg-rose-100/60 transition-colors' : 'hover:bg-emerald-50/40 transition-colors';
      tr.innerHTML = `
        <td class="p-2 font-mono font-bold text-gray-700">${item.tableCode}</td>
        <td class="p-2 font-bold text-slate-800">
          ${item.tableName}
          ${item.convenioNome && item.convenioNome !== 'Sem Convênio' ? `<span class="text-[10px] bg-blue-50 text-blue-700 border border-blue-200 px-1.5 py-0.5 rounded font-medium ml-1">🏥 ${item.convenioNome}</span>` : ''}
        </td>
        <td class="p-2 font-mono font-bold text-emerald-700 text-center">R$</td>
        <td class="p-2">
          <input type="text" value="${item.amb || ''}" onchange="updateMatPriceAmb(${idx}, this.value)" placeholder="Código AMB/TUSS" class="w-full px-2 py-1 text-xs font-mono border border-gray-300 rounded focus:border-emerald-500 bg-white">
        </td>
        <td class="p-2">
          <input type="number" step="0.01" min="0" value="${parseFloat(item.valor || 0).toFixed(2)}" onchange="updateMatPriceValor(${idx}, this.value)" class="w-full px-2 py-1 text-xs text-right font-mono font-bold border border-gray-300 rounded focus:ring-2 focus:ring-emerald-500 bg-white">
        </td>
        <td class="p-2 text-center">
          <input type="checkbox" ${item.proibir ? 'checked' : ''} onchange="updateMatPriceProibir(${idx}, this.checked)" class="w-4 h-4 text-rose-600 rounded cursor-pointer border-gray-300">
        </td>
      `;
      tbody.appendChild(tr);
    });
  }

