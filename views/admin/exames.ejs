        if (matElem) matElem.value = JSON.stringify(currentMateriaisList);

        const modModelo = document.getElementById('mod-modelo-laudo')?.value || 'Padrão LIS InovaLab';
        const modForm = document.getElementById('mod-formulario-coleta')?.value || 'Ficha Padrão de Coleta';
        const modCab = document.getElementById('mod-cabecalho')?.value || '';
        const modTit = document.getElementById('mod-titulo-laudo')?.value || '';
        const modMat = document.getElementById('mod-material-laudo')?.value || '';
        const modMet = document.getElementById('mod-metodo-laudo')?.value || '';
        const modValRef = document.getElementById('mod-valor-referencia-laudo')?.value || '';

        if (document.getElementById('form-exam-modeloLaudo')) document.getElementById('form-exam-modeloLaudo').value = modModelo;
        if (document.getElementById('form-exam-formularioColeta')) document.getElementById('form-exam-formularioColeta').value = modForm;
        if (document.getElementById('form-exam-cabecalho')) document.getElementById('form-exam-cabecalho').value = modCab;
        if (document.getElementById('form-exam-tituloLaudo')) document.getElementById('form-exam-tituloLaudo').value = modTit;
        if (document.getElementById('form-exam-materialLaudo')) document.getElementById('form-exam-materialLaudo').value = modMat;
        if (document.getElementById('form-exam-metodoLaudo')) document.getElementById('form-exam-metodoLaudo').value = modMet;
        if (document.getElementById('form-exam-valorReferenciaLaudo')) document.getElementById('form-exam-valorReferenciaLaudo').value = modValRef;
