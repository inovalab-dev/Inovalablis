    const nome = sel.value;
    const selectedOpt = sel.options[sel.selectedIndex];
    const codigo = selectedOpt ? selectedOpt.getAttribute('data-codigo') || '' : '';
    const qtde = document.getElementById('rec-coleta-qtde').value;
    const volume = document.getElementById('rec-coleta-volume').value;
    const uni = document.getElementById('rec-coleta-uni').value;
    recipientesColetaList.push({ nome, codigo, qtde, volume, uni });
