      const tr = document.createElement('tr');
      tr.className = 'hover:bg-emerald-50/50 transition-colors';

      const tdCod = document.createElement('td');
      tdCod.className = 'p-2.5 text-center font-bold text-slate-700 bg-slate-50/50';
      tdCod.textContent = '#' + cod;

      const tdDesc = document.createElement('td');
      tdDesc.className = 'p-2.5 font-bold text-slate-800';
      tdDesc.textContent = desc;

      const tdActions = document.createElement('td');
      tdActions.className = 'p-2.5 text-center';

      const divBtn = document.createElement('div');
      divBtn.className = 'flex items-center justify-center gap-1';

      const btnEdit = document.createElement('button');
      btnEdit.type = 'button';
      btnEdit.className = 'px-2 py-1 bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-200 rounded-lg font-bold text-[11px] transition-all cursor-pointer';
      btnEdit.title = 'Editar';
      btnEdit.innerHTML = '✏️';
      btnEdit.onclick = function() { editModalSupportLab(lab.id, cod, desc); };

      const btnDel = document.createElement('button');
      btnDel.type = 'button';
      btnDel.className = 'px-2 py-1 bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 rounded-lg font-bold text-[11px] transition-all cursor-pointer';
      btnDel.title = 'Excluir';
      btnDel.innerHTML = '🗑️';
      btnDel.onclick = function() { deleteModalSupportLab(lab.id, desc); };

      divBtn.appendChild(btnEdit);
      divBtn.appendChild(btnDel);
      tdActions.appendChild(divBtn);

      tr.appendChild(tdCod);
      tr.appendChild(tdDesc);
      tr.appendChild(tdActions);
      tbody.appendChild(tr);
    });
