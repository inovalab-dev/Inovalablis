            <button type="button" onclick="switchMaterialTab('coleta')" id="mat-tab-btn-coleta" class="mat-tab-btn px-3 py-1.5 rounded-lg bg-emerald-100 text-emerald-800 cursor-pointer whitespace-nowrap">
