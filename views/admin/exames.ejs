<!-- MODAL ESTILO LIS: CONFIGURAÇÃO DE LAYOUT DO MODELO NO CADASTRO DE EXAMES -->
<!-- ========================================================= -->
<div id="modal-lis-layout-editor-exames" class="fixed inset-0 bg-slate-950/80 backdrop-blur-xs flex items-center justify-center p-2 sm:p-4 z-[100] hidden no-print select-none">
  <div class="bg-slate-100 rounded-xl border border-slate-300 shadow-2xl w-full max-w-7xl h-[94vh] flex flex-col overflow-hidden text-slate-800 font-sans">
    
    <!-- JANELA DE TÍTULO ESTILO LIS -->
    <div class="bg-slate-200 border-b border-slate-300 px-3 py-2 flex items-center justify-between shrink-0">
      <div class="flex items-center gap-2">
        <span class="text-base">⚙️</span>
        <h3 class="font-bold text-xs sm:text-sm text-slate-800 font-mono tracking-tight flex items-center gap-1.5 flex-wrap">
          <span>Configuração de layout do laudo</span>
          <span class="text-slate-400 font-normal">|</span>
          <span id="lis-modal-exam-title-exames" class="text-indigo-900 font-black">EXAME</span>
          
          <!-- SELETOR DE MODELO POR ORIGEM -->
          <span class="text-slate-400 font-normal">|</span>
          <label class="text-[11px] font-bold text-slate-600 font-mono flex items-center gap-1">
            <span>Modelo:</span>
            <select
              id="lis-provider-select-exames"
              onchange="switchLisProviderModelExames(this.value)"
              class="bg-white border border-slate-300 text-slate-900 font-bold font-mono text-xs px-2 py-0.5 rounded shadow-2xs focus:ring-2 focus:ring-indigo-500 outline-none cursor-pointer"
            >
              <option value="interno">🏠 Interno (Bancada Local)</option>
              <option value="alvaro">🔵 Álvaro (Apoio)</option>
              <option value="pardini">🟣 Pardini (Apoio)</option>
            </select>
          </label>
        </h3>
      </div>
      <div class="flex items-center gap-2">
        <button
          type="button"
          onclick="saveLisLayoutModelExames()"
          class="px-3 py-1 bg-emerald-700 hover:bg-emerald-600 text-white font-bold text-xs rounded transition-all shadow-xs flex items-center gap-1 font-mono cursor-pointer"
        >
          <span>💾</span> Salvar Layout
        </button>
        <button
          type="button"
          onclick="closeLisLayoutModalExames()"
          class="px-2.5 py-1 bg-slate-800 hover:bg-red-700 text-white font-bold text-xs rounded transition-all font-mono cursor-pointer"
        >
          ✕ Fechar
        </button>
      </div>
    </div>

    <!-- BANNER DE ORIENTAÇÃO -->
    <div class="bg-amber-50 border-b border-amber-200 px-3 py-1.5 flex items-center gap-2 text-amber-900 text-xs shrink-0 font-mono">
      <span class="px-1.5 py-0.5 bg-amber-500 text-white rounded font-black text-[10px]">i</span>
      <span class="font-medium text-[11px]">
        Modelo de laudo específico deste exame. Arraste os componentes ou <strong>puxe pelas alças nos cantos/laterais para redimensionar</strong> a largura e altura na folha.
      </span>
    </div>

    <!-- TOOLBAR -->
    <div class="bg-white border-b border-slate-300 p-1.5 flex items-center gap-1 overflow-x-auto shrink-0 text-xs font-mono shadow-2xs">
      <button type="button" onclick="addLisComponentExames('texto')" class="px-2 py-1 bg-slate-100 hover:bg-slate-200 text-slate-800 border border-slate-300 rounded flex items-center gap-1 font-bold shrink-0 cursor-pointer" title="Adicionar Texto Estático"><span class="font-black text-indigo-700">[abc]</span> Texto</button>
      <button type="button" onclick="addLisComponentExames('variavel')" class="px-2 py-1 bg-slate-100 hover:bg-slate-200 text-slate-800 border border-slate-300 rounded flex items-center gap-1 font-bold shrink-0 cursor-pointer" title="Adicionar Campo Variável"><span class="font-black text-amber-600">&gt;_</span> Campo</button>
      <button type="button" onclick="addLisComponentExames('resultado_simples')" class="px-2 py-1 bg-emerald-50 hover:bg-emerald-100 text-emerald-900 border border-emerald-300 rounded flex items-center gap-1 font-bold shrink-0 cursor-pointer shadow-2xs" title="Adicionar Resultado Simples (Valor + Unidade Fixa concatenados)"><span class="font-black text-emerald-600">🧪</span> Resultado Simples</button>
      <button type="button" onclick="addLisComponentExames('dinamico')" class="px-2 py-1 bg-slate-100 hover:bg-slate-200 text-slate-800 border border-slate-300 rounded flex items-center gap-1 font-bold shrink-0 cursor-pointer" title="Adicionar Expressão Dinâmica"><span class="font-black text-emerald-700">&gt;ab_</span> Expressão</button>
      <button type="button" onclick="addLisComponentExames('linha')" class="px-2 py-1 bg-slate-100 hover:bg-slate-200 text-slate-800 border border-slate-300 rounded flex items-center gap-1 font-bold shrink-0 cursor-pointer" title="Adicionar Linha Divisória"><span class="font-black text-slate-600">---</span> Linha</button>
      <button type="button" onclick="addLisComponentExames('caixa')" class="px-2 py-1 bg-slate-100 hover:bg-slate-200 text-slate-800 border border-slate-300 rounded flex items-center gap-1 font-bold shrink-0 cursor-pointer" title="Adicionar Retângulo"><span class="font-black text-blue-600">[ &nbsp; ]</span> Retângulo</button>
      <button type="button" onclick="addLisComponentExames('referencia')" class="px-2 py-1 bg-slate-100 hover:bg-slate-200 text-slate-800 border border-slate-300 rounded flex items-center gap-1 font-bold shrink-0 cursor-pointer" title="Adicionar Valores de Referência"><span class="font-black text-purple-700">[fx]</span> Val. Referência</button>
      <button type="button" onclick="addLisComponentExames('grafico')" class="px-2 py-1 bg-slate-100 hover:bg-slate-200 text-slate-800 border border-slate-300 rounded flex items-center gap-1 font-bold shrink-0 cursor-pointer" title="Adicionar Gráfico de Histórico"><span class="font-black text-rose-600">📊</span> Gráfico</button>
      <span class="text-slate-300 font-normal">|</span>
      <button type="button" onclick="centerSelectedLisComponentExames()" class="px-2 py-1 bg-slate-100 hover:bg-slate-200 border border-slate-300 rounded font-bold cursor-pointer">Centralizar</button>
      <button type="button" onclick="deleteSelectedLisComponentExames()" class="px-2 py-1 bg-red-100 text-red-700 border border-red-200 rounded font-bold cursor-pointer">Excluir</button>
    </div>

    <!-- ÁREA DE EDICAO (CANVAS + PROPRIEDADES) -->
    <div class="flex-1 flex overflow-hidden">
      <!-- CANVAS -->
      <div class="flex-1 bg-slate-300/80 overflow-auto p-4 flex justify-center items-start relative" onclick="deselectLisComponentIfPaperExames(event)">
        <div id="lis-canvas-paper-exames" onclick="deselectLisComponentIfPaperExames(event)" class="w-[680px] min-h-[880px] bg-white shadow-2xl border border-slate-300 relative overflow-hidden font-mono">
          <div id="lis-canvas-elements-container-exames" class="absolute inset-0"></div>
        </div>
      </div>

      <!-- PAINEL PROPRIEDADES -->
      <div class="w-80 bg-white border-l border-slate-300 flex flex-col overflow-hidden text-xs font-mono">
        <div class="p-2 bg-slate-100 border-b border-slate-300 font-bold text-slate-700 flex justify-between">
          <span>Propriedades do Elemento</span>
          <span id="lis-selected-comp-badge-exames" class="text-indigo-700 font-black">Nenhum</span>
        </div>
        <div class="flex-1 overflow-y-auto p-2">
          <table class="w-full text-left border-collapse border border-slate-200 text-[11px]">
            <tbody id="lis-properties-grid-body-exames"></tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="bg-slate-200 border-t border-slate-300 px-3 py-1.5 text-[11px] font-mono flex justify-between items-center shrink-0">
      <span>Exame: <strong id="lis-footer-exam-code-exames">EXAME</strong></span>
      <span>Largura Padrão: 680px (Folha A4 LIS)</span>
    </div>
  </div>
</div>

