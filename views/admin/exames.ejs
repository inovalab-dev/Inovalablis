  function deleteCurrentModalExam() {
    const deleteBtn = document.getElementById('deleteExamModalBtn');
    const examId = deleteBtn ? deleteBtn.getAttribute('data-exam-id') : '';
    const examName = deleteBtn ? deleteBtn.getAttribute('data-exam-name') : '';
    
    const targetId = examId || document.getElementById('form-exam-id').value || document.getElementById('form-exam-jalisCode').value;
    const targetName = examName || document.getElementById('form-exam-name').value || 'este exame';

    deleteExamFromRow(targetId, targetName);
  }

  async function deleteExamFromRow(id, name, ev) {
    if (typeof name === 'object' && !ev) {
      ev = name;
      name = undefined;
    }
    if (ev) {
      if (ev.stopPropagation) ev.stopPropagation();
      if (ev.preventDefault) ev.preventDefault();
    }
    if (!id) {
      alert('Não foi possível identificar o exame para exclusão.');
      return;
    }

    let targetName = name;
    if (!targetName && typeof existingExams !== 'undefined') {
      const found = existingExams.find(e => 
        String(e.id) === String(id) || 
        String(e.code) === String(id) || 
        String(e.jalisCode) === String(id)
      );
      if (found) targetName = found.name;
    }

    if (!confirm('Deseja realmente excluir o exame: ' + (targetName || 'este exame') + '?')) {
      return;
    }

    try {
      const res = await fetch('/admin/exames/delete/' + encodeURIComponent(id), {
        method: 'POST',
        headers: {
          'Accept': 'application/json',
          'X-Requested-With': 'XMLHttpRequest'
        }
      });
      const data = await res.json();
      if (data && data.success) {
        window.location.reload();
      } else {
        window.location.href = '/admin/exames/delete/' + encodeURIComponent(id);
      }
    } catch (err) {
      console.error('Erro ao excluir exame:', err);
      window.location.href = '/admin/exames/delete/' + encodeURIComponent(id);
    }
  }

  function editExamById(examId) {
    if (!examId) return;
    let exam = typeof examId === 'object' ? examId : null;
    if (!exam && typeof existingExams !== 'undefined') {
      exam = existingExams.find(e => 
        String(e.id) === String(examId) || 
        String(e.code) === String(examId) || 
        String(e.jalisCode) === String(examId)
      );
    }
    if (exam) {
      editExam(exam);
    }
  }

  // --- EDITAR EXAME EXISTENTE ---
  function editExam(examStr) {
    let exam = null;
    if (typeof examStr === 'object' && examStr !== null) {
      exam = examStr;
    } else if (typeof examStr === 'string') {
      if (typeof existingExams !== 'undefined') {
        exam = existingExams.find(e => 
          String(e.id) === String(examStr) || 
          String(e.code) === String(examStr) || 
          String(e.jalisCode) === String(examStr)
        );
      }
      if (!exam && (examStr.startsWith('{') || examStr.startsWith('['))) {
        try {
          exam = JSON.parse(examStr);
        } catch (err) {}
      }
    }

    if (!exam) return;
    
    document.getElementById('examMainForm').action = '/admin/exames/edit';
    document.getElementById('modalExamTitle').innerText = 'Editar Exame: ' + (exam.name || '');
    document.getElementById('submitExamFormBtn').innerText = '💾 Salvar Alterações';

    const deleteBtn = document.getElementById('deleteExamModalBtn');
    if (deleteBtn) {
      deleteBtn.classList.remove('hidden');
      deleteBtn.setAttribute('data-exam-id', exam.id || exam.code || exam.jalisCode || '');
      deleteBtn.setAttribute('data-exam-name', exam.name || '');
    }

    document.getElementById('form-exam-id').value = exam.id || '';
    
    // Campo Código (Max 6 Digitos e Fixo/Readonly ao editar)
    const codeVal = (exam.code || exam.jalisCode || '').slice(0, 6);
    const jalisInput = document.getElementById('form-exam-jalisCode');
    if (jalisInput) {
      jalisInput.value = codeVal;
      jalisInput.readOnly = true;
      jalisInput.classList.add('bg-gray-100', 'cursor-not-allowed');
      jalisInput.classList.remove('bg-gray-50');
    }
    document.getElementById('form-exam-code-hidden').value = codeVal;

    document.getElementById('form-exam-name').value = exam.name || '';
    document.getElementById('form-exam-sinonimia').value = exam.sinonimia || '';
    document.getElementById('form-exam-idadeMin').value = exam.idadeMin || '0';
    document.getElementById('form-exam-idadeMinUnidade').value = exam.idadeMinUnidade || 'Anos';
    document.getElementById('form-exam-idadeMax').value = exam.idadeMax || '0';
