      <tr class="hover:bg-slate-50 bg-emerald-50/50"><td class="py-1 px-2 border-r border-slate-200 text-emerald-900 font-bold">unidade de medida</td><td class="py-1 px-2"><input type="text" value="${comp.unidade || ''}" placeholder="Ex: mg/dL, g/dL, %" onchange="updateLisCompPropExames('unidade', this.value)" class="w-full px-1 py-0.5 border border-emerald-300 rounded font-mono text-xs"/></td></tr>
      <tr class="hover:bg-slate-50"><td class="py-1 px-2 border-r border-slate-200 text-slate-600 font-bold">esquerda (X)</td><td class="py-1 px-2"><input type="number" value="${comp.esquerda}" onchange="updateLisCompPropExames('esquerda', parseInt(this.value)||0)" class="w-20 px-1 py-0.5 border border-slate-300 rounded font-mono text-xs"/></td></tr>
