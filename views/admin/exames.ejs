      const modalSelectMat = document.getElementById('modalSelectSupportMaterial');
      if (modalSelectMat && !modalSelectMat.classList.contains('hidden')) {
        closeSelectSupportMaterialModal();
        return;
      }
      const modalSearch = document.getElementById('modalSearchSupportExam');
      if (modalSearch && !modalSearch.classList.contains('hidden')) {
        closeSearchSupportExamModal();
        return;
      }
      const modalSupport = document.getElementById('modalSupportLabs');
      if (modalSupport && !modalSupport.classList.contains('hidden')) {
        closeSupportLabsModal();
        return;
      }
      const matModal = document.getElementById('materialModal');
      if (matModal && !matModal.classList.contains('hidden')) {
        closeMaterialModal();
      } else {
        closeExamModal();
      }
    }
  });

  // Garantir sincronização dos campos JSON ao enviar o formulário
  document.addEventListener('DOMContentLoaded', () => {
    renderSetoresTable();
    
    const examForm = document.getElementById('examMainForm');
    if (examForm) {
      examForm.addEventListener('submit', function() {
        const setoresElem = document.getElementById('form-exam-setores-json');
