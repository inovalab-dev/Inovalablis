<!-- ================= SCRIPTS DE COMPORTAMENTO ================= -->
<script>
  // Variáveis globais do plano de contas herdadas do servidor
  let rawTree = <%- JSON.stringify(chartOfAccountsTree) %>;
  let rawCategories = <%- JSON.stringify(accountCategories) %>;
  let activeTab = '<%= currentTab %>';

  // 1. ALTERNADOR DE ABAS DINÂMICO (SPA-feel com persistência de URL)
  function switchTab(tabId) {
    activeTab = tabId;

    // Atualizar URL de forma elegante
    const newUrl = window.location.pathname + '?tab=' + tabId;
    window.history.pushState({ tab: tabId }, '', newUrl);

    // Ocultar todos os painéis e botões de ação do topo
    document.querySelectorAll('.tab-panel').forEach(panel => panel.classList.add('hidden'));
    
    document.getElementById('btn-add-conta').classList.add('hidden');
    document.getElementById('btn-add-documento').classList.add('hidden');
    document.getElementById('btn-add-categoria').classList.add('hidden');
    document.getElementById('btn-add-plano').classList.add('hidden');

    // Desativar estilo visual de todas as abas
    const tabButtons = ['contas-bancarias', 'documentos', 'categorias', 'plano-contas'];
    tabButtons.forEach(id => {
      const btn = document.getElementById('tab-btn-' + id);
      if (btn) {
        btn.className = "px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300 transition-all";
      }
    });

    // Ativar o painel correspondente e o botão correspondente
    const activePanel = document.getElementById('panel-' + tabId);
    if (activePanel) activePanel.classList.remove('hidden');

    if (tabId === 'contas-bancarias') {
      document.getElementById('btn-add-conta').classList.remove('hidden');
    } else if (tabId === 'documentos') {
      document.getElementById('btn-add-documento').classList.remove('hidden');
    } else if (tabId === 'categorias') {
      document.getElementById('btn-add-categoria').classList.remove('hidden');
    } else if (tabId === 'plano-contas') {
      document.getElementById('btn-add-plano').classList.remove('hidden');
      renderTree(); // Certificar que a árvore renderiza atualizada
    }

    // Ativar o botão de tab ativo
    const activeBtn = document.getElementById('tab-btn-' + tabId);
    if (activeBtn) {
      activeBtn.className = "px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 border-[#284701] text-[#284701] transition-all";
    }
  }

  // Monitorar mudança de histórico de navegação (botão Voltar/Avançar do navegador)
  window.addEventListener('popstate', (event) => {
    const params = new URLSearchParams(window.location.search);
    const tab = params.get('tab') || 'contas-bancarias';
    switchTab(tab);
  });

  // 2. FUNÇÕES GERAIS DOS MODAIS
  function openModal(id) {
    const modal = document.getElementById(id);
    if (modal) {
      modal.classList.remove('hidden');
      setTimeout(() => {
        const dialog = modal.querySelector('div');
        if (dialog) {
          dialog.classList.remove('scale-95');
          dialog.classList.add('scale-100');
        }
      }, 50);
    }
  }

  function closeModal(id) {
    const modal = document.getElementById(id);
    if (modal) {
      const dialog = modal.querySelector('div');
      if (dialog) {
        dialog.classList.remove('scale-100');
        dialog.classList.add('scale-95');
      }
      setTimeout(() => {
        modal.classList.add('hidden');
      }, 150);
    }
  }

  // 3. ABA 1: CONTAS BANCÁRIAS (Ações)
  function editBankAccount(account) {
    document.getElementById('edit-bank-id').value = account.id;
    document.getElementById('edit-bank-description').value = account.description;
    openModal('edit-bank-modal');
  }

  function confirmDeleteBankAccount(id, description) {
    if (confirm('Deseja realmente excluir a conta bancária "' + description + '"?')) {
      window.location.href = '/admin/financeiro/contas-bancarias/delete/' + id;
    }
  }

  function filterBanksTable() {
    const filter = document.getElementById('bankSearch').value.toLowerCase();
    const table = document.getElementById('banksTable');
    if (!table) return;
    const trs = table.getElementsByTagName('tr');

    for (let i = 1; i < trs.length; i++) {
      const tdDesc = trs[i].querySelector('.bank-description-cell');
      if (tdDesc) {
        const text = tdDesc.textContent || tdDesc.innerText;
        trs[i].style.display = text.toLowerCase().indexOf(filter) > -1 ? "" : "none";
      }
    }
  }

  // 4. ABA 2: TIPOS DE DOCUMENTO (Ações)
  function editDocumentType(doc) {
    document.getElementById('edit-doc-id').value = doc.id;
    document.getElementById('edit-doc-description').value = doc.description;
    openModal('edit-doc-modal');
  }

  function confirmDeleteDocumentType(id, description) {
    if (confirm('Deseja realmente excluir o tipo de documento "' + description + '"?')) {
      window.location.href = '/admin/financeiro/documentos/delete/' + id;
    }
  }

  function filterDocsTable() {
    const filter = document.getElementById('docSearch').value.toLowerCase();
    const table = document.getElementById('docsTable');
    if (!table) return;
    const trs = table.getElementsByTagName('tr');

    for (let i = 1; i < trs.length; i++) {
      const tdDesc = trs[i].querySelector('.doc-description-cell');
      if (tdDesc) {
        const text = tdDesc.textContent || tdDesc.innerText;
        trs[i].style.display = text.toLowerCase().indexOf(filter) > -1 ? "" : "none";
      }
    }
  }

  // 5. ABA 3: CATEGORIAS (Ações)
  function editCategory(cat) {
    document.getElementById('edit-cat-id').value = cat.id;
    document.getElementById('edit-cat-description').value = cat.description;
    document.getElementById('edit-cat-indicator').value = cat.indicator;
    document.getElementById('edit-cat-dreRange').value = cat.dreRange || 'Receitas';
    openModal('edit-cat-modal');
  }

  function confirmDeleteCategory(id, description) {
    if (confirm('Deseja realmente excluir a categoria de plano de contas "' + description + '"?')) {
      window.location.href = '/admin/financeiro/categorias/delete/' + id;
    }
  }

  function filterCatsTable() {
    const filter = document.getElementById('catSearch').value.toLowerCase();
    const table = document.getElementById('catsTable');
    if (!table) return;
    const trs = table.getElementsByTagName('tr');

    for (let i = 1; i < trs.length; i++) {
      const tdDesc = trs[i].querySelector('.cat-description-cell');
      if (tdDesc) {
        const text = tdDesc.textContent || tdDesc.innerText;
        trs[i].style.display = text.toLowerCase().indexOf(filter) > -1 ? "" : "none";
      }
    }
  }

  // 6. ABA 4: PLANO DE CONTAS INTERATIVO (Árvore e Arraste)
  function renderTree() {
    const container = document.getElementById('tree-container');
    if (!container) return;
    container.innerHTML = '';

    // Organizar itens em hierarquia
    const roots = buildHierarchy(rawTree);
    
    if (roots.length === 0) {
      container.innerHTML = '<p class="text-center text-gray-400 p-8">Nenhuma conta cadastrada.</p>';
      return;
    }

    roots.forEach(root => {
      container.appendChild(createTreeNodeElement(root, 0));
    });
  }

  // ================= 6. ÁRVORE DINÂMICA DE PLANO DE CONTAS (3 NÍVEIS) =================
  const DRE_RANGES = [
    'Receitas',
    'Deduções sobre vendas',
    'Custos variáveis',
    'Custos fixos',
    'Despesas financeiras',
    'Investimentos'
  ];

  let expandedTreeNodes = new Set();
  DRE_RANGES.forEach((_, idx) => expandedTreeNodes.add(`dre-${idx + 1}`));
  rawCategories.forEach(c => expandedTreeNodes.add(`cat-${c.id}`));

  function recalculateTreeCodes() {
    DRE_RANGES.forEach((rangeName, rangeIdx) => {
      const level1Code = String(rangeIdx + 1);
      
      const matchedCategories = rawCategories.filter(c => (c.dreRange || 'Receitas').trim().toLowerCase() === rangeName.toLowerCase());
      
      matchedCategories.forEach((cat, catIdx) => {
        const level2Code = `${level1Code}.${catIdx + 1}`;
        cat.code = level2Code;

        const matchedAccounts = rawTree.filter(a => String(a.categoryId) === String(cat.id));
        matchedAccounts.forEach((acc, accIdx) => {
          const level3Code = `${level2Code}.${accIdx + 1}`;
          acc.code = level3Code;
        });
      });
    });
  }

  function expandAllTreeNodes() {
    DRE_RANGES.forEach((_, idx) => expandedTreeNodes.add(`dre-${idx + 1}`));
    rawCategories.forEach(c => expandedTreeNodes.add(`cat-${c.id}`));
    renderTree();
  }

  function expandLevel1TreeNodes() {
    expandedTreeNodes.clear();
    DRE_RANGES.forEach((_, idx) => expandedTreeNodes.add(`dre-${idx + 1}`));
    renderTree();
  }

  function collapseAllTreeNodes() {
    expandedTreeNodes.clear();
    renderTree();
  }

  function openAddCatForRange(rangeName) {
    const rangeSelect = document.querySelector('select[name="dreRange"]');
    if (rangeSelect) rangeSelect.value = rangeName;
    openModal('add-cat-modal');
  }

  function openAddAccountForCategory(catId) {
    const catSelects = document.querySelectorAll('select[name="categoryId"]');
    catSelects.forEach(s => s.value = catId);
    openModal('add-plano-modal');
  }

  function moveAccount(accId, direction) {
    const acc = rawTree.find(x => String(x.id) === String(accId));
    if (!acc) return;

    const sameCatAccounts = rawTree.filter(x => String(x.categoryId) === String(acc.categoryId));
    const idx = sameCatAccounts.findIndex(x => String(x.id) === String(accId));
    
    if (direction === -1 && idx > 0) {
      const prevAcc = sameCatAccounts[idx - 1];
      const mainIdxA = rawTree.findIndex(x => String(x.id) === String(acc.id));
      const mainIdxB = rawTree.findIndex(x => String(x.id) === String(prevAcc.id));
      const temp = rawTree[mainIdxA];
      rawTree[mainIdxA] = rawTree[mainIdxB];
      rawTree[mainIdxB] = temp;
    } else if (direction === 1 && idx < sameCatAccounts.length - 1) {
      const nextAcc = sameCatAccounts[idx + 1];
      const mainIdxA = rawTree.findIndex(x => String(x.id) === String(acc.id));
      const mainIdxB = rawTree.findIndex(x => String(x.id) === String(nextAcc.id));
      const temp = rawTree[mainIdxA];
      rawTree[mainIdxA] = rawTree[mainIdxB];
      rawTree[mainIdxB] = temp;
    }

    renderTree();
  }

  function moveCategory(catId, direction) {
    const cat = rawCategories.find(x => String(x.id) === String(catId));
    if (!cat) return;

    const sameRangeCats = rawCategories.filter(x => (x.dreRange || 'Receitas').trim().toLowerCase() === (cat.dreRange || 'Receitas').trim().toLowerCase());
    const idx = sameRangeCats.findIndex(x => String(x.id) === String(catId));

    if (direction === -1 && idx > 0) {
      const prevCat = sameRangeCats[idx - 1];
      const mainIdxA = rawCategories.findIndex(x => String(x.id) === String(cat.id));
      const mainIdxB = rawCategories.findIndex(x => String(x.id) === String(prevCat.id));
      const temp = rawCategories[mainIdxA];
      rawCategories[mainIdxA] = rawCategories[mainIdxB];
      rawCategories[mainIdxB] = temp;
    } else if (direction === 1 && idx < sameRangeCats.length - 1) {
      const nextCat = sameRangeCats[idx + 1];
      const mainIdxA = rawCategories.findIndex(x => String(x.id) === String(cat.id));
      const mainIdxB = rawCategories.findIndex(x => String(x.id) === String(nextCat.id));
      const temp = rawCategories[mainIdxA];
      rawCategories[mainIdxA] = rawCategories[mainIdxB];
      rawCategories[mainIdxB] = temp;
    }

    renderTree();
  }

  // HTML5 Drag and drop handlers
  let draggedAccId = null;

  function handleAccDragStart(e) {
    draggedAccId = this.dataset.accId;
    e.dataTransfer.effectAllowed = 'move';
    e.dataTransfer.setData('text/plain', draggedAccId);
    this.classList.add('opacity-40');
    e.stopPropagation();
  }

  function handleAccDragOver(e) {
    if (e.preventDefault) e.preventDefault();
    this.classList.add('bg-emerald-50', 'border-emerald-300');
    return false;
  }

  function handleAccDragLeave(e) {
    this.classList.remove('bg-emerald-50', 'border-emerald-300');
  }

  function handleAccDrop(e) {
    e.stopPropagation();
    e.preventDefault();
    this.classList.remove('bg-emerald-50', 'border-emerald-300');

    const targetAccId = this.dataset.accId;
    const targetCatId = this.dataset.catId;

    if (!draggedAccId || draggedAccId === targetAccId) return;

    const acc = rawTree.find(x => String(x.id) === String(draggedAccId));
    if (acc) {
      acc.categoryId = targetCatId;
      const accIdx = rawTree.findIndex(x => String(x.id) === String(draggedAccId));
      const targetIdx = rawTree.findIndex(x => String(x.id) === String(targetAccId));
      if (accIdx !== -1 && targetIdx !== -1) {
        const [moved] = rawTree.splice(accIdx, 1);
        rawTree.splice(targetIdx, 0, moved);
      }
      renderTree();
    }
  }

  function renderTree() {
    recalculateTreeCodes();
    const container = document.getElementById('tree-container');
    if (!container) return;

    const searchQuery = (document.getElementById('tree-search-input')?.value || '').toLowerCase().trim();
    container.innerHTML = '';

    const statCat = document.getElementById('stat-total-categories');
    const statAcc = document.getElementById('stat-total-accounts');
    if (statCat) statCat.textContent = rawCategories.length;
    if (statAcc) statAcc.textContent = rawTree.length;

    DRE_RANGES.forEach((rangeName, rangeIdx) => {
      const level1Code = String(rangeIdx + 1);
      const dreNodeId = `dre-${rangeIdx + 1}`;
      
      const categoriesInRange = rawCategories.filter(c => (c.dreRange || 'Receitas').trim().toLowerCase() === rangeName.toLowerCase());
      const totalAccountsInRange = rawTree.filter(a => categoriesInRange.some(c => String(c.id) === String(a.categoryId))).length;

      if (searchQuery) {
        const matchesSearch = rangeName.toLowerCase().includes(searchQuery) ||
          categoriesInRange.some(c => c.description.toLowerCase().includes(searchQuery) ||
            rawTree.some(a => String(a.categoryId) === String(c.id) && (a.description.toLowerCase().includes(searchQuery) || (a.code && a.code.includes(searchQuery))))
          );
        if (!matchesSearch) return;
      }

      const isExpanded = expandedTreeNodes.has(dreNodeId) || searchQuery.length > 0;

      // NÍVEL 1 CARD (Faixa DRE)
      const level1Card = document.createElement('div');
      level1Card.className = 'bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden mb-4 transition-all hover:border-brand-gold/40';
      
      let headerBg = 'bg-slate-50 border-b border-gray-200';
      let codeBadge = 'bg-slate-800 text-white';
      if (rangeName === 'Receitas') {
        headerBg = 'bg-emerald-50/70 border-b border-emerald-100';
        codeBadge = 'bg-emerald-700 text-white';
      } else if (rangeName.includes('Deduções') || rangeName.includes('Custos')) {
        headerBg = 'bg-rose-50/50 border-b border-rose-100';
        codeBadge = 'bg-rose-700 text-white';
      } else if (rangeName.includes('Investimentos') || rangeName.includes('Despesas')) {
        headerBg = 'bg-amber-50/50 border-b border-amber-100';
        codeBadge = 'bg-amber-700 text-white';
      }

      const level1Header = document.createElement('div');
      level1Header.className = `p-4 flex items-center justify-between cursor-pointer select-none ${headerBg}`;
      level1Header.onclick = (e) => {
        if (e.target.closest('.action-btn')) return;
        if (expandedTreeNodes.has(dreNodeId)) expandedTreeNodes.delete(dreNodeId);
        else expandedTreeNodes.add(dreNodeId);
        renderTree();
      };

      level1Header.innerHTML = `
        <div class="flex items-center gap-3">
          <div class="p-1.5 rounded-lg hover:bg-black/10 text-gray-700 transition-transform duration-200 ${isExpanded ? 'rotate-90' : ''}">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
          </div>
          <span class="px-3 py-1 text-xs font-mono font-black rounded-lg ${codeBadge} shadow-sm">${level1Code}</span>
          <div>
            <div class="flex items-center gap-2">
              <h3 class="text-sm font-black text-gray-900 tracking-tight">${rangeName}</h3>
              <span class="px-2 py-0.5 text-[10px] font-mono font-bold uppercase tracking-wider rounded bg-white/80 text-gray-600 border border-gray-200">Nível 1 - Faixa DRE</span>
            </div>
            <p class="text-[11px] text-gray-500 font-medium">${categoriesInRange.length} categorias • ${totalAccountsInRange} itens no plano</p>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <button type="button" onclick="openAddCatForRange('${rangeName}')" class="action-btn px-3 py-1.5 rounded-lg bg-white hover:bg-gray-100 text-[#284701] border border-gray-200 text-xs font-bold font-mono transition-all flex items-center gap-1 shadow-sm active:scale-95" title="Adicionar Categoria nesta faixa">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
            Nova Categoria
          </button>
        </div>
      `;

      level1Card.appendChild(level1Header);

      if (isExpanded) {
        const level1Body = document.createElement('div');
        level1Body.className = 'p-4 bg-gray-50/50 space-y-3 border-t border-gray-100';

        if (categoriesInRange.length === 0) {
          level1Body.innerHTML = `
            <div class="p-4 text-center text-xs text-gray-400 font-mono bg-white rounded-xl border border-dashed border-gray-200">
              Nenhuma categoria vinculada a esta faixa do DRE.
            </div>
          `;
        } else {
          categoriesInRange.forEach((cat) => {
            const catNodeId = `cat-${cat.id}`;
            const isCatExpanded = expandedTreeNodes.has(catNodeId) || searchQuery.length > 0;
            const accountsInCat = rawTree.filter(a => String(a.categoryId) === String(cat.id));

            // NÍVEL 2 CARD (Categoria)
            const catCard = document.createElement('div');
            catCard.className = 'bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden transition-all hover:border-[#284701]/30';

            const catHeader = document.createElement('div');
            catHeader.className = 'p-3 bg-white flex items-center justify-between border-b border-gray-100 hover:bg-gray-50/80 cursor-pointer select-none';
            catHeader.onclick = (e) => {
              if (e.target.closest('.action-btn')) return;
              if (expandedTreeNodes.has(catNodeId)) expandedTreeNodes.delete(catNodeId);
              else expandedTreeNodes.add(catNodeId);
              renderTree();
            };

            const isCredit = cat.indicator === 'Crédito';
            const indicatorBadge = isCredit 
              ? '<span class="px-2 py-0.5 text-[10px] font-bold font-mono uppercase rounded-md bg-emerald-50 text-emerald-700 border border-emerald-200">Crédito (+)</span>'
              : '<span class="px-2 py-0.5 text-[10px] font-bold font-mono uppercase rounded-md bg-rose-50 text-rose-700 border border-rose-200">Débito (-)</span>';

            catHeader.innerHTML = `
              <div class="flex items-center gap-2.5">
                <div class="p-1 rounded hover:bg-gray-200 text-gray-600 transition-transform duration-200 ${isCatExpanded ? 'rotate-90' : ''}">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
                </div>
                <span class="px-2.5 py-1 text-xs font-mono font-bold rounded-lg bg-[#284701] text-white shadow-xs">${cat.code}</span>
                <span class="text-xs font-black text-gray-900">${cat.description}</span>
                ${indicatorBadge}
                <span class="text-[10px] text-gray-400 font-mono font-semibold ml-1">(${accountsInCat.length} itens)</span>
              </div>

              <div class="flex items-center gap-1">
                <button type="button" onclick="moveCategory('${cat.id}', -1)" class="action-btn p-1.5 text-gray-400 hover:text-gray-700 rounded hover:bg-gray-100 transition-colors" title="Mover categoria para cima">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 15.75l7.5-7.5 7.5 7.5"/></svg>
                </button>
                <button type="button" onclick="moveCategory('${cat.id}', 1)" class="action-btn p-1.5 text-gray-400 hover:text-gray-700 rounded hover:bg-gray-100 transition-colors" title="Mover categoria para baixo">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/></svg>
                </button>
                <div class="w-px h-4 bg-gray-200 mx-1"></div>
                <button type="button" onclick="openAddAccountForCategory('${cat.id}')" class="action-btn px-2.5 py-1 text-[11px] font-bold font-mono text-[#284701] bg-[#284701]/5 hover:bg-[#284701]/10 rounded-lg transition-colors border border-[#284701]/10 flex items-center gap-1" title="Adicionar Item nesta Categoria">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
                  Nova Conta
                </button>
                <button type="button" onclick="editCategory(${JSON.stringify(cat).replace(/"/g, '&quot;')})" class="action-btn p-1.5 text-gray-400 hover:text-[#284701] hover:bg-gray-100 rounded transition-colors" title="Editar Categoria">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125"/></svg>
                </button>
              </div>
            `;

            catCard.appendChild(catHeader);

            if (isCatExpanded) {
              const catBody = document.createElement('div');
              catBody.className = 'p-3 bg-gray-50/80 space-y-1 border-t border-gray-100 pl-6 md:pl-8';

              if (accountsInCat.length === 0) {
                catBody.innerHTML = `
                  <div class="p-3 text-center text-xs text-gray-400 font-mono bg-white rounded-lg border border-dashed border-gray-200">
                    Nenhuma conta/sub-conta nesta categoria. Clique em "+ Nova Conta" acima para adicionar.
                  </div>
                `;
              } else {
                accountsInCat.forEach((acc) => {
                  // NÍVEL 3 ROW (Item do Plano de Contas)
                  const accRow = document.createElement('div');
                  accRow.className = 'flex items-center justify-between p-2.5 bg-white border border-gray-200 hover:border-gray-300 rounded-lg shadow-xs transition-all drag-account-item';
                  accRow.dataset.accId = acc.id;
                  accRow.dataset.catId = cat.id;
                  accRow.draggable = true;

                  accRow.innerHTML = `
                    <div class="flex items-center gap-2.5">
                      <div class="text-gray-300 hover:text-gray-600 cursor-grab active:cursor-grabbing p-1 shrink-0" title="Arraste para reordenar ou mover de categoria">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75h16.5M3.75 9h16.5M3.75 14.25h16.5M3.75 19.5h16.5"/></svg>
                      </div>
                      <span class="px-2 py-0.5 text-xs font-mono font-bold rounded bg-gray-100 text-gray-800 border border-gray-200">${acc.code}</span>
                      <span class="text-xs font-bold text-gray-800">${acc.description}</span>
                    </div>

                    <div class="flex items-center gap-1">
                      <button type="button" onclick="moveAccount('${acc.id}', -1)" class="p-1 text-gray-400 hover:text-gray-700 rounded hover:bg-gray-100 transition-colors" title="Mover para cima">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 15.75l7.5-7.5 7.5 7.5"/></svg>
                      </button>
                      <button type="button" onclick="moveAccount('${acc.id}', 1)" class="p-1 text-gray-400 hover:text-gray-700 rounded hover:bg-gray-100 transition-colors" title="Mover para baixo">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/></svg>
                      </button>
                      <div class="w-px h-3 bg-gray-200 mx-1"></div>
                      <button type="button" onclick="editAccount(${JSON.stringify(acc).replace(/"/g, '&quot;')})" class="p-1 text-gray-400 hover:text-[#284701] hover:bg-gray-50 rounded transition-colors" title="Editar Item">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125"/></svg>
                      </button>
                      <button type="button" onclick="confirmDeleteAccount('${acc.id}', '${acc.description}')" class="p-1 text-gray-400 hover:text-rose-600 hover:bg-rose-50 rounded transition-colors" title="Excluir Item">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/></svg>
                      </button>
                    </div>
                  `;

                  accRow.addEventListener('dragstart', handleAccDragStart);
                  accRow.addEventListener('dragover', handleAccDragOver);
                  accRow.addEventListener('dragleave', handleAccDragLeave);
                  accRow.addEventListener('drop', handleAccDrop);

                  catBody.appendChild(accRow);
                });
              }

              catCard.appendChild(catBody);
            }

            level1Body.appendChild(catCard);
          });
        }

        level1Card.appendChild(level1Body);
      }

      container.appendChild(level1Card);
    });
  }

  function saveTreeOrder() {
    const btn = document.getElementById('btn-save-order');
    if (btn) {
      btn.disabled = true;
      btn.innerHTML = `
        <svg class="animate-spin w-4 h-4 mr-1 inline" viewBox="0 0 24 24" fill="none">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
        </svg>
        Salvando...
      `;
    }

    recalculateTreeCodes();

    fetch('/admin/financeiro/plano-contas/reorder', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ tree: rawTree, categories: rawCategories })
    })
    .then(res => res.json())
    .then(data => {
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = `
          <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
          Salvar Alterações
        `;
      }
      if (data.success) {
        alert('Plano de contas e estrutura de 3 níveis salvos com sucesso!');
        window.location.reload();
      } else {
        alert('Erro ao salvar plano de contas: ' + (data.error || 'Erro desconhecido'));
      }
    })
    .catch(err => {
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = `
          <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
          Salvar Alterações
        `;
      }
      console.error('Erro de rede:', err);
      alert('Erro de rede ao salvar plano de contas.');
    });
  }

  function openAddModal() {
    openModal('add-plano-modal');
  }

  function editAccount(account) {
    document.getElementById('edit-plano-id').value = account.id;
    document.getElementById('edit-plano-description').value = account.description;
    document.getElementById('edit-plano-categoryId').value = account.categoryId;
    openModal('edit-plano-modal');
  }

  function confirmDeleteAccount(id, description) {
    if (confirm('Deseja realmente excluir a conta "' + description + '"? Sub-contas dependentes também perderão sua referência.')) {
      window.location.href = '/admin/financeiro/plano-contas/delete/' + id;
    }
  }

  // 7. CARREGAMENTO INICIAL
  document.addEventListener('DOMContentLoaded', () => {
    const params = new URLSearchParams(window.location.search);
    const queryTab = params.get('tab');
    if (queryTab) {
      activeTab = queryTab;
    }
    switchTab(activeTab);
  });
</script>

