  <div class="bg-white rounded-2xl w-full max-w-md overflow-hidden custom-shadow border border-brand-softBg flex flex-col scale-95 transition-all duration-300">
    <div class="p-6 border-b border-brand-softBg bg-[#284701]/5 flex items-center justify-between">
      <h3 class="text-lg font-bold text-[#284701] flex items-center gap-2">
        <svg class="w-5 h-5 text-brand-gold" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
        </svg>
        Editar Categoria
      </h3>
      <button onclick="closeModal('edit-cat-modal')" class="p-1.5 rounded-lg hover:bg-brand-softBg text-brand-neutralDark/40 hover:text-brand-neutralDark transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <form action="/admin/financeiro/categorias/edit" method="POST" class="p-6 flex flex-col gap-4">
      <input type="hidden" name="id" id="edit-cat-id">
      
      <div>
        <label class="block text-xs font-bold font-mono text-brand-neutralDark/70 uppercase tracking-wider mb-2">Descrição da Categoria *</label>
        <input type="text" name="description" id="edit-cat-description" required placeholder="Ex: Receitas Exames" class="w-full px-4 py-3 rounded-xl border border-brand-neutralDark/15 focus:border-[#284701] focus:ring focus:ring-[#284701]/20 text-sm font-semibold transition-all">
      </div>

      <div>
        <label class="block text-xs font-bold font-mono text-brand-neutralDark/70 uppercase tracking-wider mb-2">Indicador financeiro *</label>
        <select name="indicator" id="edit-cat-indicator" required class="w-full px-4 py-3 rounded-xl border border-brand-neutralDark/15 focus:border-[#284701] focus:ring focus:ring-[#284701]/20 text-sm font-semibold transition-all">
          <option value="Débito">Débito (-)</option>
          <option value="Crédito">Crédito (+)</option>
        </select>
      </div>

      <div>
        <label class="block text-xs font-bold font-mono text-brand-neutralDark/70 uppercase tracking-wider mb-2">Faixa no DRE *</label>
        <select name="dreRange" id="edit-cat-dreRange" required class="w-full px-4 py-3 rounded-xl border border-brand-neutralDark/15 focus:border-[#284701] focus:ring focus:ring-[#284701]/20 text-sm font-semibold transition-all bg-white text-[#1b2914]">
          <option value="Receitas">Receitas</option>
          <option value="Deduções sobre vendas">Deduções sobre vendas</option>
          <option value="Custos variáveis">Custos variables</option>
          <option value="Custos fixos">Custos fixos</option>
          <option value="Despesas financeiras">Despesas financeiras</option>
          <option value="Investimentos">Investimentos</option>
        </select>
      </div>

      <div class="flex items-center justify-end gap-3 pt-4 border-t border-brand-softBg">
        <button type="button" onclick="closeModal('edit-cat-modal')" class="px-5 py-3 rounded-xl bg-brand-softBg hover:bg-brand-neutralDark/10 text-brand-neutralDark font-bold text-xs font-mono uppercase tracking-wider transition-all">
          Cancelar
        </button>
        <button type="submit" class="px-5 py-3 rounded-xl bg-brand-gold hover:bg-[#b09363] text-[#1b2914] font-black text-xs font-mono uppercase tracking-wider transition-all shadow-md active:scale-95">
          Salvar Alterações
        </button>
      </div>
    </form>
  </div>
</div>

