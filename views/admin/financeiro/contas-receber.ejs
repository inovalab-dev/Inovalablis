<%- include('../../partials/header') %>

<div class="flex-1 p-6 md:p-8 space-y-6">
  <!-- Cabeçalho -->
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 text-xs font-bold text-[#284701] uppercase tracking-wider font-mono">
        <span class="w-2 h-2 rounded-full bg-[#284701]"></span>
        Administração Financeira
      </div>
      <h1 class="text-3xl font-extrabold text-brand-neutralDark tracking-tight mt-1">Contas a Receber</h1>
      <p class="text-sm text-gray-500">Acompanhe faturamentos de convênios, repasses, vendas particulares e entradas de caixa do laboratório.</p>
    </div>
    
    <div class="flex items-center gap-3">
      <button onclick="openAddModal('receber')" class="px-4 py-2.5 rounded-xl bg-[#284701] hover:bg-[#3d6b1d] text-white font-bold text-sm flex items-center gap-2 transition-all shadow-sm cursor-pointer">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v6m3-3H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        + Nova Conta a Receber
      </button>
    </div>
  </div>

  <!-- Abas de Navegação Financeira -->
  <div class="flex border-b border-gray-200 mb-6 overflow-x-auto whitespace-nowrap">
    <a href="/admin/financeiro/dashboard" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300 transition-all flex items-center gap-1.5">
      Dashboard
    </a>
    <a href="/admin/financeiro/relatorio-faturamento" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300 transition-all flex items-center gap-1.5">
      Relatório de Faturamento
    </a>
    <a href="/admin/financeiro/pessoas" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300 transition-all flex items-center gap-1.5">
      Clientes / Fornecedores
    </a>
    <a href="/admin/financeiro/contas-pagar" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300 transition-all flex items-center gap-1.5">
      Contas a Pagar
    </a>
    <a href="/admin/financeiro/contas-receber" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 border-[#284701] text-[#284701] transition-all flex items-center gap-1.5">
      <span class="w-2 h-2 rounded-full bg-[#284701]"></span>
      Contas a Receber
    </a>
    <a href="/admin/financeiro/fechamento-caixa" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300 transition-all flex items-center gap-1.5">
      Fechamento de Caixa
    </a>
    <a href="/admin/financeiro/fluxo-caixa" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300 transition-all flex items-center gap-1.5">
      Fluxo de Caixa
    </a>
    <a href="/admin/financeiro/dre" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300 transition-all flex items-center gap-1.5" title="Demonstrativo de Resultado">
      Demonstrativo de Resultado
    </a>
    <a href="/admin/financeiro/movimentacoes" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300 transition-all flex items-center gap-1.5">
      Movimentações
    </a>
    <a href="/admin/financeiro/configuracoes" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300 transition-all flex items-center gap-1.5">
      Configurações
    </a>
  </div>

  <!-- Seletor de Competência (Mês de Referência) -->
  <div class="bg-gradient-to-r from-emerald-500/10 via-brand-gold/10 to-transparent p-4 rounded-2xl border border-emerald-500/20 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-white flex items-center justify-center shadow-sm text-emerald-800">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5m-9-6h.008v.008H12v-.008zM12 15h.008v.008H12V15zm0 2.25h.008v.008H12v-.008zM9.75 15h.008v.008H9.75V15zm0 2.25h.008v.008H9.75v-.008zM7.5 15h.008v.008H7.5V15zm0 2.25h.008v.008H7.5v-.008zm6.75-4.5h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008V15zm0 2.25h.008v.008h-.008v-.008zm2.25-4.5h.008v.008H16.5v-.008zm0 2.25h.008v.008H16.5V15z"/>
        </svg>
      </div>
      <div>
        <p class="text-[10px] font-bold text-emerald-800 uppercase tracking-wider font-mono">Controle por Competência</p>
        <h2 class="text-sm font-bold text-gray-800">Competência de Receber: <span class="text-[#284701] font-black"><%= formatCompetence(selectedCompetence) %></span></h2>
      </div>
    </div>
    
    <div class="flex items-center gap-2">
      <button onclick="navigateCompetence(-1)" class="p-2 rounded-lg bg-white border border-gray-200 hover:bg-gray-50 text-gray-600 transition-all shadow-sm cursor-pointer" title="Mês Anterior">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/></svg>
      </button>
      
      <select id="competence-select" onchange="changeCompetence(this.value)" class="text-xs font-mono font-bold bg-white border border-gray-200 rounded-lg px-4 py-2 focus:outline-none focus:ring-1 focus:ring-[#284701] text-gray-700 shadow-sm">
        <option value="all" <%= selectedCompetence === 'all' ? 'selected' : '' %>>Todos os Meses</option>
        <% availableCompetences.forEach(comp => { %>
          <option value="<%= comp %>" <%= selectedCompetence === comp ? 'selected' : '' %>><%= formatCompetence(comp) %></option>
        <% }) %>
      </select>
      
      <button onclick="navigateCompetence(1)" class="p-2 rounded-lg bg-white border border-gray-200 hover:bg-gray-50 text-gray-600 transition-all shadow-sm cursor-pointer" title="Próximo Mês">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
      </button>
    </div>
  </div>

  <!-- Cards de Indicadores / Resumo de Contas a Receber -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <!-- A Receber Pendente -->
    <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm flex items-center justify-between">
      <div>
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest font-mono">Total A Receber (Pendente)</p>
        <p class="text-2xl font-black text-[#284701] mt-1">
          <%= new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(stats.totalReceberPendente) %>
        </p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-emerald-50 flex items-center justify-center text-[#284701] shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M12 16c1.657 0 3-.895 3-2s-1.343-2-3-2m-3-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2M14 4h6a2 2 0 012 2v1M14 4a2 2 0 00-2 2v1m-6 8a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2"/></svg>
      </div>
    </div>

    <!-- Total Recebido no Mês -->
    <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm flex items-center justify-between">
      <div>
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest font-mono">Total Recebido no Mês</p>
        <p class="text-2xl font-black text-brand-gold mt-1">
          <%= new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(stats.totalReceberPago) %>
        </p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-amber-50 flex items-center justify-center text-brand-gold shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
      </div>
    </div>

    <!-- Recebimentos Atrasados -->
    <div class="bg-white p-5 rounded-2xl border border-amber-100 shadow-sm flex items-center justify-between bg-amber-50/20">
      <div>
        <div class="flex items-center gap-2">
          <p class="text-[10px] font-bold text-amber-800 uppercase tracking-widest font-mono">Recebimentos Atrasados</p>
          <% if (stats.countAtrasado > 0) { %>
            <span class="px-1.5 py-0.5 rounded text-[9px] font-extrabold bg-amber-600 text-white font-mono"><%= stats.countAtrasado %></span>
          <% } %>
        </div>
        <p class="text-2xl font-black text-amber-700 mt-1">
          <%= new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(stats.totalAtrasado) %>
        </p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-amber-100 flex items-center justify-center text-amber-800 shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      </div>
    </div>

    <!-- A Receber Hoje -->
    <div class="bg-white p-5 rounded-2xl border border-emerald-100 shadow-sm flex items-center justify-between">
      <div>
        <div class="flex items-center gap-2">
          <p class="text-[10px] font-bold text-[#284701] uppercase tracking-widest font-mono">A Receber Hoje</p>
          <% if (stats.countVenceHoje > 0) { %>
            <span class="px-1.5 py-0.5 rounded text-[9px] font-extrabold bg-[#284701] text-white font-mono"><%= stats.countVenceHoje %></span>
          <% } %>
        </div>
        <p class="text-2xl font-black text-emerald-800 mt-1">
          <%= new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(stats.totalVenceHoje) %>
        </p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-800 shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      </div>
    </div>
  </div>

  <!-- Filtros -->
  <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm">
    <h3 class="text-xs font-bold text-[#284701] uppercase tracking-wider font-mono mb-4 flex items-center gap-1.5">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 01-.659 1.591l-5.432 5.432a2.25 2.25 0 00-.659 1.591v2.927a2.25 2.25 0 01-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 00-.659-1.591L3.659 7.409A2.25 2.25 0 013 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0112 3z"/></svg>
      Filtros de Contas a Receber
    </h3>
    
    <form action="/admin/financeiro/contas-receber" method="GET" class="grid grid-cols-1 md:grid-cols-5 gap-3">
      <!-- Status -->
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase font-mono mb-1">Status</label>
        <select name="status" class="w-full text-xs bg-brand-neutralLight border border-gray-200 rounded-lg p-2.5 focus:outline-none focus:ring-1 focus:ring-[#284701]">
          <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>Todos os Status</option>
          <option value="pendente" <%= filters.status === 'pendente' ? 'selected' : '' %>>Pendente / A Receber</option>
          <option value="pago" <%= filters.status === 'pago' ? 'selected' : '' %>>Recebido</option>
        </select>
      </div>

      <!-- Cliente / Convênio -->
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase font-mono mb-1">Cliente / Convênio</label>
        <select name="provider" class="w-full text-xs bg-brand-neutralLight border border-gray-200 rounded-lg p-2.5 focus:outline-none focus:ring-1 focus:ring-[#284701]">
          <option value="all">Todos os Clientes/Convênios</option>
          <% settings.providers.forEach(p => { %>
            <option value="<%= p %>" <%= filters.provider === p ? 'selected' : '' %>><%= p %></option>
          <% }) %>
        </select>
      </div>

      <!-- Plano de Contas -->
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase font-mono mb-1">Plano de Contas</label>
        <select name="chart" class="w-full text-xs bg-brand-neutralLight border border-gray-200 rounded-lg p-2.5 focus:outline-none focus:ring-1 focus:ring-[#284701]">
          <option value="all">Todos os Planos</option>
          <% settings.chartsOfAccounts.forEach(c => { %>
            <option value="<%= c %>" <%= filters.chart === c ? 'selected' : '' %>><%= c %></option>
          <% }) %>
        </select>
      </div>

      <!-- Vencimento Inicial -->
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase font-mono mb-1">Vencimento De</label>
        <input type="date" name="start_date" value="<%= filters.start_date || '' %>" class="w-full text-xs bg-brand-neutralLight border border-gray-200 rounded-lg p-2 focus:outline-none focus:ring-1 focus:ring-[#284701]">
      </div>

      <!-- Vencimento Final -->
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase font-mono mb-1">Vencimento Até</label>
        <div class="flex gap-2">
          <input type="date" name="end_date" value="<%= filters.end_date || '' %>" class="w-full text-xs bg-brand-neutralLight border border-gray-200 rounded-lg p-2 focus:outline-none focus:ring-1 focus:ring-[#284701]">
          <button type="submit" class="p-2.5 bg-[#284701] text-white rounded-lg hover:bg-[#3d6b1d] transition-all shrink-0 cursor-pointer">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          </button>
        </div>
      </div>
    </form>
    
    <% if (Object.keys(filters).length > 0 && (filters.status || filters.provider || filters.chart || filters.start_date || filters.end_date)) { %>
      <div class="flex justify-end mt-3">
        <a href="/admin/financeiro/contas-receber" class="text-xs font-bold text-[#284701] hover:underline flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
          Limpar Filtros Ativos
        </a>
      </div>
    <% } %>
  </div>

  <!-- Listagem de Contas a Receber -->
  <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
    <div class="p-5 border-b border-gray-100 flex items-center justify-between">
      <div>
        <h2 class="text-base font-bold text-brand-neutralDark flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-[#284701]"></span>
          Lançamentos de Contas a Receber
        </h2>
        <p class="text-xs text-gray-400 mt-0.5">Mostrando <%= transactions.length %> contas a receber na competência.</p>
      </div>
    </div>

    <% if (transactions.length === 0) { %>
      <div class="p-12 text-center">
        <div class="w-16 h-16 rounded-full bg-emerald-50 flex items-center justify-center text-[#284701] mx-auto mb-4">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M12 16c1.657 0 3-.895 3-2s-1.343-2-3-2m-3-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2"/></svg>
        </div>
        <h3 class="text-sm font-bold text-brand-neutralDark">Nenhuma conta a receber encontrada</h3>
        <p class="text-xs text-gray-400 mt-1">Nenhum lançamento de faturamento corresponde aos filtros selecionados.</p>
      </div>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-emerald-50/50 text-[10px] font-bold text-emerald-900 uppercase tracking-wider font-mono border-b border-emerald-100">
              <th class="p-4">Identificação / Documento</th>
              <th class="p-4">Cliente / Convênio</th>
              <th class="p-4">Plano de Contas</th>
              <th class="p-4">Vencimento</th>
              <th class="p-4 text-right">Valor A Receber</th>
              <th class="p-4 text-center">Status</th>
              <th class="p-4 text-center w-28">Ações</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 text-xs text-gray-700">
            <% transactions.forEach(tx => { %>
              <tr class="hover:bg-emerald-50/20 transition-all">
                <!-- Identificação / Documento -->
                <td class="p-4">
                  <div class="font-bold text-brand-neutralDark">
                    Nº <%= tx.number || 'S/N' %>
                  </div>
                  <% if (tx.docNumber || tx.docType) { %>
                    <div class="text-[10px] text-gray-400 font-mono mt-0.5">
                      <%= tx.docType %>: <%= tx.docNumber || 'Sem Nº' %>
                    </div>
                  <% } %>
                </td>

                <!-- Cliente / Convênio -->
                <td class="p-4">
                  <span class="font-medium text-gray-900"><%= tx.provider %></span>
                  <% if (tx.tags && tx.tags.length > 0) { %>
                    <div class="flex flex-wrap gap-1 mt-1">
                      <% tx.tags.forEach(tag => { %>
                        <span class="px-1.5 py-0.5 rounded text-[9px] font-bold font-mono bg-emerald-50 text-emerald-800 border border-emerald-100">
                          <%= tag %>
                        </span>
                      <% }) %>
                    </div>
                  <% } %>
                </td>

                <!-- Plano de Contas -->
                <td class="p-4">
                  <div class="text-gray-800 font-medium"><%= tx.chartOfAccounts %></div>
                  <% if (tx.bank) { %>
                    <div class="text-[10px] text-gray-400 mt-0.5">
                      Banco: <%= tx.bank %>
                    </div>
                  <% } %>
                </td>

                <!-- Vencimento -->
                <td class="p-4">
                  <% 
                    const isOverdue = tx.status !== 'pago' && new Date(tx.dueDate) < new Date();
                    const dueFormatted = tx.dueDate ? tx.dueDate.split('-').reverse().join('/') : '-';
                  %>
                  <div class="<%= isOverdue ? 'text-amber-700 font-extrabold' : 'text-gray-900 font-medium' %> flex items-center gap-1">
                    <%= dueFormatted %>
                    <% if (isOverdue) { %>
                      <span class="px-1 py-0.5 rounded text-[8px] font-bold bg-amber-100 text-amber-800 font-mono animate-pulse uppercase">Atrasado</span>
                    <% } %>
                  </div>
                  <% if (tx.issueDate) { %>
                    <div class="text-[9px] text-gray-400 mt-0.5">
                      Emissão: <%= tx.issueDate.split('-').reverse().join('/') %>
                    </div>
                  <% } %>
                </td>

                <!-- Valor -->
                <td class="p-4 text-right">
                  <div class="font-extrabold text-sm text-[#284701]">
                    +&nbsp;<%= new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(tx.amount) %>
                  </div>
                  <% if (tx.installments && tx.installments > 1) { %>
                    <div class="text-[10px] text-gray-400 font-mono">
                      <%= tx.installments %> Parcelas
                    </div>
                  <% } %>
                </td>

                <!-- Status -->
                <td class="p-4 text-center">
                  <% if (tx.status === 'pago') { %>
                    <form action="/admin/financeiro/status" method="POST" class="inline">
                      <input type="hidden" name="id" value="<%= tx.id %>">
                      <input type="hidden" name="status" value="pendente">
                      <button type="submit" title="Clique para reabrir conta a receber" class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 hover:bg-rose-100 hover:text-rose-800 transition-all uppercase tracking-wider font-mono cursor-pointer">
                        Recebido
                      </button>
                    </form>
                  <% } else { %>
                    <button type="button" onclick="openBaixaModal('<%= tx.id %>', '<%= tx.provider.replace(/\'/g, '\\\'') %>', <%= tx.amount %>, '<%= tx.bank || '' %>', 'receber')" title="Clique para dar baixa / confirmar recebimento" class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800 hover:bg-emerald-600 hover:text-white transition-all uppercase tracking-wider font-mono cursor-pointer">
                      Pendente (Receber)
                    </button>
                  <% } %>
                </td>

                <!-- Ações -->
                <td class="p-4 text-center">
                  <div class="flex items-center justify-center gap-1.5">
                    <button onclick="openEditModal(<%= JSON.stringify(tx) %>)" class="p-1.5 text-blue-600 hover:bg-blue-50 rounded-lg transition-colors cursor-pointer" title="Editar Lançamento">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                    </button>
                    
                    <form action="/admin/financeiro/delete" method="POST" onsubmit="return confirm('Deseja realmente excluir este lançamento de conta a receber?');" class="inline">
                      <input type="hidden" name="id" value="<%= tx.id %>">
                      <button type="submit" class="p-1.5 text-rose-600 hover:bg-rose-50 rounded-lg transition-colors cursor-pointer" title="Deletar Lançamento">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<!-- ================= MODAL DE LANÇAMENTO (CADASTRO / EDIÇÃO) ================= -->
<div id="tx-modal" class="hidden fixed inset-0 z-50 bg-black/50 backdrop-blur-sm flex items-center justify-center p-4">
  <div class="bg-white rounded-3xl w-full max-w-2xl shadow-2xl overflow-hidden fade-in relative border border-gray-100 max-h-[90vh] flex flex-col">
    <!-- Cabeçalho Modal -->
    <div class="p-6 border-b border-gray-100 flex items-center justify-between bg-emerald-50/40">
      <div>
        <h2 id="modal-title" class="text-lg font-black text-[#284701]">Cadastro de Conta a Receber</h2>
        <p class="text-xs text-gray-400 mt-0.5">Preencha as informações detalhadas do faturamento ou cliente.</p>
      </div>
      <button onclick="closeModal()" class="text-gray-400 hover:text-gray-600 p-1.5 hover:bg-gray-100 rounded-lg transition-colors cursor-pointer">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <!-- Formulário -->
    <form id="tx-form" action="/admin/financeiro/add" method="POST" class="overflow-y-auto p-6 space-y-4 text-left flex-1">
      <input type="hidden" name="id" id="form-tx-id">
      <input type="hidden" name="type" id="form-tx-type" value="receber">

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <!-- Número de Lançamento -->
        <div>
          <label for="form-number" class="block text-[10px] font-bold text-gray-400 uppercase font-mono mb-1">Número</label>
          <input type="text" name="number" id="form-number" class="w-full text-xs bg-brand-neutralLight border border-gray-200 rounded-lg p-2.5 focus:outline-none focus:ring-1 focus:ring-[#284701]">
        </div>

        <!-- Data Emissão -->
        <div>
          <label for="form-issueDate" class="block text-[10px] font-bold text-gray-400 uppercase font-mono mb-1">Data Emissão *</label>
          <input type="date" name="issueDate" id="form-issueDate" required class="w-full text-xs bg-brand-neutralLight border border-gray-200 rounded-lg p-2.5 focus:outline-none focus:ring-1 focus:ring-[#284701]">
        </div>

        <!-- Número de Documento -->
        <div>
          <label for="form-docNumber" class="block text-[10px] font-bold text-gray-400 uppercase font-mono mb-1">Número Documento</label>
          <input type="text" name="docNumber" id="form-docNumber" class="w-full text-xs bg-brand-neutralLight border border-gray-200 rounded-lg p-2.5 focus:outline-none focus:ring-1 focus:ring-[#284701]">
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Cliente / Convênio -->
        <div>
          <div class="flex items-center justify-between mb-1">
            <label for="form-provider" class="block text-[10px] font-bold text-gray-400 uppercase font-mono">Cliente / Convênio *</label>
            <button type="button" onclick="promptAddProvider()" class="text-[10px] font-bold text-[#284701] hover:underline font-mono">Adicionar cliente</button>
          </div>
          <select name="provider" id="form-provider" required class="w-full text-xs bg-brand-neutralLight border border-gray-200 rounded-lg p-2.5 focus:outline-none focus:ring-1 focus:ring-[#284701]">
            <option value="">Selecione...</option>
            <% settings.providers.forEach(p => { %>
              <option value="<%= p %>"><%= p %></option>
            <% }) %>
          </select>
        </div>

        <!-- Tipo Documento -->
        <div>
          <label for="form-docType" class="block text-[10px] font-bold text-gray-400 uppercase font-mono mb-1">Tipo Documento *</label>
          <select name="docType" id="form-docType" required class="w-full text-xs bg-brand-neutralLight border border-gray-200 rounded-lg p-2.5 focus:outline-none focus:ring-1 focus:ring-[#284701]">
            <option value="">Selecione...</option>
            <% settings.docTypes.forEach(d => { %>
              <option value="<%= d %>"><%= d %></option>
            <% }) %>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Plano de Contas -->
        <div>
          <div class="flex items-center justify-between mb-1">
            <label for="form-chartOfAccounts" class="block text-[10px] font-bold text-gray-400 uppercase font-mono">Plano de Contas *</label>
            <button type="button" onclick="promptAddChart()" class="text-[10px] font-bold text-[#284701] hover:underline font-mono">Adicionar plano</button>
          </div>
          <select name="chartOfAccounts" id="form-chartOfAccounts" required class="w-full text-xs bg-brand-neutralLight border border-gray-200 rounded-lg p-2.5 focus:outline-none focus:ring-1 focus:ring-[#284701]">
            <option value="">Selecione...</option>
            <% settings.chartsOfAccounts.forEach(c => { %>
              <option value="<%= c %>"><%= c %></option>
            <% }) %>
          </select>
        </div>

        <!-- Banco -->
        <div>
          <label for="form-bank" class="block text-[10px] font-bold text-gray-400 uppercase font-mono mb-1">Conta Bancária Destino</label>
          <select name="bank" id="form-bank" class="w-full text-xs bg-brand-neutralLight border border-gray-200 rounded-lg p-2.5 focus:outline-none focus:ring-1 focus:ring-[#284701]">
            <option value="">Selecione...</option>
            <% settings.banks.forEach(b => { %>
              <option value="<%= b %>"><%= b %></option>
            <% }) %>
          </select>
        </div>
      </div>

      <!-- Tags e Descrição -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="md:col-span-1">
          <label for="form-tags" class="block text-[10px] font-bold text-gray-400 uppercase font-mono mb-1">Tags (Vírgula)</label>
          <input type="text" name="tags" id="form-tags" placeholder="Ex: Convênio, Particular, Cartão" class="w-full text-xs bg-brand-neutralLight border border-gray-200 rounded-lg p-2.5 focus:outline-none focus:ring-1 focus:ring-[#284701]">
        </div>
        <div class="md:col-span-2">
          <label for="form-description" class="block text-[10px] font-bold text-gray-400 uppercase font-mono mb-1">Descrição / Histórico</label>
          <input type="text" name="description" id="form-description" placeholder="Informações adicionais da receita..." class="w-full text-xs bg-brand-neutralLight border border-gray-200 rounded-lg p-2.5 focus:outline-none focus:ring-1 focus:ring-[#284701]">
        </div>
      </div>

      <!-- Valor Total, Parcelas, Vencimento, Intervalo, Recorrente -->
      <div class="grid grid-cols-2 md:grid-cols-5 gap-4 pt-2">
        <div>
          <label for="form-amount" class="block text-[10px] font-bold text-gray-400 uppercase font-mono mb-1">Valor A Receber (R$) *</label>
          <input type="number" step="0.01" min="0.01" name="amount" id="form-amount" required placeholder="0.00" class="w-full text-xs bg-brand-neutralLight border border-gray-200 rounded-lg p-2.5 focus:outline-none focus:ring-1 focus:ring-[#284701] font-mono font-bold text-[#284701]">
        </div>

        <div>
          <label for="form-installments" class="block text-[10px] font-bold text-gray-400 uppercase font-mono mb-1">Parcelas</label>
          <input type="number" min="1" max="120" name="installments" id="form-installments" value="1" required class="w-full text-xs bg-brand-neutralLight border border-gray-200 rounded-lg p-2.5 focus:outline-none focus:ring-1 focus:ring-[#284701] font-mono">
        </div>

        <div>
          <label for="form-dueDate" class="block text-[10px] font-bold text-gray-400 uppercase font-mono mb-1">Vencimento *</label>
          <input type="date" name="dueDate" id="form-dueDate" required class="w-full text-xs bg-brand-neutralLight border border-gray-200 rounded-lg p-2.5 focus:outline-none focus:ring-1 focus:ring-[#284701]">
        </div>

        <div>
          <label for="form-interval" class="block text-[10px] font-bold text-gray-400 uppercase font-mono mb-1">Intervalo</label>
          <select name="interval" id="form-interval" class="w-full text-xs bg-brand-neutralLight border border-gray-200 rounded-lg p-2.5 focus:outline-none focus:ring-1 focus:ring-[#284701]">
            <option value="Único">Único</option>
            <option value="Semanal">Semanal</option>
            <option value="Quinzenal">Quinzenal</option>
            <option value="Mensal" selected>Mensal</option>
            <option value="Anual">Anual</option>
          </select>
        </div>

        <div class="col-span-2 md:col-span-1">
          <label class="block text-[10px] font-bold text-gray-400 uppercase font-mono mb-2">Recorrente</label>
          <div class="flex items-center gap-2 mt-1">
            <input type="checkbox" name="recurrent" id="form-recurrent" value="true" class="w-4 h-4 text-[#284701] border-gray-300 rounded focus:ring-[#284701]">
            <span class="text-xs text-gray-600 font-medium">Recorrente</span>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
        <!-- Status de Lançamento Inicial -->
        <div>
          <label for="form-status" class="block text-[10px] font-bold text-gray-400 uppercase font-mono mb-1">Situação Inicial</label>
          <select name="status" id="form-status" class="w-full text-xs bg-brand-neutralLight border border-gray-200 rounded-lg p-2.5 focus:outline-none focus:ring-1 focus:ring-[#284701]" onchange="togglePaidAt()">
            <option value="pendente" selected>Pendente / A Receber</option>
            <option value="pago">Recebido (Dar Baixa Já)</option>
          </select>
        </div>

        <!-- Data do Recebimento -->
        <div id="form-paidAt-container" class="hidden">
          <label for="form-paidAt" class="block text-[10px] font-bold text-gray-400 uppercase font-mono mb-1">Data do Recebimento</label>
          <input type="date" name="paidAt" id="form-paidAt" class="w-full text-xs bg-brand-neutralLight border border-gray-200 rounded-lg p-2.5 focus:outline-none focus:ring-1 focus:ring-[#284701]">
        </div>
      </div>

      <!-- Rodapé do formulário -->
      <div class="pt-6 border-t border-gray-100 flex items-center justify-end gap-3">
        <button type="button" onclick="closeModal()" class="px-5 py-2.5 rounded-xl border border-gray-200 text-gray-500 font-bold text-xs hover:bg-gray-50 transition-colors uppercase font-mono cursor-pointer">
          Cancelar
        </button>
        <button type="submit" class="px-6 py-2.5 rounded-xl bg-[#284701] hover:bg-[#3d6b1d] text-white font-extrabold text-xs transition-colors shadow-sm uppercase font-mono cursor-pointer">
          Salvar Conta a Receber
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  // Controladores do Modal
  function openAddModal(type = 'receber') {
    const form = document.getElementById('tx-form');
    form.reset();
    form.action = '/admin/financeiro/add';
    
    document.getElementById('form-tx-id').value = '';
    document.getElementById('form-tx-type').value = 'receber';
    document.getElementById('form-status').value = 'pendente';
    
    const today = new Date().toISOString().split('T')[0];
    document.getElementById('form-issueDate').value = today;
    document.getElementById('form-dueDate').value = today;
    document.getElementById('form-paidAt').value = today;

    togglePaidAt();
    
    document.getElementById('tx-modal').classList.remove('hidden');
    document.getElementById('form-number').focus();
  }

  function openEditModal(tx) {
    const form = document.getElementById('tx-form');
    form.reset();
    form.action = '/admin/financeiro/edit';

    document.getElementById('form-tx-id').value = tx.id;
    document.getElementById('form-tx-type').value = 'receber';
    document.getElementById('form-number').value = tx.number || '';
    document.getElementById('form-issueDate').value = tx.issueDate || '';
    document.getElementById('form-docNumber').value = tx.docNumber || '';
    document.getElementById('form-provider').value = tx.provider || '';
    document.getElementById('form-docType').value = tx.docType || '';
    document.getElementById('form-chartOfAccounts').value = tx.chartOfAccounts || '';
    document.getElementById('form-bank').value = tx.bank || '';
    document.getElementById('form-tags').value = (tx.tags || []).join(', ');
    document.getElementById('form-description').value = tx.description || '';
    document.getElementById('form-amount').value = tx.amount || '';
    document.getElementById('form-installments').value = tx.installments || '1';
    document.getElementById('form-dueDate').value = tx.dueDate || '';
    document.getElementById('form-interval').value = tx.interval || 'Mensal';
    document.getElementById('form-recurrent').checked = !!tx.recurrent;
    document.getElementById('form-status').value = tx.status || 'pendente';
    document.getElementById('form-paidAt').value = tx.paidAt || new Date().toISOString().split('T')[0];

    togglePaidAt();

    document.getElementById('tx-modal').classList.remove('hidden');
  }

  function closeModal() {
    document.getElementById('tx-modal').classList.add('hidden');
  }

  function togglePaidAt() {
    const status = document.getElementById('form-status').value;
    const container = document.getElementById('form-paidAt-container');
    if (status === 'pago') {
      container.classList.remove('hidden');
    } else {
      container.classList.add('hidden');
    }
  }

  async function promptAddProvider() {
    const providerName = prompt("Digite o nome do novo Cliente / Convênio:");
    if (!providerName || !providerName.trim()) return;

    try {
      const response = await fetch('/api/financeiro/add-provider', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ provider: providerName })
      });

      const data = await response.json();
      if (data.success) {
        const select = document.getElementById('form-provider');
        select.innerHTML = '<option value="">Selecione...</option>';
        data.providers.forEach(p => {
          const opt = document.createElement('option');
          opt.value = p;
          opt.textContent = p;
          if (p === providerName.trim()) opt.selected = true;
          select.appendChild(opt);
        });
        alert('Cliente / Convênio "' + providerName.trim() + '" adicionado com sucesso!');
      } else {
        alert('Erro ao adicionar cliente: ' + (data.error || 'Erro desconhecido'));
      }
    } catch (err) {
      console.error(err);
      alert('Erro de conexão ao salvar cliente.');
    }
  }

  async function promptAddChart() {
    const chartName = prompt("Digite o nome do novo Plano de Contas:");
    if (!chartName || !chartName.trim()) return;

    try {
      const response = await fetch('/api/financeiro/add-chart', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ chart: chartName })
      });

      const data = await response.json();
      if (data.success) {
        const select = document.getElementById('form-chartOfAccounts');
        select.innerHTML = '<option value="">Selecione...</option>';
        data.chartsOfAccounts.forEach(c => {
          const opt = document.createElement('option');
          opt.value = c;
          opt.textContent = c;
          if (c === chartName.trim()) opt.selected = true;
          select.appendChild(opt);
        });
        alert('Plano de Contas "' + chartName.trim() + '" adicionado com sucesso!');
      } else {
        alert('Erro ao adicionar plano de contas: ' + (data.error || 'Erro desconhecido'));
      }
    } catch (err) {
      console.error(err);
      alert('Erro de conexão ao salvar plano de contas.');
    }
  }

  function changeCompetence(val) {
    const url = new URL(window.location.href);
    url.searchParams.set('competence', val);
    window.location.href = url.toString();
  }
  
  function navigateCompetence(direction) {
    const select = document.getElementById('competence-select');
    if (!select) return;
    const currentIndex = select.selectedIndex;
    let nextIndex = currentIndex + (direction * -1);
    if (nextIndex >= 0 && nextIndex < select.options.length) {
      changeCompetence(select.options[nextIndex].value);
    }
  }

  function openBaixaModal(id, provider, amount, bank, type) {
    document.getElementById('baixa-id').value = id;
    document.getElementById('baixa-provider').textContent = provider;
    
    const formattedAmount = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(amount);
    document.getElementById('baixa-amount').textContent = '+ ' + formattedAmount;
    
    const bankSelect = document.getElementById('baixa-bank');
    if (bank && bank.trim() !== '') {
      bankSelect.value = bank;
    } else {
      bankSelect.selectedIndex = 0;
    }

    const today = new Date().toISOString().split('T')[0];
    document.getElementById('baixa-paidAt').value = today;

    document.getElementById('baixa-modal').classList.remove('hidden');
  }

  function closeBaixaModal() {
    document.getElementById('baixa-modal').classList.add('hidden');
  }
</script>

<!-- ================= MODAL DE BAIXA FINANCEIRA ================= -->
<div id="baixa-modal" class="hidden fixed inset-0 z-50 bg-black/50 backdrop-blur-sm flex items-center justify-center p-4">
  <div class="bg-white rounded-3xl w-full max-w-md shadow-2xl overflow-hidden fade-in relative border border-gray-100 p-6">
    <div class="flex items-center justify-between border-b border-gray-100 pb-4 mb-4">
      <div>
        <h3 id="baixa-title" class="text-lg font-black text-emerald-900">Dar Baixa no Recebimento</h3>
        <p id="baixa-desc" class="text-xs text-gray-400 mt-0.5">Confirme o recebimento para registrar a entrada no caixa do laboratório.</p>
      </div>
      <button type="button" onclick="closeBaixaModal()" class="text-gray-400 hover:text-gray-600 p-1.5 hover:bg-gray-100 rounded-lg transition-colors cursor-pointer">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <form action="/admin/financeiro/status" method="POST" class="space-y-4">
      <input type="hidden" name="id" id="baixa-id">
      <input type="hidden" name="status" value="pago">

      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase font-mono mb-1">Cliente / Convênio</label>
        <div id="baixa-provider" class="text-xs font-bold text-gray-800 bg-gray-50 rounded-lg p-2.5 border border-gray-100"></div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase font-mono mb-1">Valor A Receber</label>
          <div id="baixa-amount" class="text-xs font-mono font-bold text-emerald-800 bg-emerald-50 rounded-lg p-2.5 border border-emerald-100"></div>
        </div>
        <div>
          <label for="baixa-paidAt" class="block text-[10px] font-bold text-gray-400 uppercase font-mono mb-1">Data do Recebimento *</label>
          <input type="date" name="paidAt" id="baixa-paidAt" required class="w-full text-xs bg-brand-neutralLight border border-gray-200 rounded-lg p-2.5 focus:outline-none focus:ring-1 focus:ring-[#284701]">
        </div>
      </div>

      <div>
        <label for="baixa-bank" class="block text-[10px] font-bold text-gray-400 uppercase font-mono mb-1">Conta Bancária Destino *</label>
        <select name="bank" id="baixa-bank" required class="w-full text-xs bg-brand-neutralLight border border-gray-200 rounded-lg p-2.5 focus:outline-none focus:ring-1 focus:ring-[#284701]">
          <% settings.banks.forEach(b => { %>
            <option value="<%= b %>"><%= b %></option>
          <% }) %>
        </select>
      </div>

      <div class="pt-4 border-t border-gray-100 flex items-center justify-end gap-3">
        <button type="button" onclick="closeBaixaModal()" class="px-4 py-2 rounded-xl border border-gray-200 text-gray-500 font-bold text-xs hover:bg-gray-50 transition-colors uppercase font-mono cursor-pointer">
          Cancelar
        </button>
        <button type="submit" class="px-5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-xs transition-colors shadow-sm uppercase font-mono cursor-pointer">
          Confirmar Recebimento
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('../../partials/footer') %>
