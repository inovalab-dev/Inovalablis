                      <td class="py-2.5 font-mono <%= isOverdue ? 'text-rose-500 font-bold' : 'text-gray-500' %>">
                        <%= t.dueDate.split('-').reverse().join('/') %>
                        <% if (isOverdue) { %>
                          <span class="block text-[8px] uppercase tracking-wider text-rose-500 font-extrabold font-mono leading-none mt-0.5">Atrasado</span>
                        <% } %>
                      </td>
                      <td class="py-2.5">
                        <p class="font-bold text-gray-800"><%= t.provider %></p>
                        <p class="text-[10px] text-gray-400 truncate max-w-[150px] sm:max-w-[300px]"><%= t.description || 'S/ Descrição' %></p>
                      </td>
                      <td class="py-2.5 text-right font-mono font-bold text-rose-600">
