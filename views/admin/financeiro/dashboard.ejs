<%- include('../../partials/header') %>

<div class="p-4 md:p-8 w-full flex-1 flex flex-col gap-6 fade-in">
  
  <!-- Cabeçalho -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-brand-softBg custom-shadow">
    <div class="flex items-center gap-4">
      <div class="w-12 h-12 rounded-xl bg-[#284701]/10 text-[#284701] flex items-center justify-center shrink-0">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
        </svg>
      </div>
      <div>
        <p class="text-xs font-bold text-brand-gold uppercase tracking-wider font-mono">Gestão Financeira</p>
        <h1 class="text-2xl font-black text-[#284701] tracking-tight">Dashboard Financeiro</h1>
      </div>
    </div>
    
    <div class="flex items-center gap-2 text-xs font-mono text-gray-500 bg-gray-50 px-4 py-2.5 rounded-xl border border-gray-100 shrink-0">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span>Atualizado em tempo real</span>
    </div>
  </div>

  <!-- Sub-Navegação para facilidade de uso -->
  <div class="flex border-b border-gray-200 overflow-x-auto whitespace-nowrap mb-6">
    <a href="/admin/financeiro/dashboard" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-dashboard') ? 'border-[#284701] text-[#284701]' : 'border-[#284701] text-[#284701]' %> transition-all flex items-center gap-1.5">
      Dashboard
    </a>
    <a href="/admin/financeiro/relatorio-faturamento" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-relatorio-faturamento') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5">
      Relatório de Faturamento
    </a>
    <a href="/admin/financeiro/pessoas" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-pessoas') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5">
      Clientes / Fornecedores
    </a>
    <a href="/admin/financeiro/contas-pagar" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-contas-pagar') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5">
      Contas a Pagar
    </a>
    <a href="/admin/financeiro/contas-receber" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-contas-receber') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5">
      Contas a Receber
    </a>
    <a href="/admin/financeiro/fechamento-caixa" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && (page === 'admin-financeiro-fechamento-caixa' || page === 'admin-fechamento-caixa')) ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5">
      Fechamento de Caixa
    </a>
    <a href="/admin/financeiro/fluxo-caixa" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-fluxo-caixa') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5">
      Fluxo de Caixa
    </a>
    <a href="/admin/financeiro/dre" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-dre') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5" title="Demonstrativo de Resultado">
      Demonstrativo de Resultado
    </a>
    <a href="/admin/financeiro/movimentacoes" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-movimentacoes') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5">
      Movimentações
    </a>
    <a href="/admin/financeiro/configuracoes" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-configuracoes') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5">
      Configurações
    </a>
  </div>

  <!-- Seletor de Competência (Mês de Referência) -->
  <div class="bg-gradient-to-r from-emerald-500/10 via-brand-gold/10 to-transparent p-4 rounded-2xl border border-emerald-500/20 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-white flex items-center justify-center shadow-sm text-emerald-700">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5m-9-6h.008v.008H12v-.008zM12 15h.008v.008H12V15zm0 2.25h.008v.008H12v-.008zM9.75 15h.008v.008H9.75V15zm0 2.25h.008v.008H9.75v-.008zM7.5 15h.008v.008H7.5V15zm0 2.25h.008v.008H7.5v-.008zm6.75-4.5h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008V15zm0 2.25h.008v.008h-.008v-.008zm2.25-4.5h.008v.008H16.5v-.008zm0 2.25h.008v.008H16.5V15z"/>
        </svg>
      </div>
      <div>
        <p class="text-[10px] font-bold text-emerald-800 uppercase tracking-wider font-mono">Controle por Competência</p>
        <h2 class="text-sm font-bold text-gray-800">Visualizando competência de: <span class="text-[#284701] font-black"><%= formatCompetence(selectedCompetence) %></span></h2>
      </div>
    </div>
    
    <div class="flex items-center gap-2">
      <button onclick="navigateCompetence(-1)" class="p-2 rounded-lg bg-white border border-gray-200 hover:bg-gray-50 text-gray-600 transition-all shadow-sm cursor-pointer" title="Mês Anterior">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/></svg>
      </button>
      
      <select id="competence-select" onchange="changeCompetence(this.value)" class="text-xs font-mono font-bold bg-white border border-gray-200 rounded-lg px-4 py-2 focus:outline-none focus:ring-1 focus:ring-[#284701] text-gray-700 shadow-sm">
        <option value="all" <%= selectedCompetence === 'all' ? 'selected' : '' %>>Todos os Meses</option>
        <% availableCompetences.forEach(comp => { %>
          <option value="<%= comp %>" <%= selectedCompetence === comp ? 'selected' : '' %>><%= formatCompetence(comp) %></option>
        <% }) %>
      </select>
      
      <button onclick="navigateCompetence(1)" class="p-2 rounded-lg bg-white border border-gray-200 hover:bg-gray-50 text-gray-600 transition-all shadow-sm cursor-pointer" title="Próximo Mês">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
      </button>
    </div>
  </div>

  <!-- Cartões de Resumos de Métricas Superiores -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <!-- Card 1: Contas a receber em atraso (Ciano/Deep Teal) -->
    <div class="rounded-2xl p-5 text-white flex items-center gap-4 transition-transform hover:scale-[1.01] shadow-md" style="background-color: #00bcd4;">
      <div class="w-12 h-12 rounded-xl bg-white/20 flex items-center justify-center shrink-0">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5m-9-6h.008v.008H12v-.008zM12 15h.008v.008H12V15zm0 2.25h.008v.008H12v-.008zM9.75 15h.008v.008H9.75V15zm0 2.25h.008v.008H9.75v-.008zM7.5 15h.008v.008H7.5V15zm0 2.25h.008v.008H7.5v-.008zm6.75-4.5h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008V15zm0 2.25h.008v.008h-.008v-.008zm2.25-4.5h.008v.008H16.5v-.008zm0 2.25h.008v.008H16.5V15z"/>
        </svg>
      </div>
      <div class="overflow-hidden">
        <p class="text-[10px] font-bold uppercase tracking-wider text-white/80 font-mono">Receber em Atraso</p>
        <p class="text-xl md:text-2xl font-black tracking-tight truncate mt-0.5">
          R$ <%= contasReceberAtraso.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
        </p>
      </div>
    </div>

    <!-- Card 2: Contas a receber em aberto para este mês (Verde vibrante) -->
    <div class="rounded-2xl p-5 text-white flex items-center gap-4 transition-transform hover:scale-[1.01] shadow-md" style="background-color: #00c853;">
      <div class="w-12 h-12 rounded-xl bg-white/20 flex items-center justify-center shrink-0">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.265-.113a5.003 5.003 0 001.52-1.026 5.002 5.002 0 001.52-3.078 5.002 5.002 0 00-1.52-3.078 5.002 5.002 0 00-1.52-1.026L9 5.182m-3 14h12"/>
        </svg>
      </div>
      <div class="overflow-hidden">
        <p class="text-[10px] font-bold uppercase tracking-wider text-white/80 font-mono font-bold">Receber em Aberto (Mês)</p>
        <p class="text-xl md:text-2xl font-black tracking-tight truncate mt-0.5">
          R$ <%= contasReceberAbertoMes.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
        </p>
      </div>
    </div>

    <!-- Card 3: Contas a pagar em aberto para este mês (Laranja suave) -->
    <div class="rounded-2xl p-5 text-white flex items-center gap-4 transition-transform hover:scale-[1.01] shadow-md" style="background-color: #ffa726;">
      <div class="w-12 h-12 rounded-xl bg-white/20 flex items-center justify-center shrink-0">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5h.007m-.007 3h.007m-.007 3h.007m-2.25 9h16.5m-16.5 0a2.25 2.25 0 01-2.25-2.25V5.25A2.25 2.25 0 013.75 3h16.5a2.25 2.25 0 012.25 2.25v13.5a2.25 2.25 0 01-2.25 2.25M16.5 7.5h.007v.008H16.5V7.5zm0 3h.007v.008H16.5v-.008zm0 3h.007v.008H16.5v-.008z"/>
        </svg>
      </div>
      <div class="overflow-hidden">
        <p class="text-[10px] font-bold uppercase tracking-wider text-white/80 font-mono font-bold">Pagar em Aberto (Mês)</p>
        <p class="text-xl md:text-2xl font-black tracking-tight truncate mt-0.5">
          R$ <%= contasPagarAbertoMes.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
        </p>
      </div>
    </div>

    <!-- Card 4: Contas a pagar em atraso (Rosa escuro / Vermelho) -->
    <div class="rounded-2xl p-5 text-white flex items-center gap-4 transition-transform hover:scale-[1.01] shadow-md" style="background-color: #ff1744;">
      <div class="w-12 h-12 rounded-xl bg-white/20 flex items-center justify-center shrink-0">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2.25m0 3.75h.008v.008H12v-.008zM2.25 12c0 5.385 4.365 9.75 9.75 9.75s9.75-4.365 9.75-9.75S17.385 2.25 12 2.25 2.25 6.615 2.25 12z"/>
        </svg>
      </div>
      <div class="overflow-hidden">
        <p class="text-[10px] font-bold uppercase tracking-wider text-white/80 font-mono font-bold">Pagar em Atraso</p>
        <p class="text-xl md:text-2xl font-black tracking-tight truncate mt-0.5">
          R$ <%= contasPagarAtraso.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
        </p>
      </div>
    </div>
  </div>

  <!-- Linha Central: Comparativo do Mês e Gráfico de Projeção para os Próximos Dias -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- Bloco Esquerdo: Situação do Mês Atual (Estatísticas e Lucro Projetado) -->
    <div class="lg:col-span-4 bg-white p-6 rounded-2xl border border-brand-softBg custom-shadow flex flex-col justify-between min-h-[360px]">
      <div>
        <h2 class="text-base font-bold text-gray-800 tracking-tight flex items-center gap-1.5 border-b border-gray-100 pb-3">
          <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6a7.5 7.5 0 107.5 7.5h-7.5V6z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5H21A7.5 7.5 0 0013.5 3v7.5z"/>
          </svg>
          Situação no mês atual
        </h2>
        
        <div class="mt-6 space-y-4">
          <!-- Recebimentos -->
          <div>
            <div class="flex items-center justify-between text-xs font-mono font-bold text-gray-600 mb-1.5">
              <span class="flex items-center gap-1">
                Projeção de recebimentos
                <span class="text-gray-400 group relative cursor-pointer" title="Soma de todas as contas a receber deste mês (abertas e pagas)">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </span>
              </span>
              <span>R$ <%= projRecebimentosMes.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></span>
            </div>
            <!-- Barra Simples -->
            <div class="h-4 w-full bg-gray-100 rounded-full overflow-hidden flex">
              <div class="bg-emerald-500 h-full transition-all duration-500" style="width: <%= projRecebimentosMes > 0 || projPagamentosMes > 0 ? (projRecebimentosMes / (projRecebimentosMes + projPagamentosMes) * 100) : 50 %>%;"></div>
              <div class="bg-rose-500 h-full transition-all duration-500" style="width: <%= projRecebimentosMes > 0 || projPagamentosMes > 0 ? (projPagamentosMes / (projRecebimentosMes + projPagamentosMes) * 100) : 50 %>%;"></div>
            </div>
          </div>

          <!-- Pagamentos -->
          <div class="pt-2">
            <div class="flex items-center justify-between text-xs font-mono font-bold text-gray-600 mb-1">
              <span class="flex items-center gap-1">
                Projeção de pagamentos
                <span class="text-gray-400 group relative cursor-pointer" title="Soma de todas as contas a pagar deste mês (abertas e pagas)">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </span>
              </span>
              <span>R$ <%= projPagamentosMes.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></span>
            </div>
          </div>
        </div>
      </div>

      <!-- Lucro Projetado do Mês -->
      <div class="mt-8 bg-gray-50 p-4 rounded-xl border border-gray-100 text-center">
        <p class="text-xs font-bold text-gray-400 uppercase tracking-wider font-mono">Projeção de lucro líquido até o final do mês</p>
        <p class="text-2xl md:text-3xl font-black mt-2 tracking-tight <%= projLucroLiquidoMes >= 0 ? 'text-emerald-600' : 'text-rose-600' %>">
          <%= projLucroLiquidoMes < 0 ? '-' : '' %>R$ <%= Math.abs(projLucroLiquidoMes).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
        </p>
      </div>
    </div>

    <!-- Bloco Direito: Projeção para os Próximos Dias (Gráfico Interativo) -->
    <div class="lg:col-span-8 bg-white p-6 rounded-2xl border border-brand-softBg custom-shadow min-h-[360px] flex flex-col justify-between">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-gray-100 pb-3 mb-4">
        <div class="flex items-center gap-3">
          <h2 class="text-base font-bold text-gray-800 tracking-tight flex items-center gap-1.5">
            <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941"/>
            </svg>
            Projeção para os próximos dias
          </h2>
          <a href="/admin/financeiro/dre#analise-grafica-plano-contas" class="hidden sm:flex px-2.5 py-1 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200 text-[10px] font-bold font-mono transition-all items-center gap-1" title="Ir para Análise Gráfica por Plano de Contas">
            <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"/></svg>
            Análise Gráfica por Plano de Contas →
          </a>
        </div>
        <!-- Controles de Dias -->
        <div class="flex bg-gray-100 p-1 rounded-xl border border-gray-200 text-xs font-mono font-bold">
          <a href="/admin/financeiro/dashboard?days=15" class="px-3 py-1.5 rounded-lg transition-colors <%= projectionDays === 15 ? 'bg-white text-gray-800 shadow-sm' : 'text-gray-500 hover:text-gray-800' %>">15 dias</a>
          <a href="/admin/financeiro/dashboard?days=30" class="px-3 py-1.5 rounded-lg transition-colors <%= projectionDays === 30 ? 'bg-white text-gray-800 shadow-sm' : 'text-gray-500 hover:text-gray-800' %>">30 dias</a>
          <a href="/admin/financeiro/dashboard?days=60" class="px-3 py-1.5 rounded-lg transition-colors <%= projectionDays === 60 ? 'bg-white text-gray-800 shadow-sm' : 'text-gray-500 hover:text-gray-800' %>">60 dias</a>
        </div>
      </div>

      <!-- Container do Gráfico SVG responsivo -->
      <div class="flex-1 min-h-[220px] relative w-full" id="chart-container">
        <!-- SVG será gerado via script do lado do cliente para garantir responsividade perfeita -->
        <svg id="projection-chart" class="w-full h-full absolute inset-0"></svg>
      </div>

      <!-- Legendas do Gráfico -->
      <div class="flex flex-wrap items-center justify-center gap-6 mt-4 pt-3 border-t border-gray-50 text-[10px] font-mono font-bold text-gray-600">
        <div class="flex items-center gap-1.5">
          <span class="w-3 h-1 bg-sky-500 rounded-full inline-block"></span>
          <span>Saldo Projetado (Acumulado)</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="w-3 h-3 bg-emerald-400 rounded inline-block opacity-40"></span>
          <span>Contas a receber (por dia)</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="w-3 h-3 bg-rose-400 rounded inline-block opacity-40"></span>
          <span>Contas a pagar (por dia)</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Linha Inferior: Tabelas de Inadimplência e Detalhamentos empilhadas verticalmente -->
  <div class="grid grid-cols-1 gap-6">
    <!-- PRIMEIRO: Fornecedores (Contas a Pagar) -->
    <div class="bg-white rounded-2xl border border-brand-softBg custom-shadow overflow-hidden">
      <!-- Header do Painel -->
      <div class="bg-gray-50 border-b border-gray-100 p-4 flex items-center justify-between">
        <div>
          <h3 class="text-xs font-bold font-mono uppercase tracking-wider text-rose-700 flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-rose-500"></span>
            Visão por Fornecedores (Contas a Pagar)
          </h3>
          <p class="text-[10px] text-gray-500 mt-1 italic font-sans">Todas as contas a pagar pendentes que ainda não foram pagas</p>
        </div>
