                        <button type="button" onclick="openBaixaModal('<%= t.id %>', '<%= t.provider.replace(/\'/g, '\\\'') %>', <%= t.amount %>, '<%= t.bank || '' %>', '<%= t.type %>')" class="p-1.5 text-white bg-emerald-500 hover:bg-emerald-600 rounded-lg transition-colors cursor-pointer flex items-center justify-center shadow-sm" title="Dar baixa / Pagar">
                          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
