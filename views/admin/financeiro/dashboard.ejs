<!-- Passar dados de projeção do EJS para o JS do lado do cliente -->
<script>
  window.projectionData = <%- JSON.stringify(projDaysData) %>;
</script>

<script>
  // --- RENDERIZADOR DO GRÁFICO SVG RESPONSIVO ---
  function renderProjectionChart() {
    const svg = document.getElementById('projection-chart');
    const container = document.getElementById('chart-container');
    if (!svg || !container) return;

    // Limpar SVG
    svg.innerHTML = '';

    const width = container.clientWidth;
    const height = container.clientHeight;

    if (width === 0 || height === 0) return;

    const data = window.projectionData || [];
    if (data.length === 0) {
      svg.innerHTML = `<text x="${width/2}" y="${height/2}" text-anchor="middle" class="text-xs font-mono text-gray-400">Sem dados para projeção.</text>`;
      return;
    }

    // Configurar limites e paddings
    const paddingLeft = 60;
    const paddingRight = 40;
    const paddingTop = 20;
    const paddingBottom = 30;

    const chartWidth = width - paddingLeft - paddingRight;
    const chartHeight = height - paddingTop - paddingBottom;

    // Encontrar mínimos e máximos para escalas
    const saldos = data.map(d => d.saldo);
    const receberes = data.map(d => d.receber);
    const pagares = data.map(d => d.pagar);

    let minSaldo = Math.min(...saldos);
    let maxSaldo = Math.max(...saldos);
    
    const maxBarValue = Math.max(...receberes, ...pagares);

    // Ajustar escalas para ter margem de respiro
    if (minSaldo === maxSaldo) {
      minSaldo -= 1000;
      maxSaldo += 1000;
    } else {
      const range = maxSaldo - minSaldo;
      minSaldo -= range * 0.15;
      maxSaldo += range * 0.15;
    }

    // Funções de escala
    function getX(index) {
      return paddingLeft + (index / (data.length - 1)) * chartWidth;
    }

    function getY(val) {
      return paddingTop + chartHeight - ((val - minSaldo) / (maxSaldo - minSaldo)) * chartHeight;
    }

    // Gerar Defs (Gradiente para área sob a curva de saldo)
    const defs = document.createElementNS("http://www.w3.org/2000/svg", "defs");
    defs.innerHTML = `
      <linearGradient id="saldo-grad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.25"/>
        <stop offset="100%" stop-color="#38bdf8" stop-opacity="0.0"/>
      </linearGradient>
    `;
    svg.appendChild(defs);

    // Desenhar Linhas de Grid Horizontais
    const gridLinesCount = 5;
    for (let i = 0; i < gridLinesCount; i++) {
      const ratio = i / (gridLinesCount - 1);
      const val = minSaldo + ratio * (maxSaldo - minSaldo);
      const y = getY(val);

      const line = document.createElementNS("http://www.w3.org/2000/svg", "line");
      line.setAttribute("x1", paddingLeft);
      line.setAttribute("y1", y);
      line.setAttribute("x2", width - paddingRight);
      line.setAttribute("y2", y);
      line.setAttribute("stroke", "#f1f5f9");
      line.setAttribute("stroke-width", "1");
      svg.appendChild(line);

      // Label do Grid Y (Formatado)
      const text = document.createElementNS("http://www.w3.org/2000/svg", "text");
      text.setAttribute("x", paddingLeft - 10);
      text.setAttribute("y", y + 4);
      text.setAttribute("text-anchor", "end");
      text.setAttribute("fill", "#94a3b8");
      text.setAttribute("style", "font-family: monospace; font-size: 9px; font-weight: bold;");
      text.textContent = val.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL', minimumFractionDigits: 0, maximumFractionDigits: 0 });
      svg.appendChild(text);
    }

    // Desenhar Linhas de Grid Verticais (Eixo X) e Labels a cada X passos
    const step = Math.max(1, Math.floor(data.length / 6));
    data.forEach((d, i) => {
      if (i % step === 0 || i === data.length - 1) {
        const x = getX(i);
        
        // Label X
        const text = document.createElementNS("http://www.w3.org/2000/svg", "text");
        text.setAttribute("x", x);
        text.setAttribute("y", height - 10);
        text.setAttribute("text-anchor", "middle");
        text.setAttribute("fill", "#64748b");
        text.setAttribute("style", "font-family: Inter, sans-serif; font-size: 10px; font-weight: bold;");
        text.textContent = d.date;
        svg.appendChild(text);
      }
    });

    // Desenhar barras de transações diárias (Receber/Pagar)
    const barWidth = Math.max(2, Math.min(10, chartWidth / data.length / 2.5));
    data.forEach((d, i) => {
      const x = getX(i);
      
      // Barra Receber (Verde)
      if (d.receber > 0 && maxBarValue > 0) {
        const barHeight = (d.receber / maxBarValue) * (chartHeight * 0.4); // Max 40% do chart height
        const rect = document.createElementNS("http://www.w3.org/2000/svg", "rect");
        rect.setAttribute("x", x - barWidth - 1);
        rect.setAttribute("y", paddingTop + chartHeight - barHeight);
        rect.setAttribute("width", barWidth);
        rect.setAttribute("height", barHeight);
        rect.setAttribute("fill", "#34d399");
        rect.setAttribute("fill-opacity", "0.4");
        rect.setAttribute("rx", "1");
        svg.appendChild(rect);
      }

      // Barra Pagar (Rosa)
      if (d.pagar > 0 && maxBarValue > 0) {
        const barHeight = (d.pagar / maxBarValue) * (chartHeight * 0.4);
        const rect = document.createElementNS("http://www.w3.org/2000/svg", "rect");
        rect.setAttribute("x", x + 1);
        rect.setAttribute("y", paddingTop + chartHeight - barHeight);
        rect.setAttribute("width", barWidth);
        rect.setAttribute("height", barHeight);
        rect.setAttribute("fill", "#f87171");
        rect.setAttribute("fill-opacity", "0.4");
        rect.setAttribute("rx", "1");
        svg.appendChild(rect);
      }
    });

    // Desenhar a Área sob a curva de Saldo
    let areaPathCoords = `M ${getX(0)} ${paddingTop + chartHeight}`;
    data.forEach((d, i) => {
      areaPathCoords += ` L ${getX(i)} ${getY(d.saldo)}`;
    });
    areaPathCoords += ` L ${getX(data.length - 1)} ${paddingTop + chartHeight} Z`;

    const area = document.createElementNS("http://www.w3.org/2000/svg", "path");
    area.setAttribute("d", areaPathCoords);
    area.setAttribute("fill", "url(#saldo-grad)");
    svg.appendChild(area);

    // Desenhar a Curva de Linha do Saldo
    let linePathCoords = "";
    data.forEach((d, i) => {
      if (i === 0) {
        linePathCoords = `M ${getX(i)} ${getY(d.saldo)}`;
      } else {
        linePathCoords += ` L ${getX(i)} ${getY(d.saldo)}`;
      }
    });

    const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
    path.setAttribute("d", linePathCoords);
    path.setAttribute("fill", "none");
    path.setAttribute("stroke", "#0ea5e9");
    path.setAttribute("stroke-width", "3");
    path.setAttribute("stroke-linecap", "round");
    svg.appendChild(path);

    // Adicionar pequenos círculos nos nós da linha de saldo e comportamentos de dica rápida interativa
    data.forEach((d, i) => {
      const cx = getX(i);
      const cy = getY(d.saldo);

      // Círculo decorativo
      const circle = document.createElementNS("http://www.w3.org/2000/svg", "circle");
      circle.setAttribute("cx", cx);
      circle.setAttribute("cy", cy);
      circle.setAttribute("r", "3.5");
      circle.setAttribute("fill", "#ffffff");
      circle.setAttribute("stroke", "#0ea5e9");
      circle.setAttribute("stroke-width", "2");
      circle.style.cursor = "pointer";

      // Adicionar elemento de título para tooltip nativo super leve
      const title = document.createElementNS("http://www.w3.org/2000/svg", "title");
      title.textContent = `${d.date}\nSaldo Projetado: ${d.saldo.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' })}\nReceber no dia: ${d.receber.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' })}\nPagar no dia: ${d.pagar.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' })}`;
      circle.appendChild(title);

      svg.appendChild(circle);
    });
  }

  // Chamar renderizador ao carregar e ao redimensionar tela
  window.addEventListener('load', () => {
    renderProjectionChart();
    loadComparativoData();
  });
  window.addEventListener('resize', renderProjectionChart);
  
  // Garantir redimensionamento suave
  const chartResizeObserver = new ResizeObserver(() => {
    renderProjectionChart();
  });
  const containerEl = document.getElementById('chart-container');
  if (containerEl) {
    chartResizeObserver.observe(containerEl);
  }

  // Funções para controle de Competência
  function changeCompetence(val) {
    const url = new URL(window.location.href);
    url.searchParams.set('competence', val);
    window.location.href = url.toString();
  }
  
  function navigateCompetence(direction) {
    const select = document.getElementById('competence-select');
    if (!select) return;
    const currentIndex = select.selectedIndex;
    // Ordem é decrescente (mais recente primeiro), então navegar para mês anterior (-1 na direção temporal) significa aumentar o index no select (+1 index)
    // Direção -1 (mês anterior): incrementa index
    // Direção 1 (mês posterior): decrementa index
    let nextIndex = currentIndex + (direction * -1);
    if (nextIndex >= 0 && nextIndex < select.options.length) {
      changeCompetence(select.options[nextIndex].value);
    }
  }

  // Controladores do Modal de Baixa
  function openBaixaModal(id, provider, amount, bank, type) {
    document.getElementById('baixa-id').value = id;
    document.getElementById('baixa-provider').textContent = provider;
    
    // Formatar valor para BRL
    const formattedAmount = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(amount);
    document.getElementById('baixa-amount').textContent = (type === 'pagar' ? '-' : '+') + ' ' + formattedAmount;
    
    // Configurar banco pré-selecionado ou padrão
    const bankSelect = document.getElementById('baixa-bank');
    if (bank && bank.trim() !== '') {
      bankSelect.value = bank;
    } else {
      bankSelect.selectedIndex = 0; // Primeiro banco cadastrado
    }

    // Set data de pagamento para hoje
    const today = new Date().toISOString().split('T')[0];
    document.getElementById('baixa-paidAt').value = today;

    // Customizar título e botão com base no tipo
    const titleEl = document.getElementById('baixa-title');
    const descEl = document.getElementById('baixa-desc');
    const btnConfirm = document.getElementById('baixa-btn-confirm');
    
    if (type === 'pagar') {
      titleEl.textContent = 'Dar Baixa / Pagar Conta';
      descEl.textContent = 'Confirme o pagamento da despesa para registrar a saída no caixa.';
      btnConfirm.className = 'px-5 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-extrabold text-xs transition-colors shadow-sm uppercase font-mono cursor-pointer';
      btnConfirm.textContent = 'Confirmar Pagamento';
    } else {
      titleEl.textContent = 'Dar Baixa / Receber Conta';
      descEl.textContent = 'Confirme o recebimento do faturamento para registrar a entrada no caixa.';
      btnConfirm.className = 'px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-xs transition-colors shadow-sm uppercase font-mono cursor-pointer';
      btnConfirm.textContent = 'Confirmar Recebimento';
    }

    document.getElementById('baixa-modal').classList.remove('hidden');
  }

  function closeBaixaModal() {
    document.getElementById('baixa-modal').classList.add('hidden');
  }
</script>

<!-- ================= MODAL DE BAIXA FINANCEIRA ================= -->
<div id="baixa-modal" class="hidden fixed inset-0 z-50 bg-black/50 backdrop-blur-sm flex items-center justify-center p-4">
  <div class="bg-white rounded-3xl w-full max-w-md shadow-2xl overflow-hidden fade-in relative border border-gray-100 p-6">
    <div class="flex items-center justify-between border-b border-gray-100 pb-4 mb-4">
      <div>
        <h3 id="baixa-title" class="text-lg font-black text-brand-neutralDark">Dar Baixa no Lançamento</h3>
        <p id="baixa-desc" class="text-xs text-gray-400 mt-0.5">Confirme as informações para registrar o pagamento/recebimento.</p>
      </div>
      <button type="button" onclick="closeBaixaModal()" class="text-gray-400 hover:text-gray-600 p-1.5 hover:bg-gray-100 rounded-lg transition-colors cursor-pointer">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <form action="/admin/financeiro/status" method="POST" class="space-y-4">
      <input type="hidden" name="id" id="baixa-id">
      <input type="hidden" name="status" value="pago">

      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase font-mono mb-1">Fornecedor / Cliente</label>
        <div id="baixa-provider" class="text-xs font-bold text-gray-800 bg-gray-50 rounded-lg p-2.5 border border-gray-100"></div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase font-mono mb-1">Valor Original</label>
          <div id="baixa-amount" class="text-xs font-mono font-bold text-gray-800 bg-gray-50 rounded-lg p-2.5 border border-gray-100"></div>
        </div>
        <div>
          <label for="baixa-paidAt" class="block text-[10px] font-bold text-gray-400 uppercase font-mono mb-1">Data da Baixa *</label>
          <input type="date" name="paidAt" id="baixa-paidAt" required class="w-full text-xs bg-brand-neutralLight border border-gray-200 rounded-lg p-2.5 focus:outline-none focus:ring-1 focus:ring-brand-dark">
        </div>
      </div>

      <div>
        <label for="baixa-bank" class="block text-[10px] font-bold text-gray-400 uppercase font-mono mb-1">Conta Bancária / Banco *</label>
        <select name="bank" id="baixa-bank" required class="w-full text-xs bg-brand-neutralLight border border-gray-200 rounded-lg p-2.5 focus:outline-none focus:ring-1 focus:ring-brand-dark">
          <% settings.banks.forEach(b => { %>
            <option value="<%= b %>"><%= b %></option>
          <% }) %>
        </select>
      </div>

      <div class="pt-4 border-t border-gray-100 flex items-center justify-end gap-3">
        <button type="button" onclick="closeBaixaModal()" class="px-4 py-2 rounded-xl border border-gray-200 text-gray-500 font-bold text-xs hover:bg-gray-50 transition-colors uppercase font-mono cursor-pointer">
          Cancelar
        </button>
        <button type="submit" id="baixa-btn-confirm" class="px-5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-xs transition-colors shadow-sm uppercase font-mono cursor-pointer">
          Confirmar Baixa
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('../../partials/footer') %>
