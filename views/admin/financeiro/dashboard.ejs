            <div>
              <div class="flex items-center gap-2 mb-2 px-1">
                <span class="w-2 h-2 rounded-full bg-gray-400"></span>
                <h4 class="text-[10px] font-bold uppercase tracking-wider font-mono text-gray-500">Contas Futuras (Semana que vem em diante)</h4>
              </div>
              <table class="w-full text-left border-collapse text-xs font-sans">
                <thead>
                  <tr class="border-b border-gray-100 text-gray-400 uppercase tracking-wider font-bold text-[9px] font-mono">
                    <th class="py-2">Vencimento</th>
                    <th class="py-2">Fornecedor / Descrição</th>
                    <th class="py-2 text-right">Valor</th>
                    <th class="py-2 text-center w-12">Baixar</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-50">
                  <% contasFuturas.forEach(t => { %>
                    <tr class="hover:bg-gray-50">
                      <td class="py-2.5 font-mono text-gray-500">
                        <%= t.dueDate.split('-').reverse().join('/') %>
                      </td>
                      <td class="py-2.5">
                        <p class="font-semibold text-gray-700"><%= t.provider %></p>
                        <p class="text-[10px] text-gray-400 truncate max-w-[150px] sm:max-w-[300px]"><%= t.description || 'S/ Descrição' %></p>
                      </td>
                      <td class="py-2.5 text-right font-mono font-bold text-gray-600">
                        R$ <%= t.amount.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                      </td>
                      <td class="py-2.5 text-center">
                        <button type="button" onclick="openBaixaModal('<%= t.id %>', '<%= t.provider.replace(/\'/g, '\\\'') %>', <%= t.amount %>, '<%= t.bank || '' %>', '<%= t.type %>')" class="p-1.5 text-white bg-emerald-500 hover:bg-emerald-600 rounded-lg transition-colors cursor-pointer flex items-center justify-center shadow-sm" title="Dar baixa / Pagar">
                          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                          </svg>
                        </button>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        <% } %>
      </div>
