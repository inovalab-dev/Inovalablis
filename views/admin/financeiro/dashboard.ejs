          <div class="text-center py-12 text-xs font-mono text-gray-400 font-sans">Nenhum pagamento pendente no momento.</div>
        <% } else { %>
          <%
            // Calcular domingo desta semana
            const parsedToday = new Date(todayStr + 'T12:00:00');
            const dayOfWeek = parsedToday.getDay(); // 0 is Sunday, 1 is Monday...
            const daysToSunday = (7 - dayOfWeek) % 7;
            const sundayDate = new Date(parsedToday);
            sundayDate.setDate(parsedToday.getDate() + daysToSunday);
            const sundayStr = sundayDate.toISOString().split('T')[0];

            // Separar contas pagar
            const contasEstaSemana = contasPagarPendentes.filter(t => t.dueDate <= sundayStr);
            const contasFuturas = contasPagarPendentes.filter(t => t.dueDate > sundayStr);

            const totalEstaSemana = contasEstaSemana.reduce((sum, t) => sum + (parseFloat(t.amount) || 0), 0);
            const totalFuturas = contasFuturas.reduce((sum, t) => sum + (parseFloat(t.amount) || 0), 0);
