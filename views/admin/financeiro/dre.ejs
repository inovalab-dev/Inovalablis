<%- include('../../partials/header') %>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="flex-1 p-4 md:p-6 space-y-4 max-w-full overflow-hidden">
  <!-- Cabeçalho Principal -->
  <div class="flex flex-col xl:flex-row xl:items-center xl:justify-between gap-4 bg-white p-5 rounded-2xl border border-gray-200/80 shadow-sm">
    <div class="space-y-1">
      <div class="flex items-center gap-2 text-xs font-bold text-emerald-800 uppercase tracking-widest font-mono">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
        Contabilidade e Finanças
      </div>
      <h1 class="text-2xl md:text-3xl font-extrabold text-gray-900 tracking-tight">Demonstrativo de Resultado</h1>
      <p class="text-xs md:text-sm text-gray-500">DRE do Exercício integrado com o plano de contas e agrupado por categorias de despesa e receita.</p>
    </div>
    
    <div class="flex flex-wrap items-center gap-2">
      <a href="#analise-grafica-plano-contas" onclick="scrollToChart(event)" class="px-3.5 py-2 rounded-xl bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200 font-bold text-xs flex items-center gap-1.5 transition-all shadow-sm">
        <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"/></svg>
        Análise Gráfica
      </a>
      <button onclick="expandAll()" class="px-3.5 py-2 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold text-xs flex items-center gap-1.5 transition-all cursor-pointer">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
        Expandir Tudo
      </button>
      <button onclick="collapseAll()" class="px-3.5 py-2 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold text-xs flex items-center gap-1.5 transition-all cursor-pointer">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/></svg>
        Recolher Tudo
      </button>
      <button onclick="window.print()" class="px-3.5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs flex items-center gap-1.5 transition-all shadow-sm cursor-pointer">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
        Imprimir
      </button>
      <button onclick="exportToExcel()" class="px-3.5 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs flex items-center gap-1.5 transition-all shadow-sm cursor-pointer">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10.5v6m3-3H9m4.06-7.19l-2.12-2.12a1.5 1.5 0 00-1.061-.44H4.5A2.25 2.25 0 002.25 6v12a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9a2.25 2.25 0 00-2.25-2.25h-5.379a1.5 1.5 0 01-1.06-.44z"/></svg>
        Exportar CSV
      </button>
    </div>
  </div>

  <!-- Sub-Navegação Unificada -->
  <div class="flex border-b border-gray-200 overflow-x-auto whitespace-nowrap bg-white px-4 py-2 rounded-xl border border-gray-100 scrollbar-none shadow-sm mb-6">
    <a href="/admin/financeiro/dashboard" class="px-3 py-2 font-bold text-[11px] uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-dashboard') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-emerald-800 hover:border-gray-300' %> transition-all flex items-center gap-1.5">
      Dashboard
    </a>
    <a href="/admin/financeiro/relatorio-faturamento" class="px-3 py-2 font-bold text-[11px] uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-relatorio-faturamento') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-emerald-800 hover:border-gray-300' %> transition-all flex items-center gap-1.5">
      Relatório de Faturamento
    </a>
    <a href="/admin/financeiro/pessoas" class="px-3 py-2 font-bold text-[11px] uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-pessoas') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-emerald-800 hover:border-gray-300' %> transition-all flex items-center gap-1.5">
      Clientes / Fornecedores
    </a>
    <a href="/admin/financeiro/contas-pagar" class="px-3 py-2 font-bold text-[11px] uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-contas-pagar') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-emerald-800 hover:border-gray-300' %> transition-all flex items-center gap-1.5">
      Contas a Pagar
    </a>
    <a href="/admin/financeiro/contas-receber" class="px-3 py-2 font-bold text-[11px] uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-contas-receber') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-emerald-800 hover:border-gray-300' %> transition-all flex items-center gap-1.5">
      Contas a Receber
    </a>
    <a href="/admin/financeiro/fechamento-caixa" class="px-3 py-2 font-bold text-[11px] uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && (page === 'admin-financeiro-fechamento-caixa' || page === 'admin-fechamento-caixa')) ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-emerald-800 hover:border-gray-300' %> transition-all flex items-center gap-1.5">
      Fechamento de Caixa
    </a>
    <a href="/admin/financeiro/fluxo-caixa" class="px-3 py-2 font-bold text-[11px] uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-fluxo-caixa') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-emerald-800 hover:border-gray-300' %> transition-all flex items-center gap-1.5">
      Fluxo de Caixa
    </a>
    <a href="/admin/financeiro/dre" class="px-3 py-2 font-bold text-[11px] uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-dre') ? 'border-emerald-600 text-emerald-800' : 'border-emerald-600 text-emerald-800' %> transition-all flex items-center gap-1.5">
      DRE - Resultado
    </a>
    <a href="/admin/financeiro/movimentacoes" class="px-3 py-2 font-bold text-[11px] uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-movimentacoes') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-emerald-800 hover:border-gray-300' %> transition-all flex items-center gap-1.5">
      Movimentações
    </a>
    <a href="/admin/financeiro/configuracoes" class="px-3 py-2 font-bold text-[11px] uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-configuracoes') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-emerald-800 hover:border-gray-300' %> transition-all flex items-center gap-1.5">
      Configurações
    </a>
  </div>

  <!-- Filtros Principais -->
  <div class="bg-gray-50/50 border border-gray-200/80 p-4 rounded-2xl shadow-sm">
    <form method="GET" action="/admin/financeiro/dre" class="flex flex-col sm:flex-row items-end gap-3">
      <!-- Ano -->
      <div class="flex flex-col gap-1 w-full sm:w-36">
        <label for="year-select" class="text-[9px] font-bold text-gray-400 uppercase tracking-widest font-mono">Exercício</label>
        <select id="year-select" name="year" class="w-full text-xs font-mono font-bold bg-white border border-gray-300 rounded-lg px-2.5 py-2 focus:outline-none focus:ring-1 focus:ring-emerald-500 text-gray-700 shadow-sm">
          <% availableYears.forEach(y => { %>
            <option value="<%= y %>" <%= selectedYear === y ? 'selected' : '' %>><%= y %></option>
          <% }) %>
        </select>
      </div>

      <!-- Mês / Período -->
      <div class="flex flex-col gap-1 w-full sm:w-44">
        <label for="month-select" class="text-[9px] font-bold text-gray-400 uppercase tracking-widest font-mono">Período / Mês</label>
        <select id="month-select" name="month" class="w-full text-xs font-mono font-bold bg-white border border-gray-300 rounded-lg px-2.5 py-2 focus:outline-none focus:ring-1 focus:ring-emerald-500 text-gray-700 shadow-sm">
          <option value="all" <%= (typeof selectedMonth === 'undefined' || selectedMonth === 'all') ? 'selected' : '' %>>Todos os Meses (Anual)</option>
          <option value="01" <%= (typeof selectedMonth !== 'undefined' && selectedMonth === '01') ? 'selected' : '' %>>01 - Janeiro</option>
          <option value="02" <%= (typeof selectedMonth !== 'undefined' && selectedMonth === '02') ? 'selected' : '' %>>02 - Fevereiro</option>
          <option value="03" <%= (typeof selectedMonth !== 'undefined' && selectedMonth === '03') ? 'selected' : '' %>>03 - Março</option>
          <option value="04" <%= (typeof selectedMonth !== 'undefined' && selectedMonth === '04') ? 'selected' : '' %>>04 - Abril</option>
          <option value="05" <%= (typeof selectedMonth !== 'undefined' && selectedMonth === '05') ? 'selected' : '' %>>05 - Maio</option>
          <option value="06" <%= (typeof selectedMonth !== 'undefined' && selectedMonth === '06') ? 'selected' : '' %>>06 - Junho</option>
          <option value="07" <%= (typeof selectedMonth !== 'undefined' && selectedMonth === '07') ? 'selected' : '' %>>07 - Julho</option>
          <option value="08" <%= (typeof selectedMonth !== 'undefined' && selectedMonth === '08') ? 'selected' : '' %>>08 - Agosto</option>
          <option value="09" <%= (typeof selectedMonth !== 'undefined' && selectedMonth === '09') ? 'selected' : '' %>>09 - Setembro</option>
          <option value="10" <%= (typeof selectedMonth !== 'undefined' && selectedMonth === '10') ? 'selected' : '' %>>10 - Outubro</option>
          <option value="11" <%= (typeof selectedMonth !== 'undefined' && selectedMonth === '11') ? 'selected' : '' %>>11 - Novembro</option>
          <option value="12" <%= (typeof selectedMonth !== 'undefined' && selectedMonth === '12') ? 'selected' : '' %>>12 - Dezembro</option>
        </select>
      </div>

      <!-- Filial -->
      <div class="flex flex-col gap-1 w-full sm:w-56">
        <label for="filial-select" class="text-[9px] font-bold text-gray-400 uppercase tracking-widest font-mono">Unidade / Filial</label>
        <select id="filial-select" name="filial" class="w-full text-xs bg-white border border-gray-300 rounded-lg px-2.5 py-2 focus:outline-none focus:ring-1 focus:ring-emerald-500 text-gray-700 shadow-sm">
          <option value="Laboratório Inovalab" <%= selectedFilial === 'Laboratório Inovalab' ? 'selected' : '' %>>Laboratório Inovalab</option>
          <option value="Todas" <%= selectedFilial === 'Todas' ? 'selected' : '' %>>Todas as Unidades</option>
        </select>
      </div>

      <!-- Botão Filtrar -->
      <button type="submit" class="w-full sm:w-auto px-5 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs uppercase tracking-wider font-mono transition-all cursor-pointer shadow-sm hover:shadow">
        Filtrar
      </button>
    </form>
  </div>

  <!-- SEÇÃO DE GRÁFICOS DO DRE COM BASE NO PLANO DE CONTAS -->
  <div id="analise-grafica-plano-contas" class="bg-white rounded-2xl border border-gray-200 shadow-sm p-5 space-y-5 scroll-mt-6">
    <!-- Cabeçalho do Gráfico e Controles -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 border-b border-gray-100 pb-4">
      <div>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"/></svg>
          <h2 class="text-lg font-bold text-gray-900">Análise Gráfica por Plano de Contas</h2>
        </div>
        <p class="text-xs text-gray-500 mt-0.5">Visualização dinâmica do resultado e distribuição das contas contábeis do exercício <%= selectedYear %></p>
      </div>

      <!-- Abas de Modo do Gráfico -->
      <div class="flex items-center gap-1.5 bg-gray-100/80 p-1 rounded-xl border border-gray-200/60 overflow-x-auto">
        <button type="button" onclick="switchChartTab('overview')" id="btn-chart-overview" class="px-3 py-1.5 rounded-lg text-xs font-bold transition-all bg-white text-emerald-900 shadow-sm cursor-pointer whitespace-nowrap">
          Visão Geral DRE
        </button>
        <button type="button" onclick="switchChartTab('distribution')" id="btn-chart-distribution" class="px-3 py-1.5 rounded-lg text-xs font-bold transition-all text-gray-600 hover:text-gray-900 hover:bg-white/50 cursor-pointer whitespace-nowrap">
          Composição por Plano de Contas
        </button>
        <button type="button" onclick="switchChartTab('evolution')" id="btn-chart-evolution" class="px-3 py-1.5 rounded-lg text-xs font-bold transition-all text-gray-600 hover:text-gray-900 hover:bg-white/50 cursor-pointer whitespace-nowrap">
          Evolução por Conta
        </button>
      </div>
    </div>

    <!-- Toolbar de Filtros do Gráfico -->
    <div class="flex flex-wrap items-center justify-between gap-3 bg-gray-50/70 p-3 rounded-xl border border-gray-200/60 text-xs">
      <!-- Filtro de Grupo de Contas (para Distribuição) -->
      <div id="group-filter-container" class="flex items-center gap-2">
        <span class="font-bold text-gray-600 font-mono text-[10px] uppercase tracking-wider">Grupo:</span>
        <select id="chart-group-select" onchange="renderActiveChart()" class="bg-white border border-gray-300 rounded-lg px-2.5 py-1.5 text-xs font-medium focus:outline-none focus:ring-1 focus:ring-emerald-500 text-gray-800 shadow-sm">
          <option value="despesas" selected>Todas as Despesas / Custos</option>
          <option value="receitas">Apenas Receitas</option>
          <option value="todas">Todas as Contas do Plano</option>
        </select>
      </div>

      <!-- Filtro de Conta Específica (para Evolução) -->
      <div id="account-filter-container" class="flex items-center gap-2 hidden">
        <span class="font-bold text-gray-600 font-mono text-[10px] uppercase tracking-wider">Conta do Plano:</span>
        <select id="chart-account-select" onchange="renderActiveChart()" class="bg-white border border-gray-300 rounded-lg px-2.5 py-1.5 text-xs font-medium focus:outline-none focus:ring-1 focus:ring-emerald-500 text-gray-800 shadow-sm max-w-xs sm:max-w-md truncate">
          <option value="all">Principais Contas de Destaque</option>
          <% (planoContasSummary || []).forEach(item => { %>
            <option value="<%= item.account %>"><%= item.account %> (<%= item.sectionTitle %>)</option>
          <% }) %>
        </select>
      </div>

      <!-- Resumo Rápido em Chips -->
      <div class="flex items-center gap-2 ml-auto text-[11px] font-mono">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-100/70 text-emerald-800 font-bold border border-emerald-200/80">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          Receitas: R$ <%= (annualTotals.receitas || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
        </span>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-rose-100/70 text-rose-800 font-bold border border-rose-200/80">
          <span class="w-2 h-2 rounded-full bg-rose-500"></span>
          Custos Totais: R$ <%= ((annualTotals.custosVariaveis || 0) + (annualTotals.custosFixos || 0) + (annualTotals.deducoes || 0)).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
        </span>
      </div>
    </div>

    <!-- Canvas do Gráfico -->
    <div class="relative w-full h-[320px] md:h-[360px]">
      <canvas id="dreChartCanvas"></canvas>
    </div>

    <!-- Cards de Destaque do Plano de Contas -->
    <%
      // Calcular maior receita e maior custo do plano de contas
      let topReceitaAcc = null;
      let topCustoAcc = null;
      (planoContasSummary || []).forEach(item => {
        if (item.isCredit) {
          if (!topReceitaAcc || item.total > topReceitaAcc.total) topReceitaAcc = item;
        } else {
          if (!topCustoAcc || item.total > topCustoAcc.total) topCustoAcc = item;
        }
      });
      const totalCustosAnnual = (annualTotals.custosVariaveis || 0) + (annualTotals.custosFixos || 0) + (annualTotals.deducoes || 0);
    %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 pt-2">
      <div class="bg-emerald-50/50 border border-emerald-200/70 rounded-xl p-3.5 space-y-1">
        <div class="text-[10px] font-bold text-emerald-800 uppercase tracking-widest font-mono">Maior Conta de Receita</div>
        <div class="text-sm font-extrabold text-gray-900 truncate" title="<%= topReceitaAcc ? topReceitaAcc.account : 'N/A' %>">
          <%= topReceitaAcc ? topReceitaAcc.account : 'Sem dados' %>
        </div>
        <div class="text-xs font-mono font-extrabold text-emerald-700 flex items-center justify-between">
          <span>R$ <%= topReceitaAcc ? topReceitaAcc.total.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : '0,00' %></span>
          <span class="text-[10px] font-bold text-emerald-800 bg-emerald-100 px-1.5 py-0.5 rounded">
            <%= (topReceitaAcc && annualTotals.receitas) ? Math.round((topReceitaAcc.total / annualTotals.receitas) * 100) : 0 %>% da Receita
          </span>
        </div>
      </div>

      <div class="bg-rose-50/50 border border-rose-200/70 rounded-xl p-3.5 space-y-1">
        <div class="text-[10px] font-bold text-rose-800 uppercase tracking-widest font-mono">Maior Conta de Custo / Despesa</div>
        <div class="text-sm font-extrabold text-gray-900 truncate" title="<%= topCustoAcc ? topCustoAcc.account : 'N/A' %>">
          <%= topCustoAcc ? topCustoAcc.account : 'Sem dados' %>
        </div>
        <div class="text-xs font-mono font-extrabold text-rose-700 flex items-center justify-between">
          <span>R$ <%= topCustoAcc ? topCustoAcc.total.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : '0,00' %></span>
          <span class="text-[10px] font-bold text-rose-800 bg-rose-100 px-1.5 py-0.5 rounded">
            <%= (topCustoAcc && totalCustosAnnual) ? Math.round((topCustoAcc.total / totalCustosAnnual) * 100) : 0 %>% dos Custos
          </span>
        </div>
      </div>

      <div class="bg-indigo-50/50 border border-indigo-200/70 rounded-xl p-3.5 space-y-1">
        <div class="text-[10px] font-bold text-indigo-800 uppercase tracking-widest font-mono">Margem de Contribuição</div>
        <div class="text-sm font-extrabold text-gray-900">
          R$ <%= (annualTotals.margemContribuicao || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
        </div>
        <div class="text-xs font-mono font-bold text-indigo-700">
          <%= Math.round(annualTotals.percentMargemContribuicao || 0) %>% da Receita Líquida
        </div>
      </div>

      <div class="<%= (annualTotals.resultadoLiquido >= 0) ? 'bg-emerald-50/70 border-emerald-300' : 'bg-rose-50/70 border-rose-300' %> border rounded-xl p-3.5 space-y-1">
        <div class="text-[10px] font-bold <%= (annualTotals.resultadoLiquido >= 0) ? 'text-emerald-800' : 'text-rose-800' %> uppercase tracking-widest font-mono">Resultado Líquido do Exercício</div>
        <div class="text-sm font-extrabold <%= (annualTotals.resultadoLiquido >= 0) ? 'text-emerald-900' : 'text-rose-900' %>">
          R$ <%= (annualTotals.resultadoLiquido || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
        </div>
        <div class="text-xs font-mono font-bold <%= (annualTotals.resultadoLiquido >= 0) ? 'text-emerald-700' : 'text-rose-700' %>">
          Status: <%= (annualTotals.resultadoLiquido >= 0) ? ' Lucro Operacional' : ' Prejuízo Operacional' %>
        </div>
      </div>
    </div>
  </div>

  <!-- Tabela DRE Dinâmica -->
  <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs font-sans min-w-[1250px]" id="dre-table">
        <thead>
          <tr class="bg-gray-50 border-b border-gray-200 text-gray-500 uppercase tracking-wider font-mono font-bold text-[9px]">
            <th class="py-3 px-4 w-72 sticky left-0 bg-gray-50 z-20 border-r border-gray-200 shadow-[2px_0_5px_rgba(0,0,0,0.02)]">Descrição da Conta</th>
            <th class="py-3 px-1.5 text-right w-20">Jan</th>
            <th class="py-3 px-1.5 text-right w-20">Fev</th>
            <th class="py-3 px-1.5 text-right w-20">Mar</th>
            <th class="py-3 px-1.5 text-right w-20">Abr</th>
            <th class="py-3 px-1.5 text-right w-20">Mai</th>
            <th class="py-3 px-1.5 text-right w-20">Jun</th>
            <th class="py-3 px-1.5 text-right w-20">Jul</th>
            <th class="py-3 px-1.5 text-right w-20">Ago</th>
            <th class="py-3 px-1.5 text-right w-20">Set</th>
            <th class="py-3 px-1.5 text-right w-20">Out</th>
            <th class="py-3 px-1.5 text-right w-20">Nov</th>
            <th class="py-3 px-1.5 text-right w-20">Dez</th>
            <th class="py-3 px-3.5 text-right font-bold bg-gray-100/70 border-l border-gray-200 w-28"><%= (typeof selectedMonth !== 'undefined' && selectedMonth !== 'all') ? 'Total Período' : 'Anual' %></th>
            <th class="py-3 px-2 text-center font-bold bg-gray-100/70 border-l border-gray-200 w-16">AV%</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 font-mono text-[11px] text-gray-700">
          <%
            // Helpers de formatação
            const fM = (val, isPositive = true, isSubtotal = false) => {
              if (val === undefined || val === null || val === 0) {
                return `<span class="text-gray-300">-</span>`;
              }
              const formatted = Math.abs(val).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
              if (isSubtotal) {
                if (val < 0 || !isPositive) {
                  return `<span class="font-extrabold text-rose-600">-${formatted}</span>`;
                }
                return `<span class="font-extrabold text-gray-900">${formatted}</span>`;
              }
              if (val < 0 || !isPositive) {
                return `<span class="text-rose-600 font-medium">-${formatted}</span>`;
              }
              return `<span class="text-emerald-700 font-medium">${formatted}</span>`;
            };

            const fAV = (val) => {
              if (!annualTotals.receitas || annualTotals.receitas === 0) return `<span class="text-gray-300">0%</span>`;
              const pct = (val / annualTotals.receitas) * 100;
              return `<span class="text-gray-600 font-bold">${pct.toFixed(1)}%</span>`;
            };

            // Função para renderizar uma seção inteira com suas categorias e contas dinâmicas
            const renderSection = (sectionId, sectionTitle, isCredit) => {
              const sec = dreData.sections.find(s => s.id === sectionId);
              if (!sec) return;

              // Determina as cores da seção
              const headerClass = isCredit ? "bg-emerald-50/40 text-emerald-800" : "bg-rose-50/35 text-rose-800";
              const titleClass = isCredit ? "text-emerald-800 font-bold" : "text-rose-800 font-bold";
              const stickyBg = isCredit ? "bg-emerald-50/90" : "bg-rose-50/90";

              // Calcular totais da seção de forma dinâmica para cada mês
              const secMonthlyTotals = Array(12).fill(0);
              sec.categories.forEach(cat => {
                for (let i = 0; i < 12; i++) {
                  secMonthlyTotals[i] += cat.total[i];
                }
              });
              const secAnnualTotal = secMonthlyTotals.reduce((a, b) => a + b, 0);
          %>
              <!-- Linha de Cabeçalho do Grupo de Seção -->
              <tr class="<%= headerClass %> text-xs font-bold border-t border-gray-200">
                <td class="py-2.5 px-4 sticky left-0 <%= stickyBg %> z-10 font-sans border-r border-gray-200 flex items-center justify-between shadow-[2px_0_5px_rgba(0,0,0,0.02)]">
                  <span class="<%= titleClass %>"><%= sectionTitle %></span>
                </td>
                <% secMonthlyTotals.forEach(v => { %>
                  <td class="py-2.5 px-1.5 text-right font-bold"><%- fM(v, isCredit) %></td>
                <% }) %>
                <td class="py-2.5 px-3.5 text-right border-l border-gray-200 font-extrabold text-gray-900 bg-gray-100/50"><%- fM(secAnnualTotal, isCredit) %></td>
                <td class="py-2.5 px-2 text-center border-l border-gray-200 font-extrabold text-gray-800 bg-gray-100/50"><%- fAV(secAnnualTotal) %></td>
              </tr>

              <!-- Iteração das Categorias Dinâmicas -->
              <% sec.categories.forEach(cat => { 
                const catAnnual = cat.total.reduce((a, b) => a + b, 0);
                const hasAccountsList = cat.accountsList && cat.accountsList.length > 0;
                const hasAccountsMap = cat.accounts && Object.keys(cat.accounts).length > 0;
                const hasAccounts = hasAccountsList || hasAccountsMap;
              %>
                <tr class="hover:bg-gray-50/50 transition-colors cursor-pointer group bg-gray-50/20" onclick="toggleCategory('<%= cat.id %>')">
                  <td class="py-2.5 px-4 pl-6 sticky left-0 bg-white z-10 font-sans text-gray-800 font-bold border-r border-gray-200 flex items-center justify-between shadow-[2px_0_5px_rgba(0,0,0,0.02)]">
                    <span class="flex items-center gap-2">
                      <% if (hasAccounts) { %>
                        <svg id="chevron-<%= cat.id %>" class="w-3.5 h-3.5 text-gray-400 transform transition-transform duration-200 rotate-90" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                      <% } else { %>
                        <span class="w-3.5 h-3.5"></span>
                      <% } %>
                      <span class="px-2 py-0.5 rounded text-[10px] font-mono font-black bg-[#284701]/10 text-[#284701] border border-[#284701]/20 shadow-2xs"><%= cat.code || cat.id %></span>
                      <span class="font-extrabold text-gray-900"><%= cat.description %></span>
                    </span>
                  </td>
                  <% cat.total.forEach(v => { %>
                    <td class="py-2.5 px-1.5 text-right font-bold"><%- fM(v, isCredit) %></td>
                  <% }) %>
                  <td class="py-2.5 px-3.5 text-right bg-gray-50/70 border-l border-gray-200 font-extrabold text-gray-900"><%- fM(catAnnual, isCredit) %></td>
                  <td class="py-2.5 px-2 text-center bg-gray-50/70 border-l border-gray-200 font-bold text-gray-700"><%- fAV(catAnnual) %></td>
                </tr>

                <!-- Iteração de Contas vinculadas do Plano de Contas (Filhos da Categoria) -->
                <% if (hasAccounts) { %>
                  <% if (hasAccountsList) { %>
                    <% cat.accountsList.forEach(acc => { 
                      const accAnnual = acc.monthly.reduce((a, b) => a + b, 0);
                    %>
                      <tr class="cat-child-<%= cat.id %> hover:bg-gray-50/40 text-[11px] text-gray-600 bg-white" data-category="<%= cat.id %>">
                        <td class="py-2 px-4 pl-12 sticky left-0 bg-white z-10 font-sans border-r border-gray-200 shadow-[2px_0_5px_rgba(0,0,0,0.02)]">
                          <span class="flex items-center gap-2">
                            <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-slate-100 text-slate-700 border border-slate-200/80"><%= acc.code %></span>
                            <span class="text-gray-700 font-semibold"><%= acc.description %></span>
                          </span>
                        </td>
                        <% acc.monthly.forEach(v => { %>
                          <td class="py-2 px-1.5 text-right text-gray-600 font-mono"><%- fM(v, isCredit) %></td>
                        <% }) %>
                        <td class="py-2 px-3.5 text-right bg-gray-50/30 border-l border-gray-200 text-gray-800 font-bold font-mono"><%- fM(accAnnual, isCredit) %></td>
                        <td class="py-2 px-2 text-center bg-gray-50/30 border-l border-gray-200 text-gray-500 font-mono"><%- fAV(accAnnual) %></td>
                      </tr>
                    <% }) %>
                  <% } else if (hasAccountsMap) { %>
                    <% Object.entries(cat.accounts).forEach(([accName, accMonthlyValues]) => { 
                      const accAnnual = accMonthlyValues.reduce((a, b) => a + b, 0);
                    %>
                      <tr class="cat-child-<%= cat.id %> hover:bg-gray-50/40 text-[11px] text-gray-600 bg-white" data-category="<%= cat.id %>">
                        <td class="py-2 px-4 pl-12 sticky left-0 bg-white z-10 font-sans border-r border-gray-200 shadow-[2px_0_5px_rgba(0,0,0,0.02)] font-semibold text-gray-700">
                          <%= accName %>
                        </td>
                        <% accMonthlyValues.forEach(v => { %>
                          <td class="py-2 px-1.5 text-right text-gray-600 font-mono"><%- fM(v, isCredit) %></td>
                        <% }) %>
                        <td class="py-2 px-3.5 text-right bg-gray-50/30 border-l border-gray-200 text-gray-800 font-bold font-mono"><%- fM(accAnnual, isCredit) %></td>
                        <td class="py-2 px-2 text-center bg-gray-50/30 border-l border-gray-200 text-gray-500 font-mono"><%- fAV(accAnnual) %></td>
                      </tr>
                    <% }) %>
                  <% } %>
                <% } %>
              <% }) %>
          <% }; %>

          <!-- 1. RECEITAS BRUTAS -->
          <% renderSection("receitas", "(+) RECEITA BRUTA", true); %>

          <!-- 2. DEDUÇÕES SOBRE VENDAS -->
          <% renderSection("deducoes", "(-) DEDUÇÕES SOBRE VENDAS", false); %>

          <!-- SUB-TOTAL: (=) RECEITA LÍQUIDA -->
          <tr class="bg-emerald-600/10 text-xs font-black border-t border-b border-emerald-600/30 text-emerald-950">
            <td class="py-3 px-4 sticky left-0 bg-emerald-50/80 z-10 font-sans border-r border-gray-200 shadow-[2px_0_5px_rgba(0,0,0,0.02)] uppercase tracking-wider">
              (=) RECEITA LÍQUIDA
            </td>
            <% totals.receitaLiquida.forEach(v => { %>
              <td class="py-3 px-1.5 text-right font-black"><%- fM(v, true, true) %></td>
            <% }) %>
            <td class="py-3 px-3.5 text-right bg-emerald-100/50 border-l border-gray-300 font-extrabold text-gray-900"><%- fM(annualTotals.receitaLiquida, true, true) %></td>
            <td class="py-3 px-2 text-center bg-emerald-100/50 border-l border-gray-300 font-black"><%- fAV(annualTotals.receitaLiquida) %></td>
          </tr>

          <!-- 3. CUSTOS VARIÁVEIS -->
          <% renderSection("custos_variaveis", "(-) CUSTOS VARIÁVEIS", false); %>

          <!-- SUB-TOTAL: (=) MARGEM DE CONTRIBUIÇÃO -->
          <tr class="bg-blue-600/10 text-xs font-black border-t border-blue-600/30 text-blue-950">
            <td class="py-2.5 px-4 sticky left-0 bg-blue-50/80 z-10 font-sans border-r border-gray-200 shadow-[2px_0_5px_rgba(0,0,0,0.02)] uppercase tracking-wider">
              (=) MARGEM DE CONTRIBUIÇÃO
            </td>
            <% totals.margemContribuicao.forEach(v => { %>
              <td class="py-2.5 px-1.5 text-right font-black"><%- fM(v, true, true) %></td>
            <% }) %>
            <td class="py-2.5 px-3.5 text-right bg-blue-100/50 border-l border-gray-300 font-extrabold text-gray-900"><%- fM(annualTotals.margemContribuicao, true, true) %></td>
            <td class="py-2.5 px-2 text-center bg-blue-100/50 border-l border-gray-300 font-black"><%- fAV(annualTotals.margemContribuicao) %></td>
          </tr>

          <!-- SUB-TOTAL: (=) % MARGEM DE CONTRIBUIÇÃO -->
          <tr class="bg-blue-600/5 text-xs font-bold text-blue-900">
            <td class="py-2 px-4 sticky left-0 bg-blue-50/50 z-10 font-sans border-r border-gray-200 shadow-[2px_0_5px_rgba(0,0,0,0.02)] uppercase tracking-wider">
              (=) % Margem de Contribuição
            </td>
            <% totals.percentMargemContribuicao.forEach(v => { %>
              <td class="py-2 px-1.5 text-right font-bold text-blue-800"><%= Math.round(v) %>%</td>
            <% }) %>
            <td class="py-2 px-3.5 text-right bg-blue-100/20 border-l border-gray-300 font-bold text-blue-900"><%= Math.round(annualTotals.percentMargemContribuicao) %>%</td>
            <td class="py-2 px-2 text-center bg-blue-100/20 border-l border-gray-300 font-extrabold text-blue-900"><%= Math.round(annualTotals.percentMargemContribuicao) %>%</td>
          </tr>

          <!-- 4. CUSTOS FIXOS -->
          <% renderSection("custos_fixos", "(-) CUSTOS FIXOS", false); %>

          <!-- SUB-TOTAL: (=) RESULTADO OPERACIONAL (EBITDA) -->
          <tr class="bg-indigo-600/10 text-xs font-black border-t border-b border-indigo-600/30 text-indigo-950">
            <td class="py-3 px-4 sticky left-0 bg-indigo-50/80 z-10 font-sans border-r border-gray-200 shadow-[2px_0_5px_rgba(0,0,0,0.02)] uppercase tracking-wider">
              (=) RESULTADO OPERACIONAL (EBITDA)
            </td>
            <% totals.resultadoOperacional.forEach(v => { %>
              <td class="py-3 px-1.5 text-right font-black"><%- fM(v, v >= 0, true) %></td>
            <% }) %>
            <td class="py-3 px-3.5 text-right bg-indigo-100/50 border-l border-gray-300 font-extrabold text-gray-900"><%- fM(annualTotals.resultadoOperacional, annualTotals.resultadoOperacional >= 0, true) %></td>
            <td class="py-3 px-2 text-center bg-indigo-100/50 border-l border-gray-300 font-black"><%- fAV(annualTotals.resultadoOperacional) %></td>
          </tr>

          <!-- 5. DESPESAS FINANCEIRAS -->
          <% renderSection("despesas_financeiras", "(-) DESPESAS FINANCEIRAS", false); %>

          <!-- 6. INVESTIMENTOS -->
          <% renderSection("investimentos", "(-) INVESTIMENTOS", false); %>

          <!-- SUB-TOTAL: (=) RESULTADO LÍQUIDO -->
          <tr class="bg-emerald-600 text-white text-xs font-black border-t-2 border-emerald-700">
            <td class="py-3 px-4 sticky left-0 bg-emerald-700 z-10 font-sans border-r border-emerald-800 shadow-[2px_0_5px_rgba(0,0,0,0.05)] uppercase tracking-wider">
              (=) RESULTADO LÍQUIDO DO EXERCÍCIO
            </td>
            <% totals.resultadoLiquido.forEach(v => { %>
              <td class="py-3 px-1.5 text-right font-black text-white"><%= v === 0 ? '-' : v.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
            <% }) %>
            <td class="py-3 px-3.5 text-right bg-emerald-800 border-l border-emerald-900 font-extrabold text-white"><%= annualTotals.resultadoLiquido.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
            <td class="py-3 px-2 text-center bg-emerald-800 border-l border-emerald-900 font-black text-white"><%- fAV(annualTotals.resultadoLiquido) %></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  // Injeção segura dos dados calculados pelo servidor
  const planoContasSummaryData = <%- JSON.stringify(planoContasSummary || []) %>;
  const dreTotalsData = <%- JSON.stringify(totals || {}) %>;
  const annualTotalsData = <%- JSON.stringify(annualTotals || {}) %>;

  let activeChartTab = 'overview';
  let dreChartInstance = null;

  // Função para alternar entre as abas do gráfico
  function switchChartTab(tab) {
    activeChartTab = tab;

    // Atualiza estilo dos botões das abas
    const btnOverview = document.getElementById('btn-chart-overview');
    const btnDistribution = document.getElementById('btn-chart-distribution');
    const btnEvolution = document.getElementById('btn-chart-evolution');
    const groupFilter = document.getElementById('group-filter-container');
    const accountFilter = document.getElementById('account-filter-container');

    [btnOverview, btnDistribution, btnEvolution].forEach(btn => {
      btn.className = "px-3 py-1.5 rounded-lg text-xs font-bold transition-all text-gray-600 hover:text-gray-900 hover:bg-white/50 cursor-pointer whitespace-nowrap";
    });

    if (tab === 'overview') {
      btnOverview.className = "px-3 py-1.5 rounded-lg text-xs font-bold transition-all bg-white text-emerald-900 shadow-sm cursor-pointer whitespace-nowrap";
      groupFilter.classList.remove('hidden');
      accountFilter.classList.add('hidden');
    } else if (tab === 'distribution') {
      btnDistribution.className = "px-3 py-1.5 rounded-lg text-xs font-bold transition-all bg-white text-emerald-900 shadow-sm cursor-pointer whitespace-nowrap";
      groupFilter.classList.remove('hidden');
      accountFilter.classList.add('hidden');
    } else if (tab === 'evolution') {
      btnEvolution.className = "px-3 py-1.5 rounded-lg text-xs font-bold transition-all bg-white text-emerald-900 shadow-sm cursor-pointer whitespace-nowrap";
      groupFilter.classList.add('hidden');
      accountFilter.classList.remove('hidden');
    }

    renderActiveChart();
  }

  // Renderiza o gráfico correspondente ao estado ativo
  function renderActiveChart() {
    const canvas = document.getElementById('dreChartCanvas');
    if (!canvas || typeof Chart === 'undefined') return;

    if (dreChartInstance) {
      dreChartInstance.destroy();
      dreChartInstance = null;
    }

    const ctx = canvas.getContext('2d');
    const months = ['Jan', 'Fev', 'Mar', 'Abr', 'Mai', 'Jun', 'Jul', 'Ago', 'Set', 'Out', 'Nov', 'Dez'];

    if (activeChartTab === 'overview') {
      // 1. VISÃO GERAL DO DRE (Barras + Linha do Resultado Líquido)
      const datasetReceita = dreTotalsData.receitas || Array(12).fill(0);
      const datasetCustosVar = dreTotalsData.custosVariaveis || Array(12).fill(0);
      const datasetCustosFix = dreTotalsData.custosFixos || Array(12).fill(0);
      const datasetResultado = dreTotalsData.resultadoLiquido || Array(12).fill(0);

      dreChartInstance = new Chart(ctx, {
        type: 'bar',
        data: {
          labels: months,
          datasets: [
            {
              type: 'line',
              label: 'Resultado Líquido (R$)',
              data: datasetResultado,
              borderColor: '#10b981',
              backgroundColor: 'rgba(16, 185, 129, 0.15)',
              borderWidth: 3,
              pointBackgroundColor: '#047857',
              pointRadius: 5,
              fill: true,
              tension: 0.3,
              order: 1
            },
            {
              type: 'bar',
              label: 'Receita Bruta',
              data: datasetReceita,
              backgroundColor: 'rgba(34, 197, 94, 0.85)',
              borderRadius: 6,
              order: 2
            },
            {
              type: 'bar',
              label: 'Custos Variáveis',
              data: datasetCustosVar,
              backgroundColor: 'rgba(245, 158, 11, 0.85)',
              borderRadius: 6,
              order: 3
            },
            {
              type: 'bar',
              label: 'Custos Fixos',
              data: datasetCustosFix,
              backgroundColor: 'rgba(239, 68, 68, 0.85)',
              borderRadius: 6,
              order: 4
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              position: 'top',
              labels: { font: { family: 'sans-serif', size: 11, weight: 'bold' } }
            },
            tooltip: {
              callbacks: {
                label: function(context) {
                  const val = context.parsed.y || 0;
                  return context.dataset.label + ': R$ ' + val.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                }
              }
            }
          },
          scales: {
            x: { grid: { display: false } },
            y: {
              beginAtZero: true,
              ticks: {
                callback: function(value) {
                  return 'R$ ' + (value >= 1000 ? (value / 1000).toFixed(0) + 'k' : value);
                }
              }
            }
          }
        }
      });

    } else if (activeChartTab === 'distribution') {
      // 2. COMPOSIÇÃO POR PLANO DE CONTAS (Doughnut / Rosca)
      const groupType = document.getElementById('chart-group-select').value;
      
      let filteredAccounts = planoContasSummaryData.filter(item => item.total > 0);
      if (groupType === 'despesas') {
        filteredAccounts = filteredAccounts.filter(item => !item.isCredit);
      } else if (groupType === 'receitas') {
        filteredAccounts = filteredAccounts.filter(item => item.isCredit);
      }

      // Ordenar do maior para o menor valor
      filteredAccounts.sort((a, b) => b.total - a.total);

      // Pegar top 8 e agrupar o restante
      const topAccounts = filteredAccounts.slice(0, 8);
      const remainingAccounts = filteredAccounts.slice(8);

      let labels = topAccounts.map(a => a.account);
      let dataVals = topAccounts.map(a => a.total);

      if (remainingAccounts.length > 0) {
        const remainingTotal = remainingAccounts.reduce((sum, a) => sum + a.total, 0);
        labels.push('Outras Contas do Plano');
        dataVals.push(remainingTotal);
      }

      const colorPalette = [
        '#10b981', '#3b82f6', '#f59e0b', '#ef4444', '#8b5cf6',
        '#ec4899', '#14b8a6', '#6366f1', '#64748b', '#06b6d4'
      ];

      dreChartInstance = new Chart(ctx, {
        type: 'doughnut',
        data: {
          labels: labels,
          datasets: [{
            data: dataVals,
            backgroundColor: colorPalette.slice(0, labels.length),
            borderWidth: 2,
            borderColor: '#ffffff'
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              position: 'right',
              labels: {
                font: { family: 'sans-serif', size: 10, weight: 'bold' },
                boxWidth: 12
              }
            },
            tooltip: {
              callbacks: {
                label: function(context) {
                  const val = context.parsed || 0;
                  const totalSum = dataVals.reduce((a, b) => a + b, 0);
                  const pct = totalSum > 0 ? ((val / totalSum) * 100).toFixed(1) : 0;
                  return context.label + ': R$ ' + val.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' (' + pct + '%)';
                }
              }
            }
          }
        }
      });

    } else if (activeChartTab === 'evolution') {
      // 3. EVOLUÇÃO TEMPORAL POR CONTA DO PLANO DE CONTAS (Linhas)
      const selectedAccount = document.getElementById('chart-account-select').value;
      
      let datasets = [];
      const colors = ['#10b981', '#3b82f6', '#f59e0b', '#ef4444', '#8b5cf6', '#ec4899', '#14b8a6'];

      if (selectedAccount === 'all') {
        // Mostrar as 5 maiores contas do Plano de Contas
        const sorted = [...planoContasSummaryData].sort((a, b) => b.total - a.total).slice(0, 5);
        datasets = sorted.map((item, idx) => ({
          label: item.account,
          data: item.monthly,
          borderColor: colors[idx % colors.length],
          backgroundColor: colors[idx % colors.length],
          borderWidth: 2.5,
          tension: 0.3,
          pointRadius: 4
        }));
      } else {
        // Mostrar conta individual
        const accItem = planoContasSummaryData.find(a => a.account === selectedAccount);
        if (accItem) {
          datasets = [{
            label: accItem.account,
            data: accItem.monthly,
            borderColor: accItem.isCredit ? '#10b981' : '#f59e0b',
            backgroundColor: accItem.isCredit ? 'rgba(16, 185, 129, 0.15)' : 'rgba(245, 158, 11, 0.15)',
            borderWidth: 3,
            fill: true,
            tension: 0.3,
            pointRadius: 5
          }];
        }
      }

      dreChartInstance = new Chart(ctx, {
        type: 'line',
        data: {
          labels: months,
          datasets: datasets
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              position: 'top',
              labels: { font: { family: 'sans-serif', size: 10, weight: 'bold' } }
            },
            tooltip: {
              callbacks: {
                label: function(context) {
                  const val = context.parsed.y || 0;
                  return context.dataset.label + ': R$ ' + val.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                }
              }
            }
          },
          scales: {
            x: { grid: { display: false } },
            y: {
              beginAtZero: true,
              ticks: {
                callback: function(value) {
                  return 'R$ ' + (value >= 1000 ? (value / 1000).toFixed(0) + 'k' : value);
                }
              }
            }
          }
        }
      });
    }
  }

  // Função para ocultar/mostrar contas filhas de uma categoria
  function toggleCategory(catId) {
    const rows = document.querySelectorAll('.cat-child-' + catId);
    const chevron = document.getElementById('chevron-' + catId);
    if (!rows.length) return;

    const isCollapsed = rows[0].classList.contains('hidden');
    rows.forEach(row => {
      if (isCollapsed) {
        row.classList.remove('hidden');
      } else {
        row.classList.add('hidden');
      }
    });

    if (chevron) {
      if (isCollapsed) {
        chevron.classList.add('rotate-90');
      } else {
        chevron.classList.remove('rotate-90');
      }
    }
  }

  // Expandir todas as categorias
  function expandAll() {
    const chevrons = document.querySelectorAll('[id^="chevron-"]');
    chevrons.forEach(chevron => {
      chevron.classList.add('rotate-90');
      const catId = chevron.id.replace('chevron-', '');
      const rows = document.querySelectorAll('.cat-child-' + catId);
      rows.forEach(r => r.classList.remove('hidden'));
    });
  }

  // Recolher todas as categorias
  function collapseAll() {
    const chevrons = document.querySelectorAll('[id^="chevron-"]');
    chevrons.forEach(chevron => {
      chevron.classList.remove('rotate-90');
      const catId = chevron.id.replace('chevron-', '');
      const rows = document.querySelectorAll('.cat-child-' + catId);
      rows.forEach(r => r.classList.add('hidden'));
    });
  }

  // Exportar tabela para formato CSV/Excel
  function exportToExcel() {
    let table = document.getElementById("dre-table");
    let rows = table.rows;
    let csv = [];
    for (let i = 0; i < rows.length; i++) {
      let row = [], cols = rows[i].querySelectorAll("td, th");
      for (let j = 0; j < cols.length; j++) {
        let text = cols[j].innerText.replace(/\s+/g, " ").trim();
        row.push('"' + text.replace(/"/g, '""') + '"');
      }
      csv.push(row.join(";"));
    }
    let csvContent = "data:text/csv;charset=utf-8,\uFEFF" + csv.join("\n");
    let encodedUri = encodeURI(csvContent);
    let link = document.createElement("a");
    link.setAttribute("href", encodedUri);
    link.setAttribute("download", "Demonstrativo_de_Resultado_" + "<%= selectedYear %>" + ".csv");
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  }

  // Inicializa a página
  document.addEventListener('DOMContentLoaded', () => {
    expandAll();
    renderActiveChart();

    // Rolagem suave se a hash indicar a seção de gráficos
    if (window.location.hash === '#analise-grafica-plano-contas' || window.location.hash === '#analise-grafica') {
      setTimeout(() => {
        const el = document.getElementById('analise-grafica-plano-contas');
        if (el) el.scrollIntoView({ behavior: 'smooth' });
      }, 300);
    }
  });

  function scrollToChart(e) {
    if (e) e.preventDefault();
    const el = document.getElementById('analise-grafica-plano-contas');
    if (el) el.scrollIntoView({ behavior: 'smooth' });
  }
</script>

