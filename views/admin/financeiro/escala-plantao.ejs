        <label class="block text-[9px] font-bold text-gray-400 uppercase tracking-wider font-mono">Aviso 4 (Após as 17h)</label>
        <textarea id="notice-3" oninput="syncNotices()" rows="2" class="w-full p-2 bg-gray-50 border border-gray-200 rounded-xl text-xs font-mono mt-1 focus:ring-2 focus:ring-brand-gold/20 focus:border-brand-gold outline-none"></textarea>
