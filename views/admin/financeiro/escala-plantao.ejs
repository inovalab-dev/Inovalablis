          <input type="text" id="g3-short" oninput="syncGroupDetails(); updateCalendars();" class="w-full px-2 py-1 bg-white border border-gray-200 rounded-lg text-xs font-mono mt-0.5 focus:ring-2 focus:ring-yellow-100 outline-none" placeholder="Ex: Maria G.">
