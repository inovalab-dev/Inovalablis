          <label class="block text-[8px] font-bold text-gray-400 uppercase tracking-wider font-mono">Nome(s)</label>
          <input type="text" id="g3-name" oninput="syncGroupDetails()" class="w-full px-2 py-1 bg-white border border-gray-200 rounded-lg text-xs font-mono mt-0.5 focus:ring-2 focus:ring-yellow-100 outline-none">
