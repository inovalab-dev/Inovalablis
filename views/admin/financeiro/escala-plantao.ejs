    <div class="mt-5 pt-4 border-t border-gray-100 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <div>
        <label class="block text-[9px] font-bold text-gray-400 uppercase tracking-wider font-mono">Aviso 1 (Segunda a Sexta)</label>
        <textarea id="notice-0" oninput="syncNotices()" rows="2" class="w-full p-2 bg-gray-50 border border-gray-200 rounded-xl text-xs font-mono mt-1 focus:ring-2 focus:ring-brand-gold/20 focus:border-brand-gold outline-none"></textarea>
