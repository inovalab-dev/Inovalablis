<%- include('../../partials/header') %>

<div class="p-4 sm:p-6 max-w-7xl mx-auto space-y-6">
  <!-- Cabeçalho Principal -->
  <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-gray-100 shadow-sm no-print">
    <div>
      <div class="flex items-center gap-2">
        <h1 class="text-xl font-black text-brand-dark tracking-tight font-sans">Montador de Escala (Pronto Socorro)</h1>
        <span class="px-2 py-0.5 text-[9px] font-mono font-black uppercase tracking-wider bg-amber-50 text-amber-700 rounded border border-amber-100">Escala de Plantão</span>
      </div>
      <p class="text-xs text-gray-500 mt-1">Gere e configure a escala de plantão mensal para envio ao Pronto Socorro. Formato horizontal otimizado para impressão e PDF.</p>
    </div>
    
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
      <!-- Auto Save Status Indicator -->
      <div id="auto-save-indicator" class="flex items-center gap-2 bg-gray-50 border border-gray-200 px-3 py-1.5 rounded-xl text-[11px] font-mono font-bold shrink-0">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span class="text-emerald-700">Sistema Pronto</span>
      </div>

      <div class="flex items-center gap-2">
        <button onclick="imprimirEscala()" class="px-4 py-2 bg-brand-gold hover:bg-brand-gold/90 text-brand-dark text-xs font-bold font-mono uppercase tracking-wider rounded-xl transition-all shadow-sm flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0110.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0l.229 2.523a1.125 1.125 0 01-1.12 1.227H7.231c-.615 0-1.101-.476-1.12-1.091L5.87 18m11.79 0c.081-.833-.27-1.675-.92-2.224l-.008-.007a4.902 4.902 0 00-6.002 0l-.008.007a2.917 2.917 0 01-1.92.576" /></svg>
          Imprimir / Gerar PDF
        </button>
      </div>
    </div>
  </div>

  <!-- Elementos de controle mantidos ocultos no DOM para compatibilidade com o JS existente -->
  <div class="hidden">
    <select id="escala-year" onchange="updateCalendars()">
      <option value="2025">2025</option>
      <option value="2026" selected>2026</option>
      <option value="2027">2027</option>
      <option value="2028">2028</option>
    </select>
    <select id="escala-month-1" onchange="updateCalendars()">
      <option value="1">Janeiro</option>
      <option value="2">Fevereiro</option>
      <option value="3" selected>Março</option>
      <option value="4">Abril</option>
      <option value="5">Maio</option>
      <option value="6">Junho</option>
      <option value="7">Julho</option>
      <option value="8">Agosto</option>
      <option value="9">Setembro</option>
      <option value="10">Outubro</option>
      <option value="11">Novembro</option>
      <option value="12">Dezembro</option>
    </select>
    <select id="escala-month-2" onchange="updateCalendars()">
      <option value="1">Janeiro</option>
      <option value="2">Fevereiro</option>
      <option value="3">Março</option>
      <option value="4" selected>Abril</option>
      <option value="5">Maio</option>
      <option value="6">Junho</option>
      <option value="7">Julho</option>
      <option value="8">Agosto</option>
      <option value="9">Setembro</option>
      <option value="10">Outubro</option>
      <option value="11">Novembro</option>
      <option value="12">Dezembro</option>
    </select>
  </div>




  <!-- CONTAINER DE VISUALIZAÇÃO E IMPRESSÃO (O MODELO DO PRONTO SOCORRO) -->
  <div id="print-area" class="bg-white rounded-2xl border border-gray-200 shadow-lg p-6 sm:p-8 space-y-6">
    <!-- Cabeçalho de Impressão -->
    <div class="bg-[#224215] text-white py-4 px-6 rounded-xl text-center font-black tracking-wider uppercase font-sans border-2 border-[#b09868]/40 flex flex-col sm:flex-row items-center justify-between gap-4">
      <button onclick="shiftMonths(-1)" class="no-print w-full sm:w-auto px-4 py-2 bg-white/10 hover:bg-white/20 active:bg-white/30 text-white text-xs font-bold font-mono uppercase tracking-wider rounded-xl transition-all flex items-center justify-center gap-1.5 shadow-sm border border-white/10">
        ◀ Voltar Mês
      </button>

      <div class="flex-1 flex flex-col sm:flex-row items-center justify-center gap-3">
        <div class="shrink-0 bg-white/10 p-1.5 rounded-lg border border-white/10 no-print">
          <%- include('../../partials/logo', { layout: 'icon-only', variant: 'dark', height: 'h-8' }) %>
        </div>
        <div class="text-center sm:text-left">
          <h2 class="text-lg sm:text-xl font-black tracking-tight text-white">ESCALA PLANTÃO LABORATÓRIO INOVALAB</h2>
          <span class="text-xs sm:text-sm font-bold font-mono text-[#dfc293] mt-0.5 block" id="print-header-dates">MARÇO / ABRIL - 2026</span>
        </div>
      </div>

      <button onclick="shiftMonths(1)" class="no-print w-full sm:w-auto px-4 py-2 bg-white/10 hover:bg-white/20 active:bg-white/30 text-white text-xs font-bold font-mono uppercase tracking-wider rounded-xl transition-all flex items-center justify-center gap-1.5 shadow-sm border border-white/10">
        Avançar Mês ▶
      </button>
    </div>

    <!-- Calendários Lado a Lado -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
      <!-- Calendário da Esquerda -->
      <div class="space-y-4">
        <div class="text-center font-black text-lg text-brand-dark font-sans uppercase border-b-2 border-brand-dark pb-1" id="calendar-1-title">
          MARÇO
        </div>
        <div class="grid grid-cols-7 gap-1 text-center font-mono text-xs font-bold bg-gray-100 p-2 rounded-lg" id="calendar-1-header">
          <div class="text-rose-600">D</div>
          <div>S</div>
          <div>T</div>
          <div>Q</div>
          <div>Q</div>
          <div>S</div>
          <div class="text-blue-600">S</div>
        </div>
        <!-- Grid de dias -->
        <div class="grid grid-cols-7 gap-1" id="calendar-1-days">
          <!-- Gerado via JS -->
        </div>
      </div>

      <!-- Calendário da Direita -->
      <div class="space-y-4">
        <div class="text-center font-black text-lg text-brand-dark font-sans uppercase border-b-2 border-brand-dark pb-1" id="calendar-2-title">
          ABRIL
        </div>
        <div class="grid grid-cols-7 gap-1 text-center font-mono text-xs font-bold bg-gray-100 p-2 rounded-lg" id="calendar-2-header">
          <div class="text-rose-600">D</div>
          <div>S</div>
          <div>T</div>
          <div>Q</div>
          <div>Q</div>
          <div>S</div>
          <div class="text-blue-600">S</div>
        </div>
        <!-- Grid de dias -->
        <div class="grid grid-cols-7 gap-1" id="calendar-2-days">
          <!-- Gerado via JS -->
        </div>
      </div>
    </div>

    <!-- Configurações Globais da Escala (Pincel & Dicas) abaixo do Calendário -->
    <div class="bg-gray-50 rounded-2xl border border-gray-100 shadow-inner no-print my-6">
      <!-- Cabeçalho Colapsável -->
      <button onclick="toggleBrushSection()" class="w-full flex items-center justify-between p-4 focus:outline-none select-none text-left">
        <div class="flex items-center gap-2">
          <span class="text-lg">🎨</span>
          <div>
            <h4 class="text-xs font-black text-brand-dark uppercase tracking-wider font-mono">Pincel de Marcação Ativo & Dicas</h4>
            <p class="text-[10px] text-gray-500 font-mono">Selecione uma cor para pintar os dias no calendário</p>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <span id="brush-section-indicator" class="text-[10px] bg-brand-gold/20 text-brand-dark font-mono font-bold px-2 py-0.5 rounded-md">FECHADO</span>
          <svg id="brush-section-arrow" class="w-4 h-4 text-gray-500 transform transition-transform duration-200 rotate-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </div>
      </button>

      <!-- Conteúdo Colapsável (Escondido por padrão) -->
      <div id="brush-section-content" class="hidden border-t border-gray-200/60 p-5">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-center">
          <!-- Painel de Pincéis -->
          <div class="lg:col-span-2 space-y-3">
            <div class="flex items-center justify-between border-b pb-2 border-gray-200">
              <label class="block text-xs font-black text-brand-dark uppercase tracking-wider font-mono">Pincel de Marcação Ativo:</label>
              <button onclick="toggleColorSelection()" class="py-1 px-3 bg-white hover:bg-gray-100 border border-gray-200 text-gray-700 text-[10px] font-bold font-mono uppercase tracking-wider rounded-xl transition-colors shadow-sm">
                Alternar Legenda
              </button>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-2">
              <!-- G1 -->
              <label class="flex items-center gap-2.5 p-3 rounded-xl border border-blue-200 bg-blue-50/40 cursor-pointer hover:bg-blue-50/80 transition-all shadow-sm">
                <input type="radio" name="active-brush" value="g1" checked class="w-4 h-4 text-blue-600 focus:ring-blue-500 border-gray-300">
                <span class="w-4 h-4 rounded bg-blue-500 border border-blue-600 shrink-0"></span>
                <span id="brush-g1-label" class="text-[10px] font-black font-mono text-blue-900 uppercase truncate">G1</span>
              </label>
              <!-- G2 -->
              <label class="flex items-center gap-2.5 p-3 rounded-xl border border-emerald-200 bg-emerald-50/40 cursor-pointer hover:bg-emerald-50/80 transition-all shadow-sm">
                <input type="radio" name="active-brush" value="g2" class="w-4 h-4 text-emerald-600 focus:ring-emerald-500 border-gray-300">
                <span class="w-4 h-4 rounded bg-emerald-500 border border-emerald-600 shrink-0"></span>
                <span id="brush-g2-label" class="text-[10px] font-black font-mono text-emerald-900 uppercase truncate">G2</span>
              </label>
              <!-- G3 -->
              <label class="flex items-center gap-2.5 p-3 rounded-xl border border-yellow-200 bg-yellow-50/40 cursor-pointer hover:bg-yellow-50/80 transition-all shadow-sm">
                <input type="radio" name="active-brush" value="g3" class="w-4 h-4 text-yellow-600 focus:ring-yellow-500 border-gray-300">
                <span class="w-4 h-4 rounded bg-yellow-500 border border-yellow-600 shrink-0"></span>
                <span id="brush-g3-label" class="text-[10px] font-black font-mono text-yellow-900 uppercase truncate">G3</span>
              </label>
              <!-- Borracha -->
              <label class="flex items-center gap-2.5 p-3 rounded-xl border border-gray-200 bg-gray-50/80 cursor-pointer hover:bg-gray-100 transition-all shadow-sm">
                <input type="radio" name="active-brush" value="" class="w-4 h-4 text-gray-600 focus:ring-gray-500 border-gray-300">
                <span class="w-4 h-4 rounded bg-white border border-gray-300 shrink-0 flex items-center justify-center font-mono font-black text-[10px] text-gray-400">✖</span>
                <span class="text-[10px] font-black font-mono text-gray-600 uppercase">Borracha</span>
              </label>
            </div>
          </div>
          
          <!-- Dica de Uso -->
          <div class="p-4 bg-amber-50 border border-amber-200 rounded-xl shadow-sm">
            <span class="text-[10px] text-amber-800 font-mono block font-bold leading-none">💡 DICA DE MARCAÇÃO:</span>
            <span class="text-[10px] text-amber-700 font-mono block leading-relaxed mt-1.5">Selecione um <b>Pincel Ativo</b> acima e clique em qualquer dia no calendário para pintá-lo. Clicar em um dia já marcado com o mesmo pincel o limpa automaticamente!</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Seção de Notas e Legendas (Replicando o Modelo da Planilha do Pronto Socorro) -->
    <div class="border-t-2 border-brand-dark pt-6 grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Avisos Importantes (Ligar no Lab, etc) -->
      <div class="lg:col-span-1 space-y-3">
        <div class="p-3 border-2 border-rose-600 bg-rose-50 text-rose-800 rounded-xl space-y-1" id="print-warning-box-1">
          <span class="text-xs font-black block font-sans" id="print-notice-0">07:00h às 17:00h Segunda à Sexta Ligar no número do laboratório (43) 99618-3406</span>
        </div>
        <div class="p-3 border-2 border-rose-600 bg-rose-50 text-rose-800 rounded-xl space-y-1" id="print-warning-box-2">
          <span class="text-xs font-black block font-sans" id="print-notice-1">Aos sábados das 07:00h ao 11:00h (43) 99618-3406</span>
        </div>
        <div class="p-3 border-2 border-rose-600 bg-rose-50 text-rose-800 rounded-xl space-y-1" id="print-warning-box-3">
          <span class="text-xs font-black block font-sans" id="print-notice-2">Aos feriados ligação direta para a plantonista</span>
        </div>
      </div>

      <!-- Contatos de Plantão com Cores de Fundo (Exatamente igual ao rodapé do Pronto Socorro) -->
      <div class="lg:col-span-2 space-y-3">
        <div class="font-black text-xs text-brand-dark uppercase tracking-wider font-sans mb-1" id="print-notice-3">
          Após as 17:00h ligar nos números abaixo:
        </div>
        
        <div class="space-y-2">
          <!-- Contato 1 -->
          <div class="flex items-center gap-3 p-2 bg-blue-50 border border-blue-200 rounded-xl">
            <span class="w-6 h-6 rounded bg-blue-500 border border-blue-600 block shrink-0 flex items-center justify-center font-mono font-black text-white text-[10px]">1</span>
            <div class="text-xs font-bold font-mono">
              <span class="text-blue-800 font-black uppercase font-sans" id="print-g1-name">MONARA</span> - 
              <span class="text-gray-600" id="print-g1-phone">(43) 99914-9958</span>
            </div>
          </div>

          <!-- Contato 2 -->
          <div class="flex items-center gap-3 p-2 bg-emerald-50 border border-emerald-200 rounded-xl">
            <span class="w-6 h-6 rounded bg-emerald-500 border border-emerald-600 block shrink-0 flex items-center justify-center font-mono font-black text-white text-[10px]">2</span>
            <div class="text-xs font-bold font-mono">
              <span class="text-emerald-800 font-black uppercase font-sans" id="print-g2-name">THAÍS / GUSTAVO</span> - 
              <span class="text-gray-600" id="print-g2-phone">(43) 98487-6964 / (43) 99183-0607</span>
            </div>
          </div>

          <!-- Contato 3 -->
          <div class="flex items-center gap-3 p-2 bg-yellow-50 border border-yellow-200 rounded-xl">
            <span class="w-6 h-6 rounded bg-yellow-500 border border-yellow-600 block shrink-0 flex items-center justify-center font-mono font-black text-white text-[10px]">3</span>
            <div class="text-xs font-bold font-mono">
              <span class="text-yellow-800 font-black uppercase font-sans" id="print-g3-name">MARIA GABRIELA / RENAN</span> - 
              <span class="text-gray-600" id="print-g3-phone">(43) 99610-5992 / (43) 99115-1584</span>
            </div>
          </div>
        </div>

        <!-- Observação Extra (LIGAÇÃO SOMENTE) -->
        <div class="p-3 border-4 border-dashed border-rose-600 rounded-xl text-center bg-rose-50/50 mt-4">
          <span class="text-rose-700 font-black text-xs block font-sans uppercase tracking-wide" id="print-notice-4">
            OBS. POR FAVOR, GOSTARIAMOS QUE FIZESSE SOMENTE LIGAÇÃO
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- Configurar Grupos de Plantonistas (Cores & Contatos) Colapsável e Fechado por Padrão -->
  <details class="group bg-white p-6 rounded-2xl border border-gray-100 shadow-sm no-print transition-all duration-200">
    <summary class="flex items-center justify-between cursor-pointer list-none [&::-webkit-details-marker]:hidden select-none">
      <div class="flex items-center gap-3">
        <span class="text-xl shrink-0 group-open:scale-110 transition-transform">👥</span>
        <div>
          <span class="text-xs font-black text-brand-dark uppercase font-mono tracking-wider block">Configurar Grupos de Plantonistas (Cores & Contatos)</span>
          <p class="text-[10px] text-gray-400 font-mono mt-0.5 group-open:hidden">Clique para expandir e configurar os grupos de plantão</p>
          <p class="text-[10px] text-amber-600 font-mono mt-0.5 hidden group-open:block">As alterações nos grupos são sincronizadas em tempo real e salvas automaticamente.</p>
        </div>
      </div>
      <span class="text-gray-400 transition-transform duration-300 group-open:rotate-180 p-1.5 hover:bg-gray-50 rounded-xl">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
        </svg>
      </span>
    </summary>
    
    <div class="mt-5 pt-4 border-t border-gray-100 grid grid-cols-1 md:grid-cols-3 gap-4">
      <!-- Grupo 1 -->
      <div class="p-4 rounded-xl border border-blue-100 bg-blue-50/50 space-y-2">
        <div class="flex items-center gap-2">
          <span class="w-4 h-4 rounded bg-blue-500 border border-blue-600 block shrink-0"></span>
          <span class="text-[10px] font-black font-mono text-blue-800 uppercase tracking-wider">GRUPO 1 (AZUL)</span>
        </div>
        <div>
          <label class="block text-[8px] font-bold text-gray-400 uppercase tracking-wider font-mono">Puxar do Cadastro</label>
          <select id="g1-prof-select" onchange="applyProfessionalSelection('g1')" class="w-full px-2 py-1 bg-white border border-gray-200 rounded-lg text-[10px] font-mono mt-0.5 focus:ring-2 focus:ring-blue-100 outline-none">
            <option value="">-- Escolher Técnico --</option>
            <% professionals.forEach(p => { %>
              <option value="<%= p.id %>" data-name="<%= p.name %>" data-phone="<%= (p.salaryData && p.salaryData.pixKey && p.salaryData.pixKey.includes('@')) ? '' : ((p.salaryData && p.salaryData.pixKey) ? p.salaryData.pixKey : '') %>"><%= p.name %> (<%= p.role %>)</option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="block text-[8px] font-bold text-gray-400 uppercase tracking-wider font-mono">Nome(s)</label>
          <input type="text" id="g1-name" oninput="syncGroupDetails()" class="w-full px-2 py-1 bg-white border border-gray-200 rounded-lg text-xs font-mono mt-0.5 focus:ring-2 focus:ring-blue-100 outline-none">
        </div>
        <div>
          <label class="block text-[8px] font-bold text-gray-400 uppercase tracking-wider font-mono">Nome curto</label>
          <input type="text" id="g1-short" oninput="syncGroupDetails(); updateCalendars();" class="w-full px-2 py-1 bg-white border border-gray-200 rounded-lg text-xs font-mono mt-0.5 focus:ring-2 focus:ring-blue-100 outline-none" placeholder="Ex: Monara">
        </div>
        <div>
          <label class="block text-[8px] font-bold text-gray-400 uppercase tracking-wider font-mono">Telefone(s)</label>
          <input type="text" id="g1-phone" oninput="syncGroupDetails()" class="w-full px-2 py-1 bg-white border border-gray-200 rounded-lg text-xs font-mono mt-0.5 focus:ring-2 focus:ring-blue-100 outline-none">
        </div>
      </div>

      <!-- Grupo 2 -->
      <div class="p-4 rounded-xl border border-emerald-100 bg-emerald-50/50 space-y-2">
        <div class="flex items-center gap-2">
          <span class="w-4 h-4 rounded bg-emerald-500 border border-emerald-600 block shrink-0"></span>
          <span class="text-[10px] font-black font-mono text-emerald-800 uppercase tracking-wider">GRUPO 2 (VERDE)</span>
        </div>
        <div>
          <label class="block text-[8px] font-bold text-gray-400 uppercase tracking-wider font-mono">Puxar do Cadastro</label>
          <select id="g2-prof-select" onchange="applyProfessionalSelection('g2')" class="w-full px-2 py-1 bg-white border border-gray-200 rounded-lg text-[10px] font-mono mt-0.5 focus:ring-2 focus:ring-emerald-100 outline-none">
            <option value="">-- Escolher Técnico --</option>
            <% professionals.forEach(p => { %>
              <option value="<%= p.id %>" data-name="<%= p.name %>" data-phone="<%= (p.salaryData && p.salaryData.pixKey && p.salaryData.pixKey.includes('@')) ? '' : ((p.salaryData && p.salaryData.pixKey) ? p.salaryData.pixKey : '') %>"><%= p.name %> (<%= p.role %>)</option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="block text-[8px] font-bold text-gray-400 uppercase tracking-wider font-mono">Nome(s)</label>
          <input type="text" id="g2-name" oninput="syncGroupDetails()" class="w-full px-2 py-1 bg-white border border-gray-200 rounded-lg text-xs font-mono mt-0.5 focus:ring-2 focus:ring-emerald-100 outline-none">
        </div>
        <div>
          <label class="block text-[8px] font-bold text-gray-400 uppercase tracking-wider font-mono">Nome curto</label>
          <input type="text" id="g2-short" oninput="syncGroupDetails(); updateCalendars();" class="w-full px-2 py-1 bg-white border border-gray-200 rounded-lg text-xs font-mono mt-0.5 focus:ring-2 focus:ring-emerald-100 outline-none" placeholder="Ex: Thais">
        </div>
        <div>
          <label class="block text-[8px] font-bold text-gray-400 uppercase tracking-wider font-mono">Telefone(s)</label>
          <input type="text" id="g2-phone" oninput="syncGroupDetails()" class="w-full px-2 py-1 bg-white border border-gray-200 rounded-lg text-xs font-mono mt-0.5 focus:ring-2 focus:ring-emerald-100 outline-none">
        </div>
      </div>

      <!-- Grupo 3 -->
      <div class="p-4 rounded-xl border border-yellow-200 bg-yellow-50/50 space-y-2">
        <div class="flex items-center gap-2">
          <span class="w-4 h-4 rounded bg-yellow-500 border border-yellow-600 block shrink-0"></span>
          <span class="text-[10px] font-black font-mono text-yellow-800 uppercase tracking-wider">GRUPO 3 (AMARELO)</span>
        </div>
        <div>
          <label class="block text-[8px] font-bold text-gray-400 uppercase tracking-wider font-mono">Puxar do Cadastro</label>
          <select id="g3-prof-select" onchange="applyProfessionalSelection('g3')" class="w-full px-2 py-1 bg-white border border-gray-200 rounded-lg text-[10px] font-mono mt-0.5 focus:ring-2 focus:ring-yellow-100 outline-none">
            <option value="">-- Escolher Técnico --</option>
            <% professionals.forEach(p => { %>
              <option value="<%= p.id %>" data-name="<%= p.name %>" data-phone="<%= (p.salaryData && p.salaryData.pixKey && p.salaryData.pixKey.includes('@')) ? '' : ((p.salaryData && p.salaryData.pixKey) ? p.salaryData.pixKey : '') %>"><%= p.name %> (<%= p.role %>)</option>
            <% }) %>
          </select>
