          <label class="block text-[8px] font-bold text-gray-400 uppercase tracking-wider font-mono">Telefone(s)</label>
          <input type="text" id="g3-phone" oninput="syncGroupDetails()" class="w-full px-2 py-1 bg-white border border-gray-200 rounded-lg text-xs font-mono mt-0.5 focus:ring-2 focus:ring-yellow-100 outline-none">
        </div>
      </div>
    </div>
  </details>

  <!-- Observações e Textos Auxiliares (Avisos & Horários) Colapsável e no Final -->
  <details class="group bg-white p-5 rounded-2xl border border-gray-100 shadow-sm no-print transition-all duration-200">
    <summary class="flex items-center justify-between cursor-pointer list-none [&::-webkit-details-marker]:hidden select-none">
