<script>
  // Obter escala inicial do backend
  const escalaData = <%- JSON.stringify(escala) %>;
  let isInitialized = false;
  let autoSaveTimeout = null;

  // Função Debounced para Salvar Automaticamente
  function triggerAutoSave() {
    if (!isInitialized) return;
    
    const indicator = document.getElementById("auto-save-indicator");
    if (indicator) {
      indicator.className = "flex items-center gap-2 bg-amber-50 border border-amber-200 px-3 py-1.5 rounded-xl text-[11px] font-mono font-bold shrink-0";
      indicator.innerHTML = `<span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span><span class="text-amber-700">Salvando em breve...</span>`;
    }

    if (autoSaveTimeout) {
      clearTimeout(autoSaveTimeout);
    }

    autoSaveTimeout = setTimeout(async () => {
      if (indicator) {
        indicator.className = "flex items-center gap-2 bg-blue-50 border border-blue-200 px-3 py-1.5 rounded-xl text-[11px] font-mono font-bold shrink-0";
        indicator.innerHTML = `<span class="w-2.5 h-2.5 border-2 border-blue-500 border-t-transparent rounded-full animate-spin"></span><span class="text-blue-700">Salvando...</span>`;
      }
      try {
        const response = await fetch('/admin/financeiro/escala-plantao/save', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(escalaData)
        });
        
        const result = await response.json();
        if (result.success) {
          if (indicator) {
            indicator.className = "flex items-center gap-2 bg-emerald-50 border border-emerald-200 px-3 py-1.5 rounded-xl text-[11px] font-mono font-bold shrink-0";
            indicator.innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-500"></span><span class="text-emerald-700">Salvo automaticamente</span>`;
          }
        } else {
          if (indicator) {
            indicator.className = "flex items-center gap-2 bg-rose-50 border border-rose-200 px-3 py-1.5 rounded-xl text-[11px] font-mono font-bold shrink-0";
            indicator.innerHTML = `<span class="w-2 h-2 rounded-full bg-rose-500"></span><span class="text-rose-700">Erro ao salvar</span>`;
          }
          console.error("Erro no auto-save:", result.error);
        }
      } catch (error) {
        if (indicator) {
          indicator.className = "flex items-center gap-2 bg-rose-50 border border-rose-200 px-3 py-1.5 rounded-xl text-[11px] font-mono font-bold shrink-0";
          indicator.innerHTML = `<span class="w-2 h-2 rounded-full bg-rose-500"></span><span class="text-rose-700">Erro de conexão</span>`;
        }
        console.error("Erro de rede no auto-save:", error);
      }
    }, 1200); // 1.2 segundos após a última edição
  }
  
  // Dicionário de meses
  const NOME_MESES = {
    1: "Janeiro", 2: "Fevereiro", 3: "Março", 4: "Abril", 5: "Maio", 6: "Junho",
    7: "Julho", 8: "Agosto", 9: "Setembro", 10: "Outubro", 11: "Novembro", 12: "Dezembro"
  };

  // Carregar dados nos inputs do editor
  document.addEventListener("DOMContentLoaded", () => {
    const today = new Date();
    const currentYear = today.getFullYear();
    const currentMonth1 = today.getMonth() + 1; // 1-12
    let currentMonth2 = currentMonth1 + 1;
    if (currentMonth2 > 12) {
      currentMonth2 = 1;
    }

    // Garantir que o ano atual exista no select do ano
    const yearSelect = document.getElementById("escala-year");
    let optionExists = false;
    for (let i = 0; i < yearSelect.options.length; i++) {
      if (parseInt(yearSelect.options[i].value) === currentYear) {
        optionExists = true;
        break;
      }
    }
    if (!optionExists) {
      const newOpt = document.createElement("option");
      newOpt.value = currentYear;
      newOpt.text = currentYear;
      yearSelect.add(newOpt);
    }

    yearSelect.value = currentYear;
    document.getElementById("escala-month-1").value = currentMonth1;
    document.getElementById("escala-month-2").value = currentMonth2;

    // Configurar grupos
    if (escalaData.groups && escalaData.groups.length >= 3) {
      document.getElementById("g1-name").value = escalaData.groups[0].name || "";
      document.getElementById("g1-phone").value = escalaData.groups[0].phone || "";
      document.getElementById("g1-short").value = escalaData.groups[0].shortName || "";
      
      document.getElementById("g2-name").value = escalaData.groups[1].name || "";
      document.getElementById("g2-phone").value = escalaData.groups[1].phone || "";
      document.getElementById("g2-short").value = escalaData.groups[1].shortName || "";
      
      document.getElementById("g3-name").value = escalaData.groups[2].name || "";
      document.getElementById("g3-phone").value = escalaData.groups[2].phone || "";
      document.getElementById("g3-short").value = escalaData.groups[2].shortName || "";
    }

    // Configurar avisos
    if (escalaData.notices && escalaData.notices.length > 0) {
      for (let i = 0; i < 5; i++) {
        const txtEl = document.getElementById(`notice-${i}`);
        if (txtEl) txtEl.value = escalaData.notices[i] || "";
      }
    }

    // Sincronizar todos os textos de pré-visualização e desenhar os calendários
    syncGroupDetails();
    syncNotices();
    updateCalendars();
    
    // Marcar inicialização como concluída
    isInitialized = true;
  });

  // Função para preencher automaticamente com base na seleção de profissional cadastrado
  function applyProfessionalSelection(groupId) {
    const select = document.getElementById(`${groupId}-prof-select`);
    const selectedOption = select.options[select.selectedIndex];
    if (!selectedOption || !selectedOption.value) return;

    const name = selectedOption.getAttribute("data-name");
    const phone = selectedOption.getAttribute("data-phone");

    document.getElementById(`${groupId}-name`).value = name;
    if (phone) {
      document.getElementById(`${groupId}-phone`).value = phone;
    } else {
      document.getElementById(`${groupId}-phone`).value = "";
    }

    // Gerar um nome curto padrão inteligente (primeiro nome ou Dr/Dra. PrimeiroNome)
    let parts = name.split(" ");
    let shortName = parts[0];
    if ((parts[0].toLowerCase().startsWith("dr") || parts[0].toLowerCase() === "dra.") && parts.length > 1) {
      shortName = parts[0] + " " + parts[1]; // Ex: "Dra. Camila" ou "Dra. Monara"
    }
    document.getElementById(`${groupId}-short`).value = shortName;

    // Forçar sincronização e redesenho
    syncGroupDetails();
    updateCalendars();
  }

  // Sincronizar grupos de plantonistas do editor para a tela impressa
  function syncGroupDetails() {
    const g1Name = document.getElementById("g1-name").value;
    const g1Phone = document.getElementById("g1-phone").value;
    const g1Short = document.getElementById("g1-short").value;
    const g2Name = document.getElementById("g2-name").value;
    const g2Phone = document.getElementById("g2-phone").value;
    const g2Short = document.getElementById("g2-short").value;
    const g3Name = document.getElementById("g3-name").value;
    const g3Phone = document.getElementById("g3-phone").value;
    const g3Short = document.getElementById("g3-short").value;

    document.getElementById("print-g1-name").innerText = g1Name.toUpperCase();
    document.getElementById("print-g1-phone").innerText = g1Phone;
    document.getElementById("print-g2-name").innerText = g2Name.toUpperCase();
    document.getElementById("print-g2-phone").innerText = g2Phone;
    document.getElementById("print-g3-name").innerText = g3Name.toUpperCase();
    document.getElementById("print-g3-phone").innerText = g3Phone;

    // Atualizar labels dos pincéis no editor (mostrando apenas o nome curto)
    const brushG1 = document.getElementById("brush-g1-label");
    const brushG2 = document.getElementById("brush-g2-label");
    const brushG3 = document.getElementById("brush-g3-label");
    if (brushG1) brushG1.innerText = g1Short || g1Name || 'G1';
    if (brushG2) brushG2.innerText = g2Short || g2Name || 'G2';
    if (brushG3) brushG3.innerText = g3Short || g3Name || 'G3';

    // Atualizar dados da escalaData
    if (escalaData.groups && escalaData.groups.length >= 3) {
      escalaData.groups[0].name = g1Name;
      escalaData.groups[0].phone = g1Phone;
      escalaData.groups[0].shortName = g1Short;
      
      escalaData.groups[1].name = g2Name;
      escalaData.groups[1].phone = g2Phone;
      escalaData.groups[1].shortName = g2Short;
      
      escalaData.groups[2].name = g3Name;
      escalaData.groups[2].phone = g3Phone;
      escalaData.groups[2].shortName = g3Short;
    }
    
    // Disparar salvamento automático se já inicializado
    if (isInitialized) {
      triggerAutoSave();
    }
  }

  // Sincronizar avisos do editor para a tela impressa
  function syncNotices() {
    for (let i = 0; i < 5; i++) {
      const val = document.getElementById(`notice-${i}`).value;
      const printEl = document.getElementById(`print-notice-${i}`);
      if (printEl) printEl.innerText = val;
      escalaData.notices[i] = val;
    }
    
    // Disparar salvamento automático se já inicializado
    if (isInitialized) {
      triggerAutoSave();
    }
  }

  // Função para mudar/avançar meses com pulos inteligentes de ano
  function shiftMonths(delta) {
    let year = parseInt(document.getElementById("escala-year").value);
    let m1 = parseInt(document.getElementById("escala-month-1").value);
    let m2 = parseInt(document.getElementById("escala-month-2").value);

    m1 += delta;
    m2 += delta;

    // Lógica de rotação de meses e anos
    while (m1 < 1) {
      m1 += 12;
      year--;
    }
    while (m1 > 12) {
      m1 -= 12;
      year++;
    }

    while (m2 < 1) {
      m2 += 12;
      year--;
    }
    while (m2 > 12) {
      m2 -= 12;
      year++;
    }

    // Atualizar selects de ano e mês
    const yearSelect = document.getElementById("escala-year");
    if (yearSelect) {
      // Garantir que o ano exista no select, se não, adicionar temporariamente
      let optionExists = false;
      for (let i = 0; i < yearSelect.options.length; i++) {
        if (parseInt(yearSelect.options[i].value) === year) {
          optionExists = true;
          break;
        }
      }
      if (!optionExists) {
        const newOpt = document.createElement("option");
        newOpt.value = year;
        newOpt.text = year;
        yearSelect.add(newOpt);
      }
      yearSelect.value = year;
    }

    const month1Select = document.getElementById("escala-month-1");
    if (month1Select) month1Select.value = m1;

    const month2Select = document.getElementById("escala-month-2");
    if (month2Select) month2Select.value = m2;

    updateCalendars();
  }

  // Atualizar calendários e cabeçalhos de impressão ao trocar ano/mês
  function updateCalendars() {
    const year = parseInt(document.getElementById("escala-year").value);
    const m1 = parseInt(document.getElementById("escala-month-1").value);
    const m2 = parseInt(document.getElementById("escala-month-2").value);

    escalaData.year = year;
    escalaData.months = [m1, m2];

    // Atualizar cabeçalho
    const headerText = `${NOME_MESES[m1].toUpperCase()} / ${NOME_MESES[m2].toUpperCase()} - ${year}`;
    document.getElementById("print-header-dates").innerText = headerText;

    // Títulos de seção dos calendários
    document.getElementById("calendar-1-title").innerText = NOME_MESES[m1].toUpperCase();
    document.getElementById("calendar-2-title").innerText = NOME_MESES[m2].toUpperCase();

    // Renderizar grids de dias
    renderMonthDays(year, m1, "calendar-1-days");
    renderMonthDays(year, m2, "calendar-2-days");
  }

  // Renderizar os quadradinhos de cada dia para o mês selecionado
  function renderMonthDays(year, month, targetContainerId) {
    const container = document.getElementById(targetContainerId);
    container.innerHTML = "";

    // JS Date usa mês 0-11
    const firstDayIndex = new Date(year, month - 1, 1).getDay(); 
    const totalDays = new Date(year, month, 0).getDate(); 

    // Espaços em branco antes do primeiro dia do mês
    for (let i = 0; i < firstDayIndex; i++) {
      const emptyDiv = document.createElement("div");
      emptyDiv.className = "h-14 border border-gray-100 rounded-lg bg-gray-50/20";
      container.appendChild(emptyDiv);
    }

    // Dias reais
    for (let day = 1; day <= totalDays; day++) {
      const dateString = `${year}-${String(month).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
      const dayOfWeek = new Date(year, month - 1, day).getDay(); // 0 = Domingo, 6 = Sábado
      
      const dayBtn = document.createElement("div");
      dayBtn.className = "day-editable h-14 border border-gray-200 rounded-lg flex flex-col justify-between p-1 font-mono text-xs font-bold relative bg-white select-none cursor-pointer transition-all";
      dayBtn.dataset.date = dateString;
      
      // Número do dia
      const numSpan = document.createElement("span");
      numSpan.innerText = day;
      
      // Aplicar cor para finais de semana
      if (dayOfWeek === 0) {
        numSpan.className = "text-rose-600 font-extrabold text-xs";
      } else if (dayOfWeek === 6) {
        numSpan.className = "text-blue-600 font-extrabold text-xs";
      } else {
        numSpan.className = "text-gray-500 text-xs";
      }
      dayBtn.appendChild(numSpan);

      // Nome abreviado do plantonista se houver
      const activeGroup = escalaData.assignments[dateString] || "";
      const labelSpan = document.createElement("span");
      labelSpan.className = "text-[9px] text-center uppercase tracking-tight rounded-md px-1 py-0.5 block w-full mt-1 truncate";
      
      // Definir cores de fundo
      applyDayColor(dayBtn, labelSpan, activeGroup);
      dayBtn.appendChild(labelSpan);

      // Clique no botão para marcar ou desmarcar o dia com base no pincel ativo
      dayBtn.addEventListener("click", () => {
        // Obter o pincel/grupo ativo selecionado nos radio buttons
        const selectedBrushInput = document.querySelector('input[name="active-brush"]:checked');
        const selectedBrush = selectedBrushInput ? selectedBrushInput.value : "g1";

        let nextGroup = "";
        // Se clicar em um dia que já possui esse mesmo grupo ativo, desmarque-o (limpe o dia)
        if (activeGroup === selectedBrush) {
          nextGroup = "";
        } else {
          nextGroup = selectedBrush;
        }

        // Salvar
        escalaData.assignments[dateString] = nextGroup;
        // Re-colorir imediatamente
        applyDayColor(dayBtn, labelSpan, nextGroup);
        // Atualizar atributo para referências futuras
        dayBtn.dataset.group = nextGroup;
        
        // Re-renderizar este bloco de calendário para consistência nos escopos do event listener
        renderMonthDays(year, month, targetContainerId);

        // Disparar salvamento automático se já inicializado
        if (isInitialized) {
          triggerAutoSave();
        }
      });

      container.appendChild(dayBtn);
    }
  }

  let showNamesInCalendar = true;

  function toggleColorSelection() {
    showNamesInCalendar = !showNamesInCalendar;
    updateCalendars();
  }

  // Helper para definir as cores dos dias com base no grupo
  function applyDayColor(element, labelSpan, group) {
    // Limpar classes antigas
    element.className = "day-editable h-14 border border-gray-200 rounded-lg flex flex-col justify-between p-1 font-mono text-xs font-bold relative select-none cursor-pointer transition-all";
    labelSpan.innerText = "";
    
    if (group === "g1") {
      element.className += " bg-blue-50/70 border-blue-200 text-blue-900 hover:bg-blue-100/70";
      labelSpan.className = "text-[9px] text-center uppercase font-black tracking-tight rounded px-1 py-0.5 block w-full text-white bg-blue-600 shadow-sm truncate mb-0.5";
      const shortVal = document.getElementById("g1-short").value || document.getElementById("g1-name").value.split(" ")[0] || "G1";
      labelSpan.innerText = showNamesInCalendar ? shortVal : "G1";
    } else if (group === "g2") {
      element.className += " bg-emerald-50/70 border-emerald-200 text-emerald-900 hover:bg-emerald-100/70";
      labelSpan.className = "text-[9px] text-center uppercase font-black tracking-tight rounded px-1 py-0.5 block w-full text-white bg-emerald-600 shadow-sm truncate mb-0.5";
      const shortVal = document.getElementById("g2-short").value || document.getElementById("g2-name").value.split(" ")[0] || "G2";
      labelSpan.innerText = showNamesInCalendar ? shortVal : "G2";
    } else if (group === "g3") {
      element.className += " bg-yellow-50/70 border-yellow-200 text-yellow-900 hover:bg-yellow-100/70";
      labelSpan.className = "text-[9px] text-center uppercase font-black tracking-tight rounded px-1 py-0.5 block w-full text-yellow-950 bg-yellow-500 shadow-sm truncate mb-0.5";
      const shortVal = document.getElementById("g3-short").value || document.getElementById("g3-name").value.split(" ")[0] || "G3";
      labelSpan.innerText = showNamesInCalendar ? shortVal : "G3";
    } else {
      element.className += " bg-white text-gray-800 hover:bg-gray-50 border-gray-200";
    }
  }

  // Salvar a escala de plantão completa via API POST
  async function saveEscala() {
    try {
      const response = await fetch('/admin/financeiro/escala-plantao/save', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(escalaData)
      });
      
      const result = await response.json();
      if (result.success) {
        alert("🎉 Escala de plantão salva com sucesso no servidor!");
      } else {
        alert("⚠️ Erro ao salvar escala: " + result.error);
      }
    } catch (error) {
      console.error(error);
      alert("⚠️ Erro de rede ao tentar salvar a escala.");
    }
  }

  // Disparar o diálogo de impressão do navegador (com CSS horizontal de landscape automático)
  function imprimirEscala() {
    try {
      const inIframe = window.self !== window.top;
      if (inIframe) {
        showIframePrintModal();
      } else {
        window.print();
      }
    } catch (e) {
      window.print();
    }
  }

  function showIframePrintModal() {
    const modal = document.getElementById("iframe-print-modal");
    const card = document.getElementById("iframe-modal-card");
    if (modal && card) {
      modal.classList.remove("hidden");
      setTimeout(() => {
        card.classList.remove("scale-95", "opacity-0");
        card.classList.add("scale-100", "opacity-100");
      }, 50);
    }
  }

  function closeIframePrintModal() {
    const modal = document.getElementById("iframe-print-modal");
    const card = document.getElementById("iframe-modal-card");
    if (modal && card) {
      card.classList.remove("scale-100", "opacity-100");
      card.classList.add("scale-95", "opacity-0");
      setTimeout(() => {
        modal.classList.add("hidden");
      }, 300);
    }
  }

  function toggleBrushSection() {
    const content = document.getElementById("brush-section-content");
    const indicator = document.getElementById("brush-section-indicator");
    const arrow = document.getElementById("brush-section-arrow");
    if (content && indicator && arrow) {
      if (content.classList.contains("hidden")) {
        content.classList.remove("hidden");
        indicator.innerText = "ABERTO";
        indicator.className = "text-[10px] bg-emerald-100 text-emerald-800 font-mono font-bold px-2 py-0.5 rounded-md";
        arrow.classList.add("rotate-180");
      } else {
        content.classList.add("hidden");
        indicator.innerText = "FECHADO";
        indicator.className = "text-[10px] bg-brand-gold/20 text-brand-dark font-mono font-bold px-2 py-0.5 rounded-md";
        arrow.classList.remove("rotate-180");
      }
    }
  }
</script>

<!-- Modal de Aviso para Impressão em Iframe (Oculto por padrão) -->
