<style>
  @media print {
    body * {
      visibility: hidden;
    }
    #printable-area, #printable-area * {
      visibility: visible;
    }
    #printable-area {
      position: absolute;
      left: 0;
      top: 0;
      width: 100%;
      border: none !important;
    }
    .no-print {
      display: none !important;
    }
  }
</style>

<script>
  const closuresData = <%- JSON.stringify(closures || []) %>;

  function formatMoney(num) {
    const val = Number(num) || 0;
    return val.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function openImageModal(src) {
    if (!src) return;
    document.getElementById('image-zoom-src').src = src;
    document.getElementById('image-zoom-modal').classList.remove('hidden');
  }

  function closeImageModal() {
    document.getElementById('image-zoom-modal').classList.add('hidden');
  }

  // Alterna o status Conferido vs Fechado/Pendente
  async function toggleConferido(id, isChecked) {
    const newStatus = isChecked ? 'Conferido' : 'Fechado';
    const badgeEl = document.getElementById(`badge-status-${id}`);

    try {
      const res = await fetch('/admin/recepcao/fechamento-caixa/toggle-conferido', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, status: newStatus })
      });

      if (res.ok) {
        if (badgeEl) {
          if (isChecked) {
            badgeEl.innerText = 'Conferido';
            badgeEl.className = 'text-[9px] px-2 py-0.5 rounded-full font-mono font-bold bg-emerald-100 text-emerald-800 border border-emerald-300';
          } else {
            badgeEl.innerText = 'Pendente';
            badgeEl.className = 'text-[9px] px-2 py-0.5 rounded-full font-mono font-bold bg-amber-100 text-amber-800 border border-amber-300';
          }
        }
        
        // Atualizar atributo data-status na linha da tabela
        const row = document.querySelector(`tr[data-id="${id}"]`);
        if (row) {
          row.setAttribute('data-status', newStatus);
        }

        // Atualizar no JS data array
        const item = closuresData.find(c => c.id === id);
        if (item) item.status = newStatus;

      } else {
        alert('Erro ao atualizar status do fechamento.');
      }
    } catch (err) {
      console.error('Erro no toggle status:', err);
      alert('Erro de rede ao alterar status.');
    }
  }

  let currentSelectedMonth = ''; // Formato YYYY-MM ou 'ALL'

  const monthNamesPt = [
    'Janeiro', 'Fevereiro', 'Março', 'Abril', 'Maio', 'Junho',
    'Julho', 'Agosto', 'Setembro', 'Outubro', 'Novembro', 'Dezembro'
  ];

  function updateMonthDisplay() {
    const displayEl = document.getElementById('current-month-display');
    const pickerEl = document.getElementById('filter-month-picker');

    if (!currentSelectedMonth || currentSelectedMonth === 'ALL') {
      if (displayEl) displayEl.innerText = 'TODOS OS MESES';
      if (pickerEl) pickerEl.value = '';
      return;
    }

    if (pickerEl) pickerEl.value = currentSelectedMonth;

    const parts = currentSelectedMonth.split('-');
    if (parts.length === 2) {
      const year = parts[0];
      const monthIdx = parseInt(parts[1], 10) - 1;
      const monthName = monthNamesPt[monthIdx] || parts[1];
      if (displayEl) displayEl.innerHTML = `${monthName.toUpperCase()} / <span class="text-brand-gold">${year}</span>`;
    }
  }

  function changeMonth(delta) {
    if (!currentSelectedMonth || currentSelectedMonth === 'ALL') {
      const now = new Date();
      currentSelectedMonth = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
    }

    const parts = currentSelectedMonth.split('-');
    let year = parseInt(parts[0], 10);
    let month = parseInt(parts[1], 10) + delta;

    if (month > 12) {
      month = 1;
      year += 1;
    } else if (month < 1) {
      month = 12;
      year -= 1;
    }

    currentSelectedMonth = `${year}-${String(month).padStart(2, '0')}`;
    updateMonthDisplay();
    applyFilters();
  }

  function onMonthPickerChange() {
    const picker = document.getElementById('filter-month-picker');
    if (picker && picker.value) {
      currentSelectedMonth = picker.value;
      updateMonthDisplay();
      applyFilters();
    }
  }

  function goToCurrentMonth() {
    const now = new Date();
    currentSelectedMonth = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
    updateMonthDisplay();
    applyFilters();
  }

  function showAllMonths() {
    currentSelectedMonth = 'ALL';
    updateMonthDisplay();
    applyFilters();
  }

  // Aplica filtros e recalcula totais da Dashboard
  function applyFilters() {
    const recepcaoVal = document.getElementById('filter-recepcao').value;
    const statusVal = document.getElementById('filter-status').value;
    const dateStartVal = document.getElementById('filter-date-start').value;
    const dateEndVal = document.getElementById('filter-date-end').value;
    const searchVal = document.getElementById('filter-search').value.toLowerCase().trim();

    const rows = document.querySelectorAll('.closure-row');

    let sumEntradas = 0;
    let sumDinheiro = 0;
    let sumSaidas = 0;
    let sumPix = 0;
    let sumCredito = 0;
    let sumDebito = 0;
    let sumCheque = 0;
    let sumRetirada = 0;

    rows.forEach(r => {
      const rowRecepcao = r.getAttribute('data-recepcao') || 'Recepção Particular';
      const rowStatus = r.getAttribute('data-status') || 'Fechado';
      const rowDate = r.getAttribute('data-date') || '';
      const rowResp = r.getAttribute('data-responsavel') || '';

      // Filtro por Mês de Referência
      let matchMonth = true;
      if (currentSelectedMonth && currentSelectedMonth !== 'ALL') {
        matchMonth = rowDate.startsWith(currentSelectedMonth);
      }

      const matchRecepcao = (recepcaoVal === 'Todas') || (rowRecepcao === recepcaoVal);
      
      let matchStatus = true;
      if (statusVal === 'Conferido') matchStatus = (rowStatus === 'Conferido');
      else if (statusVal === 'Aguardando Conferência') matchStatus = (rowStatus !== 'Conferido');

      let matchDate = true;
      if (dateStartVal && rowDate < dateStartVal) matchDate = false;
      if (dateEndVal && rowDate > dateEndVal) matchDate = false;

      let matchSearch = true;
      if (searchVal && !rowResp.includes(searchVal)) matchSearch = false;

      if (matchMonth && matchRecepcao && matchStatus && matchDate && matchSearch) {
        r.style.display = '';

        sumEntradas += parseFloat(r.getAttribute('data-total-entradas')) || 0;
        sumDinheiro += parseFloat(r.getAttribute('data-dinheiro')) || 0;
        sumSaidas += parseFloat(r.getAttribute('data-saidas')) || 0;
        sumPix += parseFloat(r.getAttribute('data-pix')) || 0;
        sumCredito += parseFloat(r.getAttribute('data-credito')) || 0;
        sumDebito += parseFloat(r.getAttribute('data-debito')) || 0;
        sumCheque += parseFloat(r.getAttribute('data-cheque')) || 0;
        sumRetirada += parseFloat(r.getAttribute('data-retirada')) || 0;

      } else {
        r.style.display = 'none';
      }
    });

    // Atualizar Dashboard
    document.getElementById('dash-total-entradas').innerText = `R$ ${formatMoney(sumEntradas)}`;
    document.getElementById('dash-dinheiro').innerText = `R$ ${formatMoney(sumDinheiro)}`;
    if (document.getElementById('dash-saidas')) {
      document.getElementById('dash-saidas').innerText = `R$ ${formatMoney(sumSaidas)}`;
    }
    document.getElementById('dash-pix').innerText = `R$ ${formatMoney(sumPix)}`;
    document.getElementById('dash-credito').innerText = `R$ ${formatMoney(sumCredito)}`;
    document.getElementById('dash-debito').innerText = `R$ ${formatMoney(sumDebito)}`;
    document.getElementById('dash-cheque').innerText = `R$ ${formatMoney(sumCheque)}`;
    document.getElementById('dash-retirada').innerText = `R$ ${formatMoney(sumRetirada)}`;
  }

  function clearFilters() {
    document.getElementById('filter-recepcao').value = 'Todas';
    document.getElementById('filter-status').value = 'Todos';
    document.getElementById('filter-date-start').value = '';
    document.getElementById('filter-date-end').value = '';
    document.getElementById('filter-search').value = '';
    goToCurrentMonth();
  }

  // Inicializar filtro com o mês atual ao carregar a página
  document.addEventListener('DOMContentLoaded', () => {
    goToCurrentMonth();
  });

  function openEditModal(c) {
    document.getElementById('edit-id').value = c.id;
    document.getElementById('edit-recepcao').value = c.recepcao || 'Recepção Particular';
    document.getElementById('edit-date').value = c.data;
    document.getElementById('edit-responsavel').value = c.responsavel || '';
    document.getElementById('edit-troco-anterior').value = (c.trocoAnterior || 0).toFixed(2);
    document.getElementById('edit-dinheiro').value = (c.dinheiro || 0).toFixed(2);
    document.getElementById('edit-pix').value = (c.pix || 0).toFixed(2);
    document.getElementById('edit-cartao-credito').value = (c.cartaoCredito || 0).toFixed(2);
    document.getElementById('edit-cartao-debito').value = (c.cartaoDebito || 0).toFixed(2);
    document.getElementById('edit-cheque').value = (c.cheque || 0).toFixed(2);
    document.getElementById('edit-troco-seguinte').value = (c.trocoSeguinte || 0).toFixed(2);
    document.getElementById('edit-status').value = c.status || 'Fechado';
    document.getElementById('edit-observacoes').value = c.observacoes || '';

    document.getElementById('edit-modal').classList.remove('hidden');
  }

  function closeEditModal() {
    document.getElementById('edit-modal').classList.add('hidden');
  }

  function printReceipt(id) {
    const c = closuresData.find(item => item.id === id);
    if (!c) return;

    document.getElementById('print-recepcao-title').innerText = c.recepcao || 'RECEPÇÃO';
    document.getElementById('print-date-resp').innerText = `DATA: ${c.dataBr} | LANÇADO POR: ${c.responsavel}`;
    document.getElementById('p-dinheiro').innerText = `R$ ${c.dinheiroFmt}`;
    document.getElementById('p-pix').innerText = `R$ ${c.pixFmt}`;
    document.getElementById('p-cartao-credito').innerText = `R$ ${c.cartaoCreditoFmt}`;
    document.getElementById('p-cartao-debito').innerText = `R$ ${c.cartaoDebitoFmt}`;
    document.getElementById('p-cheque').innerText = `R$ ${c.chequeFmt}`;
    document.getElementById('p-total-entradas').innerText = `R$ ${c.totalEntradasFmt}`;

    const trocoAntEl = document.getElementById('p-troco-anterior');
    if (c.trocoAnteriorEditado) {
      trocoAntEl.innerHTML = `R$ ${c.trocoAnteriorFmt} <span class="text-[10px] text-amber-800 font-bold block">(✏️ Editado - Orig: R$ ${c.trocoAnteriorOriginalFmt || formatMoney(c.trocoAnteriorOriginal)})</span>`;
    } else {
      trocoAntEl.innerText = `R$ ${c.trocoAnteriorFmt}`;
    }
    document.getElementById('p-dinheiro-esp').innerText = `R$ ${c.dinheiroFmt}`;
    document.getElementById('p-total-especie').innerText = `R$ ${formatMoney((c.trocoAnterior || 0) + (c.dinheiro || 0))}`;

    // Saídas em dinheiro no comprovante
    const saideiras = c.saidasDinheiro || [];
    const containerSaidas = document.getElementById('p-saidas-container');
    const listSaidas = document.getElementById('p-saidas-list');
    const totalSaidas = document.getElementById('p-saidas-total');

    if (saideiras.length > 0) {
      containerSaidas.classList.remove('hidden');
      totalSaidas.innerText = `R$ ${c.saidasDinheiroTotalFmt || formatMoney(c.saidasDinheiroTotal || 0)}`;
      listSaidas.innerHTML = saideiras.map(s => `<div>&bull; ${s.tipo}: ${s.descricao} (R$ ${formatMoney(s.valor)})</div>`).join('');
    } else {
      containerSaidas.classList.add('hidden');
    }

    document.getElementById('p-troco-seguinte').innerText = `R$ ${c.trocoSeguinteFmt}`;
    document.getElementById('p-retirada').innerText = `R$ ${c.retiradaDinheiroFmt}`;

    // Print Anexo no Comprovante
    const printBox = document.getElementById('p-print-box');
    const printImg = document.getElementById('p-print-img');
    if (c.comprovantePrint) {
      printImg.src = c.comprovantePrint;
      printBox.classList.remove('hidden');
    } else {
      printBox.classList.add('hidden');
    }

    const obsText = c.observacoes && c.observacoes.trim() ? c.observacoes : 'Sem observações registradas.';
    document.getElementById('p-observacoes').innerText = obsText;

    document.getElementById('print-modal').classList.remove('hidden');
  }

  function closePrintModal() {
    document.getElementById('print-modal').classList.add('hidden');
  }

  function triggerPrint() {
    window.print();
  }
</script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    applyFilters();
  });

  // --- IMPORTAÇÃO DE FECHAMENTO DE CAIXA VIA ARQUIVO CSV ---
  let parsedCsvItemsGlobal = [];

  function openImportCsvModal() {
    const modal = document.getElementById('import-csv-modal');
    if (modal) modal.classList.remove('hidden');
  }

  function closeImportCsvModal() {
    const modal = document.getElementById('import-csv-modal');
    if (modal) modal.classList.add('hidden');
  }

  function openDeleteMonthModal() {
    const modal = document.getElementById('delete-month-modal');
    const input = document.getElementById('delete-mes-input');
    if (input) {
      if (currentSelectedMonth && currentSelectedMonth !== 'ALL') {
        input.value = currentSelectedMonth;
      } else {
        const now = new Date();
        input.value = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
      }
    }
    if (modal) modal.classList.remove('hidden');
  }

  function closeDeleteMonthModal() {
    const modal = document.getElementById('delete-month-modal');
    if (modal) modal.classList.add('hidden');
  }

  function handleCsvFileSelected(event) {
    const file = event.target.files && event.target.files[0];
    if (!file) return;
    processCsvFile(file);
  }

  function processCsvFile(file) {
    const reader = new FileReader();
    reader.onload = function(e) {
      const csvText = e.target.result;
      document.getElementById('csv-file-name').innerText = file.name;
      document.getElementById('csv-file-size').innerText = (file.size / 1024).toFixed(1) + ' KB';

      document.getElementById('csv-upload-zone').classList.add('hidden');
      document.getElementById('csv-selected-preview').classList.remove('hidden');

      const items = parseCsvText(csvText);
      parsedCsvItemsGlobal = items;
      renderGroupedCsvResults(items);
    };
    reader.readAsText(file, 'UTF-8');
  }

  function parseCsvLine(line) {
    const sep = line.includes(';') ? ';' : (line.includes('\t') ? '\t' : ',');
    const cols = [];
    let cur = '';
    let inQuotes = false;
    for (let i = 0; i < line.length; i++) {
      const char = line[i];
      if (char === '"') {
        inQuotes = !inQuotes;
      } else if (char === sep && !inQuotes) {
        cols.push(cur.trim().replace(/^"|"$/g, ''));
        cur = '';
      } else {
        cur += char;
      }
    }
    cols.push(cur.trim().replace(/^"|"$/g, ''));
    return cols;
  }

  function fixMojibake(str) {
    if (!str) return '';
    return String(str)
      .replace(/\uFFFD/g, 'e')
      .replace(/Ã©/g, 'e').replace(/Ã‰/g, 'e')
      .replace(/Ãª/g, 'e').replace(/ÃŠ/g, 'e')
      .replace(/Ã¡/g, 'a').replace(/Ã /g, 'a')
      .replace(/Ã£/g, 'a').replace(/Ã¢/g, 'a')
      .replace(/Ã /g, 'a').replace(/Ã/g, 'a')
      .replace(/Ã­/g, 'i').replace(/Ã/g, 'i')
      .replace(/Ã³/g, 'o').replace(/Ã´/g, 'o')
      .replace(/Ãµ/g, 'o').replace(/Ã'/g, 'o')
      .replace(/Ãº/g, 'u').replace(/Ãœ/g, 'u')
      .replace(/Ã§/g, 'c').replace(/Ã‡/g, 'c');
  }

  function normalizeStr(raw) {
    if (!raw) return '';
    return fixMojibake(raw)
      .toLowerCase()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/[^a-z0-9]/g, " ")
      .replace(/\s+/g, " ")
      .trim();
  }

  function parseMoneyValue(val) {
    if (val === null || val === undefined) return 0;
    let str = String(val).trim();
    if (!str || str === '-' || str === 'R$' || str === 'R$ -') return 0;

    str = str.replace(/[\u00A0\u1680\u180E\u2000-\u200B\u202F\u205F\u3000\uFEFF]/g, ' ')
             .replace(/R\$\s*/gi, '')
             .replace(/\s/g, '')
             .replace(/"/g, '');
    if (!str) return 0;

    if (str.includes(',') && str.includes('.')) {
      if (str.lastIndexOf(',') > str.lastIndexOf('.')) {
        str = str.replace(/\./g, '').replace(',', '.');
      } else {
        str = str.replace(/,/g, '');
      }
    } else if (str.includes(',')) {
      str = str.replace(',', '.');
    } else if (str.includes('.')) {
      const parts = str.split('.');
      if (parts.length === 2 && parts[1].length === 3 && parts[0].length <= 3) {
        str = str.replace('.', '');
      }
    }

    const num = parseFloat(str);
    return isNaN(num) ? 0 : num;
  }

  function parseDateStringToIso(rawDateStr) {
    if (!rawDateStr) return null;
    let str = String(rawDateStr).trim().split(' ')[0].split('T')[0];
    if (!str) return null;

    if (str.includes('/') || (str.includes('-') && str.indexOf('-') === 2)) {
      const sep = str.includes('/') ? '/' : '-';
      const parts = str.split(sep);
      if (parts.length === 3) {
        const day = parts[0].padStart(2, '0');
        const month = parts[1].padStart(2, '0');
        let year = parts[2];
        if (year.length === 2) year = '20' + year;
        if (parseInt(month, 10) >= 1 && parseInt(month, 10) <= 12 && parseInt(day, 10) >= 1 && parseInt(day, 10) <= 31) {
          return {
            isoDate: `${year}-${month}-${day}`,
            dateBr: `${day}/${month}/${year}`
          };
        }
      }
    }

    if (str.includes('-') || str.includes('/')) {
      const sep = str.includes('-') ? '-' : '/';
      const parts = str.split(sep);
      if (parts.length === 3 && parts[0].length === 4) {
        const year = parts[0];
        const month = parts[1].padStart(2, '0');
        const day = parts[2].padStart(2, '0');
        return {
          isoDate: `${year}-${month}-${day}`,
          dateBr: `${day}/${month}/${year}`
        };
      }
    }

    return null;
  }

  function classifyPaymentType(rawText) {
    if (!rawText) return 'dinheiro';
    const norm = normalizeStr(rawText);
    if (!norm) return 'dinheiro';

    // 1. DÉBITO
    const isDeb = (
      norm.includes('deb') || 
      norm === 'cd' || 
      norm === 'c d' || 
      norm.includes('cartao d') || 
      norm.includes('c deb') ||
      norm.includes('maestro') || 
      norm.includes('banricompras') || 
      norm.includes('electron')
    );

    // 2. CRÉDITO
    const isCred = (
      norm.includes('cred') || 
      norm === 'cc' || 
      norm === 'c c' || 
      norm.includes('cartao c') || 
      norm.includes('c cred') ||
      norm.includes('visa') || 
      norm.includes('master') || 
      norm.includes('hiper') || 
      norm.includes('elo') || 
      norm.includes('amex') || 
      norm.includes('american express')
    );

    if (isDeb && !isCred) return 'cartaoDebito';
    if (isCred && !isDeb) return 'cartaoCredito';

    if (isDeb && isCred) {
      if (norm.includes('debito') && !norm.includes('credito')) return 'cartaoDebito';
      if (norm.includes('credito') && !norm.includes('debito')) return 'cartaoCredito';
      if (norm.includes('c deb') || norm.includes('cartao d')) return 'cartaoDebito';
      return 'cartaoCredito';
    }

    // 3. PIX
    if (norm.includes('pix') || norm.includes('transferencia') || norm.includes('ted') || norm.includes('doc') || norm.includes('qr')) {
      return 'pix';
    }

    // 4. CHEQUE
    if (norm.includes('cheque') || norm.includes('chq')) {
      return 'cheque';
    }

    // 5. DINHEIRO
    if (norm.includes('dinheiro') || norm.includes('especie') || norm.includes('esp') || norm.includes('cash') || norm.includes('moeda')) {
      return 'dinheiro';
    }

    // 6. CARTÃO GENÉRICO
    if (
      norm.includes('cartao') || 
      norm.includes('card') || 
      norm.includes('tef') || 
      norm.includes('pos') || 
      norm.includes('cielo') || 
      norm.includes('rede') || 
      norm.includes('stone') || 
      norm.includes('getnet') || 
      norm.includes('pagseguro')
    ) {
      return 'cartaoCredito';
    }

    return 'dinheiro';
  }

  function extractFirstName(fullName) {
    if (!fullName) return 'Importado via CSV';
    let clean = fixMojibake(fullName).trim();
    if (!clean || clean.toLowerCase() === 'importado via csv') return 'Importado via CSV';

    const parts = clean.split(/[\s\/,]+/);
    let first = parts[0] || '';
    if ((first.toLowerCase() === 'dr' || first.toLowerCase() === 'dra' || first.toLowerCase() === 'dr.') && parts[1]) {
      first = parts[1];
    }
    if (!first) return 'Importado via CSV';
    return first.charAt(0).toUpperCase() + first.slice(1).toLowerCase();
  }

  function parseCsvText(text) {
    const lines = text.split(/\r?\n/).map(l => l.trim()).filter(Boolean);
    if (lines.length === 0) return [];

    const firstCols = parseCsvLine(lines[0]);
    const isHeader = firstCols.some(c => {
      const norm = normalizeStr(c);
      return (
        norm.includes('data') || 
        norm.includes('lancado') || 
        norm.includes('operador') || 
        norm.includes('tipo') || 
        norm.includes('valor') || 
        norm.includes('recepcao') || 
        norm.includes('dinheiro') || 
        norm.includes('pix') || 
        norm.includes('cred') || 
        norm.includes('deb') || 
        norm.includes('cartao')
      );
    });

    let colDinheiroIdx = -1;
    let colPixIdx = -1;
    let colCartaoCreditoIdx = -1;
    let colCartaoDebitoIdx = -1;
    let colChequeIdx = -1;
    let colCartaoGenericoIdx = -1;

    let colDateIdx = -1;
    let colOperadorIdx = -1;
    let colRecepcaoIdx = -1;
    let colTipoIdx = -1;
    let colValorIdx = -1;

    if (isHeader) {
      firstCols.forEach((c, idx) => {
        const norm = normalizeStr(c);

        if (
          norm.includes('cred') || 
          norm === 'cc' || 
          norm === 'c c' || 
          norm.includes('cartao c') || 
          norm.includes('c cred')
        ) {
          if (!norm.includes('deb') && !norm.includes('cartao d')) {
            colCartaoCreditoIdx = idx;
          }
        }

        if (
          norm.includes('deb') || 
          norm === 'cd' || 
          norm === 'c d' || 
          norm.includes('cartao d') || 
          norm.includes('c deb') ||
          norm.includes('maestro') ||
          norm.includes('electron')
        ) {
          colCartaoDebitoIdx = idx;
        }

        if (norm.includes('dinheiro') || norm === 'esp' || norm.includes('especie') || norm.includes('cash')) {
          colDinheiroIdx = idx;
        }

        if (norm.includes('pix') || norm.includes('transferencia') || norm.includes('ted') || norm.includes('doc') || norm.includes('qr')) {
          colPixIdx = idx;
        }

        if (norm.includes('cheque') || norm.includes('chq')) {
          colChequeIdx = idx;
        }

        if (
          (norm.includes('cartao') || norm.includes('card') || norm.includes('pos') || norm.includes('tef')) && 
          colCartaoCreditoIdx === -1 && 
          colCartaoDebitoIdx === -1
        ) {
          colCartaoGenericoIdx = idx;
        }

        if (norm.includes('data') || norm.includes('dt') || norm.includes('dia') || norm.includes('emissao')) {
          colDateIdx = idx;
        } else if (norm.includes('lancado') || norm.includes('operador') || norm.includes('responsavel') || norm.includes('usuario') || norm.includes('atendente') || norm.includes('func')) {
          colOperadorIdx = idx;
        } else if (norm.includes('recepcao') || norm.includes('caixa') || norm.includes('unidade') || norm.includes('local') || norm.includes('setor')) {
          colRecepcaoIdx = idx;
        } else if (norm.includes('tipo') || norm.includes('forma') || norm.includes('meio') || norm.includes('pagamento') || norm.includes('pagto') || norm.includes('modalidade') || norm.includes('historico') || norm.includes('operacao') || norm.includes('descricao')) {
          colTipoIdx = idx;
        } else if (norm.includes('valor') || norm.includes('monto') || norm.includes('total') || norm.includes('quantia') || norm.includes('vlr') || norm.includes('val')) {
          colValorIdx = idx;
        }
      });
    }

    const isMultiColumn = (
      colCartaoCreditoIdx !== -1 || 
      colCartaoDebitoIdx !== -1 || 
      (colDinheiroIdx !== -1 && colPixIdx !== -1) || 
      (colDinheiroIdx !== -1 && colCartaoGenericoIdx !== -1)
    );
    const startIndex = isHeader ? 1 : 0;
    const rows = [];

    for (let i = startIndex; i < lines.length; i++) {
      const line = lines[i];
      if (!line) continue;

      const cols = parseCsvLine(line);
      if (cols.length < 2) continue;

      let dateObj = null;
      if (colDateIdx !== -1 && cols[colDateIdx]) {
        dateObj = parseDateStringToIso(cols[colDateIdx]);
      }
      if (!dateObj) {
        for (let cIdx = 0; cIdx < cols.length; cIdx++) {
          const testD = parseDateStringToIso(cols[cIdx]);
          if (testD) {
            dateObj = testD;
            break;
          }
        }
      }
      if (!dateObj) continue;

      let rawLancadoPor = '';
      if (colOperadorIdx !== -1 && cols[colOperadorIdx]) {
        rawLancadoPor = cols[colOperadorIdx];
      }
      const lancadoPor = extractFirstName(rawLancadoPor);

      let recepcao = 'Recepção Particular';
      if (colRecepcaoIdx !== -1 && cols[colRecepcaoIdx]) {
        const cleanRec = fixMojibake(cols[colRecepcaoIdx]).trim();
        if (cleanRec) recepcao = cleanRec;
      }

      if (isMultiColumn) {
        const valDinheiro = colDinheiroIdx !== -1 ? parseMoneyValue(cols[colDinheiroIdx]) : 0;
        const valPix = colPixIdx !== -1 ? parseMoneyValue(cols[colPixIdx]) : 0;
        let valCredito = colCartaoCreditoIdx !== -1 ? parseMoneyValue(cols[colCartaoCreditoIdx]) : 0;
        let valDebito = colCartaoDebitoIdx !== -1 ? parseMoneyValue(cols[colCartaoDebitoIdx]) : 0;
        const valCheque = colChequeIdx !== -1 ? parseMoneyValue(cols[colChequeIdx]) : 0;
        const valCartaoGen = colCartaoGenericoIdx !== -1 ? parseMoneyValue(cols[colCartaoGenericoIdx]) : 0;

        if (valCartaoGen > 0 && valCredito === 0 && valDebito === 0) {
          valCredito = valCartaoGen;
        }

        if (valDinheiro > 0) rows.push({ date: dateObj.isoDate, dateBr: dateObj.dateBr, lancadoPor, tipoPagamento: 'dinheiro', valor: valDinheiro, recepcao });
        if (valPix > 0) rows.push({ date: dateObj.isoDate, dateBr: dateObj.dateBr, lancadoPor, tipoPagamento: 'pix', valor: valPix, recepcao });
        if (valCredito > 0) rows.push({ date: dateObj.isoDate, dateBr: dateObj.dateBr, lancadoPor, tipoPagamento: 'cartaoCredito', valor: valCredito, recepcao });
        if (valDebito > 0) rows.push({ date: dateObj.isoDate, dateBr: dateObj.dateBr, lancadoPor, tipoPagamento: 'cartaoDebito', valor: valDebito, recepcao });
        if (valCheque > 0) rows.push({ date: dateObj.isoDate, dateBr: dateObj.dateBr, lancadoPor, tipoPagamento: 'cheque', valor: valCheque, recepcao });

      } else {
        let rawTipo = '';
        if (colTipoIdx !== -1 && cols[colTipoIdx]) {
          rawTipo = cols[colTipoIdx];
        }

        let rawValorStr = '0';
        if (colValorIdx !== -1 && cols[colValorIdx] !== undefined) {
          rawValorStr = cols[colValorIdx];
        }

        if (!rawTipo || !rawValorStr || colValorIdx === -1) {
          for (let cIdx = 0; cIdx < cols.length; cIdx++) {
            const colVal = cols[cIdx];
            const parsedV = parseMoneyValue(colVal);
            if (parsedV > 0 && rawValorStr === '0' && cIdx !== colDateIdx) {
              rawValorStr = colVal;
            } else {
              const classT = classifyPaymentType(colVal);
              if (classT !== 'dinheiro' || colVal.toLowerCase().includes('dinheiro') || colVal.toLowerCase().includes('especie')) {
                rawTipo = colVal;
              }
            }
          }
        }

        const tipoPagamento = classifyPaymentType(rawTipo);
        const valorNum = parseMoneyValue(rawValorStr);

        if (valorNum > 0) {
          rows.push({
            date: dateObj.isoDate,
            dateBr: dateObj.dateBr,
            lancadoPor,
            tipoPagamento,
            valor: valorNum,
            recepcao
          });
        }
      }
    }

    const grouped = {};
    rows.forEach(r => {
      const key = `${r.date}_${r.recepcao}`;
      if (!grouped[key]) {
        grouped[key] = {
          data: r.date,
          dataBr: r.dateBr,
          recepcao: r.recepcao,
          dinheiro: 0,
          pix: 0,
          cartaoCredito: 0,
          cartaoDebito: 0,
          cheque: 0,
          operadoresSet: new Set(),
          totalLancamentos: 0
        };
      }

      grouped[key][r.tipoPagamento] = (grouped[key][r.tipoPagamento] || 0) + r.valor;
      if (r.lancadoPor) grouped[key].operadoresSet.add(r.lancadoPor);
      grouped[key].totalLancamentos++;
    });

    return Object.values(grouped).map(g => {
      const totalEntradas = g.dinheiro + g.pix + g.cartaoCredito + g.cartaoDebito + g.cheque;
      const ops = Array.from(g.operadoresSet).filter(Boolean);
      return {
        data: g.data,
        dataBr: g.dataBr,
        recepcao: g.recepcao,
        dinheiro: Math.round(g.dinheiro * 100) / 100,
        pix: Math.round(g.pix * 100) / 100,
        cartaoCredito: Math.round(g.cartaoCredito * 100) / 100,
        cartaoDebito: Math.round(g.cartaoDebito * 100) / 100,
        cheque: Math.round(g.cheque * 100) / 100,
        totalEntradas: Math.round(totalEntradas * 100) / 100,
        responsavel: ops.join(', ') || 'Importado via CSV',
        status: 'Conferido',
        totalLancamentos: g.totalLancamentos,
        observacoes: `Importado via CSV (${g.totalLancamentos} itens)`
      };
    });
  }

  function clearSelectedCsv() {
    parsedCsvItemsGlobal = [];
    document.getElementById('csv-file-input').value = '';
    document.getElementById('csv-upload-zone').classList.remove('hidden');
    document.getElementById('csv-selected-preview').classList.add('hidden');
    document.getElementById('csv-result-container').classList.add('hidden');
    document.getElementById('btn-save-imported-csv-batch').classList.add('hidden');
  }

  function renderGroupedCsvResults(items) {
    const container = document.getElementById('csv-result-container');
    const groupedList = document.getElementById('csv-grouped-list');
    const metaInfo = document.getElementById('csv-meta-info');
    const totalGeralEl = document.getElementById('csv-total-geral');
    const btnSaveBatch = document.getElementById('btn-save-imported-csv-batch');

    if (!items || items.length === 0) {
      alert('Nenhum lançamento válido encontrado no arquivo CSV.');
      return;
    }

    let totalGeral = 0;
    items.forEach(it => {
      totalGeral += it.totalEntradas;
    });

    if (metaInfo) {
      metaInfo.innerText = `${items.length} Fechamento(s) de Caixa Identificado(s) | Status: Conferido`;
    }

    if (totalGeralEl) {
      totalGeralEl.innerText = `R$ ${formatMoney(totalGeral)}`;
    }

    groupedList.innerHTML = items.map((st, idx) => {
      return `
        <div class="bg-white p-4 sm:p-5 rounded-2xl border border-gray-200 shadow-sm space-y-3">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-gray-100 pb-3">
            <div class="flex items-center gap-2">
              <span class="w-8 h-8 rounded-xl bg-slate-900 text-amber-400 flex items-center justify-center font-mono font-bold text-xs shrink-0">
                ${idx + 1}
              </span>
              <div>
                <h4 class="text-xs font-black font-mono text-gray-900 uppercase">Data: ${st.dataBr} (${st.data})</h4>
                <p class="text-[10px] text-gray-500 font-mono">Operadores: ${st.responsavel} • Linhas lidas: ${st.totalLancamentos}</p>
              </div>
            </div>

            <div class="flex items-center gap-2">
              <span class="px-2.5 py-1 rounded-full text-[10px] font-mono font-bold bg-emerald-100 text-emerald-800 border border-emerald-300">
                Status: Conferido
              </span>
              <span class="px-2.5 py-1 rounded-full text-[10px] font-mono font-bold bg-gray-100 text-gray-800 border border-gray-300">
                ${st.recepcao}
              </span>
            </div>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-5 gap-2 text-center font-mono">
            <div class="bg-emerald-50 p-2 rounded-xl border border-emerald-100">
              <span class="text-[9px] font-bold text-emerald-800 uppercase block">Dinheiro</span>
              <span class="text-xs font-bold text-emerald-900">R$ ${formatMoney(st.dinheiro)}</span>
            </div>
            <div class="bg-teal-50 p-2 rounded-xl border border-teal-100">
              <span class="text-[9px] font-bold text-teal-800 uppercase block">PIX</span>
              <span class="text-xs font-bold text-teal-900">R$ ${formatMoney(st.pix)}</span>
            </div>
            <div class="bg-blue-50 p-2 rounded-xl border border-blue-100">
              <span class="text-[9px] font-bold text-blue-800 uppercase block">Crédito</span>
              <span class="text-xs font-bold text-blue-900">R$ ${formatMoney(st.cartaoCredito)}</span>
            </div>
            <div class="bg-indigo-50 p-2 rounded-xl border border-indigo-100">
              <span class="text-[9px] font-bold text-indigo-800 uppercase block">Débito</span>
              <span class="text-xs font-bold text-indigo-900">R$ ${formatMoney(st.cartaoDebito)}</span>
            </div>
            <div class="bg-gray-50 p-2 rounded-xl border border-gray-200 col-span-2 sm:col-span-1">
              <span class="text-[9px] font-bold text-gray-700 uppercase block">Cheque</span>
              <span class="text-xs font-bold text-gray-900">R$ ${formatMoney(st.cheque)}</span>
            </div>
          </div>

          <div class="flex items-center justify-between pt-1">
            <span class="text-[10px] font-bold text-gray-500 font-mono">Total do Fechamento: <strong class="text-emerald-900">R$ ${formatMoney(st.totalEntradas)}</strong></span>
          </div>
        </div>
      `;
    }).join('');

    container.classList.remove('hidden');
    if (btnSaveBatch) btnSaveBatch.classList.remove('hidden');
  }

  async function saveImportedCsvBatch() {
    if (!parsedCsvItemsGlobal || parsedCsvItemsGlobal.length === 0) {
      alert('Nenhum fechamento para importar.');
      return;
    }

    const btn = document.getElementById('btn-save-imported-csv-batch');
    if (btn) btn.disabled = true;

    try {
      const response = await fetch('/api/admin/recepcao/fechamento-caixa/salvar-lote-csv', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: parsedCsvItemsGlobal })
      });

      const res = await response.json();
      if (!res.success) {
        throw new Error(res.error || 'Erro ao importar lançamentos do CSV.');
      }

      alert(res.message || 'Lançamentos importados e marcados como CONFERIDO com sucesso!');
      closeImportCsvModal();
      window.location.reload();
    } catch (err) {
      console.error('Erro ao importar CSV:', err);
      alert('Falha ao gravar lançamentos: ' + err.message);
    } finally {
      if (btn) btn.disabled = false;
    }
  }
</script>

