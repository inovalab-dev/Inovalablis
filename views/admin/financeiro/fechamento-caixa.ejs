        <div class="flex justify-between font-mono"><span class="text-gray-600">Cheque:</span> <span id="p-cheque" class="font-bold">R$ 0,00</span></div>
        <div class="flex justify-between font-mono text-sm font-black pt-1 border-t border-gray-200">
          <span>Total Faturado:</span> <span id="p-total-entradas" class="text-emerald-700">R$ 0,00</span>
