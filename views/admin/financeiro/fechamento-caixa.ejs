      </div>

      <!-- Conciliação do Caixa -->
      <div class="space-y-1.5 text-xs bg-gray-50 p-3 rounded-lg border border-gray-200">
        <div class="font-bold text-[11px] text-gray-800 uppercase font-mono border-b border-gray-200 pb-1">2. Apuração do Caixa em Espécie</div>
        <div class="flex justify-between font-mono"><span class="text-gray-600">(+) Troco Inicial (Dia Ant.):</span> <span id="p-troco-anterior" class="font-bold">R$ 0,00</span></div>
