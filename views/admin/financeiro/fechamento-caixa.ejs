<%- include('../../partials/header') %>

<main class="min-h-screen bg-brand-neutralLight/45 pb-16">
  
  <!-- BANNER CABEÇALHO -->
  <section class="bg-white border-b border-brand-light/10 py-8">
    <div class="max-w-[1700px] mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
      <div class="space-y-1">
        <div class="flex items-center gap-2 text-xs font-semibold text-gray-500">
          <a href="/admin" class="hover:text-brand-dark transition-colors">Administração</a>
          <span>&rsaquo;</span>
          <span class="text-brand-dark font-bold font-mono uppercase text-[10px]">Financeiro / Recepção</span>
          <span>&rsaquo;</span>
          <span class="text-brand-gold font-bold font-mono uppercase text-[10px]">Conferência & Histórico de Caixas</span>
        </div>
        <h1 class="text-2xl font-extrabold text-brand-dark tracking-tight flex items-center gap-2.5">
          <svg class="w-7 h-7 text-brand-gold shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
          Conferência & Histórico de Fechamentos de Caixa
        </h1>
        <p class="text-xs text-gray-500 max-w-4xl">
          Painel administrativo para conciliação dos caixas da recepção (Particular e SUS). Valide e marque a flag de conferido, filtre por período e acompanhe o fluxo financeiro.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <button type="button" onclick="openImportCsvModal()" class="text-xs font-bold bg-gradient-to-r from-emerald-600 to-teal-700 hover:from-emerald-700 hover:to-teal-800 text-white px-4 py-2.5 rounded-xl transition-all shadow-md flex items-center gap-2 cursor-pointer border border-emerald-500/30">
          <svg class="w-4 h-4 text-emerald-200 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>
          <span>Importar Arquivo CSV</span>
          <span class="px-1.5 py-0.5 rounded-full text-[9px] font-mono bg-emerald-400 text-slate-900 font-black uppercase">CSV</span>
        </button>
        <button type="button" onclick="openDeleteMonthModal()" class="text-xs font-bold bg-rose-700 hover:bg-rose-800 text-white px-4 py-2.5 rounded-xl transition-all shadow-md flex items-center gap-2 cursor-pointer border border-rose-600">
          <svg class="w-4 h-4 text-rose-200 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
          <span>Excluir Mês</span>
        </button>
        <a href="/admin/recepcao/fechamento-caixa" class="text-xs font-bold bg-brand-dark hover:bg-brand-light text-white px-4 py-2.5 rounded-xl transition-all shadow-md flex items-center gap-2 cursor-pointer">
          <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
          <span>Lançar Novo Fechamento</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ALERTAS -->
  <% if (typeof query !== 'undefined' && query.success) { %>
    <div class="max-w-[1700px] mx-auto px-4 sm:px-6 lg:px-8 mt-6">
      <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 px-4 py-3 rounded-xl flex items-center justify-between text-xs font-semibold shadow-sm">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <% if (query.success === 'deleted_month') { %>
            <span>Todos os fechamentos de caixa do mês <%= query.mes || '' %> (<%= query.count || 0 %> lançamento(s)) foram excluídos com sucesso.</span>
          <% } else { %>
            <span>Operação realizada com sucesso no fechamento de caixa.</span>
          <% } %>
        </div>
        <button onclick="this.parentElement.remove()" class="text-emerald-500 hover:text-emerald-800 text-base">&times;</button>
      </div>
    </div>
  <% } %>

  <div class="max-w-[1700px] mx-auto px-4 sm:px-6 lg:px-8 mt-6 space-y-6">

    <!-- Sub-Navegação Unificada -->
    <div class="flex border-b border-gray-200 mb-6 overflow-x-auto whitespace-nowrap bg-white px-4 py-2.5 rounded-xl border border-gray-100 shadow-sm">
      <a href="/admin/financeiro/dashboard" class="px-4 py-2 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-dashboard') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5">
        Dashboard
      </a>
      <a href="/admin/financeiro/relatorio-faturamento" class="px-4 py-2 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-relatorio-faturamento') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5">
        Relatório de Faturamento
      </a>
      <a href="/admin/financeiro/pessoas" class="px-4 py-2 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-pessoas') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5">
        Clientes / Fornecedores
      </a>
      <a href="/admin/financeiro/contas-pagar" class="px-4 py-2 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-contas-pagar') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5">
        Contas a Pagar
      </a>
      <a href="/admin/financeiro/contas-receber" class="px-4 py-2 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-contas-receber') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5">
        Contas a Receber
      </a>
      <a href="/admin/financeiro/fechamento-caixa" class="px-4 py-2 font-bold text-xs uppercase tracking-wider font-mono border-b-2 border-[#284701] text-[#284701] transition-all flex items-center gap-1.5">
        Fechamento de Caixa
      </a>
      <a href="/admin/financeiro/fluxo-caixa" class="px-4 py-2 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-fluxo-caixa') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5">
        Fluxo de Caixa
      </a>
      <a href="/admin/financeiro/dre" class="px-4 py-2 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-dre') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5" title="Demonstrativo de Resultado">
        Demonstrativo de Resultado
      </a>
      <a href="/admin/financeiro/movimentacoes" class="px-4 py-2 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-movimentacoes') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5">
        Movimentações
      </a>
      <a href="/admin/financeiro/configuracoes" class="px-4 py-2 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-configuracoes') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5">
        Configurações
      </a>
    </div>

    <!-- DASHBOARD DE MÉTRICAS (FINANCEIRO / RECEPTIVO) -->
    <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 xl:grid-cols-9 gap-3">
      
      <!-- Metric 1: Total Entradas (Faturado) -->
      <div class="bg-white p-4 rounded-2xl border border-brand-light/20 shadow-sm col-span-2 sm:col-span-2 lg:col-span-2">
        <div class="flex items-center justify-between">
          <span class="text-[10px] font-bold text-gray-500 uppercase tracking-wider font-mono">Total Entradas (Faturamento)</span>
          <div class="w-7 h-7 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
          </div>
        </div>
        <div class="mt-2">
          <div id="dash-total-entradas" class="text-xl font-black text-emerald-800 font-mono">R$ 0,00</div>
          <p class="text-[9px] text-gray-400 mt-0.5">Soma de todas as formas de pagamento</p>
        </div>
      </div>

      <!-- Metric 2: Dinheiro -->
      <div class="bg-white p-3.5 rounded-2xl border border-emerald-100 shadow-sm">
        <span class="text-[10px] font-bold text-emerald-800 uppercase tracking-wider font-mono">Dinheiro</span>
        <div id="dash-dinheiro" class="text-base font-extrabold text-emerald-950 font-mono mt-1">R$ 0,00</div>
        <p class="text-[9px] text-emerald-600 mt-0.5">Espécie entrado</p>
      </div>

      <!-- Metric 2.1: Saídas em Dinheiro -->
      <div class="bg-white p-3.5 rounded-2xl border border-rose-200 shadow-sm">
        <span class="text-[10px] font-bold text-rose-800 uppercase tracking-wider font-mono">(-) Saídas Caixa</span>
        <div id="dash-saidas" class="text-base font-extrabold text-rose-700 font-mono mt-1">R$ 0,00</div>
        <p class="text-[9px] text-rose-600 mt-0.5">Combustível/Pão/Insumos</p>
      </div>

      <!-- Metric 3: PIX -->
      <div class="bg-white p-3.5 rounded-2xl border border-teal-100 shadow-sm">
        <span class="text-[10px] font-bold text-teal-800 uppercase tracking-wider font-mono">PIX</span>
        <div id="dash-pix" class="text-base font-extrabold text-teal-950 font-mono mt-1">R$ 0,00</div>
        <p class="text-[9px] text-teal-600 mt-0.5">Transferências PIX</p>
      </div>

      <!-- Metric 4: Cartão Crédito -->
      <div class="bg-white p-3.5 rounded-2xl border border-indigo-100 shadow-sm">
        <span class="text-[10px] font-bold text-indigo-800 uppercase tracking-wider font-mono">C. Crédito</span>
        <div id="dash-credito" class="text-base font-extrabold text-indigo-950 font-mono mt-1">R$ 0,00</div>
        <p class="text-[9px] text-indigo-600 mt-0.5">Vendas crédito</p>
      </div>

      <!-- Metric 5: Cartão Débito -->
      <div class="bg-white p-3.5 rounded-2xl border border-purple-100 shadow-sm">
        <span class="text-[10px] font-bold text-purple-800 uppercase tracking-wider font-mono">C. Débito</span>
        <div id="dash-debito" class="text-base font-extrabold text-purple-950 font-mono mt-1">R$ 0,00</div>
        <p class="text-[9px] text-purple-600 mt-0.5">Vendas débito</p>
      </div>

      <!-- Metric 6: Cheque -->
      <div class="bg-white p-3.5 rounded-2xl border border-gray-200 shadow-sm">
        <span class="text-[10px] font-bold text-gray-700 uppercase tracking-wider font-mono">Cheque</span>
        <div id="dash-cheque" class="text-base font-extrabold text-gray-900 font-mono mt-1">R$ 0,00</div>
        <p class="text-[9px] text-gray-500 mt-0.5">Cheques pré</p>
      </div>

      <!-- Metric 7: Total Retirada / Sangria -->
      <div class="bg-brand-neutralDark text-white p-4 rounded-2xl border border-brand-gold/30 shadow-md col-span-2 sm:col-span-2 lg:col-span-2">
        <div class="flex items-center justify-between">
          <span class="text-[10px] font-bold text-brand-gold uppercase tracking-wider font-mono">Retirada (Sangria Total)</span>
          <div class="w-7 h-7 rounded-lg bg-brand-gold/20 text-brand-gold flex items-center justify-center">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
          </div>
        </div>
        <div class="mt-2">
          <div id="dash-retirada" class="text-xl font-black text-brand-gold font-mono">R$ 0,00</div>
          <p class="text-[9px] text-white/60 mt-0.5">Total a recolher das recepções em espécie</p>
        </div>
      </div>

    </div>

    <!-- BARRA DE CONTROLE MENSAL DA CONFERÊNCIA -->
    <div class="bg-brand-neutralDark text-white p-4 rounded-2xl border border-brand-gold/30 shadow-md flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-brand-gold/20 text-brand-gold flex items-center justify-center shrink-0 border border-brand-gold/30">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        </div>
        <div>
          <span class="text-[10px] font-bold text-brand-gold uppercase tracking-widest font-mono">Competência / Mês de Referência</span>
          <h3 id="current-month-display" class="text-xl font-black text-white font-mono leading-tight flex items-center gap-2">
            <span>Carregando mês...</span>
          </h3>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <!-- Botão Mês Anterior -->
        <button type="button" onclick="changeMonth(-1)" 
                class="px-3 py-2 bg-white/10 hover:bg-brand-gold hover:text-brand-dark text-white rounded-xl transition-all shadow-sm flex items-center gap-1.5 text-xs font-bold font-mono cursor-pointer border border-white/10" title="Voltar 1 Mês">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
          <span class="hidden sm:inline">Anterior</span>
        </button>

        <!-- Seletor de Mês (Input Month) -->
        <div class="relative">
          <input type="month" id="filter-month-picker" onchange="onMonthPickerChange()" 
                 class="bg-white/10 text-white font-extrabold font-mono text-xs px-3 py-2 rounded-xl border border-white/20 focus:outline-none focus:ring-2 focus:ring-brand-gold cursor-pointer hover:bg-white/15 transition-all">
        </div>

        <!-- Botão Próximo Mês -->
        <button type="button" onclick="changeMonth(1)" 
                class="px-3 py-2 bg-white/10 hover:bg-brand-gold hover:text-brand-dark text-white rounded-xl transition-all shadow-sm flex items-center gap-1.5 text-xs font-bold font-mono cursor-pointer border border-white/10" title="Avançar 1 Mês">
          <span class="hidden sm:inline">Próximo</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </button>

        <!-- Botão Mês Atual -->
        <button type="button" onclick="goToCurrentMonth()" 
                class="px-3.5 py-2 bg-brand-gold text-brand-dark hover:bg-yellow-400 text-xs font-black rounded-xl transition-all shadow-sm font-mono cursor-pointer" title="Ir para Mês Atual">
          Mês Atual
        </button>

        <!-- Botão Ver Todos -->
        <button type="button" onclick="showAllMonths()" 
                class="px-3 py-2 bg-white/10 hover:bg-white/20 text-white text-xs font-bold rounded-xl transition-all shadow-sm font-mono cursor-pointer border border-white/10" title="Exibir Todos os Lançamentos">
          Todos
        </button>
      </div>
    </div>

    <!-- PAINEL PRINCIPAL COM FILTROS E TABELA DE CONFERÊNCIA -->
    <div class="bg-white rounded-2xl border border-brand-light/20 shadow-sm p-6 space-y-5">
      
      <!-- BARRA DE FILTROS -->
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 border-b border-gray-100 pb-5">
        <div>
          <h2 class="text-base font-bold text-brand-dark flex items-center gap-2">
            <svg class="w-5 h-5 text-brand-gold" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/></svg>
            <span>Filtros e Conciliação</span>
          </h2>
          <p class="text-[11px] text-gray-500">Filtre por recepção, intervalo de datas ou status de conferência.</p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          
          <!-- Filtro Recepção -->
          <div>
            <label class="block text-[10px] font-bold text-gray-600 uppercase font-mono mb-1">Recepção</label>
            <select id="filter-recepcao" onchange="applyFilters()" class="text-xs font-bold px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:ring-1 focus:ring-brand-gold focus:outline-none">
              <option value="Todas" selected>Todas as Recepções</option>
              <option value="Recepção Particular">Recepção Particular</option>
              <option value="Recepção SUS">Recepção SUS</option>
            </select>
          </div>

          <!-- Filtro Status -->
          <div>
            <label class="block text-[10px] font-bold text-gray-600 uppercase font-mono mb-1">Status Conferência</label>
            <select id="filter-status" onchange="applyFilters()" class="text-xs font-bold px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:ring-1 focus:ring-brand-gold focus:outline-none">
              <option value="Todos" selected>Todos os Status</option>
              <option value="Aguardando Conferência">Aguardando Conferência</option>
              <option value="Conferido">Conferidos</option>
            </select>
          </div>

          <!-- Data Inicial -->
          <div>
            <label class="block text-[10px] font-bold text-gray-600 uppercase font-mono mb-1">Data Inicial</label>
            <input type="date" id="filter-date-start" onchange="applyFilters()" class="text-xs font-bold font-mono px-3 py-1.5 bg-gray-50 border border-gray-200 rounded-xl focus:ring-1 focus:ring-brand-gold focus:outline-none">
          </div>

          <!-- Data Final -->
          <div>
            <label class="block text-[10px] font-bold text-gray-600 uppercase font-mono mb-1">Data Final</label>
            <input type="date" id="filter-date-end" onchange="applyFilters()" class="text-xs font-bold font-mono px-3 py-1.5 bg-gray-50 border border-gray-200 rounded-xl focus:ring-1 focus:ring-brand-gold focus:outline-none">
          </div>

          <!-- Busca por texto -->
          <div>
            <label class="block text-[10px] font-bold text-gray-600 uppercase font-mono mb-1">Buscar</label>
            <input type="text" id="filter-search" oninput="applyFilters()" placeholder="Nome do responsável..." class="text-xs px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:ring-1 focus:ring-brand-gold focus:outline-none w-36">
          </div>

          <!-- Limpar Filtros -->
          <div class="self-end">
            <button onclick="clearFilters()" class="text-xs font-bold text-gray-500 hover:text-brand-dark px-3 py-2 border border-gray-200 hover:bg-gray-100 rounded-xl transition-all">
              Limpar
            </button>
          </div>

        </div>
      </div>

      <!-- TABELA HISTÓRICO COM CONFERÊNCIA DE CAIXA -->
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse min-w-[1300px]">
          <thead>
            <tr class="bg-gray-50 border-y border-gray-200 text-[10px] font-bold text-gray-500 uppercase font-mono">
              <th class="py-3 px-3 text-center">Conferido?</th>
              <th class="py-3 px-3">Data</th>
              <th class="py-3 px-3">Recepção</th>
              <th class="py-3 px-3">Lançado por</th>
              <th class="py-3 px-3 text-right">Troco Ant.</th>
              <th class="py-3 px-3 text-right">Dinheiro</th>
              <th class="py-3 px-3 text-right text-rose-700">(-) Saídas Caixa</th>
              <th class="py-3 px-3 text-right">PIX</th>
              <th class="py-3 px-3 text-right">Crédito</th>
              <th class="py-3 px-3 text-right">Débito</th>
              <th class="py-3 px-3 text-right">Cheque</th>
              <th class="py-3 px-3 text-right font-black">Total Entradas</th>
              <th class="py-3 px-3 text-right">Troco Seg.</th>
              <th class="py-3 px-3 text-right text-brand-dark font-black">Retirada (Sangria)</th>
              <th class="py-3 px-3 text-center">Print Anexo</th>
              <th class="py-3 px-3 text-center">Ações</th>
            </tr>
          </thead>
          <tbody id="closures-table-body" class="divide-y divide-gray-100 text-xs">
            <% if (closures && closures.length > 0) { %>
              <% closures.forEach(c => { %>
                <tr class="hover:bg-gray-50/80 transition-colors closure-row" 
                    data-id="<%= c.id %>"
                    data-recepcao="<%= c.recepcao || 'Recepção Particular' %>"
                    data-status="<%= c.status || 'Fechado' %>"
                    data-date="<%= c.data || '' %>"
                    data-responsavel="<%= (c.responsavel || '').toLowerCase() %>"
                    data-dinheiro="<%= c.dinheiro || 0 %>"
                    data-saidas="<%= c.saidasDinheiroTotal || 0 %>"
                    data-pix="<%= c.pix || 0 %>"
                    data-credito="<%= c.cartaoCredito || 0 %>"
                    data-debito="<%= c.cartaoDebito || 0 %>"
                    data-cheque="<%= c.cheque || 0 %>"
                    data-total-entradas="<%= c.totalEntradas || 0 %>"
                    data-retirada="<%= c.retiradaDinheiro || 0 %>"
                    data-troco-seguinte="<%= c.trocoSeguinte || 0 %>">
                  
                  <!-- Toggle Flag Conferido -->
                  <td class="py-3 px-3 text-center whitespace-nowrap">
                    <label class="inline-flex items-center gap-1.5 cursor-pointer" title="Marcar / Desmarcar como Conferido">
                      <input type="checkbox" 
                             class="w-4 h-4 text-emerald-600 rounded border-gray-300 focus:ring-emerald-500 cursor-pointer"
                             <%= (c.status === 'Conferido') ? 'checked' : '' %>
                             onchange="toggleConferido('<%= c.id %>', this.checked)">
                      <span id="badge-status-<%= c.id %>" class="text-[9px] px-2 py-0.5 rounded-full font-mono font-bold <%= (c.status === 'Conferido') ? 'bg-emerald-100 text-emerald-800 border border-emerald-300' : 'bg-amber-100 text-amber-800 border border-amber-300' %>">
                        <%= (c.status === 'Conferido') ? 'Conferido' : 'Pendente' %>
                      </span>
                    </label>
                  </td>

                  <!-- Data -->
                  <td class="py-3 px-3 font-bold font-mono text-gray-900 whitespace-nowrap">
                    <%= c.dataBr %>
                  </td>

                  <!-- Recepção -->
                  <td class="py-3 px-3 font-bold text-gray-800 whitespace-nowrap">
                    <span class="px-2 py-0.5 rounded-lg text-[10px] font-mono font-bold <%= (c.recepcao === 'Recepção SUS') ? 'bg-blue-50 text-blue-700 border border-blue-200' : 'bg-purple-50 text-purple-700 border border-purple-200' %>">
                      <%= c.recepcao || 'Recepção Particular' %>
                    </span>
                  </td>

                  <!-- Responsável -->
                  <td class="py-3 px-3 font-semibold text-gray-700 whitespace-nowrap">
                    <%= c.responsavel %>
                  </td>

                  <!-- Troco Anterior -->
                  <td class="py-3 px-3 text-right font-mono text-gray-700 whitespace-nowrap">
                    <div class="font-bold">R$ <%= c.trocoAnteriorFmt %></div>
                    <% if (c.trocoAnteriorEditado) { %>
                      <div class="inline-flex items-center gap-1 bg-amber-100 text-amber-900 border border-amber-300 rounded px-1.5 py-0.5 text-[9px] font-bold font-sans mt-0.5" title="Troco do dia anterior foi alterado manualmente! Troco carregado originalmente era R$ <%= c.trocoAnteriorOriginalFmt %>">
                        ✏️ Editado (Orig: R$ <%= c.trocoAnteriorOriginalFmt %>)
                      </div>
                    <% } %>
                  </td>

                  <!-- Dinheiro -->
                  <td class="py-3 px-3 text-right font-mono font-bold text-emerald-700 whitespace-nowrap">
                    R$ <%= c.dinheiroFmt %>
                  </td>

                  <!-- Saídas Dinheiro (Despesas Caixa) -->
                  <td class="py-3 px-3 text-right font-mono font-bold text-rose-700 bg-rose-50/30 whitespace-nowrap" title="<%= (c.saidasDinheiro && c.saidasDinheiro.length) ? c.saidasDinheiro.map(s => s.tipo + ': R$ ' + s.valor).join(' | ') : 'Nenhuma saída em dinheiro' %>">
                    <% if (c.saidasDinheiroTotal > 0) { %>
                      - R$ <%= c.saidasDinheiroTotalFmt %>
                    <% } else { %>
                      <span class="text-gray-300">R$ 0,00</span>
                    <% } %>
                  </td>

                  <!-- PIX -->
                  <td class="py-3 px-3 text-right font-mono text-teal-700 whitespace-nowrap">
                    R$ <%= c.pixFmt %>
                  </td>

                  <!-- Crédito -->
                  <td class="py-3 px-3 text-right font-mono text-indigo-700 whitespace-nowrap">
                    R$ <%= c.cartaoCreditoFmt %>
                  </td>

                  <!-- Débito -->
                  <td class="py-3 px-3 text-right font-mono text-purple-700 whitespace-nowrap">
                    R$ <%= c.cartaoDebitoFmt %>
                  </td>

                  <!-- Cheque -->
                  <td class="py-3 px-3 text-right font-mono text-gray-700 whitespace-nowrap">
                    R$ <%= c.chequeFmt %>
                  </td>

                  <!-- Total Entradas -->
                  <td class="py-3 px-3 text-right font-mono font-black text-gray-900 bg-emerald-50/50 whitespace-nowrap">
                    R$ <%= c.totalEntradasFmt %>
                  </td>

                  <!-- Troco Seguinte -->
                  <td class="py-3 px-3 text-right font-mono text-amber-700 whitespace-nowrap">
                    R$ <%= c.trocoSeguinteFmt %>
                  </td>

                  <!-- Retirada (Sangria) -->
                  <td class="py-3 px-3 text-right font-mono font-black text-brand-dark bg-brand-gold/10 whitespace-nowrap">
                    R$ <%= c.retiradaDinheiroFmt %>
                  </td>

                  <!-- Print Anexo -->
                  <td class="py-3 px-3 text-center whitespace-nowrap">
                    <% if (c.comprovantePrint) { %>
                      <button type="button" onclick="openImageModal('<%= c.comprovantePrint %>')" 
                              class="inline-flex items-center gap-1 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-bold text-[10px] px-2 py-1 rounded-lg border border-indigo-200 transition-all cursor-pointer"
                              title="Ver Print Anexado do Outro Sistema">
                        <svg class="w-3.5 h-3.5 text-indigo-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                        <span>Ver Print</span>
                      </button>
                    <% } else { %>
                      <span class="text-gray-300 font-mono text-[10px]">-</span>
                    <% } %>
                  </td>

                  <!-- Ações -->
                  <td class="py-3 px-3 text-center whitespace-nowrap">
                    <div class="flex items-center justify-center gap-1.5">
                      <button type="button" onclick="printReceipt('<%= c.id %>')" title="Imprimir Comprovante (Ticket)"
                              class="p-1.5 text-gray-600 hover:text-brand-dark hover:bg-gray-100 rounded-lg transition-colors cursor-pointer">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
                      </button>
                      <button type="button" onclick='openEditModal(<%- JSON.stringify(c) %>)' title="Editar Lançamento"
                              class="p-1.5 text-blue-600 hover:text-blue-800 hover:bg-blue-50 rounded-lg transition-colors cursor-pointer">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                      </button>
                      <form action="/admin/recepcao/fechamento-caixa/delete" method="POST" onsubmit="return confirm('Excluir este fechamento de caixa?');" class="inline">
                        <input type="hidden" name="id" value="<%= c.id %>">
                        <button type="submit" title="Excluir Lançamento"
                                class="p-1.5 text-rose-500 hover:text-rose-700 hover:bg-rose-50 rounded-lg transition-colors cursor-pointer">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                        </button>
                      </form>
                    </div>
                  </td>

                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="14" class="py-12 text-center text-xs text-gray-400 font-mono">
                  Nenhum fechamento de caixa encontrado no sistema.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

    </div>

  </div>
</main>

<!-- MODAL EDIÇÃO PELO ADMINISTRADOR -->
<div id="edit-modal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
  <div class="bg-white rounded-3xl shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto border border-gray-200 p-6 space-y-5">
    
    <div class="flex items-center justify-between border-b border-gray-100 pb-3">
      <h3 class="text-base font-extrabold text-brand-dark flex items-center gap-2">
        <svg class="w-5 h-5 text-brand-gold" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
        <span>Editar Fechamento de Caixa</span>
      </h3>
      <button onclick="closeEditModal()" class="text-gray-400 hover:text-gray-700 text-lg cursor-pointer">&times;</button>
    </div>

    <form id="edit-closure-form" action="/admin/recepcao/fechamento-caixa/save" method="POST" class="space-y-4">
      <input type="hidden" id="edit-id" name="id">

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div>
          <label class="block text-[11px] font-bold text-gray-700 uppercase font-mono mb-1">Recepção</label>
          <select id="edit-recepcao" name="recepcao" required class="w-full text-xs font-bold px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl">
            <option value="Recepção Particular">Recepção Particular</option>
            <option value="Recepção SUS">Recepção SUS</option>
          </select>
        </div>

        <div>
          <label class="block text-[11px] font-bold text-gray-700 uppercase font-mono mb-1">Data</label>
          <input type="date" id="edit-date" name="data" required class="w-full text-xs font-bold font-mono px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl">
        </div>

        <div>
          <label class="block text-[11px] font-bold text-gray-700 uppercase font-mono mb-1">Responsável</label>
          <input type="text" id="edit-responsavel" name="responsavel" required class="w-full text-xs font-bold px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl">
        </div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 bg-gray-50 p-3 rounded-xl border border-gray-200">
        <div>
          <label class="block text-[10px] font-bold text-blue-800 uppercase font-mono mb-1">Troco Dia Ant.</label>
          <input type="number" step="0.01" id="edit-troco-anterior" name="trocoAnterior" required class="w-full text-xs font-bold font-mono px-2.5 py-1.5 bg-white border border-gray-300 rounded-lg">
        </div>
        <div>
          <label class="block text-[10px] font-bold text-emerald-800 uppercase font-mono mb-1">Dinheiro</label>
          <input type="number" step="0.01" id="edit-dinheiro" name="dinheiro" required class="w-full text-xs font-bold font-mono px-2.5 py-1.5 bg-white border border-gray-300 rounded-lg">
        </div>
        <div>
          <label class="block text-[10px] font-bold text-teal-800 uppercase font-mono mb-1">PIX</label>
          <input type="number" step="0.01" id="edit-pix" name="pix" class="w-full text-xs font-bold font-mono px-2.5 py-1.5 bg-white border border-gray-300 rounded-lg">
        </div>
        <div>
          <label class="block text-[10px] font-bold text-indigo-800 uppercase font-mono mb-1">C. Crédito</label>
          <input type="number" step="0.01" id="edit-cartao-credito" name="cartaoCredito" class="w-full text-xs font-bold font-mono px-2.5 py-1.5 bg-white border border-gray-300 rounded-lg">
        </div>
        <div>
          <label class="block text-[10px] font-bold text-purple-800 uppercase font-mono mb-1">C. Débito</label>
          <input type="number" step="0.01" id="edit-cartao-debito" name="cartaoDebito" class="w-full text-xs font-bold font-mono px-2.5 py-1.5 bg-white border border-gray-300 rounded-lg">
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-700 uppercase font-mono mb-1">Cheque</label>
          <input type="number" step="0.01" id="edit-cheque" name="cheque" class="w-full text-xs font-bold font-mono px-2.5 py-1.5 bg-white border border-gray-300 rounded-lg">
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label class="block text-[11px] font-bold text-amber-800 uppercase font-mono mb-1">Troco Próximo Dia</label>
          <input type="number" step="0.01" id="edit-troco-seguinte" name="trocoSeguinte" required class="w-full text-xs font-bold font-mono px-3 py-2 bg-amber-50 border border-amber-300 rounded-xl">
        </div>

        <div>
          <label class="block text-[11px] font-bold text-gray-700 uppercase font-mono mb-1">Status Conferência</label>
          <select id="edit-status" name="status" class="w-full text-xs font-bold px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl">
            <option value="Fechado">Aguardando Conferência</option>
            <option value="Conferido">Conferido</option>
          </select>
        </div>
      </div>

      <div>
        <label class="block text-[11px] font-bold text-gray-700 uppercase font-mono mb-1">Observações</label>
        <textarea id="edit-observacoes" name="observacoes" rows="2" class="w-full text-xs p-2.5 bg-gray-50 border border-gray-200 rounded-xl"></textarea>
      </div>

      <div class="flex items-center justify-end gap-2 pt-2 border-t border-gray-100">
        <button type="button" onclick="closeEditModal()" class="px-4 py-2 text-xs font-bold text-gray-600 hover:bg-gray-100 rounded-xl">Cancelar</button>
        <button type="submit" class="px-5 py-2.5 text-xs font-extrabold bg-brand-dark text-white hover:bg-brand-light rounded-xl shadow cursor-pointer">Salvar Alterações</button>
      </div>
    </form>

  </div>
</div>

<!-- MODAL DE IMPORTAÇÃO AUTOMÁTICA DE CSV DO FECHAMENTO DE CAIXA -->
<div id="import-csv-modal" class="fixed inset-0 bg-black/75 backdrop-blur-md z-[80] hidden flex items-center justify-center p-3 sm:p-6 overflow-y-auto" onclick="closeImportCsvModal()">
  <div class="bg-white rounded-3xl shadow-2xl max-w-4xl w-full max-h-[92vh] flex flex-col border border-gray-200 overflow-hidden" onclick="event.stopPropagation()">
    
    <!-- CABEÇALHO DO MODAL -->
    <div class="bg-slate-900 text-white p-5 sm:p-6 flex items-center justify-between gap-4 border-b border-slate-800 shrink-0">
      <div class="space-y-1">
        <div class="flex items-center gap-2">
          <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 uppercase tracking-widest">Importador de Arquivo CSV</span>
          <span class="text-slate-400 text-xs font-mono">• Delimitado por Ponto e Vírgula (;)</span>
        </div>
        <h2 class="text-xl sm:text-2xl font-black tracking-tight text-white flex items-center gap-2.5 font-mono">
          <svg class="w-6 h-6 text-brand-gold shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>
          <span>Importar Relatório de Caixa (CSV)</span>
        </h2>
        <p class="text-xs text-slate-300 max-w-2xl font-sans">
          Selecione o arquivo CSV. O sistema ignorará a primeira linha e agrupará os lançamentos por data e recepção, definindo o status como <strong class="text-emerald-400">Conferido</strong>.
        </p>
      </div>

      <button onclick="closeImportCsvModal()" class="w-9 h-9 rounded-full bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white flex items-center justify-center text-lg font-bold transition-all cursor-pointer">
        &times;
      </button>
    </div>

    <!-- CORPO DO MODAL -->
    <div class="p-5 sm:p-6 overflow-y-auto space-y-6 flex-1 bg-gray-50/50">

      <!-- ZONA DE DROP E UPLOAD -->
      <div id="csv-upload-zone" class="border-2 border-dashed border-emerald-300 hover:border-emerald-500 bg-emerald-50/40 hover:bg-emerald-50 p-6 sm:p-8 rounded-3xl text-center transition-all cursor-pointer relative" onclick="document.getElementById('csv-file-input').click()">
        <input type="file" id="csv-file-input" accept=".csv,text/csv,text/plain" class="hidden" onchange="handleCsvFileSelected(event)">
        
        <div class="space-y-3 pointer-events-none">
          <div class="w-16 h-16 rounded-2xl bg-emerald-100 text-emerald-700 flex items-center justify-center mx-auto shadow-inner">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          </div>
          <div>
            <p class="text-sm font-black text-gray-800 font-mono">Clique para selecionar ou arraste o arquivo CSV aqui</p>
            <p class="text-xs text-gray-500 font-sans mt-0.5">Formato: Data do Fechamento *; Lançado Por; Tipo de pagamento; Valor; Recepção</p>
          </div>
          <span class="inline-block px-3 py-1 rounded-full text-[10px] font-bold font-mono bg-emerald-600 text-white shadow-sm">
            📄 Relatório de Caixa Formato CSV (ponto e vírgula)
          </span>
        </div>
      </div>

      <!-- ITEM SELECIONADO E PREVIEW -->
      <div id="csv-selected-preview" class="hidden bg-white p-4 rounded-2xl border border-gray-200 shadow-sm flex items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-800 flex items-center justify-center font-bold text-lg shrink-0">
            📊
          </div>
          <div class="truncate">
            <p id="csv-file-name" class="text-xs font-bold text-gray-900 font-mono truncate">relatorio_caixa.csv</p>
            <p id="csv-file-size" class="text-[10px] text-gray-500 font-mono">0 KB</p>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <button type="button" onclick="clearSelectedCsv()" class="text-xs font-bold text-rose-600 hover:text-rose-800 px-3 py-1.5 rounded-lg border border-rose-200 hover:bg-rose-50 transition-all cursor-pointer">
            Remover
          </button>
        </div>
      </div>

      <!-- RESULTADO DA LEITURA DO CSV -->
      <div id="csv-result-container" class="hidden space-y-5">
        
        <!-- HEADER RESUMO DO CSV -->
        <div class="bg-emerald-900 text-white p-4 sm:p-5 rounded-2xl shadow-md flex flex-col sm:flex-row sm:items-center justify-between gap-4 border border-emerald-800">
          <div class="space-y-1">
            <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-500/30 text-emerald-200 border border-emerald-400/30 uppercase">Leitura Concluída</span>
            <div id="csv-meta-info" class="text-xs font-bold font-mono text-emerald-100">
              Lançamentos Agrupados
            </div>
          </div>

          <div class="bg-emerald-950/80 p-3 rounded-xl border border-emerald-800 text-right">
            <span class="text-[10px] font-bold uppercase tracking-wider font-mono text-emerald-400 block">Total Geral Faturado</span>
            <span id="csv-total-geral" class="text-2xl font-black font-mono text-white">R$ 0,00</span>
          </div>
        </div>

        <!-- CARDS DOS GRUPOS ENCONTRADOS -->
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <h3 class="text-xs font-black font-mono uppercase text-gray-800 tracking-wider flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
              <span>Fechamentos de Caixa para Lançamento (Conferido):</span>
            </h3>
            <span class="text-[10px] text-gray-500 font-mono">Confira os agrupamentos por data antes de confirmar</span>
          </div>

          <div id="csv-grouped-list" class="space-y-4">
            <!-- Lista dinâmica dos fechamentos agrupados -->
          </div>
        </div>

      </div>

    </div>

    <!-- RODAPÉ DO MODAL -->
    <div class="bg-white p-4 border-t border-gray-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3 shrink-0">
      <p class="text-[11px] text-gray-500 font-mono flex items-center gap-1.5">
        <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <span>Os lançamentos serão importados com o status "Conferido" e integrados ao Financeiro.</span>
      </p>
      
      <div class="flex items-center justify-end gap-2 shrink-0">
        <button type="button" onclick="closeImportCsvModal()" class="px-4 py-2 rounded-xl text-xs font-bold font-mono text-gray-600 bg-gray-100 hover:bg-gray-200 transition-all cursor-pointer">
          Cancelar
        </button>
        <button type="button" id="btn-save-imported-csv-batch" onclick="saveImportedCsvBatch()" class="hidden px-6 py-2.5 rounded-xl text-xs font-black font-mono uppercase bg-emerald-600 hover:bg-emerald-700 text-white shadow-md transition-all cursor-pointer flex items-center gap-2">
          <span>⚡ Importar Lançamentos (Conferido)</span>
        </button>
      </div>
    </div>

  </div>
</div>

<!-- MODAL PARA EXCLUIR FECHAMENTOS POR MÊS -->
<div id="delete-month-modal" class="fixed inset-0 bg-black/75 backdrop-blur-md z-[80] hidden flex items-center justify-center p-4" onclick="closeDeleteMonthModal()">
  <div class="bg-white rounded-3xl shadow-2xl max-w-md w-full border border-gray-200 overflow-hidden" onclick="event.stopPropagation()">
    
    <div class="bg-rose-900 text-white p-5 flex items-center justify-between gap-4 border-b border-rose-800">
      <div class="flex items-center gap-2.5">
        <svg class="w-6 h-6 text-rose-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
        <h3 class="text-base font-black font-mono text-white">Excluir Lançamentos por Mês</h3>
      </div>
      <button onclick="closeDeleteMonthModal()" class="text-rose-200 hover:text-white text-xl font-bold">&times;</button>
    </div>

    <form action="/admin/recepcao/fechamento-caixa/delete-mes" method="POST" class="p-6 space-y-4">
      <p class="text-xs text-gray-600 font-sans">
        Selecione o mês para remover <strong>todos</strong> os registros de fechamento de caixa pertencentes a esse período.
      </p>

      <div>
        <label class="block text-xs font-bold text-gray-700 font-mono uppercase mb-1">Mês de Referência (AAAA-MM):</label>
        <input type="month" id="delete-mes-input" name="mes" required class="w-full text-sm font-bold font-mono p-3 rounded-xl border border-gray-300 bg-gray-50 focus:ring-2 focus:ring-rose-500 focus:outline-none">
      </div>

      <div class="p-3 bg-amber-50 border border-amber-200 rounded-xl text-[11px] text-amber-900 font-sans space-y-1">
        <strong class="font-bold font-mono uppercase text-amber-800 flex items-center gap-1">⚠️ Atenção:</strong>
        <p>Esta ação é irreversível. Todos os lançamentos do mês informado serão excluídos permanentemente.</p>
      </div>

      <div class="flex items-center justify-end gap-2 pt-2">
        <button type="button" onclick="closeDeleteMonthModal()" class="px-4 py-2 text-xs font-bold text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-xl cursor-pointer">
          Cancelar
        </button>
        <button type="submit" onclick="return confirm('Tem certeza que deseja EXCLUIR TODOS os lançamentos deste mês?')" class="px-5 py-2.5 text-xs font-black font-mono uppercase bg-rose-600 hover:bg-rose-700 text-white rounded-xl shadow cursor-pointer">
          🗑️ Confirmar Exclusão
        </button>
      </div>
    </form>

  </div>
</div>

<!-- MODAL DE VISUALIZAÇÃO DE IMAGEM EM TAMANHO REAL (PRINT DO SISTEMA) -->
