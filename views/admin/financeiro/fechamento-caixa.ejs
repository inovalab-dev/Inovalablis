    <button onclick="closeImageModal()" class="absolute -top-10 right-0 text-white hover:text-brand-gold text-sm font-bold cursor-pointer flex items-center gap-1">
      <span>&times; Fechar Visualização</span>
    </button>
    <img id="image-zoom-src" src="" alt="Print Ampliado" class="max-w-full max-h-[85vh] object-contain rounded-xl shadow-2xl border border-white/20">
  </div>
</div>

