  function autoCalcModalClt() {
    const adm = document.getElementById('acc-adm-val').value;
    if (!adm) {
      alert('Este colaborador não possui data de admissão cadastrada.');
      return;
    }

    const faltas = Number(document.getElementById('acc-faltas').value) || 0;
    const gozados = Number(document.getElementById('acc-dias-gozados').value) || 0;

    let admDate;
    if (adm.includes('/')) {
      const parts = adm.split('/');
      admDate = new Date(parts[2], parts[1] - 1, parts[0]);
    } else {
      const parts = adm.split('-');
      admDate = new Date(parts[0], parts[1] - 1, parts[2]);
    }

    if (isNaN(admDate.getTime())) {
      alert('Data de admissão inválida.');
      return;
    }

    const today = new Date('2026-07-22');
    let k = 1;
    while (true) {
      let nextEnd = new Date(admDate.getFullYear() + k, admDate.getMonth(), admDate.getDate() - 1);
      if (nextEnd > today && k > 1) break;
      k++;
      if (k > 50) break;
    }

    let kVencida = Math.max(1, k - 1);
    let vencidaEmDate = new Date(admDate.getFullYear() + kVencida, admDate.getMonth(), admDate.getDate() - 1);

    const pad = (n) => String(n).padStart(2, '0');
    const fmtBr = (d) => `${pad(d.getDate())}/${pad(d.getMonth() + 1)}/${d.getFullYear()}`;
    const fmtIso = (d) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;

    let concessiveEndDate = new Date(vencidaEmDate.getFullYear() + 1, vencidaEmDate.getMonth(), vencidaEmDate.getDate());
    let concederAvisoDate = new Date(concessiveEndDate.getTime() - (60 * 24 * 60 * 60 * 1000));
    let proximoDate = new Date(admDate.getFullYear() + kVencida + 1, admDate.getMonth(), admDate.getDate() - 1);

    let diasDireito = 30;
    if (faltas > 32) diasDireito = 0;
    else if (faltas >= 24) diasDireito = 12;
    else if (faltas >= 15) diasDireito = 18;
    else if (faltas >= 6) diasDireito = 24;

    let saldoAGozar = Math.max(0, diasDireito - gozados);

    document.getElementById('acc-vencida-em').value = fmtBr(vencidaEmDate);
    document.getElementById('acc-dias-direito').value = diasDireito;
    document.getElementById('acc-saldo').value = saldoAGozar;
    document.getElementById('acc-conceder-aviso').value = fmtIso(concederAvisoDate);
    document.getElementById('acc-proximo-vencimento').value = fmtBr(proximoDate);
  }

