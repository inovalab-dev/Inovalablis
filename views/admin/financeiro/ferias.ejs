  function renderCalendar(year, monthIndex) {
    const title = document.getElementById('calendar-month-title');
    if (title) {
      title.innerText = `${monthNames[monthIndex]} ${year}`;
    }

    const grid = document.getElementById('calendar-days-grid');
    if (!grid) return;
    grid.innerHTML = '';

    const firstDay = new Date(year, monthIndex, 1);
    const lastDay = new Date(year, monthIndex + 1, 0);
    const startDayOfWeek = firstDay.getDay();
    const totalDays = lastDay.getDate();

    for (let i = 0; i < startDayOfWeek; i++) {
      const emptyBox = document.createElement('div');
      emptyBox.className = 'bg-gray-50/40 rounded-xl min-h-[90px] border border-dashed border-gray-100/60';
      grid.appendChild(emptyBox);
    }

    for (let day = 1; day <= totalDays; day++) {
      const dayBox = document.createElement('div');
      const pad = (n) => String(n).padStart(2, '0');
      const monthStr = pad(monthIndex + 1);
      const dayStr = pad(day);
      const dateIso = `${year}-${monthStr}-${dayStr}`;

      const isToday = (year === 2026 && monthIndex === 6 && day === 22);

      dayBox.className = `p-2 rounded-xl border min-h-[95px] flex flex-col justify-between transition-all ${
        isToday ? 'bg-amber-50/80 border-amber-300 ring-2 ring-brand-gold/30' : 'bg-white border-gray-100 hover:border-gray-200'
      }`;

      let dayHeader = `
        <div class="flex items-center justify-between">
          <span class="text-xs font-mono font-bold ${isToday ? 'text-amber-900 font-black bg-amber-200 px-1.5 py-0.5 rounded-md' : 'text-gray-700'}">${day}</span>
          ${isToday ? '<span class="text-[9px] font-mono font-bold text-amber-800 uppercase">Hoje</span>' : ''}
        </div>
      `;

      let activeChips = [];
      if (allProfessionalsData && Array.isArray(allProfessionalsData)) {
        allProfessionalsData.forEach(p => {
          if (p.vacations && p.vacations.length > 0) {
            p.vacations.forEach((v, vIdx) => {
              if (v.startDate && v.endDate && dateIso >= v.startDate && dateIso <= v.endDate) {
                let firstName = p.name ? p.name.split(' ')[0] : 'Colaborador';
                let badgeColor = v.status === 'Gozadas' ? 'bg-emerald-100 text-emerald-900 border-emerald-300' : 'bg-amber-100 text-amber-900 border-amber-300';
                let startBr = v.startDate ? v.startDate.split('-').reverse().slice(0, 2).join('/') : '';
                let endBr = v.endDate ? v.endDate.split('-').reverse().slice(0, 2).join('/') : '';
                activeChips.push(`
                  <div class="px-1.5 py-0.5 rounded text-[9px] font-mono font-bold border ${badgeColor} flex items-center justify-between gap-1" title="${p.name} - ${v.status}: ${v.startDate} a ${v.endDate}">
                    <span class="truncate">🌴 ${firstName}</span>
                    <div class="flex items-center gap-0.5">
                      ${v.status !== 'Gozadas' ? `
                        <button onclick="event.stopPropagation(); confirmBaixaVacation('${p.id}', '${v.id || vIdx}', '${p.name.replace(/'/g, "\\'")}', '${startBr} a ${endBr}')" class="text-emerald-700 hover:text-emerald-950 font-black px-0.5 leading-none cursor-pointer" title="Dar Baixa nas Férias">&#10003;</button>
                      ` : ''}
                      <button onclick="event.stopPropagation(); confirmDeleteVacation('${p.id}', '${v.id || vIdx}', '${p.name.replace(/'/g, "\\'")}', '${startBr} a ${endBr}')" class="text-rose-600 hover:text-rose-900 font-black px-0.5 leading-none cursor-pointer" title="Remover agendamento de férias">&times;</button>
                    </div>
                  </div>
                `);
              }
            });
          }

          if (p.concederAvisoAte && p.concederAvisoAte === dateIso) {
            let firstName = p.name ? p.name.split(' ')[0] : 'Colaborador';
            activeChips.push(`
              <div class="px-1.5 py-0.5 rounded text-[9px] font-mono font-bold bg-rose-100 text-rose-900 border border-rose-300 truncate" title="Limite de Aviso Prévio CLT para ${p.name}">
                🚨 Limite CLT: ${firstName}
              </div>
            `);
          }
        });
      }

      dayBox.innerHTML = `
        <div>
          ${dayHeader}
          <div class="mt-1 space-y-1 overflow-y-auto max-h-[60px]">
            ${activeChips.join('')}
          </div>
        </div>
        <button onclick="openVacationModalWithDate('${dateIso}')" class="text-[9px] font-mono font-bold text-gray-400 hover:text-brand-dark mt-1 text-right w-full hover:underline">
          + agendar
        </button>
      `;

      grid.appendChild(dayBox);
    }
  }

