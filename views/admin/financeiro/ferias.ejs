  function calculateVacationDays() {
    const startVal = document.getElementById('form-start-date').value;
    const endVal = document.getElementById('form-end-date').value;
    const abonoSelect = document.getElementById('form-abono');
    const summaryBox = document.getElementById('vacation-days-summary');
    const requestedEl = document.getElementById('requested-days-val');
    const abonoEl = document.getElementById('abono-days-val');
    const totalEl = document.getElementById('total-days-val');
    const availableEl = document.getElementById('available-days-val');
    const alertEl = document.getElementById('vacation-balance-alert');
    const submitBtn = document.getElementById('submit-vacation-btn');
    const maxAvailable = Number(document.getElementById('form-max-available-days').value) || 0;

    let abonoDays = 0;
    if (abonoSelect && abonoSelect.value && abonoSelect.value !== 'Não') {
      const match = abonoSelect.value.match(/\d+/);
      if (match) abonoDays = parseInt(match[0], 10);
      else abonoDays = 10;
    }
    const abonoInput = document.getElementById('form-abono-days-hidden');
    if (abonoInput) abonoInput.value = abonoDays;

    let requestedDays = 0;
    if (startVal && endVal) {
      const s = new Date(startVal + 'T00:00:00');
      const e = new Date(endVal + 'T00:00:00');
      if (!isNaN(s.getTime()) && !isNaN(e.getTime()) && e >= s) {
        const diffTime = e - s;
        requestedDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)) + 1;
      } else if (e < s) {
        if (summaryBox) summaryBox.classList.remove('hidden');
        if (requestedEl) requestedEl.innerText = 'Data inválida';
        if (availableEl) availableEl.innerText = `${maxAvailable} dia(s)`;
        if (alertEl) {
          alertEl.innerText = '⚠️ A data de término deve ser posterior à data de início!';
          alertEl.classList.remove('hidden');
        }
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
        }
        return;
      }
    }

    const totalDays = requestedDays + abonoDays;

    if (summaryBox) summaryBox.classList.remove('hidden');
    if (requestedEl) requestedEl.innerText = `${requestedDays} dia(s)`;
    if (abonoEl) abonoEl.innerText = `${abonoDays} dia(s)`;
    if (totalEl) totalEl.innerText = `${totalDays} dia(s)`;
    if (availableEl) availableEl.innerText = `${maxAvailable} dia(s)`;

    if (totalDays > maxAvailable) {
      if (alertEl) {
        alertEl.innerText = `⚠️ Total a debitar (${totalDays}d = ${requestedDays}d gozo + ${abonoDays}d abono) excede o saldo disponível de ${maxAvailable}d!`;
        alertEl.classList.remove('hidden');
      }
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
      }
    } else {
      if (alertEl) alertEl.classList.add('hidden');
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
      }
    }
  }

  function validateVacationForm(event) {
    const startVal = document.getElementById('form-start-date').value;
    const endVal = document.getElementById('form-end-date').value;
    const maxAvailable = Number(document.getElementById('form-max-available-days').value) || 0;

    if (!startVal || !endVal) {
      alert('Por favor, selecione as datas de início e término das férias.');
      if (event) event.preventDefault();
      return false;
    }

    const s = new Date(startVal + 'T00:00:00');
    const e = new Date(endVal + 'T00:00:00');

    if (e < s) {
      alert('A data de término não pode ser anterior à data de início.');
      if (event) event.preventDefault();
      return false;
    }

    const requestedDays = Math.ceil((e - s) / (1000 * 60 * 60 * 24)) + 1;

    if (requestedDays > maxAvailable) {
      alert(`Atenção: Você solicitou ${requestedDays} dias de férias, mas o saldo disponível para este período aquisitivo é de apenas ${maxAvailable} dias.`);
      if (event) event.preventDefault();
      return false;
    }

    return true;
  }

