  function filterRows() {
    const searchInput = document.getElementById('search-name');
    const term = searchInput ? searchInput.value.toLowerCase().trim() : '';

    // 1. Relatório Contábil
    const reportRows = document.querySelectorAll('.report-row');
    reportRows.forEach(row => {
      const name = row.getAttribute('data-name') || '';
      const isGozada = row.getAttribute('data-gozada') === 'true';

      const matchesSearch = !term || name.includes(term);
      const matchesGozada = showGozadas || !isGozada;

      if (matchesSearch && matchesGozada) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });

    // 2. Timeline Gantt
    const ganttRows = document.querySelectorAll('.gantt-row');
    ganttRows.forEach(row => {
      const name = row.getAttribute('data-name') || '';
      const isGozada = row.getAttribute('data-gozada') === 'true';

      const matchesSearch = !term || name.includes(term);
      const matchesGozada = showGozadas || !isGozada;

      if (matchesSearch && matchesGozada) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });

    // 3. Férias já gozadas dentro dos meses no Gantt
    const gozadaChips = document.querySelectorAll('.gozada-chip');
    gozadaChips.forEach(chip => {
      if (showGozadas) {
        chip.style.display = '';
      } else {
        chip.style.display = 'none';
      }
    });
  }

