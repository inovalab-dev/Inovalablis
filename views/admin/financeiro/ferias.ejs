  function confirmDeleteVacation(profId, vacationIdOrIndex, profName, periodStr) {
    if (confirm(`Deseja realmente remover o agendamento de férias de ${profName} (${periodStr})?`)) {
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = '/admin/financeiro/rh/delete-vacation';

      const inputProf = document.createElement('input');
      inputProf.type = 'hidden';
      inputProf.name = 'profId';
      inputProf.value = profId;
      form.appendChild(inputProf);

      const inputVacId = document.createElement('input');
      inputVacId.type = 'hidden';
      inputVacId.name = 'vacationId';
      inputVacId.value = vacationIdOrIndex;
      form.appendChild(inputVacId);

      const inputVacIdx = document.createElement('input');
      inputVacIdx.type = 'hidden';
      inputVacIdx.name = 'vacationIndex';
      inputVacIdx.value = vacationIdOrIndex;
      form.appendChild(inputVacIdx);

      const inputRedir = document.createElement('input');
      inputRedir.type = 'hidden';
      inputRedir.name = 'redirectUrl';
      inputRedir.value = window.location.pathname + window.location.search;
      form.appendChild(inputRedir);

      document.body.appendChild(form);
      form.submit();
    }
  }

