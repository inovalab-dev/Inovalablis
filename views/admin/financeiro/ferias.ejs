  function onModalProfChange(preferredPeriodStr = null) {
    const profId = document.getElementById('form-prof-id').value;
    const periodSelect = document.getElementById('form-aquisitive-period-select');
    if (!periodSelect) return;

    periodSelect.innerHTML = '';

    if (!profId) {
      periodSelect.innerHTML = '<option value="">-- Selecione o Colaborador primeiro --</option>';
      document.getElementById('form-max-available-days').value = '0';
      calculateVacationDays();
      return;
    }

    const prof = allProfessionalsData ? allProfessionalsData.find(p => String(p.id) === String(profId)) : null;
    if (!prof) {
      periodSelect.innerHTML = '<option value="">-- Colaborador não encontrado --</option>';
      document.getElementById('form-max-available-days').value = '0';
      calculateVacationDays();
      return;
    }

    const periods = computeAllVacationPeriodsJS(prof);
    if (!periods || periods.length === 0) {
      const opt = document.createElement('option');
      opt.value = 'Aquisitivo Atual';
      opt.dataset.saldo = '30';
      opt.innerText = 'Aquisitivo Atual — Saldo: 30 dias';
      periodSelect.appendChild(opt);
    } else {
      periods.forEach((p) => {
        const opt = document.createElement('option');
        opt.value = p.aquisitivePeriod;
        opt.dataset.saldo = p.saldoAGozar;
        opt.dataset.diasDireito = p.diasDireito;
        opt.dataset.diasGozados = p.diasGozados;

        const badge = p.saldoAGozar === 0 ? '[Quitada]' : (p.isVencida ? '[Vencida]' : '[Atual]');
        const planStr = p.diasPlanejados > 0 ? ` | Planejados: ${p.diasPlanejados}d` : '';
        opt.innerText = `${badge} ${p.aquisitivePeriod} — Saldo: ${p.saldoAGozar} dias${planStr}`;

        periodSelect.appendChild(opt);
      });
    }

    if (preferredPeriodStr) {
      for (let i = 0; i < periodSelect.options.length; i++) {
        const val = periodSelect.options[i].value;
        if (val === preferredPeriodStr || val.includes(preferredPeriodStr) || preferredPeriodStr.includes(val)) {
          periodSelect.selectedIndex = i;
          break;
        }
      }
    }

    onModalPeriodChange();
  }

  function onModalPeriodChange() {
    const periodSelect = document.getElementById('form-aquisitive-period-select');
    if (!periodSelect || periodSelect.selectedIndex === -1) return;
    const selectedOpt = periodSelect.options[periodSelect.selectedIndex];
    if (selectedOpt && selectedOpt.dataset.saldo !== undefined) {
      document.getElementById('form-max-available-days').value = selectedOpt.dataset.saldo;
    } else {
      document.getElementById('form-max-available-days').value = '30';
