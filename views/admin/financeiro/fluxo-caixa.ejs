<%- include('../../partials/header') %>

<div class="flex-1 p-6 md:p-8 space-y-6">
  <!-- Cabeçalho -->
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 text-xs font-bold text-brand-dark uppercase tracking-wider font-mono">
        <span class="w-2 h-2 rounded-full bg-brand-gold animate-pulse"></span>
        Administração Financeira
      </div>
      <h1 class="text-3xl font-extrabold text-brand-neutralDark tracking-tight mt-1">Fluxo de Caixa Diário</h1>
      <p class="text-sm text-gray-500">Acompanhe e projete a saúde financeira diária do laboratório de forma simplificada.</p>
    </div>
  </div>

  <!-- Sub-Navegação Unificada -->
  <div class="flex border-b border-gray-200 mb-6 overflow-x-auto whitespace-nowrap">
    <a href="/admin/financeiro/dashboard" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-dashboard') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5">
      Dashboard
    </a>
    <a href="/admin/financeiro/relatorio-faturamento" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-relatorio-faturamento') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5">
      Relatório de Faturamento
    </a>
    <a href="/admin/financeiro/pessoas" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-pessoas') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5">
      Clientes / Fornecedores
    </a>
    <a href="/admin/financeiro/contas-pagar" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-contas-pagar') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5">
      Contas a Pagar
    </a>
    <a href="/admin/financeiro/contas-receber" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-contas-receber') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5">
      Contas a Receber
    </a>
    <a href="/admin/financeiro/fechamento-caixa" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && (page === 'admin-financeiro-fechamento-caixa' || page === 'admin-fechamento-caixa')) ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5">
      Fechamento de Caixa
    </a>
    <a href="/admin/financeiro/fluxo-caixa" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-fluxo-caixa') ? 'border-[#284701] text-[#284701]' : 'border-[#284701] text-[#284701]' %> transition-all flex items-center gap-1.5">
      Fluxo de Caixa
    </a>
    <a href="/admin/financeiro/dre" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-dre') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5" title="Demonstrativo de Resultado">
      Demonstrativo de Resultado
    </a>
    <a href="/admin/financeiro/movimentacoes" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-movimentacoes') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5">
      Movimentações
    </a>
    <a href="/admin/financeiro/configuracoes" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-configuracoes') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5">
      Configurações
    </a>
  </div>

  <!-- Filtros Principais -->
  <div class="bg-gray-50 border border-gray-200 p-5 rounded-2xl shadow-sm">
    <form method="GET" action="/admin/financeiro/fluxo-caixa" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 items-end">
      <!-- Mês / Ano -->
      <div class="flex flex-col gap-1.5">
        <label for="month-select" class="text-[10px] font-bold text-gray-500 uppercase tracking-wider font-mono">Mês/Ano</label>
        <select id="month-select" name="month" class="w-full text-xs font-mono font-bold bg-white border border-gray-300 rounded-lg px-3 py-2.5 focus:outline-none focus:ring-1 focus:ring-[#284701] text-gray-700">
          <% availableMonths.forEach(m => { %>
            <option value="<%= m %>" <%= selectedMonth === m ? 'selected' : '' %>>
              <%= m.split('-').reverse().join('/') %> (<%= formatMonthDisplay(m) %>)
            </option>
          <% }) %>
        </select>
      </div>

      <!-- Banco -->
      <div class="flex flex-col gap-1.5">
        <label for="bank-select" class="text-[10px] font-bold text-gray-500 uppercase tracking-wider font-mono">Banco</label>
        <select id="bank-select" name="bank" class="w-full text-xs font-sans bg-white border border-gray-300 rounded-lg px-3 py-2.5 focus:outline-none focus:ring-1 focus:ring-[#284701] text-gray-700">
          <option value="all" <%= selectedBank === 'all' ? 'selected' : '' %>>Selecione (Todos os Bancos)</option>
          <% if (settings && settings.bankAccounts) { %>
            <% settings.bankAccounts.forEach(b => { %>
              <option value="<%= b.name %>" <%= selectedBank === b.name ? 'selected' : '' %>><%= b.name %></option>
            <% }) %>
          <% } %>
        </select>
      </div>

      <!-- Filial -->
      <div class="flex flex-col gap-1.5">
        <label for="filial-select" class="text-[10px] font-bold text-gray-500 uppercase tracking-wider font-mono">Filial</label>
        <select id="filial-select" name="filial" class="w-full text-xs font-sans bg-white border border-gray-300 rounded-lg px-3 py-2.5 focus:outline-none focus:ring-1 focus:ring-[#284701] text-gray-700">
          <option value="Laboratório Inovalab" <%= selectedFilial === 'Laboratório Inovalab' ? 'selected' : '' %>>Laboratório Inovalab</option>
          <option value="all" <%= selectedFilial === 'all' ? 'selected' : '' %>>Todas as Filiais</option>
        </select>
      </div>

      <!-- Considerar Transferências -->
      <div class="flex flex-col gap-1.5 sm:col-span-2 lg:col-span-1">
        <div class="flex items-center justify-between sm:justify-start gap-4 h-[42px]">
          <span class="text-[10px] font-bold text-gray-500 uppercase tracking-wider font-mono">Considerar transferências</span>
          <div class="flex items-center gap-2">
            <input type="hidden" name="transfers" id="transfers-hidden" value="<%= considerTransfers ? 'yes' : 'no' %>">
            <button type="button" onclick="toggleTransfers()" id="transfers-btn" class="relative inline-flex h-6 w-11 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none <%= considerTransfers ? 'bg-[#059669]' : 'bg-gray-200' %>">
              <span class="sr-only">Toggle transfers</span>
              <span id="transfers-dot" class="pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out <%= considerTransfers ? 'translate-x-5' : 'translate-x-0' %>"></span>
            </button>
            <span id="transfers-label" class="text-xs font-bold text-gray-700"><%= considerTransfers ? 'Sim' : 'Não' %></span>
          </div>
        </div>
      </div>

      <!-- Botão Buscar -->
      <div class="sm:col-span-2 lg:col-span-4 mt-2">
        <button type="submit" class="w-full sm:w-auto px-6 py-2.5 bg-[#059669] hover:bg-[#047857] text-white font-bold text-xs font-mono uppercase tracking-wider rounded-lg transition-colors cursor-pointer shadow-sm">
          Buscar
        </button>
      </div>
    </form>
  </div>

  <!-- Tabelas Lado a Lado: Realizado vs Projetado -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    
    <!-- QUADRO 1: REALIZADO -->
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden flex flex-col">
      <!-- Cabeçalho do Quadro -->
      <div class="p-5 border-b border-gray-100 bg-gray-50/50 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
          <h2 class="text-lg font-black text-gray-800 tracking-tight">Realizado</h2>
          <p class="text-[10px] font-mono text-gray-400 uppercase tracking-wider mt-0.5">Fluxo de Caixa Efetivado no Período</p>
        </div>
        <div class="text-right">
          <p class="text-[10px] font-mono text-gray-400 uppercase tracking-wider">Saldo Final do Mês Anterior</p>
          <p class="text-base font-black <%= saldoAnteriorRealizado >= 0 ? 'text-gray-800' : 'text-rose-600' %>">
            <%= saldoAnteriorRealizado.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %>
          </p>
        </div>
      </div>

      <!-- Botão Imprimir do Quadro -->
      <div class="px-5 pt-4">
        <button onclick="printQuadro('realizado-print-area')" class="px-3 py-1.5 bg-[#059669] hover:bg-[#047857] text-white text-[10px] font-bold font-mono uppercase tracking-wider rounded transition-colors cursor-pointer flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0110.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0l.229 2.523a1.125 1.125 0 01-1.12 1.227H7.231c-.615 0-1.11-.474-1.12-1.088L6.34 18m11.32 0H6.34M18 10.5h.008v.008H18V10.5zm-1.8-3.6h.008v.008H16.2V6.9zM15 3h4.5a1.5 1.5 0 011.5 1.5V15a1.5 1.5 0 01-1.5 1.5H15M9 21h6"/></svg>
          Imprimir
        </button>
      </div>

      <!-- Tabela Realizado -->
      <div class="p-5 overflow-x-auto" id="realizado-print-area">
        <table class="w-full text-left text-xs font-sans">
          <thead>
            <tr class="border-b border-gray-200 text-gray-400 uppercase tracking-widest font-bold text-[10px] font-mono">
              <th class="py-3 w-12 text-center">Dia</th>
              <th class="py-3 text-right">Entradas</th>
              <th class="py-3 text-right">Saídas</th>
              <th class="py-3 text-right">Saldo do Dia</th>
              <th class="py-3 text-right">Saldo do Mês</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-50 text-gray-600 font-medium">
            <% dailyRealizado.forEach(row => { %>
              <tr class="hover:bg-gray-50">
                <td class="py-2.5 text-center font-bold text-gray-700 bg-gray-50/30"><%= row.day %></td>
                
                <!-- Entradas (Green if > 0) -->
                <td class="py-2.5 text-right font-mono <%= row.entradas > 0 ? 'text-emerald-600 font-bold' : 'text-gray-400' %>">
                  <%= row.entradas.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                </td>
                
                <!-- Saídas (Red if > 0) -->
                <td class="py-2.5 text-right font-mono <%= row.saidas > 0 ? 'text-rose-600 font-bold' : 'text-gray-400' %>">
                  <%= row.saidas.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                </td>
                
                <!-- Saldo do Dia -->
                <td class="py-2.5 text-right font-mono <%= row.saldoDia > 0 ? 'text-emerald-700' : (row.saldoDia < 0 ? 'text-rose-700' : 'text-gray-400') %>">
                  <%= row.saldoDia.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                </td>
                
                <!-- Saldo do Mês (Acumulado) -->
                <td class="py-2.5 text-right font-mono font-bold <%= row.saldoMes >= 0 ? 'text-gray-700' : 'text-rose-600' %>">
                  <%= row.saldoMes.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- QUADRO 2: PROJETADO -->
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden flex flex-col">
      <!-- Cabeçalho do Quadro -->
      <div class="p-5 border-b border-gray-100 bg-gray-50/50 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
          <h2 class="text-lg font-black text-gray-800 tracking-tight">Projetado</h2>
          <p class="text-[10px] font-mono text-gray-400 uppercase tracking-wider mt-0.5">Previsões baseadas em Contas a Pagar/Receber</p>
        </div>
        <div class="text-right">
          <p class="text-[10px] font-mono text-gray-400 uppercase tracking-wider">Saldo Final do Mês Anterior</p>
          <p class="text-base font-black <%= saldoAnteriorProjetado >= 0 ? 'text-gray-800' : 'text-rose-600' %>">
            <%= saldoAnteriorProjetado.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %>
          </p>
        </div>
      </div>

      <!-- Botão Imprimir do Quadro -->
      <div class="px-5 pt-4">
        <button onclick="printQuadro('projetado-print-area')" class="px-3 py-1.5 bg-[#059669] hover:bg-[#047857] text-white text-[10px] font-bold font-mono uppercase tracking-wider rounded transition-colors cursor-pointer flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0110.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0l.229 2.523a1.125 1.125 0 01-1.12 1.227H7.231c-.615 0-1.11-.474-1.12-1.088L6.34 18m11.32 0H6.34M18 10.5h.008v.008H18V10.5zm-1.8-3.6h.008v.008H16.2V6.9zM15 3h4.5a1.5 1.5 0 011.5 1.5V15a1.5 1.5 0 01-1.5 1.5H15M9 21h6"/></svg>
          Imprimir
        </button>
      </div>

      <!-- Tabela Projetado -->
      <div class="p-5 overflow-x-auto" id="projetado-print-area">
        <table class="w-full text-left text-xs font-sans">
          <thead>
            <tr class="border-b border-gray-200 text-gray-400 uppercase tracking-widest font-bold text-[10px] font-mono">
              <th class="py-3 w-12 text-center">Dia</th>
              <th class="py-3 text-right">Entradas</th>
              <th class="py-3 text-right">Saídas</th>
              <th class="py-3 text-right">Saldo do Dia</th>
              <th class="py-3 text-right">Saldo do Mês</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-50 text-gray-600 font-medium">
            <% dailyProjetado.forEach(row => { %>
              <tr class="hover:bg-gray-50">
                <td class="py-2.5 text-center font-bold text-gray-700 bg-gray-50/30"><%= row.day %></td>
                
                <!-- Entradas (Green if > 0) -->
                <td class="py-2.5 text-right font-mono <%= row.entradas > 0 ? 'text-emerald-600 font-bold' : 'text-gray-400' %>">
                  <%= row.entradas.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                </td>
                
                <!-- Saídas (Red if > 0) -->
                <td class="py-2.5 text-right font-mono <%= row.saidas > 0 ? 'text-rose-600 font-bold' : 'text-gray-400' %>">
                  <%= row.saidas.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                </td>
                
                <!-- Saldo do Dia -->
                <td class="py-2.5 text-right font-mono <%= row.saldoDia > 0 ? 'text-emerald-700' : (row.saldoDia < 0 ? 'text-rose-700' : 'text-gray-400') %>">
                  <%= row.saldoDia.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                </td>
                
                <!-- Saldo do Mês (Acumulado) -->
                <td class="py-2.5 text-right font-mono font-bold <%= row.saldoMes >= 0 ? 'text-gray-700' : 'text-rose-600' %>">
                  <%= row.saldoMes.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

  </div>
</div>

<script>
  function toggleTransfers() {
    const hiddenInput = document.getElementById('transfers-hidden');
    const dot = document.getElementById('transfers-dot');
    const btn = document.getElementById('transfers-btn');
    const label = document.getElementById('transfers-label');

    if (hiddenInput.value === 'yes') {
      hiddenInput.value = 'no';
      btn.classList.remove('bg-[#059669]');
      btn.classList.add('bg-gray-200');
      dot.classList.remove('translate-x-5');
      dot.classList.add('translate-x-0');
      label.innerText = 'Não';
    } else {
      hiddenInput.value = 'yes';
      btn.classList.remove('bg-gray-200');
      btn.classList.add('bg-[#059669]');
      dot.classList.remove('translate-x-0');
      dot.classList.add('translate-x-5');
      label.innerText = 'Sim';
    }
  }

  function printQuadro(divId) {
    const printContent = document.getElementById(divId).innerHTML;
    const originalContent = document.body.innerHTML;
    
    // Configurar o título do cabeçalho
    const isRealizado = divId.includes('realizado');
    const titulo = isRealizado ? 'Fluxo de Caixa Diário - Realizado' : 'Fluxo de Caixa Diário - Projetado';
    const monthName = "<%= formatMonthDisplay(selectedMonth) %>";

    document.body.innerHTML = `
      <div style="padding: 40px; font-family: sans-serif;">
        <h1 style="font-size: 20px; font-weight: bold; margin-bottom: 5px;">${titulo}</h1>
        <h2 style="font-size: 14px; color: #666; margin-bottom: 25px;">Período: ${monthName}</h2>
        ${printContent}
      </div>
    `;

    window.print();
    document.body.innerHTML = originalContent;
    window.location.reload(); // Recarrega para recuperar os eventos do DOM
  }
</script>

<%- include('../../partials/footer') %>
