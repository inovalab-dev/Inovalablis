<%- include('../../partials/header') %>

<div class="flex-1 p-6 md:p-8 space-y-6">
  <!-- Cabeçalho -->
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 text-xs font-bold text-brand-dark uppercase tracking-wider font-mono">
        <span class="w-2 h-2 rounded-full bg-brand-gold"></span>
        Administração Financeira
      </div>
      <h1 class="text-3xl font-extrabold text-brand-neutralDark tracking-tight mt-1">Movimentações Financeiras</h1>
      <p class="text-sm text-gray-500">Histórico de baixas e fluxo de caixa realizado com detalhamento de planos de contas e bancos.</p>
    </div>
    
    <div class="flex items-center gap-3">
      <button onclick="openAddMovementModal()" class="px-4 py-2.5 rounded-xl bg-[#009688] hover:bg-[#00796b] text-white font-bold text-sm flex items-center gap-2 transition-all shadow-sm cursor-pointer">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v6m3-3H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Nova Movimentação
      </button>
    </div>
  </div>

  <!-- Sub-Navegação Unificada -->
  <div class="flex border-b border-gray-200 mb-6 overflow-x-auto whitespace-nowrap">
    <a href="/admin/financeiro/dashboard" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-dashboard') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5">
      Dashboard
    </a>
    <a href="/admin/financeiro/relatorio-faturamento" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-relatorio-faturamento') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5">
      Relatório de Faturamento
    </a>
    <a href="/admin/financeiro/pessoas" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-pessoas') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5">
      Clientes / Fornecedores
    </a>
    <a href="/admin/financeiro/contas-pagar" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-contas-pagar') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5">
      Contas a Pagar
    </a>
    <a href="/admin/financeiro/contas-receber" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-contas-receber') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5">
      Contas a Receber
    </a>
    <a href="/admin/financeiro/fechamento-caixa" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && (page === 'admin-financeiro-fechamento-caixa' || page === 'admin-fechamento-caixa')) ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5">
      Fechamento de Caixa
    </a>
    <a href="/admin/financeiro/fluxo-caixa" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-fluxo-caixa') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5">
      Fluxo de Caixa
    </a>
    <a href="/admin/financeiro/dre" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-dre') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5" title="Demonstrativo de Resultado">
      Demonstrativo de Resultado
    </a>
    <a href="/admin/financeiro/movimentacoes" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-movimentacoes') ? 'border-[#284701] text-[#284701]' : 'border-[#284701] text-[#284701]' %> transition-all flex items-center gap-1.5">
      Movimentações
    </a>
    <a href="/admin/financeiro/configuracoes" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-configuracoes') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5">
      Configurações
    </a>
  </div>

  <!-- Seletor de Competência (Mês de Referência) -->
  <div class="bg-gradient-to-r from-emerald-500/10 via-brand-gold/10 to-transparent p-4 rounded-2xl border border-emerald-500/20 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-white flex items-center justify-center shadow-sm text-emerald-700">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5m-9-6h.008v.008H12v-.008zM12 15h.008v.008H12V15zm0 2.25h.008v.008H12v-.008zM9.75 15h.008v.008H9.75V15zm0 2.25h.008v.008H9.75v-.008zM7.5 15h.008v.008H7.5V15zm0 2.25h.008v.008H7.5v-.008zm6.75-4.5h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008V15zm0 2.25h.008v.008h-.008v-.008zm2.25-4.5h.008v.008H16.5v-.008zm0 2.25h.008v.008H16.5V15z"/>
        </svg>
      </div>
      <div>
        <p class="text-[10px] font-bold text-emerald-800 uppercase tracking-wider font-mono">Controle por Competência</p>
        <h2 class="text-sm font-bold text-gray-800">Visualizando competência de: <span class="text-[#284701] font-black"><%= formatCompetence(selectedCompetence) %></span></h2>
      </div>
    </div>
    
    <div class="flex items-center gap-2">
      <button onclick="navigateCompetence(-1)" class="p-2 rounded-lg bg-white border border-gray-200 hover:bg-gray-50 text-gray-600 transition-all shadow-sm cursor-pointer" title="Mês Anterior">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/></svg>
      </button>
      
      <select id="competence-select" onchange="changeCompetence(this.value)" class="text-xs font-mono font-bold bg-white border border-gray-200 rounded-lg px-4 py-2 focus:outline-none focus:ring-1 focus:ring-[#284701] text-gray-700 shadow-sm">
        <option value="all" <%= selectedCompetence === 'all' ? 'selected' : '' %>>Todos os Meses</option>
        <% availableCompetences.forEach(comp => { %>
          <option value="<%= comp %>" <%= selectedCompetence === comp ? 'selected' : '' %>><%= formatCompetence(comp) %></option>
        <% }) %>
      </select>
      
      <button onclick="navigateCompetence(1)" class="p-2 rounded-lg bg-white border border-gray-200 hover:bg-gray-50 text-gray-600 transition-all shadow-sm cursor-pointer" title="Próximo Mês">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
      </button>
    </div>
  </div>

  <!-- Cards de Indicadores / Resumo de Movimentações -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <!-- Total Recebido -->
    <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm flex items-center justify-between">
      <div>
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest font-mono">Entradas (Realizado)</p>
        <p class="text-2xl font-black text-emerald-600 mt-1">
          <%= new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(stats.totalRecebido) %>
        </p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-600">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m0 0l6.75-6.75M12 19.5l-6.75-6.75"/></svg>
      </div>
    </div>

    <!-- Total Pago -->
    <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm flex items-center justify-between">
      <div>
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest font-mono">Saídas (Realizado)</p>
        <p class="text-2xl font-black text-rose-600 mt-1">
          <%= new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(stats.totalPago) %>
        </p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-rose-50 flex items-center justify-center text-rose-600">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19.5v-15m0 0l-6.75 6.75M12 4.5l6.75 6.75"/></svg>
      </div>
    </div>

    <!-- Saldo Líquido -->
    <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm flex items-center justify-between">
      <div>
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest font-mono">Saldo Líquido no Período</p>
        <p class="text-2xl font-black mt-1 <%= stats.saldoNet >= 0 ? 'text-[#284701]' : 'text-rose-600' %>">
          <%= new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(stats.saldoNet) %>
        </p>
      </div>
      <div class="w-10 h-10 rounded-xl flex items-center justify-center <%= stats.saldoNet >= 0 ? 'bg-emerald-50 text-[#284701]' : 'bg-rose-50 text-rose-600' %>">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5h.007m-.007 3h.007m-.007 3h.007m-2.25 9h16.5m-16.5 0a2.25 2.25 0 01-2.25-2.25V5.25A2.25 2.25 0 013.75 3h16.5a2.25 2.25 0 012.25 2.25v13.5a2.25 2.25 0 01-2.25 2.25M16.5 7.5h.007v.008H16.5V7.5zm0 3h.007v.008H16.5v-.008zm0 3h.007v.008H16.5v-.008z"/></svg>
      </div>
    </div>
  </div>

  <!-- Filtros -->
  <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm">
    <h3 class="text-xs font-bold text-brand-dark uppercase tracking-wider font-mono mb-4 flex items-center gap-1.5">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 01-.659 1.591l-5.432 5.432a2.25 2.25 0 00-.659 1.591v2.927a2.25 2.25 0 01-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 00-.659-1.591L3.659 7.409A2.25 2.25 0 013 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0112 3z"/></svg>
      Filtros de Pesquisa
    </h3>
    
    <form action="/admin/financeiro/movimentacoes" method="GET" class="grid grid-cols-1 md:grid-cols-6 gap-3">
      <!-- Código -->
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase font-mono mb-1">Código</label>
        <input type="text" name="code" value="<%= filters.code || '' %>" placeholder="Ex: 361" class="w-full text-xs bg-brand-neutralLight border border-gray-200 rounded-lg p-2 focus:outline-none focus:ring-1 focus:ring-brand-dark">
      </div>

      <!-- Data Inicial -->
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase font-mono mb-1">Data Inicial</label>
        <input type="date" name="start_date" value="<%= filters.start_date || '' %>" class="w-full text-xs bg-brand-neutralLight border border-gray-200 rounded-lg p-2 focus:outline-none focus:ring-1 focus:ring-brand-dark">
      </div>

      <!-- Data Final -->
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase font-mono mb-1">Data Final</label>
        <input type="date" name="end_date" value="<%= filters.end_date || '' %>" class="w-full text-xs bg-brand-neutralLight border border-gray-200 rounded-lg p-2 focus:outline-none focus:ring-1 focus:ring-brand-dark">
      </div>

      <!-- Plano de Contas -->
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase font-mono mb-1">Plano de Contas</label>
        <select name="chart" class="w-full text-xs bg-brand-neutralLight border border-gray-200 rounded-lg p-2 focus:outline-none focus:ring-1 focus:ring-brand-dark">
          <option value="all">Selecione</option>
          <% settings.chartsOfAccounts.forEach(c => { %>
            <option value="<%= c %>" <%= filters.chart === c ? 'selected' : '' %>><%= c %></option>
          <% }) %>
        </select>
      </div>

      <!-- Banco -->
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase font-mono mb-1">Bancos</label>
        <select name="bank" class="w-full text-xs bg-brand-neutralLight border border-gray-200 rounded-lg p-2 focus:outline-none focus:ring-1 focus:ring-brand-dark">
          <option value="all">Selecione</option>
          <% (settings.banks || []).forEach(b => { %>
            <option value="<%= b %>" <%= filters.bank === b ? 'selected' : '' %>><%= b %></option>
          <% }) %>
          <% (settings.bankAccounts || []).forEach(ba => { %>
            <% if (!(settings.banks || []).includes(ba.description)) { %>
              <option value="<%= ba.description %>" <%= filters.bank === ba.description ? 'selected' : '' %>><%= ba.description %></option>
            <% } %>
          <% }) %>
        </select>
      </div>

      <!-- Complemento -->
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase font-mono mb-1">Complemento</label>
        <div class="flex gap-2">
          <input type="text" name="complemento" value="<%= filters.complemento || '' %>" placeholder="Digite o complemento" class="w-full text-xs bg-brand-neutralLight border border-gray-200 rounded-lg p-2 focus:outline-none focus:ring-1 focus:ring-brand-dark">
          <button type="submit" class="p-2 bg-[#009688] text-white rounded-lg hover:bg-[#00796b] transition-all shrink-0 cursor-pointer">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          </button>
        </div>
      </div>
    </form>
    
    <% if (Object.keys(filters).length > 0 && (filters.code || filters.start_date || filters.end_date || filters.chart || filters.bank || filters.complemento)) { %>
      <div class="flex justify-end mt-3">
        <a href="/admin/financeiro/movimentacoes" class="text-xs font-bold text-rose-600 hover:underline flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
          Limpar Filtros ativos
        </a>
      </div>
    <% } %>
  </div>

  <!-- Listagem de Movimentações -->
  <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
    <div class="p-5 border-b border-gray-100 flex items-center justify-between">
      <div>
        <h2 class="text-base font-bold text-brand-neutralDark">Movimentações Realizadas</h2>
        <p class="text-xs text-gray-400 mt-0.5">Mostrando <%= movements.length %> lançamentos efetivados.</p>
      </div>
    </div>

    <% if (movements.length === 0) { %>
      <div class="p-12 text-center">
        <div class="w-16 h-16 rounded-full bg-brand-softBg flex items-center justify-center text-brand-dark mx-auto mb-4">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M12 16c1.657 0 3-.895 3-2s-1.343-2-3-2m-3-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2"/></svg>
        </div>
        <h3 class="text-sm font-bold text-brand-neutralDark">Nenhuma movimentação encontrada</h3>
        <p class="text-xs text-gray-400 mt-1">Nenhum registro corresponde aos filtros selecionados.</p>
      </div>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs">
          <thead>
            <tr class="bg-brand-softBg/50 text-[10px] font-bold text-brand-dark uppercase tracking-wider font-mono border-b border-gray-100">
              <th class="p-4 w-12 text-center">
                <input type="checkbox" class="rounded text-brand-dark focus:ring-brand-dark">
              </th>
              <th class="p-4">Código</th>
              <th class="p-4">Data Movimentação</th>
              <th class="p-4">Plano de Contas</th>
              <th class="p-4">Complemento</th>
              <th class="p-4">Banco</th>
              <th class="p-4 text-right">Valor</th>
              <th class="p-4 text-center w-20">Ações</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 text-gray-700">
            <% movements.forEach(m => { %>
              <tr class="hover:bg-gray-50/70 transition-all">
                <td class="p-4 text-center">
                  <input type="checkbox" class="rounded text-brand-dark focus:ring-brand-dark">
                </td>
                <td class="p-4">
                  <span class="font-bold text-gray-800 block"><%= m.code %></span>
                  <span class="text-[9px] font-mono font-bold uppercase tracking-wider text-gray-400 block mt-0.5">
                    <%= m.type === 'receber' ? 'Contas a receber' : 'Contas a pagar' %>
                  </span>
                </td>
                <td class="p-4 font-mono font-semibold text-gray-500">
                  <%= m.date ? m.date.split('-').reverse().join('/') : '' %>
                </td>
                <td class="p-4 font-semibold text-gray-600">
                  <%= m.chartOfAccounts %>
                </td>
                <td class="p-4 text-gray-500 italic max-w-[250px] truncate" title="<%= m.complemento %>">
                  <%= m.complemento || '-' %>
                </td>
                <td class="p-4 text-gray-600 font-medium">
                  <%= m.bank %>
                </td>
                <td class="p-4 text-right font-mono font-bold <%= m.amount < 0 ? 'text-rose-600' : 'text-emerald-600' %>">
                  <%= m.amount < 0 ? '-' : '' %>R$ <%= Math.abs(m.amount).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                </td>
                <td class="p-4 text-center">
                  <div class="relative inline-block text-left" id="action-container-<%= m.id %>">
                    <button onclick="toggleActionMenu('<%= m.id %>')" class="p-1 hover:bg-gray-100 rounded-lg transition-all focus:outline-none cursor-pointer">
                      <svg class="w-5 h-5 text-gray-500" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/>
                      </svg>
                    </button>
                    <!-- Menu suspenso de ações -->
                    <div id="action-menu-<%= m.id %>" class="hidden absolute right-0 mt-1 w-32 bg-white border border-gray-100 rounded-xl shadow-lg z-20 py-1 font-sans">
                      <form action="/admin/financeiro/movimentacoes/delete" method="POST" onsubmit="return confirm('Tem certeza que deseja excluir esta movimentação?')" class="block w-full">
                        <input type="hidden" name="id" value="<%= m.id %>">
                        <button type="submit" class="w-full text-left px-4 py-2 text-xs text-rose-600 hover:bg-rose-50 font-bold transition-all flex items-center gap-1.5 cursor-pointer">
                          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" /></svg>
                          Excluir log
                        </button>
                      </form>
                    </div>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<!-- Modal: Cadastro de Movimentações Financeiras -->
<div id="add-movement-modal" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50 p-4 transition-all overflow-y-auto">
  <div class="bg-white rounded-3xl w-full max-w-2xl overflow-hidden shadow-2xl relative fade-in my-8">
    <!-- Header -->
    <div class="px-6 py-5 border-b border-gray-100 flex items-center justify-between">
      <h2 class="text-lg font-black text-brand-neutralDark font-sans">Cadastro de Movimentações Financeiras</h2>
      <button onclick="closeAddMovementModal()" class="p-1.5 hover:bg-gray-100 rounded-full transition-all text-gray-400 hover:text-gray-600 cursor-pointer">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <!-- Body -->
    <form action="/admin/financeiro/movimentacoes/add" method="POST" class="p-6 space-y-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Código -->
        <div>
          <label class="block text-xs font-bold text-gray-500 mb-1 font-sans">Código</label>
          <input type="number" name="code" value="<%= movements.length > 0 ? (Math.max(...movements.map(m => m.code || 0)) + 1) : 362 %>" class="w-full text-xs bg-gray-100 text-gray-500 border border-gray-200 rounded-lg p-2.5 cursor-not-allowed focus:outline-none" readonly>
        </div>

        <!-- Data Movimentação -->
        <div>
          <label class="block text-xs font-bold text-gray-700 mb-1 font-sans">Data Movimentação <span class="text-rose-500">*</span></label>
          <input type="date" name="date" required value="<%= new Date().toISOString().split('T')[0] %>" class="w-full text-xs bg-brand-neutralLight border border-gray-200 rounded-lg p-2.5 focus:outline-none focus:ring-1 focus:ring-brand-dark">
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Tipo de Movimentação (Pagar / Receber) -->
        <div>
          <label class="block text-xs font-bold text-gray-700 mb-1 font-sans">Tipo <span class="text-rose-500">*</span></label>
          <select name="type" required class="w-full text-xs bg-brand-neutralLight border border-gray-200 rounded-lg p-2.5 focus:outline-none focus:ring-1 focus:ring-brand-dark">
            <option value="pagar" selected>Contas a pagar</option>
            <option value="receber">Contas a receber</option>
          </select>
        </div>

        <!-- Valor Pago -->
        <div>
          <label class="block text-xs font-bold text-gray-700 mb-1 font-sans">Valor Pago <span class="text-rose-500">*</span></label>
          <div class="relative">
            <span class="absolute left-3 top-2.5 text-xs text-gray-400 font-sans">R$</span>
            <input type="text" name="amount" required placeholder="0,00" class="w-full text-xs bg-brand-neutralLight border border-gray-200 rounded-lg p-2.5 pl-8 focus:outline-none focus:ring-1 focus:ring-brand-dark font-mono">
          </div>
        </div>
      </div>

      <!-- Plano de Contas -->
      <div>
        <label class="block text-xs font-bold text-gray-700 mb-1 font-sans">Plano de Contas <span class="text-rose-500">*</span></label>
        <select name="chartOfAccounts" required class="w-full text-xs bg-brand-neutralLight border border-gray-200 rounded-lg p-2.5 focus:outline-none focus:ring-1 focus:ring-brand-dark">
          <option value="">Selecione</option>
          <% settings.chartsOfAccounts.forEach(c => { %>
            <option value="<%= c %>"><%= c %></option>
          <% }) %>
        </select>
      </div>

      <!-- Banco -->
      <div>
        <label class="block text-xs font-bold text-gray-700 mb-1 font-sans">Banco <span class="text-rose-500">*</span></label>
        <select name="bank" required class="w-full text-xs bg-brand-neutralLight border border-gray-200 rounded-lg p-2.5 focus:outline-none focus:ring-1 focus:ring-brand-dark">
          <option value="">Selecione</option>
          <% (settings.banks || []).forEach(b => { %>
            <option value="<%= b %>"><%= b %></option>
          <% }) %>
          <% (settings.bankAccounts || []).forEach(ba => { %>
            <% if (!(settings.banks || []).includes(ba.description)) { %>
              <option value="<%= ba.description %>"><%= ba.description %></option>
            <% } %>
          <% }) %>
        </select>
      </div>

      <!-- Complemento -->
      <div>
        <label class="block text-xs font-bold text-gray-700 mb-1 font-sans">Complemento</label>
        <textarea name="complemento" rows="3" placeholder="Digite o complemento ou observações" class="w-full text-xs bg-brand-neutralLight border border-gray-200 rounded-lg p-2.5 focus:outline-none focus:ring-1 focus:ring-brand-dark font-sans"></textarea>
      </div>

      <!-- Footer Actions -->
      <div class="pt-4 border-t border-gray-100 flex justify-end gap-3">
        <button type="button" onclick="closeAddMovementModal()" class="px-5 py-2.5 text-xs font-bold font-mono uppercase tracking-wider text-gray-500 hover:bg-gray-50 rounded-xl transition-all border border-gray-200 cursor-pointer">
          Cancelar
        </button>
        <button type="submit" class="px-6 py-2.5 text-xs font-bold font-mono uppercase tracking-wider text-white bg-[#009688] hover:bg-[#00796b] rounded-xl transition-all shadow-md active:scale-95 cursor-pointer">
          Salvar
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  // Controle de menus de ação individuais
  function toggleActionMenu(id) {
    const menu = document.getElementById('action-menu-' + id);
    const allMenus = document.querySelectorAll('[id^="action-menu-"]');
    
    // Fecha todos os outros menus
    allMenus.forEach(m => {
      if (m.id !== 'action-menu-' + id) {
        m.classList.add('hidden');
      }
    });

    if (menu) {
      menu.classList.toggle('hidden');
    }
  }

  // Fecha menus de ação ao clicar fora
  document.addEventListener('click', function(e) {
    const isActionButton = e.target.closest('[id^="action-container-"]');
    if (!isActionButton) {
      const allMenus = document.querySelectorAll('[id^="action-menu-"]');
      allMenus.forEach(menu => menu.classList.add('hidden'));
    }
  });

  // Modal handlers
  function openAddMovementModal() {
    const modal = document.getElementById('add-movement-modal');
    if (modal) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }
  }

  function closeAddMovementModal() {
    const modal = document.getElementById('add-movement-modal');
    if (modal) {
      modal.classList.remove('flex');
      modal.classList.add('hidden');
    }
  }

  // Funções para controle de Competência
  function changeCompetence(val) {
    const url = new URL(window.location.href);
    url.searchParams.set('competence', val);
    window.location.href = url.toString();
  }
  
  function navigateCompetence(direction) {
    const select = document.getElementById('competence-select');
    if (!select) return;
    const currentIndex = select.selectedIndex;
    // Ordem é decrescente (mais recente primeiro), então navegar para mês anterior (-1 na direção temporal) significa aumentar o index no select (+1 index)
    // Direção -1 (mês anterior): incrementa index
    // Direção 1 (mês posterior): decrementa index
    let nextIndex = currentIndex + (direction * -1);
    if (nextIndex >= 0 && nextIndex < select.options.length) {
      changeCompetence(select.options[nextIndex].value);
    }
  }
</script>

<%- include('../../partials/footer') %>
