<script>
  // Abrir modal de importação CSV
  function openImportModal() {
    document.getElementById('csv-file-input').value = '';
    document.getElementById('csv-text-input').value = '';
    document.getElementById('preview-container').classList.add('hidden');
    const modal = document.getElementById('import-modal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }

  // Fechar modal de importação CSV
  function closeImportModal() {
    const modal = document.getElementById('import-modal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }

  // Baixar Modelo de Arquivo CSV
  function downloadCsvTemplate() {
    const content = "Código;CPF/CNPJ;Nome;Tipo;Telefone;Email;Contato;Cidade;UF;Endereco;CEP;Aniversario;Observacao\n" +
                    "1;;Labingá;Fornecedor;;;;;AC;\", , \";;01/01/0001;\n" +
                    "2;12.345.678/0001-90;Fornecedor Exemplo LTDA;Fornecedor;(43) 99999-8888;contato@exemplo.com;João da Silva;Cambará;PR;Rua Dr. Miguel Pedroso, 100;86390-000;15/05/1985;Empresa parceira";
    
    const blob = new Blob(["\uFEFF" + content], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'modelo_importacao_clientes_fornecedores.csv';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  // Parser CSV no cliente para Pré-visualização
  function parseCsvClient(text) {
    if (!text) return [];
    const lines = text.replace(/^\uFEFF/, '').trim().split(/\r?\n/);
    if (lines.length === 0) return [];

    const firstLine = lines[0] || '';
    const semicolonCount = (firstLine.match(/;/g) || []).length;
    const commaCount = (firstLine.match(/,/g) || []).length;
    const delimiter = semicolonCount >= commaCount ? ';' : ',';

    const rows = [];
    for (let l of lines) {
      if (!l.trim()) continue;
      const fields = [];
      let cur = '';
      let inQuotes = false;
      for (let i = 0; i < l.length; i++) {
        const c = l[i];
        if (c === '"' || c === "'") {
          if (inQuotes && l[i + 1] === c) {
            cur += c;
            i++;
          } else {
            inQuotes = !inQuotes;
          }
        } else if (c === delimiter && !inQuotes) {
          fields.push(cur.trim());
          cur = '';
        } else {
          cur += c;
        }
      }
      fields.push(cur.trim());
      rows.push(fields);
    }
    return rows;
  }

  // Atualizar tabela de preview do CSV
  function updatePreview(csvText) {
    const container = document.getElementById('preview-container');
    const tbody = document.getElementById('preview-tbody');
    const summary = document.getElementById('preview-summary');

    if (!csvText || !csvText.trim()) {
      container.classList.add('hidden');
      return;
    }

    const rows = parseCsvClient(csvText);
    if (rows.length === 0) {
      container.classList.add('hidden');
      return;
    }

    let startIdx = 0;
    const headerRow = rows[0].map(h => h.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, ''));
    const hasHeader = headerRow.some(h => h.includes('nome') || h.includes('codigo') || h.includes('cpf') || h.includes('tipo'));
    if (hasHeader) startIdx = 1;

    let codeIdx = 0, cpfIdx = 1, nameIdx = 2, typeIdx = 3, phoneIdx = 4, cityIdx = 7, ufIdx = 8;
    if (hasHeader) {
      headerRow.forEach((col, idx) => {
        if (col.includes('codigo') || col.includes('code')) codeIdx = idx;
        else if (col.includes('cpf') || col.includes('cnpj')) cpfIdx = idx;
        else if (col.includes('nome') && !col.includes('contato')) nameIdx = idx;
        else if (col.includes('tipo')) typeIdx = idx;
        else if (col.includes('telef') || col.includes('cel')) phoneIdx = idx;
        else if (col.includes('cidade')) cityIdx = idx;
        else if (col.includes('uf')) ufIdx = idx;
      });
    }

    const validRows = [];
    for (let i = startIdx; i < rows.length; i++) {
      const r = rows[i];
      if (r && r[nameIdx] && r[nameIdx].trim()) {
        validRows.push(r);
      }
    }

    tbody.innerHTML = '';
    const previewRows = validRows.slice(0, 10);

    if (previewRows.length === 0) {
      container.classList.add('hidden');
      return;
    }

    previewRows.forEach(r => {
      const code = r[codeIdx] || '-';
      const name = r[nameIdx] || '-';
      const type = r[typeIdx] || 'Cliente';
      const cpf = r[cpfIdx] || '-';
      const phone = r[phoneIdx] || '-';
      const cityUf = (r[cityIdx] || r[ufIdx]) ? `${r[cityIdx] || ''} / ${r[ufIdx] || ''}` : '-';

      const tr = document.createElement('tr');
      tr.className = 'border-b border-gray-100 hover:bg-gray-50';
      tr.innerHTML = `
        <td class="p-2 font-mono text-gray-500 font-bold">${code}</td>
        <td class="p-2 font-semibold text-gray-800">${name}</td>
        <td class="p-2"><span class="px-2 py-0.5 rounded text-[10px] font-bold font-mono uppercase ${type.toLowerCase().includes('forneced') ? 'bg-amber-50 text-amber-700' : 'bg-emerald-50 text-emerald-700'}">${type}</span></td>
        <td class="p-2 font-mono text-gray-600">${cpf}</td>
        <td class="p-2 text-gray-600">${phone}</td>
        <td class="p-2 text-gray-600">${cityUf}</td>
      `;
      tbody.appendChild(tr);
    });

    summary.textContent = `Total de ${validRows.length} cadastros válidos prontos para importação.`;
    container.classList.remove('hidden');
  }

  // Manipular seleção de arquivo
  function handleFileSelect(event) {
    const file = event.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = function(e) {
      const text = e.target.result;
      document.getElementById('csv-text-input').value = text;
      updatePreview(text);
    };
    reader.readAsText(file, 'UTF-8');
  }

  // Manipular digitação/colagem manual de texto
  function handleTextInput() {
    const text = document.getElementById('csv-text-input').value;
    updatePreview(text);
  }

  // Abrir modal de cadastro vazio
  function openNewModal() {
    document.getElementById('form-id').value = '';
    document.getElementById('form-code').value = '';
    document.getElementById('form-persontype').value = 'Cliente';
    document.getElementById('form-cpfcnpj').value = '';
    document.getElementById('form-name').value = '';
    document.getElementById('form-birthday').value = '';
    document.getElementById('form-phone').value = '';
    document.getElementById('form-email').value = '';
    document.getElementById('form-contactname').value = '';
    document.getElementById('form-observation').value = '';
    document.getElementById('form-cep').value = '';
    document.getElementById('form-city').value = '';
    document.getElementById('form-uf').value = 'PR';
    document.getElementById('form-address').value = '';
    document.getElementById('form-bairro').value = '';
    document.getElementById('form-number').value = '';
    document.getElementById('form-complement').value = '';

    // Mostrar modal
    const modal = document.getElementById('cadastro-modal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }

  // Abrir modal de cadastro para edição
  function openEditModal(person) {
    document.getElementById('form-id').value = person.id || '';
    document.getElementById('form-code').value = person.code || '';
    document.getElementById('form-persontype').value = person.personType || 'Cliente';
    document.getElementById('form-cpfcnpj').value = person.cpfCnpj || '';
    document.getElementById('form-name').value = person.name || '';
    document.getElementById('form-birthday').value = person.birthday || '';
    document.getElementById('form-phone').value = person.phone || '';
    document.getElementById('form-email').value = person.email || '';
    document.getElementById('form-contactname').value = person.contactName || '';
    document.getElementById('form-observation').value = person.observation || '';
    document.getElementById('form-cep').value = person.cep || '';
    document.getElementById('form-city').value = person.city || '';
    document.getElementById('form-uf').value = person.uf || 'PR';
    document.getElementById('form-address').value = person.address || '';
    document.getElementById('form-bairro').value = person.bairro || '';
    document.getElementById('form-number').value = person.number || '';
    document.getElementById('form-complement').value = person.complement || '';

    // Mostrar modal
    const modal = document.getElementById('cadastro-modal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }

  // Fechar modal
  function closeModal() {
    const modal = document.getElementById('cadastro-modal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }

  // Filtrar tabela em tempo real (Pesquisa + Tipo + UF)
  function filterTable() {
    const searchQuery = document.getElementById('table-search').value.toLowerCase();
    const typeFilter = document.getElementById('filter-type').value;
    const stateFilter = document.getElementById('filter-state').value;
    const rows = document.querySelectorAll('#pessoas-table tbody tr');

    rows.forEach(row => {
      // Pular linha de "Nenhum registro"
      if (row.cells.length === 1) return;

      const rowText = row.getAttribute('data-search') || '';
      const rowType = row.getAttribute('data-type') || '';
      const rowUf = row.getAttribute('data-uf') || '';

      const matchesSearch = rowText.includes(searchQuery);
      const matchesType = (typeFilter === 'all' || rowType === typeFilter);
      const matchesState = (stateFilter === 'all' || rowUf === stateFilter);

      if (matchesSearch && matchesType && matchesState) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });
  }

  // Busca Automática de CEP (ViaCEP)
  async function buscarCEP(cep) {
    const cleanCep = cep.replace(/\D/g, '');
    if (cleanCep.length !== 8) return;

    const loadingIndicator = document.getElementById('cep-loading');
    loadingIndicator.classList.remove('hidden');

    try {
      const response = await fetch(`https://viacep.com.br/ws/${cleanCep}/json/`);
      const data = await response.json();
      
      if (!data.erro) {
        document.getElementById('form-city').value = data.localidade || '';
        document.getElementById('form-uf').value = data.uf || 'PR';
        document.getElementById('form-address').value = data.logradouro || '';
        document.getElementById('form-bairro').value = data.bairro || '';
        // Focar no número do endereço
        document.getElementById('form-number').focus();
      }
    } catch (err) {
      console.error("Erro ao buscar CEP:", err);
    } finally {
      loadingIndicator.classList.add('hidden');
    }
  }

  // Fechar modais ao clicar fora do card
  window.addEventListener('click', function(e) {
    const cadastroModal = document.getElementById('cadastro-modal');
    const importModal = document.getElementById('import-modal');
    if (e.target === cadastroModal) {
      closeModal();
    }
    if (e.target === importModal) {
      closeImportModal();
    }
  });
</script>

