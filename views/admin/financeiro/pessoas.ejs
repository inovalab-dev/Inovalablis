<%- include('../../partials/header') %>

<div class="flex-1 p-6 md:p-8 space-y-6">
  <!-- Cabeçalho -->
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 text-xs font-bold text-brand-dark uppercase tracking-wider font-mono">
        <span class="w-2 h-2 rounded-full bg-brand-gold animate-pulse"></span>
        Gestão Financeira
      </div>
      <h1 class="text-3xl font-extrabold text-brand-neutralDark tracking-tight mt-1">Clientes e Fornecedores</h1>
      <p class="text-sm text-gray-500">Cadastre e gerencie a base unificada de clientes, convênios e fornecedores do laboratório.</p>
    </div>
    
    <div class="flex items-center gap-2">
      <button onclick="openImportModal()" class="px-4 py-3 rounded-xl bg-white border border-gray-200 hover:bg-gray-50 text-gray-700 font-bold text-xs font-mono uppercase tracking-wider flex items-center gap-2 transition-all shadow-sm hover:shadow cursor-pointer active:scale-95">
        <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5"/></svg>
        Importar CSV
      </button>

      <button onclick="openNewModal()" class="px-5 py-3 rounded-xl bg-[#284701] hover:bg-[#3d6b1d] text-white font-bold text-xs font-mono uppercase tracking-wider flex items-center gap-2 transition-all shadow-md hover:shadow-lg cursor-pointer active:scale-95">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
        Cadastrar Pessoa
      </button>
    </div>
  </div>

  <!-- Sub-Navegação Unificada -->
  <div class="flex border-b border-gray-200 mb-6 overflow-x-auto whitespace-nowrap">
    <a href="/admin/financeiro/dashboard" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-dashboard') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5">
      Dashboard
    </a>
    <a href="/admin/financeiro/relatorio-faturamento" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-relatorio-faturamento') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5">
      Relatório de Faturamento
    </a>
    <a href="/admin/financeiro/pessoas" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-pessoas') ? 'border-[#284701] text-[#284701]' : 'border-[#284701] text-[#284701]' %> transition-all flex items-center gap-1.5">
      Clientes / Fornecedores
    </a>
    <a href="/admin/financeiro/contas-pagar" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-contas-pagar') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5">
      Contas a Pagar
    </a>
    <a href="/admin/financeiro/contas-receber" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-contas-receber') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5">
      Contas a Receber
    </a>
    <a href="/admin/financeiro/fechamento-caixa" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && (page === 'admin-financeiro-fechamento-caixa' || page === 'admin-fechamento-caixa')) ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5">
      Fechamento de Caixa
    </a>
    <a href="/admin/financeiro/fluxo-caixa" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-fluxo-caixa') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5">
      Fluxo de Caixa
    </a>
    <a href="/admin/financeiro/dre" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-dre') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5" title="Demonstrativo de Resultado">
      Demonstrativo de Resultado
    </a>
    <a href="/admin/financeiro/movimentacoes" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-movimentacoes') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5">
      Movimentações
    </a>
    <a href="/admin/financeiro/configuracoes" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 <%= (typeof page !== 'undefined' && page === 'admin-financeiro-configuracoes') ? 'border-[#284701] text-[#284701]' : 'border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300' %> transition-all flex items-center gap-1.5">
      Configurações
    </a>
  </div>

  <!-- Alertas de Feedback -->
  <% if (typeof success_msg !== 'undefined' && success_msg) { %>
    <div class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl text-sm font-semibold flex items-center gap-2 shadow-sm">
      <svg class="w-5 h-5 shrink-0 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      <%= success_msg %>
    </div>
  <% } %>
  <% if (typeof error_msg !== 'undefined' && error_msg) { %>
    <div class="p-4 bg-rose-50 border border-rose-200 text-rose-800 rounded-xl text-sm font-semibold flex items-center gap-2 shadow-sm">
      <svg class="w-5 h-5 shrink-0 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
      </svg>
      <%= error_msg %>
    </div>
  <% } %>

  <!-- Grid de mini-indicadores -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm flex items-center gap-4">
      <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z"/></svg>
      </div>
      <div>
        <p class="text-xs font-bold text-gray-400 uppercase font-mono tracking-wider">Total Geral</p>
        <p class="text-2xl font-black text-gray-800 leading-tight mt-0.5"><%= pessoas.length %></p>
      </div>
    </div>

    <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm flex items-center gap-4">
      <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
      </div>
      <div>
        <p class="text-xs font-bold text-gray-400 uppercase font-mono tracking-wider">Clientes / Convênios</p>
        <p class="text-2xl font-black text-emerald-700 leading-tight mt-0.5">
          <%= pessoas.filter(p => p.personType === 'Cliente').length %>
        </p>
      </div>
    </div>

    <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm flex items-center gap-4">
      <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center shrink-0">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
      </div>
      <div>
        <p class="text-xs font-bold text-gray-400 uppercase font-mono tracking-wider">Fornecedores / Parceiros</p>
        <p class="text-2xl font-black text-amber-700 leading-tight mt-0.5">
          <%= pessoas.filter(p => p.personType === 'Fornecedor').length %>
        </p>
      </div>
    </div>
  </div>

  <!-- Filtros e Barra de Pesquisa -->
  <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm space-y-4">
    <div class="flex flex-col md:flex-row gap-4 items-center justify-between">
      <div class="flex-1 w-full relative">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        </div>
        <input type="text" id="table-search" onkeyup="filterTable()" placeholder="Pesquise por nome, CPF/CNPJ, e-mail ou observações..." class="w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[#284701] focus:border-transparent transition-all">
      </div>
      
      <div class="flex gap-2 w-full md:w-auto">
        <select id="filter-type" onchange="filterTable()" class="w-full md:w-44 px-3 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[#284701] font-semibold text-gray-600 transition-all cursor-pointer">
          <option value="all">Todos os tipos</option>
          <option value="Cliente">Apenas Clientes</option>
          <option value="Fornecedor">Apenas Fornecedores</option>
        </select>
        
        <select id="filter-state" onchange="filterTable()" class="w-full md:w-32 px-3 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[#284701] font-semibold text-gray-600 transition-all cursor-pointer">
          <option value="all">Todas as UFs</option>
          <option value="PR">PR</option>
          <option value="SP">SP</option>
          <option value="SC">SC</option>
          <option value="RJ">RJ</option>
          <option value="MG">MG</option>
        </select>
      </div>
    </div>

    <!-- Tabela -->
    <div class="overflow-x-auto rounded-xl border border-gray-100">
      <table class="w-full text-left border-collapse text-sm" id="pessoas-table">
        <thead>
          <tr class="bg-gray-50 text-gray-400 font-mono text-[11px] uppercase tracking-wider border-b border-gray-100">
            <th class="p-4 text-center font-bold">Cód.</th>
            <th class="p-4 font-bold">Tipo</th>
            <th class="p-4 font-bold">Nome / Razão Social</th>
            <th class="p-4 font-bold">CPF / CNPJ</th>
            <th class="p-4 font-bold">Contato</th>
            <th class="p-4 font-bold">Localização</th>
            <th class="p-4 text-center font-bold">Ações</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 text-gray-700 font-sans">
          <% if (pessoas.length === 0) { %>
            <tr>
              <td colspan="7" class="p-8 text-center text-gray-400 italic">Nenhum registro encontrado. Cadastre um novo cliente ou fornecedor para começar.</td>
            </tr>
          <% } else { %>
            <% pessoas.forEach(p => { %>
              <tr class="hover:bg-gray-50/60 transition-all" data-type="<%= p.personType %>" data-uf="<%= p.uf %>" data-search="<%= (p.name + ' ' + (p.cpfCnpj || '') + ' ' + (p.email || '') + ' ' + (p.phone || '') + ' ' + (p.observation || '')).toLowerCase() %>">
                <td class="p-4 text-center font-mono font-bold text-gray-500"><%= p.code %></td>
                <td class="p-4">
                  <% if (p.personType === 'Cliente') { %>
                    <span class="px-2.5 py-1 text-[10px] font-bold font-mono uppercase tracking-wider rounded-full bg-emerald-50 text-emerald-700 border border-emerald-100">Cliente</span>
                  <% } else { %>
                    <span class="px-2.5 py-1 text-[10px] font-bold font-mono uppercase tracking-wider rounded-full bg-amber-50 text-amber-700 border border-amber-100">Fornecedor</span>
                  <% } %>
                </td>
                <td class="p-4">
                  <div class="font-bold text-gray-800 text-[14px]"><%= p.name %></div>
                  <% if (p.contactName) { %>
                    <div class="text-[11px] text-gray-400 font-medium">Contato: <%= p.contactName %></div>
                  <% } %>
                </td>
                <td class="p-4 font-mono text-gray-600 font-medium"><%= p.cpfCnpj || 'Não Informado' %></td>
                <td class="p-4 text-xs">
                  <% if (p.phone) { %>
                    <div class="flex items-center gap-1 text-gray-600 font-medium font-mono">
                      <svg class="w-3.5 h-3.5 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.94.725l.548 2.2a1 1 0 01-.321.988l-1.305.98a10.582 10.582 0 004.872 4.872l.98-1.305a1 1 0 01.988-.321l2.2.548a1 1 0 01.725.94V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                      <%= p.phone %>
                    </div>
                  <% } %>
                  <% if (p.email) { %>
                    <div class="flex items-center gap-1 text-gray-400 truncate max-w-[180px] mt-0.5" title="<%= p.email %>">
                      <svg class="w-3.5 h-3.5 text-gray-300 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                      <%= p.email %>
                    </div>
                  <% } %>
                </td>
                <td class="p-4 text-xs">
                  <div class="font-semibold text-gray-700"><%= p.city || 'Cambará' %> - <%= p.uf || 'PR' %></div>
                  <% if (p.address) { %>
                    <div class="text-[10px] text-gray-400 font-mono truncate max-w-[160px]" title="<%= p.address %>, <%= p.number %>"><%= p.address %>, <%= p.number %></div>
                  <% } %>
                </td>
                <td class="p-4 text-center">
                  <div class="flex items-center justify-center gap-2">
                    <button onclick="openEditModal(<%= JSON.stringify(p) %>)" class="p-1.5 bg-blue-50 text-blue-600 hover:bg-blue-100 rounded-lg transition-colors cursor-pointer" title="Editar">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                    </button>
                    
                    <form action="/admin/financeiro/pessoas/delete" method="POST" onsubmit="return confirm('Tem certeza que deseja excluir <%= p.name %>?')" class="inline">
                      <input type="hidden" name="id" value="<%= p.id %>">
                      <button type="submit" class="p-1.5 bg-rose-50 text-rose-600 hover:bg-rose-100 rounded-lg transition-colors cursor-pointer" title="Excluir">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- MODAL: CADASTRO DE CLIENTES E FORNECEDORES (FIEL À IMAGEM) -->
<div id="cadastro-modal" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50 p-4 overflow-y-auto transition-all">
  <div class="bg-white rounded-2xl w-full max-w-5xl shadow-2xl relative fade-in border border-gray-100 overflow-hidden my-8">
    
    <!-- Botão de Fechar no Canto -->
    <button onclick="closeModal()" class="absolute top-5 right-5 p-1.5 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-full transition-all cursor-pointer z-10">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>

    <!-- Header do Modal -->
    <div class="px-6 py-5 border-b border-gray-100 bg-gray-50/50">
      <h2 class="text-xl font-bold text-gray-800">Cadastro de Clientes e Fornecedores</h2>
    </div>

    <!-- Form de Cadastro -->
    <form action="/admin/financeiro/pessoas/save" method="POST" class="p-6 space-y-5 font-sans text-gray-700">
      <!-- Input Oculto de ID para Edição -->
      <input type="hidden" name="id" id="form-id" value="">

      <!-- Primeira Linha: Código, TipoPessoa, CPF/CNPJ -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
        <!-- Código -->
        <div class="md:col-span-3">
          <label class="block text-xs font-semibold text-gray-500 mb-1">Código</label>
          <input type="text" id="form-code" placeholder="Auto-gerado" readonly class="w-full text-sm bg-gray-100 border border-gray-200 rounded-lg p-2.5 focus:outline-none text-gray-500 font-mono font-bold">
        </div>
        
        <!-- TipoPessoa -->
        <div class="md:col-span-4">
          <label class="block text-xs font-semibold text-gray-500 mb-1">TipoPessoa</label>
          <select name="personType" id="form-persontype" class="w-full text-sm bg-white border border-gray-200 rounded-lg p-2.5 focus:outline-none focus:ring-1 focus:ring-[#284701] focus:border-[#284701] cursor-pointer">
            <option value="Cliente">Cliente</option>
            <option value="Fornecedor">Fornecedor</option>
          </select>
        </div>

        <!-- Cpf/Cnpj -->
        <div class="md:col-span-5">
          <label class="block text-xs font-semibold text-gray-500 mb-1">Cpf/Cnpj</label>
          <input type="text" name="cpfCnpj" id="form-cpfcnpj" placeholder="Digite apenas números ou formatado" class="w-full text-sm bg-white border border-gray-200 rounded-lg p-2.5 focus:outline-none focus:ring-1 focus:ring-[#284701] focus:border-[#284701] font-mono">
        </div>
      </div>

      <!-- Segunda Linha: Nome, Data de Aniversário -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
        <!-- Nome -->
        <div class="md:col-span-8">
          <label class="block text-xs font-semibold text-gray-500 mb-1">Nome <span class="text-rose-500 font-bold">*</span></label>
          <input type="text" name="name" id="form-name" required placeholder="Digite o nome ou razão social" class="w-full text-sm bg-white border border-gray-200 rounded-lg p-2.5 focus:outline-none focus:ring-1 focus:ring-[#284701] focus:border-[#284701]">
        </div>

        <!-- Data de Aniversário -->
        <div class="md:col-span-4">
          <label class="block text-xs font-semibold text-gray-500 mb-1">Data de Aniversário</label>
          <input type="text" name="birthday" id="form-birthday" placeholder="__/__/____" class="w-full text-sm bg-white border border-gray-200 rounded-lg p-2.5 focus:outline-none focus:ring-1 focus:ring-[#284701] focus:border-[#284701] font-mono">
        </div>
      </div>

      <!-- Terceira Linha: Telefone, E-mail -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Telefone -->
        <div>
          <label class="block text-xs font-semibold text-gray-500 mb-1">Telefone</label>
          <div class="relative">
            <input type="text" name="phone" id="form-phone" placeholder="(00) 00000-0000" class="w-full text-sm bg-white border border-gray-200 rounded-lg p-2.5 focus:outline-none focus:ring-1 focus:ring-[#284701] focus:border-[#284701] font-mono">
            <div class="absolute right-3.5 top-3 text-gray-300">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/></svg>
            </div>
          </div>
        </div>

