<%- include('../../partials/header') %>

<div class="p-4 md:p-8 w-full max-w-full mx-auto flex-1 flex flex-col gap-8 fade-in">
  
  <!-- Cabeçalho -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-brand-softBg custom-shadow">
    <div class="flex items-center gap-4">
      <div class="w-12 h-12 rounded-xl bg-[#284701]/10 text-[#284701] flex items-center justify-center shrink-0">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"/>
        </svg>
      </div>
      <div>
        <p class="text-xs font-bold text-brand-gold uppercase tracking-wider font-mono">Gestão Financeira</p>
        <h1 class="text-2xl font-black text-[#284701] tracking-tight">Plano de Contas Interativo</h1>
      </div>
    </div>
    
    <button onclick="openAddModal()" class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-[#284701] hover:bg-[#3d6b1d] text-white font-bold text-xs font-mono uppercase tracking-wider transition-all shadow-md active:scale-95">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
      </svg>
      Nova Conta / Sub-Conta
    </button>
  </div>

  <!-- Abas de Navegação Financeira -->
  <div class="flex flex-wrap border-b border-gray-200 gap-2">
    <a href="/admin/financeiro" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300 transition-all">
      Fluxo de Caixa
    </a>
    <a href="/admin/financeiro/contas-bancarias" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300 transition-all">
      Contas Bancárias
    </a>
    <a href="/admin/financeiro/documentos" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300 transition-all">
      Tipos de Documentos
    </a>
    <a href="/admin/financeiro/categorias" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 border-transparent text-gray-500 hover:text-[#284701] hover:border-gray-300 transition-all">
      Categorias
    </a>
    <a href="/admin/financeiro/plano-contas" class="px-4 py-2.5 font-bold text-xs uppercase tracking-wider font-mono border-b-2 border-[#284701] text-[#284701] transition-all">
      Plano de Contas
    </a>
  </div>

  <!-- Alertas de Feedback -->
  <% if (typeof success_msg !== 'undefined' && success_msg) { %>
    <div class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl text-sm font-semibold flex items-center gap-2">
      <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      <%= success_msg %>
    </div>
  <% } %>
  <% if (typeof error_msg !== 'undefined' && error_msg) { %>
    <div class="p-4 bg-rose-50 border border-rose-200 text-rose-800 rounded-xl text-sm font-semibold flex items-center gap-2">
      <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
      </svg>
      <%= error_msg %>
    </div>
  <% } %>

  <!-- Grid Principal -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    <!-- Árvore de Plano de Contas (2 colunas) -->
    <div class="lg:col-span-2 bg-white rounded-2xl border border-brand-softBg custom-shadow overflow-hidden flex flex-col">
      <div class="p-6 border-b border-brand-softBg bg-[#284701]/5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h2 class="text-lg font-bold text-[#284701] flex items-center gap-2">
            <svg class="w-5 h-5 text-brand-gold" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z"/>
            </svg>
            Estrutura de Contas
          </h2>
          <p class="text-xs text-brand-neutralDark/60 mt-1">
            Arraste os itens para reordenar ou aninhar. Os códigos numéricos serão <strong>recalculados de forma dinâmica</strong>.
          </p>
        </div>
        
        <div class="flex gap-2">
          <button onclick="saveTreeOrder()" id="btn-save-order" class="px-4 py-2 bg-[#284701] hover:bg-[#3d6b1d] text-white rounded-xl text-xs font-bold font-mono uppercase tracking-wider transition-all shadow-sm flex items-center gap-1.5 active:scale-95">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
            </svg>
            Salvar Árvore
          </button>
        </div>
      </div>

      <!-- Container da Árvore Interativa -->
      <div class="p-6 flex-1 bg-brand-softBg/10 overflow-y-auto max-h-[600px]">
        <div id="tree-container" class="space-y-1"></div>
      </div>
    </div>

    <!-- Direita: Instruções de Arraste e Form Rápido -->
    <div class="flex flex-col gap-6">
      <!-- Painel Informativo de Gestos -->
      <div class="bg-white p-6 rounded-2xl border border-brand-softBg custom-shadow">
        <h3 class="font-bold text-[#284701] text-sm flex items-center gap-2">
          <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          Como Reestruturar a Árvore
        </h3>
        <ul class="text-xs text-brand-neutralDark/70 mt-3 space-y-2 list-disc pl-4 font-sans leading-relaxed">
          <li><strong>Clique e segure</strong> o ícone de arrastar para mover uma conta.</li>
          <li><strong>Solte em cima</strong> de outra conta para transformá-la em <strong>sub-conta (filha)</strong>.</li>
          <li>Você também pode usar os botões <span class="bg-gray-100 px-1 py-0.5 rounded text-gray-800">Recuar</span> e <span class="bg-gray-100 px-1 py-0.5 rounded text-gray-800">Avançar</span> rápidos para reordenar níveis sem arrastar.</li>
          <li>Quando terminar de organizar, lembre-se de clicar no botão <strong>Salvar Árvore</strong> para persistir as alterações.</li>
        </ul>
      </div>

      <!-- Form de Novo Item do Plano -->
      <div class="bg-white rounded-2xl border border-brand-softBg custom-shadow overflow-hidden">
        <div class="p-5 border-b border-brand-softBg bg-[#284701]/5">
          <h3 class="font-bold text-[#284701] text-sm">Adicionar Conta Rápido</h3>
        </div>
        
        <form action="/admin/financeiro/plano-contas/add" method="POST" class="p-5 flex flex-col gap-4">
          <div>
            <label class="block text-[10px] font-bold text-brand-neutralDark/70 uppercase tracking-wider mb-1 font-mono">Descrição da Conta *</label>
            <input type="text" name="description" required placeholder="Ex: Tarifas Bancárias, Pró-Labore" class="w-full px-3 py-2 text-xs rounded-xl border border-brand-neutralDark/15 focus:border-[#284701] focus:ring focus:ring-[#284701]/10 font-semibold">
          </div>

          <div>
            <label class="block text-[10px] font-bold text-brand-neutralDark/70 uppercase tracking-wider mb-1 font-mono">Categoria de Plano *</label>
            <select name="categoryId" required class="w-full px-3 py-2 text-xs rounded-xl border border-brand-neutralDark/15 focus:border-[#284701] focus:ring focus:ring-[#284701]/10 font-semibold bg-white text-[#1b2914]">
              <% accountCategories.forEach(cat => { %>
                <option value="<%= cat.id %>"><%= cat.description %> (<%= cat.indicator %>)</option>
              <% }) %>
            </select>
          </div>

          <button type="submit" class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-[#284701] hover:bg-[#3d6b1d] text-white font-bold text-xs font-mono uppercase tracking-wider transition-all mt-2 shadow-sm active:scale-95">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
            </svg>
            Criar Conta
          </button>
        </form>
      </div>
    </div>

  </div>

</div>

<!-- MODAL: Adicionar Completo -->
