    <form action="/admin/financeiro/plano-contas/add" method="POST" class="p-6 flex flex-col gap-4">
      <div>
        <label class="block text-xs font-bold font-mono text-brand-neutralDark/70 uppercase tracking-wider mb-2">Descrição *</label>
        <input type="text" name="description" required placeholder="Ex: Aluguel, Insumos de TI" class="w-full px-4 py-3 rounded-xl border border-brand-neutralDark/15 focus:border-[#284701] focus:ring focus:ring-[#284701]/20 text-sm font-semibold transition-all">
      </div>

      <div>
        <label class="block text-xs font-bold font-mono text-brand-neutralDark/70 uppercase tracking-wider mb-2">Categoria *</label>
        <select name="categoryId" required class="w-full px-4 py-3 rounded-xl border border-brand-neutralDark/15 focus:border-[#284701] focus:ring focus:ring-[#284701]/20 text-sm font-semibold transition-all bg-white text-[#1b2914]">
