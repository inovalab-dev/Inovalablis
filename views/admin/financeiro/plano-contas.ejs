    <form action="/admin/financeiro/plano-contas/edit" method="POST" class="p-6 flex flex-col gap-4">
      <input type="hidden" name="id" id="edit-id">
      
      <div>
        <label class="block text-xs font-bold font-mono text-brand-neutralDark/70 uppercase tracking-wider mb-2">Descrição *</label>
        <input type="text" name="description" id="edit-description" required placeholder="Ex: Aluguel" class="w-full px-4 py-3 rounded-xl border border-brand-neutralDark/15 focus:border-[#284701] focus:ring focus:ring-[#284701]/20 text-sm font-semibold transition-all">
      </div>

