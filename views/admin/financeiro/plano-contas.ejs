        <select name="categoryId" id="edit-categoryId" required class="w-full px-4 py-3 rounded-xl border border-brand-neutralDark/15 focus:border-[#284701] focus:ring focus:ring-[#284701]/20 text-sm font-semibold transition-all bg-white text-[#1b2914]">
