          Salvar Alterações
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Scripts de Interação Drag & Drop / Reconstrução Local da Árvore -->
<script>
  // Carregar os dados originais passados do servidor
  let rawTree = <%- JSON.stringify(chartOfAccountsTree) %>;
  let rawCategories = <%- JSON.stringify(accountCategories) %>;

  // Renderizar a árvore dinamicamente com manipulação visual
  function renderTree() {
    const container = document.getElementById('tree-container');
    container.innerHTML = '';

    // Organizar itens em hierarquia
    const roots = buildHierarchy(rawTree);
    
    if (roots.length === 0) {
      container.innerHTML = '<p class="text-center text-gray-400 p-8">Nenhuma conta cadastrada.</p>';
      return;
    }

    roots.forEach(root => {
      container.appendChild(createTreeNodeElement(root, 0));
    });
  }

  // Organizar lista plana de contas em nós encadeados (filhos)
  function buildHierarchy(list) {
    const map = {};
    const roots = [];

    list.forEach(item => {
      map[item.id] = { ...item, children: [] };
    });

    list.forEach(item => {
      const node = map[item.id];
      if (item.parentId && map[item.parentId]) {
        map[item.parentId].children.push(node);
      } else {
        roots.push(node);
      }
    });

    // Ordenar recursivamente com base no código atual
    function sortNodes(nodes) {
      nodes.sort((a, b) => a.code.localeCompare(b.code, undefined, { numeric: true }));
      nodes.forEach(node => {
        if (node.children.length > 0) {
          sortNodes(node.children);
        }
      });
    }

    sortNodes(roots);
    return roots;
  }

  // Criar elemento HTML para cada nó da árvore
  function createTreeNodeElement(node, depth) {
    const div = document.createElement('div');
    div.className = 'tree-node flex flex-col gap-1 select-none transition-all';
    div.style.paddingLeft = (depth * 24) + 'px';
    div.dataset.id = node.id;
    div.draggable = true;

    // Encontrar informações de categoria
    const cat = rawCategories.find(c => c.id === node.categoryId) || {};
    const badgeColor = cat.indicator === 'Crédito' ? 'bg-emerald-50 text-emerald-700 border-emerald-100' : 'bg-rose-50 text-rose-700 border-rose-100';

    const row = document.createElement('div');
    row.className = 'flex items-center justify-between p-3.5 bg-white border border-brand-softBg hover:border-[#284701]/40 rounded-xl shadow-sm transition-all drag-item duration-150';

    row.innerHTML = `
      <div class="flex items-center gap-3">
        <!-- Ícone Drag Handle -->
        <div class="text-gray-300 hover:text-gray-600 cursor-grab active:cursor-grabbing p-1 shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75h16.5M3.75 9h16.5M3.75 14.25h16.5M3.75 19.5h16.5"/>
          </svg>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-2">
          <span class="text-xs font-mono font-bold text-[#284701] bg-[#284701]/5 border border-[#284701]/10 px-2 py-0.5 rounded">${node.code}</span>
          <span class="text-sm font-black text-brand-neutralDark">${node.description}</span>
          ${cat.description ? `<span class="px-2 py-0.5 text-[9px] font-bold font-mono uppercase rounded border ${badgeColor}">${cat.description}</span>` : ''}
        </div>
      </div>

      <!-- Ações rápidas -->
      <div class="flex items-center gap-1">
        <!-- Níveis rápidos de recuo e avanço -->
        <button type="button" onclick="changeNodeLevel('${node.id}', -1)" class="p-1 text-gray-400 hover:text-gray-800 rounded hover:bg-gray-100 transition-colors" title="Subir um nível (Reduzir recuo)">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/>
          </svg>
        </button>
        <button type="button" onclick="changeNodeLevel('${node.id}', 1)" class="p-1 text-gray-400 hover:text-gray-800 rounded hover:bg-gray-100 transition-colors" title="Avançar nível (Tornar sub-conta da conta anterior)">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/>
          </svg>
        </button>

        <div class="w-px h-4 bg-gray-200 mx-1"></div>

        <button type="button" onclick="editAccount(${JSON.stringify(node)})" class="p-1 text-gray-400 hover:text-[#284701] hover:bg-gray-50 rounded transition-colors" title="Editar">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125"/>
          </svg>
        </button>
        <button type="button" onclick="confirmDelete('${node.id}', '${node.description}')" class="p-1 text-gray-400 hover:text-rose-600 hover:bg-rose-50 rounded transition-colors" title="Excluir">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/>
          </svg>
        </button>
      </div>
    `;

    div.appendChild(row);

    // Adicionar Drag Events para HTML5 Drag & Drop
    div.addEventListener('dragstart', handleDragStart);
    div.addEventListener('dragover', handleDragOver);
    div.addEventListener('dragleave', handleDragLeave);
    div.addEventListener('drop', handleDrop);

    // Renderizar filhos
    if (node.children && node.children.length > 0) {
      const childContainer = document.createElement('div');
      childContainer.className = 'flex flex-col gap-1 w-full mt-1';
      node.children.forEach(child => {
        childContainer.appendChild(createTreeNodeElement(child, depth + 1));
      });
      div.appendChild(childContainer);
    }

    return div;
  }

  // Lógica de Drag & Drop
  let dragSrcId = null;

  function handleDragStart(e) {
    dragSrcId = this.dataset.id;
    e.dataTransfer.effectAllowed = 'move';
    e.dataTransfer.setData('text/plain', dragSrcId);
    this.classList.add('opacity-40');
    e.stopPropagation();
  }

  function handleDragOver(e) {
    if (e.preventDefault) {
      e.preventDefault();
    }
    const dropTarget = this.querySelector('.drag-item');
    if (dropTarget && this.dataset.id !== dragSrcId) {
      dropTarget.classList.add('bg-[#284701]/10', 'border-[#284701]/50', 'scale-[1.01]');
    }
    return false;
  }

  function handleDragLeave() {
    const dropTarget = this.querySelector('.drag-item');
    if (dropTarget) {
      dropTarget.classList.remove('bg-[#284701]/10', 'border-[#284701]/50', 'scale-[1.01]');
    }
  }

  function handleDrop(e) {
    e.stopPropagation();
    e.preventDefault();

    const targetId = this.dataset.id;
    const dropTarget = this.querySelector('.drag-item');
    if (dropTarget) {
      dropTarget.classList.remove('bg-[#284701]/10', 'border-[#284701]/50', 'scale-[1.01]');
    }

    const draggedNode = document.querySelector(`[data-id="${dragSrcId}"]`);
    if (draggedNode) {
      draggedNode.classList.remove('opacity-40');
    }

    if (dragSrcId === targetId) return;

    // Verificar se o target não é filho do arrastado (evitar loop infinito)
    if (isDescendant(dragSrcId, targetId)) {
      alert('Não é possível aninhar uma conta superior dentro de sua própria sub-conta.');
      return;
    }

    // Tornar o arrastado um filho do target
    const item = rawTree.find(x => x.id === dragSrcId);
    if (item) {
      item.parentId = targetId;
      recalculateCodesAndRender();
    }
  }

  // Mover nível do nó de forma rápida (botões de recuo)
  function changeNodeLevel(id, direction) {
    const node = rawTree.find(x => x.id === id);
    if (!node) return;

    if (direction === -1) {
      // Retirar recuo (Mover para o pai do pai)
      if (!node.parentId) return; // Já é raiz
      const parent = rawTree.find(x => x.id === node.parentId);
      node.parentId = parent ? parent.parentId : null;
    } else if (direction === 1) {
      // Aumentar recuo (Mover como filho do irmão anterior)
      const siblings = rawTree.filter(x => x.parentId === node.parentId);
      const idx = siblings.findIndex(x => x.id === id);
      if (idx <= 0) return; // Não tem irmão anterior
      node.parentId = siblings[idx - 1].id;
    }

    recalculateCodesAndRender();
  }

  // Verificar recursivamente se target é descendente de parent
  function isDescendant(parentId, targetId) {
    let current = rawTree.find(x => x.id === targetId);
    while (current && current.parentId) {
      if (current.parentId === parentId) return true;
      current = rawTree.find(x => x.id === current.parentId);
    }
    return false;
  }

  // Recalcular os caminhos numéricos (códigos) baseados na hierarquia e renderizar novamente
  function recalculateCodesAndRender() {
    const roots = buildHierarchy(rawTree);
    
    // Função recursiva para atualizar os códigos baseados na ordem e profundidade
    function updateCodes(nodes, parentCode = '') {
      nodes.forEach((node, index) => {
        const indexCode = String(index + 1);
        const newCode = parentCode ? `${parentCode}.${indexCode}` : indexCode;
        
        // Encontrar o item original no rawTree e atualizar o código
        const originalItem = rawTree.find(x => x.id === node.id);
        if (originalItem) {
          originalItem.code = newCode;
        }

        if (node.children && node.children.length > 0) {
          updateCodes(node.children, newCode);
        }
      });
    }

    updateCodes(roots);
    renderTree();
  }

  // Enviar a nova estrutura reorganizada para o servidor
  function saveTreeOrder() {
    const btn = document.getElementById('btn-save-order');
    btn.disabled = true;
    btn.innerHTML = `
      <svg class="animate-spin w-4 h-4 mr-1" viewBox="0 0 24 24" fill="none">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
      </svg>
      Salvando...
    `;

    fetch('/admin/financeiro/plano-contas/reorder', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ tree: rawTree })
    })
    .then(res => res.json())
    .then(data => {
      btn.disabled = false;
      btn.innerHTML = `
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
        </svg>
        Salvar Árvore
      `;
      if (data.success) {
        alert('Plano de contas e códigos dinâmicos salvos com sucesso!');
        window.location.reload();
      } else {
        alert('Erro ao salvar plano de contas: ' + (data.error || 'Erro desconhecido'));
      }
    })
    .catch(err => {
      btn.disabled = false;
      btn.innerHTML = `
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
        </svg>
        Salvar Árvore
      `;
      console.error('Erro de rede:', err);
      alert('Erro de rede ao salvar plano de contas.');
    });
  }

  // Modais de Edição e Adição
  function openModal(id) {
    const modal = document.getElementById(id);
    if (modal) {
      modal.classList.remove('hidden');
      setTimeout(() => {
        const dialog = modal.querySelector('div');
        if (dialog) {
          dialog.classList.remove('scale-95');
          dialog.classList.add('scale-100');
        }
      }, 50);
    }
  }

  function closeModal(id) {
    const modal = document.getElementById(id);
    if (modal) {
      const dialog = modal.querySelector('div');
      if (dialog) {
        dialog.classList.remove('scale-100');
        dialog.classList.add('scale-95');
      }
      setTimeout(() => {
        modal.classList.add('hidden');
      }, 150);
    }
  }

  function openAddModal() {
    openModal('add-modal');
  }

  function editAccount(account) {
    document.getElementById('edit-id').value = account.id;
    document.getElementById('edit-description').value = account.description;
    document.getElementById('edit-categoryId').value = account.categoryId;
    openModal('edit-modal');
  }

  function confirmDelete(id, description) {
    if (confirm('Deseja realmente excluir a conta "' + description + '"? Sub-contas dependentes também perderão sua referência.')) {
      window.location.href = '/admin/financeiro/plano-contas/delete/' + id;
    }
  }

  // Inicializar a árvore na carga da página
  document.addEventListener('DOMContentLoaded', () => {
    renderTree();
  });
</script>

