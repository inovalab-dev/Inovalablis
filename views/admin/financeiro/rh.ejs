      <div class="pt-2 flex justify-end gap-2">
        <button type="button" onclick="document.getElementById('modal-add-shift').classList.add('hidden')" class="px-4 py-2 bg-gray-100 text-gray-700 text-xs font-bold font-mono rounded-xl hover:bg-gray-200 uppercase">Cancelar</button>
        <button type="submit" class="px-4 py-2 bg-brand-dark hover:bg-emerald-900 text-white text-xs font-bold font-mono rounded-xl uppercase">Registrar Escala</button>
      </div>
    </form>
  </div>
</div>

<script>
  // Controlar Abas Principais
  function switchMainTab(tabId) {
    const cleanId = tabId.replace('tab-', 'main-');
    document.querySelectorAll('.main-section').forEach(sec => sec.classList.add('hidden'));
    document.querySelectorAll('.main-tab-btn').forEach(btn => btn.classList.remove('active', 'text-brand-gold', 'bg-white/10', 'border-l-4', 'border-brand-gold'));
    
    // Mostra seção ativa
    const secEl = document.getElementById('section-' + cleanId);
    const btnEl = document.getElementById('btn-' + cleanId);
    if (secEl) secEl.classList.remove('hidden');
    if (btnEl) btnEl.classList.add('active');
  }

  // Controlar Sub-abas de Colaboradores
  function switchSubTab(subTabId) {
    document.querySelectorAll('.sub-section').forEach(sec => sec.classList.add('hidden'));
    document.querySelectorAll('.sub-tab-btn').forEach(btn => btn.classList.remove('active', 'bg-brand-dark', 'text-white'));
    
    const secEl = document.getElementById('section-' + subTabId);
    const btnEl = document.getElementById('btn-' + subTabId);
    if (secEl) secEl.classList.remove('hidden');
    if (btnEl) btnEl.classList.add('active', 'bg-brand-dark', 'text-white');
  }

  // Inicializar com base nos parâmetros da URL
  window.addEventListener('DOMContentLoaded', () => {
    const urlParams = new URLSearchParams(window.location.search);
    const tabParam = urlParams.get('tab');
    if (tabParam) {
      switchMainTab('tab-' + tabParam);
    } else {
      switchMainTab('tab-dashboard');
    }

    const subTabParam = urlParams.get('subTab');
    if (subTabParam) {
      switchSubTab('sub-' + subTabParam);
    } else {
      switchSubTab('sub-salario');
    }
  });
</script>

<style>
  .main-tab-btn.active {
    border-bottom-color: #3b661d;
    color: #3b661d;
    background-color: rgb(240 253 244);
  }
  .sub-tab-btn {
    color: #4b5563;
    background-color: transparent;
  }
  .sub-tab-btn.active {
    background-color: #0c2010;
    color: #ffffff;
  }
</style>

