<!-- SCRIPTS DE INTERATIVIDADE E NAVEGAÇÃO ENTRE ABAS -->
<script>
  let currentActiveTab = 'naoEnviados';
  window.interfaceDataGlobal = <%- JSON.stringify(interfaceData || {}) %>;

  function switchTab(tabId) {
    currentActiveTab = tabId;
    try {
      localStorage.setItem('interfaceActiveTab', tabId);
    } catch(e) {}

    // Toggle Tab Buttons Styling
    const tabBtns = document.querySelectorAll('.tab-btn');
    tabBtns.forEach(btn => {
      btn.classList.remove('bg-[#284701]', 'text-white', 'shadow-xs');
      btn.classList.add('text-gray-600', 'hover:text-gray-900', 'hover:bg-gray-100');
    });

    const activeBtn = document.getElementById('tab-btn-' + tabId);
    if (activeBtn) {
      activeBtn.classList.remove('text-gray-600', 'hover:text-gray-900', 'hover:bg-gray-100');
      activeBtn.classList.add('bg-[#284701]', 'text-white', 'shadow-xs');
    }

    // Toggle Tab Content Panels
    const tabContents = document.querySelectorAll('.tab-content');
    tabContents.forEach(content => {
      content.classList.add('hidden');
    });

    const activeContent = document.getElementById('tab-content-' + tabId);
    if (activeContent) {
      activeContent.classList.remove('hidden');
    }

    applyInterfaceFilter();
  }

  // Restore active tab on DOM load
  document.addEventListener('DOMContentLoaded', () => {
    try {
      const savedTab = localStorage.getItem('interfaceActiveTab');
      if (savedTab && ['naoEnviados', 'processando', 'prontos', 'mensagens'].includes(savedTab)) {
        switchTab(savedTab);
      }
    } catch(e) {}
  });

  function applyInterfaceFilter() {
    const searchVal = (document.getElementById('filterSearchInput').value || '').trim().toLowerCase();
    const equipVal = document.getElementById('filterEquipment').value;

    const cards = document.querySelectorAll('#tab-content-' + currentActiveTab + ' .interface-card');
    cards.forEach(card => {
      const cardSearch = card.getAttribute('data-search') || '';
      const cardEquip = card.getAttribute('data-equipment') || '';

      const matchesSearch = !searchVal || cardSearch.includes(searchVal);
      const matchesEquip = equipVal === 'todos' || cardEquip.toLowerCase().includes(equipVal.toLowerCase());

      if (matchesSearch && matchesEquip) {
        card.classList.remove('hidden');
      } else {
        card.classList.add('hidden');
      }
    });
  }

  async function sendSingleOrder(orderId) {
    try {
      const res = await fetch('/api/interfaceamento/send-order', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: orderId })
      });
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      } else {
        alert(data.message || 'Erro ao enviar ordem para equipamento.');
      }
    } catch (err) {
      console.error(err);
      alert('Falha de conexão ao enviar ordem.');
    }
  }

  async function sendAllOrders() {
    if (!confirm('Deseja enviar todas as ordens de trabalho pendentes para os equipamentos de destino?')) return;
    try {
      const res = await fetch('/api/interfaceamento/send-all', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      } else {
        alert(data.message || 'Erro ao enviar exames.');
      }
    } catch (err) {
      console.error(err);
      alert('Falha de conexão.');
    }
  }

  async function simulateResult(procId, examCode) {
    let customVal = prompt(`Simular resultado para o exame ${examCode}:`, '');
    if (customVal === null) return; // user cancelled

    try {
      const res = await fetch('/api/interfaceamento/simulate-result', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: procId, customValue: customVal })
      });
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      } else {
        alert(data.message || 'Erro ao simular leitura do equipamento.');
      }
    } catch (err) {
      console.error(err);
      alert('Falha de conexão ao simular resultado.');
    }
  }

  async function clearLogs() {
    if (!confirm('Deseja limpar todos os registros do log de mensagens?')) return;
    try {
      const res = await fetch('/api/interfaceamento/clear-logs', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      }
    } catch (err) {
      console.error(err);
    }
  }

  async function clearFictitiousSamples() {
    if (!confirm('Deseja remover todas as amostras fictícias/de teste que não pertencem a nenhuma requisição real cadastrada no LIS?')) return;
    try {
      const res = await fetch('/api/interfaceamento/limpar-ficticias', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      const data = await res.json();
      if (data.success) {
        alert(`${data.removedCount || 0} amostra(s) fictícia(s) foram removida(s) com sucesso!`);
        window.location.reload();
      } else {
        alert(data.message || 'Erro ao remover amostras fictícias.');
      }
    } catch (err) {
      console.error(err);
      alert('Erro de conexão ao tentar limpar amostras fictícias.');
    }
  }

  async function clearAllInterfaceData() {
    if (!confirm('ATENÇÃO: Deseja realmente zerar todas as listas do interfaceamento (Não Enviados, Processando, Prontos)?')) return;
    try {
      const res = await fetch('/api/interfaceamento/limpar-tudo', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      const data = await res.json();
      if (data.success) {
        alert('Todas as listas de interfaceamento foram zeradas com sucesso!');
        window.location.reload();
      } else {
        alert(data.message || 'Erro ao zerar interfaceamento.');
      }
    } catch (err) {
      console.error(err);
      alert('Erro de conexão ao tentar zerar interfaceamento.');
    }
  }

  function reloadInterfaceData() {
    window.location.reload();
  }

  // Modals logic
  function viewAstmFrame(id, patient, exam, frame) {
    document.getElementById('astmModalPatient').innerText = patient;
    document.getElementById('astmModalExam').innerText = exam;
    document.getElementById('astmModalContent').innerText = frame;
    document.getElementById('astmModal').classList.remove('hidden');
  }

  function closeAstmModal() {
    document.getElementById('astmModal').classList.add('hidden');
  }

  function copyAstmFrameText() {
    const text = document.getElementById('astmModalContent').innerText;
    navigator.clipboard.writeText(text);
    alert('Frame ASTM copiado para a área de transferência!');
  }

  function parseResultValToLinhas(resultVal, defaultUnit, parsedValores) {
    let rawItems = [];

    if (Array.isArray(parsedValores) && parsedValores.length > 0) {
      parsedValores.forEach(pv => {
        const k = pv.label || pv.labelName || pv.rotulo || pv.key || pv.parametro || pv.PARAMETRO || pv.part1 || 'RESULTADO';
        const rawVal = pv.value !== undefined ? pv.value : (pv.valor !== undefined ? pv.valor : (pv.resultado !== undefined ? pv.resultado : ''));
        rawItems.push({ key: String(k), value: String(rawVal !== undefined && rawVal !== null ? rawVal : '').trim(), unit: pv.unit || pv.unidade });
      });
    } else if (Array.isArray(resultVal)) {
      resultVal.forEach(item => {
        if (item && typeof item === 'object') {
          const k = item.label || item.labelName || item.rotulo || item.part1 || item.PARAMETRO || item.key || item.parametro || 'RESULTADO';
          const rawVal = item.resultado !== undefined ? item.resultado : (item.value !== undefined ? item.value : item.valor);
          rawItems.push({ key: String(k), value: String(rawVal !== undefined && rawVal !== null ? rawVal : '').trim(), unit: item.unidade || item.unit });
        } else {
          rawItems.push({ key: 'RESULTADO', value: String(item).trim() });
        }
      });
    } else if (resultVal !== undefined && resultVal !== null && String(resultVal).trim() !== '') {
      rawItems.push({ key: 'RESULTADO', value: String(resultVal).trim() });
    }

    // Process rawItems to expand any composite strings containing '|', '\n' or ':'
    let expanded = [];
    rawItems.forEach(it => {
      const kUpper = String(it.key).replace(/:\s*$/, '').toUpperCase().trim();
      const valStr = String(it.value).trim();

      if ((kUpper === 'RESULTADO' || kUpper === 'VALOR' || kUpper === '' || kUpper === 'RESULT') && (valStr.includes('|') || valStr.includes('\n') || valStr.includes(':'))) {
        const segments = valStr.split(/[|\n]/).map(s => s.trim()).filter(Boolean);
        segments.forEach(seg => {
          if (seg.includes(':')) {
            const colonIdx = seg.indexOf(':');
            const pName = seg.substring(0, colonIdx).trim();
            const pVal = seg.substring(colonIdx + 1).trim();
            expanded.push({ key: pName, value: pVal, unit: it.unit });
          } else {
            expanded.push({ key: 'RESULTADO', value: seg, unit: it.unit });
          }
        });
      } else {
        expanded.push(it);
      }
    });

    if (expanded.length === 0) {
      return [{ part1: "RESULTADO:", PARAMETRO: "RESULTADO", resultado: "", unidade: defaultUnit || "" }];
    }

    return expanded.map(it => {
      let rawKey = String(it.key || 'RESULTADO').trim();
      let part1Formatted = rawKey;
      if (!part1Formatted.endsWith(':')) {
        part1Formatted += ':';
      }

      let rest = String(it.value || '').trim();
      let paramUnit = it.unit || defaultUnit || "";
      let valStr = rest;

      if (rest.includes(' ')) {
        const tokens = rest.split(/\s+/);
        valStr = tokens[0];
        if (!it.unit && tokens.length > 1) {
          paramUnit = tokens.slice(1).join(' ');
        }
      }

      let valNum = valStr;
      const parsedFloat = parseFloat(valStr.replace(',', '.'));
      if (!isNaN(parsedFloat) && isFinite(valStr.replace(',', '.'))) {
        valNum = valStr;
      }

      return {
        part1: part1Formatted,
        resultado: valNum,
        unidade: paramUnit
      };
    });
  }

  function showResultJson(reqCode, patName, patAge, examCode, examTitle, resultVal, unit, mat, equip, ref, parsedValores) {
    const linhas = parseResultValToLinhas(resultVal, unit, parsedValores);
    const jsonStructure = {
      paciente: {
        nome: patName,
        idade: patAge,
        medico: "Dr. Luís Guilherme de Souza Costa",
        convenio: "Hospital Municipal de Cambará",
        procedencia: "Coleta Hospit",
        dataRequisicao: new Date().toLocaleDateString('pt-BR'),
        dataEmissao: new Date().toLocaleDateString('pt-BR'),
        requisicaoCode: reqCode
      },
      exames: [
        {
          codigo: examCode,
          titulo: examTitle,
          situacao: "LIBERADO",
          liberado: true,
          material: mat || "Soro",
          metodo: "Automatizado Colorimétrico",
          equipamento: equip,
          observacao: "",
          valorReferencia: ref,
          linhas: linhas
        }
      ]
    };

    document.getElementById('jsonModalContent').innerText = JSON.stringify(jsonStructure, null, 2);
    document.getElementById('jsonResultModal').classList.remove('hidden');
  }

  function closeJsonModal() {
    document.getElementById('jsonResultModal').classList.add('hidden');
  }

  function copyResultJsonText() {
    const text = document.getElementById('jsonModalContent').innerText;
    navigator.clipboard.writeText(text);
    alert('JSON do laudo copiado com sucesso!');
  }

  function openAddModal() {
    document.getElementById('addModal').classList.remove('hidden');
  }

  function closeAddModal() {
    document.getElementById('addModal').classList.add('hidden');
  }

  async function handleAddManualOrder(e) {
    e.preventDefault();
    const payload = {
      requisitionCode: document.getElementById('addReqCode').value,
      patientName: document.getElementById('addPatientName').value,
      patientAge: document.getElementById('addPatientAge').value,
      examCode: document.getElementById('addExamCode').value,
      examTitle: document.getElementById('addExamTitle').value,
      equipment: document.getElementById('addEquipment').value,
      material: document.getElementById('addMaterial').value
    };

    try {
      const res = await fetch('/api/interfaceamento/add-manual-order', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (data.success) {
        closeAddModal();
        window.location.reload();
      } else {
        alert(data.message || 'Erro ao salvar ordem.');
      }
    } catch (err) {
      console.error(err);
      alert('Erro de conexão ao salvar ordem.');
    }
  }

  function openComplexModalByItem(itemId) {
    const prontos = (window.interfaceDataGlobal && window.interfaceDataGlobal.prontos) ? window.interfaceDataGlobal.prontos : [];
    const item = prontos.find(x => String(x.id) === String(itemId));
    if (!item) return;

    document.getElementById('complexModalSubtitle').innerText = `${item.examCode || 'EXAME'} - ${item.examTitle || ''} (#${item.requisitionCode})`;
    document.getElementById('complexModalPatient').innerText = item.patientName + (item.patientAge ? ` (${item.patientAge})` : '');
    document.getElementById('complexModalBarcode').innerText = item.sampleBarcode || '-';

    const tbody = document.getElementById('complexModalTableBody');
    tbody.innerHTML = '';

    let list = item.parsedValores;
    if (!list || !Array.isArray(list) || list.length === 0) {
      if (item.resultValue && item.resultValue.includes('|')) {
        list = item.resultValue.split('|').map(part => {
          const [k, v] = part.split(':');
          return { key: (k || '').trim(), value: (v || '').trim() };
        });
      } else {
        list = [{ key: 'RESULTADO', value: item.resultValue }];
      }
    }

    list.forEach(row => {
      const tr = document.createElement('tr');
      tr.className = 'hover:bg-slate-50 transition-colors';
      tr.innerHTML = `
        <td class="py-2.5 px-3 font-bold text-slate-700">${row.key || 'Parâmetro'}</td>
        <td class="py-2.5 px-3 text-right font-mono font-black text-emerald-700">${row.value} ${item.unit || ''}</td>
      `;
      tbody.appendChild(tr);
    });

    document.getElementById('complexResultModal').classList.remove('hidden');
  }

  function closeComplexModal() {
    document.getElementById('complexResultModal').classList.add('hidden');
  }

  async function revertToNaoEnviados(id) {
    if (!confirm('Deseja realmente voltar esta ordem/amostra para a aba "Não Enviados"?')) return;
    try {
      const res = await fetch('/api/interfaceamento/revert-to-naoenviados', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id })
      });
      const json = await res.json();
      if (json.success) {
        try {
          localStorage.setItem('interfaceActiveTab', 'naoEnviados');
        } catch(e) {}
        window.location.reload();
      } else {
        alert(json.message || 'Erro ao devolver para Não Enviados');
      }
    } catch (err) {
      alert('Erro de conexão ao devolver amostra.');
    }
  }

  async function revertToProcessando(id) {
    if (!confirm('Deseja realmente reverter este resultado e voltá-lo para a aba "Processando"?')) return;
    try {
      const res = await fetch('/api/interfaceamento/revert-to-processando', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id })
      });
      const json = await res.json();
      if (json.success) {
        try {
          localStorage.setItem('interfaceActiveTab', 'processando');
        } catch(e) {}
        window.location.reload();
      } else {
        alert(json.message || 'Erro ao reverter resultado.');
      }
    } catch (err) {
      alert('Erro de conexão ao reverter resultado.');
    }
  }

  // Real-time background sync without forcing page refresh unless state changes
  let lastDataString = JSON.stringify(window.interfaceDataGlobal);

  async function checkLiveUpdates() {
    try {
      const res = await fetch('/api/interfaceamento/data?t=' + Date.now());
      if (!res.ok) return;
      const json = await res.json();
      if (json && json.success && json.data) {
        const newStr = JSON.stringify(json.data);
        if (newStr !== lastDataString) {
          lastDataString = newStr;
          window.interfaceDataGlobal = json.data;

          // Update header counters
          const badgeNao = document.getElementById('badge-count-naoenviados');
          const badgeProc = document.getElementById('badge-count-processando');
          const badgePro = document.getElementById('badge-count-prontos');
          const badgeMsg = document.getElementById('badge-count-mensagens');

          if (badgeNao) badgeNao.innerText = (json.data.naoEnviados || []).length;
          if (badgeProc) badgeProc.innerText = (json.data.processando || []).length;
          if (badgePro) badgePro.innerText = (json.data.prontos || []).length;
          if (badgeMsg) badgeMsg.innerText = (json.data.mensagens || []).length;

          // Only refresh page if user is not typing or inside an open modal
          const isModalOpen = document.querySelector('#addModal:not(.hidden), #astmModal:not(.hidden), #jsonResultModal:not(.hidden), #complexResultModal:not(.hidden)');
          if (!isModalOpen) {
            window.location.reload();
          }
        }
      }
    } catch (err) {
      // ignore network errors during background polling
    }
  }

  // Poll every 2 seconds
  setInterval(checkLiveUpdates, 2000);
</script>

