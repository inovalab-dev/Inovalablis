<%- include('../partials/header') %>

<%
  function parseDateTime(dateStr) {
    if (!dateStr) {
      const now = new Date();
      const dd = String(now.getDate()).padStart(2, '0');
      const mm = String(now.getMonth() + 1).padStart(2, '0');
      const yyyy = now.getFullYear();
      const hh = String(now.getHours()).padStart(2, '0');
      const min = String(now.getMinutes()).padStart(2, '0');
      return { date: `${dd}-${mm}-${yyyy}`, time: `${hh}:${min}` };
    }
    let s = String(dateStr).trim();
    if (s.includes('T')) {
      const [dp, tp] = s.split('T');
      const parts = dp.split('-');
      if (parts.length === 3) {
        return {
          date: `${parts[2].padStart(2, '0')}-${parts[1].padStart(2, '0')}-${parts[0]}`,
          time: (tp || '').substring(0, 5) || '00:00'
        };
      }
    }
    const tokens = s.split(/[\s,]+/);
    let datePart = tokens[0] ? tokens[0].replace(/\//g, '-') : '-';
    if (datePart.includes('-')) {
      const parts = datePart.split('-');
      if (parts[0] && parts[0].length === 4) {
        datePart = `${parts[2].padStart(2, '0')}-${parts[1].padStart(2, '0')}-${parts[0]}`;
      }
    }
    let timePart = tokens[1] ? tokens[1].substring(0, 5) : '00:00';
    return { date: datePart, time: timePart };
  }

  function parseSex(sexStr) {
    if (!sexStr) return 'M';
    const s = String(sexStr).trim().toUpperCase();
    if (s.startsWith('F')) return 'F';
    return 'M';
  }

  function parseAge(ageStr) {
    if (!ageStr) return '-';
    let a = String(ageStr).trim();
    if (/^\d+$/.test(a)) return `${a} anos`;
    return a;
  }
%>

<div class="p-4 sm:p-6 lg:p-8 max-w-[98vw] xl:max-w-[96vw] mx-auto w-full flex-1">
  <!-- Header Banner -->
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-6">
    <div>
      <div class="flex items-center gap-2 text-xs text-brand-neutral/60 font-mono uppercase tracking-wider mb-1">
        <span>Módulo LIS</span>
        <span>•</span>
        <span class="text-cyan-600 font-bold">Automação & Analisadores</span>
      </div>
      <h1 class="text-2xl font-black text-[#284701] flex items-center gap-2">
        <span>🔌</span> Interfaceamento de Equipamentos
      </h1>
      <p class="text-xs text-brand-neutral/70 mt-1">
        Gerenciamento de comunicação bidirecional ASTM / HL7 com equipamentos automatizados (Urit, Sysmex, Mindray, Cobas).
      </p>
    </div>

    <!-- Counters Badge Bar -->
    <div class="flex flex-wrap items-center gap-2 sm:gap-3">
      <div onclick="switchTab('naoEnviados')" class="bg-white px-3.5 py-2 rounded-xl border border-amber-200 shadow-2xs text-center min-w-28 cursor-pointer hover:border-amber-400 transition-all">
        <span class="text-[10px] font-bold text-amber-600 uppercase tracking-wider block">⏳ Não Enviados</span>
        <span id="badge-count-naoenviados" class="text-base font-black text-amber-700"><%= (interfaceData.naoEnviados || []).length %></span>
      </div>

      <div onclick="switchTab('processando')" class="bg-white px-3.5 py-2 rounded-xl border border-sky-200 shadow-2xs text-center min-w-28 cursor-pointer hover:border-sky-400 transition-all">
        <span class="text-[10px] font-bold text-sky-600 uppercase tracking-wider block">🔄 Processando</span>
        <span id="badge-count-processando" class="text-base font-black text-sky-700"><%= (interfaceData.processando || []).length %></span>
      </div>

      <div onclick="switchTab('prontos')" class="bg-white px-3.5 py-2 rounded-xl border border-emerald-200 shadow-2xs text-center min-w-28 cursor-pointer hover:border-emerald-400 transition-all">
        <span class="text-[10px] font-bold text-emerald-600 uppercase tracking-wider block">✅ Prontos</span>
        <span id="badge-count-prontos" class="text-base font-black text-emerald-700"><%= (interfaceData.prontos || []).length %></span>
      </div>

      <div onclick="switchTab('mensagens')" class="bg-white px-3.5 py-2 rounded-xl border border-slate-200 shadow-2xs text-center min-w-28 cursor-pointer hover:border-slate-400 transition-all">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">📟 Mensagens</span>
        <span id="badge-count-mensagens" class="text-base font-black text-slate-700"><%= (interfaceData.mensagens || []).length %></span>
      </div>

      <div class="flex items-center gap-2 shrink-0">
        <a 
          href="/lis_equipment_postman_collection.json" 
          download="LIS_Equipment_Postman_Collection.json"
          title="Baixar arquivo JSON da Coleção do Postman atualizada"
          class="bg-indigo-50 hover:bg-indigo-100 text-indigo-700 border border-indigo-200 px-3 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer flex items-center gap-1.5 shadow-2xs"
        >
          <span>🚀</span>
          <span class="hidden sm:inline">Postman Collection</span>
          <span class="sm:hidden">Postman</span>
        </a>

        <button 
          type="button" 
          onclick="clearFictitiousSamples()" 
          title="Remove amostras fictícias/de teste que não pertencem a nenhuma requisição real cadastrada"
          class="bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 px-3 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer flex items-center gap-1.5 shadow-2xs"
        >
          <span>🧹</span>
          <span class="hidden sm:inline">Limpar Fictícias</span>
          <span class="sm:hidden">Fictícias</span>
        </button>

        <button 
          type="button" 
          onclick="clearAllInterfaceData()" 
          title="Limpa todas as listas de interfaceamento (Não Enviados, Processando e Prontos)"
          class="bg-gray-100 hover:bg-gray-200 text-gray-700 border border-gray-300 px-3 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer flex items-center gap-1.5 shadow-2xs"
        >
          <span>🗑️</span>
          <span class="hidden sm:inline">Zerar Listas</span>
          <span class="sm:hidden">Zerar</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Navigation Tabs & Integrated Search/Filter Bar -->
  <div class="bg-white rounded-2xl p-2 md:p-2.5 border border-gray-200 shadow-xs mb-5 flex flex-col lg:flex-row lg:items-center justify-between gap-3">
    <!-- 4 Tabs Buttons -->
    <div class="flex items-center gap-1.5 overflow-x-auto shrink-0 pb-1 lg:pb-0">
      <button 
        type="button" 
        id="tab-btn-naoEnviados" 
        onclick="switchTab('naoEnviados')"
        class="tab-btn px-4 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-2 cursor-pointer bg-[#284701] text-white shadow-xs whitespace-nowrap"
      >
        <span>⏳</span> Não enviados
        <span class="bg-white/20 px-2 py-0.5 rounded-full text-[10px] font-mono"><%= (interfaceData.naoEnviados || []).length %></span>
      </button>

      <button 
        type="button" 
        id="tab-btn-processando" 
        onclick="switchTab('processando')"
        class="tab-btn px-4 py-2 rounded-xl text-xs font-bold text-gray-600 hover:text-gray-900 hover:bg-gray-100 transition-all flex items-center gap-2 cursor-pointer whitespace-nowrap"
      >
        <span>⚙️</span> Processando
        <span class="bg-gray-200 px-2 py-0.5 rounded-full text-[10px] font-mono text-gray-700"><%= (interfaceData.processando || []).length %></span>
      </button>

      <button 
        type="button" 
        id="tab-btn-prontos" 
        onclick="switchTab('prontos')"
        class="tab-btn px-4 py-2 rounded-xl text-xs font-bold text-gray-600 hover:text-gray-900 hover:bg-gray-100 transition-all flex items-center gap-2 cursor-pointer whitespace-nowrap"
      >
        <span>✅</span> Prontos
        <span class="bg-gray-200 px-2 py-0.5 rounded-full text-[10px] font-mono text-gray-700"><%= (interfaceData.prontos || []).length %></span>
      </button>

      <button 
        type="button" 
        id="tab-btn-mensagens" 
        onclick="switchTab('mensagens')"
        class="tab-btn px-4 py-2 rounded-xl text-xs font-bold text-gray-600 hover:text-gray-900 hover:bg-gray-100 transition-all flex items-center gap-2 cursor-pointer whitespace-nowrap"
      >
        <span>💬</span> Mensagens
        <span class="bg-gray-200 px-2 py-0.5 rounded-full text-[10px] font-mono text-gray-700"><%= (interfaceData.mensagens || []).length %></span>
      </button>
    </div>

    <!-- Search & Filter Controls -->
    <div class="flex items-center gap-2 flex-1 max-w-2xl w-full">
      <div class="relative flex-1">
        <svg class="w-4 h-4 absolute left-3 top-2.5 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        <input 
          type="text" 
          id="filterSearchInput" 
          oninput="applyInterfaceFilter()" 
          placeholder="Buscar paciente, código, requisição (#000) ou amostra..." 
          class="w-full pl-9 pr-3 py-1.5 bg-gray-50 border border-gray-200 rounded-xl text-xs font-medium text-gray-800 focus:outline-none focus:ring-2 focus:ring-[#284701] focus:bg-white transition-all"
        />
      </div>

      <select id="filterEquipment" onchange="applyInterfaceFilter()" class="bg-gray-50 border border-gray-200 text-gray-700 rounded-xl px-2.5 py-1.5 text-xs font-bold focus:ring-2 focus:ring-[#284701] focus:outline-none cursor-pointer shrink-0">
        <option value="todos">🔬 Todos os Equipamentos</option>
        <option value="Urit">Urit 8021A (Bioquímica)</option>
        <option value="Sysmex">Sysmex XN-550 (Hematologia)</option>
        <option value="Mindray">Mindray BS-200</option>
        <option value="Cobas">Cobas c311 (Imuno/Hormônios)</option>
      </select>
    </div>
  </div>

  <!-- ================= TAB 1: NÃO ENVIADOS ================= -->
  <div id="tab-content-naoEnviados" class="tab-content space-y-4">

    <% if (!interfaceData.naoEnviados || interfaceData.naoEnviados.length === 0) { %>
      <div class="bg-white rounded-2xl p-12 text-center border border-gray-200 shadow-xs">
        <span class="text-4xl block mb-3">✅</span>
        <h3 class="text-base font-bold text-gray-800">Nenhum exame pendente no status "Aguardando Execução"</h3>
        <p class="text-xs text-gray-500 mt-1">Todas as ordens de trabalho foram enviadas para os equipamentos ou nenhuma nova amostra foi triada.</p>
      </div>
    <% } else { 
      const groupedNaoEnviados = [];
      const patientMap = new Map();

      interfaceData.naoEnviados.forEach(item => {
        if (!item) return;
        // Group strictly by requisition / patient / sample barcode so there is only 1 row per patient
        const key = String(item.requisitionCode || item.patientName || item.sampleBarcode || item.id).trim().toLowerCase();
        const dt = parseDateTime(item.dateRequested);
        const examCode = item.examCode || item.examTitle || 'EXAME';
        const mat = item.material || 'Soro';

        if (!patientMap.has(key)) {
          const rowData = {
            sampleBarcode: item.sampleBarcode || '-',
            requisitionCode: item.requisitionCode || '-',
            patientName: item.patientName || 'Paciente',
            patientSex: parseSex(item.patientSex),
            patientAge: parseAge(item.patientAge),
            date: dt.date,
            time: dt.time,
            materials: [mat],
            equipment: item.equipment || '-',
            exams: [examCode]
          };
          patientMap.set(key, rowData);
          groupedNaoEnviados.push(rowData);
        } else {
          const existing = patientMap.get(key);
          if (!existing.exams.includes(examCode)) {
            existing.exams.push(examCode);
          }
          if (mat && !existing.materials.includes(mat)) {
            existing.materials.push(mat);
          }
        }
      });
    %>
      <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden shadow-2xs">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-xs">
            <thead>
              <tr class="bg-slate-100 text-slate-700 font-bold uppercase text-[11px] border-b border-slate-200 tracking-wide">
                <th class="py-3 px-4">Amostra</th>
                <th class="py-3 px-4">Requisição</th>
                <th class="py-3 px-4">Paciente</th>
                <th class="py-3 px-4 text-center">Sexo</th>
                <th class="py-3 px-4">Idade</th>
                <th class="py-3 px-4">Data</th>
                <th class="py-3 px-4">Hora</th>
                <th class="py-3 px-4">Material</th>
                <th class="py-3 px-4">Exames</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 font-medium">
              <% groupedNaoEnviados.forEach(function(row) { %>
                <tr class="interface-card hover:bg-amber-50/40 transition-colors"
                    data-search="<%= (row.patientName + ' ' + row.requisitionCode + ' ' + row.exams.join(' ') + ' ' + row.equipment + ' ' + row.sampleBarcode).toLowerCase() %>"
                    data-equipment="<%= row.equipment %>">
                  <td class="py-3 px-4 font-mono font-bold text-slate-800 whitespace-nowrap">
                    <%= row.sampleBarcode %>
                  </td>
                  <td class="py-3 px-4 font-mono text-slate-700 font-bold whitespace-nowrap">
                    #<%= row.requisitionCode %>
                  </td>
                  <td class="py-3 px-4 whitespace-nowrap font-bold text-slate-800">
                    <%= row.patientName %>
                  </td>
                  <td class="py-3 px-4 text-center whitespace-nowrap font-bold font-mono">
                    <span class="<%= row.patientSex === 'F' ? 'bg-pink-50 text-pink-700 border-pink-200' : 'bg-blue-50 text-blue-700 border-blue-200' %> border px-2 py-0.5 rounded-md text-[11px]">
                      <%= row.patientSex %>
                    </span>
                  </td>
                  <td class="py-3 px-4 whitespace-nowrap text-slate-600 font-medium">
                    <%= row.patientAge %>
                  </td>
                  <td class="py-3 px-4 whitespace-nowrap font-mono text-slate-600 font-bold">
                    <%= row.date %>
                  </td>
                  <td class="py-3 px-4 whitespace-nowrap font-mono text-slate-500">
                    <%= row.time %>
                  </td>
                  <td class="py-3 px-4 whitespace-nowrap text-slate-700 font-semibold">
                    <%= row.materials.join(', ') %>
                  </td>
                  <td class="py-3 px-4 font-bold text-slate-800 whitespace-nowrap">
                    <%= row.exams.join(', ') %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>

  </div>

  <!-- ================= TAB 2: PROCESSANDO ================= -->
  <div id="tab-content-processando" class="tab-content hidden space-y-4">

    <% if (!interfaceData.processando || interfaceData.processando.length === 0) { %>
      <div class="bg-white rounded-2xl p-12 text-center border border-gray-200 shadow-xs">
        <span class="text-4xl block mb-3">📭</span>
        <h3 class="text-base font-bold text-gray-800">Nenhum exame em processamento no momento</h3>
        <p class="text-xs text-gray-500 mt-1">Realize a consulta da amostra via API para que ela entre em processamento automaticamente.</p>
      </div>
    <% } else { %>
      <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden shadow-2xs">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-xs">
            <thead>
              <tr class="bg-slate-100 text-slate-700 font-bold uppercase text-[11px] border-b border-slate-200 tracking-wide">
                <th class="py-3 px-4">Amostra</th>
                <th class="py-3 px-4">Requisição</th>
                <th class="py-3 px-4">Paciente</th>
                <th class="py-3 px-4 text-center">Sexo</th>
                <th class="py-3 px-4">Idade</th>
                <th class="py-3 px-4">Data</th>
                <th class="py-3 px-4">Hora</th>
                <th class="py-3 px-4">Material</th>
                <th class="py-3 px-4">Exame</th>
                <th class="py-3 px-4 text-center">Ações</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 font-medium">
              <% interfaceData.processando.forEach(function(item) { 
                   if (!item) return;
                   const dt = parseDateTime(item.dateRequested || item.startTime);
                   const sex = parseSex(item.patientSex);
                   const age = parseAge(item.patientAge);
                   const examCode = item.examCode || 'EXAME';
                   const searchText = ((item.patientName || '') + ' ' + (item.requisitionCode || '') + ' ' + (item.examCode || '') + ' ' + (item.examTitle || '') + ' ' + (item.equipment || '') + ' ' + (item.sampleBarcode || '')).toLowerCase();
              %>
                <tr class="interface-card hover:bg-sky-50/40 transition-colors"
                    data-search="<%= searchText %>"
                    data-equipment="<%= item.equipment || '' %>">
                  <td class="py-3 px-4 font-mono font-bold text-slate-800 whitespace-nowrap">
                    <%= item.sampleBarcode || '-' %>
                  </td>
                  <td class="py-3 px-4 font-mono text-slate-700 font-bold whitespace-nowrap">
                    #<%= item.requisitionCode %>
                  </td>
                  <td class="py-3 px-4 whitespace-nowrap font-bold text-slate-800">
                    <%= item.patientName %>
                  </td>
                  <td class="py-3 px-4 text-center whitespace-nowrap font-bold font-mono">
                    <span class="<%= sex === 'F' ? 'bg-pink-50 text-pink-700 border-pink-200' : 'bg-blue-50 text-blue-700 border-blue-200' %> border px-2 py-0.5 rounded-md text-[11px]">
                      <%= sex %>
                    </span>
                  </td>
                  <td class="py-3 px-4 whitespace-nowrap text-slate-600 font-medium">
                    <%= age %>
                  </td>
                  <td class="py-3 px-4 whitespace-nowrap font-mono text-slate-600 font-bold">
                    <%= dt.date %>
                  </td>
                  <td class="py-3 px-4 whitespace-nowrap font-mono text-slate-500">
                    <%= dt.time %>
                  </td>
                  <td class="py-3 px-4 whitespace-nowrap text-slate-700 font-semibold">
                    <%= item.material || 'Soro' %>
                  </td>
                  <td class="py-3 px-4 font-bold text-slate-800 whitespace-nowrap">
                    <%= examCode %>
                  </td>
                  <td class="py-3 px-4 text-center whitespace-nowrap">
                    <button 
                      type="button" 
                      onclick="revertToNaoEnviados('<%= item.id %>')" 
                      class="px-2.5 py-1.5 bg-amber-50 hover:bg-amber-100 text-amber-800 border border-amber-200 text-xs font-bold rounded-lg shadow-2xs transition-all flex items-center gap-1 cursor-pointer mx-auto"
                      title="Voltar esta amostra para a aba 'Não Enviados'"
                    >
                      <span>↩️</span> Voltar
                    </button>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>

  </div>

  <!-- ================= TAB 3: PRONTOS ================= -->
  <div id="tab-content-prontos" class="tab-content hidden space-y-4">

    <% if (!interfaceData.prontos || interfaceData.prontos.length === 0) { %>
      <div class="bg-white rounded-2xl p-12 text-center border border-gray-200 shadow-xs">
        <span class="text-4xl block mb-3">📄</span>
        <h3 class="text-base font-bold text-gray-800">Nenhum resultado pronto no momento</h3>
        <p class="text-xs text-gray-500 mt-1">Simule ou aguarde a leitura de exames na aba "Processando".</p>
      </div>
    <% } else { %>
      <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden shadow-2xs">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-xs">
            <thead>
              <tr class="bg-slate-100 text-slate-700 font-bold uppercase text-[11px] border-b border-slate-200 tracking-wide">
                <th class="py-3 px-4">Amostra</th>
                <th class="py-3 px-4">Requisição</th>
                <th class="py-3 px-4">Paciente</th>
                <th class="py-3 px-4">Sexo</th>
                <th class="py-3 px-4">Idade</th>
                <th class="py-3 px-4">Data</th>
                <th class="py-3 px-4">Hora</th>
                <th class="py-3 px-4">Resultado</th>
                <th class="py-3 px-4">Material</th>
                <th class="py-3 px-4">Exame</th>
                <th class="py-3 px-4 text-center">Ações</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 font-medium">
              <% interfaceData.prontos.forEach(function(item) { 
                   if (!item) return;
                   const searchTxt = ((item.patientName || '') + ' ' + (item.requisitionCode || '') + ' ' + (item.examCode || '') + ' ' + (item.examTitle || '') + ' ' + (item.equipment || '') + ' ' + (item.sampleBarcode || '')).toLowerCase();
                   const completedParts = (item.completedTime || '').split(' ');
                   const dataVal = completedParts[0] || '-';
                   const horaVal = completedParts[1] || '-';
              %>
                <tr class="interface-card hover:bg-emerald-50/40 transition-colors"
                    data-search="<%= searchTxt %>"
                    data-equipment="<%= item.equipment || '' %>">
                  <!-- 1. Amostra -->
                  <td class="py-3 px-4 font-mono font-bold text-slate-800 whitespace-nowrap">
                    <%= item.sampleBarcode || '-' %>
                  </td>
                  <!-- 2. Requisição -->
                  <td class="py-3 px-4 font-mono text-slate-600 font-bold whitespace-nowrap">#<%= item.requisitionCode %></td>
                  <!-- 3. Paciente -->
                  <td class="py-3 px-4 whitespace-nowrap">
                    <span class="font-bold text-slate-800"><%= item.patientName %></span>
                  </td>
                  <!-- 4. Sexo -->
                  <td class="py-3 px-4 whitespace-nowrap text-slate-700 font-semibold">
                    <%= item.patientSex || '-' %>
                  </td>
                  <!-- 5. Idade -->
                  <td class="py-3 px-4 whitespace-nowrap text-slate-600">
                    <%= item.patientAge || '-' %>
                  </td>
                  <!-- 6. Data -->
                  <td class="py-3 px-4 whitespace-nowrap font-mono text-slate-700">
                    <%= dataVal %>
                  </td>
                  <!-- 7. Hora -->
                  <td class="py-3 px-4 whitespace-nowrap font-mono text-slate-700">
                    <%= horaVal %>
                  </td>
                  <!-- 8. Resultado -->
                  <td class="py-3 px-4 whitespace-nowrap">
                    <% if (item.isComplex || (item.parsedValores && item.parsedValores.length > 1)) { %>
                      <button 
                        type="button" 
                        onclick="openComplexModalByItem('<%= item.id %>')" 
                        class="px-2.5 py-1.5 bg-sky-50 hover:bg-sky-100 text-sky-800 border border-sky-200 text-xs font-bold rounded-lg shadow-2xs transition-all flex items-center gap-1 cursor-pointer"
                        title="Clique para visualizar todos os parâmetros do resultado"
                      >
                        <span>🔬</span> Ver Resultado
                      </button>
                    <% } else { %>
                      <span class="font-mono font-black text-emerald-700 bg-emerald-50 border border-emerald-200 px-2.5 py-1 rounded-lg text-xs"><%= item.resultValue %> <%= item.unit %></span>
                      <% if (item.refRange) { %>
                        <span class="text-[10px] text-slate-400 font-mono ml-1">Ref: <%= item.refRange %></span>
                      <% } %>
                    <% } %>
                  </td>
                  <!-- 9. Material -->
                  <td class="py-3 px-4 whitespace-nowrap font-semibold text-slate-700">
                    <%= item.material || 'Soro' %>
                  </td>
                  <!-- 10. Exame -->
                  <td class="py-3 px-4 font-bold text-slate-800 whitespace-nowrap">
                    <%= item.examCode || 'EXAME' %>
                  </td>
                  <!-- 11. Ações -->
                  <td class="py-3 px-4 text-center whitespace-nowrap">
                    <div class="flex items-center justify-center gap-1.5">
                      <button 
                        type="button" 
                        onclick="showResultJson('<%= item.requisitionCode %>', '<%= item.patientName %>', '<%= item.patientAge %>', '<%= item.examCode %>', '<%= item.examTitle %>', '<%= item.resultValue %>', '<%= item.unit %>', '<%= item.material %>', '<%= item.equipment %>', '<%= item.refRange %>', <%= item.parsedValores ? JSON.stringify(item.parsedValores) : 'null' %>)" 
                        class="px-2.5 py-1.5 bg-[#284701] hover:bg-[#1d3301] text-white text-[11px] font-bold rounded-lg shadow-2xs transition-all flex items-center gap-1 cursor-pointer"
                        title="Copiar JSON do Laudo"
                      >
                        <span>📋</span> JSON
                      </button>
                      <a 
                        href="/admin/resultados/digitacao?req=<%= item.requisitionCode %>" 
                        class="px-2.5 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 text-[11px] font-bold rounded-lg transition-all flex items-center gap-1 cursor-pointer"
                        title="Abrir na Liberação de Resultados"
                      >
                        <span>👁️</span> Liberação
                      </a>
                      <button 
                        type="button" 
                        onclick="revertToProcessando('<%= item.id %>')" 
                        class="px-2.5 py-1.5 bg-amber-50 hover:bg-amber-100 text-amber-800 border border-amber-200 text-[11px] font-bold rounded-lg shadow-2xs transition-all flex items-center gap-1 cursor-pointer"
                        title="Voltar este exame para a aba 'Processando'"
                      >
                        <span>↩️</span> Voltar
                      </button>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>

  </div>

  <!-- ================= TAB 4: MENSAGENS ================= -->
  <div id="tab-content-mensagens" class="tab-content hidden space-y-4">
    
    <% if (interfaceData.mensagens && interfaceData.mensagens.length > 0) { %>
      <div class="flex justify-end mb-2">
        <button 
          type="button" 
          onclick="clearLogs()" 
          class="px-3 py-1.5 bg-red-50 hover:bg-red-100 text-red-700 border border-red-200 text-xs font-bold rounded-xl transition-all flex items-center gap-1 cursor-pointer"
        >
          <span>🗑️</span> Limpar Log
        </button>
      </div>
    <% } %>

    <% if (!interfaceData.mensagens || interfaceData.mensagens.length === 0) { %>
      <div class="bg-white rounded-2xl p-12 text-center border border-gray-200 shadow-xs">
        <span class="text-4xl block mb-3">💬</span>
        <h3 class="text-base font-bold text-gray-800">Nenhuma mensagem registrada no log</h3>
        <p class="text-xs text-gray-500 mt-1">As mensagens enviadas ou recebidas dos equipamentos serão registradas aqui em formato nativo ASTM/HL7.</p>
      </div>
    <% } else { %>
      <div class="space-y-3" id="mensagens-list">
        <% interfaceData.mensagens.forEach(function(msg) { 
             if (!msg) return;
             const searchTxt = ((msg.equipment || '') + ' ' + (msg.payload || '') + ' ' + (msg.type || '') + ' ' + (msg.status || '')).toLowerCase();
        %>
          <div class="bg-slate-950 border border-slate-800 rounded-2xl p-4 font-mono text-xs text-slate-200 shadow-sm"
               data-search="<%= searchTxt %>"
               data-equipment="<%= msg.equipment || '' %>">
            
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-800 pb-2.5 mb-2.5">
              <div class="flex items-center gap-2">
                <% if (msg.type === 'OUTBOUND') { %>
                  <span class="bg-amber-500/20 text-amber-400 border border-amber-500/30 text-[10px] font-bold px-2 py-0.5 rounded-full uppercase">
                    📤 LIS ➔ EQUIPAMENTO
                  </span>
                <% } else { %>
                  <span class="bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 text-[10px] font-bold px-2 py-0.5 rounded-full uppercase">
                    📥 EQUIPAMENTO ➔ LIS
                  </span>
                <% } %>

                <span class="text-slate-400 font-bold">🔬 <%= msg.equipment %></span>
                <span class="text-slate-600">• <%= msg.protocol %></span>
              </div>

              <div class="flex items-center gap-3 text-[11px] text-slate-400">
                <span class="text-emerald-400 font-bold">Status: <%= msg.status %></span>
                <span>⏱️ <%= msg.timestamp %></span>
              </div>
            </div>

            <div class="bg-slate-900 p-3 rounded-xl border border-slate-800 text-cyan-200 whitespace-pre-wrap overflow-x-auto selection:bg-cyan-800">
<%= msg.payload %>
            </div>

          </div>
        <% }); %>
      </div>
    <% } %>

  </div>

</div>

