<!-- SCRIPTS DE INTERATIVIDADE E NAVEGAÇÃO ENTRE ABAS -->
<script>
  let currentActiveTab = 'naoEnviados';

  function switchTab(tabId) {
    currentActiveTab = tabId;

    // Toggle Tab Buttons Styling
    const tabBtns = document.querySelectorAll('.tab-btn');
    tabBtns.forEach(btn => {
      btn.classList.remove('bg-[#284701]', 'text-white', 'shadow-xs');
      btn.classList.add('text-gray-600', 'hover:text-gray-900', 'hover:bg-gray-100');
    });

    const activeBtn = document.getElementById('tab-btn-' + tabId);
    if (activeBtn) {
      activeBtn.classList.remove('text-gray-600', 'hover:text-gray-900', 'hover:bg-gray-100');
      activeBtn.classList.add('bg-[#284701]', 'text-white', 'shadow-xs');
    }

    // Toggle Tab Content Panels
    const tabContents = document.querySelectorAll('.tab-content');
    tabContents.forEach(content => {
      content.classList.add('hidden');
    });

    const activeContent = document.getElementById('tab-content-' + tabId);
    if (activeContent) {
      activeContent.classList.remove('hidden');
    }

    applyInterfaceFilter();
  }

  function applyInterfaceFilter() {
    const searchVal = (document.getElementById('filterSearchInput').value || '').trim().toLowerCase();
    const equipVal = document.getElementById('filterEquipment').value;

    const cards = document.querySelectorAll('#tab-content-' + currentActiveTab + ' .interface-card');
    cards.forEach(card => {
      const cardSearch = card.getAttribute('data-search') || '';
      const cardEquip = card.getAttribute('data-equipment') || '';

      const matchesSearch = !searchVal || cardSearch.includes(searchVal);
      const matchesEquip = equipVal === 'todos' || cardEquip.toLowerCase().includes(equipVal.toLowerCase());

      if (matchesSearch && matchesEquip) {
        card.classList.remove('hidden');
      } else {
        card.classList.add('hidden');
      }
    });
  }

  async function sendSingleOrder(orderId) {
    try {
      const res = await fetch('/api/interfaceamento/send-order', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: orderId })
      });
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      } else {
        alert(data.message || 'Erro ao enviar ordem para equipamento.');
      }
    } catch (err) {
      console.error(err);
      alert('Falha de conexão ao enviar ordem.');
    }
  }

  async function sendAllOrders() {
    if (!confirm('Deseja enviar todas as ordens de trabalho pendentes para os equipamentos de destino?')) return;
    try {
      const res = await fetch('/api/interfaceamento/send-all', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      } else {
        alert(data.message || 'Erro ao enviar exames.');
      }
    } catch (err) {
      console.error(err);
      alert('Falha de conexão.');
    }
  }

  async function simulateResult(procId, examCode) {
    let customVal = prompt(`Simular resultado para o exame ${examCode}:`, '');
    if (customVal === null) return; // user cancelled

    try {
      const res = await fetch('/api/interfaceamento/simulate-result', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: procId, customValue: customVal })
      });
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      } else {
        alert(data.message || 'Erro ao simular leitura do equipamento.');
      }
    } catch (err) {
      console.error(err);
      alert('Falha de conexão ao simular resultado.');
    }
  }

  async function clearLogs() {
    if (!confirm('Deseja limpar todos os registros do log de mensagens?')) return;
    try {
      const res = await fetch('/api/interfaceamento/clear-logs', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      }
    } catch (err) {
      console.error(err);
    }
  }

  function reloadInterfaceData() {
    window.location.reload();
  }

  // Modals logic
  function viewAstmFrame(id, patient, exam, frame) {
    document.getElementById('astmModalPatient').innerText = patient;
    document.getElementById('astmModalExam').innerText = exam;
    document.getElementById('astmModalContent').innerText = frame;
    document.getElementById('astmModal').classList.remove('hidden');
  }

  function closeAstmModal() {
    document.getElementById('astmModal').classList.add('hidden');
  }

  function copyAstmFrameText() {
    const text = document.getElementById('astmModalContent').innerText;
    navigator.clipboard.writeText(text);
    alert('Frame ASTM copiado para a área de transferência!');
  }

  function showResultJson(reqCode, patName, patAge, examCode, examTitle, resultVal, unit, mat, equip, ref) {
    const jsonStructure = {
      paciente: {
        nome: patName,
        idade: patAge,
        medico: "Dr. Luís Guilherme de Souza Costa",
        convenio: "Hospital Municipal de Cambará",
        procedencia: "Coleta Hospit",
        dataRequisicao: new Date().toLocaleDateString('pt-BR'),
        dataEmissao: new Date().toLocaleDateString('pt-BR'),
        requisicaoCode: reqCode
      },
      exames: [
        {
          codigo: examCode,
          titulo: examTitle,
          situacao: "LIBERADO",
          liberado: true,
          material: mat || "Soro",
          metodo: "Automatizado Colorimétrico",
          equipamento: equip,
          observacao: "",
          valorReferencia: ref,
          linhas: [
            {
              part1: "RESULTADO:",
              resultado: resultVal,
              unidade: unit
            }
          ]
        }
      ]
    };

    document.getElementById('jsonModalContent').innerText = JSON.stringify(jsonStructure, null, 2);
    document.getElementById('jsonResultModal').classList.remove('hidden');
  }

  function closeJsonModal() {
    document.getElementById('jsonResultModal').classList.add('hidden');
  }

  function copyResultJsonText() {
    const text = document.getElementById('jsonModalContent').innerText;
    navigator.clipboard.writeText(text);
    alert('JSON do laudo copiado com sucesso!');
  }

  function openAddModal() {
    document.getElementById('addModal').classList.remove('hidden');
  }

  function closeAddModal() {
    document.getElementById('addModal').classList.add('hidden');
  }

  async function handleAddManualOrder(e) {
    e.preventDefault();
    const payload = {
      requisitionCode: document.getElementById('addReqCode').value,
      patientName: document.getElementById('addPatientName').value,
      patientAge: document.getElementById('addPatientAge').value,
      examCode: document.getElementById('addExamCode').value,
      examTitle: document.getElementById('addExamTitle').value,
      equipment: document.getElementById('addEquipment').value,
      material: document.getElementById('addMaterial').value
    };

    try {
      const res = await fetch('/api/interfaceamento/add-manual-order', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (data.success) {
        closeAddModal();
        window.location.reload();
      } else {
        alert(data.message || 'Erro ao salvar ordem.');
      }
    } catch (err) {
      console.error(err);
      alert('Erro de conexão ao salvar ordem.');
    }
  }
</script>

