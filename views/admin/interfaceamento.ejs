<%- include('../partials/header') %>

<div class="p-4 sm:p-6 lg:p-8 max-w-[98vw] xl:max-w-[96vw] mx-auto w-full flex-1">
  <!-- Header Banner -->
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-6">
    <div>
      <div class="flex items-center gap-2 text-xs text-brand-neutral/60 font-mono uppercase tracking-wider mb-1">
        <span>Módulo LIS</span>
        <span>•</span>
        <span class="text-cyan-600 font-bold">Automação & Analisadores</span>
      </div>
      <h1 class="text-2xl font-black text-[#284701] flex items-center gap-2">
        <span>🔌</span> Interfaceamento de Equipamentos
      </h1>
      <p class="text-xs text-brand-neutral/70 mt-1">
        Gerenciamento de comunicação bidirecional ASTM / HL7 com equipamentos automatizados (Urit, Sysmex, Mindray, Cobas).
      </p>
    </div>

    <!-- Counters Badge Bar -->
    <div class="flex flex-wrap items-center gap-2 sm:gap-3">
      <div onclick="switchTab('naoEnviados')" class="bg-white px-3.5 py-2 rounded-xl border border-amber-200 shadow-2xs text-center min-w-28 cursor-pointer hover:border-amber-400 transition-all">
        <span class="text-[10px] font-bold text-amber-600 uppercase tracking-wider block">⏳ Não Enviados</span>
        <span id="badge-count-naoenviados" class="text-base font-black text-amber-700"><%= (interfaceData.naoEnviados || []).length %></span>
      </div>

      <div onclick="switchTab('processando')" class="bg-white px-3.5 py-2 rounded-xl border border-sky-200 shadow-2xs text-center min-w-28 cursor-pointer hover:border-sky-400 transition-all">
        <span class="text-[10px] font-bold text-sky-600 uppercase tracking-wider block">🔄 Processando</span>
        <span id="badge-count-processando" class="text-base font-black text-sky-700"><%= (interfaceData.processando || []).length %></span>
      </div>

      <div onclick="switchTab('prontos')" class="bg-white px-3.5 py-2 rounded-xl border border-emerald-200 shadow-2xs text-center min-w-28 cursor-pointer hover:border-emerald-400 transition-all">
        <span class="text-[10px] font-bold text-emerald-600 uppercase tracking-wider block">✅ Prontos</span>
        <span id="badge-count-prontos" class="text-base font-black text-emerald-700"><%= (interfaceData.prontos || []).length %></span>
      </div>

      <div onclick="switchTab('mensagens')" class="bg-white px-3.5 py-2 rounded-xl border border-slate-200 shadow-2xs text-center min-w-28 cursor-pointer hover:border-slate-400 transition-all">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">📟 Mensagens</span>
        <span id="badge-count-mensagens" class="text-base font-black text-slate-700"><%= (interfaceData.mensagens || []).length %></span>
      </div>
    </div>
  </div>

  <!-- Navigation 4 Tabs Bar -->
  <div class="bg-white rounded-2xl p-2 border border-gray-200 shadow-xs mb-6 flex flex-wrap items-center justify-between gap-2">
    <div class="flex items-center gap-1.5 overflow-x-auto w-full sm:w-auto pb-1 sm:pb-0">
      <button 
        type="button" 
        id="tab-btn-naoEnviados" 
        onclick="switchTab('naoEnviados')"
        class="tab-btn px-4 py-2.5 rounded-xl text-xs font-bold transition-all flex items-center gap-2 cursor-pointer bg-[#284701] text-white shadow-xs"
      >
        <span>⏳</span> Não enviados
        <span class="bg-white/20 px-2 py-0.5 rounded-full text-[10px] font-mono"><%= (interfaceData.naoEnviados || []).length %></span>
      </button>

      <button 
        type="button" 
        id="tab-btn-processando" 
        onclick="switchTab('processando')"
        class="tab-btn px-4 py-2.5 rounded-xl text-xs font-bold text-gray-600 hover:text-gray-900 hover:bg-gray-100 transition-all flex items-center gap-2 cursor-pointer"
      >
        <span>⚙️</span> Processando
        <span class="bg-gray-200 px-2 py-0.5 rounded-full text-[10px] font-mono text-gray-700"><%= (interfaceData.processando || []).length %></span>
      </button>

      <button 
        type="button" 
        id="tab-btn-prontos" 
        onclick="switchTab('prontos')"
        class="tab-btn px-4 py-2.5 rounded-xl text-xs font-bold text-gray-600 hover:text-gray-900 hover:bg-gray-100 transition-all flex items-center gap-2 cursor-pointer"
      >
        <span>✅</span> Prontos
        <span class="bg-gray-200 px-2 py-0.5 rounded-full text-[10px] font-mono text-gray-700"><%= (interfaceData.prontos || []).length %></span>
      </button>

      <button 
        type="button" 
        id="tab-btn-mensagens" 
        onclick="switchTab('mensagens')"
        class="tab-btn px-4 py-2.5 rounded-xl text-xs font-bold text-gray-600 hover:text-gray-900 hover:bg-gray-100 transition-all flex items-center gap-2 cursor-pointer"
      >
        <span>💬</span> Mensagens
        <span class="bg-gray-200 px-2 py-0.5 rounded-full text-[10px] font-mono text-gray-700"><%= (interfaceData.mensagens || []).length %></span>
      </button>
    </div>

    <!-- Quick Action Controls -->
    <div class="flex items-center gap-2 w-full sm:w-auto justify-end">
      <button 
        type="button" 
        onclick="openAddModal()" 
        class="px-3.5 py-2.5 bg-brand-gold hover:bg-amber-500 text-slate-900 font-bold text-xs rounded-xl transition-all shadow-xs cursor-pointer flex items-center gap-1.5"
      >
        <span>➕</span> Nova Ordem Teste
      </button>

      <button 
        type="button" 
        onclick="reloadInterfaceData()" 
        class="px-3 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold text-xs rounded-xl transition-all cursor-pointer flex items-center gap-1.5"
        title="Atualizar lista"
      >
        <span>🔄</span> Sincronizar
      </button>
    </div>
  </div>

  <!-- Search & Filter Controls Bar -->
  <div class="bg-white rounded-2xl p-4 border border-gray-100 shadow-xs mb-6 flex flex-col md:flex-row items-center justify-between gap-3">
    <div class="relative flex-1 w-full">
      <svg class="w-4 h-4 absolute left-3.5 top-3.5 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      <input 
        type="text" 
        id="filterSearchInput" 
        oninput="applyInterfaceFilter()" 
        placeholder="Buscar por paciente, código do exame, requisição (#0000...) ou amostra..." 
        class="w-full pl-10 pr-4 py-2 bg-gray-50 border border-gray-200 rounded-xl text-xs font-medium text-gray-800 focus:outline-none focus:ring-2 focus:ring-[#284701] focus:bg-white transition-all"
      />
    </div>

    <div class="flex items-center gap-2 w-full md:w-auto">
      <select id="filterEquipment" onchange="applyInterfaceFilter()" class="bg-gray-50 border border-gray-200 text-gray-700 rounded-xl px-3 py-2 text-xs font-bold focus:ring-2 focus:ring-[#284701] focus:outline-none cursor-pointer">
        <option value="todos">🔬 Todos os Equipamentos</option>
        <option value="Urit">Urit 8021A (Bioquímica)</option>
        <option value="Sysmex">Sysmex XN-550 (Hematologia)</option>
        <option value="Mindray">Mindray BS-200</option>
        <option value="Cobas">Cobas c311 (Imuno/Hormônios)</option>
      </select>
    </div>
  </div>

  <!-- ================= TAB 1: NÃO ENVIADOS ================= -->
  <div id="tab-content-naoEnviados" class="tab-content space-y-4">
    
    <div class="flex items-center justify-between bg-amber-50 border border-amber-200 rounded-2xl p-4 text-amber-900 mb-2">
      <div class="flex items-center gap-3">
        <span class="text-2xl">⏳</span>
        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-amber-800">Exames no Status: Aguardando Execução</h3>
          <p class="text-xs text-amber-700 mt-0.5">Estes exames foram triados e aguardam o envio das ordens de trabalho para os equipamentos automatizados.</p>
        </div>
      </div>
      <% if (interfaceData.naoEnviados && interfaceData.naoEnviados.length > 0) { %>
        <button 
          type="button" 
          onclick="sendAllOrders()" 
          class="px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs rounded-xl shadow-xs transition-all flex items-center gap-2 cursor-pointer"
        >
          <span>🚀</span> Enviar Todos para o Equipamento
        </button>
      <% } %>
    </div>

    <% if (!interfaceData.naoEnviados || interfaceData.naoEnviados.length === 0) { %>
      <div class="bg-white rounded-2xl p-12 text-center border border-gray-200 shadow-xs">
        <span class="text-4xl block mb-3">✅</span>
        <h3 class="text-base font-bold text-gray-800">Nenhum exame pendente no status "Aguardando Execução"</h3>
        <p class="text-xs text-gray-500 mt-1">Todas as ordens de trabalho foram enviadas para os equipamentos ou nenhuma nova amostra foi triada.</p>
        <button onclick="openAddModal()" class="mt-4 px-4 py-2 bg-[#284701] text-white text-xs font-bold rounded-xl shadow-xs hover:bg-[#1e3501]">
          ➕ Adicionar Ordem de Teste
        </button>
      </div>
    <% } else { %>
      <div class="grid grid-cols-1 gap-4" id="naoenviados-list">
        <% interfaceData.naoEnviados.forEach(function(item) { %>
          <div class="interface-card bg-white rounded-2xl p-5 border border-gray-200 shadow-xs hover:shadow-md transition-all flex flex-col md:flex-row md:items-center justify-between gap-4"
               data-search="<%= (item.patientName + ' ' + item.requisitionCode + ' ' + item.examCode + ' ' + item.examTitle + ' ' + item.equipment).toLowerCase() %>"
               data-equipment="<%= item.equipment %>">
            
            <div class="flex items-start gap-3.5">
              <div class="p-3 bg-amber-50 text-amber-600 rounded-xl font-bold text-lg shrink-0">
                🧪
              </div>
              <div>
                <div class="flex flex-wrap items-center gap-2">
                  <span class="bg-amber-100 text-amber-800 text-[10px] font-black px-2.5 py-0.5 rounded-full uppercase tracking-wider">
                    Aguardando Execução
                  </span>
                  <span class="text-xs font-mono font-bold text-slate-500">
                    Req #<%= item.requisitionCode %>
                  </span>
                  <span class="text-xs font-mono text-gray-400">|</span>
                  <span class="text-xs font-mono text-cyan-700 font-bold bg-cyan-50 px-2 py-0.5 rounded-md">
                    🏷️ Amostra: <%= item.sampleBarcode %>
                  </span>
                </div>

                <h2 class="text-base font-black text-slate-800 mt-1">
                  <%= item.patientName %> <span class="text-xs font-normal text-slate-500">(<%= item.patientAge %>)</span>
                </h2>

                <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-slate-600 mt-1">
                  <span class="font-bold text-[#284701]">Exame: <%= item.examCode %> - <%= item.examTitle %></span>
                  <span>• Material: <b><%= item.material %></b></span>
                  <span>• Convênio: <b><%= item.convenio %></b></span>
                </div>

                <div class="flex items-center gap-2 text-xs text-slate-500 mt-2 font-mono">
                  <span>🔬 Equipamento: <strong class="text-slate-800"><%= item.equipment %></strong></span>
                  <span>• Data: <%= item.dateRequested %></span>
                </div>
              </div>
            </div>

            <!-- Actions -->
            <div class="flex flex-wrap md:flex-col items-end gap-2 shrink-0 border-t md:border-t-0 pt-3 md:pt-0 border-gray-100">
              <button 
                type="button" 
                onclick="sendSingleOrder('<%= item.id %>')" 
                class="px-4 py-2 bg-[#284701] hover:bg-[#1d3301] text-white text-xs font-bold rounded-xl shadow-xs transition-all flex items-center gap-1.5 cursor-pointer w-full md:w-auto justify-center"
              >
                <span>🚀</span> Enviar p/ Equipamento
              </button>

              <button 
                type="button" 
                onclick="viewAstmFrame('<%= item.id %>', '<%= item.patientName %>', '<%= item.examCode %>', `<%= item.astmFrame %>`)" 
                class="px-3.5 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-bold rounded-xl transition-all flex items-center gap-1.5 cursor-pointer w-full md:w-auto justify-center"
              >
                <span>📄</span> Ver Frame ASTM
              </button>
            </div>

          </div>
        <% }); %>
      </div>
    <% } %>

  </div>

  <!-- ================= TAB 2: PROCESSANDO ================= -->
  <div id="tab-content-processando" class="tab-content hidden space-y-4">
    
    <div class="flex items-center justify-between bg-sky-50 border border-sky-200 rounded-2xl p-4 text-sky-900 mb-2">
      <div class="flex items-center gap-3">
        <span class="text-2xl animate-spin">⚙️</span>
        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-sky-800">Ordens em Análise nos Equipamentos</h3>
          <p class="text-xs text-sky-700 mt-0.5">Exames cujas ordens de trabalho já foram transmitidas aos analisadores e aguardam a conclusão da leitura.</p>
        </div>
      </div>
    </div>

    <% if (!interfaceData.processando || interfaceData.processando.length === 0) { %>
      <div class="bg-white rounded-2xl p-12 text-center border border-gray-200 shadow-xs">
        <span class="text-4xl block mb-3">📭</span>
        <h3 class="text-base font-bold text-gray-800">Nenhum exame em processamento no momento</h3>
        <p class="text-xs text-gray-500 mt-1">Envie ordens da aba "Não enviados" para iniciar a análise automatizada.</p>
      </div>
    <% } else { %>
      <div class="grid grid-cols-1 gap-4" id="processando-list">
        <% interfaceData.processando.forEach(function(item) { %>
          <div class="interface-card bg-white rounded-2xl p-5 border border-sky-100 shadow-xs flex flex-col md:flex-row md:items-center justify-between gap-4"
               data-search="<%= (item.patientName + ' ' + item.requisitionCode + ' ' + item.examCode + ' ' + item.examTitle + ' ' + item.equipment).toLowerCase() %>"
               data-equipment="<%= item.equipment %>">
            
            <div class="flex items-start gap-3.5 flex-1">
              <div class="p-3 bg-sky-50 text-sky-600 rounded-xl font-bold text-lg shrink-0">
                ⚙️
              </div>
              <div class="flex-1">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="bg-sky-100 text-sky-800 text-[10px] font-black px-2.5 py-0.5 rounded-full uppercase tracking-wider animate-pulse">
                    🔄 Processando Leitura
                  </span>
                  <span class="text-xs font-mono font-bold text-slate-500">
                    Req #<%= item.requisitionCode %>
                  </span>
                  <span class="text-xs font-mono text-cyan-700 font-bold bg-cyan-50 px-2 py-0.5 rounded-md">
                    🏷️ Tubo: <%= item.sampleBarcode %>
                  </span>
                </div>

                <h2 class="text-base font-black text-slate-800 mt-1">
                  <%= item.patientName %> <span class="text-xs font-normal text-slate-500">(<%= item.patientAge %>)</span>
                </h2>

                <div class="text-xs font-bold text-sky-800 mt-1">
                  Exame: <%= item.examCode %> - <%= item.examTitle %> (<%= item.material %>)
                </div>

                <!-- Progress Bar -->
                <div class="w-full max-w-md bg-gray-100 rounded-full h-2.5 mt-2.5 overflow-hidden">
                  <div class="bg-sky-500 h-2.5 rounded-full transition-all duration-500" style="width: <%= item.progress || 50 %>%"></div>
                </div>

                <div class="flex items-center gap-3 text-[11px] text-slate-500 mt-1.5 font-mono">
                  <span>🔬 Equipamento: <b><%= item.equipment %></b></span>
                  <span>• Início: <%= item.startTime %></span>
                </div>
              </div>
            </div>

            <!-- Action: Simular Conclusão de Leitura -->
            <div class="flex flex-col items-end gap-2 shrink-0">
              <button 
                type="button" 
                onclick="simulateResult('<%= item.id %>', '<%= item.examCode %>')" 
                class="px-4 py-2.5 bg-sky-600 hover:bg-sky-700 text-white text-xs font-bold rounded-xl shadow-xs transition-all flex items-center gap-1.5 cursor-pointer"
              >
                <span>⚡</span> Simular Conclusão de Leitura
              </button>
            </div>

          </div>
        <% }); %>
      </div>
    <% } %>

  </div>

  <!-- ================= TAB 3: PRONTOS ================= -->
  <div id="tab-content-prontos" class="tab-content hidden space-y-4">
    
    <div class="flex items-center justify-between bg-emerald-50 border border-emerald-200 rounded-2xl p-4 text-emerald-900 mb-2">
      <div class="flex items-center gap-3">
        <span class="text-2xl">✅</span>
        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-emerald-800">Resultados Recebidos dos Equipamentos</h3>
          <p class="text-xs text-emerald-700 mt-0.5">Resultados processados e capturados automaticamente via comunicação serial/socket ASTM/HL7.</p>
        </div>
      </div>
    </div>

    <% if (!interfaceData.prontos || interfaceData.prontos.length === 0) { %>
      <div class="bg-white rounded-2xl p-12 text-center border border-gray-200 shadow-xs">
        <span class="text-4xl block mb-3">📄</span>
        <h3 class="text-base font-bold text-gray-800">Nenhum resultado pronto no momento</h3>
        <p class="text-xs text-gray-500 mt-1">Simule ou aguarde a leitura de exames na aba "Processando".</p>
      </div>
    <% } else { %>
      <div class="grid grid-cols-1 gap-4" id="prontos-list">
        <% interfaceData.prontos.forEach(function(item) { %>
          <div class="interface-card bg-white rounded-2xl p-5 border border-emerald-100 shadow-xs flex flex-col md:flex-row md:items-center justify-between gap-4"
               data-search="<%= (item.patientName + ' ' + item.requisitionCode + ' ' + item.examCode + ' ' + item.examTitle + ' ' + item.equipment).toLowerCase() %>"
               data-equipment="<%= item.equipment %>">
            
            <div class="flex items-start gap-3.5 flex-1">
              <div class="p-3 bg-emerald-50 text-emerald-600 rounded-xl font-bold text-lg shrink-0">
                ✅
              </div>
              <div class="flex-1">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="bg-emerald-100 text-emerald-800 text-[10px] font-black px-2.5 py-0.5 rounded-full uppercase tracking-wider">
                    Pronto p/ Laudo
                  </span>
                  <span class="text-xs font-mono font-bold text-slate-500">
                    Req #<%= item.requisitionCode %>
                  </span>
                  <span class="text-xs font-mono text-cyan-700 font-bold bg-cyan-50 px-2 py-0.5 rounded-md">
                    🏷️ Tubo: <%= item.sampleBarcode %>
                  </span>
                </div>

                <h2 class="text-base font-black text-slate-800 mt-1">
                  <%= item.patientName %> <span class="text-xs font-normal text-slate-500">(<%= item.patientAge %>)</span>
                </h2>

                <div class="text-xs font-bold text-slate-700 mt-1">
                  Exame: <%= item.examCode %> - <%= item.examTitle %>
                </div>

                <!-- Display Result Pill -->
                <div class="mt-2.5 inline-flex items-center gap-3 bg-slate-50 border border-slate-200 px-3.5 py-2 rounded-xl">
                  <span class="text-xs text-slate-500 font-bold uppercase">Resultado Lido:</span>
                  <span class="text-base font-black text-emerald-700 font-mono"><%= item.resultValue %> <%= item.unit %></span>
                  <span class="text-xs text-slate-400 font-mono">Ref: <%= item.refRange %></span>
                </div>

                <div class="flex items-center gap-3 text-[11px] text-slate-500 mt-2 font-mono">
                  <span>🔬 Equipamento: <b><%= item.equipment %></b></span>
                  <span>• Concluído: <%= item.completedTime %></span>
                </div>
              </div>
            </div>

            <!-- Actions: Copy JSON structure & Go to Digitacao -->
            <div class="flex flex-col items-end gap-2 shrink-0">
              <button 
                type="button" 
                onclick="showResultJson('<%= item.requisitionCode %>', '<%= item.patientName %>', '<%= item.patientAge %>', '<%= item.examCode %>', '<%= item.examTitle %>', '<%= item.resultValue %>', '<%= item.unit %>', '<%= item.material %>', '<%= item.equipment %>', '<%= item.refRange %>')" 
                class="px-4 py-2 bg-[#284701] hover:bg-[#1d3301] text-white text-xs font-bold rounded-xl shadow-xs transition-all flex items-center gap-1.5 cursor-pointer"
              >
                <span>📋</span> Copiar JSON do Laudo
              </button>

              <a 
                href="/admin/resultados/digitacao?req=<%= item.requisitionCode %>" 
                class="px-3.5 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-bold rounded-xl transition-all flex items-center gap-1.5 cursor-pointer"
              >
                <span>👁️</span> Abrir na Digitação
              </a>
            </div>

          </div>
        <% }); %>
      </div>
    <% } %>

  </div>

  <!-- ================= TAB 4: MENSAGENS ================= -->
  <div id="tab-content-mensagens" class="tab-content hidden space-y-4">
    
    <div class="flex items-center justify-between bg-slate-900 border border-slate-800 rounded-2xl p-4 text-white mb-2 shadow-sm">
      <div class="flex items-center gap-3">
        <span class="text-2xl text-cyan-400">📟</span>
        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-cyan-400">Log de Comunicação ASTM E1394 / HL7 v2</h3>
          <p class="text-xs text-slate-300 mt-0.5">Tráfego de mensagens em tempo real entre o LIS InovaLab e os controladores seriais RS-232 / TCP-IP.</p>
        </div>
      </div>

      <button 
        type="button" 
        onclick="clearLogs()" 
        class="px-3 py-1.5 bg-red-950 hover:bg-red-900 text-red-300 border border-red-800 text-xs font-bold rounded-xl transition-all flex items-center gap-1 cursor-pointer"
      >
        <span>🗑️</span> Limpar Log
      </button>
    </div>

    <% if (!interfaceData.mensagens || interfaceData.mensagens.length === 0) { %>
      <div class="bg-white rounded-2xl p-12 text-center border border-gray-200 shadow-xs">
        <span class="text-4xl block mb-3">💬</span>
        <h3 class="text-base font-bold text-gray-800">Nenhuma mensagem registrada no log</h3>
        <p class="text-xs text-gray-500 mt-1">As mensagens enviadas ou recebidas dos equipamentos serão registradas aqui em formato nativo ASTM/HL7.</p>
      </div>
    <% } else { %>
      <div class="space-y-3" id="mensagens-list">
        <% interfaceData.mensagens.forEach(function(msg) { %>
          <div class="bg-slate-950 border border-slate-800 rounded-2xl p-4 font-mono text-xs text-slate-200 shadow-sm"
               data-search="<%= (msg.equipment + ' ' + msg.payload + ' ' + msg.type + ' ' + msg.status).toLowerCase() %>"
               data-equipment="<%= msg.equipment %>">
            
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-800 pb-2.5 mb-2.5">
              <div class="flex items-center gap-2">
                <% if (msg.type === 'OUTBOUND') { %>
                  <span class="bg-amber-500/20 text-amber-400 border border-amber-500/30 text-[10px] font-bold px-2 py-0.5 rounded-full uppercase">
                    📤 LIS ➔ EQUIPAMENTO
                  </span>
                <% } else { %>
                  <span class="bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 text-[10px] font-bold px-2 py-0.5 rounded-full uppercase">
                    📥 EQUIPAMENTO ➔ LIS
                  </span>
                <% } %>

                <span class="text-slate-400 font-bold">🔬 <%= msg.equipment %></span>
                <span class="text-slate-600">• <%= msg.protocol %></span>
              </div>

              <div class="flex items-center gap-3 text-[11px] text-slate-400">
                <span class="text-emerald-400 font-bold">Status: <%= msg.status %></span>
                <span>⏱️ <%= msg.timestamp %></span>
              </div>
            </div>

            <div class="bg-slate-900 p-3 rounded-xl border border-slate-800 text-cyan-200 whitespace-pre-wrap overflow-x-auto selection:bg-cyan-800">
<%= msg.payload %>
            </div>

          </div>
        <% }); %>
      </div>
    <% } %>

  </div>

</div>

