<%- include('../../partials/header', { page: 'admin-lab-externo-materiais-alvaro' }) %>

<div class="p-4 sm:p-6 lg:p-8 max-w-[98vw] xl:max-w-[96vw] mx-auto w-full flex-1 space-y-6">

  <!-- Cabeçalho Principal da Tela -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 text-xs text-brand-neutral/60 font-mono uppercase tracking-wider mb-1">
        <a href="/admin" class="hover:text-brand-neutralDark transition-colors">Administração</a>
        <span>•</span>
        <span>Laboratório Externo</span>
        <span>•</span>
        <span class="text-amber-700 font-bold">Materiais Álvaro</span>
      </div>
      
      <div class="flex items-center gap-3">
        <div class="w-11 h-11 rounded-2xl bg-amber-500/10 border border-amber-500/30 shadow-sm flex items-center justify-center shrink-0 relative text-amber-700 font-black text-xl">
          🧫
        </div>
        <div>
          <h1 class="text-2xl font-black text-brand-neutralDark tracking-tight flex items-center gap-2">
            Materiais Álvaro
            <span class="text-xs font-mono font-bold bg-amber-100 text-amber-800 px-2.5 py-0.5 rounded-full uppercase border border-amber-200">Apoio Álvaro</span>
          </h1>
          <p class="text-xs text-brand-neutral/70">
            Cadastre e gerencie a lista de materiais e recipientes do Laboratório de Apoio Álvaro
          </p>
        </div>
      </div>
    </div>

    <!-- Botões Principais de Ação -->
    <div class="flex items-center gap-2 sm:gap-3 flex-wrap">
      <button type="button" id="btnSyncMateriais" onclick="syncMateriaisAlvaro()" class="px-4 py-2.5 bg-slate-900 hover:bg-slate-800 text-amber-400 font-bold text-xs uppercase tracking-wider rounded-xl shadow-md transition-all active:scale-95 cursor-pointer flex items-center gap-2 border border-amber-500/30">
        <svg id="syncIcon" class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99"/></svg>
        <span id="syncText">Sincronizar Materiais</span>
      </button>
      <button type="button" onclick="openMaterialModal()" class="px-5 py-2.5 bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs uppercase tracking-wider rounded-xl shadow-lg shadow-amber-600/20 transition-all active:scale-95 cursor-pointer flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
        <span>+ Novo Material Álvaro</span>
      </button>
    </div>
  </div>

  <!-- Cards de Métricas -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4">
    <div class="bg-white p-4 rounded-2xl border border-gray-200 shadow-2xs flex items-center justify-between">
      <div>
        <p class="text-[11px] font-bold text-gray-500 uppercase font-mono tracking-wider">Total de Materiais</p>
        <p id="stat-total-materiais" class="text-2xl font-black text-slate-800 font-mono mt-0.5"><%= materiais.length %></p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-amber-50 flex items-center justify-center text-amber-700 font-bold text-lg">🧫</div>
    </div>

    <div class="bg-white p-4 rounded-2xl border border-gray-200 shadow-2xs flex items-center justify-between">
      <div>
        <p class="text-[11px] font-bold text-gray-500 uppercase font-mono tracking-wider">Laboratório de Apoio</p>
        <p class="text-2xl font-black text-amber-800 font-mono mt-0.5">ÁLVARO</p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-amber-100 flex items-center justify-center text-amber-700 font-bold text-lg">🧪</div>
    </div>

    <div class="bg-white p-4 rounded-2xl border border-gray-200 shadow-2xs flex items-center justify-between sm:col-span-2 lg:col-span-1">
      <div>
        <p class="text-[11px] font-bold text-gray-500 uppercase font-mono tracking-wider">Status do Cadastro</p>
        <p class="text-xs font-bold text-emerald-600 flex items-center gap-1.5 mt-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
          Sincronizado & Ativo
        </p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-600 font-bold text-lg">✓</div>
    </div>
  </div>

  <!-- Filtro e Pesquisa -->
  <div class="bg-white p-4 rounded-2xl border border-gray-200 shadow-2xs flex flex-col md:flex-row md:items-center justify-between gap-3">
    <div class="relative flex-1">
      <input type="text" id="search-input" oninput="filterMaterialsTable()" placeholder="Pesquisar por Código ou Descrição do Material..." class="w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl font-bold text-xs text-slate-800 outline-none focus:ring-2 focus:ring-amber-500 transition-all">
      <span class="absolute left-3.5 top-3 text-gray-400 text-sm">🔍</span>
    </div>
    <div class="text-xs font-mono font-bold text-gray-500">
      Mostrando <span id="filtered-count" class="text-slate-800 font-extrabold"><%= materiais.length %></span> materiais
    </div>
  </div>

  <!-- Tabela de Materiais -->
  <div class="bg-white rounded-2xl border border-gray-200 shadow-2xs overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left font-mono text-xs">
        <thead class="bg-slate-900 text-white text-[10px] uppercase tracking-wider font-extrabold">
          <tr>
            <th class="p-3.5 w-48 text-center cursor-pointer hover:bg-slate-800 transition-colors select-none" onclick="toggleSortField('codigo')">
              Código <span id="sort-indicator-codigo" class="text-amber-400">▲</span>
            </th>
            <th class="p-3.5 cursor-pointer hover:bg-slate-800 transition-colors select-none" onclick="toggleSortField('descricao')">
              Descrição do Material <span id="sort-indicator-descricao" class="text-amber-400"></span>
            </th>
            <th class="p-3.5 w-32 text-center">Ações</th>
          </tr>
        </thead>
        <tbody id="materialsTableBody" class="divide-y divide-gray-100 bg-white">
          <!-- Renderizado via JS / EJS -->
        </tbody>
      </table>
    </div>

    <!-- Controles de Paginação -->
    <div id="paginationControls" class="px-4 py-3 bg-gray-50 border-t border-gray-200 flex flex-col sm:flex-row items-center justify-between gap-3 font-mono text-xs">
      <div id="paginationInfo" class="text-gray-600 font-bold">
        Exibindo 0-0 de 0
      </div>
      <div id="paginationButtons" class="flex items-center gap-1.5 flex-wrap">
        <!-- Renderizado via JS -->
      </div>
    </div>
  </div>

</div>

<!-- MODAL CADASTRAR / EDITAR MATERIAL ÁLVARO -->
<div id="materialModal" class="fixed inset-0 z-[100] bg-black/75 backdrop-blur-sm flex items-center justify-center p-3 sm:p-5 hidden">
  <div class="bg-white w-full max-w-lg rounded-2xl shadow-2xl border border-gray-200 overflow-hidden transform transition-all flex flex-col max-h-[90vh]">
    
    <!-- Header Modal -->
    <div class="px-5 py-4 bg-slate-900 text-white flex items-center justify-between shrink-0">
      <div class="flex items-center gap-2.5">
        <span class="text-2xl">🧫</span>
        <div>
          <h3 id="modalTitle" class="text-xs font-black uppercase font-mono tracking-wider text-amber-400">
            Cadastrar Material - Álvaro
          </h3>
          <p class="text-[10px] text-gray-300">Informe o código e a descrição do material</p>
        </div>
      </div>
      <button type="button" onclick="closeMaterialModal()" class="text-gray-400 hover:text-white text-2xl font-bold p-1 cursor-pointer">&times;</button>
    </div>

    <!-- Form Body -->
    <form id="materialForm" onsubmit="saveMaterialForm(event)" class="p-5 overflow-y-auto space-y-4 font-mono text-xs flex-1">
      <input type="hidden" id="modal-material-id" value="">

      <!-- Código -->
      <div>
        <label class="block font-bold text-slate-700 uppercase mb-1">Código do Material <span class="text-red-500">*</span>:</label>
        <input type="text" id="modal-material-codigo" required placeholder="Ex: SORO, EDTA, URINA_24H" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-xl font-bold text-slate-800 outline-none focus:ring-2 focus:ring-amber-500 uppercase">
        <p class="text-[10px] text-gray-400 mt-1">Código identificador único do material para o laboratório Álvaro</p>
      </div>

      <!-- Descrição -->
      <div>
        <label class="block font-bold text-slate-700 uppercase mb-1">Descrição do Material <span class="text-red-500">*</span>:</label>
        <input type="text" id="modal-material-descricao" required placeholder="Ex: Soro (Tubo Gel Separador / Amarelo ou Vermelho)" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-xl font-bold text-slate-800 outline-none focus:ring-2 focus:ring-amber-500">
        <p class="text-[10px] text-gray-400 mt-1">Descrição detalhada do frasco, tubo ou fracionamento</p>
      </div>

      <!-- Buttons -->
      <div class="pt-3 border-t border-gray-100 flex items-center justify-end gap-3">
        <button type="button" onclick="closeMaterialModal()" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold rounded-xl transition-all cursor-pointer">
          Cancelar
        </button>
        <button type="submit" id="btnSaveMaterial" class="px-5 py-2 bg-amber-600 hover:bg-amber-700 text-white font-bold rounded-xl shadow-md transition-all cursor-pointer flex items-center gap-1.5">
          <span>Salvar Material</span>
        </button>
      </div>
    </form>
  </div>
</div>

<!-- MODAL CONFIRMAR EXCLUSÃO -->
<div id="deleteModal" class="fixed inset-0 z-[110] bg-black/75 backdrop-blur-sm flex items-center justify-center p-3 hidden">
  <div class="bg-white w-full max-w-sm rounded-2xl shadow-2xl border border-gray-200 overflow-hidden p-5 text-center space-y-4 font-mono">
    <div class="w-12 h-12 rounded-2xl bg-red-100 text-red-600 flex items-center justify-center text-2xl mx-auto">
      ⚠️
    </div>
    <div>
      <h3 class="text-sm font-black text-slate-900 uppercase">Excluir Material?</h3>
      <p id="deleteModalText" class="text-xs text-gray-500 mt-1">Esta ação não poderá ser desfeita.</p>
    </div>
    <div class="flex items-center justify-center gap-3 pt-2">
      <button type="button" onclick="closeDeleteModal()" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold text-xs rounded-xl transition-all cursor-pointer">
        Cancelar
      </button>
      <button type="button" id="btnConfirmDelete" onclick="confirmDeleteMaterial()" class="px-5 py-2 bg-red-600 hover:bg-red-700 text-white font-bold text-xs rounded-xl shadow-md transition-all cursor-pointer">
        Sim, Excluir
      </button>
    </div>
  </div>
</div>

<!-- TOAST CONTAINER -->
<div id="toastContainer" class="fixed bottom-5 right-5 z-[200] flex flex-col gap-2 pointer-events-none"></div>

<script>
  let materialsData = <%- JSON.stringify(materiais) %>;
  let materialToDeleteId = null;

  let currentSortField = 'codigo';   // Ordem crescente por código
  let currentSortAsc = true;         // Ordem crescente (A-Z / 0-9)
  let currentPage = 1;
  const pageSize = 100;              // 100 em 100
  let currentFilteredList = [];

  function sortList(list) {
    return list.slice().sort((a, b) => {
      let valA = '';
      let valB = '';
      if (currentSortField === 'codigo') {
        valA = String(a.codigo || a.descricao || '').trim();
        valB = String(b.codigo || b.descricao || '').trim();
      } else {
        valA = String(a.descricao || a.codigo || '').trim();
        valB = String(b.descricao || b.codigo || '').trim();
      }

      const comp = valA.localeCompare(valB, 'pt-BR', { numeric: true, sensitivity: 'base' });
      if (comp !== 0) {
        return currentSortAsc ? comp : -comp;
      }

      const subA = String(a.codigo || '').trim();
      const subB = String(b.codigo || '').trim();
      return currentSortAsc ? subA.localeCompare(subB, 'pt-BR') : -subA.localeCompare(subB, 'pt-BR');
    });
  }

  function toggleSortField(field) {
    if (currentSortField === field) {
      currentSortAsc = !currentSortAsc;
    } else {
      currentSortField = field;
      currentSortAsc = true;
    }
    filterMaterialsTable(true);
  }

  function updateSortIndicators() {
    const codInd = document.getElementById('sort-indicator-codigo');
    const descInd = document.getElementById('sort-indicator-descricao');
    if (codInd) codInd.innerText = currentSortField === 'codigo' ? (currentSortAsc ? ' ▲' : ' ▼') : '';
    if (descInd) descInd.innerText = currentSortField === 'descricao' ? (currentSortAsc ? ' ▲' : ' ▼') : '';
  }

  function filterMaterialsTable(resetPage = true) {
    const queryInput = document.getElementById('search-input');
    const query = queryInput ? queryInput.value.toLowerCase().trim() : '';

    let filtered = materialsData;
    if (query) {
      filtered = materialsData.filter(item => {
        const cod = (item.codigo || '').toLowerCase();
        const desc = (item.descricao || '').toLowerCase();
        return cod.includes(query) || desc.includes(query);
      });
    }

    currentFilteredList = sortList(filtered);

    if (resetPage) {
      currentPage = 1;
    }

    updateSortIndicators();
    renderTable();
  }

  function renderTable() {
    const tbody = document.getElementById('materialsTableBody');
    const totalItems = currentFilteredList.length;
    const totalPages = Math.ceil(totalItems / pageSize) || 1;

    if (currentPage < 1) currentPage = 1;
    if (currentPage > totalPages) currentPage = totalPages;

    document.getElementById('stat-total-materiais').innerText = materialsData.length;
    document.getElementById('filtered-count').innerText = totalItems;

    if (totalItems === 0) {
      tbody.innerHTML = `
        <tr>
          <td colspan="3" class="p-8 text-center text-gray-400 font-bold">
            <span class="text-3xl block mb-2">🧫</span>
            Nenhum material cadastrado para o Laboratório Álvaro.
          </td>
        </tr>
      `;
      renderPagination(0, 0, 0, 1);
      return;
    }

    const startIdx = (currentPage - 1) * pageSize;
    const endIdx = Math.min(startIdx + pageSize, totalItems);
    const pageItems = currentFilteredList.slice(startIdx, endIdx);

    tbody.innerHTML = pageItems.map(item => {
      const codeClean = item.codigo ? item.codigo.replace(/'/g, "\\'") : '';
      const descClean = item.descricao ? item.descricao.replace(/'/g, "\\'") : '';

      return `
        <tr class="hover:bg-amber-50/40 transition-colors group">
          <td class="p-3.5 text-center">
            <span class="inline-block px-2.5 py-1 bg-amber-100 text-amber-900 border border-amber-200 font-extrabold rounded-lg text-xs uppercase">
              ${escapeHtml(item.codigo || '-')}
            </span>
          </td>
          <td class="p-3.5 font-bold text-slate-800">
            ${escapeHtml(item.descricao || '-')}
          </td>
          <td class="p-3.5 text-center">
            <div class="flex items-center justify-center gap-1.5">
              <button type="button" onclick="openMaterialModal('${item.id}', '${codeClean}', '${descClean}')" title="Editar Material" class="p-1.5 rounded-lg text-amber-700 hover:bg-amber-100 transition-colors cursor-pointer">
                ✏️
              </button>
              <button type="button" onclick="openDeleteModal('${item.id}', '${codeClean}')" title="Excluir Material" class="p-1.5 rounded-lg text-red-600 hover:bg-red-100 transition-colors cursor-pointer">
                🗑️
              </button>
            </div>
          </td>
        </tr>
      `;
    }).join('');

    renderPagination(startIdx + 1, endIdx, totalItems, totalPages);
  }

  function renderPagination(startNum, endNum, totalItems, totalPages) {
    const infoEl = document.getElementById('paginationInfo');
    const buttonsEl = document.getElementById('paginationButtons');

    if (!infoEl || !buttonsEl) return;

    if (totalItems === 0) {
      infoEl.innerText = 'Nenhum material para exibir';
      buttonsEl.innerHTML = '';
      return;
    }

    infoEl.innerHTML = `Exibindo <span class="font-black text-slate-800">${startNum}-${endNum}</span> de <span class="font-black text-slate-800">${totalItems}</span> materiais (Pág. ${currentPage}/${totalPages})`;

    let html = '';

    // Botão Anterior
    html += `
      <button type="button" onclick="changePage(${currentPage - 1})" ${currentPage <= 1 ? 'disabled' : ''} class="px-3 py-1.5 bg-white border border-gray-200 rounded-lg font-bold text-xs text-slate-700 hover:bg-amber-50 hover:border-amber-300 disabled:opacity-40 disabled:hover:bg-white disabled:hover:border-gray-200 transition-all cursor-pointer disabled:cursor-not-allowed">
        ◀ Anterior
      </button>
    `;

    const maxVisiblePages = 5;
    let startPage = Math.max(1, currentPage - Math.floor(maxVisiblePages / 2));
    let endPage = Math.min(totalPages, startPage + maxVisiblePages - 1);

    if (endPage - startPage + 1 < maxVisiblePages) {
      startPage = Math.max(1, endPage - maxVisiblePages + 1);
    }

    if (startPage > 1) {
      html += `<button type="button" onclick="changePage(1)" class="px-2.5 py-1.5 bg-white border border-gray-200 rounded-lg font-bold text-xs text-slate-700 hover:bg-amber-50 transition-all cursor-pointer">1</button>`;
      if (startPage > 2) {
        html += `<span class="px-1 text-gray-400 font-bold">...</span>`;
      }
    }

    for (let p = startPage; p <= endPage; p++) {
      if (p === currentPage) {
        html += `<span class="px-3 py-1.5 bg-amber-600 text-white rounded-lg font-extrabold text-xs shadow-2xs">${p}</span>`;
      } else {
        html += `<button type="button" onclick="changePage(${p})" class="px-3 py-1.5 bg-white border border-gray-200 rounded-lg font-bold text-xs text-slate-700 hover:bg-amber-50 hover:border-amber-300 transition-all cursor-pointer">${p}</button>`;
      }
    }

    if (endPage < totalPages) {
      if (endPage < totalPages - 1) {
        html += `<span class="px-1 text-gray-400 font-bold">...</span>`;
      }
      html += `<button type="button" onclick="changePage(${totalPages})" class="px-2.5 py-1.5 bg-white border border-gray-200 rounded-lg font-bold text-xs text-slate-700 hover:bg-amber-50 transition-all cursor-pointer">${totalPages}</button>`;
    }

    // Botão Próxima
    html += `
      <button type="button" onclick="changePage(${currentPage + 1})" ${currentPage >= totalPages ? 'disabled' : ''} class="px-3 py-1.5 bg-white border border-gray-200 rounded-lg font-bold text-xs text-slate-700 hover:bg-amber-50 hover:border-amber-300 disabled:opacity-40 disabled:hover:bg-white disabled:hover:border-gray-200 transition-all cursor-pointer disabled:cursor-not-allowed">
        Próxima ▶
      </button>
    `;

    buttonsEl.innerHTML = html;
  }

  function changePage(newPage) {
    currentPage = newPage;
    renderTable();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function openMaterialModal(id = '', codigo = '', descricao = '') {
    document.getElementById('modal-material-id').value = id;
    document.getElementById('modal-material-codigo').value = codigo;
    document.getElementById('modal-material-descricao').value = descricao;

    const modalTitle = document.getElementById('modalTitle');
    if (id) {
      modalTitle.innerText = 'Editar Material - Álvaro';
    } else {
      modalTitle.innerText = 'Cadastrar Material - Álvaro';
    }

    document.getElementById('materialModal').classList.remove('hidden');
    setTimeout(() => {
      document.getElementById('modal-material-codigo').focus();
    }, 100);
  }

  function closeMaterialModal() {
    document.getElementById('materialModal').classList.add('hidden');
  }

  async function saveMaterialForm(event) {
    event.preventDefault();
    const btn = document.getElementById('btnSaveMaterial');
    btn.disabled = true;
    btn.innerText = 'Salvando...';

    const id = document.getElementById('modal-material-id').value;
    const codigo = document.getElementById('modal-material-codigo').value;
    const descricao = document.getElementById('modal-material-descricao').value;

    try {
      const res = await fetch('/api/lab-externo/materiais-alvaro/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, codigo, descricao })
      });

      const data = await res.json();
      if (data.success) {
        materialsData = data.materiais;
        filterMaterialsTable();
        closeMaterialModal();
        showToast(id ? 'Material atualizado com sucesso!' : 'Novo material cadastrado!', 'success');
      } else {
        showToast(data.message || 'Erro ao salvar material', 'error');
      }
    } catch (err) {
      console.error(err);
      showToast('Erro de conexão ao salvar material.', 'error');
    } finally {
      btn.disabled = false;
      btn.innerText = 'Salvar Material';
    }
  }

  function openDeleteModal(id, codigo) {
    materialToDeleteId = id;
    document.getElementById('deleteModalText').innerText = `Deseja realmente excluir o material "${codigo}"?`;
    document.getElementById('deleteModal').classList.remove('hidden');
  }

  function closeDeleteModal() {
    materialToDeleteId = null;
    document.getElementById('deleteModal').classList.add('hidden');
  }

  async function confirmDeleteMaterial() {
    if (!materialToDeleteId) return;

    const btn = document.getElementById('btnConfirmDelete');
    btn.disabled = true;
    btn.innerText = 'Excluindo...';

    try {
      const res = await fetch('/api/lab-externo/materiais-alvaro/delete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: materialToDeleteId })
      });

      const data = await res.json();
      if (data.success) {
        materialsData = data.materiais;
        filterMaterialsTable();
        closeDeleteModal();
        showToast('Material excluído com sucesso!', 'success');
      } else {
        showToast(data.message || 'Erro ao excluir material', 'error');
      }
    } catch (err) {
      console.error(err);
      showToast('Erro de conexão ao excluir material.', 'error');
    } finally {
      btn.disabled = false;
      btn.innerText = 'Sim, Excluir';
    }
  }

  async function syncMateriaisAlvaro() {
    const btn = document.getElementById('btnSyncMateriais');
    const icon = document.getElementById('syncIcon');
    const text = document.getElementById('syncText');

    btn.disabled = true;
    icon.classList.add('animate-spin');
    text.innerText = 'Sincronizando...';

    try {
      const res = await fetch('/api/lab-externo/materiais-alvaro/sync', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });

      const data = await res.json();
      if (data.success) {
        materialsData = data.materiais;
        filterMaterialsTable();
        const msg = data.countNew > 0
          ? `Sincronização concluída! ${data.countNew} novo(s) material(is) adicionado(s). Total: ${data.countTotal}`
          : `Sincronização concluída! Todos os ${data.countTotal} materiais já estão atualizados.`;
        showToast(msg, 'success');
      } else {
        showToast(data.message || 'Erro ao sincronizar materiais.', 'error');
      }
    } catch (err) {
      console.error(err);
      showToast('Erro de conexão ao sincronizar com o Álvaro.', 'error');
    } finally {
      btn.disabled = false;
      icon.classList.remove('animate-spin');
      text.innerText = 'Sincronizar Materiais';
    }
  }

  function showToast(message, type = 'success') {
    const container = document.getElementById('toastContainer');
    const toast = document.createElement('div');
    toast.className = `pointer-events-auto px-4 py-3 rounded-xl font-mono text-xs font-bold text-white shadow-xl flex items-center gap-2 transform transition-all duration-300 translate-y-2 opacity-0 ${
      type === 'success' ? 'bg-emerald-600' : 'bg-red-600'
    }`;
    toast.innerHTML = `<span>${type === 'success' ? '✓' : '⚠️'}</span><span>${escapeHtml(message)}</span>`;

    container.appendChild(toast);

    setTimeout(() => {
      toast.classList.remove('translate-y-2', 'opacity-0');
    }, 10);

    setTimeout(() => {
      toast.classList.add('opacity-0', 'translate-y-2');
      setTimeout(() => toast.remove(), 300);
    }, 3000);
  }

  function escapeHtml(str) {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  // Render inicial
  document.addEventListener('DOMContentLoaded', () => {
    filterMaterialsTable(true);
  });
</script>

