<%- include('../partials/header', { page: 'admin-laboratorios' }) %>

<div class="p-4 sm:p-6 lg:p-8 max-w-[98vw] xl:max-w-[96vw] mx-auto w-full flex-1 space-y-6">

  <!-- Cabeçalho Principal da Tela (Padrão InovaLab / LIS) -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 text-xs text-brand-neutral/60 font-mono uppercase tracking-wider mb-1">
        <a href="/admin" class="hover:text-brand-neutralDark transition-colors">Administração</a>
        <span>•</span>
        <span>Cadastros</span>
        <span>•</span>
        <span class="text-emerald-700 font-bold">Laboratório de Apoio</span>
      </div>
      
      <div class="flex items-center gap-3">
        <!-- Ícone do Cadastro -->
        <div class="w-11 h-11 rounded-2xl bg-white border border-gray-200 shadow-sm flex items-center justify-center shrink-0 relative">
          <svg class="w-6 h-6 text-emerald-700" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>
          </svg>
          <div class="absolute -bottom-1 -right-1 w-5 h-5 bg-emerald-600 rounded-lg text-white font-black text-xs flex items-center justify-center border-2 border-white shadow-xs">
            +
          </div>
        </div>
        <div>
          <h1 class="text-2xl font-black text-brand-neutralDark tracking-tight">
            Cadastro de Laboratório de Apoio
          </h1>
          <p class="text-xs text-brand-neutral/70">
            Cadastre e gerencie os laboratórios de apoio terceirizados (Ex: Alvaro, Hermes Pardini...)
          </p>
        </div>
      </div>
    </div>

    <!-- Botão Principal de Ação -->
    <div class="flex items-center gap-3">
      <button type="button" onclick="openNewLabModal()" class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs uppercase tracking-wider rounded-xl shadow-lg shadow-emerald-600/20 transition-all active:scale-95 cursor-pointer flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
        <span>+ Novo Laboratório</span>
      </button>
    </div>
  </div>

  <!-- Cards de Métricas / Resumo dos Laboratórios -->
  <% 
    const totalLabs = labs.length;
  %>
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 sm:gap-4">
    <div class="bg-white p-4 rounded-2xl border border-gray-200 shadow-2xs flex items-center justify-between">
      <div>
        <p class="text-[11px] font-bold text-gray-500 uppercase font-mono tracking-wider">Total Registrados</p>
        <p class="text-2xl font-black text-slate-800 font-mono mt-0.5"><%= totalLabs %></p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-600 text-lg">🧪</div>
    </div>

    <div class="bg-white p-4 rounded-2xl border border-gray-200 shadow-2xs flex items-center justify-between">
      <div>
        <p class="text-[11px] font-bold text-emerald-600 uppercase font-mono tracking-wider">Status do Cadastro</p>
        <p class="text-2xl font-black text-emerald-700 font-mono mt-0.5">Ativo</p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-600 text-lg">✅</div>
    </div>

    <div class="bg-white p-4 rounded-2xl border border-gray-200 shadow-2xs flex items-center justify-between">
      <div>
        <p class="text-[11px] font-bold text-blue-600 uppercase font-mono tracking-wider">Próximo Código</p>
        <p class="text-2xl font-black text-blue-700 font-mono mt-0.5">
          <% 
            let maxCod = 0;
            labs.forEach(l => {
              const num = parseInt(l.codigo || l.id, 10);
              if (!isNaN(num) && num > maxCod) maxCod = num;
            });
          %>
          <%= maxCod + 1 %>
        </p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center text-blue-600 text-lg">🏷️</div>
    </div>
  </div>

  <!-- TABELA / LISTA PRINCIPAL DE LABORATÓRIOS DE APOIO -->
  <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
    
    <!-- Barra Superior de Pesquisa e Filtros -->
    <div class="p-4 bg-slate-50/80 border-b border-gray-200 flex flex-col md:flex-row items-center justify-between gap-3">
      
      <div class="flex items-center gap-2 w-full md:w-auto">
        <span class="text-sm font-black text-slate-800 uppercase tracking-wide shrink-0">Laboratórios de Apoio</span>
        <span id="labsCounterBadge" class="px-2.5 py-0.5 bg-emerald-100 text-emerald-800 rounded-full text-xs font-bold font-mono">
          <%= totalLabs %> cadastrados
        </span>
      </div>

      <!-- Campo de Busca -->
      <div class="flex items-center gap-2.5 w-full md:w-auto">
        <div class="relative w-full sm:w-80">
          <input type="text" id="searchLabsInput" onkeyup="filterLabsTable()" placeholder="Buscar por código ou descrição..." class="w-full pl-8 pr-3 py-1.5 bg-white border border-gray-300 rounded-xl text-xs outline-none focus:ring-2 focus:ring-emerald-500 shadow-2xs">
          <span class="absolute left-2.5 top-2 text-gray-400 text-xs">🔍</span>
        </div>
      </div>

    </div>

    <!-- Tabela de Laboratórios -->
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-gray-100/90 border-b border-gray-200 text-[10px] font-black text-gray-500 uppercase font-mono tracking-wider">
            <th class="p-3 w-28 text-center">Código</th>
            <th class="p-3">Descrição</th>
            <th class="p-3 w-32 text-center">Ações</th>
          </tr>
        </thead>
        <tbody id="labsTableBody" class="divide-y divide-gray-100 text-xs font-medium">
          <% if (labs.length === 0) { %>
            <tr>
              <td colspan="3" class="p-8 text-center text-gray-400 font-sans italic">
                Nenhum laboratório de apoio cadastrado até o momento.
              </td>
            </tr>
          <% } else { %>
            <% labs.forEach(lab => { 
                const cod = lab.codigo || lab.id;
                const desc = lab.descricao || lab.name || '';
            %>
              <tr class="lab-row hover:bg-emerald-50/40 transition-colors" data-search="<%= (cod + ' ' + desc).toLowerCase() %>">
                <td class="p-3 text-center font-mono font-bold text-slate-700 bg-slate-50/50">
                  #<%= cod %>
                </td>
                <td class="p-3">
                  <div class="font-bold text-slate-800 text-sm"><%= desc %></div>
                </td>
                <td class="p-3 text-center">
                  <div class="flex items-center justify-center gap-1.5">
                    <button type="button" onclick="editLab('<%= lab.id %>', '<%= cod %>', '<%= desc.replace(/'/g, "\\'") %>')" title="Editar Laboratório" class="px-2 py-1 bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-200 rounded-lg font-bold text-xs transition-all flex items-center gap-1 cursor-pointer">
                      ✏️
                    </button>
                    <button type="button" onclick="deleteLab('<%= lab.id %>', '<%= desc.replace(/'/g, "\\'") %>')" title="Excluir Laboratório" class="px-2 py-1 bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 rounded-lg font-bold text-xs transition-all flex items-center gap-1 cursor-pointer">
                      🗑️
                    </button>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>

  </div>

</div>

<!-- MODAL DE CADASTRO / EDIÇÃO DE LABORATÓRIO DE APOIO -->
<div id="labModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 flex items-center justify-center p-4 hidden">
  <div class="bg-white w-full max-w-lg rounded-2xl shadow-2xl border border-gray-200 overflow-hidden transform transition-all flex flex-col max-h-[90vh]">
    
    <!-- Modal Header -->
    <div class="p-4 bg-slate-900 text-white flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="text-xl">🧪</span>
        <h3 id="labModalTitle" class="text-sm font-extrabold uppercase font-mono tracking-wider text-brand-gold">
          Cadastrar Laboratório de Apoio
        </h3>
      </div>
      <button type="button" onclick="closeLabModal()" class="text-white/70 hover:text-white text-xl font-bold p-1 cursor-pointer">&times;</button>
    </div>

    <!-- Form Container -->
    <form id="labForm" action="/admin/laboratorios/save" method="POST" class="p-6 space-y-4 overflow-y-auto flex-1">
      <input type="hidden" name="id" id="lab-id" value="">

      <!-- Código -->
      <div class="space-y-1">
        <label for="lab-codigo" class="block text-xs font-extrabold text-slate-700 uppercase font-mono">
          Código: <span class="text-rose-500">*</span>
        </label>
        <input type="text" name="codigo" id="lab-codigo" required class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-xs font-bold font-mono text-slate-800 outline-none focus:ring-2 focus:ring-emerald-500">
        <p class="text-[10px] text-gray-500">Código identificador do laboratório de apoio.</p>
      </div>

      <!-- Descrição -->
      <div class="space-y-1">
        <label for="lab-descricao" class="block text-xs font-extrabold text-slate-700 uppercase font-mono">
          Descrição: <span class="text-rose-500">*</span>
        </label>
        <input type="text" name="descricao" id="lab-descricao" required placeholder="Ex: Alvaro, Hermes Pardini..." class="w-full px-3 py-2 bg-white border border-gray-300 rounded-xl text-xs font-bold text-slate-800 outline-none focus:ring-2 focus:ring-emerald-500">
        <p class="text-[10px] text-gray-500">Nome/Descrição do laboratório de apoio terceirizado.</p>
      </div>

      <!-- Footer Actions inside Modal -->
      <div class="pt-4 border-t border-gray-100 flex items-center justify-end gap-3">
        <button type="button" onclick="closeLabModal()" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold text-xs rounded-xl uppercase font-mono transition-all cursor-pointer">
          Cancelar
        </button>
        <button type="submit" class="px-5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-xs rounded-xl uppercase font-mono tracking-wider shadow-md shadow-emerald-600/20 transition-all active:scale-95 cursor-pointer">
          💾 Salvar
        </button>
      </div>
    </form>

  </div>
</div>

<script>
  let labsList = <%- JSON.stringify(labs) %>;

  function openNewLabModal() {
    document.getElementById('labForm').reset();
    document.getElementById('lab-id').value = '';
    
    // Gerar próximo código sequencial
    let maxCod = 0;
    labsList.forEach(l => {
      const num = parseInt(l.codigo || l.id, 10);
      if (!isNaN(num) && num > maxCod) maxCod = num;
    });
    document.getElementById('lab-codigo').value = String(maxCod + 1);

    document.getElementById('labModalTitle').innerText = 'Cadastrar Novo Laboratório de Apoio';
    document.getElementById('labModal').classList.remove('hidden');
    setTimeout(() => document.getElementById('lab-descricao').focus(), 100);
  }

  function closeLabModal() {
    document.getElementById('labModal').classList.add('hidden');
  }

  function editLab(id, codigo, descricao) {
    document.getElementById('lab-id').value = id;
    document.getElementById('lab-codigo').value = codigo;
    document.getElementById('lab-descricao').value = descricao;

    document.getElementById('labModalTitle').innerText = 'Editar Laboratório de Apoio #' + codigo;
    document.getElementById('labModal').classList.remove('hidden');
    setTimeout(() => document.getElementById('lab-descricao').focus(), 100);
  }

  function deleteLab(id, desc) {
    if (confirm('Tem certeza que deseja excluir o laboratório de apoio "' + desc + '"?')) {
      fetch('/admin/laboratorios/delete/' + encodeURIComponent(id), {
        method: 'POST',
        headers: { 'Accept': 'application/json' }
      }).then(res => {
        if (res.ok) {
          window.location.reload();
        } else {
          window.location.href = '/admin/laboratorios/delete/' + encodeURIComponent(id);
        }
      }).catch(() => {
        window.location.href = '/admin/laboratorios/delete/' + encodeURIComponent(id);
      });
    }
  }

  function filterLabsTable() {
    const query = document.getElementById('searchLabsInput').value.toLowerCase().trim();
    const rows = document.querySelectorAll('.lab-row');
    let visibleCount = 0;

    rows.forEach(row => {
      const text = row.getAttribute('data-search') || '';
      if (!query || text.includes(query)) {
        row.classList.remove('hidden');
        visibleCount++;
      } else {
        row.classList.add('hidden');
      }
    });

    const badge = document.getElementById('labsCounterBadge');
    if (badge) {
      badge.innerText = visibleCount + ' exibidos';
    }
  }
</script>

<%- include('../partials/footer') %>
