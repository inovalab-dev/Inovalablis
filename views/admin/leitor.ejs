              </button>
            </div>
          </div>

          <!-- Ação Principal: Enviar para Análise -->
          <div class="mt-6 pt-5 border-t border-brand-light/10">
            <button type="button" id="btn-analyze" disabled onclick="sendToIA()" class="w-full py-4 px-6 bg-brand-dark hover:bg-brand-light disabled:bg-gray-200 disabled:text-gray-400 disabled:cursor-not-allowed text-white text-sm font-extrabold rounded-2xl shadow-md transition-all flex items-center justify-center gap-2 cursor-pointer">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
              Analisar Guia com Inteligência Artificial
            </button>
            
            <button type="button" id="btn-reset" onclick="resetAll()" class="w-full mt-2 py-3 px-6 bg-brand-softBg hover:bg-brand-light/20 text-brand-dark text-xs font-bold rounded-2xl transition-all hidden flex items-center justify-center gap-2 cursor-pointer">
              Tirar Outra Foto / Novo Scan
            </button>
          </div>

        </div>

        <!-- Informativo da Recepção -->
        <div class="bg-brand-softBg/50 rounded-3xl p-5 border border-brand-light/10 text-[11px] leading-relaxed text-brand-dark/85">
          <h4 class="font-bold font-mono text-xs uppercase tracking-wider mb-2 flex items-center gap-1.5 text-brand-dark">
            <svg class="w-4 h-4 text-brand-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Dicas para Melhor Leitura
          </h4>
          <ul class="list-disc pl-4 space-y-1">
            <li>Garanta um ambiente bem iluminado para evitar sombras e borrões nas letras.</li>
            <li>Centralize os exames da guia médica dentro da moldura tracejada.</li>
            <li>O sistema entende abreviações médicas comuns (ex: HMG, EAS, TSH, Urina I, Glicose).</li>
            <li>Se faltar algum exame na leitura, você poderá registrá-lo posteriormente.</li>
          </ul>
        </div>

      </div>

      <!-- COLUNA DIREITA: RESULTADOS E REQUISIÇÃO -->
      <div class="lg:col-span-7">
        
        <!-- ESTADO INICIAL (VAZIO) -->
        <div id="results-empty-state" class="bg-white rounded-3xl border border-brand-light/15 p-12 text-center shadow-sm h-full flex flex-col items-center justify-center space-y-6">
          <div class="w-16 h-16 bg-brand-softBg text-brand-light rounded-full flex items-center justify-center">
            <svg class="w-8 h-8 text-brand-dark/60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/></svg>
          </div>
          <div>
            <h3 class="text-sm font-extrabold text-brand-dark font-mono uppercase tracking-wider">Aguardando Captura</h3>
            <p class="text-xs text-gray-400 mt-1 max-w-sm mx-auto mb-4">Tire uma foto ou faça upload da imagem da requisição médica na coluna esquerda para obter a análise.</p>
            
            <div class="relative max-w-md mx-auto pt-4 border-t border-brand-light/10 space-y-3">
              <p class="text-xs font-bold text-brand-dark font-mono uppercase tracking-wider">Ou Monte a Requisição Manualmente</p>
              
              <div class="relative">
                <input type="text" id="empty-search-input" oninput="filterManualSearch('empty')" placeholder="Digite o nome de um exame para adicionar..." class="w-full px-4 py-3 rounded-xl border border-brand-light/30 focus:outline-none focus:ring-1 focus:ring-brand-dark bg-brand-neutralLight text-xs font-semibold">
                <div id="empty-search-dropdown" class="absolute left-0 right-0 mt-1 max-h-48 overflow-y-auto bg-white border border-brand-light/20 rounded-xl shadow-lg z-50 hidden text-left divide-y divide-brand-light/5"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- ESTADO DE LOADING ANIMADO -->
        <div id="results-loading-state" class="bg-white rounded-3xl border border-brand-light/15 p-12 text-center shadow-sm h-full flex flex-col items-center justify-center space-y-6 hidden">
          <div class="relative flex items-center justify-center">
            <!-- Pulsar Circles -->
            <div class="w-20 h-20 border-4 border-brand-light/10 border-t-brand-dark rounded-full animate-spin"></div>
            <div class="absolute w-12 h-12 bg-brand-softBg rounded-full flex items-center justify-center">
              <svg class="w-6 h-6 text-brand-dark animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
            </div>
          </div>
          <div class="space-y-2">
            <h3 class="text-sm font-extrabold text-brand-dark font-mono uppercase tracking-wider">Analisando Imagem...</h3>
            <div class="space-y-1 font-mono text-[10px] text-gray-400">
              <p id="loading-step-1" class="text-brand-dark font-bold">● Lendo canais ópticos e texto da imagem</p>
              <p id="loading-step-2">○ Extraindo exames médicos via Gemini AI</p>
              <p id="loading-step-3">○ Cruzando com os códigos do sistema</p>
            </div>
          </div>
        </div>

