              <div class="relative">
                <input type="text" id="success-search-input" oninput="filterManualSearch('success')" placeholder="Escreva o nome do exame para adicionar..." class="w-full px-4 py-2.5 rounded-xl border border-brand-light/30 focus:outline-none focus:ring-1 focus:ring-brand-dark bg-white text-xs font-semibold">
