<%- include('../partials/header', { page: 'admin' }) %>

<!-- Middleware de Proteção Admin Visual -->
<script>
  // Garantir cookie de autenticação visualmente rápido
  if (!document.cookie.includes('admin_token=')) {
    window.location.href = '/admin/login';
  }
</script>

<section class="py-8 bg-brand-softBg/30 min-h-screen">
  <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Breadcrumb -->
    <div class="flex items-center justify-between mb-8">
      <div class="flex items-center gap-2 text-xs font-semibold text-gray-500">
        <a href="/admin" class="hover:text-brand-dark transition-colors">Administração</a>
        <span>&rsaquo;</span>
        <span class="text-brand-dark font-bold font-mono uppercase text-[10px]">Leitor de Guia (IA)</span>
      </div>
      <a href="/admin" class="inline-flex items-center gap-2 text-xs font-bold text-brand-dark hover:text-brand-light transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
        Voltar ao Painel
      </a>
    </div>

    <!-- Título Principal -->
    <div class="mb-8">
      <h1 class="text-2xl sm:text-3xl font-extrabold text-brand-dark tracking-tight">Scanner de Guia Médica</h1>
      <p class="text-xs sm:text-sm text-gray-500 mt-1">Capture ou envie a imagem de uma guia de exames para extrair automaticamente os exames, códigos do sistema e laboratórios de apoio.</p>
    </div>

    <% if (!apiKeyConfigured) { %>
      <!-- Aviso de Chave de API Ausente -->
      <div class="bg-amber-50 border border-amber-200 rounded-3xl p-6 mb-8 flex flex-col sm:flex-row gap-4 items-start">
        <div class="p-3 bg-amber-100 text-amber-800 rounded-2xl">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
        </div>
        <div>
          <h3 class="text-sm font-bold text-amber-900">Chave de API do Gemini não configurada</h3>
          <p class="text-xs text-amber-700/90 mt-1 leading-relaxed">Para utilizar o Leitor de Guia Inteligente, é necessário que a variável de ambiente <code class="font-mono font-bold text-amber-950 bg-amber-200/50 px-1 rounded">GEMINI_API_KEY</code> esteja configurada no painel de controle (Settings > Secrets). O sistema operará em modo de simulação demonstrativa na ausência desta chave.</p>
        </div>
      </div>
    <% } %>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- COLUNA ESQUERDA: CAPTURA E UPLOAD -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- Bloco de Origem da Imagem -->
        <div class="bg-white rounded-3xl border border-brand-light/15 p-6 shadow-sm">
          <h2 class="text-sm font-extrabold text-brand-dark font-mono uppercase tracking-wider mb-4 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-brand-light"></span>
            1. Capturar ou Enviar Guia
          </h2>

          <!-- Abas para alternar Camera / Arquivo -->
          <div class="flex bg-brand-softBg/60 p-1 rounded-2xl mb-5">
            <button onclick="switchTab('camera')" id="tab-camera" class="flex-1 text-center py-2 text-xs font-bold rounded-xl transition-all cursor-pointer bg-white text-brand-dark shadow-sm">
              Câmera do Celular / Web
            </button>
            <button onclick="switchTab('upload')" id="tab-upload" class="flex-1 text-center py-2 text-xs font-bold rounded-xl transition-all cursor-pointer text-gray-500 hover:text-brand-dark">
              Upload de Arquivo
            </button>
          </div>

          <!-- SEÇÃO DA CÂMERA -->
          <div id="section-camera" class="space-y-4">
            <div class="relative bg-brand-neutralDark rounded-2xl overflow-hidden aspect-[4/3] flex items-center justify-center border border-brand-light/10 shadow-inner">
              
              <!-- Video Stream -->
              <video id="video-stream" autoplay playsinline class="w-full h-full object-cover hidden"></video>
              
              <!-- Canvas Oculto para Snapshot -->
              <canvas id="snapshot-canvas" class="hidden"></canvas>
              
              <!-- Foto Capturada Preview -->
              <img id="image-preview" class="w-full h-full object-contain hidden" alt="Foto da Guia">

              <!-- Placeholder Inicial -->
              <div id="camera-placeholder" class="text-center p-6 space-y-3 z-10">
                <div class="w-16 h-16 bg-white/10 rounded-full flex items-center justify-center mx-auto text-brand-light animate-pulse">
                  <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                </div>
                <p class="text-xs font-semibold text-gray-300">A câmera está desativada.</p>
                <button type="button" onclick="startCamera()" class="px-4 py-2 bg-brand-light/95 hover:bg-brand-light text-brand-dark text-xs font-extrabold rounded-xl transition-all cursor-pointer shadow-md inline-block">
                  Ativar Câmera
                </button>
              </div>

              <!-- Overlay Visual Guia de Enquadramento -->
              <div id="scanner-reticle" class="absolute inset-8 border-2 border-brand-light/30 border-dashed rounded-xl pointer-events-none hidden">
                <div class="absolute inset-0 bg-brand-dark/5"></div>
              </div>
            </div>

            <!-- Controles da Câmera -->
            <div id="camera-controls" class="flex flex-wrap gap-2 justify-center hidden">
              <button type="button" onclick="captureSnapshot()" class="flex-1 py-3 px-4 bg-brand-dark hover:bg-brand-light text-white text-xs font-bold rounded-xl transition-all cursor-pointer flex items-center justify-center gap-2 shadow-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h.01M19 12h.01M12 5h.01M12 19h.01M12 12h.01M8 12h.01M16 12h.01"/></svg>
                Tirar Foto da Guia
              </button>
              <button type="button" onclick="stopCamera()" class="py-3 px-4 bg-rose-50 hover:bg-rose-100 text-rose-600 text-xs font-bold rounded-xl transition-all cursor-pointer flex items-center justify-center" title="Desligar Câmera">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/></svg>
              </button>
            </div>
          </div>

          <!-- SEÇÃO DE FILE UPLOAD (DRAG AND DROP) -->
          <div id="section-upload" class="space-y-4 hidden">
            <div id="drop-zone" class="border-2 border-dashed border-brand-light/30 bg-brand-neutralLight hover:bg-brand-softBg/30 rounded-2xl p-8 text-center transition-all cursor-pointer relative" onclick="triggerFileSelect()">
              <input type="file" id="file-input" class="hidden" accept="image/*,application/pdf" onchange="handleFileSelect(event)">
              <div class="space-y-3">
                <div class="w-12 h-12 bg-brand-softBg text-brand-dark rounded-full flex items-center justify-center mx-auto">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
                </div>
                <div>
                  <p class="text-xs font-bold text-brand-dark">Arraste o arquivo ou clique para selecionar</p>
                  <p class="text-[10px] text-gray-400 mt-1">Formatos suportados: PDF, PNG, JPG, JPEG (Máx. 10MB)</p>
                </div>
              </div>
            </div>
            
            <!-- File Preview Container -->
            <div id="upload-preview-container" class="relative bg-brand-neutralDark rounded-2xl overflow-hidden aspect-[4/3] border border-brand-light/10 shadow-inner hidden">
              <img id="upload-preview" class="w-full h-full object-contain" alt="Upload Preview">
              
              <!-- PDF Preview Card -->
              <div id="pdf-preview-card" class="absolute inset-0 flex flex-col items-center justify-center p-6 text-center bg-brand-neutralDark text-white hidden">
                <div class="w-16 h-16 bg-white/10 rounded-2xl flex items-center justify-center mb-3 text-brand-light">
                  <svg class="w-10 h-10 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 9h1.5m1 0H13m-4 4h4m-4 4h4"/>
                  </svg>
                </div>
                <p id="pdf-file-name" class="text-xs font-bold text-white max-w-xs truncate px-4"></p>
                <p id="pdf-file-size" class="text-[10px] text-gray-400 mt-1 font-mono"></p>
                <span class="mt-4 bg-brand-light text-brand-dark text-[9px] font-mono font-extrabold px-2.5 py-1 rounded-full uppercase tracking-wider">Documento PDF Pronto</span>
              </div>

              <button onclick="clearUpload()" class="absolute top-3 right-3 p-2 bg-black/60 hover:bg-black/80 text-white rounded-full transition-all z-10" title="Remover Arquivo">
