                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m-6 9h6m-6 4h6"/></svg>
                Copiar Resumo
              </button>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs leading-relaxed text-gray-200">
              
              <!-- Lista de Códigos de Digitação -->
              <div class="bg-white/5 rounded-2xl p-4 border border-white/5 space-y-3">
                <p class="font-extrabold font-mono text-[10px] uppercase tracking-wider text-amber-300">Códigos para o Sistema de Gestão</p>
                <div id="summary-codes" class="space-y-1.5 font-mono text-[11px]">
                  <!-- Injetado dinamicamente -->
                </div>
              </div>

              <!-- Distribuição para Apoio -->
              <div class="bg-white/5 rounded-2xl p-4 border border-white/5 space-y-3">
                <p class="font-extrabold font-mono text-[10px] uppercase tracking-wider text-emerald-300">Roteamento de Amostras (Lab Apoio)</p>
                <div id="summary-routing" class="space-y-2">
                  <!-- Injetado dinamicamente -->
                </div>
              </div>

            </div>

            <!-- Informações Rápidas Adicionais -->
            <div class="mt-5 pt-4 border-t border-white/10 flex flex-col sm:flex-row justify-between text-[11px] text-gray-400 gap-2">
              <div class="flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                <span>Fidelidade garantida via IA InovaLab</span>
              </div>
              <div class="font-mono" id="current-scan-time"></div>
            </div>

          </div>

        </div>

      </div>

    </div>

  </div>
</section>

<!-- SCRIPTS DE COMPORTAMENTO DO SCANNER -->
<script>
  let activeTab = 'camera';
  let videoStreamObj = null;
  let activeBase64Image = null;

  // Gerenciamento de Abas
  function switchTab(tab) {
    activeTab = tab;
    document.getElementById('tab-camera').className = tab === 'camera' 
      ? 'flex-1 text-center py-2 text-xs font-bold rounded-xl transition-all cursor-pointer bg-white text-brand-dark shadow-sm'
      : 'flex-1 text-center py-2 text-xs font-bold rounded-xl transition-all cursor-pointer text-gray-500 hover:text-brand-dark';

    document.getElementById('tab-upload').className = tab === 'upload'
      ? 'flex-1 text-center py-2 text-xs font-bold rounded-xl transition-all cursor-pointer bg-white text-brand-dark shadow-sm'
      : 'flex-1 text-center py-2 text-xs font-bold rounded-xl transition-all cursor-pointer text-gray-500 hover:text-brand-dark';

    if (tab === 'camera') {
      document.getElementById('section-camera').classList.remove('hidden');
      document.getElementById('section-upload').classList.add('hidden');
    } else {
      document.getElementById('section-camera').classList.add('hidden');
      document.getElementById('section-upload').classList.remove('hidden');
      stopCamera();
    }
  }

  // Ativar Câmera
  async function startCamera() {
    try {
      const constraints = {
        video: { facingMode: 'environment' }, // Preferência câmera de trás (mobile)
        audio: false
      };
      videoStreamObj = await navigator.mediaDevices.getUserMedia(constraints);
      
      const video = document.getElementById('video-stream');
      video.srcObject = videoStreamObj;
      video.classList.remove('hidden');
      
      document.getElementById('camera-placeholder').classList.add('hidden');
      document.getElementById('scanner-reticle').classList.remove('hidden');
      document.getElementById('camera-controls').classList.remove('hidden');
    } catch (error) {
      console.error("Erro ao ativar câmera:", error);
      alert("Não foi possível acessar a câmera do dispositivo. Por favor, conceda permissão de acesso à câmera no seu navegador ou utilize o upload de imagem.");
    }
  }

  // Desativar Câmera
  function stopCamera() {
    if (videoStreamObj) {
      videoStreamObj.getTracks().forEach(track => track.stop());
      videoStreamObj = null;
    }
    const video = document.getElementById('video-stream');
    video.srcObject = null;
    video.classList.add('hidden');
    
    document.getElementById('camera-placeholder').classList.remove('hidden');
    document.getElementById('scanner-reticle').classList.add('hidden');
    document.getElementById('camera-controls').classList.add('hidden');
  }

  // Capturar Snapshot
  function captureSnapshot() {
    const video = document.getElementById('video-stream');
    const canvas = document.getElementById('snapshot-canvas');
    const ctx = canvas.getContext('2d');

    // Configurar tamanho do canvas proporcional ao vídeo
    canvas.width = video.videoWidth || 640;
    canvas.height = video.videoHeight || 480;

    // Desenhar frame do vídeo no canvas
    ctx.drawImage(video, 0, 0, canvas.width, canvas.height);

    // Converter para base64
    activeBase64Image = canvas.toDataURL('image/jpeg', 0.8);

    // Mostrar Preview
    const imgPreview = document.getElementById('image-preview');
    imgPreview.src = activeBase64Image;
    imgPreview.classList.remove('hidden');

    // Desativar/ocultar vídeo
    video.classList.add('hidden');
    document.getElementById('scanner-reticle').classList.add('hidden');
    
    // Habilitar botão de análise
    document.getElementById('btn-analyze').removeAttribute('disabled');
  }

  // Trigger File Input Click
  function triggerFileSelect() {
    document.getElementById('file-input').click();
  }

  // Selecionar Arquivo do Computador/Celular
  function handleFileSelect(event) {
    const file = event.target.files[0];
    if (!file) return;

    if (!file.type.startsWith('image/') && file.type !== 'application/pdf') {
      alert("Por favor, selecione apenas arquivos de imagem ou PDF.");
      return;
    }

    const reader = new FileReader();
    reader.onload = function(e) {
      activeBase64Image = e.target.result;
      
      const img = document.getElementById('upload-preview');
      const pdfCard = document.getElementById('pdf-preview-card');
      
      if (file.type === 'application/pdf') {
        img.classList.add('hidden');
        pdfCard.classList.remove('hidden');
        document.getElementById('pdf-file-name').innerText = file.name;
        
        const sizeKB = (file.size / 1024).toFixed(1);
        document.getElementById('pdf-file-size').innerText = `${sizeKB} KB`;
      } else {
        pdfCard.classList.add('hidden');
        img.classList.remove('hidden');
        img.src = activeBase64Image;
      }
      
      document.getElementById('drop-zone').classList.add('hidden');
      document.getElementById('upload-preview-container').classList.remove('hidden');
      
      // Habilitar botão de análise
      document.getElementById('btn-analyze').removeAttribute('disabled');
    };
    reader.readAsDataURL(file);
  }

  // Limpar Upload
  function clearUpload() {
    activeBase64Image = null;
    document.getElementById('file-input').value = "";
    document.getElementById('drop-zone').classList.remove('hidden');
    document.getElementById('upload-preview-container').classList.add('hidden');
    document.getElementById('btn-analyze').setAttribute('disabled', 'true');
    
    document.getElementById('upload-preview').classList.remove('hidden');
    document.getElementById('pdf-preview-card').classList.add('hidden');
  }

  // Resetar Tudo para Novo Scan
  function resetAll() {
    activeBase64Image = null;
    document.getElementById('btn-analyze').removeAttribute('disabled');
    document.getElementById('btn-analyze').classList.remove('hidden');
    document.getElementById('btn-reset').classList.add('hidden');
    
    // Oculta estados de sucesso/erro
    document.getElementById('results-success-state').classList.add('hidden');
    document.getElementById('results-empty-state').classList.remove('hidden');

    if (activeTab === 'camera') {
      document.getElementById('image-preview').classList.add('hidden');
      document.getElementById('image-preview').src = "";
      startCamera();
    } else {
      clearUpload();
    }
  }

  // Enviar Imagem para a API
  async function sendToIA() {
    if (!activeBase64Image) return;

    // Desliga a câmera ativa se houver para economizar recursos
    stopCamera();

    // Mudar estado para Loading
    document.getElementById('results-empty-state').classList.add('hidden');
    document.getElementById('results-success-state').classList.add('hidden');
    document.getElementById('results-loading-state').classList.remove('hidden');

    // Desativar botões
    document.getElementById('btn-analyze').setAttribute('disabled', 'true');

    // Simular passos do loading de forma elegante
    const step1 = document.getElementById('loading-step-1');
    const step2 = document.getElementById('loading-step-2');
    const step3 = document.getElementById('loading-step-3');

    setTimeout(() => {
      step1.className = "text-emerald-600 font-bold";
      step1.innerText = "✓ Imagem lida com sucesso";
      step2.className = "text-brand-dark font-bold animate-pulse";
      step2.innerText = "● Extraindo exames médicos via Gemini AI...";
    }, 1200);

    setTimeout(() => {
      step2.className = "text-emerald-600 font-bold";
      step2.innerText = "✓ Exames extraídos com sucesso";
      step3.className = "text-brand-dark font-bold animate-pulse";
      step3.innerText = "● Cruzando dados com a base local do laboratório...";
    }, 2800);

    try {
      const response = await fetch('/api/admin/leitor/analisar', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          image: activeBase64Image,
          mimeType: activeBase64Image.split(';')[0].split(':')[1] || 'image/jpeg'
        })
      });

      const data = await response.json();

      if (!data.success) {
        throw new Error(data.error || "Erro desconhecido na análise.");
      }

      // Exibir Resultados na UI
      displayScanResults(data);

    } catch (error) {
      console.error(error);
      alert(error.message || "Ocorreu um erro ao comunicar com a IA. Verifique as configurações ou tente novamente.");
      
      // Volta ao estado anterior
      document.getElementById('results-loading-state').classList.add('hidden');
      document.getElementById('results-empty-state').classList.remove('hidden');
      document.getElementById('btn-analyze').removeAttribute('disabled');
      
      // Reseta passos
      step1.className = "text-brand-dark font-bold";
      step1.innerText = "● Lendo canais ópticos e texto da imagem";
      step2.className = "";
      step2.innerText = "○ Extraindo exames médicos via Gemini AI";
      step3.className = "";
      step3.innerText = "○ Cruzando com os códigos do sistema";
    }
  }

  // Dados Locais e Globais de Exames
  const allAvailableExams = <%- JSON.stringify(exams) %>;
  let currentRequisitionExams = [];

  // Filtrar Busca Manual
  function filterManualSearch(state) {
    const input = document.getElementById(state + '-search-input');
    const dropdown = document.getElementById(state + '-search-dropdown');
    const q = input.value.toLowerCase().trim();

    if (!q) {
      dropdown.classList.add('hidden');
      return;
    }

    const filtered = allAvailableExams.filter(e => 
      e.name.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").includes(q) || 
      (e.code && e.code.toLowerCase().includes(q))
    ).slice(0, 8);

    if (filtered.length === 0) {
      dropdown.innerHTML = `
        <div class="p-3 text-xs text-gray-400 font-mono italic bg-white rounded-xl shadow-md border border-brand-light/10">
          Nenhum exame correspondente encontrado.
        </div>
      `;
    } else {
      dropdown.innerHTML = filtered.map(e => `
        <button type="button" onclick="addExamManually('${e.id}', '${state}')" class="w-full text-left px-4 py-3 text-xs text-brand-dark hover:bg-brand-softBg hover:text-brand-dark transition-colors font-bold flex justify-between items-center cursor-pointer border-b border-brand-light/5 bg-white last:border-0">
          <span>${e.name}</span>
          <span class="text-[9px] font-bold font-mono bg-amber-100 text-amber-800 px-1.5 py-0.5 rounded uppercase">${e.code || 'S/C'}</span>
        </button>
      `).join('');
    }
    dropdown.classList.remove('hidden');
    
    // Fechar dropdown ao clicar fora
    document.addEventListener('click', function closeDropdown(ev) {
      if (!input.contains(ev.target) && !dropdown.contains(ev.target)) {
        dropdown.classList.add('hidden');
        document.removeEventListener('click', closeDropdown);
      }
    });
  }

  // Adicionar Exame Manualmente à Requisição
  function addExamManually(examId, state) {
    const exam = allAvailableExams.find(e => e.id === examId);
    if (!exam) return;

    // Evitar duplicados
    const exists = currentRequisitionExams.some(e => e.id === exam.id);
    if (exists) {
      alert("Este exame já está na lista!");
      document.getElementById(state + '-search-input').value = '';
      document.getElementById(state + '-search-dropdown').classList.add('hidden');
      return;
    }

    currentRequisitionExams.push({
      id: exam.id,
      name: exam.name,
      matched: true,
      code: exam.code || 'A_DEFINIR',
      supportLab: exam.supportLab || 'Próprio',
      timeframe: exam.timeframe || '24h',
      fasting: exam.fasting || 'Não obrigatório'
    });

    document.getElementById(state + '-search-input').value = '';
    document.getElementById(state + '-search-dropdown').classList.add('hidden');

    // Mudar estados visualmente para exibir resultados
    document.getElementById('results-empty-state').classList.add('hidden');
    document.getElementById('results-success-state').classList.remove('hidden');
    document.getElementById('btn-analyze').classList.add('hidden');
    document.getElementById('btn-reset').classList.remove('hidden');

    renderRequisition();
  }

  // Remover Exame da Requisição
  function removeExamFromRequisition(index) {
    currentRequisitionExams.splice(index, 1);
    if (currentRequisitionExams.length === 0) {
      document.getElementById('results-success-state').classList.add('hidden');
      document.getElementById('results-empty-state').classList.remove('hidden');
      document.getElementById('btn-reset').classList.add('hidden');
      document.getElementById('btn-analyze').classList.remove('hidden');
    } else {
      renderRequisition();
    }
  }

  // Preencher Resultados na Tela após análise da IA
  function displayScanResults(data) {
    currentRequisitionExams = data.exames.map(item => ({
      id: item.id || null,
      name: item.name,
      matched: item.matched,
      code: item.code || 'A_DEFINIR',
      supportLab: item.supportLab || 'Próprio',
      timeframe: item.timeframe || '24h',
      fasting: item.fasting || 'Não obrigatório'
    }));

    renderRequisition();
  }

  // Renderizador principal da tabela de requisição e cartões de resumo
  function renderRequisition() {
    const listContainer = document.getElementById('scanned-exams-list');
    listContainer.innerHTML = '';

    const totalCount = currentRequisitionExams.length;
    const matchedCount = currentRequisitionExams.filter(e => e.matched).length;

    document.getElementById('badge-total-scanned').innerText = `Total: ${totalCount}`;
    document.getElementById('badge-total-matched').innerText = `Cruzado: ${matchedCount}`;

    currentRequisitionExams.forEach((item, index) => {
      const row = document.createElement('div');
      row.className = "py-4 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 transition-all hover:bg-brand-softBg/20 px-2 rounded-xl";
      
      let badgeHtml = "";
      let actionHtml = "";

      if (item.matched) {
        badgeHtml = `
          <div class="flex flex-wrap items-center gap-1.5 mt-1">
            <span class="bg-amber-100 text-amber-800 border border-amber-200 font-bold font-mono text-[9px] px-2 py-0.5 rounded uppercase">
              Cod: ${item.code}
            </span>
            <span class="text-[9px] font-bold font-mono px-2 py-0.5 rounded uppercase ${item.supportLab === 'Próprio' ? 'bg-emerald-100 text-emerald-800 border border-emerald-200' : 'bg-indigo-100 text-indigo-800 border border-indigo-200'}">
              ${item.supportLab}
            </span>
          </div>
        `;

        actionHtml = `
          <div class="flex items-center gap-3">
            <div class="text-right">
              <span class="inline-flex items-center gap-1 text-[10px] font-bold text-emerald-600 font-mono">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                Sincronizado
              </span>
              <p class="text-[10px] text-gray-400 font-mono mt-0.5">${item.timeframe} • ${item.fasting}</p>
            </div>
            <button type="button" onclick="removeExamFromRequisition(${index})" class="p-2 text-gray-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition-colors cursor-pointer" title="Remover Exame">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            </button>
          </div>
        `;
      } else {
        badgeHtml = `
          <div class="flex flex-wrap items-center gap-1.5 mt-1">
            <span class="bg-rose-50 text-rose-700 border border-rose-100 font-bold font-mono text-[9px] px-2 py-0.5 rounded uppercase">
              Não Cadastrado
            </span>
            <span class="text-[9px] text-gray-400">Verifique a grafia</span>
          </div>
        `;

        actionHtml = `
          <div class="flex items-center gap-3">
            <div class="text-right">
              <a href="/admin/exames?newExamName=${encodeURIComponent(item.name)}" class="inline-flex items-center gap-1 text-[10px] font-extrabold text-brand-dark bg-brand-softBg/80 hover:bg-brand-light/30 px-2 py-1 rounded-lg transition-colors">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/></svg>
                Cadastrar Exame
              </a>
            </div>
            <button type="button" onclick="removeExamFromRequisition(${index})" class="p-2 text-gray-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition-colors cursor-pointer" title="Remover Exame">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            </button>
          </div>
        `;
      }

      row.innerHTML = `
        <div class="space-y-0.5">
          <p class="text-xs font-bold text-brand-dark">${item.name}</p>
          ${badgeHtml}
        </div>
        ${actionHtml}
      `;

      listContainer.appendChild(row);
    });

    // Preencher Card de Resumo de Requisição Rápida
    const summaryCodesContainer = document.getElementById('summary-codes');
    const summaryRoutingContainer = document.getElementById('summary-routing');

    summaryCodesContainer.innerHTML = '';
    summaryRoutingContainer.innerHTML = '';

    // Filtra apenas os exames sincronizados (que possuem código)
    const matchedExams = currentRequisitionExams.filter(e => e.matched);

    if (matchedExams.length > 0) {
      // 1. Códigos do Sistema
      matchedExams.forEach(item => {
        const itemHtml = `
          <div class="flex justify-between border-b border-white/5 pb-1 select-all hover:bg-white/5 px-1.5 rounded">
            <span class="text-gray-300">${item.name}</span>
            <span class="text-amber-300 font-extrabold">${item.code}</span>
          </div>
        `;
        summaryCodesContainer.innerHTML += itemHtml;
      });

      // 2. Destino de Laboratórios (Agrupado por Laboratório de Apoio)
      const labsAgruped = {};
      matchedExams.forEach(item => {
        const lab = item.supportLab || "Próprio";
        if (!labsAgruped[lab]) labsAgruped[lab] = [];
        labsAgruped[lab].push(item.name);
      });

      Object.keys(labsAgruped).forEach(lab => {
        const itemHtml = `
          <div class="space-y-0.5">
            <p class="font-bold text-[10px] text-emerald-300 uppercase tracking-wide font-mono">${lab}</p>
            <p class="text-[10px] text-gray-300 italic pl-2 leading-tight">${labsAgruped[lab].join(', ')}</p>
          </div>
        `;
        summaryRoutingContainer.innerHTML += itemHtml;
      });
    } else {
      summaryCodesContainer.innerHTML = `<span class="text-rose-400 italic text-[10px]">Nenhum exame sincronizado disponível para gerar códigos.</span>`;
      summaryRoutingContainer.innerHTML = `<span class="text-rose-400 italic text-[10px]">Sem dados para roteamento.</span>`;
    }

    // Hora de atualização
    const now = new Date();
    document.getElementById('current-scan-time').innerText = `Atualizado às ${now.toLocaleTimeString('pt-BR')}`;

    // Alternar visualizações de estados se necessário
    document.getElementById('results-loading-state').classList.add('hidden');
    document.getElementById('results-success-state').classList.remove('hidden');

    // Botão de Novo Scan
    document.getElementById('btn-analyze').classList.add('hidden');
    document.getElementById('btn-reset').classList.remove('hidden');

    // Limpar passos do Loading
    const step1 = document.getElementById('loading-step-1');
    const step2 = document.getElementById('loading-step-2');
    const step3 = document.getElementById('loading-step-3');
    step1.className = "text-brand-dark font-bold";
    step1.innerText = "● Lendo canais ópticos e texto da imagem";
    step2.className = "";
    step2.innerText = "○ Extraindo exames médicos via Gemini AI";
    step3.className = "";
    step3.innerText = "○ Cruzando com os códigos do sistema";
  }

  // Copiar resumo de códigos e laboratórios de destino
  function copyToClipboard() {
    const codes = [];
    const elements = document.querySelectorAll('#summary-codes > div');
    elements.forEach(el => {
      const name = el.children[0].innerText;
      const code = el.children[1].innerText;
      codes.push(`${name}: ${code}`);
    });

    const routings = [];
    const routingsElements = document.querySelectorAll('#summary-routing > div');
    routingsElements.forEach(el => {
      const lab = el.children[0].innerText;
      const exams = el.children[1].innerText;
      routings.push(`Enviar para [${lab}]: ${exams}`);
    });

    const summaryText = `--- INOVALAB REQUISIÇÃO RÁPIDA ---\n\n` +
                        `CÓDIGOS PARA SISTEMA:\n` +
                        (codes.length > 0 ? codes.join('\n') : 'Nenhum exame sincronizado.') +
                        `\n\nROTEAMENTO DE AMOSTRAS:\n` +
                        (routings.length > 0 ? routings.join('\n') : 'Nenhum roteamento disponível.') +
                        `\n\nGerado automaticamente via Leitor Digital IA.`;

    navigator.clipboard.writeText(summaryText)
      .then(() => alert("Resumo de exames e roteamento copiado para a área de transferência!"))
      .catch(err => console.error("Erro ao copiar:", err));
  }

  // Capturar parâmetro de novo cadastro se necessário
  window.addEventListener('DOMContentLoaded', () => {
    // Configurar drag and drop para a área de upload (drop-zone)
    const dropZone = document.getElementById('drop-zone');
    if (dropZone) {
      ['dragenter', 'dragover'].forEach(eventName => {
        dropZone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropZone.classList.add('bg-brand-softBg/50', 'border-brand-dark');
        }, false);
      });

      ['dragleave', 'drop'].forEach(eventName => {
        dropZone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropZone.classList.remove('bg-brand-softBg/50', 'border-brand-dark');
        }, false);
      });

      dropZone.addEventListener('drop', (e) => {
        const dt = e.dataTransfer;
        const files = dt.files;
        if (files && files.length > 0) {
          const fileInput = document.getElementById('file-input');
          fileInput.files = files;
          
          const synthEvent = { target: { files: files } };
          handleFileSelect(synthEvent);
        }
      }, false);
    }

    console.log("Leitor de Guia de Exames carregado.");
  });
</script>

