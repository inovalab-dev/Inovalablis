<%- include('../partials/header', { page: 'admin-locais-coleta' }) %>

<div class="p-4 sm:p-6 lg:p-8 max-w-[98vw] xl:max-w-[96vw] mx-auto w-full flex-1 space-y-6">

  <!-- Cabeçalho Principal da Tela (Padrão InovaLab / LIS) -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 text-xs text-brand-neutral/60 font-mono uppercase tracking-wider mb-1">
        <a href="/admin" class="hover:text-brand-neutralDark transition-colors">Administração</a>
        <span>•</span>
        <span>Cadastros</span>
        <span>•</span>
        <span class="text-teal-700 font-bold">Locais de Coleta</span>
      </div>
      
      <div class="flex items-center gap-3">
        <!-- Ícone do Cadastro de Locais de Coleta -->
        <div class="w-11 h-11 rounded-2xl bg-white border border-gray-200 shadow-sm flex items-center justify-center shrink-0 relative">
          <svg class="w-6 h-6 text-teal-700" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
          </svg>
          <div class="absolute -bottom-1 -right-1 w-5 h-5 bg-teal-600 rounded-lg text-white font-black text-xs flex items-center justify-center border-2 border-white shadow-xs">
            +
          </div>
        </div>
        <div>
          <h1 class="text-2xl font-black text-brand-neutralDark tracking-tight">
            Cadastro de Locais de Coleta
          </h1>
          <p class="text-xs text-brand-neutral/70">
            Cadastre e gerencie os locais e salas de coleta de amostras (Ex: Sala Particular, Sala SUS, Domiciliar...)
          </p>
        </div>
      </div>
    </div>

    <!-- Botão Principal de Ação -->
    <div class="flex items-center gap-3">
      <button type="button" onclick="openNewLocalModal()" class="px-5 py-2.5 bg-teal-700 hover:bg-teal-800 text-white font-bold text-xs uppercase tracking-wider rounded-xl shadow-lg shadow-teal-700/20 transition-all active:scale-95 cursor-pointer flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
        <span>+ Novo Local de Coleta</span>
      </button>
    </div>
  </div>

  <!-- Cards de Métricas / Resumo dos Locais de Coleta -->
  <% 
    const totalLocais = locaisColeta.length;
  %>
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 sm:gap-4">
    <div class="bg-white p-4 rounded-2xl border border-gray-200 shadow-2xs flex items-center justify-between">
      <div>
        <p class="text-[11px] font-bold text-gray-500 uppercase font-mono tracking-wider">Total Registrados</p>
        <p class="text-2xl font-black text-slate-800 font-mono mt-0.5"><%= totalLocais %></p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-teal-50 flex items-center justify-center text-teal-700 text-lg">📍</div>
    </div>

    <div class="bg-white p-4 rounded-2xl border border-gray-200 shadow-2xs flex items-center justify-between">
      <div>
        <p class="text-[11px] font-bold text-emerald-600 uppercase font-mono tracking-wider">Status do Cadastro</p>
        <p class="text-2xl font-black text-emerald-700 font-mono mt-0.5">Ativo</p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-600 text-lg">✅</div>
    </div>

    <div class="bg-white p-4 rounded-2xl border border-gray-200 shadow-2xs flex items-center justify-between">
      <div>
        <p class="text-[11px] font-bold text-blue-600 uppercase font-mono tracking-wider">Próximo Código</p>
        <p class="text-2xl font-black text-blue-700 font-mono mt-0.5">
          <% 
            let maxCod = 0;
            locaisColeta.forEach(l => {
              const num = parseInt(l.codigo, 10);
              if (!isNaN(num) && num > maxCod) maxCod = num;
            });
          %>
          <%= maxCod + 1 %>
        </p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center text-blue-600 text-lg">🏷️</div>
    </div>
  </div>

  <!-- TABELA / LISTA PRINCIPAL DE LOCAIS DE COLETA -->
  <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
    
    <!-- Barra Superior de Pesquisa e Filtros -->
    <div class="p-4 bg-slate-50/80 border-b border-gray-200 flex flex-col md:flex-row items-center justify-between gap-3">
      
      <div class="flex items-center gap-2 w-full md:w-auto">
        <span class="text-sm font-black text-slate-800 uppercase tracking-wide shrink-0">Lista de Locais de Coleta</span>
        <span id="locaisCounterBadge" class="px-2.5 py-0.5 bg-teal-100 text-teal-800 rounded-full text-xs font-bold font-mono">
          <%= totalLocais %> cadastrados
        </span>
      </div>

      <!-- Campo de Busca -->
      <div class="flex items-center gap-2.5 w-full md:w-auto">
        <div class="relative w-full sm:w-80">
          <input type="text" id="searchLocaisInput" onkeyup="filterLocaisTable()" placeholder="Buscar por código ou descrição..." class="w-full pl-8 pr-3 py-1.5 bg-white border border-gray-300 rounded-xl text-xs outline-none focus:ring-2 focus:ring-teal-500 shadow-2xs">
          <span class="absolute left-2.5 top-2 text-gray-400 text-xs">🔍</span>
        </div>
      </div>

    </div>

    <!-- Tabela de Locais de Coleta -->
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-gray-100/90 border-b border-gray-200 text-[10px] font-black text-gray-500 uppercase font-mono tracking-wider">
            <th class="p-3 w-28 text-center">Código</th>
            <th class="p-3">Descrição do Local de Coleta</th>
            <th class="p-3 w-36 text-center">Ações</th>
          </tr>
        </thead>
        <tbody id="locaisTableBody" class="divide-y divide-gray-100 text-xs font-medium">
          <% if (locaisColeta.length === 0) { %>
            <tr>
              <td colspan="3" class="p-8 text-center text-gray-400 font-sans italic">
                Nenhum local de coleta cadastrado até o momento.
              </td>
            </tr>
          <% } else { %>
            <% locaisColeta.forEach(l => { %>
              <tr class="local-row hover:bg-teal-50/40 transition-colors" data-search="<%= ((l.codigo || '') + ' ' + (l.descricao || l.nome || '')).toLowerCase() %>">
                <td class="p-3 text-center font-mono font-bold text-slate-700 bg-slate-50/50">
                  #<%= l.codigo || '' %>
                </td>
                <td class="p-3">
                  <div class="font-bold text-slate-800 text-sm flex items-center gap-2">
                    <span class="text-teal-600">📍</span> <%= l.descricao || l.nome || '-' %>
                  </div>
                </td>
                <td class="p-3 text-center">
                  <div class="flex items-center justify-center gap-1.5">
                    <button type="button" onclick="editLocal('<%= l.id %>')" title="Editar Local de Coleta" class="px-2.5 py-1 bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-200 rounded-lg font-bold text-xs transition-all flex items-center gap-1 cursor-pointer">
                      ✏️ Editar
                    </button>
                    <button type="button" onclick="deleteLocal('<%= l.id %>', '<%= (l.descricao || l.nome || '').replace(/'/g, "\\'") %>')" title="Excluir Local de Coleta" class="px-2 py-1 bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 rounded-lg font-bold text-xs transition-all flex items-center gap-1 cursor-pointer">
                      🗑️
                    </button>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>

  </div>

</div>

<!-- MODAL DE CADASTRO / EDIÇÃO DE LOCAL DE COLETA -->
<div id="localModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 flex items-center justify-center p-4 hidden">
  <div class="bg-white w-full max-w-lg rounded-2xl shadow-2xl border border-gray-200 overflow-hidden transform transition-all flex flex-col max-h-[90vh]">
    
    <!-- Modal Header -->
    <div class="p-4 bg-slate-900 text-white flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="text-xl">📍</span>
        <h3 id="localModalTitle" class="text-sm font-extrabold uppercase font-mono tracking-wider text-brand-gold">
          Cadastrar Novo Local de Coleta
        </h3>
      </div>
      <button type="button" onclick="closeLocalModal()" class="text-white/70 hover:text-white text-xl font-bold p-1 cursor-pointer">&times;</button>
    </div>

    <!-- Form Container -->
    <form id="localForm" action="/admin/locais-coleta/save" method="POST" class="p-6 space-y-4 overflow-y-auto flex-1">
      <input type="hidden" name="id" id="loc-id" value="">

      <!-- Código -->
      <div class="space-y-1">
        <label for="loc-codigo" class="block text-xs font-extrabold text-slate-700 uppercase font-mono">
          Código: <span class="text-rose-500">*</span>
        </label>
        <input type="text" name="codigo" id="loc-codigo" required class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-xs font-bold font-mono text-slate-800 outline-none focus:ring-2 focus:ring-teal-500">
        <p class="text-[10px] text-gray-500">O código identifica o local de coleta no sistema.</p>
      </div>

      <!-- Descrição -->
      <div class="space-y-1">
        <label for="loc-descricao" class="block text-xs font-extrabold text-slate-700 uppercase font-mono">
          Descrição do Local de Coleta: <span class="text-rose-500">*</span>
        </label>
        <input type="text" name="descricao" id="loc-descricao" required placeholder="Ex: Sala Particular, Sala SUS, Domiciliar..." class="w-full px-3 py-2 bg-white border border-gray-300 rounded-xl text-xs font-bold text-slate-800 outline-none focus:ring-2 focus:ring-teal-500">
        <p class="text-[10px] text-gray-500">Informe a descrição do local ou ambiente de coleta.</p>
      </div>

      <!-- Footer Actions inside Modal -->
      <div class="pt-4 border-t border-gray-100 flex items-center justify-end gap-3">
        <button type="button" onclick="closeLocalModal()" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold text-xs rounded-xl uppercase font-mono transition-all cursor-pointer">
          Cancelar
        </button>
        <button type="submit" class="px-5 py-2 bg-teal-700 hover:bg-teal-800 text-white font-extrabold text-xs rounded-xl uppercase font-mono tracking-wider shadow-md shadow-teal-700/20 transition-all active:scale-95 cursor-pointer">
          💾 Salvar Local de Coleta
        </button>
      </div>
    </form>

  </div>
</div>

<script>
  let locaisList = <%- JSON.stringify(locaisColeta) %>;

  function openNewLocalModal() {
    document.getElementById('localForm').reset();
    document.getElementById('loc-id').value = '';
    
    // Gerar próximo código
    let maxCod = 0;
    locaisList.forEach(l => {
      const num = parseInt(l.codigo, 10);
      if (!isNaN(num) && num > maxCod) maxCod = num;
    });
    document.getElementById('loc-codigo').value = String(maxCod + 1);

    document.getElementById('localModalTitle').innerText = 'Cadastrar Novo Local de Coleta';
    document.getElementById('localModal').classList.remove('hidden');
    setTimeout(() => document.getElementById('loc-descricao').focus(), 100);
  }

  function closeLocalModal() {
    document.getElementById('localModal').classList.add('hidden');
  }

  function editLocal(id) {
    const item = locaisList.find(l => String(l.id) === String(id));
    if (!item) return;

    document.getElementById('loc-id').value = item.id;
    document.getElementById('loc-codigo').value = item.codigo;
    document.getElementById('loc-descricao').value = item.descricao;

    document.getElementById('localModalTitle').innerText = 'Editar Local de Coleta #' + item.codigo;
    document.getElementById('localModal').classList.remove('hidden');
    setTimeout(() => document.getElementById('loc-descricao').focus(), 100);
  }

  function deleteLocal(id, desc) {
    if (confirm('Tem certeza que deseja excluir o local de coleta "' + desc + '"?')) {
      fetch('/admin/locais-coleta/delete/' + encodeURIComponent(id), {
        method: 'POST',
        headers: { 'Accept': 'application/json' }
      }).then(res => {
        if (res.ok) {
          window.location.reload();
        } else {
          window.location.href = '/admin/locais-coleta/delete/' + encodeURIComponent(id);
        }
      }).catch(() => {
        window.location.href = '/admin/locais-coleta/delete/' + encodeURIComponent(id);
      });
    }
  }

  function filterLocaisTable() {
    const query = document.getElementById('searchLocaisInput').value.toLowerCase().trim();
    const rows = document.querySelectorAll('.local-row');
    let visibleCount = 0;

    rows.forEach(row => {
      const text = row.getAttribute('data-search') || '';
      if (!query || text.includes(query)) {
        row.classList.remove('hidden');
        visibleCount++;
      } else {
        row.classList.add('hidden');
      }
    });

    const badge = document.getElementById('locaisCounterBadge');
    if (badge) {
      badge.innerText = visibleCount + ' exibidos';
    }
  }
</script>

<%- include('../partials/footer') %>
