<%- include('../partials/header') %>

<section class="min-h-[70vh] flex items-center justify-center py-16 bg-brand-neutralLight/50 px-4">
  <div class="w-full max-w-md bg-white p-8 sm:p-10 rounded-3xl border border-brand-light/20 shadow-lg space-y-6 text-center animate-fade-in">
    
    <div class="space-y-2">
      <div class="w-12 h-12 bg-brand-dark/10 text-brand-dark rounded-2xl flex items-center justify-center mx-auto mb-4 border border-brand-dark/10">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
      </div>
      <h1 class="text-2xl font-extrabold text-brand-dark tracking-tight">Área Administrativa</h1>
      <p class="text-xs text-gray-400">Insira suas credenciais de acesso restrito (usuário e senha) para acessar o painel administrativo.</p>
    </div>

    <% if (error) { %>
      <div class="bg-rose-50 text-rose-700 p-4 rounded-2xl text-xs font-semibold border border-rose-100 flex items-center space-x-2">
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
        <span><%= error %></span>
      </div>
    <% } %>

    <% if (typeof success !== 'undefined' && success) { %>
      <div class="bg-emerald-50 text-emerald-800 p-4 rounded-2xl text-xs font-semibold border border-emerald-200 flex items-center space-x-2">
        <svg class="w-4 h-4 shrink-0 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
        <span><%= success %></span>
      </div>
    <% } %>

    <form action="/admin/login" method="POST" class="space-y-4 text-left">
      <div>
        <label for="username" class="block text-xs font-bold text-brand-dark uppercase tracking-wider font-mono mb-1.5">Usuário de Acesso</label>
        <input type="text" name="username" id="username" required placeholder="Ex: admin ou seu login de profissional" class="w-full px-4 py-3 rounded-xl border border-brand-light/30 focus:outline-none focus:ring-1 focus:ring-brand-dark bg-brand-neutralLight text-sm text-center">
      </div>

      <div>
        <label for="password" class="block text-xs font-bold text-brand-dark uppercase tracking-wider font-mono mb-1.5">Senha de Acesso</label>
        <input type="password" name="password" id="password" required placeholder="Digite a senha..." class="w-full px-4 py-3 rounded-xl border border-brand-light/30 focus:outline-none focus:ring-1 focus:ring-brand-dark bg-brand-neutralLight font-mono text-sm tracking-widest text-center">
      </div>

      <button type="submit" class="w-full py-3.5 bg-brand-dark hover:bg-brand-light text-white font-bold rounded-xl shadow-md transition-all duration-150 hover:-translate-y-0.5 text-xs uppercase tracking-wider font-mono cursor-pointer">
        Entrar no Painel
      </button>
    </form>

    <div class="pt-4 border-t border-brand-light/10 text-[10px] text-gray-400">
      <p>Esqueceu ou não possui suas credenciais?</p>
      <p class="font-bold text-brand-dark/70 mt-0.5 mb-3">Contate o administrador do sistema.</p>
      <div class="mt-2 p-3 bg-blue-50/70 text-blue-800 rounded-xl border border-blue-100 text-left space-y-1">
        <p class="font-bold text-xs flex items-center gap-1">
          <svg class="w-3.5 h-3.5 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path></svg>
          Dica para Visualizador AI Studio:
        </p>
        <p class="text-[10px] leading-relaxed">Se ao tentar fazer login você continuar sendo redirecionado de volta para esta tela de login sem nenhuma mensagem de erro, isso indica que o navegador está bloqueando cookies de terceiros dentro do iframe do AI Studio.</p>
        <p class="text-[10px] font-semibold text-blue-900 leading-relaxed">Para resolver, basta abrir o aplicativo em uma <strong>Nova Aba</strong> clicando no botão do topo do painel do AI Studio!</p>
      </div>
    </div>

  </div>
</section>

<%- include('../partials/footer') %>
