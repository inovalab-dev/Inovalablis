        <p>&bull; <strong>Paciente:</strong> <span id="recoleta-paciente-display">-</span></p>
        <p>&bull; <strong>Exame Ocorrido:</strong> <span id="recoleta-exame-display">-</span></p>
        <p>&bull; <strong>Motivo da Recoleta:</strong> <span id="recoleta-motivo-display">-</span></p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <div>
          <label class="text-[9px] font-extrabold uppercase font-mono text-gray-400 block mb-1">Motivo Justificado (RDC 302)</label>
          <select id="recoleta-motivo-select" class="w-full bg-white border border-gray-200 rounded-lg p-2 text-xs">
