  // ================= CHAT DE COLABORAÇÃO LIVE =================
  function renderChatMessages() {
    const container = document.getElementById("chat-messages-container");
    container.innerHTML = "";

    if (currentComments.length === 0) {
      container.innerHTML = `<div class="h-full flex items-center justify-center text-center p-6 text-gray-400 text-xs leading-relaxed">
        Não há comentários técnicos nesta Não Conformidade.<br>Escreva suas notas de acompanhamento técnico abaixo.
      </div>`;
      return;
    }

    currentComments.forEach(c => {
      const isMe = c.user === "Dra. Sandra Regina Mendes";
      const div = document.createElement("div");
      div.className = `flex flex-col ${isMe ? 'items-end' : 'items-start'}`;
      div.innerHTML = `
        <div class="max-w-[85%] rounded-2xl px-3.5 py-2.5 shadow-sm text-xs border ${isMe ? 'bg-amber-50 text-brand-neutralDark border-amber-100/50 rounded-tr-none' : 'bg-white text-gray-700 border-gray-100 rounded-tl-none'}">
          <div class="flex justify-between items-center gap-4 text-[9px] font-mono font-bold text-gray-400 mb-1">
            <span>${c.user}</span>
            <span>${c.date}</span>
          </div>
          <p class="leading-relaxed whitespace-pre-wrap font-normal">${c.text}</p>
        </div>
      `;
      container.appendChild(div);
    });

    container.scrollTop = container.scrollHeight;
  }

  async function submitChatMessage() {
    const input = document.getElementById("chat-text-input");
    const text = input.value.trim();
    if (!text || !currentNC) return;

    try {
      const response = await fetch("/admin/nao-conformidades/comentar", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          id: currentNC.id,
          text: text,
          user: "Dra. Sandra Regina Mendes"
        })
      });

      const res = await response.json();
      if (res.success) {
        currentComments.push(res.comment);
        renderChatMessages();
        input.value = "";
        
        // Atualizar trilha de auditoria para refletir o comentário inserido
        currentHistory.push({
          user: "Dra. Sandra Regina Mendes",
          date: res.comment.date,
          action: "Adição de Comentário",
          comments: `Adicionou um comentário no chat da NC.`
        });
        renderAuditTrail();
      } else {
        alert("Erro ao adicionar nota: " + res.error);
      }
    } catch (e) {
      console.error(e);
      alert("Falha de rede ao comentar.");
    }
  }

  // ================= TRILHA DE AUDITORIA / HISTÓRICO =================
  function renderAuditTrail() {
    const container = document.getElementById("audit-trail-container");
    container.innerHTML = "";

    if (currentHistory.length === 0) {
      container.innerHTML = `<div class="p-4 text-center text-gray-400 text-xs">Nenhum evento registrado na trilha de auditoria.</div>`;
      return;
    }

    currentHistory.forEach(h => {
      const div = document.createElement("div");
      div.className = "relative pl-2 space-y-1";
      div.innerHTML = `
        <span class="absolute -left-[21px] top-1 w-2.5 h-2.5 bg-brand-gold rounded-full border border-white"></span>
        <div class="text-[10px] font-mono font-bold text-gray-400 flex justify-between">
          <span>${h.action}</span>
          <span>${h.date}</span>
        </div>
        <p class="text-xs font-bold text-gray-700">${h.user}</p>
        <p class="text-[11px] text-gray-500 italic font-normal">${h.comments || ''}</p>
      `;
      container.appendChild(div);
