  // ================= PROTOCOLO DE RECOLETA =================
  function triggerRecoleta() {
    const pacName = document.getElementById("form-patientName").value;
    const examName = document.getElementById("form-exam").value;
    
    if (!pacName || !examName) {
      alert("Por favor, preencha o Nome do Paciente e o Exame na aba de Paciente antes de solicitar recoleta.");
      return;
    }

    document.getElementById("recoleta-paciente-display").textContent = pacName;
    document.getElementById("recoleta-exame-display").textContent = examName;
    document.getElementById("recoleta-motivo-display").textContent = "Identificada Instabilidade Analítica da Amostra (NC)";

    document.getElementById("recoleta-modal").classList.remove("hidden");
  }

  function closeRecoletaModal() {
    document.getElementById("recoleta-modal").classList.add("hidden");
  }

  function confirmRecoleta() {
    const motivo = document.getElementById("recoleta-motivo-select").value;
    const contato = document.getElementById("recoleta-contato-select").value;

    // Adicionar log ao chat
    const logText = `[SOLICITAÇÃO DE RECOLETA EMITIDA]
Motivo: ${motivo}
Acompanhamento Paciente: ${contato}
Rastreabilidade RDC-302 iniciada de forma automática pela Qualidade.`;

    currentComments.push({
      user: "Sistema da Qualidade (InovaLab)",
      date: new Date().toLocaleDateString('pt-BR') + ' ' + new Date().toLocaleTimeString('pt-BR', {hour: '2-digit', minute:'2-digit'}),
      text: logText
    });
    
    // Adicionar ao histórico
    currentHistory.push({
      user: "Sistema de Qualidade",
      date: new Date().toLocaleDateString('pt-BR') + ' ' + new Date().toLocaleTimeString('pt-BR', {hour: '2-digit', minute:'2-digit'}),
      action: "Solicitação de Recoleta",
      comments: `Emitido alerta de recoleta para o exame. Motivo: ${motivo}.`
    });

    renderChatMessages();
    renderAuditTrail();
    closeRecoletaModal();

    alert("Recoleta protocolada e registrada na trila de auditoria e chat com absoluto sucesso!");
  }

