            <h5 class="font-bold uppercase text-[#284701]">Verificação da Eficácia (Controle de Qualidade)</h5>
            <p><strong>NC Resolvida?</strong> ${currentNC.effectivenessResolved || 'Aguardando Verificação'}</p>
            <p><strong>Houve Recorrência?</strong> ${currentNC.effectivenessRecurred || 'Não'}</p>
            <p class="text-gray-500 italic">"${currentNC.effectivenessDescription || 'Aguardando auditoria preventiva final.'}"</p>
            <p class="font-mono text-[10px] text-gray-400">Verificado por: ${currentNC.effectivenessResponsible} em ${currentNC.effectivenessDate || '-'}</p>
          </div>
          <div class="space-y-2">
            <h5 class="font-bold uppercase text-[#284701]">Homologação e Parecer de Encerramento</h5>
            <p class="text-gray-600">"${currentNC.closureParecer || 'Ocorrência sob investigação operacional preventiva.'}"</p>
            <p class="font-mono text-[10px] text-gray-400">Homologado por: ${currentNC.closureResponsible} em ${currentNC.closureDate || '-'}</p>
            <div class="pt-4 mt-4 border-t border-dashed border-gray-200 text-center text-gray-400 text-[9px] font-mono">
              <p>Chave de Homologação Digital:</p>
              <p class="font-bold text-gray-700">${currentNC.closureSignature || 'PENDENTE DE HOMOLOGAÇÃO'}</p>
            </div>
          </div>
        </div>

      </div>
    `;

    document.getElementById("capa-modal").classList.remove("hidden");
  }

  function closeCAPAModal() {
    document.getElementById("capa-modal").classList.add("hidden");
  }

  // ================= CHAME DA INTELIGÊNCIA ARTIFICIAL GEMINI =================
  async function callGemini(action) {
    let text = "";
    
    if (action === 'improve' || action === 'summarize') {
      text = document.getElementById("form-description").value.trim();
      if (!text) {
        alert("Por favor, preencha o campo de Descrição antes de chamar a Inteligência Artificial Gemini.");
        return;
      }
    } else if (action === 'suggest_cause' || action === 'generate_5whys') {
      text = document.getElementById("form-description").value.trim();
      if (!text) {
        // Se a descrição estiver vazia, sugerir preencher primeiro
        alert("Preencha a descrição do desvio na Aba 2 para que a IA possa analisar e sugerir a causa raiz correspondente.");
        return;
      }
    }

    const context = {
      sector: document.getElementById("form-sector").value,
      process: document.getElementById("form-process").value,
      subprocess: document.getElementById("form-subprocess").value
    };

    // Alerta visual de loading
    const isCause = (action === 'suggest_cause' || action === 'generate_5whys');
    const responsePanel = document.getElementById(isCause ? "ai-cause-panel" : "ai-response-panel");
    const responseText = document.getElementById(isCause ? "ai-cause-text" : "ai-response-text");

    responsePanel.classList.remove("hidden");
    responseText.innerHTML = `<span class="animate-pulse flex items-center gap-2"><svg class="animate-spin h-4 w-4 text-amber-500" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Chamando modelo gemini-3.5-flash e analisando dados da rotina laboratorial...</span>`;

    if (!isCause) {
      // Garantir rolagem visível na aba de descrição
      responsePanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    } else {
      responsePanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    try {
      const response = await fetch("/api/admin/nao-conformidades/ia", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          action: action,
          text: text,
          context: context
        })
      });

      const res = await response.json();
      if (res.success) {
        responseText.textContent = res.result;
      } else {
        responseText.textContent = "Erro retornado pela IA: " + res.error;
      }
    } catch (e) {
      console.error(e);
      responseText.textContent = "Falha crítica de rede ao tentar se conectar ao assistente de inteligência artificial Gemini.";
    }
  }

  function applyAIResult() {
    const txt = document.getElementById("ai-response-text").textContent;
    if (txt && !txt.includes("Chamando modelo") && !txt.includes("Erro retornado")) {
      document.getElementById("form-description").value = txt;
      alert("Texto sugerido pelo Gemini aplicado com sucesso!");
    }
  }

  function applyAICauseResult() {
    const txt = document.getElementById("ai-cause-text").textContent;
    if (txt && !txt.includes("Chamando modelo") && !txt.includes("Erro retornado")) {
      document.getElementById("form-causeAnalysisRoot").value = txt;
      alert("Investigação sugerida pelo Gemini aplicada ao formulário!");
    }
  }
</script>

