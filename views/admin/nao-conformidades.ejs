<!-- ================= MODAL: DOCUMENTO CAPA (PRINT) ================= -->
<div id="capa-modal" class="hidden fixed inset-0 z-50 bg-brand-neutralDark/40 backdrop-blur-sm flex items-center justify-center p-4">
  <div class="bg-white rounded-3xl border border-gray-100 max-w-4xl w-full p-8 shadow-2xl relative flex flex-col max-h-[90vh]">
    <div class="flex justify-between items-center border-b border-gray-100 pb-3 mb-4 shrink-0">
      <h3 class="text-sm font-extrabold uppercase font-mono text-[#284701] flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        <span>Relatório de Não Conformidade e Ação CAPA (ISO 15189)</span>
      </h3>
      <div class="flex gap-2">
        <button onclick="window.print()" class="px-3 py-1 bg-[#284701] hover:bg-[#1e350d] text-white text-xs font-mono font-bold rounded-lg cursor-pointer">Imprimir</button>
        <button onclick="closeCAPAModal()" class="text-gray-400 hover:text-gray-700 focus:outline-none font-bold text-lg">&times;</button>
      </div>
    </div>
    
    <!-- Relatório Estruturado -->
    <div class="flex-1 overflow-y-auto p-6 border border-gray-100 bg-gray-50/20 rounded-2xl" id="capa-print-content">
      <!-- Injetado por Javascript -->
    </div>
  </div>
</div>

<!-- Scripts de Manipulação do Front-End -->
<script>
  // Carrega os dados da Não Conformidade Selecionada no EJS
  let currentNC = <%- selectedNC ? JSON.stringify(selectedNC) : 'null' %>;
  let allNCs = <%- JSON.stringify(nonConformities) %>;

  // Lista local para gerenciar o Plano de Ação dinamicamente
  let currentActionPlan = [];
  if (currentNC && currentNC.actionPlan) {
    currentActionPlan = [...currentNC.actionPlan];
  }

  // Lista local para gerenciar anexos / evidências
  let currentEvidences = [];
  if (currentNC && currentNC.evidences) {
    currentEvidences = [...currentNC.evidences];
  }

  // Lista de históricos
  let currentHistory = [];
  if (currentNC && currentNC.history) {
    currentHistory = [...currentNC.history];
  }

  // Lista de comentários/chat
  let currentComments = [];
  if (currentNC && currentNC.comments) {
    currentComments = [...currentNC.comments];
  }

  document.addEventListener("DOMContentLoaded", function() {
    // Inicializar visualização do plano de ação e histórico
    renderActionPlanTable();
    renderAuditTrail();
    renderChatMessages();

    // Se houver uma NC carregada, seleciona na lista visual
    if (currentNC) {
      const activeCard = document.getElementById(`nc-card-${currentNC.id}`);
      if (activeCard) {
        activeCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }
  });

  // Troca de Abas
  function switchTab(tabId) {
    document.querySelectorAll(".tab-btn").forEach(btn => {
      btn.classList.remove("text-[#284701]", "bg-white", "border", "border-gray-100", "shadow-sm");
      btn.classList.add("text-gray-500", "hover:text-[#284701]", "hover:bg-white/50");
    });
    
    const activeBtn = document.getElementById(`tab-btn-${tabId}`);
    if (activeBtn) {
      activeBtn.classList.remove("text-gray-500", "hover:text-[#284701]", "hover:bg-white/50");
      activeBtn.classList.add("text-[#284701]", "bg-white", "border", "border-gray-100", "shadow-sm");
    }

    document.querySelectorAll(".tab-content").forEach(content => {
      content.classList.add("hidden");
    });
    const activeContent = document.getElementById(`tab-content-${tabId}`);
    if (activeContent) {
      activeContent.classList.remove("hidden");
    }
  }

  // Selecionar uma NC da Listagem
  function selectNC(id) {
    window.location.href = `/admin/nao-conformidades?id=${id}`;
  }

  // Iniciar criação de um novo registro (Zera o formulário)
  function createNewNC() {
    currentNC = null;
    currentActionPlan = [];
    currentEvidences = [];
    currentHistory = [];
    currentComments = [];

    document.getElementById("form-nc-id").value = "";
    document.getElementById("form-id-display").value = "(Novo Registro Autogerado)";
    document.getElementById("form-status").value = "Aberta";
    document.getElementById("form-responsibleRegistration").value = "Dra. Sandra Regina Mendes";
    document.getElementById("form-dateOccurrence").value = "";
    document.getElementById("form-timeOccurrence").value = "";
    document.getElementById("form-dateRegistration").value = new Date().toISOString().substring(0,10);
    document.getElementById("form-subprocess").value = "Triagem / Cadastro";
    document.getElementById("form-description").value = "";
    document.getElementById("form-patientName").value = "";
    document.getElementById("form-patientCode").value = "";
    document.getElementById("form-convenio").value = "";
    document.getElementById("form-requisitionCode").value = "";
    document.getElementById("form-exam").value = "";
    document.getElementById("form-material").value = "";
    document.getElementById("form-lot").value = "";
    document.getElementById("form-reagent").value = "";
    document.getElementById("form-equipment").value = "";
    document.getElementById("form-pop").value = "";
    document.getElementById("form-supplier").value = "";
    document.getElementById("form-impactDescription").value = "";
    document.getElementById("form-causeAnalysisRoot").value = "";
    document.getElementById("form-effectivenessDescription").value = "";
    document.getElementById("form-closureParecer").value = "";

    // Desmarcar checkboxes de partes afetadas
    document.querySelectorAll("input[name='affected']").forEach(cb => {
      cb.checked = false;
    });

    document.getElementById("delete-nc-btn").classList.add("hidden");

    // Reset de exibições dinâmicas
    renderActionPlanTable();
    renderAuditTrail();
    renderChatMessages();

    // Remove destaque visual das listagens
    document.querySelectorAll(".nc-card").forEach(card => {
      card.classList.remove("bg-amber-50/50", "border-[#284701]");
      card.classList.add("border-transparent");
    });

    switchTab("gerais");
  }

  // Filtragem local na listagem
  function filterNCs() {
    const searchText = document.getElementById("nc-search").value.toLowerCase();
    const statusVal = document.getElementById("status-filter").value;
    const severityVal = document.getElementById("severity-filter").value;

    document.querySelectorAll(".nc-card").forEach(card => {
      const text = card.textContent.toLowerCase();
      const matchesText = text.includes(searchText);
      
      const cardId = card.id.replace("nc-card-", "");
      const matchObj = allNCs.find(n => n.id === cardId);
      
      if (!matchObj) return;

      const matchesStatus = (statusVal === 'todos' || matchObj.status === statusVal);
      const matchesSeverity = (severityVal === 'todos' || matchObj.severity === severityVal);

      if (matchesText && matchesStatus && matchesSeverity) {
        card.classList.remove("hidden");
      } else {
        card.classList.add("hidden");
      }
    });
  }

  // ================= GERENCIAMENTO PLANO DE AÇÃO (TABELA DINÂMICA) =================
  function renderActionPlanTable() {
    const container = document.getElementById("action-plan-rows");
    container.innerHTML = "";

    if (currentActionPlan.length === 0) {
      container.innerHTML = `<tr><td colspan="6" class="p-4 text-center text-gray-400">Nenhuma ação cadastrada no plano CAPA. Adicione ações no botão acima.</td></tr>`;
      updateProgressBar(0);
      return;
    }

    let completed = 0;
    currentActionPlan.forEach((act, index) => {
      if (act.status === 'Concluída') completed++;

      const tr = document.createElement("tr");
      tr.className = "hover:bg-gray-50/50";
      tr.innerHTML = `
        <td class="p-3">
          <select onchange="updateActionField(${index}, 'type', this.value)" class="bg-white border border-gray-200 rounded-lg p-1 text-xs">
            <option value="Correção" ${act.type === 'Correção' ? 'selected' : ''}>Correção Imediata</option>
            <option value="Preventiva" ${act.type === 'Preventiva' ? 'selected' : ''}>Preventiva</option>
            <option value="Corretiva" ${act.type === 'Corretiva' ? 'selected' : ''}>Corretiva</option>
            <option value="Educativa" ${act.type === 'Educativa' ? 'selected' : ''}>Educativa</option>
          </select>
        </td>
        <td class="p-3">
          <input type="text" value="${act.description || ''}" onchange="updateActionField(${index}, 'description', this.value)" placeholder="Descreva a ação..." class="w-full bg-white border border-gray-200 rounded-lg p-1 text-xs">
        </td>
        <td class="p-3">
          <input type="text" value="${act.responsible || ''}" onchange="updateActionField(${index}, 'responsible', this.value)" placeholder="Responsável..." class="w-full bg-white border border-gray-200 rounded-lg p-1 text-xs">
        </td>
        <td class="p-3">
          <input type="date" value="${act.deadline || ''}" onchange="updateActionField(${index}, 'deadline', this.value)" class="bg-white border border-gray-200 rounded-lg p-1 text-xs">
        </td>
        <td class="p-3">
          <select onchange="updateActionField(${index}, 'status', this.value)" class="bg-white border border-gray-200 rounded-lg p-1 text-xs font-semibold">
            <option value="Aberta" ${act.status === 'Aberta' ? 'selected' : ''}>Aberta</option>
            <option value="Em Execução" ${act.status === 'Em Execução' ? 'selected' : ''}>Em Execução</option>
            <option value="Concluída" ${act.status === 'Concluída' ? 'selected' : ''}>Concluída</option>
          </select>
        </td>
        <td class="p-3">
          <button type="button" onclick="removeActionPlanRow(${index})" class="text-xs text-rose-600 hover:underline font-bold">Excluir</button>
        </td>
      `;
      container.appendChild(tr);
    });

    const pct = Math.round((completed / currentActionPlan.length) * 100);
    updateProgressBar(pct);
  }

  function addActionPlanRow() {
    currentActionPlan.push({
      id: 'act_' + Date.now(),
      type: 'Correção',
      description: '',
      responsible: currentNC ? currentNC.responsibleRegistration : 'Dra. Sandra Regina Mendes',
      deadline: '',
      status: 'Aberta',
      dateConclusion: ''
    });
    renderActionPlanTable();
  }

  function removeActionPlanRow(index) {
    currentActionPlan.splice(index, 1);
    renderActionPlanTable();
  }

  function updateActionField(index, field, value) {
    currentActionPlan[index][field] = value;
    if (field === 'status' && value === 'Concluída') {
      currentActionPlan[index].dateConclusion = new Date().toISOString().substring(0, 10);
    } else if (field === 'status') {
      currentActionPlan[index].dateConclusion = "";
    }
    renderActionPlanTable();
  }

  function updateProgressBar(pct) {
    document.getElementById("action-progress-label").textContent = `${pct}% Concluído`;
    document.getElementById("action-progress-bar").style.width = `${pct}%`;
  }

  // ================= PROCESSAMENTO E ANEXOS DE EVIDÊNCIAS =================
  function simulateFileUpload() {
    const input = document.getElementById("evidence-file-input");
    input.click();
    input.onchange = function() {
      if (input.files.length === 0) return;
      
      const list = document.getElementById("evidencias-list");
      if (currentEvidences.length === 0) list.innerHTML = "";

      for (let i = 0; i < input.files.length; i++) {
        const file = input.files[i];
        
        // Simular o upload
        const mockEv = {
          name: file.name,
          size: Math.round(file.size / 1024) + ' KB',
          type: file.type || 'application/octet-stream',
          date: new Date().toLocaleDateString('pt-BR') + ' ' + new Date().toLocaleTimeString('pt-BR', {hour: '2-digit', minute:'2-digit'})
        };

        currentEvidences.push(mockEv);
        
        // Renderizar novo item
        const item = document.createElement("div");
        item.className = "p-3 flex justify-between items-center bg-emerald-50/30 rounded-xl border border-emerald-100/50 animate-pulse";
        item.innerHTML = `
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <div>
              <p class="text-xs font-bold text-emerald-800">${mockEv.name} (Carregando...)</p>
              <p class="text-[10px] text-gray-400">${mockEv.size} &bull; Agendado para salvar</p>
            </div>
          </div>
        `;
        list.appendChild(item);

        setTimeout(() => {
          item.classList.remove("bg-emerald-50/30", "border-emerald-100/50", "animate-pulse");
          item.className = "p-3 flex justify-between items-center bg-gray-50/50 rounded-xl";
          item.innerHTML = `
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
              <div>
                <p class="text-xs font-bold text-gray-800">${mockEv.name}</p>
                <p class="text-[10px] text-gray-400">${mockEv.size} &bull; Pronto para salvar</p>
              </div>
            </div>
            <button type="button" onclick="deleteEvidence(${currentEvidences.length - 1})" class="text-xs text-red-500 font-mono hover:underline">Remover</button>
          `;
        }, 1000);
      }
    };
  }

  function deleteEvidence(idx) {
    currentEvidences.splice(idx, 1);
    const list = document.getElementById("evidencias-list");
    list.innerHTML = "";
    if (currentEvidences.length === 0) {
      list.innerHTML = `<div class="p-4 text-center text-gray-400 text-xs">Nenhum anexo registrado como evidência física.</div>`;
      return;
    }
    currentEvidences.forEach((ev, i) => {
