  // ================= SALVAMENTO DE FORMULÁRIO (AJAX) =================
  async function saveNCForm(event) {
    if (event) event.preventDefault();

    const form = document.getElementById("nc-form");
    const formData = new FormData(form);
    const body = {};

    formData.forEach((value, key) => {
      if (key === 'affected') {
        if (!body[key]) body[key] = [];
        body[key].push(value);
      } else {
        body[key] = value;
      }
    });

    // Injetar dados estruturados dinamicamente gerenciados
    body.actionPlanJson = JSON.stringify(currentActionPlan);
    body.evidences = currentEvidences;

    try {
      const response = await fetch("/admin/nao-conformidades/salvar", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body)
      });

      const res = await response.json();
      if (res.success) {
        alert("Não Conformidade salva com absoluto sucesso!");
        // Redireciona com o ID atual para manter o foco e carregar de forma nativa e estática
        window.location.href = `/admin/nao-conformidades?id=${res.id}`;
      } else {
        alert("Erro ao salvar: " + res.error);
      }
    } catch (e) {
      console.error(e);
      alert("Falha de rede ao tentar salvar os dados.");
    }
  }

  // ================= REMOÇÃO DE REGISTRO =================
  async function deleteNC() {
    if (!currentNC) return;
    if (!confirm(`Deseja realmente remover a ocorrência ${currentNC.id} de forma irreversível?`)) return;

    try {
      const response = await fetch("/admin/nao-conformidades/deletar", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ id: currentNC.id })
      });

      const res = await response.json();
      if (res.success) {
        alert("Não Conformidade removida com sucesso!");
        window.location.href = "/admin/nao-conformidades";
      } else {
        alert("Erro ao remover: " + res.error);
      }
    } catch (e) {
      console.error(e);
      alert("Falha ao comunicar exclusão.");
    }
  }

