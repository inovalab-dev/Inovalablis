<%- include('../partials/header') %>

<!-- Conteúdo Principal da Gestão de Não Conformidades -->
<div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 py-6 flex-1 flex flex-col min-h-screen">
  
  <!-- Cabeçalho -->
  <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-4 pb-6 border-b border-gray-200">
    <div>
      <div class="flex items-center gap-2 text-xs font-semibold text-gray-400">
        <a href="/admin" class="hover:text-brand-dark transition-colors">Administração</a>
        <span>&rsaquo;</span>
        <span class="text-brand-dark font-bold font-mono uppercase text-[10px]">Qualidade</span>
      </div>
      <h1 class="text-2xl font-black text-brand-neutralDark tracking-tight mt-1 flex items-center gap-3">
        Gestão de Não Conformidades <span class="text-[10px] bg-red-100 text-red-800 px-2.5 py-0.5 rounded-full font-mono font-bold uppercase tracking-wider">RDC 302 / ISO 15189</span>
      </h1>
      <p class="text-xs text-gray-500 mt-1">Identificação, rastreabilidade, análise de causa raiz e planos de ação corretiva e preventiva (CAPA).</p>
    </div>
    
    <div class="flex flex-wrap gap-2 w-full lg:w-auto">
      <button onclick="createNewNC()" class="flex-1 lg:flex-initial text-center px-4 py-2.5 bg-[#284701] hover:bg-[#1e350d] text-white text-xs font-bold font-mono uppercase tracking-wider rounded-xl transition-all shadow-md hover:shadow-lg flex items-center justify-center gap-2 cursor-pointer">
        <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
        <span>+ Nova Não Conformidade</span>
      </button>
    </div>
  </div>

  <!-- Painel de Indicadores e KPIs da Qualidade -->
  <div class="grid grid-cols-2 lg:grid-cols-5 gap-4 py-6">
    <div class="bg-white p-4 rounded-2xl border border-gray-100 shadow-sm flex flex-col justify-between">
      <span class="text-[9px] font-extrabold font-mono text-gray-400 uppercase tracking-widest">Total Registrado</span>
      <div class="flex items-baseline justify-between mt-1">
        <span class="text-xl font-black text-brand-neutralDark font-mono" id="kpi-total"><%= nonConformities.length %></span>
        <span class="text-[10px] text-gray-400">ocorrencias</span>
      </div>
    </div>
    <div class="bg-white p-4 rounded-2xl border border-gray-100 shadow-sm flex flex-col justify-between border-l-4 border-red-500">
      <span class="text-[9px] font-extrabold font-mono text-red-600 uppercase tracking-widest">Abertas / Em Análise</span>
      <div class="flex items-baseline justify-between mt-1">
        <span class="text-xl font-black text-red-600 font-mono" id="kpi-open">
          <%= nonConformities.filter(n => n.status === 'Aberta' || n.status === 'Em Análise').length %>
        </span>
        <span class="text-[9px] bg-red-50 text-red-700 px-1.5 py-0.5 rounded font-mono font-bold">Ação Crítica</span>
      </div>
    </div>
    <div class="bg-white p-4 rounded-2xl border border-gray-100 shadow-sm flex flex-col justify-between border-l-4 border-amber-500">
      <span class="text-[9px] font-extrabold font-mono text-amber-600 uppercase tracking-widest">Em Execução / Validação</span>
      <div class="flex items-baseline justify-between mt-1">
        <span class="text-xl font-black text-amber-600 font-mono" id="kpi-execution">
          <%= nonConformities.filter(n => n.status === 'Em Execução' || n.status === 'Aguardando Validação').length %>
        </span>
        <span class="text-[10px] text-gray-400">em progresso</span>
      </div>
    </div>
    <div class="bg-white p-4 rounded-2xl border border-gray-100 shadow-sm flex flex-col justify-between border-l-4 border-emerald-500">
      <span class="text-[9px] font-extrabold font-mono text-emerald-600 uppercase tracking-widest">Encerradas</span>
      <div class="flex items-baseline justify-between mt-1">
        <span class="text-xl font-black text-emerald-600 font-mono" id="kpi-closed">
          <%= nonConformities.filter(n => n.status === 'Encerrada').length %>
        </span>
        <span class="text-[9px] bg-emerald-50 text-emerald-700 px-1.5 py-0.5 rounded font-mono font-bold">Resolvidas</span>
      </div>
    </div>
    <div class="bg-white p-4 rounded-2xl border border-gray-100 shadow-sm flex flex-col justify-between col-span-2 lg:col-span-1">
      <span class="text-[9px] font-extrabold font-mono text-brand-dark uppercase tracking-widest">Indicadores CAPA</span>
      <div class="space-y-1 mt-2">
        <div class="flex justify-between text-[10px]">
          <span class="text-gray-500">Eficácia das Ações:</span>
          <span class="font-bold text-emerald-600">94.5%</span>
        </div>
        <div class="flex justify-between text-[10px]">
          <span class="text-gray-500">Índice Recorrência:</span>
          <span class="font-bold text-red-600">1.2%</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Layout Dividido em Duas Colunas -->
  <div class="flex-1 grid grid-cols-1 xl:grid-cols-12 gap-6 items-start">
    
    <!-- Coluna Esquerda: Listagem de NCs (xl:col-span-4) -->
    <div class="xl:col-span-4 bg-white rounded-3xl border border-gray-100 shadow-sm overflow-hidden flex flex-col h-[calc(100vh-250px)] min-h-[500px]">
      
      <!-- Cabeçalho de Busca e Filtro -->
      <div class="p-4 border-b border-gray-100 bg-gray-50/60 space-y-3">
        <div>
          <label class="text-[9px] font-extrabold uppercase font-mono tracking-wider text-gray-400">Buscar Ocorrência</label>
          <div class="relative mt-1">
            <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400 pointer-events-none">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            </span>
            <input type="text" id="nc-search" oninput="filterNCs()" placeholder="Nº da NC, setor ou descrição..." class="pl-9 w-full bg-white border border-gray-200 rounded-xl py-2 px-3 text-xs focus:ring-2 focus:ring-brand-gold focus:border-brand-gold focus:outline-none transition-all">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="text-[9px] font-extrabold uppercase font-mono tracking-wider text-gray-400">Filtrar por Status</label>
            <select id="status-filter" onchange="filterNCs()" class="mt-1 w-full bg-white border border-gray-200 rounded-xl py-1.5 px-2 text-xs focus:ring-2 focus:ring-brand-gold focus:outline-none">
              <option value="todos">Todos os Status</option>
              <option value="Aberta">Aberta</option>
              <option value="Em Análise">Em Análise</option>
              <option value="Em Execução">Em Execução</option>
              <option value="Aguardando Validação">Aguardando Validação</option>
              <option value="Encerrada">Encerrada</option>
            </select>
          </div>
          <div>
            <label class="text-[9px] font-extrabold uppercase font-mono tracking-wider text-gray-400">Gravidade</label>
            <select id="severity-filter" onchange="filterNCs()" class="mt-1 w-full bg-white border border-gray-200 rounded-xl py-1.5 px-2 text-xs focus:ring-2 focus:ring-brand-gold focus:outline-none">
              <option value="todos">Todas</option>
              <option value="Baixa">Baixa</option>
              <option value="Média">Média</option>
              <option value="Alta">Alta</option>
              <option value="Crítica">Crítica</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Lista Rolável -->
      <div class="flex-1 overflow-y-auto divide-y divide-gray-100" id="nc-list-container">
        <% if (nonConformities.length === 0) { %>
          <div class="p-8 text-center text-gray-400 space-y-2">
            <svg class="w-12 h-12 mx-auto stroke-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <p class="text-xs font-semibold">Nenhuma Não Conformidade registrada.</p>
            <button onclick="createNewNC()" class="text-xs text-brand-gold font-bold underline hover:text-brand-dark transition-colors">Criar a primeira agora</button>
          </div>
        <% } else { %>
          <% nonConformities.forEach(function(nc) { %>
            <div onclick="selectNC('<%= nc.id %>')" id="nc-card-<%= nc.id %>" class="nc-card p-4 hover:bg-gray-50 cursor-pointer transition-colors border-l-4 <%= selectedNC && selectedNC.id === nc.id ? 'bg-amber-50/50 border-[#284701]' : 'border-transparent' %>">
              <div class="flex justify-between items-start gap-2">
                <span class="font-mono font-bold text-xs text-brand-neutralDark"><%= nc.id %></span>
                
                <!-- Badge de Status Dinâmico -->
                <% 
                  let badgeClass = "bg-red-50 text-red-700 border-red-100";
                  if (nc.status === 'Em Análise') badgeClass = "bg-orange-50 text-orange-700 border-orange-100";
                  else if (nc.status === 'Em Execução') badgeClass = "bg-blue-50 text-blue-700 border-blue-100";
                  else if (nc.status === 'Aguardando Validação') badgeClass = "bg-purple-50 text-purple-700 border-purple-100";
                  else if (nc.status === 'Encerrada') badgeClass = "bg-emerald-50 text-emerald-700 border-emerald-100";
                %>
                <span class="text-[9px] px-2 py-0.5 rounded-full border font-bold font-mono tracking-wider <%= badgeClass %>">
                  <%= nc.status %>
                </span>
              </div>
              
              <div class="text-[11px] text-gray-500 font-bold mt-1.5 flex justify-between items-center">
                <span><%= nc.sector %> &bull; <%= nc.process %></span>
                <span class="text-[10px] font-normal"><%= nc.dateOccurrence %></span>
              </div>
              
              <p class="text-xs text-gray-700 font-normal line-clamp-2 mt-2 leading-relaxed">
                <%= nc.description %>
              </p>

              <div class="flex justify-between items-center mt-3">
                <div class="flex items-center gap-1.5">
                  <% if (nc.severity === 'Alta' || nc.severity === 'Crítica') { %>
                    <span class="text-[9px] bg-red-100 text-red-800 font-extrabold px-1.5 py-0.2 rounded uppercase">Critico</span>
                  <% } else { %>
                    <span class="text-[9px] bg-gray-100 text-gray-700 px-1.5 py-0.2 rounded"><%= nc.severity %></span>
                  <% } %>
                  
                  <% if (nc.actionPlan && nc.actionPlan.length > 0) { %>
                    <% 
                      let done = nc.actionPlan.filter(a => a.status === 'Concluída').length;
                      let total = nc.actionPlan.length;
                      let pct = Math.round((done / total) * 100);
                    %>
                    <span class="text-[9px] font-mono text-gray-400 font-bold">Plano: <%= done %>/<%= total %> (<%= pct %>%)</span>
                  <% } %>
                </div>
                
                <% if (nc.comments && nc.comments.length > 0) { %>
                  <span class="flex items-center gap-1 text-[10px] text-gray-400 font-mono">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                    <%= nc.comments.length %>
                  </span>
                <% } %>
              </div>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>

    <!-- Coluna Direita: Painel de Ocorrência Detalhado (xl:col-span-8) -->
    <div class="xl:col-span-8 space-y-6">
      
      <!-- Se não houver nada e houver NCs, mostramos aviso ou carregamos o primeiro -->
      <div id="nc-detail-card" class="bg-white rounded-3xl border border-gray-100 shadow-sm overflow-hidden flex flex-col min-h-[500px]">
        
        <!-- Formulário Geral da Não Conformidade -->
        <form id="nc-form" onsubmit="saveNCForm(event)" class="flex flex-col flex-1">
          <input type="hidden" name="id" id="form-nc-id" value="<%= selectedNC ? selectedNC.id : '' %>">
          
          <!-- Abas de Navegação (10 Abas) -->
          <div class="border-b border-gray-200 bg-gray-50/50 p-2 overflow-x-auto whitespace-nowrap scrollbar-none flex items-center gap-1">
            <button type="button" onclick="switchTab('gerais')" id="tab-btn-gerais" class="tab-btn px-3 py-2 text-xs font-bold font-mono uppercase tracking-wider rounded-xl transition-all text-[#284701] bg-white border border-gray-100 shadow-sm">
              1. Gerais
            </button>
            <button type="button" onclick="switchTab('descricao')" id="tab-btn-descricao" class="tab-btn px-3 py-2 text-xs font-bold font-mono uppercase tracking-wider rounded-xl transition-all text-gray-500 hover:text-[#284701] hover:bg-white/50">
              2. Descrição
            </button>
            <button type="button" onclick="switchTab('paciente')" id="tab-btn-paciente" class="tab-btn px-3 py-2 text-xs font-bold font-mono uppercase tracking-wider rounded-xl transition-all text-gray-500 hover:text-[#284701] hover:bg-white/50">
              3. Paciente/Exame
            </button>
            <button type="button" onclick="switchTab('impacto')" id="tab-btn-impacto" class="tab-btn px-3 py-2 text-xs font-bold font-mono uppercase tracking-wider rounded-xl transition-all text-gray-500 hover:text-[#284701] hover:bg-white/50">
              4. Impacto
            </button>
            <button type="button" onclick="switchTab('evidencias')" id="tab-btn-evidencias" class="tab-btn px-3 py-2 text-xs font-bold font-mono uppercase tracking-wider rounded-xl transition-all text-gray-500 hover:text-[#284701] hover:bg-white/50">
              5. Evidências
            </button>
            <button type="button" onclick="switchTab('causa')" id="tab-btn-causa" class="tab-btn px-3 py-2 text-xs font-bold font-mono uppercase tracking-wider rounded-xl transition-all text-gray-500 hover:text-[#284701] hover:bg-white/50">
              6. Causa
            </button>
            <button type="button" onclick="switchTab('plano')" id="tab-btn-plano" class="tab-btn px-3 py-2 text-xs font-bold font-mono uppercase tracking-wider rounded-xl transition-all text-gray-500 hover:text-[#284701] hover:bg-white/50">
              7. Plano CAPA
            </button>
            <button type="button" onclick="switchTab('eficacia')" id="tab-btn-eficacia" class="tab-btn px-3 py-2 text-xs font-bold font-mono uppercase tracking-wider rounded-xl transition-all text-gray-500 hover:text-[#284701] hover:bg-white/50">
              8. Eficácia
            </button>
            <button type="button" onclick="switchTab('encerramento')" id="tab-btn-encerramento" class="tab-btn px-3 py-2 text-xs font-bold font-mono uppercase tracking-wider rounded-xl transition-all text-gray-500 hover:text-[#284701] hover:bg-white/50">
              9. Fechamento
            </button>
            <button type="button" onclick="switchTab('historico')" id="tab-btn-historico" class="tab-btn px-3 py-2 text-xs font-bold font-mono uppercase tracking-wider rounded-xl transition-all text-gray-500 hover:text-[#284701] hover:bg-white/50">
              10. Histórico/Chat
            </button>
          </div>

          <!-- Corpo do Detalhe das Abas -->
          <div class="p-6 flex-1 overflow-y-auto min-h-[400px]">
            
            <!-- ABA 1: Informações Gerais -->
            <div id="tab-content-gerais" class="tab-content space-y-6">
              <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                  <label class="text-[10px] font-extrabold uppercase font-mono text-gray-400">Número da NC (Somente Leitura)</label>
                  <input type="text" id="form-id-display" readonly value="<%= selectedNC ? selectedNC.id : '(Novo Registro Autogerado)' %>" class="mt-1.5 w-full bg-gray-50 border border-gray-200 text-gray-500 rounded-xl py-2 px-3 text-xs font-bold font-mono outline-none cursor-not-allowed">
                </div>
                <div>
                  <label class="text-[10px] font-extrabold uppercase font-mono text-gray-400">Status Ocorrência</label>
                  <select name="status" id="form-status" class="mt-1.5 w-full bg-white border border-gray-200 rounded-xl py-2 px-3 text-xs focus:ring-2 focus:ring-brand-gold focus:outline-none font-bold">
                    <option value="Aberta" <%= selectedNC && selectedNC.status === 'Aberta' ? 'selected' : '' %>>Aberta</option>
                    <option value="Em Análise" <%= selectedNC && selectedNC.status === 'Em Análise' ? 'selected' : '' %>>Em Análise</option>
                    <option value="Em Execução" <%= selectedNC && selectedNC.status === 'Em Execução' ? 'selected' : '' %>>Em Execução</option>
                    <option value="Aguardando Validação" <%= selectedNC && selectedNC.status === 'Aguardando Validação' ? 'selected' : '' %>>Aguardando Validação</option>
                    <option value="Encerrada" <%= selectedNC && selectedNC.status === 'Encerrada' ? 'selected' : '' %>>Encerrada</option>
                  </select>
                </div>
                <div>
                  <label class="text-[10px] font-extrabold uppercase font-mono text-gray-400">Responsável pelo Registro</label>
                  <input type="text" name="responsibleRegistration" required id="form-responsibleRegistration" value="<%= selectedNC ? selectedNC.responsibleRegistration : 'Dra. Sandra Regina Mendes' %>" class="mt-1.5 w-full bg-white border border-gray-200 rounded-xl py-2 px-3 text-xs focus:ring-2 focus:ring-brand-gold focus:outline-none">
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                  <label class="text-[10px] font-extrabold uppercase font-mono text-gray-400">Data da Ocorrência</label>
                  <input type="date" name="dateOccurrence" required id="form-dateOccurrence" value="<%= selectedNC ? selectedNC.dateOccurrence : '' %>" class="mt-1.5 w-full bg-white border border-gray-200 rounded-xl py-2 px-3 text-xs focus:ring-2 focus:ring-brand-gold focus:outline-none">
                </div>
                <div>
                  <label class="text-[10px] font-extrabold uppercase font-mono text-gray-400">Hora</label>
                  <input type="time" name="timeOccurrence" required id="form-timeOccurrence" value="<%= selectedNC ? selectedNC.timeOccurrence : '' %>" class="mt-1.5 w-full bg-white border border-gray-200 rounded-xl py-2 px-3 text-xs focus:ring-2 focus:ring-brand-gold focus:outline-none">
                </div>
                <div>
                  <label class="text-[10px] font-extrabold uppercase font-mono text-gray-400">Data do Registro</label>
                  <input type="date" name="dateRegistration" required id="form-dateRegistration" value="<%= selectedNC ? selectedNC.dateRegistration : new Date().toISOString().substring(0,10) %>" class="mt-1.5 w-full bg-white border border-gray-200 rounded-xl py-2 px-3 text-xs focus:ring-2 focus:ring-brand-gold focus:outline-none">
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                  <label class="text-[10px] font-extrabold uppercase font-mono text-gray-400">Unidade</label>
                  <select name="unit" id="form-unit" class="mt-1.5 w-full bg-white border border-gray-200 rounded-xl py-2 px-3 text-xs focus:ring-2 focus:ring-brand-gold focus:outline-none">
                    <option value="Unidade Cambará - Central" <%= selectedNC && selectedNC.unit === 'Unidade Cambará - Central' ? 'selected' : '' %>>Unidade Cambará - Central</option>
                    <option value="Unidade Posto Avançado Cambará" <%= selectedNC && selectedNC.unit === 'Unidade Posto Avançado Cambará' ? 'selected' : '' %>>Unidade Posto Avançado Cambará</option>
                  </select>
                </div>
                <div>
                  <label class="text-[10px] font-extrabold uppercase font-mono text-gray-400">Setor Laboratorial</label>
                  <select name="sector" id="form-sector" class="mt-1.5 w-full bg-white border border-gray-200 rounded-xl py-2 px-3 text-xs focus:ring-2 focus:ring-brand-gold focus:outline-none">
                    <option value="Hematologia" <%= selectedNC && selectedNC.sector === 'Hematologia' ? 'selected' : '' %>>Hematologia</option>
                    <option value="Bioquímica" <%= selectedNC && selectedNC.sector === 'Bioquímica' ? 'selected' : '' %>>Bioquímica</option>
                    <option value="Imunologia" <%= selectedNC && selectedNC.sector === 'Imunologia' ? 'selected' : '' %>>Imunologia</option>
                    <option value="Microbiologia" <%= selectedNC && selectedNC.sector === 'Microbiologia' ? 'selected' : '' %>>Microbiologia</option>
                    <option value="Uroanálise" <%= selectedNC && selectedNC.sector === 'Uroanálise' ? 'selected' : '' %>>Uroanálise</option>
                    <option value="Qualidade / Geral" <%= selectedNC && selectedNC.sector === 'Qualidade / Geral' ? 'selected' : '' %>>Qualidade / Geral</option>
                  </select>
                </div>
                <div>
                  <label class="text-[10px] font-extrabold uppercase font-mono text-gray-400">Origem da Identificação</label>
                  <select name="origin" id="form-origin" class="mt-1.5 w-full bg-white border border-gray-200 rounded-xl py-2 px-3 text-xs focus:ring-2 focus:ring-brand-gold focus:outline-none">
                    <option value="Auditoria Interna de Rotina" <%= selectedNC && selectedNC.origin === 'Auditoria Interna de Rotina' ? 'selected' : '' %>>Auditoria Interna de Rotina</option>
                    <option value="Auditoria Externa (PALC)" <%= selectedNC && selectedNC.origin === 'Auditoria Externa (PALC)' ? 'selected' : '' %>>Auditoria Externa (PALC)</option>
                    <option value="Reclamação de Paciente" <%= selectedNC && selectedNC.origin === 'Reclamação de Paciente' ? 'selected' : '' %>>Reclamação de Paciente</option>
                    <option value="Análise Crítica Diária da Equipe" <%= selectedNC && selectedNC.origin === 'Análise Crítica Diária da Equipe' ? 'selected' : '' %>>Análise Crítica Diária da Equipe</option>
                    <option value="Controle Interno de Qualidade (CIQ)" <%= selectedNC && selectedNC.origin === 'Controle Interno de Qualidade (CIQ)' ? 'selected' : '' %>>Controle Interno de Qualidade (CIQ)</option>
                    <option value="Controle Externo (Ensaios de Proficiência)" <%= selectedNC && selectedNC.origin === 'Controle Externo (Ensaios de Proficiência)' ? 'selected' : '' %>>Controle Externo (Ensaios de Proficiência)</option>
                  </select>
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label class="text-[10px] font-extrabold uppercase font-mono text-gray-400">Processo Afetado</label>
                  <select name="process" id="form-process" class="mt-1.5 w-full bg-white border border-gray-200 rounded-xl py-2 px-3 text-xs focus:ring-2 focus:ring-brand-gold focus:outline-none">
                    <option value="Fase Pré-Analítica" <%= selectedNC && selectedNC.process === 'Fase Pré-Analítica' ? 'selected' : '' %>>Fase Pré-Analítica</option>
                    <option value="Fase Analítica" <%= selectedNC && selectedNC.process === 'Fase Analítica' ? 'selected' : '' %>>Fase Analítica</option>
                    <option value="Fase Pós-Analítica" <%= selectedNC && selectedNC.process === 'Fase Pós-Analítica' ? 'selected' : '' %>>Fase Pós-Analítica</option>
                    <option value="Processo Suporte/Garantia" <%= selectedNC && selectedNC.process === 'Processo Suporte/Garantia' ? 'selected' : '' %>>Processo Suporte/Garantia</option>
                  </select>
                </div>
                <div>
                  <label class="text-[10px] font-extrabold uppercase font-mono text-gray-400">Subprocesso</label>
                  <input type="text" name="subprocess" id="form-subprocess" value="<%= selectedNC ? selectedNC.subprocess : 'Processamento de Amostra' %>" placeholder="Ex: Cadastro, Triagem, Soroteca, Assinatura de Laudo..." class="mt-1.5 w-full bg-white border border-gray-200 rounded-xl py-2 px-3 text-xs focus:ring-2 focus:ring-brand-gold focus:outline-none">
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label class="text-[10px] font-extrabold uppercase font-mono text-gray-400">Categoria da Não Conformidade</label>
                  <select name="category" id="form-category" class="mt-1.5 w-full bg-white border border-gray-200 rounded-xl py-2 px-3 text-xs focus:ring-2 focus:ring-brand-gold focus:outline-none">
                    <option value="Desvio de Equipamento" <%= selectedNC && selectedNC.category === 'Desvio de Equipamento' ? 'selected' : '' %>>Desvio de Equipamento</option>
                    <option value="Troca/Erro de Amostra" <%= selectedNC && selectedNC.category === 'Troca/Erro de Amostra' ? 'selected' : '' %>>Troca/Erro de Amostra</option>
                    <option value="Atraso na Entrega (TAT)" <%= selectedNC && selectedNC.category === 'Atraso na Entrega (TAT)' ? 'selected' : '' %>>Atraso na Entrega (TAT)</option>
                    <option value="Reagente Vencido ou Degradado" <%= selectedNC && selectedNC.category === 'Reagente Vencido ou Degradado' ? 'selected' : '' %>>Reagente Vencido ou Degradado</option>
                    <option value="Erro de Transcrição/Digitação" <%= selectedNC && selectedNC.category === 'Erro de Transcrição/Digitação' ? 'selected' : '' %>>Erro de Transcrição/Digitação</option>
                  </select>
                </div>
                <div>
                  <label class="text-[10px] font-extrabold uppercase font-mono text-gray-400">Tipo de Falha</label>
                  <input type="text" name="type" id="form-type" value="<%= selectedNC ? selectedNC.type : 'Erro de Calibração' %>" placeholder="Ex: Descalibração mecânica, erro de software..." class="mt-1.5 w-full bg-white border border-gray-200 rounded-xl py-2 px-3 text-xs focus:ring-2 focus:ring-brand-gold focus:outline-none">
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label class="text-[10px] font-extrabold uppercase font-mono text-gray-400">Gravidade</label>
                  <select name="severity" id="form-severity" class="mt-1.5 w-full bg-white border border-gray-200 rounded-xl py-2 px-3 text-xs focus:ring-2 focus:ring-brand-gold focus:outline-none">
                    <option value="Baixa" <%= selectedNC && selectedNC.severity === 'Baixa' ? 'selected' : '' %>>Baixa (Mínimo impacto operacional)</option>
                    <option value="Média" <%= selectedNC && selectedNC.severity === 'Média' ? 'selected' : '' %>>Média (Impacto gerenciável com correção rápida)</option>
                    <option value="Alta" <%= selectedNC && selectedNC.severity === 'Alta' ? 'selected' : '' %>>Alta (Impacto no TAT ou risco analítico sob controle)</option>
                    <option value="Crítica" <%= selectedNC && selectedNC.severity === 'Crítica' ? 'selected' : '' %>>Crítica (Prejuízo ao paciente / recolta imediata)</option>
                  </select>
                </div>
                <div>
                  <label class="text-[10px] font-extrabold uppercase font-mono text-gray-400">Prioridade</label>
                  <select name="priority" id="form-priority" class="mt-1.5 w-full bg-white border border-gray-200 rounded-xl py-2 px-3 text-xs focus:ring-2 focus:ring-brand-gold focus:outline-none">
                    <option value="Baixa" <%= selectedNC && selectedNC.priority === 'Baixa' ? 'selected' : '' %>>Baixa</option>
                    <option value="Média" <%= selectedNC && selectedNC.priority === 'Média' ? 'selected' : '' %>>Média</option>
                    <option value="Alta" <%= selectedNC && selectedNC.priority === 'Alta' ? 'selected' : '' %>>Alta</option>
                    <option value="Crítica" <%= selectedNC && selectedNC.priority === 'Crítica' ? 'selected' : '' %>>Imediata / Crítica</option>
                  </select>
                </div>
              </div>
            </div>

            <!-- ABA 2: Descrição Detalhada -->
            <div id="tab-content-descricao" class="tab-content hidden space-y-4">
              <div>
                <label class="text-[10px] font-extrabold uppercase font-mono text-gray-400">Descrição Detalhada do Desvio Ocorrido</label>
                <textarea name="description" id="form-description" rows="8" placeholder="Descreva de forma rica e objetiva o que ocorreu, onde ocorreu, como foi descoberto, as consequências imediatas e ações paliativas já adotadas pela equipe..." class="mt-1.5 w-full bg-white border border-gray-200 rounded-xl p-3 text-xs focus:ring-2 focus:ring-brand-gold focus:outline-none leading-relaxed"><%= selectedNC ? selectedNC.description : '' %></textarea>
              </div>

              <!-- Integração de IA - Botões Rápidos e Exibição de Resultados -->
              <div class="bg-gray-50 p-4 rounded-2xl border border-gray-100 flex flex-col gap-3">
                <div class="flex items-center gap-2">
                  <span class="text-[9px] bg-amber-500 text-white font-mono font-bold px-1.5 py-0.5 rounded uppercase">Módulo IA Gemini</span>
                  <span class="text-[11px] text-gray-600 font-bold">Assistente de Redação e Qualidade</span>
                </div>
                
                <div class="flex flex-wrap gap-2">
                  <button type="button" onclick="callGemini('improve')" class="px-3 py-1.5 bg-brand-dark hover:bg-[#1e350d] text-white rounded-lg text-xs font-mono font-bold cursor-pointer transition-colors active:scale-95 flex items-center gap-1">
                    <svg class="w-3.5 h-3.5 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                    Melhorar Descrição com IA
                  </button>
                  <button type="button" onclick="callGemini('summarize')" class="px-3 py-1.5 bg-brand-dark hover:bg-[#1e350d] text-white rounded-lg text-xs font-mono font-bold cursor-pointer transition-colors active:scale-95 flex items-center gap-1">
                    <svg class="w-3.5 h-3.5 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/></svg>
                    Resumir Ocorrência
                  </button>
                </div>

                <!-- Painel de Output da IA -->
                <div id="ai-response-panel" class="hidden mt-3 bg-white p-3 rounded-xl border border-amber-200/50 space-y-2 relative">
                  <div class="flex justify-between items-center border-b border-gray-100 pb-1">
                    <span class="text-[10px] font-mono text-amber-700 font-bold">Resultado Sugerido pelo Gemini:</span>
                    <button type="button" onclick="applyAIResult()" class="text-[10px] text-emerald-600 font-bold hover:underline font-mono">Aplicar ao Campo Descrição</button>
                  </div>
                  <p id="ai-response-text" class="text-xs text-gray-700 leading-relaxed italic whitespace-pre-wrap"></p>
                </div>
              </div>
            </div>

            <!-- ABA 3: Paciente / Exame Vinculado -->
            <div id="tab-content-paciente" class="tab-content hidden space-y-6">
              <div class="border-l-4 border-amber-400 pl-3">
                <h4 class="text-xs font-extrabold uppercase font-mono text-gray-400">Vínculos de Amostra, Equipamento e Paciente</h4>
                <p class="text-[11px] text-gray-500">Mantenha a rastreabilidade total preenchendo as informações associadas à ocorrência.</p>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                  <label class="text-[10px] font-extrabold uppercase font-mono text-gray-400">Nome do Paciente</label>
                  <input type="text" name="patientName" id="form-patientName" value="<%= selectedNC ? selectedNC.patientName : '' %>" placeholder="Ex: Maria de Lurdes" class="mt-1.5 w-full bg-white border border-gray-200 rounded-xl py-2 px-3 text-xs focus:ring-2 focus:ring-brand-gold focus:outline-none">
                </div>
                <div>
                  <label class="text-[10px] font-extrabold uppercase font-mono text-gray-400">Código do Paciente</label>
                  <input type="text" name="patientCode" id="form-patientCode" value="<%= selectedNC ? selectedNC.patientCode : '' %>" placeholder="Ex: 123456" class="mt-1.5 w-full bg-white border border-gray-200 rounded-xl py-2 px-3 text-xs focus:ring-2 focus:ring-brand-gold focus:outline-none font-mono">
                </div>
                <div>
                  <label class="text-[10px] font-extrabold uppercase font-mono text-gray-400">Convênio</label>
                  <input type="text" name="convenio" id="form-convenio" value="<%= selectedNC ? selectedNC.convenio : '' %>" placeholder="Ex: Unimed, Particular, SUS..." class="mt-1.5 w-full bg-white border border-gray-200 rounded-xl py-2 px-3 text-xs focus:ring-2 focus:ring-brand-gold focus:outline-none">
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                  <label class="text-[10px] font-extrabold uppercase font-mono text-gray-400">Código da Requisição</label>
                  <input type="text" name="requisitionCode" id="form-requisitionCode" value="<%= selectedNC ? selectedNC.requisitionCode : '' %>" placeholder="Ex: REQ887" class="mt-1.5 w-full bg-white border border-gray-200 rounded-xl py-2 px-3 text-xs focus:ring-2 focus:ring-brand-gold focus:outline-none font-mono">
                </div>
                <div>
                  <label class="text-[10px] font-extrabold uppercase font-mono text-gray-400">Exame Ocorrido</label>
                  <input type="text" name="exam" id="form-exam" value="<%= selectedNC ? selectedNC.exam : '' %>" placeholder="Ex: Hemograma Completo" class="mt-1.5 w-full bg-white border border-gray-200 rounded-xl py-2 px-3 text-xs focus:ring-2 focus:ring-brand-gold focus:outline-none">
                </div>
                <div>
                  <label class="text-[10px] font-extrabold uppercase font-mono text-gray-400">Material Biológico</label>
                  <input type="text" name="material" id="form-material" value="<%= selectedNC ? selectedNC.material : '' %>" placeholder="Ex: Sangue Total (EDTA)" class="mt-1.5 w-full bg-white border border-gray-200 rounded-xl py-2 px-3 text-xs focus:ring-2 focus:ring-brand-gold focus:outline-none">
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                  <label class="text-[10px] font-extrabold uppercase font-mono text-gray-400">Lote do Insumo</label>
                  <input type="text" name="lot" id="form-lot" value="<%= selectedNC ? selectedNC.lot : '' %>" placeholder="Ex: L2026-X8" class="mt-1.5 w-full bg-white border border-gray-200 rounded-xl py-2 px-3 text-xs focus:ring-2 focus:ring-brand-gold focus:outline-none font-mono">
                </div>
                <div>
                  <label class="text-[10px] font-extrabold uppercase font-mono text-gray-400">Reagente Utilizado</label>
                  <input type="text" name="reagent" id="form-reagent" value="<%= selectedNC ? selectedNC.reagent : '' %>" placeholder="Ex: Calibrador Hemoglobin 5V" class="mt-1.5 w-full bg-white border border-gray-200 rounded-xl py-2 px-3 text-xs focus:ring-2 focus:ring-brand-gold focus:outline-none">
                </div>
                <div>
                  <label class="text-[10px] font-extrabold uppercase font-mono text-gray-400">Equipamento Laboratorial</label>
                  <input type="text" name="equipment" id="form-equipment" value="<%= selectedNC ? selectedNC.equipment : '' %>" placeholder="Ex: Sysmex XN-1000" class="mt-1.5 w-full bg-white border border-gray-200 rounded-xl py-2 px-3 text-xs focus:ring-2 focus:ring-brand-gold focus:outline-none">
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label class="text-[10px] font-extrabold uppercase font-mono text-gray-400">POP de Referência (Wiki)</label>
                  <input type="text" name="pop" id="form-pop" value="<%= selectedNC ? selectedNC.pop : '' %>" placeholder="Ex: POP-HEM-01" class="mt-1.5 w-full bg-white border border-gray-200 rounded-xl py-2 px-3 text-xs focus:ring-2 focus:ring-brand-gold focus:outline-none font-mono">
                </div>
                <div>
                  <label class="text-[10px] font-extrabold uppercase font-mono text-gray-400">Fornecedor / Fabricante</label>
                  <input type="text" name="supplier" id="form-supplier" value="<%= selectedNC ? selectedNC.supplier : '' %>" placeholder="Ex: Roche Diagnostics" class="mt-1.5 w-full bg-white border border-gray-200 rounded-xl py-2 px-3 text-xs focus:ring-2 focus:ring-brand-gold focus:outline-none">
                </div>
              </div>

              <!-- Ações Extras de Relacionamento -->
              <div class="flex flex-wrap gap-2 pt-4 border-t border-gray-100">
                <button type="button" onclick="showRelationModal('Equipamento')" class="px-3 py-2 border border-[#284701] hover:bg-[#284701]/5 text-[#284701] font-mono font-bold rounded-lg text-xs cursor-pointer transition-colors">
                  + Relacionar Equipamento
                </button>
                <button type="button" onclick="showRelationModal('POP')" class="px-3 py-2 border border-[#284701] hover:bg-[#284701]/5 text-[#284701] font-mono font-bold rounded-lg text-xs cursor-pointer transition-colors">
                  + Relacionar POP
                </button>
                <button type="button" onclick="showRelationModal('Fornecedor')" class="px-3 py-2 border border-[#284701] hover:bg-[#284701]/5 text-[#284701] font-mono font-bold rounded-lg text-xs cursor-pointer transition-colors">
                  + Relacionar Fornecedor
                </button>
                <button type="button" onclick="triggerRecoleta()" class="px-3 py-2 bg-red-600 hover:bg-red-700 text-white font-mono font-bold rounded-lg text-xs cursor-pointer transition-colors ml-auto">
                  Criar Recoleta de Paciente
                </button>
              </div>
            </div>

            <!-- ABA 4: Impacto -->
            <div id="tab-content-impacto" class="tab-content hidden space-y-6">
              <div>
                <label class="text-[10px] font-extrabold uppercase font-mono text-gray-400">Partes Afetadas pelo Desvio (Seleção Múltipla)</label>
                <div class="grid grid-cols-2 md:grid-cols-5 gap-3 mt-2">
                  <% 
                    let affectedList = selectedNC && selectedNC.affected ? selectedNC.affected : [];
                  %>
                  <label class="flex items-center gap-2 p-3 border border-gray-100 rounded-xl hover:bg-gray-50 cursor-pointer text-xs font-semibold">
                    <input type="checkbox" name="affected" value="Paciente" <%= affectedList.includes('Paciente') ? 'checked' : '' %> class="rounded border-gray-300 text-brand-gold focus:ring-brand-gold">
                    <span>Paciente</span>
                  </label>
                  <label class="flex items-center gap-2 p-3 border border-gray-100 rounded-xl hover:bg-gray-50 cursor-pointer text-xs font-semibold">
                    <input type="checkbox" name="affected" value="Prazo" <%= affectedList.includes('Prazo') ? 'checked' : '' %> class="rounded border-gray-300 text-brand-gold focus:ring-brand-gold">
                    <span>Prazo (TAT)</span>
                  </label>
                  <label class="flex items-center gap-2 p-3 border border-gray-100 rounded-xl hover:bg-gray-50 cursor-pointer text-xs font-semibold">
                    <input type="checkbox" name="affected" value="Financeiro" <%= affectedList.includes('Financeiro') ? 'checked' : '' %> class="rounded border-gray-300 text-brand-gold focus:ring-brand-gold">
                    <span>Financeiro</span>
                  </label>
                  <label class="flex items-center gap-2 p-3 border border-gray-100 rounded-xl hover:bg-gray-50 cursor-pointer text-xs font-semibold">
                    <input type="checkbox" name="affected" value="Reputacional" <%= affectedList.includes('Reputacional') ? 'checked' : '' %> class="rounded border-gray-300 text-brand-gold focus:ring-brand-gold">
                    <span>Reputação</span>
                  </label>
                  <label class="flex items-center gap-2 p-3 border border-gray-100 rounded-xl hover:bg-gray-50 cursor-pointer text-xs font-semibold">
                    <input type="checkbox" name="affected" value="Qualidade" <%= affectedList.includes('Qualidade') ? 'checked' : '' %> class="rounded border-gray-300 text-brand-gold focus:ring-brand-gold">
                    <span>Qualidade</span>
                  </label>
                </div>
              </div>

              <div>
                <label class="text-[10px] font-extrabold uppercase font-mono text-gray-400">Descrição do Impacto e Mitigação Provisória</label>
                <textarea name="impactDescription" id="form-impactDescription" rows="5" placeholder="Descreva os danos causados (atrasos, cancelamento de teste, retrabalho) e quais ações mitigadoras foram adotadas de imediato para resguardar o paciente e o laboratório..." class="mt-1.5 w-full bg-white border border-gray-200 rounded-xl p-3 text-xs focus:ring-2 focus:ring-brand-gold focus:outline-none leading-relaxed"><%= selectedNC ? selectedNC.impactDescription : '' %></textarea>
              </div>
            </div>

            <!-- ABA 5: Evidências (Arquivos e Anexos) -->
            <div id="tab-content-evidencias" class="tab-content hidden space-y-6">
              <div class="border-2 border-dashed border-gray-200 hover:border-brand-gold transition-colors p-8 rounded-2xl text-center space-y-3 cursor-pointer relative" id="evidence-dropzone" onclick="simulateFileUpload()">
                <svg class="w-12 h-12 mx-auto text-gray-400 stroke-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>
                <div>
                  <p class="text-xs font-bold text-gray-700">Arraste e solte arquivos aqui, ou clique para selecionar</p>
                  <p class="text-[10px] text-gray-400 mt-1">Imagens de calibração, logs de erro TXT, laudos PDF afetados (Até 10MB)</p>
                </div>
                <input type="file" id="evidence-file-input" class="hidden" multiple>
              </div>

              <div class="space-y-3">
                <h4 class="text-[10px] font-extrabold uppercase font-mono text-gray-400">Evidências e Documentos Anexados</h4>
                <div class="divide-y divide-gray-100 border border-gray-100 rounded-xl" id="evidencias-list">
                  <% if (selectedNC && selectedNC.evidences && selectedNC.evidences.length > 0) { %>
                    <% selectedNC.evidences.forEach(function(ev, idx) { %>
                      <div class="p-3 flex justify-between items-center bg-gray-50/50 rounded-xl">
                        <div class="flex items-center gap-3">
                          <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                          <div>
                            <p class="text-xs font-bold text-gray-800"><%= ev.name %></p>
                            <p class="text-[10px] text-gray-400"><%= ev.size %> &bull; Anexado em <%= ev.date %></p>
                          </div>
                        </div>
                        <button type="button" onclick="deleteEvidence(<%= idx %>)" class="text-xs text-red-500 font-mono hover:underline">Remover</button>
                      </div>
                    <% }); %>
                  <% } else { %>
                    <div class="p-4 text-center text-gray-400 text-xs">
                      Nenhum anexo registrado como evidência física.
                    </div>
                  <% } %>
                </div>
              </div>
            </div>

            <!-- ABA 6: Análise da Causa Raiz -->
            <div id="tab-content-causa" class="tab-content hidden space-y-6">
              <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="md:col-span-1">
                  <label class="text-[10px] font-extrabold uppercase font-mono text-gray-400">Metodologia Utilizada</label>
                  <select name="causeAnalysisMethod" id="form-causeAnalysisMethod" class="mt-1.5 w-full bg-white border border-gray-200 rounded-xl py-2 px-3 text-xs focus:ring-2 focus:ring-brand-gold focus:outline-none">
                    <option value="5 Porquês" <%= selectedNC && selectedNC.causeAnalysisMethod === '5 Porquês' ? 'selected' : '' %>>5 Porquês (Recomendado)</option>
                    <option value="Diagrama de Ishikawa" <%= selectedNC && selectedNC.causeAnalysisMethod === 'Diagrama de Ishikawa' ? 'selected' : '' %>>Diagrama de Ishikawa (Espinha de Peixe)</option>
                    <option value="Análise de Pareto" <%= selectedNC && selectedNC.causeAnalysisMethod === 'Análise de Pareto' ? 'selected' : '' %>>Análise de Pareto</option>
                    <option value="Brainstorming" <%= selectedNC && selectedNC.causeAnalysisMethod === 'Brainstorming' ? 'selected' : '' %>>Brainstorming / Mapeamento</option>
                  </select>
                </div>
                <div class="md:col-span-2">
                  <span class="text-[10px] font-extrabold uppercase font-mono text-gray-400 block">Assistente de Qualidade IA</span>
                  <div class="flex gap-2 mt-1.5">
                    <button type="button" onclick="callGemini('suggest_cause')" class="px-3 py-1.5 bg-brand-dark hover:bg-[#1e350d] text-white rounded-lg text-xs font-mono font-bold cursor-pointer transition-colors active:scale-95 flex items-center gap-1">
                      Sugerir Causa Provável com IA
                    </button>
                    <button type="button" onclick="callGemini('generate_5whys')" class="px-3 py-1.5 bg-brand-dark hover:bg-[#1e350d] text-white rounded-lg text-xs font-mono font-bold cursor-pointer transition-colors active:scale-95 flex items-center gap-1">
                      Gerar Análise 5 Porquês com IA
                    </button>
                  </div>
                </div>
              </div>

              <div>
                <label class="text-[10px] font-extrabold uppercase font-mono text-gray-400 block">Investigação e Identificação da Causa Raiz</label>
                <textarea name="causeAnalysisRoot" id="form-causeAnalysisRoot" rows="8" placeholder="Ex: Por que ocorreu a falha? O controle falhou. Por que o controle falhou? O calibrador degradou... [Insira a investigação lógica que levou ao fator impeditivo primário]" class="mt-1.5 w-full bg-white border border-gray-200 rounded-xl p-3 text-xs focus:ring-2 focus:ring-brand-gold focus:outline-none leading-relaxed font-mono whitespace-pre-wrap"><%= selectedNC ? selectedNC.causeAnalysisRoot : '' %></textarea>
              </div>

              <!-- Painel de Output da Investigação da IA -->
              <div id="ai-cause-panel" class="hidden bg-gray-50 p-4 rounded-2xl border border-gray-100 space-y-2">
                <div class="flex justify-between items-center border-b border-gray-100 pb-1">
                  <span class="text-[10px] font-mono text-amber-700 font-bold">Investigação Estruturada do Gemini:</span>
                  <button type="button" onclick="applyAICauseResult()" class="text-[10px] text-emerald-600 font-bold hover:underline font-mono">Aplicar ao Campo de Análise</button>
                </div>
                <p id="ai-cause-text" class="text-xs text-gray-700 leading-relaxed italic whitespace-pre-wrap font-mono bg-white p-3 rounded-xl border border-gray-200"></p>
              </div>
            </div>

            <!-- ABA 7: Plano de Ação (CAPA) -->
            <div id="tab-content-plano" class="tab-content hidden space-y-6">
              <div class="flex justify-between items-center">
                <div>
                  <h4 class="text-xs font-extrabold uppercase font-mono text-gray-400">Plano de Ação Corretiva e Preventiva (CAPA)</h4>
                  <p class="text-[11px] text-gray-500">Adicione ações corretivas imediatas e de melhoria para prevenir novas ocorrências.</p>
                </div>
                <button type="button" onclick="addActionPlanRow()" class="px-3 py-1.5 bg-[#284701] hover:bg-[#1e350d] text-white text-xs font-mono font-bold rounded-lg cursor-pointer transition-colors active:scale-95">
                  + Adicionar Ação
                </button>
              </div>

              <!-- Barra de Progresso Dinâmica -->
              <div class="bg-gray-50 p-3 rounded-2xl border border-gray-100">
                <div class="flex justify-between text-xs font-bold font-mono text-gray-600 mb-1">
                  <span>Progresso do Plano de Ação:</span>
                  <span id="action-progress-label">0% Concluído</span>
                </div>
                <div class="w-full bg-gray-200 h-2.5 rounded-full overflow-hidden">
                  <div id="action-progress-bar" class="bg-emerald-500 h-full transition-all duration-300" style="width: 0%;"></div>
                </div>
              </div>

              <!-- Tabela de Ações Dinâmica -->
              <div class="overflow-x-auto border border-gray-100 rounded-2xl">
                <table class="w-full text-left text-xs divide-y divide-gray-100">
                  <thead class="bg-gray-50 text-gray-400 font-mono font-bold uppercase text-[9px] tracking-wider">
                    <tr>
                      <th class="p-3">Tipo</th>
                      <th class="p-3 w-1/3">Descrição da Ação</th>
                      <th class="p-3">Responsável</th>
                      <th class="p-3">Prazo</th>
                      <th class="p-3">Status</th>
                      <th class="p-3">Ações</th>
                    </tr>
                  </thead>
                  <tbody id="action-plan-rows" class="divide-y divide-gray-100">
                    <!-- Gerado Dinamicamente por Javascript -->
                  </tbody>
                </table>
              </div>
            </div>

            <!-- ABA 8: Verificação da Eficácia -->
            <div id="tab-content-eficacia" class="tab-content hidden space-y-6">
              <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                  <label class="text-[10px] font-extrabold uppercase font-mono text-gray-400">A Não Conformidade foi Resolvida?</label>
                  <select name="effectivenessResolved" id="form-effectivenessResolved" class="mt-1.5 w-full bg-white border border-gray-200 rounded-xl py-2 px-3 text-xs focus:ring-2 focus:ring-brand-gold focus:outline-none">
                    <option value="Sim" <%= selectedNC && selectedNC.effectivenessResolved === 'Sim' ? 'selected' : '' %>>Sim (Totalmente Solucionada)</option>
                    <option value="Não" <%= selectedNC && selectedNC.effectivenessResolved === 'Não' ? 'selected' : '' %>>Não (Medidas ineficazes)</option>
                    <option value="Parcialmente" <%= selectedNC && selectedNC.effectivenessResolved === 'Parcialmente' ? 'selected' : '' %>>Parcialmente (Aguardando monitoramento longo)</option>
                  </select>
                </div>
                <div>
                  <label class="text-[10px] font-extrabold uppercase font-mono text-gray-400">Houve Recorrência do Desvio?</label>
                  <select name="effectivenessRecurred" id="form-effectivenessRecurred" class="mt-1.5 w-full bg-white border border-gray-200 rounded-xl py-2 px-3 text-xs focus:ring-2 focus:ring-brand-gold focus:outline-none">
                    <option value="Não" <%= selectedNC && selectedNC.effectivenessRecurred === 'Não' ? 'selected' : '' %>>Não (Comportamento controlado)</option>
                    <option value="Sim" <%= selectedNC && selectedNC.effectivenessRecurred === 'Sim' ? 'selected' : '' %>>Sim (Houve nova falha idêntica)</option>
                  </select>
                </div>
                <div>
                  <label class="text-[10px] font-extrabold uppercase font-mono text-gray-400">Auditor / Responsável Verificação</label>
                  <input type="text" name="effectivenessResponsible" id="form-effectivenessResponsible" value="<%= selectedNC ? selectedNC.effectivenessResponsible : 'Dra. Sandra Regina Mendes' %>" class="mt-1.5 w-full bg-white border border-gray-200 rounded-xl py-2 px-3 text-xs focus:ring-2 focus:ring-brand-gold">
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="md:col-span-2">
                  <label class="text-[10px] font-extrabold uppercase font-mono text-gray-400">Análise do Auditor da Qualidade (Evidência Objetiva)</label>
                  <textarea name="effectivenessDescription" id="form-effectivenessDescription" rows="5" placeholder="Insira seu parecer técnico fundamentado sobre os resultados práticos obtidos após o encerramento do plano de ação..." class="mt-1.5 w-full bg-white border border-gray-200 rounded-xl p-3 text-xs focus:ring-2 focus:ring-brand-gold leading-relaxed"><%= selectedNC ? selectedNC.effectivenessDescription : '' %></textarea>
                </div>
                <div>
                  <label class="text-[10px] font-extrabold uppercase font-mono text-gray-400">Data de Verificação</label>
                  <input type="date" name="effectivenessDate" id="form-effectivenessDate" value="<%= selectedNC ? selectedNC.effectivenessDate : '' %>" class="mt-1.5 w-full bg-white border border-gray-200 rounded-xl py-2 px-3 text-xs focus:ring-2 focus:ring-brand-gold">
                </div>
              </div>
            </div>

            <!-- ABA 9: Encerramento / Homologação -->
            <div id="tab-content-encerramento" class="tab-content hidden space-y-6">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label class="text-[10px] font-extrabold uppercase font-mono text-gray-400">Diretor Técnico / Homologador</label>
                  <input type="text" name="closureResponsible" id="form-closureResponsible" value="<%= selectedNC ? selectedNC.closureResponsible : 'Dr. Carlos Eduardo Lima (Diretor Técnico)' %>" class="mt-1.5 w-full bg-white border border-gray-200 rounded-xl py-2 px-3 text-xs focus:ring-2 focus:ring-brand-gold">
                </div>
                <div>
                  <label class="text-[10px] font-extrabold uppercase font-mono text-gray-400">Data de Encerramento Oficial</label>
                  <input type="date" name="closureDate" id="form-closureDate" value="<%= selectedNC ? selectedNC.closureDate : '' %>" class="mt-1.5 w-full bg-white border border-gray-200 rounded-xl py-2 px-3 text-xs focus:ring-2 focus:ring-brand-gold">
                </div>
              </div>

              <div>
                <label class="text-[10px] font-extrabold uppercase font-mono text-gray-400">Parecer Final de Homologação</label>
                <textarea name="closureParecer" id="form-closureParecer" rows="5" placeholder="Parecer conclusivo da Diretoria de Qualidade atestando o restabelecimento da conformidade operacional..." class="mt-1.5 w-full bg-white border border-gray-200 rounded-xl p-3 text-xs focus:ring-2 focus:ring-brand-gold leading-relaxed"><%= selectedNC ? selectedNC.closureParecer : '' %></textarea>
              </div>

              <div>
                <label class="text-[10px] font-extrabold uppercase font-mono text-gray-400">Assinatura Digital / Chave de Validação do Diretor</label>
                <input type="text" name="closureSignature" id="form-closureSignature" value="<%= selectedNC ? selectedNC.closureSignature : 'Carlos Eduardo Lima - Diretor Técnico - CRBM/PR 4452' %>" placeholder="Ex: Carlos Eduardo Lima - Diretor Técnico - CRBM/PR 4452" class="mt-1.5 w-full bg-white border border-gray-200 rounded-xl py-2 px-3 text-xs focus:ring-2 focus:ring-brand-gold font-mono">
              </div>

              <div class="pt-4 border-t border-gray-100 flex gap-2">
                <button type="button" onclick="generateCAPADocument()" class="px-4 py-2.5 bg-brand-dark hover:bg-brand-neutralDark text-white text-xs font-mono font-bold rounded-xl cursor-pointer transition-colors active:scale-95 flex items-center gap-2">
                  <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
                  <span>Gerar Relatório CAPA para Impressão</span>
                </button>
              </div>
            </div>

            <!-- ABA 10: Histórico de Auditoria & Live Chat -->
            <div id="tab-content-historico" class="tab-content hidden grid grid-cols-1 lg:grid-cols-12 gap-6">
              
              <!-- Histórico de Auditoria (Esquerda / lg:col-span-6) -->
              <div class="lg:col-span-6 space-y-4">
                <span class="text-[10px] font-extrabold uppercase font-mono text-gray-400">Trilha de Auditoria (Histórico de Alterações)</span>
                <div class="space-y-4 border-l-2 border-gray-100 pl-4 relative" id="audit-trail-container">
                  <!-- Carregado por Javascript -->
                </div>
              </div>

              <!-- Live Chat Interno (Direita / lg:col-span-6) -->
              <div class="lg:col-span-6 flex flex-col h-[400px] border border-gray-100 rounded-2xl bg-gray-50/50 overflow-hidden">
                <div class="bg-white p-3 border-b border-gray-100 flex justify-between items-center">
                  <span class="text-[10px] font-extrabold uppercase font-mono text-[#284701]">Chat de Colaboração Técnica</span>
                  <span class="text-[9px] bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-full font-mono font-bold uppercase tracking-wider">Criptografado</span>
                </div>

                <!-- Corpo de Mensagens Chat -->
                <div class="flex-1 p-4 overflow-y-auto space-y-3" id="chat-messages-container">
                  <!-- Carregado por Javascript -->
                </div>

                <!-- Envio de Comentários -->
                <div class="p-3 bg-white border-t border-gray-100 flex gap-2">
                  <input type="text" id="chat-text-input" placeholder="Digite sua nota ou observação..." class="flex-1 bg-gray-50 border border-gray-200 rounded-xl py-2 px-3 text-xs focus:ring-2 focus:ring-brand-gold focus:outline-none focus:bg-white transition-all">
                  <button type="button" onclick="submitChatMessage()" class="px-3 bg-brand-dark hover:bg-brand-neutralDark text-white text-xs font-mono font-bold rounded-xl transition-colors cursor-pointer active:scale-95 flex items-center justify-center">
                    Enviar
                  </button>
                </div>
              </div>
            </div>

          </div>

          <!-- Barra de Ações do Rodapé do Formulário -->
          <div class="p-4 bg-gray-50 border-t border-gray-100 flex justify-between items-center shrink-0">
            <button type="button" onclick="deleteNC()" id="delete-nc-btn" class="px-4 py-2 bg-rose-50 hover:bg-rose-100 text-rose-700 text-xs font-mono font-bold rounded-xl transition-colors cursor-pointer <%= selectedNC ? '' : 'hidden' %>">
              Remover Registro
            </button>
            <div class="flex gap-2 ml-auto">
              <button type="button" onclick="window.location.reload()" class="px-4 py-2 border border-gray-200 text-gray-500 hover:bg-gray-100 text-xs font-mono font-bold rounded-xl transition-all cursor-pointer">
                Cancelar
              </button>
              <button type="submit" class="px-5 py-2 bg-[#284701] hover:bg-[#1e350d] text-white text-xs font-mono font-bold rounded-xl transition-all shadow shadow-[#284701]/10 hover:shadow-lg cursor-pointer">
                Salvar Alterações
              </button>
            </div>
          </div>

        </form>
      </div>

    </div>
  </div>

</div>

