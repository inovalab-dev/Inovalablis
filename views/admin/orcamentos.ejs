<script>
  // Dados de todos os orçamentos
  const budgetsData = <%- JSON.stringify(budgets) %>;
  const examsData = <%- JSON.stringify(exams) %>;
  const patientsData = <%- JSON.stringify(locals.patients || []) %>;
  const conveniosData = <%- JSON.stringify(locals.convenios || []) %>;
  const priceTablesData = <%- JSON.stringify(locals.priceTables || []) %>;

  function getExamPriceForBudgetConvenio(exam) {
    if (!exam) return 0;
    
    const currentConvName = (document.getElementById('form-convenio')?.value || 'Particular').trim();
    
    let conv = conveniosData.find(c => 
      (c.fantasia && c.fantasia.toLowerCase() === currentConvName.toLowerCase()) ||
      (c.razaoSocial && c.razaoSocial.toLowerCase() === currentConvName.toLowerCase())
    );

    if (!conv) {
      conv = conveniosData.find(c => (c.fantasia || c.razaoSocial || '').toLowerCase().includes('particular')) || conveniosData[0];
    }

    const tabelaId = conv ? conv.tabelaPrecoId : null;
    let priceTable = null;
    if (tabelaId) {
      priceTable = priceTablesData.find(pt => String(pt.id) === String(tabelaId));
    }
    if (!priceTable && priceTablesData.length > 0) {
      priceTable = priceTablesData[0];
    }

    if (!priceTable || !priceTable.precios) {
      return parseFloat(exam.pricePrivate || exam.price || 0);
    }

    const examCode = (exam.code || exam.codigo || '').toLowerCase();
    const examName = (exam.name || exam.nome || '').toLowerCase();
    const examId = (exam.id || '').toLowerCase();
    const examMat = (exam.material || exam.materialColetado || exam.materialNome || '').toLowerCase().trim();

    let priceItem = null;
    if (examMat) {
      priceItem = priceTable.precios.find(p => {
        const pCode = (p.exameCodigo || p.examCode || p.code || '').toLowerCase();
        const pName = (p.exameNome || p.examName || p.name || '').toLowerCase();
        const pId = (p.exameId || p.id || '').toLowerCase();
        const pMat = (p.material || '').toLowerCase().trim();

        const matchExam = (examCode && pCode === examCode) || (examId && pId === examId) || (examName && pName === examName);
        return matchExam && pMat === examMat;
      });
    }

    if (!priceItem) {
      priceItem = priceTable.precios.find(p => {
        const pCode = (p.exameCodigo || p.examCode || p.code || '').toLowerCase();
        const pName = (p.exameNome || p.examName || p.name || '').toLowerCase();
        const pId = (p.exameId || p.id || '').toLowerCase();
        return (examCode && pCode === examCode) || (examId && pId === examId) || (examName && pName === examName);
      });
    }

    if (priceItem && priceItem.valor !== undefined && priceItem.valor !== null && priceItem.valor !== '') {
      return parseFloat(priceItem.valor) || 0;
    }

    return parseFloat(exam.pricePrivate || exam.price || 0);
  }

  function recalculateBudgetExamPrices() {
    if (!addedExams || addedExams.length === 0) return;
    addedExams.forEach(item => {
      const match = examsData.find(e => e.id === item.id || (e.code && e.code.toLowerCase() === (item.code || '').toLowerCase()));
      item.price = getExamPriceForBudgetConvenio(match || item);
    });
    renderAddedExamsTable();
    calculateTotais();
  }

  // Lista local de exames adicionados na sessão de cadastro
  let addedExams = [];

  // Variáveis de Paginação (50 por página)
  const PAGE_SIZE = 50;
  let currentPage = 1;
  let filteredBudgets = [...budgetsData];

  document.addEventListener('DOMContentLoaded', () => {
    renderPagination();
  });

  // TGL Formulário de Cadastro (Collapse Fechado por Padrão)
  function toggleRegistrationForm(forceOpen = null) {
    const card = document.getElementById('novo-orcamento-card');
    const toggleText = document.getElementById('collapse-toggle-text');
    const historico = document.getElementById('historico-secao');

    let shouldShow = forceOpen !== null ? forceOpen : card.classList.contains('hidden');

    if (shouldShow) {
      card.classList.remove('hidden');
      if (historico) historico.classList.add('hidden');
      if (toggleText) toggleText.textContent = 'Ocultar ▲';
      card.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } else {
      card.classList.add('hidden');
      if (historico) historico.classList.remove('hidden');
      if (toggleText) toggleText.textContent = 'Expandir ▼';
    }
  }

  // TGL Dados do Paciente dentro do Form
  function togglePatientDataSection() {
    const panel = document.getElementById('patient-data-panel');
    const icon = document.getElementById('patient-data-toggle-icon');

    if (panel.classList.contains('hidden')) {
      panel.classList.remove('hidden');
      icon.textContent = '▲';
    } else {
      panel.classList.add('hidden');
      icon.textContent = '▼';
    }
  }

  // Limpar/Resetar Form de Cadastro
  function resetBudgetForm() {
    addedExams = [];
    renderAddedExamsTable();
    if (document.getElementById('form-originalId')) document.getElementById('form-originalId').value = '';
    const heading = document.getElementById('form-title-heading');
    if (heading) heading.textContent = 'Cadastro de Novo Orçamento';
    document.getElementById('form-codigo').value = 'ORC' + Date.now().toString().slice(-6);
    if (document.getElementById('exam-code-field')) document.getElementById('exam-code-field').value = '';
    document.getElementById('exam-search-field').value = '';
    document.getElementById('form-patientName').value = '';
    if (document.getElementById('form-solicitante')) document.getElementById('form-solicitante').value = '';
    document.getElementById('form-patientPhone').value = '';
    if (document.getElementById('form-patientEmail')) document.getElementById('form-patientEmail').value = '';
    if (document.getElementById('form-contatoNome')) document.getElementById('form-contatoNome').value = '';
    if (document.getElementById('form-contatoFone')) document.getElementById('form-contatoFone').value = '';
    if (document.getElementById('form-conselhoTipo')) document.getElementById('form-conselhoTipo').value = 'CRM';
    if (document.getElementById('form-conselhoNum')) document.getElementById('form-conselhoNum').value = '';
    if (document.getElementById('form-conselhoUf')) document.getElementById('form-conselhoUf').value = 'PR';
    document.getElementById('form-doctorName').value = '';
    document.getElementById('form-patientCpf').value = '';
    document.getElementById('form-convenio').value = 'Particular';
    document.getElementById('form-acrescimo').value = '0.00';
    document.getElementById('form-desconto').value = '0.00';
    document.getElementById('form-observation').value = '';
