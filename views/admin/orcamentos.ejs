<%- include('../partials/header', { page: 'admin' }) %>

<style>
@media print {
  body > *:not(#print-modal),
  #print-modal > *:not(.bg-white),
  #print-modal .bg-white > *:not(#modal-print-content) {
    display: none !important;
  }

  #print-modal {
    position: absolute !important;
    left: 0 !important;
    top: 0 !important;
    width: 100% !important;
    height: auto !important;
    display: block !important;
    background: white !important;
    border: none !important;
    box-shadow: none !important;
    overflow: visible !important;
    padding: 0 !important;
    margin: 0 !important;
    z-index: 99999 !important;
  }

  #print-modal > .bg-white {
    width: 100% !important;
    max-width: 100% !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
    margin: 0 !important;
    background: white !important;
    display: block !important;
  }

  #modal-print-content {
    display: block !important;
    width: 100% !important;
    padding: 20px !important;
    margin: 0 !important;
    border: none !important;
    box-shadow: none !important;
    background: white !important;
  }

  * {
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
  }
}
</style>

<!-- Cabeçalho de Navegação Superior -->
<section class="bg-brand-softBg/30 border-b border-brand-light/15 py-5">
  <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div class="space-y-1">
      <div class="flex items-center gap-2 text-xs font-semibold text-gray-500">
        <a href="/admin" class="hover:text-brand-dark transition-colors">Administração</a>
        <span>&rsaquo;</span>
        <span class="text-brand-dark font-bold font-mono uppercase text-[10px]">Recepção e Atendimento</span>
      </div>
      <h1 class="text-2xl font-extrabold text-brand-dark tracking-tight flex items-center gap-2">
        <svg class="w-7 h-7 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        Orçamentos
      </h1>
      <p class="text-xs text-gray-500">Orçamento de exames por convênios e emissão de fichas de preparo</p>
    </div>
    
    <div class="flex items-center gap-3">
      <a href="/admin" class="text-xs font-bold bg-white hover:bg-brand-softBg text-brand-dark px-4 py-2.5 rounded-xl border border-brand-light/20 transition-all flex items-center space-x-1.5 cursor-pointer shadow-sm">
        <span>Voltar ao Painel</span>
      </a>
      <button onclick="toggleRegistrationForm(true)" class="text-xs font-bold bg-brand-dark hover:bg-brand-light text-white px-4 py-2.5 rounded-xl transition-all shadow-md flex items-center gap-1.5 cursor-pointer">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
        <span>Novo Orçamento</span>
      </button>
    </div>
  </div>
</section>

<section class="py-8 bg-brand-neutralLight/45 min-h-screen">
  <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 space-y-8">

    <!-- PAINEL DE CADASTRO DE ORÇAMENTO (COLLAPSE FECHADO POR PADRÃO) -->
    <div id="novo-orcamento-card" class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden hidden transition-all duration-300">
      
      <!-- Cabeçalho do Collapse -->
      <div onclick="toggleRegistrationForm()" class="px-6 py-4 bg-gray-50 border-b border-gray-200 flex items-center justify-between cursor-pointer hover:bg-gray-100/80 transition-colors select-none">
        <div class="flex items-center gap-3">
          <div class="p-2 bg-emerald-100 text-emerald-800 rounded-lg">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
          </div>
          <div>
            <h2 class="text-sm font-bold text-gray-900 font-mono uppercase tracking-wider" id="form-title-heading">Cadastro de Novo Orçamento</h2>
            <p class="text-[11px] text-gray-500">Preencha os exames e dados para gerar a proposta comercial e ficha de instrução</p>
          </div>
        </div>
        <button type="button" class="text-gray-500 hover:text-gray-800 font-bold text-sm flex items-center gap-1 font-mono">
          <span id="collapse-toggle-text">Ocultar ▲</span>
        </button>
      </div>

      <!-- Form de Cadastro -->
      <form action="/admin/orcamentos/add" method="POST" id="budget-form" onsubmit="prepareFormSubmission(event)" class="p-6 space-y-6">
        <input type="hidden" name="originalId" id="form-originalId" value="">
        <input type="hidden" name="examsJson" id="hidden-exams-json">

        <!-- Linha Superior: Código, Data, Usuário -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pb-4 border-b border-gray-100 bg-gray-50/50 p-4 rounded-xl border">
          <div>
            <label class="block text-xs font-bold text-gray-700 font-mono uppercase mb-1">Código:</label>
            <input type="text" name="codigo" id="form-codigo" readonly value="ORC<%= Date.now().toString().slice(-6) %>" class="w-full px-3 py-2 bg-gray-100 border border-gray-300 rounded-lg text-xs font-mono font-bold text-gray-800">
          </div>
          <div>
            <label class="block text-xs font-bold text-gray-700 font-mono uppercase mb-1">Data:</label>
            <input type="date" name="data" id="form-data" value="<%= new Date().toISOString().split('T')[0] %>" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-xs font-mono font-bold text-gray-800 focus:ring-2 focus:ring-emerald-500 outline-none">
          </div>
          <div>
            <label class="block text-xs font-bold text-gray-700 font-mono uppercase mb-1">Usuário:</label>
            <input type="text" name="usuario" id="form-usuario" readonly value="<%= adminUserName || 'Administrador' %>" class="w-full px-3 py-2 bg-gray-100 border border-gray-300 rounded-lg text-xs font-mono font-bold text-gray-800">
          </div>
        </div>

        <!-- Seção Dobrável: Dados do Paciente (MOVIDO PARA CIMA) -->
        <div class="border border-gray-200 rounded-xl overflow-hidden bg-white shadow-sm">
          <button type="button" onclick="togglePatientDataSection()" class="w-full px-4 py-2.5 bg-gray-50 hover:bg-gray-100 text-left font-bold text-xs font-mono text-gray-800 uppercase flex items-center justify-between border-b border-gray-200 cursor-pointer">
            <span class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
              Dados do paciente
            </span>
            <span id="patient-data-toggle-icon" class="text-xs font-bold text-gray-500">▲</span>
          </button>

          <div id="patient-data-panel" class="p-4 space-y-3 bg-white">
            
            <!-- Linha 1: Paciente + Busca -->
            <div class="flex flex-col sm:flex-row sm:items-center gap-2">
              <label class="w-24 text-xs font-bold text-gray-700 font-mono uppercase shrink-0">Paciente:</label>
              <div class="flex-1 flex items-center gap-1">
                <input type="text" name="patientName" id="form-patientName" placeholder="Nome do paciente" class="w-full px-3 py-1.5 bg-gray-50 border border-gray-300 rounded-lg text-xs font-medium focus:ring-2 focus:ring-emerald-500 focus:bg-white outline-none">
                <button type="button" onclick="openPatientSearchModal()" class="px-3 py-1.5 bg-brand-gold hover:bg-brand-gold/90 text-brand-dark font-bold rounded-lg text-xs transition-all flex items-center justify-center shrink-0 cursor-pointer" title="Buscar Paciente Cadastrado">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                </button>
              </div>
            </div>

            <!-- Linha 2: Solicitante -->
            <div class="flex flex-col sm:flex-row sm:items-center gap-2">
              <label class="w-24 text-xs font-bold text-gray-700 font-mono uppercase shrink-0">Solicitante:</label>
              <input type="text" name="solicitante" id="form-solicitante" placeholder="Nome do solicitante / instituição" class="w-full px-3 py-1.5 bg-gray-50 border border-gray-300 rounded-lg text-xs font-medium focus:ring-2 focus:ring-emerald-500 focus:bg-white outline-none">
            </div>

            <!-- Linha 3: Fone & E-mail -->
            <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 items-center">
              <div class="sm:col-span-5 flex items-center gap-2">
                <label class="w-24 text-xs font-bold text-gray-700 font-mono uppercase shrink-0">Fone:</label>
                <input type="text" name="patientPhone" id="form-patientPhone" placeholder="(  ) - " class="w-full px-3 py-1.5 bg-gray-50 border border-gray-300 rounded-lg text-xs font-mono focus:ring-2 focus:ring-emerald-500 focus:bg-white outline-none">
              </div>
              <div class="sm:col-span-7 flex items-center gap-2">
                <label class="w-16 text-xs font-bold text-gray-700 font-mono uppercase shrink-0 sm:text-right">E-mail:</label>
                <input type="email" name="patientEmail" id="form-patientEmail" placeholder="email@exemplo.com" class="w-full px-3 py-1.5 bg-gray-50 border border-gray-300 rounded-lg text-xs font-medium focus:ring-2 focus:ring-emerald-500 focus:bg-white outline-none">
              </div>
            </div>

            <!-- Linha 4: Contato & Fone -->
            <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 items-center">
              <div class="sm:col-span-7 flex items-center gap-2">
                <label class="w-24 text-xs font-bold text-gray-700 font-mono uppercase shrink-0">Contato:</label>
                <input type="text" name="contatoNome" id="form-contatoNome" placeholder="Nome do contato responsável" class="w-full px-3 py-1.5 bg-gray-50 border border-gray-300 rounded-lg text-xs font-medium focus:ring-2 focus:ring-emerald-500 focus:bg-white outline-none">
              </div>
              <div class="sm:col-span-5 flex items-center gap-2">
                <label class="w-16 text-xs font-bold text-gray-700 font-mono uppercase shrink-0 sm:text-right">Fone:</label>
                <input type="text" name="contatoFone" id="form-contatoFone" placeholder="(  ) - " class="w-full px-3 py-1.5 bg-gray-50 border border-gray-300 rounded-lg text-xs font-mono focus:ring-2 focus:ring-emerald-500 focus:bg-white outline-none">
              </div>
            </div>

            <!-- Linha 5: Médico (Conselho, N°, UF, Lupa, Nome) -->
            <div class="flex flex-col sm:flex-row sm:items-center gap-2">
              <label class="w-24 text-xs font-bold text-gray-700 font-mono uppercase shrink-0">Médico:</label>
              <div class="flex-1 flex flex-wrap sm:flex-nowrap items-center gap-2">
                <select name="conselhoTipo" id="form-conselhoTipo" class="px-2.5 py-1.5 bg-gray-50 border border-gray-300 rounded-lg text-xs font-bold text-gray-800 outline-none focus:ring-2 focus:ring-emerald-500 cursor-pointer">
                  <option value="CRM">CRM</option>
                  <option value="CRO">CRO</option>
                  <option value="CRMV">CRMV</option>
                  <option value="COREN">COREN</option>
                  <option value="CRF">CRF</option>
                  <option value="OUTRO">OUTRO</option>
                </select>
                <input type="text" name="conselhoNum" id="form-conselhoNum" placeholder="Nº Conselho" class="w-28 px-3 py-1.5 bg-gray-50 border border-gray-300 rounded-lg text-xs font-mono font-bold focus:ring-2 focus:ring-emerald-500 focus:bg-white outline-none">
                <select name="conselhoUf" id="form-conselhoUf" class="px-2.5 py-1.5 bg-gray-50 border border-gray-300 rounded-lg text-xs font-bold text-gray-800 outline-none focus:ring-2 focus:ring-emerald-500 cursor-pointer">
                  <option value="PR">PR</option>
                  <option value="SP">SP</option>
                  <option value="SC">SC</option>
                  <option value="RS">RS</option>
                  <option value="RJ">RJ</option>
                  <option value="MG">MG</option>
                  <option value="MS">MS</option>
                  <option value="MT">MT</option>
                  <option value="GO">GO</option>
                  <option value="DF">DF</option>
                  <option value="OUTRO">UF</option>
                </select>
                <button type="button" onclick="openDoctorSearchModal()" class="px-3 py-1.5 bg-brand-gold hover:bg-brand-gold/90 text-brand-dark font-bold rounded-lg text-xs transition-all flex items-center justify-center shrink-0 cursor-pointer" title="Buscar Médico Solicitante">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                </button>
                <input type="text" name="doctorName" id="form-doctorName" placeholder="Nome do médico" class="flex-1 min-w-[200px] px-3 py-1.5 bg-gray-50 border border-gray-300 rounded-lg text-xs font-medium focus:ring-2 focus:ring-emerald-500 focus:bg-white outline-none">
              </div>
            </div>

            <!-- Linha Complementar: CPF e Convênio -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2 border-t border-gray-100">
              <div class="flex items-center gap-2">
                <label class="w-24 text-xs font-bold text-gray-700 font-mono uppercase shrink-0">CPF:</label>
                <input type="text" name="patientCpf" id="form-patientCpf" placeholder="000.000.000-00" class="w-full px-3 py-1.5 bg-gray-50 border border-gray-300 rounded-lg text-xs font-mono focus:ring-2 focus:ring-emerald-500 focus:bg-white outline-none">
              </div>
              <div class="flex items-center gap-2">
                <label class="w-20 text-xs font-bold text-gray-700 font-mono uppercase shrink-0 sm:text-right">Convênio:</label>
                <select name="convenio" id="form-convenio" onchange="recalculateBudgetExamPrices()" class="w-full px-3 py-1.5 bg-emerald-50/50 border border-emerald-300 rounded-lg text-xs font-bold text-slate-900 focus:ring-2 focus:ring-emerald-500 focus:bg-white outline-none cursor-pointer">
                  <option value="Particular">Particular</option>
                  <% (typeof convenios !== 'undefined' ? convenios : []).forEach(c => { %>
                    <option value="<%= c.fantasia || c.razaoSocial %>"><%= c.codigo ? '[' + c.codigo + '] ' : '' %><%= c.fantasia || c.razaoSocial %></option>
                  <% }) %>
                </select>
              </div>
            </div>

          </div>
        </div>

        <!-- Seletor Rápido de Exame & Material -->
        <div class="bg-gray-50 border border-gray-200 rounded-xl p-4 space-y-3">
          <div class="text-xs font-bold text-gray-800 font-mono uppercase tracking-wider flex items-center gap-1.5">
            <span>🔍 Adicionar Exames ao Orçamento</span>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-12 gap-3 items-end">
            <!-- Cód. Exame -->
            <div class="md:col-span-3">
              <label class="block text-[11px] font-bold text-gray-600 mb-1">Cód. Exame:</label>
              <input type="text" id="exam-code-field" oninput="onExamCodeInput()" onkeydown="handleExamInputKeydown(event)" placeholder="Código (ex: HEM)..." class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-xs font-mono font-bold focus:ring-2 focus:ring-emerald-500 outline-none uppercase">
            </div>

            <!-- Input com Datalist do Exame -->
            <div class="md:col-span-5">
              <label class="block text-[11px] font-bold text-gray-600 mb-1">Nome / Descrição do Exame:</label>
              <div class="relative">
                <input type="text" id="exam-search-field" list="exams-datalist" oninput="onExamNameInput()" onkeydown="handleExamInputKeydown(event)" placeholder="Digite ou selecione o exame..." class="w-full pl-9 pr-3 py-2 bg-white border border-gray-300 rounded-lg text-xs font-semibold focus:ring-2 focus:ring-emerald-500 outline-none">
                <svg class="w-4 h-4 text-gray-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
              </div>
              <datalist id="exams-datalist">
                <% exams.forEach(e => { %>
                  <option value="<%= e.code ? e.code + ' - ' : '' %><%= e.name %>" data-id="<%= e.id %>" data-name="<%= e.name %>" data-code="<%= e.code || '' %>" data-price="<%= e.pricePrivate || 0 %>" data-material="<%= e.material || 'Soro' %>" data-fasting="<%= e.fasting || 'Sem jejum' %>" data-timeframe="<%= e.timeframe || '1 dia útil' %>" data-instructions="<%= e.instructions || '' %>">
                <% }) %>
              </datalist>
            </div>

            <!-- Material Dropdown -->
            <div class="md:col-span-2">
              <label class="block text-[11px] font-bold text-gray-600 mb-1">Material:</label>
              <select id="exam-material-field" class="w-full px-2.5 py-2 bg-white border border-gray-300 rounded-lg text-xs font-semibold focus:ring-2 focus:ring-emerald-500 outline-none">
                <option value="Soro">Soro (S)</option>
                <option value="Plasma">Plasma (P)</option>
                <option value="Sangue Total">Sangue Total (ST)</option>
                <option value="Urina">Urina (U)</option>
                <option value="Fezes">Fezes (FZ)</option>
                <option value="Líquor">Líquor (LQ)</option>
                <option value="Swab">Swab (SW)</option>
                <option value="Saliva">Saliva (SL)</option>
                <option value="Outro">Outro</option>
              </select>
            </div>

            <!-- Botão OK -->
            <div class="md:col-span-2 flex items-end">
              <button type="button" onclick="addSelectedExam()" class="w-full py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs uppercase tracking-wider rounded-lg shadow transition-all flex items-center justify-center gap-1 cursor-pointer">
                <span>OK</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Tabela de Exames Adicionados ao Orçamento -->
        <div class="border border-gray-200 rounded-xl overflow-hidden bg-white shadow-sm">
          <table class="w-full text-left border-collapse" id="budget-items-table">
            <thead>
              <tr class="bg-gray-100 border-b border-gray-200 text-[11px] font-bold text-gray-600 uppercase font-mono">
                <th class="py-2.5 px-3 w-12 text-center">#</th>
                <th class="py-2.5 px-3 w-28">Código</th>
                <th class="py-2.5 px-3">Exame</th>
                <th class="py-2.5 px-3 w-28">Mat.</th>
                <th class="py-2.5 px-3 w-28 text-right">Valor (R$)</th>
                <th class="py-2.5 px-3 w-16 text-center">Ação</th>
              </tr>
            </thead>
            <tbody id="budget-items-tbody" class="divide-y divide-gray-100 text-xs font-medium">
              <tr id="empty-exams-row">
                <td colspan="6" class="py-8 text-center text-gray-400 font-mono text-xs">
                  Nenhum exame adicionado ao orçamento ainda. Selecione um exame acima e clique em OK.
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Ajustes Financeiros: Acréscimo, Desconto, Validade, Observação -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-start bg-gray-50 p-4 rounded-xl border border-gray-200">
          <!-- Acréscimo -->
          <div class="md:col-span-3">
            <label class="block text-[11px] font-bold text-gray-700 mb-1 font-mono uppercase">Acréscimo:</label>
            <div class="flex items-center gap-1">
              <input type="number" step="0.01" name="acrescimo" id="form-acrescimo" value="0.00" oninput="calculateTotais()" class="w-full px-2.5 py-1.5 bg-white border border-gray-300 rounded-lg text-xs font-mono font-bold text-gray-800 focus:ring-2 focus:ring-emerald-500 outline-none">
              <select name="tipoAcrescimo" id="form-tipoAcrescimo" onchange="calculateTotais()" class="px-2 py-1.5 bg-white border border-gray-300 rounded-lg text-xs font-bold">
                <option value="R$">R$</option>
                <option value="%">%</option>
              </select>
            </div>
          </div>

          <!-- Desconto -->
          <div class="md:col-span-3">
            <label class="block text-[11px] font-bold text-gray-700 mb-1 font-mono uppercase">Desconto:</label>
            <div class="flex items-center gap-1">
              <input type="number" step="0.01" name="desconto" id="form-desconto" value="0.00" oninput="calculateTotais()" class="w-full px-2.5 py-1.5 bg-white border border-gray-300 rounded-lg text-xs font-mono font-bold text-gray-800 focus:ring-2 focus:ring-emerald-500 outline-none">
              <select name="tipoDesconto" id="form-tipoDesconto" onchange="calculateTotais()" class="px-2 py-1.5 bg-white border border-gray-300 rounded-lg text-xs font-bold">
                <option value="R$">R$</option>
                <option value="%">%</option>
              </select>
            </div>
          </div>

          <!-- Validade -->
          <div class="md:col-span-3">
            <label class="block text-[11px] font-bold text-gray-700 mb-1 font-mono uppercase">Validade:</label>
            <div class="relative">
              <input type="text" name="validade" id="form-validade" value="30 dias" class="w-full pr-8 px-3 py-1.5 bg-white border border-gray-300 rounded-lg text-xs font-mono font-bold text-gray-800 focus:ring-2 focus:ring-emerald-500 outline-none">
              <span class="absolute right-2 top-2 text-gray-400 text-xs">🔍</span>
            </div>
          </div>

          <!-- Total Geral Resumo -->
          <div class="md:col-span-3 text-right bg-white p-2.5 rounded-lg border border-gray-300 shadow-sm">
            <span class="block text-[10px] font-bold text-gray-500 uppercase font-mono">Valor Total Líquido:</span>
            <span class="text-lg font-black text-emerald-800 font-mono" id="form-total-display">R$ 0,00</span>
          </div>

          <!-- Observação -->
          <div class="md:col-span-12">
            <label class="block text-[11px] font-bold text-gray-700 mb-1 font-mono uppercase">Observação:</label>
            <textarea name="observation" id="form-observation" rows="2" placeholder="Observações do orçamento (ex: Validade 30 dias, trazer pedido médico na coleta)..." class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-xs font-medium focus:ring-2 focus:ring-emerald-500 outline-none"></textarea>
          </div>
        </div>

        <!-- Opções & Legenda -->
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 pt-2">
          <div class="space-y-1 text-xs text-gray-600">
            <label class="flex items-center gap-2 cursor-pointer font-medium">
              <input type="checkbox" checked class="rounded text-emerald-600 focus:ring-emerald-500">
              <span>Mostrar valores para todos os convênios</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer font-medium">
              <input type="checkbox" checked class="rounded text-emerald-600 focus:ring-emerald-500">
              <span>Carregar exames de agrupamento</span>
            </label>
          </div>

          <!-- Legenda de Cores -->
          <div class="flex flex-wrap items-center gap-3 text-[11px] font-semibold text-gray-600">
            <span class="flex items-center gap-1">
              <span class="w-3 h-3 bg-rose-600 inline-block rounded-xs"></span>
              Exame com desconto
            </span>
            <span class="flex items-center gap-1">
              <span class="w-3 h-3 bg-emerald-600 inline-block rounded-xs"></span>
              Exame com acréscimo
            </span>
            <span class="flex items-center gap-1">
              <span class="w-3 h-3 bg-blue-600 inline-block rounded-xs"></span>
              Exame possui instrução de coleta
            </span>
          </div>
        </div>

        <!-- Barra de Botões de Ação do Cadastro -->
        <div class="pt-4 border-t border-gray-200 flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto">
            <button type="button" onclick="alert('Funcionalidade de opções estendidas de impressão.')" class="px-3 py-2 bg-gray-100 hover:bg-gray-200 text-gray-800 font-bold text-xs rounded-lg border border-gray-300 flex items-center gap-1 cursor-pointer">
              <span>Imprimir ▼</span>
            </button>
            <button type="button" onclick="alert('Menu de opções avançadas de orçamento.')" class="px-3 py-2 bg-gray-100 hover:bg-gray-200 text-gray-800 font-bold text-xs rounded-lg border border-gray-300 flex items-center gap-1 cursor-pointer">
              <span>Opções ▼</span>
            </button>
            <button type="button" onclick="convertToRequision()" class="px-3 py-2 bg-sky-50 hover:bg-sky-100 text-sky-800 font-bold text-xs rounded-lg border border-sky-200 cursor-pointer">
              Requisição (OS)
            </button>
            <button type="button" onclick="alert('Orçamento Aprovado com Sucesso!')" class="px-3 py-2 bg-emerald-50 hover:bg-emerald-100 text-emerald-800 font-bold text-xs rounded-lg border border-emerald-200 cursor-pointer">
              Aprovar
            </button>
          </div>

          <!-- Botões Principais de Salvar / Cancelar / Fechar -->
          <div class="flex items-center gap-2 w-full sm:w-auto justify-end">
            <button type="button" onclick="resetBudgetForm()" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold text-xs rounded-lg border border-gray-300 cursor-pointer">
              Novo
            </button>
            <button type="submit" class="px-5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-lg shadow-md transition-all cursor-pointer">
              Salvar
            </button>
            <button type="button" onclick="toggleRegistrationForm(false)" class="px-4 py-2 bg-rose-50 hover:bg-rose-100 text-rose-700 font-bold text-xs rounded-lg border border-rose-200 cursor-pointer">
              Cancelar
            </button>
            <button type="button" onclick="toggleRegistrationForm(false)" class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold text-xs rounded-lg cursor-pointer">
              Fechar
            </button>
          </div>
        </div>

      </form>
    </div>

    <!-- TABELA HISTÓRICO DE ORÇAMENTOS (PAGINADA DE 50 EM 50) -->
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden" id="historico-secao">
      
      <!-- Cabeçalho e Busca -->
      <div class="px-6 py-5 border-b border-gray-200 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-gray-50/60">
        <div>
          <h2 class="text-sm font-bold text-gray-900 font-mono uppercase tracking-wider flex items-center gap-2">
            <span>📋 Orçamentos Emitidos</span>
            <span class="px-2 py-0.5 bg-gray-200 text-gray-700 text-[10px] rounded-full font-mono font-bold" id="total-budgets-count"><%= budgets.length %> registros</span>
          </h2>
          <p class="text-[11px] text-gray-500 mt-0.5">Listagem paginada de 50 em 50 orçamentos. Use o filtro para buscar por paciente ou número.</p>
        </div>

        <div class="flex items-center gap-3 w-full sm:w-auto">
          <div class="relative w-full sm:w-72">
            <input type="text" id="budget-search-input" onkeyup="filterBudgetsWithPagination()" placeholder="Buscar por paciente ou código..." class="w-full pl-9 pr-3 py-2 rounded-xl border border-gray-300 text-xs font-medium focus:ring-2 focus:ring-emerald-500 outline-none">
            <svg class="w-4 h-4 text-gray-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          </div>
        </div>
      </div>

      <!-- Tabela -->
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse" id="budgets-table">
          <thead>
            <tr class="bg-gray-100 text-gray-700 border-b border-gray-200 text-[11px] font-bold uppercase tracking-wider font-mono">
              <th class="px-6 py-3.5">Código / Data</th>
              <th class="px-6 py-3.5">Paciente</th>
              <th class="px-6 py-3.5">Médico / Convênio</th>
              <th class="px-6 py-3.5">Exames</th>
              <th class="px-6 py-3.5 text-right">Valor Total</th>
              <th class="px-6 py-3.5">Status</th>
              <th class="px-6 py-3.5 text-center">Ações</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 text-xs" id="budgets-table-tbody">
            <% budgets.forEach((req, idx) => { %>
              <tr class="hover:bg-gray-50 transition-colors budget-row" data-name="<%= (req.patientName || '').toLowerCase() %>" data-id="<%= (req.id || '').toLowerCase() %>" data-index="<%= idx %>">
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="font-bold text-gray-900 font-mono text-[11px]"><%= req.id %></div>
                  <div class="text-[10px] text-gray-400 mt-0.5 font-mono"><%= req.createdAt || req.date %></div>
                </td>
                <td class="px-6 py-4">
                  <div class="font-bold text-gray-900 text-sm"><%= req.patientName %></div>
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[10px] text-gray-500 mt-1 font-mono">
                    <% if (req.patientCpf) { %>
                      <span>CPF: <%= req.patientCpf %></span>
                    <% } %>
                    <% if (req.patientPhone) { %>
                      <span>Cel: <%= req.patientPhone %></span>
                    <% } %>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="font-medium text-gray-800"><%= req.doctorName || 'Não Informado' %></div>
                  <div class="text-[10px] bg-emerald-50 text-emerald-800 border border-emerald-200 px-2 py-0.5 rounded-md inline-block font-mono mt-1 font-bold uppercase"><%= req.convenio || 'Particular' %></div>
                </td>
                <td class="px-6 py-4">
                  <div class="max-w-xs truncate" title="<%= (req.exams || []).map(e => e.name).join(', ') %>">
                    <span class="font-semibold text-gray-900"><%= (req.exams || []).length %> exames:</span>
                    <span class="text-gray-500 text-[11px]"><%= (req.exams || []).map(e => e.name).join(', ') %></span>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right font-mono font-bold text-emerald-800 text-sm">
                  R$ <%= (req.totalPrice || 0).toFixed(2).replace('.', ',') %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <select onchange="updateBudgetStatus('<%= req.id %>', this.value)" class="text-[11px] font-bold px-2.5 py-1 rounded-lg border border-gray-300 focus:outline-none focus:ring-1 focus:ring-emerald-500 transition-all bg-white
                    <%= req.status === 'Pronto' ? 'text-emerald-700 border-emerald-300 bg-emerald-50' : 
                        req.status === 'Coletado' ? 'text-blue-700 border-blue-300 bg-blue-50' : 
                        req.status === 'Em Processamento' ? 'text-amber-700 border-amber-300 bg-amber-50' : 
                        'text-gray-700 border-gray-300 bg-gray-50' %>">
                    <option value="Aguardando Coleta" <%= req.status === 'Aguardando Coleta' ? 'selected' : '' %>>Aguardando Coleta</option>
                    <option value="Coletado" <%= req.status === 'Coletado' ? 'selected' : '' %>>Coletado</option>
                    <option value="Em Processamento" <%= req.status === 'Em Processamento' ? 'selected' : '' %>>Em Processamento</option>
                    <option value="Pronto" <%= req.status === 'Pronto' ? 'selected' : '' %>>Pronto / Concluído</option>
                  </select>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-center">
                  <div class="flex items-center justify-center gap-1.5">
                    <!-- Editar -->
                    <button type="button" onclick="editBudget('<%= req.id %>')" class="p-2 bg-amber-50 hover:bg-amber-600 hover:text-white text-amber-700 rounded-lg transition-all cursor-pointer" title="Editar Orçamento">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                    </button>
                    <!-- Botão de Visualização / Impressão -->
                    <button type="button" onclick="openPrintModal('<%= req.id %>')" class="p-2 bg-gray-100 hover:bg-emerald-600 hover:text-white text-gray-700 rounded-lg transition-all cursor-pointer" title="Visualizar & Imprimir Ficha">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
                    </button>
                    <!-- Excluir -->
                    <form action="/admin/orcamentos/delete" method="POST" onsubmit="return confirm('Deseja realmente excluir este orçamento?')" class="inline m-0">
                      <input type="hidden" name="id" value="<%= req.id %>">
                      <button type="submit" class="p-2 bg-rose-50 text-rose-600 hover:bg-rose-600 hover:text-white rounded-lg transition-all cursor-pointer" title="Excluir Orçamento">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>

            <% if (budgets.length === 0) { %>
              <tr id="empty-budgets-row">
                <td colspan="7" class="text-center py-12 text-gray-400 text-xs italic">
                  Nenhum orçamento emitido até o momento. Clique em "Novo Orçamento" para criar o primeiro.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Barra de Paginação (50 por Página) -->
      <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-gray-600 font-mono">
        <div id="pagination-info">
          Exibindo 1 a 50 de <%= budgets.length %> orçamentos
        </div>

        <div class="flex items-center gap-2" id="pagination-controls">
          <button type="button" id="btn-prev-page" onclick="changePage(-1)" class="px-3 py-1.5 bg-white border border-gray-300 hover:bg-gray-100 rounded-lg font-bold disabled:opacity-40 disabled:cursor-not-allowed">
            &larr; Anterior
          </button>
          
          <span id="page-display" class="px-3 py-1 bg-white border border-gray-300 rounded-lg font-bold">
            Página 1 de 1
          </span>

          <button type="button" id="btn-next-page" onclick="changePage(1)" class="px-3 py-1.5 bg-white border border-gray-300 hover:bg-gray-100 rounded-lg font-bold disabled:opacity-40 disabled:cursor-not-allowed">
            Próxima &rarr;
          </button>
        </div>
      </div>

    </div>

  </div>
</section>

