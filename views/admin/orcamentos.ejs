  // Digitação do Código do Exame no Form
  function onExamCodeInput() {
    const codeVal = document.getElementById('exam-code-field').value.trim().toLowerCase();
    if (!codeVal) return;

    // Buscar no banco de exames por código exato ou que inicie com o código
    const match = examsData.find(e => e.code && e.code.toLowerCase() === codeVal) ||
                  examsData.find(e => e.code && e.code.toLowerCase().startsWith(codeVal));

    if (match) {
      document.getElementById('exam-search-field').value = (match.code ? match.code + ' - ' : '') + match.name;
      if (match.material) {
        document.getElementById('exam-material-field').value = match.material;
      }
    }
  }

  // Digitação/Seleção do Nome do Exame
  function onExamNameInput() {
    const searchVal = document.getElementById('exam-search-field').value.trim().toLowerCase();
    if (!searchVal) return;

    const match = examsData.find(e => {
      const fullText = (e.code ? e.code + ' - ' : '') + e.name;
      return fullText.toLowerCase() === searchVal || e.name.toLowerCase() === searchVal;
    });

    if (match) {
      if (document.getElementById('exam-code-field')) {
        document.getElementById('exam-code-field').value = match.code || '';
      }
      if (match.material) {
        document.getElementById('exam-material-field').value = match.material;
      }
    }
  }

  // Tecla Enter nos campos de busca de exame
  function handleExamInputKeydown(event) {
    if (event.key === 'Enter') {
      event.preventDefault();
      addSelectedExam();
    }
  }

  // Adicionar Exame da Barra de Pesquisa ao Grid
  function addSelectedExam() {
    const codeInput = document.getElementById('exam-code-field');
    const codeVal = codeInput ? codeInput.value.trim() : '';
    const searchVal = document.getElementById('exam-search-field').value.trim();
    const materialVal = document.getElementById('exam-material-field').value;

    if (!codeVal && !searchVal) {
      alert('Por favor, digite o código ou selecione um exame na busca.');
      return;
    }

    // Tentar localizar no banco de exames
    const match = examsData.find(e => {
      const codeMatch = codeVal && e.code && e.code.toLowerCase() === codeVal.toLowerCase();
      const fullText = (e.code ? e.code + ' - ' : '') + e.name;
      const nameMatch = searchVal && (fullText.toLowerCase() === searchVal.toLowerCase() || e.name.toLowerCase() === searchVal.toLowerCase());
      return codeMatch || nameMatch;
    });

    if (match) {
      addedExams.push({
        id: match.id,
        code: match.code || 'EX-' + Math.floor(Math.random()*1000),
        name: match.name,
        material: materialVal || match.material || 'Soro',
        price: parseFloat(match.pricePrivate || 0),
        fasting: match.fasting || 'Sem jejum',
        timeframe: match.timeframe || '1 dia útil',
        instructions: match.instructions || ''
      });
    } else {
      alert("Exame não encontrado no cadastro de exames. Selecione um exame da lista de exames cadastrados.");
      return;
    }

    if (codeInput) codeInput.value = '';
    document.getElementById('exam-search-field').value = '';
    if (codeInput) {
      codeInput.focus();
    } else {
      document.getElementById('exam-search-field').focus();
    }
    renderAddedExamsTable();
  }

  // Remover Exame da Tabela
  function removeExamFromGrid(idx) {
    addedExams.splice(idx, 1);
    renderAddedExamsTable();
  }

  // Renderizar Tabela de Exames Adicionados
  function renderAddedExamsTable() {
    const tbody = document.getElementById('budget-items-tbody');
    tbody.innerHTML = '';

    if (addedExams.length === 0) {
      tbody.innerHTML = `
        <tr id="empty-exams-row">
          <td colspan="6" class="py-8 text-center text-gray-400 font-mono text-xs">
            Nenhum exame adicionado ao orçamento ainda. Selecione um exame acima e clique em OK.
          </td>
        </tr>
      `;
      calculateTotais();
      return;
    }

    addedExams.forEach((item, index) => {
      const tr = document.createElement('tr');
      tr.className = 'hover:bg-gray-50 border-b border-gray-100';

      tr.innerHTML = `
        <td class="py-2.5 px-3 text-center font-mono font-bold text-gray-500">${index + 1}</td>
        <td class="py-2.5 px-3 font-mono font-bold text-emerald-800">${item.code}</td>
        <td class="py-2.5 px-3 font-bold text-gray-900">${item.name}</td>
        <td class="py-2.5 px-3 font-mono text-gray-700">${item.material}</td>
        <td class="py-2.5 px-3 text-right font-mono font-bold text-gray-900">
          R$ ${item.price.toFixed(2).replace('.', ',')}
        </td>
        <td class="py-2.5 px-3 text-center">
          <button type="button" onclick="removeExamFromGrid(${index})" class="text-rose-600 hover:text-rose-800 font-bold p-1 rounded hover:bg-rose-50 cursor-pointer" title="Remover Exame">
            ✕
          </button>
        </td>
      `;
      tbody.appendChild(tr);
    });

    calculateTotais();
  }

  // Calcular Totais (Acréscimo e Desconto)
  function calculateTotais() {
    let subtotal = addedExams.reduce((acc, cur) => acc + (cur.price || 0), 0);

    let acrescimoVal = parseFloat(document.getElementById('form-acrescimo').value || '0');
    let tipoAcrescimo = document.getElementById('form-tipoAcrescimo').value;

    let descontoVal = parseFloat(document.getElementById('form-desconto').value || '0');
    let tipoDesconto = document.getElementById('form-tipoDesconto').value;

    let totalAcrescimo = tipoAcrescimo === '%' ? (subtotal * acrescimoVal) / 100 : acrescimoVal;
    let totalDesconto = tipoDesconto === '%' ? (subtotal * descontoVal) / 100 : descontoVal;

    let totalLiquido = Math.max(0, subtotal + totalAcrescimo - totalDesconto);

    document.getElementById('form-total-display').textContent = 'R$ ' + totalLiquido.toFixed(2).replace('.', ',');
  }

  // Preparar Envio do Formulário
  function prepareFormSubmission(e) {
    if (addedExams.length === 0) {
      e.preventDefault();
      alert('Por favor, adicione pelo menos um exame antes de salvar o orçamento.');
      return false;
    }

    document.getElementById('hidden-exams-json').value = JSON.stringify(addedExams);
    return true;
  }

  // Converter Orçamento Atual em Requisição / OS
  function convertToRequision() {
    const pName = document.getElementById('form-patientName').value.trim();
    const pCpf = document.getElementById('form-patientCpf').value.trim();
    const pPhone = document.getElementById('form-patientPhone').value.trim();

    if (!pName) {
      alert('Preencha o Nome do Paciente para gerar a Requisição.');
      return;
    }

    window.location.href = `/admin/requisicoes?patientName=${encodeURIComponent(pName)}&patientCpf=${encodeURIComponent(pCpf)}&patientPhone=${encodeURIComponent(pPhone)}`;
  }

  // LÓGICA DE PAGINAÇÃO DE 50 EM 50
  function filterBudgetsWithPagination() {
    const input = document.getElementById('budget-search-input');
    const query = input.value.toLowerCase().trim();

    filteredBudgets = budgetsData.filter(b => {
      const name = (b.patientName || '').toLowerCase();
      const id = (b.id || '').toLowerCase();
      return name.includes(query) || id.includes(query);
    });

    currentPage = 1;
    renderPagination();
  }

  function renderPagination() {
    const totalItems = filteredBudgets.length;
    const totalPages = Math.ceil(totalItems / PAGE_SIZE) || 1;

    if (currentPage > totalPages) currentPage = totalPages;
    if (currentPage < 1) currentPage = 1;

    const startIndex = (currentPage - 1) * PAGE_SIZE;
    const endIndex = Math.min(startIndex + PAGE_SIZE, totalItems);

    // Ocultar/Exibir linhas correspondentes
    const allRows = document.querySelectorAll('.budget-row');
    allRows.forEach(row => {
      const idx = parseInt(row.getAttribute('data-index'), 10);
      const rowItem = budgetsData[idx];
      if (rowItem && filteredBudgets.includes(rowItem)) {
        const filteredIdx = filteredBudgets.indexOf(rowItem);
        if (filteredIdx >= startIndex && filteredIdx < endIndex) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      } else {
        row.style.display = 'none';
      }
    });

    // Atualizar Contadores e Textos
    document.getElementById('total-budgets-count').textContent = totalItems + ' registros';
    document.getElementById('pagination-info').textContent = totalItems > 0 
      ? `Exibindo ${startIndex + 1} a ${endIndex} de ${totalItems} orçamentos`
      : 'Nenhum orçamento encontrado';

    document.getElementById('page-display').textContent = `Página ${currentPage} de ${totalPages}`;

    document.getElementById('btn-prev-page').disabled = (currentPage <= 1);
    document.getElementById('btn-next-page').disabled = (currentPage >= totalPages);
  }

  function changePage(direction) {
    currentPage += direction;
    renderPagination();
  }

  // Atualizar Status via API
  async function updateBudgetStatus(id, newStatus) {
    try {
      const response = await fetch('/admin/orcamentos/status', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, status: newStatus })
      });
      const data = await response.json();
      if (data.success) {
        window.location.reload();
      } else {
        alert('Erro ao atualizar status: ' + (data.message || 'Erro desconhecido'));
      }
    } catch (err) {
      console.error(err);
      alert('Erro na comunicação com o servidor.');
    }
  }

  // Visualizar / Imprimir Ficha no Modal
  function openPrintModal(reqId) {
    const req = budgetsData.find(r => r.id === reqId);
    if (!req) return;

    document.getElementById('modal-id').textContent = req.id;
    document.getElementById('modal-date').textContent = req.createdAt || req.date;
    document.getElementById('modal-patient-name').textContent = req.patientName;
    document.getElementById('modal-patient-cpf').textContent = req.patientCpf || 'Não informado';
    document.getElementById('modal-doctor').textContent = (req.doctorName || 'Não Informado') + ' [' + (req.convenio || 'Particular') + ']';
    document.getElementById('modal-fasting').textContent = req.maxFasting || 'Sem jejum';
    document.getElementById('modal-timeframe').textContent = req.maxTimeframe || '1 dia útil';
    document.getElementById('modal-total-price').textContent = 'R$ ' + (req.totalPrice || 0).toFixed(2).replace('.', ',');

    const examsContainer = document.getElementById('modal-exams-list');
    examsContainer.innerHTML = '';
    (req.exams || []).forEach(exam => {
      const div = document.createElement('div');
      div.className = 'py-2 flex justify-between items-center';
      div.innerHTML = `
        <div>
          <span class="font-bold text-gray-900">${exam.name}</span>
          <span class="block text-[10px] text-gray-500 font-mono">Mat: ${exam.material || 'Soro'} | Cód: ${exam.code || '-'}</span>
        </div>
        <div class="font-bold text-gray-800 font-mono">
          R$ ${(exam.price || 0).toFixed(2).replace('.', ',')}
        </div>
      `;
      examsContainer.appendChild(div);
    });

    document.getElementById('print-modal').classList.remove('hidden');
  }

  function closePrintModal() {
    document.getElementById('print-modal').classList.add('hidden');
  }
</script>

