  // Editar Orçamento Existente
  function editBudget(id) {
    const b = budgetsData.find(item => item.id === id);
    if (!b) {
      alert('Orçamento não encontrado!');
      return;
    }

    // Preencher campos do formulário
    if (document.getElementById('form-originalId')) document.getElementById('form-originalId').value = b.id;
    if (document.getElementById('form-codigo')) document.getElementById('form-codigo').value = b.id;
    if (document.getElementById('form-data')) document.getElementById('form-data').value = b.date || new Date().toISOString().split('T')[0];
    if (document.getElementById('form-usuario')) document.getElementById('form-usuario').value = b.user || 'Administrador';

    // Dados do paciente / solicitante / contato / médico
    if (document.getElementById('form-patientName')) document.getElementById('form-patientName').value = b.patientName || '';
    if (document.getElementById('form-patientCpf')) document.getElementById('form-patientCpf').value = b.patientCpf || '';
    if (document.getElementById('form-patientPhone')) document.getElementById('form-patientPhone').value = b.patientPhone || '';
    if (document.getElementById('form-patientEmail')) document.getElementById('form-patientEmail').value = b.patientEmail || '';
    if (document.getElementById('form-solicitante')) document.getElementById('form-solicitante').value = b.solicitante || '';
    if (document.getElementById('form-contatoNome')) document.getElementById('form-contatoNome').value = b.contatoNome || '';
    if (document.getElementById('form-contatoFone')) document.getElementById('form-contatoFone').value = b.contatoFone || '';
    if (document.getElementById('form-conselhoTipo')) document.getElementById('form-conselhoTipo').value = b.conselhoTipo || 'CRM';
    if (document.getElementById('form-conselhoNum')) document.getElementById('form-conselhoNum').value = b.conselhoNum || '';
    if (document.getElementById('form-conselhoUf')) document.getElementById('form-conselhoUf').value = b.conselhoUf || 'PR';
    if (document.getElementById('form-doctorName')) document.getElementById('form-doctorName').value = b.doctorName || '';
    if (document.getElementById('form-convenio')) document.getElementById('form-convenio').value = b.convenio || 'Particular';

    // Valores e observação
    if (document.getElementById('form-acrescimo')) document.getElementById('form-acrescimo').value = b.acrescimo !== undefined ? b.acrescimo : '0.00';
    if (document.getElementById('form-tipoAcrescimo')) document.getElementById('form-tipoAcrescimo').value = b.tipoAcrescimo || 'R$';
    if (document.getElementById('form-desconto')) document.getElementById('form-desconto').value = b.desconto !== undefined ? b.desconto : '0.00';
    if (document.getElementById('form-tipoDesconto')) document.getElementById('form-tipoDesconto').value = b.tipoDesconto || 'R$';
    if (document.getElementById('form-validade')) document.getElementById('form-validade').value = b.validade || '30 dias';
    if (document.getElementById('form-observation')) document.getElementById('form-observation').value = b.observation || '';

    // Exames
    addedExams = Array.isArray(b.exams) ? JSON.parse(JSON.stringify(b.exams)) : [];
    renderAddedExamsTable();

    // Atualizar título do form
    const heading = document.getElementById('form-title-heading');
    if (heading) heading.textContent = 'Editar Orçamento #' + b.id;

    // Expandir painel de dados do paciente se estiver fechado
    const panel = document.getElementById('patient-data-panel');
    if (panel && panel.classList.contains('hidden')) {
      togglePatientDataSection();
    }

    // Abrir formulário e esconder histórico
    toggleRegistrationForm(true);
  }

  // Modais de Busca de Paciente e Médico
  function openPatientSearchModal() {
    renderPatientsModalList(patientsData);
    document.getElementById('patient-search-modal').classList.remove('hidden');
    document.getElementById('patient-modal-input').value = '';
    document.getElementById('patient-modal-input').focus();
  }

  function closePatientSearchModal() {
    document.getElementById('patient-search-modal').classList.add('hidden');
  }

  function filterPatientsModal() {
    const q = document.getElementById('patient-modal-input').value.toLowerCase().trim();
    const filtered = patientsData.filter(p => {
      const name = (p.nome || p.name || '').toLowerCase();
      const cpf = (p.cpf || '').toLowerCase();
      return name.includes(q) || cpf.includes(q);
    });
    renderPatientsModalList(filtered);
  }

  function renderPatientsModalList(list) {
    const container = document.getElementById('patient-modal-list');
    container.innerHTML = '';
    if (!list || list.length === 0) {
      container.innerHTML = '<div class="p-4 text-center text-xs text-gray-400 font-mono">Nenhum paciente cadastrado encontrado.</div>';
      return;
    }
    list.forEach(p => {
      const pName = p.nome || p.name || 'Paciente sem nome';
      const div = document.createElement('div');
      div.className = 'p-3 bg-gray-50 hover:bg-emerald-50 rounded-xl border border-gray-200 cursor-pointer transition-all flex justify-between items-center';
      div.onclick = () => selectPatientFromModal(p);
      div.innerHTML = `
        <div>
          <span class="block font-bold text-gray-900 text-xs">${pName}</span>
          <span class="block text-[10px] text-gray-500 font-mono">CPF: ${p.cpf || '-'} | Tel: ${p.telefone || p.celular || p.phone || '-'}</span>
        </div>
        <button type="button" class="px-2.5 py-1 bg-emerald-600 text-white font-bold text-[10px] uppercase rounded-lg">Selecionar</button>
      `;
      container.appendChild(div);
    });
  }

  function selectPatientFromModal(p) {
    document.getElementById('form-patientName').value = p.nome || p.name || '';
    if (p.cpf) document.getElementById('form-patientCpf').value = p.cpf;
    if (p.telefone || p.celular || p.phone) document.getElementById('form-patientPhone').value = p.telefone || p.celular || p.phone;
    if (p.email && document.getElementById('form-patientEmail')) document.getElementById('form-patientEmail').value = p.email;
    if (p.convenio) document.getElementById('form-convenio').value = p.convenio;
    closePatientSearchModal();
  }

