  // TABELA 5: Ausências e Férias
  function calcAbsenceDays() {
    const start = document.getElementById('abs-start').value;
    const end = document.getElementById('abs-end').value;

    if (!start || !end) return;

    const startDate = new Date(start);
    const endDate = new Date(end);
    
    if (endDate < startDate) {
      document.getElementById('abs-days').value = 0;
      return;
    }

    const diffTime = Math.abs(endDate - startDate);
    const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)) + 1; // Incluindo o próprio dia de início
    document.getElementById('abs-days').value = diffDays;
  }

