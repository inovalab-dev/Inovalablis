<%- include('../partials/header') %>

<!-- Top Section with Clinical Banner -->
<section class="bg-gradient-to-r from-brand-dark to-brand-light/85 text-white py-8 relative overflow-hidden">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,rgba(255,255,255,0.06),transparent_50%)] pointer-events-none"></div>
  <div class="absolute -right-16 -bottom-16 w-64 h-64 bg-white/5 rounded-full blur-3xl pointer-events-none"></div>
  
  <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-6 relative z-10 animate-fade-in">
    <div class="space-y-3 max-w-3xl">
      <div class="flex items-center gap-2 text-xs font-semibold text-brand-light/20 bg-white/10 px-3 py-1 rounded-full w-fit">
        <a href="/admin" class="hover:text-white transition-colors">Administração</a>
        <span>&rsaquo;</span>
        <span class="text-white font-bold font-mono uppercase text-[9px] tracking-wider">Recursos Humanos</span>
      </div>
      <h1 class="text-3xl font-extrabold text-white tracking-tight sm:text-4xl">Ficha Funcional & Recursos Humanos</h1>
      <p class="text-xs text-white/80 max-w-xl leading-relaxed">
        Gerenciamento completo do corpo de colaboradores da empresa. Registre dados pessoais, contratuais, formação acadêmica, registros profissionais, treinamentos, controle de vacinação e históricos de ausências.
      </p>
    </div>

    <!-- Stats badge -->
    <button onclick="toggleAddProfForm()" class="bg-brand-gold hover:bg-amber-600 text-brand-neutralDark font-bold text-xs uppercase tracking-wider px-6 py-3.5 rounded-2xl shadow-lg transition-all transform hover:-translate-y-0.5 flex items-center gap-2 cursor-pointer border border-brand-gold/20">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
      </svg>
      <span>Adicionar Colaborador</span>
    </button>
  </div>
</section>

<section class="py-10 bg-brand-neutralLight/45">
  <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
    
    <!-- Formulário Principal de Cadastro/Edição (Oculto por padrão) -->
    <div id="add-prof-panel" class="hidden bg-white rounded-3xl border-2 border-brand-light/30 shadow-xl overflow-hidden animate-fade-in">
      <div class="bg-brand-dark text-white px-6 py-5 flex justify-between items-center">
        <div>
          <h2 id="form-title" class="text-lg font-extrabold tracking-tight">Cadastrar Novo Colaborador</h2>
          <p class="text-[10px] text-white/70">Preencha as informações funcionais organizadas por abas abaixo.</p>
        </div>
        <button onclick="hideAddProfForm()" class="text-white/80 hover:text-white text-xs font-bold font-mono uppercase bg-white/10 px-3 py-1.5 rounded-lg border border-white/10 cursor-pointer">
          Cancelar / Fechar
        </button>
      </div>

      <!-- Abas de Navegação do Formulário -->
      <div class="bg-brand-softBg/40 border-b border-brand-light/10 flex flex-wrap gap-1 p-2">
        <button type="button" onclick="switchFormTab('tab-pessoais')" id="btn-tab-pessoais" class="form-tab-btn active px-4 py-2 text-xs font-bold font-mono uppercase tracking-wider rounded-xl transition-all">
          👤 1. Pessoais
        </button>
        <button type="button" onclick="switchFormTab('tab-profissionais')" id="btn-tab-profissionais" class="form-tab-btn px-4 py-2 text-xs font-bold font-mono uppercase tracking-wider rounded-xl transition-all">
          💼 2. Profissionais
        </button>
        <button type="button" onclick="switchFormTab('tab-formacao')" id="btn-tab-formacao" class="form-tab-btn px-4 py-2 text-xs font-bold font-mono uppercase tracking-wider rounded-xl transition-all">
          🎓 3. Formação, Registro & Assinatura (Laudos)
        </button>
        <button type="button" onclick="switchFormTab('tab-treinamentos')" id="btn-tab-treinamentos" class="form-tab-btn px-4 py-2 text-xs font-bold font-mono uppercase tracking-wider rounded-xl transition-all">
          📚 4. Treinamentos
        </button>
        <button type="button" onclick="switchFormTab('tab-vacinacao')" id="btn-tab-vacinacao" class="form-tab-btn px-4 py-2 text-xs font-bold font-mono uppercase tracking-wider rounded-xl transition-all">
          💉 5. Vacinação
        </button>
        <button type="button" onclick="switchFormTab('tab-documentos')" id="btn-tab-documentos" class="form-tab-btn px-4 py-2 text-xs font-bold font-mono uppercase tracking-wider rounded-xl transition-all">
          📂 6. Documentos Digitais
        </button>
        <button type="button" onclick="switchFormTab('tab-ausencias')" id="btn-tab-ausencias" class="form-tab-btn px-4 py-2 text-xs font-bold font-mono uppercase tracking-wider rounded-xl transition-all">
          📅 7. Férias & Ausências
        </button>
      </div>

      <!-- Formulário -->
      <form id="prof-form" action="/admin/profissionais/add" method="POST" class="p-6 sm:p-8 space-y-6">
        <input type="hidden" name="id" id="form-prof-id">
        
        <!-- Inputs Ocultos de Arrays Serializados -->
        <input type="hidden" name="education" id="form-serialized-education" value="[]">
        <input type="hidden" name="trainings" id="form-serialized-trainings" value="[]">
        <input type="hidden" name="vaccinations" id="form-serialized-vaccinations" value="[]">
        <input type="hidden" name="documents" id="form-serialized-documents" value="[]">
        <input type="hidden" name="absences" id="form-serialized-absences" value="[]">

        <!-- ---------------- TAB 1: DADOS PESSOAIS ---------------- -->
        <div id="panel-tab-pessoais" class="form-panel space-y-6">
          <div class="border-b border-brand-light/10 pb-2">
            <h3 class="text-xs font-black text-brand-dark font-mono uppercase tracking-widest">👤 1. Dados Pessoais & Contatos</h3>
            <p class="text-[10px] text-gray-400">Informações básicas e documentos de identificação civil do colaborador.</p>
          </div>

          <!-- Avatar / Foto -->
          <div class="flex items-center gap-5 bg-brand-softBg/30 p-4 rounded-2xl border border-brand-light/10">
            <div class="relative group">
              <div class="w-16 h-16 rounded-full bg-brand-softBg border-2 border-brand-light/30 flex items-center justify-center overflow-hidden">
                <img id="avatar-preview" src="" class="w-full h-full object-cover hidden">
                <svg id="avatar-placeholder" class="w-8 h-8 text-brand-dark/30" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                </svg>
              </div>
            </div>
            <div class="space-y-1">
              <label class="block text-xs font-bold text-brand-dark uppercase tracking-wider font-mono">Foto do Colaborador</label>
              <input type="file" id="photo-file" accept="image/*" onchange="handlePhotoUpload(event)" class="text-xs text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-brand-softBg file:text-brand-dark hover:file:bg-brand-light/20 cursor-pointer">
              <input type="hidden" name="photo" id="form-prof-photo">
              <p class="text-[9px] text-gray-400">Tamanho recomendado: 300x300px. Formatos: PNG, JPG.</p>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div class="md:col-span-2">
              <label class="block text-[10px] font-bold text-brand-dark uppercase tracking-wider font-mono mb-1">Nome Completo <span class="text-rose-500">*</span></label>
              <input type="text" name="name" id="form-prof-name" required placeholder="Ex: Monara Natana Idem" class="form-input">
            </div>
            <div class="md:col-span-2">
              <label class="block text-[10px] font-bold text-brand-dark uppercase tracking-wider font-mono mb-1">Nome Social (se aplicável)</label>
              <input type="text" name="socialName" id="form-prof-socialName" placeholder="Ex: Nome de preferência" class="form-input">
            </div>

            <div>
              <label class="block text-[10px] font-bold text-brand-dark uppercase tracking-wider font-mono mb-1">CPF <span class="text-rose-500">*</span></label>
              <input type="text" name="cpf" id="form-prof-cpf" required placeholder="000.000.000-00" oninput="maskCPF(this)" class="form-input">
            </div>
            <div>
              <label class="block text-[10px] font-bold text-brand-dark uppercase tracking-wider font-mono mb-1">RG</label>
              <input type="text" name="rg" id="form-prof-rg" placeholder="00.000.000-0" class="form-input">
            </div>
            <div>
              <label class="block text-[10px] font-bold text-brand-dark uppercase tracking-wider font-mono mb-1">Data de Nascimento</label>
              <input type="date" name="birthDate" id="form-prof-birthDate" class="form-input">
            </div>
            <div>
              <label class="block text-[10px] font-bold text-brand-dark uppercase tracking-wider font-mono mb-1">Sexo</label>
              <select name="gender" id="form-prof-gender" class="form-input">
                <option value="">Selecione...</option>
                <option value="Feminino">Feminino</option>
                <option value="Masculino">Masculino</option>
                <option value="Outro">Outro / Prefere não dizer</option>
              </select>
            </div>

            <div>
              <label class="block text-[10px] font-bold text-brand-dark uppercase tracking-wider font-mono mb-1">Estado Civil</label>
              <select name="maritalStatus" id="form-prof-maritalStatus" class="form-input">
                <option value="">Selecione...</option>
                <option value="Solteiro(a)">Solteiro(a)</option>
                <option value="Casado(a)">Casado(a)</option>
                <option value="Divorciado(a)">Divorciado(a)</option>
                <option value="Viúvo(a)">Viúvo(a)</option>
                <option value="União Estável">União Estável</option>
              </select>
            </div>
            <div>
              <label class="block text-[10px] font-bold text-brand-dark uppercase tracking-wider font-mono mb-1">Nacionalidade</label>
              <input type="text" name="nationality" id="form-prof-nationality" placeholder="Ex: Brasileira" class="form-input">
            </div>
            <div>
              <label class="block text-[10px] font-bold text-brand-dark uppercase tracking-wider font-mono mb-1">Telefone Fixo</label>
              <input type="text" name="phone" id="form-prof-phone" oninput="maskPhone(this)" placeholder="(43) 3546-0000" class="form-input">
            </div>
            <div>
              <label class="block text-[10px] font-bold text-brand-dark uppercase tracking-wider font-mono mb-1">Celular <span class="text-rose-500">*</span></label>
              <input type="text" name="mobile" id="form-prof-mobile" required oninput="maskPhone(this)" placeholder="(43) 99999-0000" class="form-input">
            </div>

            <div class="md:col-span-2">
              <label class="block text-[10px] font-bold text-brand-dark uppercase tracking-wider font-mono mb-1">E-mail Pessoal / Trabalho</label>
              <input type="email" name="email" id="form-prof-email" placeholder="nome@laboratorioinovalab.com" class="form-input">
            </div>
            <div class="md:col-span-2">
              <label class="block text-[10px] font-bold text-brand-dark uppercase tracking-wider font-mono mb-1">Endereço Residencial</label>
              <input type="text" name="address" id="form-prof-address" placeholder="Rua, número, bairro" class="form-input">
            </div>

            <div>
              <label class="block text-[10px] font-bold text-brand-dark uppercase tracking-wider font-mono mb-1">Cidade</label>
              <input type="text" name="city" id="form-prof-city" placeholder="Ex: Cambará" class="form-input">
            </div>
            <div>
              <label class="block text-[10px] font-bold text-brand-dark uppercase tracking-wider font-mono mb-1">Estado</label>
              <input type="text" name="state" id="form-prof-state" placeholder="Ex: PR" class="form-input">
            </div>
            <div>
              <label class="block text-[10px] font-bold text-brand-dark uppercase tracking-wider font-mono mb-1">CEP</label>
              <input type="text" name="zipCode" id="form-prof-zipCode" placeholder="86390-000" class="form-input">
            </div>
          </div>
        </div>

        <!-- ---------------- TAB 2: DADOS PROFISSIONAIS ---------------- -->
        <div id="panel-tab-profissionais" class="form-panel space-y-6 hidden">
          <div class="border-b border-brand-light/10 pb-2">
            <h3 class="text-xs font-black text-brand-dark font-mono uppercase tracking-widest">💼 2. Dados Profissionais & Acessos</h3>
            <p class="text-[10px] text-gray-400">Atribuição do colaborador na estrutura organizacional e permissões.</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
              <label class="block text-[10px] font-bold text-brand-dark uppercase tracking-wider font-mono mb-1">Matrícula / Registro Interno</label>
              <input type="text" name="registration" id="form-prof-registration" placeholder="Ex: INOVA-105" class="form-input">
            </div>
            <div>
              <label class="block text-[10px] font-bold text-brand-dark uppercase tracking-wider font-mono mb-1">Cargo Principal <span class="text-rose-500">*</span></label>
              <select name="role" id="form-prof-role" required class="form-input">
                <option value="">Selecione...</option>
                <option value="Responsável Técnico">Responsável Técnico</option>
                <option value="Bioquímico(a)">Bioquímico(a)</option>
                <option value="Biomédico(a)">Biomédico(a)</option>
                <option value="Farmacêutico(a)">Farmacêutico(a)</option>
                <option value="Recepcionista">Recepcionista</option>
                <option value="Analista de Laboratório">Analista de Laboratório</option>
                <option value="Auxiliar de Coleta">Auxiliar de Coleta</option>
                <option value="Serviços Gerais">Serviços Gerais</option>
                <option value="Gerente Administrativo">Gerente Administrativo</option>
              </select>
            </div>
            <div>
              <label class="block text-[10px] font-bold text-brand-dark uppercase tracking-wider font-mono mb-1">Setor de Atuação</label>
              <select name="sector" id="form-prof-sector" class="form-input">
                <option value="">Selecione...</option>
                <option value="Técnico / Bancada">Técnico / Bancada</option>
                <option value="Recepção / Atendimento">Recepção / Atendimento</option>
                <option value="Administrativo / Diretoria">Administrativo / Diretoria</option>
                <option value="Logística / Apoio">Logística / Apoio</option>
              </select>
            </div>

            <div>
              <label class="block text-[10px] font-bold text-brand-dark uppercase tracking-wider font-mono mb-1">Função Detalhada</label>
              <input type="text" name="function" id="form-prof-function" placeholder="Ex: Coleta de Sangue e Triagem" class="form-input">
            </div>
            <div>
              <label class="block text-[10px] font-bold text-brand-dark uppercase tracking-wider font-mono mb-1">Data de Admissão</label>
              <input type="date" name="admissionDate" id="form-prof-admissionDate" class="form-input">
            </div>
            <div>
              <label class="block text-[10px] font-bold text-brand-dark uppercase tracking-wider font-mono mb-1">Tipo de Contrato</label>
              <select name="contractType" id="form-prof-contractType" class="form-input">
                <option value="">Selecione...</option>
                <option value="CLT Permanente">CLT Permanente</option>
                <option value="CLT Experiência">CLT Experiência</option>
                <option value="Prestador de Serviço (PJ)">Prestador de Serviço (PJ)</option>
                <option value="Estágio">Estágio</option>
                <option value="Temporário">Temporário</option>
              </select>
            </div>

            <div>
              <label class="block text-[10px] font-bold text-brand-dark uppercase tracking-wider font-mono mb-1">Jornada de Trabalho semanal</label>
              <input type="text" name="workday" id="form-prof-workday" placeholder="Ex: 44h semanais (Seg a Sáb)" class="form-input">
            </div>
            <div>
              <label class="block text-[10px] font-bold text-brand-dark uppercase tracking-wider font-mono mb-1">Supervisor / Gestor Imediato</label>
              <input type="text" name="supervisor" id="form-prof-supervisor" placeholder="Nome do supervisor" class="form-input">
            </div>
            <div>
              <label class="block text-[10px] font-bold text-brand-dark uppercase tracking-wider font-mono mb-1">Situação / Status Atual</label>
              <select name="status" id="form-prof-status" onchange="toggleTerminationReasonField()" class="form-input font-bold">
                <option value="Ativo" class="text-emerald-600 font-bold">Ativo</option>
                <option value="Férias" class="text-amber-600 font-bold">Férias</option>
                <option value="Licença" class="text-indigo-600 font-bold">Licença</option>
                <option value="Afastado" class="text-rose-600 font-bold">Afastado</option>
                <option value="Desligado" class="text-gray-500 font-bold">Desligado</option>
              </select>
            </div>

            <div id="container-terminationReason" class="md:col-span-3 hidden">
              <label class="block text-[10px] font-bold text-rose-700 uppercase tracking-wider font-mono mb-1">Motivo do Desligamento</label>
              <input type="text" name="terminationReason" id="form-prof-terminationReason" placeholder="Ex: Pedido de demissão, Rescisão contratual sem justa causa, Fim de contrato de experiência..." class="form-input border-rose-300 bg-rose-50/40 text-rose-900 font-medium">
            </div>
          </div>

          <div class="bg-indigo-50 border border-indigo-100 p-5 rounded-2xl space-y-4">
            <h4 class="text-xs font-bold text-indigo-900 font-mono uppercase tracking-wider flex items-center gap-2">
              <svg class="w-4 h-4 text-indigo-700" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/>
              </svg>
              Credenciais de Acesso ao Painel Admin
            </h4>
            <p class="text-[10px] text-indigo-800/80 leading-relaxed">
              Opcional. Defina um usuário e senha caso este profissional necessite de acesso ao sistema do laboratório para cadastros ou emissão de laudos.
            </p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-1">
              <div>
                <label class="block text-[10px] font-bold text-indigo-900 uppercase tracking-wider font-mono mb-1">Usuário de Acesso</label>
                <input type="text" name="username" id="form-prof-username" placeholder="Ex: monara.idem" class="w-full px-4 py-2.5 rounded-xl border border-indigo-200 focus:outline-none focus:ring-1 focus:ring-indigo-500 bg-white text-xs font-semibold text-brand-dark">
              </div>
              <div>
                <label class="block text-[10px] font-bold text-indigo-900 uppercase tracking-wider font-mono mb-1">Senha de Acesso</label>
                <input type="password" name="password" id="form-prof-password" placeholder="Defina a senha" class="w-full px-4 py-2.5 rounded-xl border border-indigo-200 focus:outline-none focus:ring-1 focus:ring-indigo-500 bg-white text-xs font-semibold text-brand-dark">
              </div>
            </div>
            
            <div class="pt-2">
              <label class="block text-[10px] font-bold text-indigo-900 uppercase tracking-wider font-mono mb-1">Perfil de Acesso do Profissional</label>
              <select name="profileId" id="form-prof-profileId" class="w-full px-4 py-2.5 rounded-xl border border-indigo-200 focus:outline-none focus:ring-1 focus:ring-indigo-500 bg-white text-xs font-semibold text-[#1b2914]">
                <option value="">Selecione um perfil de acesso...</option>
                <% if (typeof profiles !== 'undefined' && profiles) { %>
                  <% profiles.forEach(profile => { %>
                    <option value="<%= profile.id %>"><%= profile.name %></option>
                  <% }) %>
                <% } %>
              </select>
              <p class="text-[9px] text-indigo-800/60 mt-1">Determina quais telas da administração o profissional logado poderá visualizar e interagir.</p>
            </div>
          </div>

          <!-- Apresentação na Página Pública -->
          <div class="bg-brand-softBg/35 p-5 rounded-2xl border border-brand-light/10 space-y-4">
            <h4 class="text-xs font-bold text-brand-dark font-mono uppercase tracking-wider">Apresentação no Site do Laboratório</h4>
            
            <div class="flex items-start gap-3">
              <input type="checkbox" name="showOnAbout" id="form-prof-showOnAbout" value="true" checked class="mt-1 w-4 h-4 rounded text-brand-dark focus:ring-brand-dark border-brand-light/30 bg-brand-neutralLight">
              <div class="space-y-1">
                <label for="form-prof-showOnAbout" class="text-xs font-bold text-brand-dark select-none cursor-pointer">
                  Exibir no Corpo Clínico ("Sobre Nós" / Membros em Destaque)
                </label>
                <p class="text-[10px] text-gray-400 leading-relaxed">Se ativado, o profissional será listado publicamente para pacientes conhecerem o corpo de profissionais técnicos do InovaLab.</p>
              </div>
            </div>

            <div class="grid grid-cols-1 gap-4 pt-1">
              <div>
                <label class="block text-[10px] font-bold text-brand-dark uppercase tracking-wider font-mono mb-1">Título Acadêmico Curto (Apresentação Pública)</label>
                <input type="text" name="title" id="form-prof-title" placeholder="Ex: Farmacêutica/Bioquímica | CRF 28129" class="form-input">
              </div>
              <div>
                <label class="block text-[10px] font-bold text-brand-dark uppercase tracking-wider font-mono mb-1">Minicurrículo / Resumo da Experiência</label>
                <textarea name="description" id="form-prof-description" rows="3" placeholder="Breve currículo que aparece na página institucional para o público..." class="form-input font-sans leading-relaxed"></textarea>
              </div>
            </div>
          </div>
        </div>

        <!-- ---------------- TAB 3: FORMAÇÃO E REGISTRO ---------------- -->
        <div id="panel-tab-formacao" class="form-panel space-y-6 hidden">
          <div class="border-b border-brand-light/10 pb-2">
            <h3 class="text-xs font-black text-brand-dark font-mono uppercase tracking-widest">🎓 3. Formação Acadêmica, Registro de Classe & Assinatura Digital</h3>
            <p class="text-[10px] text-gray-400">Armazene graduações, registro de conselho (CRBM, CRF, CRM) e a assinatura digitalizada para o rodapé dos laudos.</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 p-5 bg-brand-softBg/30 rounded-2xl border border-brand-light/10">
            <div class="md:col-span-2">
              <h4 class="text-xs font-extrabold text-brand-dark font-mono uppercase tracking-wider">Formação de Nível Superior / Geral</h4>
            </div>
            <div>
              <label class="block text-[10px] font-bold text-brand-dark uppercase tracking-wider font-mono mb-1">Pós-Graduação (Especializações / MBA)</label>
              <input type="text" name="postGrad" id="form-prof-postGrad" placeholder="Ex: Especialização em Citopatologia Clínica" class="form-input">
            </div>
            <div>
              <label class="block text-[10px] font-bold text-brand-dark uppercase tracking-wider font-mono mb-1">Especialidades Adicionais</label>
