                  <option value="Banco de Horas (Folga)">Banco de Horas (Folga)</option>
                  <option value="Licença Médica (Atestado)">Licença Médica (Atestado)</option>
                  <option value="Licença Maternidade/Paternidade">Licença Maternidade/Paternidade</option>
                  <option value="Afastamento Previdenciário (INSS)">Afastamento Previdenciário (INSS)</option>
                  <option value="Falta Justificada">Falta Justificada</option>
                  <option value="Folga Geral / Outros">Folga Geral / Outros</option>
                </select>
              </div>
              <div class="md:col-span-2">
                <label class="block text-[9px] font-bold text-brand-dark uppercase tracking-wider font-mono mb-1">Data Início</label>
                <input type="date" id="abs-start" class="form-input bg-white" onchange="calcAbsenceDays()">
              </div>
              <div class="md:col-span-2">
                <label class="block text-[9px] font-bold text-brand-dark uppercase tracking-wider font-mono mb-1">Data Fim</label>
                <input type="date" id="abs-end" class="form-input bg-white" onchange="calcAbsenceDays()">
              </div>
              <div class="md:col-span-1.5 md:col-span-1">
                <label class="block text-[9px] font-bold text-brand-dark uppercase tracking-wider font-mono mb-1">Dias</label>
                <input type="number" id="abs-days" readonly class="form-input bg-gray-100 font-bold text-brand-dark">
              </div>
              <div class="md:col-span-3">
                <label class="block text-[9px] font-bold text-brand-dark uppercase tracking-wider font-mono mb-1">Observações / Motivo</label>
                <input type="text" id="abs-notes" placeholder="Ex: Férias do período aquisitivo 2024/2025" class="form-input bg-white">
              </div>
              <div class="md:col-span-1">
                <button type="button" onclick="addAbsenceRow()" class="w-full py-2.5 bg-brand-dark hover:bg-brand-light text-white text-xs font-bold rounded-xl cursor-pointer">
                  +
                </button>
              </div>
            </div>
          </div>

          <!-- Tabela de Ausências -->
          <div class="overflow-x-auto rounded-3xl border border-brand-light/10">
            <table class="w-full text-left border-collapse text-xs">
              <thead>
                <tr class="bg-brand-softBg/30 text-[9px] font-bold uppercase tracking-widest text-brand-dark/70 border-b border-brand-light/10 font-mono">
                  <th class="py-3 px-4">Tipo de Evento</th>
                  <th class="py-3 px-4">Data Início</th>
                  <th class="py-3 px-4">Data Fim</th>
                  <th class="py-3 px-4">Total de Dias</th>
                  <th class="py-3 px-4">Observações</th>
                  <th class="py-3 px-4 text-right">Ação</th>
                </tr>
              </thead>
              <tbody id="absences-table-body" class="divide-y divide-brand-light/5 text-xs text-gray-600 font-medium">
                <!-- Linhas injetadas via JS -->
              </tbody>
            </table>
          </div>
        </div>

        <!-- Botões de Ações de Submissão -->
        <div class="flex justify-between items-center pt-6 border-t border-brand-light/10">
          <div class="text-[10px] text-gray-400 font-mono">
            * Campos obrigatórios para salvamento simples do funcionário.
          </div>
          <div class="flex gap-3">
            <button type="button" onclick="hideAddProfForm()" class="px-5 py-3 bg-brand-softBg hover:bg-brand-light/20 text-brand-dark text-xs font-bold rounded-xl transition-all cursor-pointer">
              Fechar
            </button>
            <button type="submit" id="submit-btn" class="px-6 py-3 bg-brand-dark hover:bg-brand-light text-white text-xs font-bold rounded-xl shadow-md transition-all cursor-pointer font-mono uppercase tracking-wider">
              Salvar Colaborador & Ficha
            </button>
          </div>
        </div>
      </form>
    </div>

    <!-- Filtros de Busca de Colaboradores -->
    <div class="bg-white p-5 rounded-3xl border border-brand-light/10 shadow-xs grid grid-cols-1 md:grid-cols-12 gap-4 items-center">
      <div class="md:col-span-5 relative">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
          <svg class="h-4.5 w-4.5 text-gray-400" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </div>
        <input type="text" id="employee-search" oninput="filterEmployees()" placeholder="Buscar por Nome do Colaborador, Cargo ou CPF..." 
               class="w-full pl-11 pr-4 py-3 rounded-xl border border-brand-light/30 focus:outline-none focus:ring-1 focus:ring-brand-dark bg-white text-xs font-semibold text-brand-dark" autocomplete="off">
      </div>

      <div class="md:col-span-3">
        <select id="employee-filter-role" onchange="filterEmployees()" 
                class="w-full px-3 py-3 rounded-xl border border-brand-light/30 focus:outline-none focus:ring-1 focus:ring-brand-dark bg-white text-xs font-bold text-brand-dark cursor-pointer">
          <option value="all">Todos os Cargos</option>
          <option value="Responsável Técnico">Responsável Técnico</option>
          <option value="Bioquímico(a)">Bioquímico(a)</option>
          <option value="Biomédico(a)">Biomédico(a)</option>
          <option value="Recepcionista">Recepcionista</option>
          <option value="Analista de Laboratório">Analista de Laboratório</option>
        </select>
      </div>

      <div class="md:col-span-2">
        <select id="employee-filter-status" onchange="filterEmployees()" 
                class="w-full px-3 py-3 rounded-xl border border-brand-light/30 focus:outline-none focus:ring-1 focus:ring-brand-dark bg-white text-xs font-bold text-brand-dark cursor-pointer">
          <option value="all">Todas Situações</option>
          <option value="Ativo">Ativo</option>
          <option value="Férias">Férias</option>
          <option value="Licença">Licença</option>
          <option value="Afastado">Afastado</option>
          <option value="Desligado">Desligado</option>
        </select>
      </div>

      <div class="md:col-span-2">
        <button onclick="clearEmployeeFilters()" class="w-full py-3 bg-brand-softBg hover:bg-brand-light/10 text-brand-dark text-xs font-bold rounded-xl transition-all font-mono uppercase tracking-wider cursor-pointer">
          Limpar Filtros
        </button>
      </div>
    </div>

    <!-- Lista de Colaboradores (Cards Modernos para Ficha Funcional) -->
    <div id="employees-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% professionals.forEach(prof => { %>
        <%
          let isDesligado = (prof.status === 'Desligado' || prof.status === 'Inativo');
          // Configurações de Badge de Situação
          let statusColor = "bg-emerald-50 text-emerald-700 border-emerald-100";
          if (prof.status === 'Férias') statusColor = "bg-amber-50 text-amber-700 border-amber-100";
          else if (prof.status === 'Licença') statusColor = "bg-indigo-50 text-indigo-700 border-indigo-100";
          else if (prof.status === 'Afastado') statusColor = "bg-rose-50 text-rose-700 border-rose-100";
          else if (isDesligado) statusColor = "bg-gray-100 text-gray-600 border-gray-200";

          let cardStyle = isDesligado ? "opacity-60 bg-gray-50/80 grayscale-[20%] border-gray-300 border-dashed hover:opacity-100 hover:grayscale-0 hover:bg-white" : "bg-white border-brand-light/15 shadow-sm hover:shadow-md";
        %>
        <div class="employee-card rounded-3xl border transition-all p-6 flex flex-col justify-between space-y-4 <%= cardStyle %>"
             data-name="<%= prof.name.toLowerCase() %>"
             data-role="<%= (prof.role || '').toLowerCase() %>"
             data-cpf="<%= (prof.cpf || '').toLowerCase() %>"
             data-status="<%= prof.status || 'Ativo' %>">
          
          <div class="space-y-4">
            <!-- Cabeçalho com Foto e Situação -->
            <div class="flex justify-between items-start gap-3">
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-full bg-brand-softBg border border-brand-light/30 flex items-center justify-center overflow-hidden shrink-0">
                  <% if (prof.photo) { %>
                    <img src="<%= prof.photo %>" class="w-full h-full object-cover">
                  <% } else { %>
                    <svg class="w-7 h-7 text-brand-dark/40" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                    </svg>
                  <% } %>
                </div>
                <div>
                  <h3 class="text-sm font-extrabold text-brand-dark leading-tight"><%= prof.name %></h3>
                  <p class="text-[10px] text-gray-400 font-mono"><%= prof.role %></p>
                </div>
              </div>

              <span class="px-2.5 py-1 rounded-full border text-[9px] font-extrabold uppercase font-mono tracking-wider shrink-0 <%= statusColor %>">
                <%= prof.status || 'Ativo' %>
              </span>
            </div>

            <% if (isDesligado && prof.terminationReason) { %>
              <div class="bg-rose-50/80 border border-rose-200/80 p-2.5 rounded-2xl text-[10px]">
                <span class="text-[9px] font-bold text-rose-700 uppercase tracking-wider block font-mono">Motivo do Desligamento</span>
                <span class="text-rose-950 font-semibold"><%= prof.terminationReason %></span>
              </div>
            <% } %>

            <!-- Dados Compactados da Ficha -->
            <div class="grid grid-cols-2 gap-x-2 gap-y-3 bg-brand-softBg/30 p-3.5 rounded-2xl text-[10px]">
              <div>
                <span class="text-[9px] font-bold text-gray-400 uppercase tracking-wider block font-mono">Setor</span>
                <span class="text-brand-dark font-semibold"><%= prof.sector || 'Não cadastrado' %></span>
              </div>
              <div>
                <span class="text-[9px] font-bold text-gray-400 uppercase tracking-wider block font-mono">Matrícula</span>
                <span class="text-brand-dark font-mono font-bold"><%= prof.registration || 'Não cadastrada' %></span>
              </div>
              <div>
                <span class="text-[9px] font-bold text-gray-400 uppercase tracking-wider block font-mono">Conselho / Registro</span>
                <span class="text-brand-dark font-mono font-semibold"><%= prof.regType ? `${prof.regType.split(' ')[0]} ${prof.regNumber}` : 'Não cadastrado' %></span>
              </div>
              <div>
                <span class="text-[9px] font-bold text-gray-400 uppercase tracking-wider block font-mono">Admissão</span>
                <span class="text-brand-dark font-mono"><%= prof.admissionDate ? new Date(prof.admissionDate).toLocaleDateString('pt-BR') : 'Não cadastrada' %></span>
              </div>
            </div>

            <!-- Resumo das Fichas Auxiliares -->
            <div class="flex flex-wrap items-center gap-1.5 text-[9px] font-bold font-mono">
              <span class="bg-indigo-50 border border-indigo-100 text-indigo-700 px-2 py-0.5 rounded">
                🎓 <%= (prof.education || []).length %> Graduações
              </span>
              <span class="bg-emerald-50 border border-emerald-100 text-emerald-700 px-2 py-0.5 rounded">
                📚 <%= (prof.trainings || []).length %> Treinamentos
              </span>
              <span class="bg-amber-50 border border-amber-100 text-amber-700 px-2 py-0.5 rounded">
                💉 <%= (prof.vaccinations || []).length %> Vacinas
              </span>
              <span class="bg-rose-50 border border-rose-100 text-rose-700 px-2 py-0.5 rounded">
                📂 <%= (prof.documents || []).length %> Arquivos
              </span>
            </div>
          </div>

          <!-- Ações Funcionais -->
          <div class="flex items-center gap-2 pt-2 border-t border-brand-light/5">
            <button onclick="editProf('<%= JSON.stringify(prof).replace(/'/g, "\\'") %>')" class="w-full py-2.5 bg-brand-softBg hover:bg-brand-dark text-brand-dark hover:text-white text-[11px] font-bold rounded-xl transition-all cursor-pointer flex items-center justify-center gap-1.5 font-mono uppercase tracking-wider">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
              </svg>
              <span>Gerenciar Ficha</span>
            </button>
            <a href="/admin/profissionais/delete/<%= prof.id %>" onclick="return confirm('Deseja realmente desligar/excluir este colaborador do sistema de recursos humanos? Esta ação é irreversível.')" class="p-2.5 bg-rose-50 hover:bg-rose-600 text-rose-600 hover:text-white rounded-xl transition-all cursor-pointer" title="Remover Colaborador">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
              </svg>
            </a>
          </div>
        </div>
      <% }) %>

      <!-- No results message -->
      <div id="no-employees" class="hidden col-span-full py-16 text-center text-gray-400 font-medium font-sans animate-fade-in">
        <div class="flex flex-col items-center justify-center space-y-3 bg-white rounded-3xl p-8 border border-brand-light/10 shadow-sm max-w-md mx-auto">
          <svg class="w-10 h-10 text-gray-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
          </svg>
          <p class="text-sm font-bold text-gray-600">Nenhum colaborador encontrado.</p>
          <p class="text-[11px] text-gray-400">Tente fazer outra pesquisa ou remover os filtros ativos acima.</p>
          <button type="button" onclick="clearEmployeeFilters()" class="text-xs text-indigo-600 font-extrabold hover:underline cursor-pointer">Ver Todos</button>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .form-input {
    width: 100%;
    padding: 0.65rem 1rem;
    border-radius: 0.75rem;
    border: 1px solid var(--color-brand-light, #8da673);
    border-color: rgba(141, 166, 115, 0.3);
    background-color: #fafbfa;
    font-size: 0.75rem;
    font-weight: 600;
    color: #1b2914;
    transition: all 0.2s;
  }
  .form-input:focus {
    outline: none;
    border-color: #284701;
    box-shadow: 0 0 0 1px #284701;
  }
  .form-tab-btn {
    color: #4b5563;
    background-color: transparent;
  }
  .form-tab-btn.active {
    color: #ffffff;
    background-color: #284701;
    box-shadow: 0 4px 10px rgba(40, 71, 1, 0.15);
  }
</style>

<script>
  // Listas locais de apoio para arrays do form
  let localEducation = [];
  let localTrainings = [];
  let localVaccinations = [];
  let localDocuments = [];
  let localAbsences = [];

  // Alterna Abas do Form
  function switchFormTab(tabId) {
    document.querySelectorAll('.form-panel').forEach(p => p.classList.add('hidden'));
    document.getElementById(`panel-${tabId}`).classList.remove('hidden');

    document.querySelectorAll('.form-tab-btn').forEach(b => b.classList.remove('active'));
    document.getElementById(`btn-${tabId}`).classList.add('active');
  }

  function toggleTerminationReasonField() {
    const statusVal = document.getElementById('form-prof-status').value;
    const container = document.getElementById('container-terminationReason');
    if (statusVal === 'Desligado') {
      container.classList.remove('hidden');
    } else {
      container.classList.add('hidden');
    }
  }

  // Alterna o Formulário Principal de Exibição
  function toggleAddProfForm() {
    const panel = document.getElementById('add-prof-panel');
    panel.classList.toggle('hidden');
    
    // Reseta form para estado "Add" caso estivesse editando
    document.getElementById('form-title').innerText = "Cadastrar Novo Colaborador";
    document.getElementById('prof-form').action = "/admin/profissionais/add";
    document.getElementById('form-prof-id').value = "";
    document.getElementById('prof-form').reset();
    document.getElementById('form-prof-showOnAbout').checked = true;
    document.getElementById('submit-btn').innerText = "Salvar Colaborador & Ficha";

    if (document.getElementById('form-prof-terminationReason')) {
      document.getElementById('form-prof-terminationReason').value = "";
    }
    toggleTerminationReasonField();

    // Reseta foto
    document.getElementById('avatar-preview').src = "";
    document.getElementById('avatar-preview').classList.add('hidden');
    document.getElementById('avatar-placeholder').classList.remove('hidden');

    // Reseta arrays locais
    localEducation = [];
    localTrainings = [];
    localVaccinations = [];
    localDocuments = [];
    localAbsences = [];
    
    renderAllTables();
    switchFormTab('tab-pessoais');
  }

  function hideAddProfForm() {
    document.getElementById('add-prof-panel').classList.add('hidden');
  }

  // Preenche Ficha de Colaborador para Edição
  function editProf(profStr) {
    const prof = JSON.parse(profStr);
    
    // Mostra o formulário
    const panel = document.getElementById('add-prof-panel');
    panel.classList.remove('hidden');
    
    document.getElementById('form-title').innerText = "Gerenciar Ficha Funcional: " + prof.name;
    document.getElementById('prof-form').action = "/admin/profissionais/edit";
    document.getElementById('submit-btn').innerText = "Salvar Alterações";
    
    // Preenche os campos Básicos/Pessoais
    document.getElementById('form-prof-id').value = prof.id;
    document.getElementById('form-prof-name').value = prof.name;
    document.getElementById('form-prof-socialName').value = prof.socialName || "";
    document.getElementById('form-prof-cpf').value = prof.cpf || "";
    document.getElementById('form-prof-rg').value = prof.rg || "";
    document.getElementById('form-prof-birthDate').value = prof.birthDate || "";
    document.getElementById('form-prof-gender').value = prof.gender || "";
    document.getElementById('form-prof-maritalStatus').value = prof.maritalStatus || "";
    document.getElementById('form-prof-nationality').value = prof.nationality || "";
    document.getElementById('form-prof-phone').value = prof.phone || "";
    document.getElementById('form-prof-mobile').value = prof.mobile || "";
    document.getElementById('form-prof-email').value = prof.email || "";
    document.getElementById('form-prof-address').value = prof.address || "";
    document.getElementById('form-prof-city').value = prof.city || "";
    document.getElementById('form-prof-state').value = prof.state || "";
    document.getElementById('form-prof-zipCode').value = prof.zipCode || "";
    
    // Preenche Foto do Colaborador
    if (prof.photo) {
      document.getElementById('form-prof-photo').value = prof.photo;
      document.getElementById('avatar-preview').src = prof.photo;
      document.getElementById('avatar-preview').classList.remove('hidden');
      document.getElementById('avatar-placeholder').classList.add('hidden');
    } else {
      document.getElementById('form-prof-photo').value = "";
      document.getElementById('avatar-preview').src = "";
      document.getElementById('avatar-preview').classList.add('hidden');
      document.getElementById('avatar-placeholder').classList.remove('hidden');
    }

    // Preenche Dados Profissionais
    document.getElementById('form-prof-registration').value = prof.registration || "";
    document.getElementById('form-prof-role').value = prof.role || "";
    document.getElementById('form-prof-sector').value = prof.sector || "";
    document.getElementById('form-prof-function').value = prof.function || "";
    document.getElementById('form-prof-admissionDate').value = prof.admissionDate || "";
    document.getElementById('form-prof-contractType').value = prof.contractType || "";
    document.getElementById('form-prof-workday').value = prof.workday || "";
    document.getElementById('form-prof-supervisor').value = prof.supervisor || "";
    document.getElementById('form-prof-status').value = prof.status || "Ativo";
    if (document.getElementById('form-prof-terminationReason')) {
      document.getElementById('form-prof-terminationReason').value = prof.terminationReason || "";
    }
    toggleTerminationReasonField();

    // Preenche Acessos & Site
    document.getElementById('form-prof-username').value = prof.username || "";
    document.getElementById('form-prof-password').value = prof.password || "";
    document.getElementById('form-prof-profileId').value = prof.profileId || "";
    document.getElementById('form-prof-showOnAbout').checked = prof.showOnAbout !== false;
    document.getElementById('form-prof-title').value = prof.title || "";
    document.getElementById('form-prof-description').value = prof.description || "";

    // Preenche Formação
    document.getElementById('form-prof-postGrad').value = prof.postGrad || "";
    document.getElementById('form-prof-specializations').value = prof.specializations || "";
    document.getElementById('form-prof-masterDegree').value = prof.masterDegree || "";
    document.getElementById('form-prof-doctorateDegree').value = prof.doctorateDegree || "";

    // Preenche Registro de Classe
    document.getElementById('form-prof-regType').value = prof.regType || "";
    document.getElementById('form-prof-regNumber').value = prof.regNumber || "";
    document.getElementById('form-prof-regState').value = prof.regState || "";
    document.getElementById('form-prof-regValidity').value = prof.regValidity || "";
    document.getElementById('form-prof-regDocFile').value = prof.regDocFile || "";
    
    if (prof.regDocFile) {
      document.getElementById('regdoc-preview-container').classList.remove('hidden');
    } else {
      document.getElementById('regdoc-preview-container').classList.add('hidden');
    }

    // Preenche Assinatura & Dados do Laudo
    document.getElementById('form-prof-laudoTitle').value = prof.laudoTitle || prof.role || "";
    document.getElementById('form-prof-laudoCouncil').value = prof.laudoCouncil || (prof.regType && prof.regNumber ? (prof.regType.split(' ')[0] + '-' + (prof.regState || 'PR') + ': ' + prof.regNumber) : "");
    document.getElementById('form-prof-signatureFile').value = prof.signatureFile || "";

    if (prof.signatureFile) {
      document.getElementById('sig-preview-img').src = prof.signatureFile;
      document.getElementById('sig-preview-img').classList.remove('hidden');
      document.getElementById('sig-preview-placeholder').classList.add('hidden');
    } else {
      document.getElementById('sig-preview-img').src = "";
      document.getElementById('sig-preview-img').classList.add('hidden');
      document.getElementById('sig-preview-placeholder').classList.remove('hidden');
    }

    updateSigPreviewText();

    // Atribui os arrays do EJS para os arrays locais
    localEducation = Array.isArray(prof.education) ? prof.education : [];
    localTrainings = Array.isArray(prof.trainings) ? prof.trainings : [];
    localVaccinations = Array.isArray(prof.vaccinations) ? prof.vaccinations : [];
    localDocuments = Array.isArray(prof.documents) ? prof.documents : [];
    localAbsences = Array.isArray(prof.absences) ? prof.absences : [];

    renderAllTables();
    switchFormTab('tab-pessoais');

    panel.scrollIntoView({ behavior: 'smooth' });
  }

  // Métodos auxiliares para converter Uploads de Arquivos para Base64 no Client
  function handlePhotoUpload(e) {
    const file = e.target.files[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = function(evt) {
      const base64Str = evt.target.result;
      document.getElementById('form-prof-photo').value = base64Str;
      document.getElementById('avatar-preview').src = base64Str;
      document.getElementById('avatar-preview').classList.remove('hidden');
      document.getElementById('avatar-placeholder').classList.add('hidden');
    };
    reader.readAsDataURL(file);
  }

  function handleRegDocUpload(e) {
    const file = e.target.files[0];
    if (!file) return;

