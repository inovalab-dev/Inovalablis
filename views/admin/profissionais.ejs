  // ---------------- FILTROS DE PESQUISA & BUSCA DE COLABORADORES ----------------

  function filterEmployees() {
    const searchVal = document.getElementById('employee-search').value.toLowerCase().trim();
    const roleVal = document.getElementById('employee-filter-role').value.toLowerCase().trim();
    const statusVal = document.getElementById('employee-filter-status').value.toLowerCase().trim();

    const cards = document.querySelectorAll('.employee-card');
    let visibleCount = 0;

    cards.forEach(card => {
      const name = card.getAttribute('data-name') || '';
      const role = card.getAttribute('data-role') || '';
      const cpf = card.getAttribute('data-cpf') || '';
      const status = card.getAttribute('data-status') || '';

      // 1. Busca por texto
      const matchesSearch = !searchVal || name.includes(searchVal) || role.includes(searchVal) || cpf.includes(searchVal);

      // 2. Filtro de Cargo
      const matchesRole = roleVal === 'all' || role.includes(roleVal);

      // 3. Filtro de Status
      const matchesStatus = statusVal === 'all' || status.toLowerCase() === statusVal;

      if (matchesSearch && matchesRole && matchesStatus) {
        card.classList.remove('hidden');
        visibleCount++;
      } else {
        card.classList.add('hidden');
      }
    });

    const noResults = document.getElementById('no-employees');
    if (visibleCount === 0) {
      noResults.classList.remove('hidden');
    } else {
      noResults.classList.add('hidden');
    }
  }

  function clearEmployeeFilters() {
    document.getElementById('employee-search').value = '';
    document.getElementById('employee-filter-role').value = 'all';
    document.getElementById('employee-filter-status').value = 'all';
    filterEmployees();
  }

  // Mascaras de campo
  function maskCPF(i) {
    let v = i.value;
    if (isNaN(v.charAt(v.length-1))) {
      i.value = v.substring(0, v.length-1);
      return;
    }
    i.setAttribute("maxlength", "14");
    if (v.length === 3 || v.length === 7) i.value += ".";
    if (v.length === 11) i.value += "-";
  }

  function maskPhone(i) {
    let v = i.value.replace(/\D/g, "");
    if (v.length > 11) v = v.substring(0, 11);
    
    if (v.length > 10) {
      i.value = "(" + v.substring(0, 2) + ") " + v.substring(2, 7) + "-" + v.substring(7, 11);
    } else if (v.length > 6) {
      i.value = "(" + v.substring(0, 2) + ") " + v.substring(2, 6) + "-" + v.substring(6, 10);
    } else if (v.length > 2) {
      i.value = "(" + v.substring(0, 2) + ") " + v.substring(2);
    } else if (v.length > 0) {
      i.value = "(" + v;
    }
  }
</script>

