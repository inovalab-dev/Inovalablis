  }

  async function applyNewExamStatus(newStatus) {
    if (!selectedReqId || !targetExamCodeForEdit) return;
    const req = globalRequisitions.find(r => r.id === selectedReqId);
    if (!req || !Array.isArray(req.exams)) return;

    const exIndex = req.exams.findIndex(e => (e.code || e.id) === targetExamCodeForEdit);
    if (exIndex !== -1) {
      req.exams[exIndex].status = newStatus;
      await syncExamsToBackend(req.id, req.exams);
    }

    closeChangeExamStatusModal();
    selectRequisitionToCollect(selectedReqId);
  }

  async function coletarTodosDoGrupo(tubo, material) {
    if (!selectedReqId) return;
    const req = globalRequisitions.find(r => r.id === selectedReqId);
    if (!req || !Array.isArray(req.exams)) return;

    let changedCount = 0;
    req.exams.forEach(ex => {
      const info = getExamTubeAndMaterialInfo(ex);
      if (info.tubo === tubo && info.material === material) {
        const currentStatus = ex.status ? String(ex.status).trim() : 'A Coletar';
        if (currentStatus === 'A Coletar') {
          ex.status = 'Coletado';
          changedCount++;
        }
      }
    });

    if (changedCount > 0) {
      await syncExamsToBackend(req.id, req.exams);
      selectRequisitionToCollect(selectedReqId);
    } else {
      alert("Nenhum exame pendente ('A Coletar') foi encontrado neste grupo.");
    }
  }

  async function coletarTodosOsExames() {
    if (!selectedReqId) return;
    const req = globalRequisitions.find(r => r.id === selectedReqId);
    if (!req || !Array.isArray(req.exams)) return;

    let changedCount = 0;
    req.exams.forEach(ex => {
      const currentStatus = ex.status ? String(ex.status).trim() : 'A Coletar';
      if (currentStatus === 'A Coletar') {
        ex.status = 'Coletado';
        changedCount++;
      }
    });

    if (changedCount > 0) {
      await syncExamsToBackend(req.id, req.exams);
      selectRequisitionToCollect(selectedReqId);
    } else {
      alert("Nenhum exame no status 'A Coletar' pendente nesta requisição.");
    }
  }

