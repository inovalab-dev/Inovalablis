  function escapeHtmlString(str) {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  // --- GERADOR E REMOVEDOR DE ACENTOS PARA EPL2 ---
  function removeAccentsForEpl(str) {
    if (!str) return '';
    return String(str)
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-zA-Z0-9\s\-\/\:\.\,\_\(\)]/g, '')
      .toUpperCase();
  }

  function generateEplForTubeGroup(item) {
    if (!item) return '';
    const primaryExam = item.grp.exams[0];
    const setorCode2Digits = getExamSetorCodigo(primaryExam);
    const barcodeTag = `01-${item.reqCode8Digits}-${setorCode2Digits}`;
    const setorName = removeAccentsForEpl(getExamSetorName(primaryExam)).substring(0, 16);
    const materialName = removeAccentsForEpl(item.grp.material || 'DIVERSOS').substring(0, 18);
    const tuboName = removeAccentsForEpl(item.grp.tubo || getExamTubeName(primaryExam)).substring(0, 18);
    const patientName = removeAccentsForEpl(item.patientName || 'PACIENTE').substring(0, 28);
    
    const rawCodes = item.grp.exams.map(e => e.code || e.jalisCode || e.name).filter(Boolean);
    const uniqueCodes = [...new Set(rawCodes)].map(removeAccentsForEpl);
    const examCodesStr = uniqueCodes.join(', ').substring(0, 36);

    const dateStr = item.dateTime ? item.dateTime.dateStr : '';
    const timeStr = item.dateTime ? item.dateTime.timeStr : '';
    const patientDN = item.patientDN || '';
    const copies = item.currentQty || 1;

    // Código EPL2 padrão para etiqueta de tubo 50mm x 30mm (400x240 dots @ 203 DPI)
    const eplLines = [
      'N',
      'q400',
      'Q240,24',
      `A15,10,0,3,1,1,N,"${setorName} - ${materialName}"`,
      `A15,35,0,2,1,1,N,"${patientName}"`,
      `A15,60,0,1,1,N,"EX: ${examCodesStr}"`,
      `A15,80,0,1,1,N,"${dateStr} ${timeStr}  DN:${patientDN}"`,
      `B15,100,0,1,2,5,45,N,"${barcodeTag}"`,
      `A15,152,0,2,1,1,N,"${barcodeTag}"`,
      `A250,152,0,2,1,1,N,"TUBO: ${tuboName}"`,
      `P${copies}`,
      ''
    ];

    return eplLines.join('\r\n');
  }

  function copyEplCommandsSingle(idx) {
    if (!window.activeLabelGroups || !window.activeLabelGroups[idx]) return;
    const item = window.activeLabelGroups[idx];
    const eplCode = generateEplForTubeGroup(item);
    
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(eplCode).then(() => {
        alert('Código EPL2 deste tubo copiado para a área de transferência!');
      }).catch(err => {
        console.error('Erro ao copiar EPL:', err);
        alert('Não foi possível copiar automaticamente. Veja o código no painel bruto.');
      });
    } else {
      alert('Copie manualmente o código EPL do painel bruto do tubo.');
    }
  }

  function copyEplCommandsAll() {
    if (!window.activeLabelGroups || window.activeLabelGroups.length === 0) {
      alert('Nenhuma etiqueta disponível para copiar.');
      return;
    }

    const allEpl = window.activeLabelGroups.map(generateEplForTubeGroup).join('\r\n');
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(allEpl).then(() => {
        alert('Códigos EPL2 de TODAS as etiquetas copiados com sucesso!');
      }).catch(err => {
        console.error('Erro ao copiar EPL:', err);
        alert('Erro ao copiar. Tente copiar do painel de código bruto do tubo.');
      });
    } else {
      alert('Copie manualmente o código EPL do painel de código bruto.');
    }
  }

  async function printEplDirectAll() {
    if (!window.activeLabelGroups || window.activeLabelGroups.length === 0) {
      alert('Nenhuma etiqueta de tubo disponível para envio.');
      return;
    }

    const allEpl = window.activeLabelGroups.map(generateEplForTubeGroup).join('\r\n');
    
    try {
      const response = await fetch('/api/impressoras/imprimir', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          impressora: 'ZDesigner ZD230-203dpi ZPL',
          etiqueta: allEpl
        })
      });

      const data = await response.json();
      if (data && data.success) {
        alert('Etiquetas enviadas com sucesso para a impressora térmica EPL!');
      } else {
        alert('Solicitação enviada ao servidor de impressão. ' + (data?.message || ''));
      }
    } catch (err) {
      console.error('Erro ao enviar impressão EPL REST:', err);
      alert('Erro ao conectar ao servidor de impressão local. O código EPL2 pode ser copiado no botão "Copiar EPL2".');
    }
  }

