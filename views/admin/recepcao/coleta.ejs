  // --- AUXILIARES DA ETIQUETA ZEBRA (50x30mm) ---
  function getPatientDN(req) {
    if (!req) return '21/01/1983';
    let birthDate = req.patientBirthDate || req.patientNascimento || req.nascimento || req.birthDate;

    if (!birthDate && typeof globalPatients !== 'undefined' && Array.isArray(globalPatients)) {
      const p = globalPatients.find(patient => 
        (req.patientId && (patient.id === req.patientId || patient.code === req.patientId)) ||
        (req.patientCpf && patient.cpf && patient.cpf.replace(/\D/g, '') === req.patientCpf.replace(/\D/g, '')) ||
        (req.patientName && patient.name && patient.name.trim().toLowerCase() === req.patientName.trim().toLowerCase())
      );
      if (p) {
        birthDate = p.birthDate || p.nascimento || p.dataNascimento;
      }
    }

    if (!birthDate) return '21/01/1983';

    const clean = String(birthDate).trim();
    if (clean.includes('-')) {
      const parts = clean.split('T')[0].split('-');
      if (parts.length === 3) {
        return `${parts[2].padStart(2, '0')}/${parts[1].padStart(2, '0')}/${parts[0]}`;
      }
    }
    return clean;
  }

  function getExamSetorName(ex) {
    if (!ex) return 'Externo';
    const fullExam = (typeof globalExams !== 'undefined' && Array.isArray(globalExams))
      ? globalExams.find(e => e.code === ex.code || e.id === ex.id || (e.jalisCode && e.jalisCode === ex.code) || e.name === ex.name) || ex
      : ex;

    // 1. Procurar na aba Setores do cadastro do exame (fullExam.setores)
    if (Array.isArray(fullExam.setores) && fullExam.setores.length > 0) {
      for (const s of fullExam.setores) {
        if (typeof s === 'object' && s !== null) {
          const desc = s.descricao || s.nome || s.sigla;
          if (desc && desc.trim()) return desc.trim();
        } else if (typeof s === 'string' && s.trim()) {
          return s.trim();
        }
      }
    }

    // 2. Fallbacks caso o exame não tenha setor cadastrado na aba Setores
    if (Array.isArray(fullExam.materiaisColetados) && fullExam.materiaisColetados.length > 0) {
      const mat = fullExam.materiaisColetados[0];
      if (mat.setorBancada) return mat.setorBancada;
    }
    if (fullExam.setorBancada) return fullExam.setorBancada;
    if (fullExam.category) return fullExam.category;
    if (ex.category) return ex.category;

    return 'Externo';
  }

  function getExamTubeName(ex) {
    if (!ex) return 'Lamina';
    const fullExam = (typeof globalExams !== 'undefined' && Array.isArray(globalExams))
      ? globalExams.find(e => e.code === ex.code || e.name === ex.name || (e.jalisCode && e.jalisCode === ex.code)) || ex
      : ex;

    if (Array.isArray(fullExam.materiaisColetados) && fullExam.materiaisColetados.length > 0) {
      const mat = fullExam.materiaisColetados[0];
      if (Array.isArray(mat.recipientesColeta) && mat.recipientesColeta.length > 0) {
        const rec = mat.recipientesColeta[0];
        if (rec.nome) return rec.nome;
      }
      if (mat.recipiente) return mat.recipiente;
      if (mat.nome) return mat.nome;
    }

    if (fullExam.tubo) return fullExam.tubo;
    if (fullExam.recipiente) return fullExam.recipiente;
    if (ex.tubo) return ex.tubo;

    return 'Lamina';
  }

  function getReqDateTimeStr(req) {
    let dateStr = '';
    let timeStr = '';

    if (req.fatura) dateStr = req.fatura;
    if (req.hora) timeStr = req.hora;

    if (!dateStr || !timeStr) {
      if (req.createdAt) {
        const parts = String(req.createdAt).split(',');
        if (parts[0]) dateStr = dateStr || parts[0].trim();
        if (parts[1]) {
          const timeParts = parts[1].trim().split(':');
          if (timeParts.length >= 2) {
            timeStr = timeStr || `${timeParts[0]}:${timeParts[1]}`;
          }
        }
      }
    }

    const now = new Date();
    if (!dateStr) dateStr = '28/07/2026';
    if (!timeStr) timeStr = '14:13';

    return { dateStr, timeStr };
  }

  function renderBarcodeCode128(svgElem, text) {
    if (!svgElem) return;
    if (typeof JsBarcode === 'function') {
      try {
        JsBarcode(svgElem, text, {
          format: "CODE128",
          height: 38,
          width: 1.6,
          displayValue: false,
          margin: 0
        });
        return;
      } catch(e) {}
    }

    const patterns = [
      "212222","222122","222221","121223","121322","131222","122213","122312","132212","221213",
      "221312","231212","112232","122132","122231","113222","123122","123221","223211","221132",
      "221231","213212","223112","312131","311222","321122","321221","312212","322112","322211",
      "212123","212321","232121","111323","131123","131321","112313","132113","132311","211313",
      "231113","231311","112133","112331","132131","113123","113321","133121","313121","211331",
      "231131","213113","213311","213131","311123","311321","331121","312113","312311","332111",
      "314111","221411","431111","111224","111422","121124","121421","141122","141221","112214",
      "112412","122114","122411","142112","142411","241211","221114","411112","421111","211142",
      "214112","412112","111114","111411","114111","114212","124112","124211","411211","421112",
      "421211","212141","214121","412121","111143","111341","131141","114113","114311","411113",
      "411311","113141","114131","311141","411131","211412","211214","211232","2331112"
    ];
    let code = [104];
    let checkSum = 104;
    for (let i = 0; i < text.length; i++) {
      const charCode = text.charCodeAt(i) - 32;
      if (charCode >= 0 && charCode <= 94) {
        code.push(charCode);
        checkSum += charCode * (i + 1);
      }
    }
    checkSum = checkSum % 103;
    code.push(checkSum);
    code.push(106);

    let barStr = "";
    code.forEach(idx => { barStr += patterns[idx] || ""; });

    let rects = "";
    let x = 0;
    for (let i = 0; i < barStr.length; i++) {
      const width = parseInt(barStr[i], 10);
      if (i % 2 === 0) {
        rects += `<rect x="${x}" y="0" width="${width * 1.5}" height="38" fill="#000" />`;
      }
      x += width * 1.5;
    }
    svgElem.setAttribute("viewBox", `0 0 ${x} 38`);
    svgElem.innerHTML = rects;
  }

  // --- AUXILIAR: OBTER CÓDIGO DO SETOR DO EXAME (2 DÍGITOS) ---
  function getExamSetorCodigo(ex) {
    if (!ex) return '01';

    const fullExam = (typeof globalExams !== 'undefined' && Array.isArray(globalExams))
      ? globalExams.find(e => e.code === ex.code || e.name === ex.name || (e.jalisCode && e.jalisCode === ex.code)) || ex
      : ex;

    let targetSetorName = '';
    let targetSetorCode = '';

    // 1. Array 'setores' do exame
    if (Array.isArray(fullExam.setores) && fullExam.setores.length > 0) {
      const firstSetor = fullExam.setores[0];
      if (typeof firstSetor === 'object' && firstSetor !== null) {
        if (firstSetor.codigo) targetSetorCode = String(firstSetor.codigo);
        if (firstSetor.descricao) targetSetorName = String(firstSetor.descricao);
      } else if (typeof firstSetor === 'string') {
        targetSetorName = firstSetor;
      }
    }

    // 2. Outras propriedades (setorBancada, category)
    if (!targetSetorName && !targetSetorCode) {
      if (Array.isArray(fullExam.materiaisColetados) && fullExam.materiaisColetados.length > 0) {
        const mat = fullExam.materiaisColetados[0];
        if (mat.setorBancada) targetSetorName = mat.setorBancada;
      }
      if (!targetSetorName && fullExam.setorBancada) {
        targetSetorName = fullExam.setorBancada;
      }
      if (!targetSetorName && fullExam.category) {
        targetSetorName = fullExam.category;
      }
      if (!targetSetorName && ex.category) {
        targetSetorName = ex.category;
      }
    }

    // 3. Buscar no array globalSetores do cadastro
    if (typeof globalSetores !== 'undefined' && Array.isArray(globalSetores) && globalSetores.length > 0) {
      if (targetSetorCode) {
        const matchByCode = globalSetores.find(s => String(s.codigo) === targetSetorCode || String(s.id) === targetSetorCode);
        if (matchByCode) return String(matchByCode.codigo).padStart(2, '0');
      }

      if (targetSetorName) {
        const cleanTarget = targetSetorName.trim().toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
        const matchByName = globalSetores.find(s => {
          const desc = String(s.descricao || '').trim().toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
          const sigla = String(s.sigla || '').trim().toLowerCase();
          return desc === cleanTarget || cleanTarget.includes(desc) || desc.includes(cleanTarget) || (sigla && sigla === cleanTarget);
        });
        if (matchByName) {
          return String(matchByName.codigo).padStart(2, '0');
        }
      }
    }

    // 4. Mapeamento fallback caso o nome não estivesse idêntico ao cadastro
    if (targetSetorName) {
      const norm = targetSetorName.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
      if (norm.includes('hemato')) return '01';
      if (norm.includes('bioquim')) return '02';
      if (norm.includes('imuno')) return '03';
      if (norm.includes('endocrin') || norm.includes('hormon')) return '04';
      if (norm.includes('bacterio') || norm.includes('microbio')) return '05';
      if (norm.includes('toxico')) return '06';
      if (norm.includes('citolog')) return '07';
      if (norm.includes('seminal') || norm.includes('esperm')) return '08';
      if (norm.includes('uroan') || norm.includes('urinal') || norm.includes('urina')) return '09';
      if (norm.includes('parasit') || norm.includes('fezes')) return '10';
      if (norm.includes('externo') || norm.includes('apoio')) return '11';
      if (norm.includes('coagul')) return '12';
    }

    return '01';
  }

