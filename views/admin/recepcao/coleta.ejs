<%- include('../../partials/header') %>
<script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>
<style>
  @media print {
    @page {
      size: auto;
      margin: 8mm;
    }
    body * {
      visibility: hidden !important;
    }
    #modalPrintLabels, #labels-preview-container, #labels-preview-container * {
      visibility: visible !important;
    }
    .no-print, .no-print * {
      display: none !important;
      visibility: hidden !important;
    }
    #modalPrintLabels {
      position: absolute !important;
      left: 0 !important;
      top: 0 !important;
      width: 100% !important;
      height: auto !important;
      background: white !important;
      padding: 0 !important;
      margin: 0 !important;
    }
    #modalPrintLabels > div {
      max-width: 100% !important;
      box-shadow: none !important;
      border: none !important;
      background: transparent !important;
    }
    #modalPrintLabels .bg-slate-900, #modalPrintLabels .bg-gray-50 {
      display: none !important;
    }

    /* MODO TÉRMICA ZEBRA / CONTINUA (1 POR PÁGINA / ROLO) */
    #modalPrintLabels.print-type-zebra .zebra-label-card {
      page-break-after: always !important;
      break-after: page !important;
      page-break-inside: avoid !important;
      break-inside: avoid !important;
      border: 1px solid #000 !important;
      box-shadow: none !important;
      margin-bottom: 20px !important;
      width: 100% !important;
    }

    /* MODO FOLHA A4 (VÁRIAS ETIQUETAS EM GRADE NA MESMA FOLHA A4) */
    #modalPrintLabels.print-type-a4 #labels-preview-container {
      display: flex !important;
      flex-wrap: wrap !important;
      gap: 5mm !important;
      padding: 0 !important;
      margin: 0 !important;
      width: 100% !important;
    }
    #modalPrintLabels.print-type-a4 .bg-slate-50 {
      background: transparent !important;
      border: none !important;
      padding: 0 !important;
      margin: 0 !important;
      display: contents !important;
    }
    #modalPrintLabels.print-type-a4 .space-y-3 {
      display: contents !important;
    }
    #modalPrintLabels.print-type-a4 .zebra-label-card {
      page-break-inside: avoid !important;
      break-inside: avoid !important;
      page-break-after: auto !important;
      break-after: auto !important;
      width: 90mm !important;
      min-height: 48mm !important;
      border: 1px solid #000 !important;
      box-shadow: none !important;
      margin: 0 !important;
      box-sizing: border-box !important;
    }
  }
</style>

<div class="p-4 sm:p-6 w-full max-w-full">
  
  <!-- CABEÇALHO DA TELA -->
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-6">
    <div>
      <div class="flex items-center gap-2 text-xs text-slate-500 font-mono uppercase tracking-wider mb-1">
        <span>Recepção LIS</span>
        <span>•</span>
        <span class="text-emerald-700 font-bold">Fase Pré-Analítica</span>
        <span>•</span>
        <span class="text-rose-600 font-bold">Posto de Coleta</span>
      </div>
      <h1 class="text-2xl font-black text-slate-800 flex items-center gap-2.5">
        <span class="p-2 bg-rose-100 text-rose-700 rounded-xl">🧪</span>
        Coleta de Materiais Biológicos
      </h1>
      <p class="text-xs text-slate-500 mt-1">
        Controle operacional da fila de atendimento, contagem automatizada de tubos por cor e confirmação de coleta.
      </p>
    </div>

    <!-- CARDS DE METRICAS DA FILA DA COLETA -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      <div class="bg-amber-50/80 border border-amber-200 rounded-2xl p-3 flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-amber-500 text-white flex items-center justify-center font-black text-lg shadow-sm">
          ⏳
        </div>
        <div>
          <div class="text-[10px] font-mono font-bold text-amber-800 uppercase tracking-wider">A Coletar</div>
          <div class="text-xl font-black text-amber-900 font-mono" id="stat-a-coletar">0</div>
        </div>
      </div>

      <div class="bg-rose-50/80 border border-rose-200 rounded-2xl p-3 flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-rose-600 text-white flex items-center justify-center font-black text-lg shadow-sm">
          🚨
        </div>
        <div>
          <div class="text-[10px] font-mono font-bold text-rose-800 uppercase tracking-wider">Urgentes</div>
          <div class="text-xl font-black text-rose-900 font-mono" id="stat-urgentes">0</div>
        </div>
      </div>

      <div class="bg-emerald-50/80 border border-emerald-200 rounded-2xl p-3 flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-emerald-600 text-white flex items-center justify-center font-black text-lg shadow-sm">
          ✅
        </div>
        <div>
          <div class="text-[10px] font-mono font-bold text-emerald-800 uppercase tracking-wider">Coletados Hoje</div>
          <div class="text-xl font-black text-emerald-900 font-mono" id="stat-coletados">0</div>
        </div>
      </div>

      <div class="bg-blue-50/80 border border-blue-200 rounded-2xl p-3 flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-blue-600 text-white flex items-center justify-center font-black text-lg shadow-sm">
          ⏱️
        </div>
        <div>
          <div class="text-[10px] font-mono font-bold text-blue-800 uppercase tracking-wider">Média Espera</div>
          <div class="text-lg font-black text-blue-900 font-mono" id="stat-media-espera">-- min</div>
        </div>
      </div>
    </div>
  </div>

  <!-- CONTEÚDO PRINCIPAL (SELEÇÃO DE PACIENTE VS MODO FOCO DE COLETA) -->
  <div id="coleta-main-container" class="w-full">

    <!-- ÁREA 1: SELEÇÃO DE PACIENTES NA FILA (EXIBIDO QUANDO NENHUM PACIENTE ESTÁ SELECIONADO) -->
    <div id="coleta-queue-container" class="w-full flex flex-col gap-4">
      
      <!-- BUSCA E FILTROS -->
      <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4 space-y-3">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-3">
          <div class="relative w-full sm:w-auto sm:flex-1">
            <svg class="w-4 h-4 text-gray-400 absolute left-3 top-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            <input type="text" id="coleta-search" oninput="filterColetaQueue()" placeholder="Buscar por paciente, código de requisição ou CPF..." class="w-full pl-9 pr-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-xs font-medium focus:ring-2 focus:ring-rose-500 focus:bg-white outline-none transition-all">
          </div>

          <div class="flex items-center gap-1.5 p-1 bg-gray-100/80 rounded-xl text-[11px] font-bold w-full sm:w-auto">
            <button type="button" onclick="setColetaTab('a_coletar')" id="tab-btn-a_coletar" class="coleta-tab-btn flex-1 sm:flex-initial py-1.5 px-3 rounded-lg text-center transition-all cursor-pointer bg-white text-slate-800 shadow-2xs font-extrabold">
              ⏳ A Coletar
            </button>
            <button type="button" onclick="setColetaTab('urgentes')" id="tab-btn-urgentes" class="coleta-tab-btn flex-1 sm:flex-initial py-1.5 px-3 rounded-lg text-center transition-all cursor-pointer text-gray-600 hover:text-slate-800">
              🚨 Urgentes
            </button>
            <button type="button" onclick="setColetaTab('coletados')" id="tab-btn-coletados" class="coleta-tab-btn flex-1 sm:flex-initial py-1.5 px-3 rounded-lg text-center transition-all cursor-pointer text-gray-600 hover:text-slate-800">
              ✅ Coletados
            </button>
          </div>
        </div>
      </div>

      <!-- LISTA DE PACIENTES DA FILA -->
      <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden flex-1 min-h-[450px] flex flex-col">
        <div class="p-4 border-b border-gray-100 bg-gray-50/50 flex items-center justify-between">
          <div>
            <span class="text-xs font-bold font-mono text-slate-800 uppercase tracking-wider flex items-center gap-1.5">
              <span>📋</span>
              <span>Fila de Pacientes para Coleta</span>
            </span>
            <p class="text-[11px] text-gray-500 mt-0.5">Selecione o paciente desejado na lista abaixo para abrir os detalhes e realizar a coleta de amostras.</p>
          </div>
          <span class="text-xs font-mono font-bold text-rose-700 bg-rose-50 border border-rose-200 px-3 py-1 rounded-full" id="queue-count-badge">0 em espera</span>
        </div>

        <div id="coleta-queue-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 p-4 overflow-y-auto max-h-[700px]">
          <!-- Renderizado via JavaScript -->
        </div>
      </div>

    </div>

    <!-- ÁREA 2: PAINEL DE DETALHES E GUIA DE TUBOS DA COLETA (EXIBIDO QUANDO UM PACIENTE É SELECIONADO) -->
    <div id="coleta-details-column" class="w-full hidden space-y-5">
      
      <!-- BARRINHA SUPERIOR COM BOTÃO VOLTAR PARA A SELEÇÃO -->
      <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4 flex flex-wrap items-center justify-between gap-3">
        <button type="button" onclick="clearSelectedColeta()" class="px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white font-extrabold rounded-xl text-xs transition-all flex items-center gap-2 cursor-pointer shadow-sm">
          <span>←</span>
          <span>Voltar para Seleção de Pacientes</span>
        </button>
      </div>

      <!-- CARTOES DE DETALHES DA COLETA (SELECIONADO) -->
      <div id="coleta-details-panel" class="space-y-5">
        
        <!-- CARD 1: DADOS DO PACIENTE E ATENDIMENTO -->
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 space-y-4">
          <div class="flex flex-wrap items-center justify-between gap-3 border-b border-gray-100 pb-3">
            <div class="flex items-center gap-3">
              <span class="text-xs font-mono font-extrabold px-3 py-1 rounded-xl bg-slate-900 text-emerald-400" id="det-req-code">#----</span>
              <span class="px-3 py-1 rounded-full text-xs font-extrabold font-mono uppercase bg-amber-100 text-amber-900 border border-amber-300" id="det-req-status-badge">A Coletar</span>
              <span class="px-3 py-1 rounded-full text-xs font-extrabold font-mono bg-emerald-100 text-emerald-900 border border-emerald-300 hidden" id="det-req-collected-badge">✅ Coletado em: --/--/---- --:--</span>
              <span class="px-2.5 py-1 rounded-full text-xs font-extrabold font-mono bg-rose-100 text-rose-800 border border-rose-200 hidden" id="det-req-urgent-badge">🚨 URGENTE</span>
            </div>

            <div class="flex items-center gap-2">
              <button type="button" onclick="triggerChamarPaciente()" class="px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-800 font-black rounded-xl text-xs transition-all inline-flex items-center gap-1.5 cursor-pointer shadow-2xs">
                <span>📢</span> Chamar Paciente
              </button>
              <button type="button" onclick="openLabelPrintModal()" class="px-3 py-1.5 bg-rose-50 hover:bg-rose-100 text-rose-800 border border-rose-200 font-black rounded-xl text-xs transition-all inline-flex items-center gap-1.5 cursor-pointer shadow-2xs">
                <span>🖨️</span> Imprimir Etiquetas
              </button>
            </div>
          </div>

          <!-- GRADE DE INFORMACÕES DO PACIENTE -->
          <div class="grid grid-cols-1 md:grid-cols-4 lg:grid-cols-5 gap-4 bg-gray-50/70 p-4 rounded-xl border border-gray-100">
            <div class="md:col-span-2">
              <span class="text-[10px] font-mono text-gray-400 font-bold uppercase tracking-wider block">Paciente</span>
              <div class="text-sm font-black text-slate-800" id="det-patient-name">---</div>
              <div class="text-xs text-gray-500 font-mono mt-0.5" id="det-patient-meta">---</div>
            </div>

            <div>
              <span class="text-[10px] font-mono text-gray-400 font-bold uppercase tracking-wider block">Convênio / Plano</span>
              <div class="text-xs font-black text-slate-700" id="det-req-convenio">---</div>
              <div class="text-[11px] text-gray-500 font-mono" id="det-req-date">---</div>
            </div>

            <div>
              <span class="text-[10px] font-mono text-gray-400 font-bold uppercase tracking-wider block">Médico / Solicitante</span>
              <div class="text-xs font-bold text-slate-700" id="det-req-doctor">---</div>
              <div class="text-[11px] text-gray-500" id="det-req-user">---</div>
            </div>

            <div id="det-req-coleta-block" class="bg-emerald-50/70 p-2.5 rounded-xl border border-emerald-200">
              <span class="text-[10px] font-mono text-emerald-800 font-bold uppercase tracking-wider block">💉 Data da Coleta</span>
              <div class="text-xs font-black text-emerald-950 font-mono mt-0.5" id="det-req-coleta-date">--/--/---- --:--</div>
              <div class="text-[10px] text-emerald-700 font-semibold mt-0.5" id="det-req-coleta-sub">Status: A Coletar</div>
            </div>
          </div>

          <!-- NOTAS DE JEJUM E CLINICAS -->
          <div id="det-req-notes-container" class="p-3 bg-amber-50/60 border border-amber-200 rounded-xl text-xs text-amber-900 space-y-1">
            <div class="font-black flex items-center gap-1.5 text-amber-800">
              <span>📋</span> Recomendações de Jejum & Observações Clínicas:
            </div>
            <div id="det-req-notes-content" class="font-medium text-amber-950">
              Sem observações específicas cadastradas.
            </div>
          </div>
        </div>

        <!-- CARD 2: TABELA DE EXAMES SOLICITADOS -->
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden p-5 space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-gray-100 pb-3">
            <div>
              <h3 class="text-xs font-bold font-mono text-slate-800 uppercase tracking-wider flex items-center gap-1.5">
                <span>📋</span> Exames Solicitados na Requisição
              </h3>
              <p class="text-[11px] text-gray-500 mt-0.5">Agrupados por tipo de tubo/recipiente e material biológico com volumes recomendados.</p>
            </div>
            <div class="flex items-center gap-2">
              <button type="button" onclick="expandAllExamGroups()" class="text-[10px] font-mono font-bold text-slate-600 bg-slate-100 hover:bg-slate-200 px-2 py-1 rounded-lg border border-slate-200 transition-colors cursor-pointer flex items-center gap-1">
                <span>📂</span> Expandir
              </button>
              <button type="button" onclick="collapseAllExamGroups()" class="text-[10px] font-mono font-bold text-slate-600 bg-slate-100 hover:bg-slate-200 px-2 py-1 rounded-lg border border-slate-200 transition-colors cursor-pointer flex items-center gap-1">
                <span>📁</span> Recolher
              </button>
              <span class="text-xs font-mono font-bold text-slate-500 bg-slate-100 px-2.5 py-1 rounded-full border border-slate-200" id="det-exams-count">0 exames</span>
            </div>
          </div>

          <div id="det-exams-grouped-container" class="space-y-4">
            <!-- Renderizado dinamicamente via JavaScript -->
          </div>
        </div>

        <!-- CARD 3: CONTAGEM DE TUBOS E INFORMAÇÕES DE COLETA (DESTAQUE DA SOLICITAÇÃO DO USUÁRIO) -->
        <div id="det-tubes-card-container" class="bg-white rounded-2xl border border-rose-200 shadow-sm p-5 space-y-4 hidden transition-all">
          
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-rose-100 pb-3">
            <div>
              <h3 class="text-sm font-black text-rose-950 flex items-center gap-2">
                <span>🧪</span>
                <span>Tubos & Recipientes Necessários para a Coleta</span>
              </h3>
              <p class="text-[11px] text-rose-800/80 mt-0.5">
                Contagem automatizada por cor de tampa e frasco recomendados para os exames desta requisição.
              </p>
            </div>
            
            <div class="inline-flex items-center gap-1.5 bg-rose-600 text-white font-mono font-black text-xs px-3 py-1.5 rounded-xl shadow-2xs self-start sm:self-auto">
              <span>📦 Total:</span>
              <span id="det-tubes-total-count">0 recipientes</span>
            </div>
          </div>

          <!-- CARDS VISUAIS DE QUANTIDADE POR COR DE TUBO -->
          <div id="det-tubes-summary-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
            <!-- Renderizado via JS -->
          </div>

          <!-- PAINEL DE GUIA / INSTRUÇÕES TÉCNICAS DE COLETA -->
          <div class="bg-rose-50/50 border border-rose-200/80 rounded-xl p-4 space-y-2">
            <h4 class="text-xs font-black text-rose-900 font-mono uppercase tracking-wider flex items-center gap-1.5">
              <span>💡</span> Informações Técnicas de Coleta & Procedimento:
            </h4>
            <div id="det-tubes-instructions-list" class="text-xs text-slate-700 space-y-2 font-medium">
              <!-- Renderizado via JS -->
            </div>
          </div>

        </div>

        <!-- CARD 4: BARRA DE AÇÕES DA COLETA (ANOTAÇÕES DA COLETA) -->
        <div id="det-obs-card-container" class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hidden transition-all">
          <div class="flex-1">
            <label class="block text-[11px] font-bold text-gray-600 font-mono mb-1">Anotações do Coletador / Observações da Amostra (Opcional):</label>
            <input type="text" id="det-coleta-obs" placeholder="Ex: Coleta difícil (acesso venoso), amostra sem intercorrências..." class="w-full px-3 py-1.5 bg-gray-50 border border-gray-300 rounded-xl text-xs font-bold text-slate-800 outline-none focus:ring-2 focus:ring-rose-500">
          </div>

          <div class="flex items-center justify-end gap-3 shrink-0">
            <button type="button" onclick="toggleObsCard()" class="px-4 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold rounded-xl text-xs transition-all cursor-pointer">
              Cancelar
            </button>
            <button type="button" onclick="confirmarColetaFinalizada()" id="btn-confirmar-coleta" class="px-6 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-black rounded-xl text-xs shadow-md hover:shadow-lg transition-all inline-flex items-center gap-2 cursor-pointer">
              <span>📝</span> Adicionar anotação
            </button>
          </div>
        </div>

      </div>

    </div>

  </div>

</div>

<!-- MODAL DE PREVIEW DE ETIQUETAS DE CÓDIGO DE BARRAS -->
<div id="modalPrintLabels" class="fixed inset-0 z-[100] bg-black/75 backdrop-blur-sm flex items-center justify-center p-4 hidden">
  <div class="bg-white rounded-2xl max-w-2xl w-full overflow-hidden shadow-2xl border border-gray-100">
    <div class="p-4 bg-slate-900 text-white flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="text-lg">🖨️</span>
        <h3 class="font-black text-sm font-mono">Impressão de Etiquetas para Tubos (Zebra / Argox)</h3>
      </div>
      <button onclick="closeLabelPrintModal()" class="text-gray-400 hover:text-white font-bold text-lg cursor-pointer">&times;</button>
    </div>

    <div class="p-6 space-y-4 max-h-[70vh] overflow-y-auto" id="labels-preview-container">
      <!-- Gerado via JS -->
    </div>

    <div class="p-4 bg-gray-50 border-t border-gray-200 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
      <div class="flex items-center gap-2">
        <label for="selectPrintMode" class="text-xs font-bold text-slate-700 flex items-center gap-1">
          <span>🖨️</span> Impressão:
        </label>
        <select id="selectPrintMode" onchange="setPrintMode(this.value)" class="bg-white border border-slate-300 rounded-lg px-2.5 py-1.5 text-xs font-bold text-slate-800 shadow-2xs focus:ring-2 focus:ring-rose-500 focus:outline-none cursor-pointer">
          <option value="a4" selected>📄 Folha A4 (Várias etiquetas/página)</option>
          <option value="zebra">🏷️ Térmica / Zebra (1 por página)</option>
          <option value="epl">📟 Térmica EPL / EPL2 (50x30mm / 203 DPI)</option>
        </select>
      </div>

      <div class="flex flex-wrap items-center justify-end gap-2">
        <button type="button" onclick="copyEplCommandsAll()" class="px-3 py-1.5 bg-amber-500 hover:bg-amber-600 text-slate-950 font-black rounded-lg text-xs flex items-center gap-1.5 cursor-pointer shadow-2xs transition-all active:scale-95" title="Copiar código EPL2 de todas as etiquetas para a área de transferência">
          <span>📋</span> Copiar EPL2
        </button>
        <button type="button" onclick="printEplDirectAll()" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white font-black rounded-lg text-xs flex items-center gap-1.5 cursor-pointer shadow-2xs transition-all active:scale-95" title="Enviar impressão EPL2 diretamente para a impressora térmica">
          <span>📡</span> Imprimir EPL (REST)
        </button>
        <button type="button" onclick="closeLabelPrintModal()" class="px-3 py-1.5 bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold rounded-lg text-xs cursor-pointer transition-colors">Fechar</button>
        <button type="button" onclick="simulateZebraPrint()" class="px-4 py-1.5 bg-rose-600 hover:bg-rose-700 text-white font-black rounded-lg text-xs flex items-center gap-1.5 cursor-pointer shadow-2xs transition-all active:scale-95">
          <span>🖨️</span> Imprimir A4/Web
        </button>
      </div>
    </div>
  </div>
</div>

<!-- MODAL DE ALTERAÇÃO DE STATUS DE EXAME INDIVIDUAL -->
<div id="modalChangeExamStatus" class="fixed inset-0 z-[110] bg-black/75 backdrop-blur-sm flex items-center justify-center p-4 hidden">
  <div class="bg-white rounded-2xl max-w-sm w-full overflow-hidden shadow-2xl border border-gray-100">
    <div class="p-4 bg-slate-900 text-white flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="text-lg">✏️</span>
        <h3 class="font-black text-xs font-mono">Alterar Status do Exame</h3>
      </div>
      <button onclick="closeChangeExamStatusModal()" class="text-gray-400 hover:text-white font-bold text-lg cursor-pointer">&times;</button>
    </div>

    <div class="p-5 space-y-3">
      <p class="text-xs font-bold text-slate-800" id="modal-exam-title">Exame: ---</p>
      <p class="text-[11px] text-gray-500">Selecione abaixo o novo status desejado para este exame:</p>

      <div class="space-y-2 pt-2">
        <button type="button" onclick="applyNewExamStatus('A Coletar')" class="w-full text-left px-3.5 py-2.5 rounded-xl bg-amber-50 hover:bg-amber-100 text-amber-950 border border-amber-300 font-mono text-xs font-bold transition-all flex items-center justify-between cursor-pointer">
          <span class="flex items-center gap-2"><span>⏳</span> A Coletar</span>
          <span class="text-[10px] opacity-75">Pendente</span>
        </button>

        <button type="button" onclick="applyNewExamStatus('Coletado')" class="w-full text-left px-3.5 py-2.5 rounded-xl bg-emerald-50 hover:bg-emerald-100 text-emerald-950 border border-emerald-300 font-mono text-xs font-bold transition-all flex items-center justify-between cursor-pointer">
          <span class="flex items-center gap-2"><span>✅</span> Coletado</span>
          <span class="text-[10px] opacity-75">Amostra Obtida</span>
        </button>

        <button type="button" onclick="applyNewExamStatus('Em Análise')" class="w-full text-left px-3.5 py-2.5 rounded-xl bg-blue-50 hover:bg-blue-100 text-blue-950 border border-blue-300 font-mono text-xs font-bold transition-all flex items-center justify-between cursor-pointer">
          <span class="flex items-center gap-2"><span>🔬</span> Em Análise</span>
          <span class="text-[10px] opacity-75">Na Triagem</span>
        </button>

        <button type="button" onclick="applyNewExamStatus('Concluído')" class="w-full text-left px-3.5 py-2.5 rounded-xl bg-purple-50 hover:bg-purple-100 text-purple-950 border border-purple-300 font-mono text-xs font-bold transition-all flex items-center justify-between cursor-pointer">
          <span class="flex items-center gap-2"><span>🎉</span> Concluído</span>
          <span class="text-[10px] opacity-75">Laudo Pronto</span>
        </button>

        <button type="button" onclick="applyNewExamStatus('Cancelado')" class="w-full text-left px-3.5 py-2.5 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-950 border border-rose-300 font-mono text-xs font-bold transition-all flex items-center justify-between cursor-pointer">
          <span class="flex items-center gap-2"><span>❌</span> Cancelado</span>
          <span class="text-[10px] opacity-75">Descontinuado</span>
        </button>
      </div>
    </div>

    <div class="p-3 bg-gray-50 border-t border-gray-200 text-right">
      <button type="button" onclick="closeChangeExamStatusModal()" class="px-4 py-1.5 bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold rounded-xl text-xs cursor-pointer">Cancelar</button>
    </div>
  </div>
</div>

<script>
  // Dados globais passados pelo backend EJS
  const globalRequisitions = <%- JSON.stringify(requisitions || []) %>;
  const globalExams = <%- JSON.stringify(exams || []) %>;
  const globalRecipientes = <%- JSON.stringify(recipientes || []) %>;
  const globalSetores = <%- JSON.stringify(setores || []) %>;
  const globalPatients = <%- JSON.stringify(patients || []) %>;

  let currentTab = 'a_coletar'; // 'a_coletar', 'urgentes', 'coletados'
  let selectedReqId = null;
  let targetExamCodeForEdit = null;

  document.addEventListener('DOMContentLoaded', () => {
    updateColetaStats();
    renderColetaQueue();
  });

  // --- MÉTODOS DE ESTATÍSTICA ---
  function updateColetaStats() {
    const aColetar = globalRequisitions.filter(r => (r.status || 'A Coletar') === 'A Coletar');
    const urgentes = aColetar.filter(r => r.isUrgent);
    const coletados = globalRequisitions.filter(r => r.status === 'Coletado');

    document.getElementById('stat-a-coletar').textContent = aColetar.length;
    document.getElementById('stat-urgentes').textContent = urgentes.length;
    document.getElementById('stat-coletados').textContent = coletados.length;

    // Calcular tempo médio de espera
    if (aColetar.length > 0) {
      let totalMinutes = 0;
      aColetar.forEach(r => {
        totalMinutes += getMinutesElapsed(r.createdAt);
      });
      const avg = Math.round(totalMinutes / aColetar.length);
      document.getElementById('stat-media-espera').textContent = avg + ' min';
    } else {
      document.getElementById('stat-media-espera').textContent = '0 min';
    }
  }

  function getMinutesElapsed(createdAtStr) {
    if (!createdAtStr) return 10; // fallback padrao
    try {
      // Ex: "28/07/2026, 10:03:04" ou ISO
      let dateObj;
      if (createdAtStr.includes('/')) {
        const parts = createdAtStr.split(',');
        const dateParts = parts[0].trim().split('/');
        const timeParts = parts[1] ? parts[1].trim().split(':') : ['08', '00', '00'];
        dateObj = new Date(dateParts[2], dateParts[1] - 1, dateParts[0], timeParts[0], timeParts[1], timeParts[2] || 0);
      } else {
        dateObj = new Date(createdAtStr);
      }
      const diffMs = new Date() - dateObj;
      const diffMins = Math.floor(diffMs / (1000 * 60));
      return diffMins > 0 ? diffMins : 5;
    } catch (e) {
      return 15;
    }
  }

  function formatColetaDateTime(collectedAtRaw, req) {
    let dt = null;
    if (collectedAtRaw) {
      dt = new Date(collectedAtRaw);
    }
    if (!dt || isNaN(dt.getTime())) {
      if (req && req.collectedAt) {
        dt = new Date(req.collectedAt);
      } else if (req && req.updatedAt && (req.status === 'Coletado' || req.triado)) {
        dt = new Date(req.updatedAt);
      }
    }
    if (!dt || isNaN(dt.getTime())) {
      if (req && req.fatura) {
        return `${req.fatura} às ${req.hora || '10:00'}`;
      }
      return 'Data N/I';
    }
    const d = String(dt.getDate()).padStart(2, '0');
    const m = String(dt.getMonth() + 1).padStart(2, '0');
    const y = dt.getFullYear();
    const h = String(dt.getHours()).padStart(2, '0');
    const min = String(dt.getMinutes()).padStart(2, '0');
    return `${d}/${m}/${y} às ${h}:${min}`;
  }

  // --- FILTROS E ABAS ---
  function setColetaTab(tab) {
    currentTab = tab;
    document.querySelectorAll('.coleta-tab-btn').forEach(btn => {
      btn.className = 'coleta-tab-btn flex-1 py-1.5 px-2 rounded-lg text-center transition-all cursor-pointer text-gray-600 hover:text-slate-800';
    });
    const activeBtn = document.getElementById(`tab-btn-${tab}`);
    if (activeBtn) {
      activeBtn.className = 'coleta-tab-btn flex-1 py-1.5 px-2 rounded-lg text-center transition-all cursor-pointer bg-white text-slate-800 shadow-2xs font-extrabold';
    }
    renderColetaQueue();
  }

  function filterColetaQueue() {
    renderColetaQueue();
  }

  // --- RENDERIZAR FILA DE PACIENTES ---
  function renderColetaQueue() {
    const listContainer = document.getElementById('coleta-queue-list');
    const searchVal = (document.getElementById('coleta-search').value || '').toLowerCase().trim();

    let filtered = globalRequisitions.filter(r => {
      const st = r.status || 'A Coletar';
      if (currentTab === 'a_coletar') return st === 'A Coletar';
      if (currentTab === 'urgentes') return st === 'A Coletar' && r.isUrgent;
      if (currentTab === 'coletados') return st === 'Coletado';
      return true;
    });

    if (searchVal) {
      filtered = filtered.filter(r => {
        const name = (r.patientName || '').toLowerCase();
        const code = (r.requisitionCode || r.id || '').toLowerCase();
        const cpf = (r.patientCpf || '').toLowerCase();
        const doctor = (r.doctorName || '').toLowerCase();
        return name.includes(searchVal) || code.includes(searchVal) || cpf.includes(searchVal) || doctor.includes(searchVal);
      });
    }

    // Ordenar urgentes primeiro, depois por tempo de espera
    filtered.sort((a, b) => {
      if (a.isUrgent && !b.isUrgent) return -1;
      if (!a.isUrgent && b.isUrgent) return 1;
      return getMinutesElapsed(b.createdAt) - getMinutesElapsed(a.createdAt);
    });

    document.getElementById('queue-count-badge').textContent = `${filtered.length} na fila`;

    if (filtered.length === 0) {
      listContainer.innerHTML = `
        <div class="p-8 text-center text-gray-400 text-xs font-mono">
          Nenhum paciente encontrado com os filtros selecionados.
        </div>
      `;
      return;
    }

    listContainer.innerHTML = '';
    filtered.forEach(req => {
      const isSelected = selectedReqId === req.id;
      const mins = getMinutesElapsed(req.createdAt);

      const card = document.createElement('div');
      card.className = `p-3 rounded-xl border transition-all cursor-pointer select-none space-y-2 ${
        isSelected
          ? 'bg-rose-50/80 border-rose-500 shadow-sm ring-2 ring-rose-400'
          : req.isUrgent
          ? 'bg-rose-50/40 border-rose-200 hover:bg-rose-50/70'
          : 'bg-white border-gray-100 hover:border-gray-300 hover:bg-gray-50/80'
      }`;
      card.onclick = () => selectRequisitionToCollect(req.id);

      const reqCodeDisplay = `#${req.requisitionCode || req.id}`;
      const examNames = (req.exams || []).map(e => e.name).slice(0, 3).join(', ');
      const extraExamsCount = (req.exams || []).length > 3 ? `+${(req.exams || []).length - 3}` : '';

      card.innerHTML = `
        <div class="flex items-center justify-between text-xs">
          <div class="flex items-center gap-1.5 font-mono font-black text-slate-800">
            <span class="px-2 py-0.5 rounded bg-slate-900 text-emerald-400 text-[11px]">${reqCodeDisplay}</span>
            ${req.isUrgent ? '<span class="px-1.5 py-0.5 rounded bg-rose-600 text-white text-[9px] font-extrabold uppercase">🚨 URGENTE</span>' : ''}
          </div>
          ${(req.status === 'Coletado' || req.triado || req.collectedAt)
            ? `<span class="text-[10px] font-mono text-emerald-800 font-extrabold flex items-center gap-1 bg-emerald-50 px-2 py-0.5 rounded-md border border-emerald-200" title="Data da Coleta">✅ ${formatColetaDateTime(req.collectedAt, req)}</span>`
            : `<span class="text-[10px] font-mono text-gray-500 font-bold flex items-center gap-1">⏱️ ${mins} min</span>`
          }
        </div>

        <div>
          <div class="font-black text-xs text-slate-900 leading-snug">${req.patientName || 'Paciente Não Informado'}</div>
          <div class="text-[10px] text-gray-500 font-mono mt-0.5 flex items-center gap-2">
            <span>${req.patientAge || 'Idade N/I'}</span>
            <span>•</span>
            <span class="font-bold text-slate-700">${req.convenio || 'Particular'}</span>
          </div>
        </div>

        <div class="text-[10px] text-slate-600 font-mono bg-gray-100/70 px-2 py-1 rounded-lg truncate">
          🧪 ${examNames || 'Nenhum exame'} ${extraExamsCount}
        </div>
      `;

      listContainer.appendChild(card);
    });
  }

  // --- SELECIONAR REQUISIÇÃO PARA COLETA ---
  function selectRequisitionToCollect(reqId) {
    selectedReqId = reqId;

    const req = globalRequisitions.find(r => r.id === reqId);
    if (!req) return;

    // Ocultar a área de seleção de pacientes e exibir o modo foco da coleta
    const queueContainer = document.getElementById('coleta-queue-container');
    const detailsCol = document.getElementById('coleta-details-column');
    if (queueContainer) queueContainer.classList.add('hidden');
    if (detailsCol) detailsCol.classList.remove('hidden');

    window.scrollTo({ top: 0, behavior: 'smooth' });

    // Header Meta
    document.getElementById('det-req-code').textContent = `#${req.requisitionCode || req.id}`;
    
    const stBadge = document.getElementById('det-req-status-badge');
    stBadge.textContent = req.status || 'A Coletar';
    if (req.status === 'Coletado') {
      stBadge.className = 'px-3 py-1 rounded-full text-xs font-extrabold font-mono uppercase bg-emerald-100 text-emerald-900 border border-emerald-300';
    } else {
      stBadge.className = 'px-3 py-1 rounded-full text-xs font-extrabold font-mono uppercase bg-amber-100 text-amber-900 border border-amber-300';
    }

    const urgentBadge = document.getElementById('det-req-urgent-badge');
    if (req.isUrgent) urgentBadge.classList.remove('hidden');
    else urgentBadge.classList.add('hidden');

    // Data / Hora da Coleta
    const isColetado = req.status === 'Coletado' || req.triado || req.collectedAt;
    const collectedBadge = document.getElementById('det-req-collected-badge');
    const coletaDateEl = document.getElementById('det-req-coleta-date');
    const coletaSubEl = document.getElementById('det-req-coleta-sub');
    const coletaBlock = document.getElementById('det-req-coleta-block');

    if (isColetado) {
      const formattedColetaDate = formatColetaDateTime(req.collectedAt, req);
      if (collectedBadge) {
        collectedBadge.textContent = `✅ Coletado em: ${formattedColetaDate}`;
        collectedBadge.classList.remove('hidden');
      }
      if (coletaDateEl) coletaDateEl.textContent = formattedColetaDate;
      if (coletaSubEl) coletaSubEl.textContent = `Local: ${req.coleta || 'Sede / Central'}`;
      if (coletaBlock) {
        coletaBlock.className = 'bg-emerald-50 p-2.5 rounded-xl border border-emerald-300 shadow-2xs';
      }
    } else {
      if (collectedBadge) collectedBadge.classList.add('hidden');
      if (coletaDateEl) coletaDateEl.textContent = 'Pendente';
      if (coletaSubEl) coletaSubEl.textContent = 'Aguardando Coleta';
      if (coletaBlock) {
        coletaBlock.className = 'bg-amber-50/70 p-2.5 rounded-xl border border-amber-200';
      }
    }

    // Paciente
    document.getElementById('det-patient-name').textContent = req.patientName || 'Não informado';
    document.getElementById('det-patient-meta').textContent = `${req.patientAge || 'Idade N/I'} • Sexo: ${req.patientSex || 'N/I'} • CPF: ${req.patientCpf || 'Sem CPF'}`;
    document.getElementById('det-req-convenio').textContent = req.convenio || 'Particular';
    document.getElementById('det-req-date').textContent = `Fatura: ${req.fatura || 'Hoje'} às ${req.hora || '10:00'}`;
    document.getElementById('det-req-doctor').textContent = req.doctorName || 'Sem solicitação declarada';
    document.getElementById('det-req-user').textContent = `Coleta: ${req.coleta || 'Sede'} / ${req.destino || 'Principal'}`;

    // Observações
    const notesContent = document.getElementById('det-req-notes-content');
    let notesText = [];
    if (req.fasting) notesText.push(`Jejum exigido: ${req.fasting}`);
    if (req.clinicalNotes) notesText.push(`Observações Clínicas: ${req.clinicalNotes}`);
    if (req.obs) notesText.push(`Obs. Atendimento: ${req.obs}`);

    notesContent.textContent = notesText.length > 0 ? notesText.join(' | ') : 'Sem recomendações especiais cadastradas.';

    // Tabela/Lista de Exames Agrupados por Tipo de Tubo e Material
    const groupedContainer = document.getElementById('det-exams-grouped-container');
    if (groupedContainer) groupedContainer.innerHTML = '';

    const reqExams = req.exams || [];
    document.getElementById('det-exams-count').textContent = `${reqExams.length} exame(s)`;

    // Processar informações de tubo, material e volume para cada exame
    const processedExams = reqExams.map(ex => getExamTubeAndMaterialInfo(ex));

    // Agrupar por chave: `${tubo}___${material}`
    const groups = {};
    processedExams.forEach(info => {
      const groupKey = `${info.tubo}___${info.material}`;
      if (!groups[groupKey]) {
        groups[groupKey] = {
          tubo: info.tubo,
          material: info.material,
          icon: info.icon,
          colorTheme: info.colorTheme,
          exams: [],
          totalVolume: 0,
          uni: info.uni
        };
      }
      groups[groupKey].exams.push(info);
      groups[groupKey].totalVolume += info.volume;
    });

    const groupKeys = Object.keys(groups);
    if (groupKeys.length === 0 && groupedContainer) {
      groupedContainer.innerHTML = `
        <div class="p-6 text-center text-gray-400 text-xs font-mono">
          Nenhum exame associado a esta requisição.
        </div>
      `;
    } else if (groupedContainer) {
      groupKeys.forEach((key, idx) => {
        const grp = groups[key];
        const groupCard = document.createElement('div');
        
        let headerBg = 'bg-slate-50 border-gray-200 text-slate-900';
        let materialBadgeClass = 'bg-gray-100 text-gray-800 border-gray-300';
        let volBadgeClass = 'bg-slate-200/90 text-slate-800 border-slate-300';
        
        if (grp.colorTheme === 'purple') {
          headerBg = 'bg-purple-50/90 border-purple-200 text-purple-950';
          materialBadgeClass = 'bg-purple-100 text-purple-900 border-purple-300';
          volBadgeClass = 'bg-purple-200/80 text-purple-950 border-purple-300';
        } else if (grp.colorTheme === 'blue') {
          headerBg = 'bg-blue-50/90 border-blue-200 text-blue-950';
          materialBadgeClass = 'bg-blue-100 text-blue-900 border-blue-300';
          volBadgeClass = 'bg-blue-200/80 text-blue-950 border-blue-300';
        } else if (grp.colorTheme === 'gray') {
          headerBg = 'bg-slate-100 border-slate-300 text-slate-900';
          materialBadgeClass = 'bg-slate-200 text-slate-900 border-slate-300';
          volBadgeClass = 'bg-slate-300/80 text-slate-900 border-slate-400';
        } else if (grp.colorTheme === 'yellow') {
          headerBg = 'bg-amber-50/90 border-amber-200 text-amber-950';
          materialBadgeClass = 'bg-amber-100 text-amber-900 border-amber-300';
          volBadgeClass = 'bg-amber-200/80 text-amber-950 border-amber-300';
        } else if (grp.colorTheme === 'orange') {
          headerBg = 'bg-orange-50/90 border-orange-200 text-orange-950';
          materialBadgeClass = 'bg-orange-100 text-orange-900 border-orange-300';
          volBadgeClass = 'bg-orange-200/80 text-orange-950 border-orange-300';
        } else if (grp.colorTheme === 'amber') {
          headerBg = 'bg-rose-50/80 border-rose-200 text-rose-950';
          materialBadgeClass = 'bg-rose-100 text-rose-900 border-rose-300';
          volBadgeClass = 'bg-rose-200/80 text-rose-950 border-rose-300';
        }

        const totalVolFormatted = grp.totalVolume.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 3 }) + ' ' + grp.uni;

        let suggestedTubesCount = 1;
        if (grp.colorTheme === 'amber' && grp.exams.length > 5) {
          suggestedTubesCount = Math.ceil(grp.exams.length / 5);
        } else if (grp.totalVolume > 5.0 && grp.uni === 'mL') {
          suggestedTubesCount = Math.ceil(grp.totalVolume / 4.0);
        }

        groupCard.className = 'rounded-xl border border-gray-200 overflow-hidden shadow-2xs transition-all';
        
        let rowsHtml = grp.exams.map(exInfo => {
          const volFormatted = exInfo.volume.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 3 }) + ' ' + exInfo.uni;
          const statusStr = exInfo.status || 'A Coletar';

          let statusBadgeClass = 'bg-amber-100 text-amber-950 border-amber-300';
          let statusIcon = '⏳';
          if (statusStr === 'Coletado' || statusStr === 'Coletada') {
            statusBadgeClass = 'bg-emerald-100 text-emerald-950 border-emerald-300';
            statusIcon = '✅';
          } else if (statusStr === 'Em Análise' || statusStr === 'Em Analise') {
            statusBadgeClass = 'bg-blue-100 text-blue-950 border-blue-300';
            statusIcon = '🔬';
          } else if (statusStr === 'Concluído' || statusStr === 'Concluido') {
            statusBadgeClass = 'bg-purple-100 text-purple-950 border-purple-300';
            statusIcon = '🎉';
          } else if (statusStr === 'Cancelado') {
            statusBadgeClass = 'bg-rose-100 text-rose-950 border-rose-300';
            statusIcon = '❌';
          }

          const escapedCode = String(exInfo.code || '').replace(/'/g, "\\'");

          return `
            <tr class="hover:bg-gray-50/80 transition-colors">
              <td class="p-2.5 font-mono font-black text-slate-900">${exInfo.code}</td>
              <td class="p-2.5 font-bold text-slate-900">${exInfo.name}</td>
              <td class="p-2.5 text-center">
                <div class="inline-flex items-center justify-center gap-1.5">
                  <span class="inline-flex items-center gap-1 font-mono text-[10px] font-extrabold px-2 py-0.5 rounded border ${statusBadgeClass}">
                    <span>${statusIcon}</span> ${statusStr}
                  </span>
                  <button type="button" 
                          onclick="openChangeExamStatusModal('${escapedCode}')" 
                          title="Alterar status do exame ${exInfo.code}" 
                          class="p-1 text-slate-600 hover:text-slate-900 bg-gray-100 hover:bg-gray-200 border border-gray-300 rounded-md transition-all cursor-pointer text-xs">
                    ✏️
                  </button>
                </div>
              </td>
              <td class="p-2.5 font-mono text-gray-600 text-[11px]">${exInfo.fasting}</td>
              <td class="p-2.5 font-mono text-gray-500 text-[11px]">${exInfo.timeframe}</td>
              <td class="p-2.5 text-right font-mono font-black text-emerald-800 bg-emerald-50/40">
                <span class="inline-flex items-center gap-1 bg-emerald-100/90 text-emerald-950 px-2 py-0.5 rounded border border-emerald-300">
                  <span>💧</span> ${volFormatted}
                </span>
              </td>
            </tr>
          `;
        }).join('');

        const escapedTubo = String(grp.tubo || '').replace(/'/g, "\\'");
        const escapedMaterial = String(grp.material || '').replace(/'/g, "\\'");

        groupCard.innerHTML = `
          <div onclick="toggleGroupCollapse(${idx})" class="px-4 py-3 border-b flex flex-col sm:flex-row sm:items-center justify-between gap-2 cursor-pointer select-none hover:brightness-95 transition-all ${headerBg}">
            <div class="flex items-center gap-2">
              <span class="text-xl leading-none">${grp.icon}</span>
              <div>
                <span class="font-black text-xs font-mono uppercase tracking-wider">${suggestedTubesCount}x - ${grp.tubo}</span>
                <span class="ml-2 px-2 py-0.5 rounded text-[10px] font-bold border ${materialBadgeClass}">
                  Material: ${grp.material}
                </span>
              </div>
            </div>
            <div class="flex items-center gap-2 shrink-0 self-end sm:self-auto flex-wrap">
              <span class="px-2.5 py-0.5 rounded-md text-[11px] font-mono font-bold border ${volBadgeClass} flex items-center gap-1 shadow-2xs">
                <span>💧 Vol. Total:</span>
                <span>${totalVolFormatted}</span>
              </span>
              <button type="button" 
                      onclick="event.stopPropagation(); coletarTodosDoGrupo('${escapedTubo}', '${escapedMaterial}')" 
                      title="Marcar todos os exames em 'A Coletar' deste grupo como Coletados" 
                      class="p-1.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-lg transition-all shadow-2xs flex items-center justify-center cursor-pointer text-xs">
                <span>✅</span>
              </button>
              <button type="button" 
                      onclick="event.stopPropagation(); openLabelPrintModal('${escapedTubo}', '${escapedMaterial}')" 
                      title="Imprimir etiquetas dos exames deste grupo" 
                      class="p-1.5 bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold border border-slate-300 rounded-lg transition-all shadow-2xs flex items-center justify-center cursor-pointer text-xs">
                <span>🖨️</span>
              </button>
              <button type="button" aria-label="Alternar grupo" class="p-1 rounded-lg bg-white/60 hover:bg-white text-slate-700 border border-black/10 transition-transform">
