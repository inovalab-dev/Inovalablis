  function openChangeExamStatusModal(examCode) {
    targetExamCodeForEdit = examCode;
    const req = globalRequisitions.find(r => r.id === selectedReqId);
    if (!req) return;
    const ex = (req.exams || []).find(e => (e.code || e.id) === examCode);
