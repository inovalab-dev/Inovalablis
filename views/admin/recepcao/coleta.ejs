  // --- EXTRAIR INFORMAÇÕES DE TUBO, MATERIAL E VOLUME DO CADASTRO DO EXAME ---
  function getExamTubeAndMaterialInfo(ex) {
    const fullExam = globalExams.find(e => e.code === ex.code || e.name === ex.name || (e.jalisCode && e.jalisCode === ex.code)) || ex;
    const searchStr = `${ex.name || ''} ${ex.code || ''} ${ex.category || ''} ${fullExam.name || ''} ${fullExam.category || ''} ${fullExam.jalisCode || ''}`.toLowerCase();

    let tuboNome = '';
    let materialNome = '';
    let volumeVal = 0;
    let volumeUni = 'mL';
    let icon = '🧪';
    let colorTheme = 'slate';

    // 1. Tentar obter dados cadastrados na aba Recipientes / materiaisColetados
    if (Array.isArray(fullExam.materiaisColetados) && fullExam.materiaisColetados.length > 0) {
      const mat = fullExam.materiaisColetados[0];
      if (mat.nome) materialNome = mat.nome;
      if (Array.isArray(mat.recipientesColeta) && mat.recipientesColeta.length > 0) {
        const rec = mat.recipientesColeta[0];
        if (rec.nome) tuboNome = rec.nome;
        if (rec.volume) {
          let v = parseFloat(String(rec.volume).replace(',', '.'));
          if (!isNaN(v) && v > 0) volumeVal = v;
        }
        if (rec.uni) volumeUni = rec.uni;
      }
    }

    // 2. Fallbacks inteligentes caso não haja dados específicos cadastrados
    if (!materialNome) materialNome = ex.material || fullExam.category || 'Sangue Total';

    if (!tuboNome) {
      if (searchStr.includes('hemo') || searchStr.includes('leuco') || searchStr.includes('plaq') || searchStr.includes('hba1c') || searchStr.includes('edta') || searchStr.includes('roxa') || searchStr.includes('sangue total')) {
        tuboNome = 'Tubo Tampa Roxa (EDTA)';
        if (!materialNome || materialNome === 'Sangue') materialNome = 'Sangue Total';
        if (volumeVal === 0) volumeVal = 0.100;
      } else if (searchStr.includes('citrat') || searchStr.includes('tap') || searchStr.includes('ttpa') || searchStr.includes('fibrin') || searchStr.includes('coag') || searchStr.includes('azul')) {
        tuboNome = 'Tubo Tampa Azul (Citrato)';
        if (!materialNome || materialNome === 'Sangue') materialNome = 'Plasma Citratado';
        if (volumeVal === 0) volumeVal = 2.0;
      } else if (searchStr.includes('glico') || searchStr.includes('fluor') || searchStr.includes('cinza') || searchStr.includes('lactat')) {
        tuboNome = 'Tubo Tampa Cinza (Fluoreto)';
        if (!materialNome || materialNome === 'Sangue') materialNome = 'Plasma';
        if (volumeVal === 0) volumeVal = 1.0;
      } else if (searchStr.includes('urin') || searchStr.includes('eas') || searchStr.includes('uroc')) {
        tuboNome = 'Frasco Coletor Urina Estéril';
        if (!materialNome) materialNome = 'Urina';
        if (volumeVal === 0) volumeVal = 10.0;
      } else if (searchStr.includes('fez') || searchStr.includes('copro') || searchStr.includes('parasit')) {
        tuboNome = 'Frasco Coletor Fezes';
        if (!materialNome) materialNome = 'Fezes';
        if (volumeVal === 0) volumeVal = 5.0;
        volumeUni = 'g';
      } else {
        tuboNome = 'Tubo Tampa Vermelha / Amarela (Gel / Soro)';
        if (!materialNome || materialNome === 'Sangue') materialNome = 'Soro';
        if (volumeVal === 0) volumeVal = 0.5;
      }
    }

    if (volumeVal === 0) volumeVal = 0.5;

    // Determinar ícone e cores do tema
    const tuboLower = tuboNome.toLowerCase();
    if (tuboLower.includes('roxa') || tuboLower.includes('edta')) {
      icon = '🟣';
      colorTheme = 'purple';
    } else if (tuboLower.includes('azul') || tuboLower.includes('citrato')) {
      icon = '🔵';
      colorTheme = 'blue';
    } else if (tuboLower.includes('cinza') || tuboLower.includes('fluoreto')) {
      icon = '⚪';
      colorTheme = 'gray';
    } else if (tuboLower.includes('urina') || tuboLower.includes('estéril') || tuboLower.includes('esteril')) {
      icon = '🟨';
      colorTheme = 'yellow';
    } else if (tuboLower.includes('fezes')) {
      icon = '💩';
      colorTheme = 'orange';
    } else if (tuboLower.includes('vermelha') || tuboLower.includes('amarela') || tuboLower.includes('soro') || tuboLower.includes('gel')) {
      icon = '🔴';
      colorTheme = 'amber';
    } else {
      icon = '📦';
      colorTheme = 'slate';
    }

    return {
      code: ex.code || fullExam.code || 'EX',
      name: ex.name || fullExam.name,
      status: ex.status || fullExam.status || 'A Coletar',
      material: materialNome,
      tubo: tuboNome,
      volume: volumeVal,
      uni: volumeUni,
      fasting: ex.fasting || fullExam.fasting || 'Jejum Padrão',
      timeframe: ex.timeframe || fullExam.timeframe || '24h',
      icon,
      colorTheme,
      fullExam
    };
  }

  // --- CÁLCULO INTELIGENTE DE TUBOS E INSTRUÇÕES ---
  function calculateAndRenderTubes(reqExams, groups) {
    const tubesSummaryGrid = document.getElementById('det-tubes-summary-grid');
    const tubesInstructionsList = document.getElementById('det-tubes-instructions-list');

    tubesSummaryGrid.innerHTML = '';
    tubesInstructionsList.innerHTML = '';

    const instructionsMap = {
      edta: 'Homogeneizar por inversão suave 8 a 10 vezes imediatamente após a coleta. Nunca agitar energeticamente para prevenir microcoágulos e hemólise.',
      soro: 'Inverter 5 vezes suavemente. Manter em repouso vertical por 30 minutos para retração do coágulo antes da centrifugação a 3000 RPM.',
      citrato: 'Respeitar rigorosamente a marca do volume do tubo (proporção 1:9 anticoagulante/sangue). Inverter suavemente 3 a 4 vezes.',
      fluoreto: 'Homogeneizar 8 vezes por inversão. O fluoreto inibe a glicólise garantindo dosagem exata de glicemia.',
      urina: 'Higienização prévia do paciente. Orientar desprezar o 1º jato e coletar o jato médio em frasco estéril.',
      fezes: 'Coletar porção equivalente a uma colher de chá em pontos distintos da amostra evitando urina ou água do vaso.',
      outros: 'Seguir protocolo pré-analítico de biossegurança de amostras especiais.'
    };

    let totalRecipientesCount = 0;
    const groupValues = groups ? Object.values(groups) : [];

    if (groupValues.length === 0) {
      document.getElementById('det-tubes-total-count').textContent = '0 recipientes';
      return;
    }

    groupValues.forEach(grp => {
      let count = 1;
      if (grp.colorTheme === 'amber' && grp.exams.length > 5) {
        count = Math.ceil(grp.exams.length / 5);
      } else if (grp.totalVolume > 5.0 && grp.uni === 'mL') {
        count = Math.ceil(grp.totalVolume / 4.0);
      }

      totalRecipientesCount += count;
      const totalVolFormatted = grp.totalVolume.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 3 }) + ' ' + grp.uni;

      let colorBg = 'bg-slate-100';
      let colorText = 'text-slate-900';
      let colorBorder = 'border-slate-300';
      let instKey = 'outros';

      if (grp.colorTheme === 'purple') {
        colorBg = 'bg-purple-100'; colorText = 'text-purple-900'; colorBorder = 'border-purple-300'; instKey = 'edta';
      } else if (grp.colorTheme === 'blue') {
        colorBg = 'bg-blue-100'; colorText = 'text-blue-900'; colorBorder = 'border-blue-300'; instKey = 'citrato';
      } else if (grp.colorTheme === 'gray') {
        colorBg = 'bg-slate-200'; colorText = 'text-slate-900'; colorBorder = 'border-slate-400'; instKey = 'fluoreto';
      } else if (grp.colorTheme === 'yellow') {
        colorBg = 'bg-yellow-100'; colorText = 'text-yellow-900'; colorBorder = 'border-yellow-300'; instKey = 'urina';
      } else if (grp.colorTheme === 'orange') {
        colorBg = 'bg-orange-100'; colorText = 'text-orange-900'; colorBorder = 'border-orange-300'; instKey = 'fezes';
      } else if (grp.colorTheme === 'amber') {
        colorBg = 'bg-amber-100'; colorText = 'text-amber-900'; colorBorder = 'border-amber-300'; instKey = 'soro';
      }

      const card = document.createElement('div');
      card.className = `p-3 rounded-xl border flex flex-col justify-between ${colorBg} ${colorBorder} ${colorText} shadow-2xs font-mono space-y-2`;
      card.innerHTML = `
        <div class="flex items-start justify-between gap-2">
          <div class="flex items-center gap-2">
            <span class="text-2xl">${grp.icon}</span>
            <div>
              <div class="font-extrabold text-xs leading-tight">${grp.tubo}</div>
              <div class="text-[10px] font-bold opacity-80 mt-0.5">Material: ${grp.material}</div>
            </div>
          </div>
          <div class="text-base font-black bg-white/90 px-2.5 py-1 rounded-lg border border-black/10 shadow-2xs shrink-0">
            ${count}x
          </div>
        </div>
        <div class="flex items-center justify-between text-[11px] font-black border-t border-black/10 pt-1.5 mt-1">
          <span class="opacity-75">Vol. Total Sugerido:</span>
          <span class="bg-white/90 px-2 py-0.5 rounded text-emerald-950 font-extrabold">${totalVolFormatted}</span>
        </div>
      `;
      tubesSummaryGrid.appendChild(card);

      const inst = document.createElement('div');
      inst.className = 'flex items-start gap-2 p-2 rounded-lg bg-white/80 border border-rose-100 text-xs text-slate-800';
      inst.innerHTML = `
        <span class="text-base leading-none">${grp.icon}</span>
        <div>
          <strong class="font-black text-rose-950">${grp.tubo} (${grp.material}):</strong> ${instructionsMap[instKey] || instructionsMap.outros}
        </div>
      `;
      tubesInstructionsList.appendChild(inst);
    });

    document.getElementById('det-tubes-total-count').textContent = `${totalRecipientesCount} recipiente(s)`;
  }

  // --- AÇÃO DE CONFIRMAR COLETA ---
  async function confirmarColetaFinalizada() {
    if (!selectedReqId) return;

    const req = globalRequisitions.find(r => r.id === selectedReqId);
    if (!req) return;

    const obsColeta = document.getElementById('det-coleta-obs').value;

    if (!confirm(`Deseja confirmar a realização da coleta das amostras para o paciente "${req.patientName}"?`)) {
      return;
    }

    const btn = document.getElementById('btn-confirmar-coleta');
    btn.disabled = true;
    btn.innerHTML = `<span>⏳</span> Salvando...`;

    try {
      const response = await fetch('/admin/requisicoes/update-status', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          id: selectedReqId,
          status: 'Coletado',
          coletaObs: obsColeta
        })
      });

      const data = await response.json();
      if (data.success) {
        // Atualiza status local
        req.status = 'Coletado';
        req.collectedAt = data.collectedAt || new Date().toISOString();
        
        // Notificação toast
        alert(`✅ Coleta do paciente ${req.patientName} confirmada com sucesso! A amostra foi direcionada para a triagem técnica.`);

        // Atualizar estatísticas e retornar para a listagem de seleção de pacientes
        updateColetaStats();
        clearSelectedColeta();
      } else {
        alert("Ocorreu um erro ao atualizar o status da coleta.");
      }
    } catch (e) {
      console.error(e);
      alert("Erro na comunicação com o servidor.");
    } finally {
      btn.disabled = false;
      btn.innerHTML = `<span>💉</span> Confirmar Coleta de Amostras`;
    }
  }

