  async function syncExamsToBackend(reqId, exams) {
    try {
      const response = await fetch('/admin/requisicoes/update-exams-status', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: reqId, exams })
      });
      const data = await response.json();
      if (data.success) {
        const req = globalRequisitions.find(r => r.id === reqId);
        if (req) {
          if (data.status) req.status = data.status;
          if (data.exams) req.exams = data.exams;
          if (data.collectedAt) req.collectedAt = data.collectedAt;
        }
        updateColetaStats();
      }
    } catch (err) {
      console.error("Erro ao sincronizar status dos exames:", err);
    }
  }
</script>

