  window.toggleGroupCollapse = function(index) {
    const body = document.getElementById(`group-body-${index}`);
    const chevron = document.getElementById(`group-chevron-${index}`);
    if (!body) return;
    const isHidden = body.classList.contains('hidden');
    if (isHidden) {
      body.classList.remove('hidden');
      if (chevron) chevron.style.transform = 'rotate(0deg)';
    } else {
      body.classList.add('hidden');
      if (chevron) chevron.style.transform = 'rotate(-90deg)';
    }
  };

  window.expandAllExamGroups = function() {
    document.querySelectorAll('[id^="group-body-"]').forEach(body => {
      body.classList.remove('hidden');
    });
    document.querySelectorAll('[id^="group-chevron-"]').forEach(chev => {
      chev.style.transform = 'rotate(0deg)';
    });
  };

  window.collapseAllExamGroups = function() {
    document.querySelectorAll('[id^="group-body-"]').forEach(body => {
      body.classList.add('hidden');
    });
    document.querySelectorAll('[id^="group-chevron-"]').forEach(chev => {
      chev.style.transform = 'rotate(-90deg)';
    });
  };

