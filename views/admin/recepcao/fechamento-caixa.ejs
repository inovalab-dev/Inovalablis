      const items = parseCsvText(csvText);
      parsedCsvItemsGlobal = items;
      renderGroupedCsvResults(items);
    };
    reader.readAsText(file, 'UTF-8');
  }

  function parseCsvLine(line) {
    const sep = line.includes(';') ? ';' : (line.includes('\t') ? '\t' : ',');
    const cols = [];
    let cur = '';
    let inQuotes = false;
    for (let i = 0; i < line.length; i++) {
      const char = line[i];
      if (char === '"') {
        inQuotes = !inQuotes;
      } else if (char === sep && !inQuotes) {
        cols.push(cur.trim().replace(/^"|"$/g, ''));
        cur = '';
      } else {
        cur += char;
      }
    }
    cols.push(cur.trim().replace(/^"|"$/g, ''));
    return cols;
  }

  function fixMojibake(str) {
    if (!str) return '';
    return String(str)
      .replace(/\uFFFD/g, 'e')
      .replace(/Ã©/g, 'e').replace(/Ã‰/g, 'e')
      .replace(/Ãª/g, 'e').replace(/ÃŠ/g, 'e')
      .replace(/Ã¡/g, 'a').replace(/Ã /g, 'a')
      .replace(/Ã£/g, 'a').replace(/Ã¢/g, 'a')
      .replace(/Ã /g, 'a').replace(/Ã/g, 'a')
      .replace(/Ã­/g, 'i').replace(/Ã/g, 'i')
      .replace(/Ã³/g, 'o').replace(/Ã´/g, 'o')
      .replace(/Ãµ/g, 'o').replace(/Ã'/g, 'o')
      .replace(/Ãº/g, 'u').replace(/Ãœ/g, 'u')
      .replace(/Ã§/g, 'c').replace(/Ã‡/g, 'c');
  }

  function normalizeStr(raw) {
    if (!raw) return '';
    return fixMojibake(raw)
      .toLowerCase()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/[^a-z0-9]/g, " ")
      .replace(/\s+/g, " ")
      .trim();
  }

  function parseMoneyValue(val) {
    if (val === null || val === undefined) return 0;
    let str = String(val).trim();
    if (!str || str === '-' || str === 'R$' || str === 'R$ -') return 0;

    str = str.replace(/[\u00A0\u1680\u180E\u2000-\u200B\u202F\u205F\u3000\uFEFF]/g, ' ')
             .replace(/R\$\s*/gi, '')
             .replace(/\s/g, '')
             .replace(/"/g, '');
    if (!str) return 0;

    if (str.includes(',') && str.includes('.')) {
      if (str.lastIndexOf(',') > str.lastIndexOf('.')) {
        str = str.replace(/\./g, '').replace(',', '.');
      } else {
        str = str.replace(/,/g, '');
      }
    } else if (str.includes(',')) {
      str = str.replace(',', '.');
    } else if (str.includes('.')) {
      const parts = str.split('.');
      if (parts.length === 2 && parts[1].length === 3 && parts[0].length <= 3) {
        str = str.replace('.', '');
      }
    }

    const num = parseFloat(str);
    return isNaN(num) ? 0 : num;
  }

  function parseDateStringToIso(rawDateStr) {
    if (!rawDateStr) return null;
    let str = String(rawDateStr).trim().split(' ')[0].split('T')[0];
    if (!str) return null;

    if (str.includes('/') || (str.includes('-') && str.indexOf('-') === 2)) {
      const sep = str.includes('/') ? '/' : '-';
      const parts = str.split(sep);
      if (parts.length === 3) {
        const day = parts[0].padStart(2, '0');
        const month = parts[1].padStart(2, '0');
        let year = parts[2];
        if (year.length === 2) year = '20' + year;
        if (parseInt(month, 10) >= 1 && parseInt(month, 10) <= 12 && parseInt(day, 10) >= 1 && parseInt(day, 10) <= 31) {
          return {
            isoDate: `${year}-${month}-${day}`,
            dateBr: `${day}/${month}/${year}`
          };
        }
      }
    }

    if (str.includes('-') || str.includes('/')) {
      const sep = str.includes('-') ? '-' : '/';
      const parts = str.split(sep);
      if (parts.length === 3 && parts[0].length === 4) {
        const year = parts[0];
        const month = parts[1].padStart(2, '0');
        const day = parts[2].padStart(2, '0');
        return {
          isoDate: `${year}-${month}-${day}`,
          dateBr: `${day}/${month}/${year}`
        };
      }
    }

    return null;
  }

  function classifyPaymentType(rawText) {
    if (!rawText) return 'dinheiro';
    const norm = normalizeStr(rawText);
    if (!norm) return 'dinheiro';

    // 1. DÉBITO
    const isDeb = (
      norm.includes('deb') || 
      norm === 'cd' || 
      norm === 'c d' || 
      norm.includes('cartao d') || 
      norm.includes('c deb') ||
      norm.includes('maestro') || 
      norm.includes('banricompras') || 
      norm.includes('electron')
    );

    // 2. CRÉDITO
    const isCred = (
      norm.includes('cred') || 
      norm === 'cc' || 
      norm === 'c c' || 
      norm.includes('cartao c') || 
      norm.includes('c cred') ||
      norm.includes('visa') || 
      norm.includes('master') || 
      norm.includes('hiper') || 
      norm.includes('elo') || 
      norm.includes('amex') || 
      norm.includes('american express')
    );

    if (isDeb && !isCred) return 'cartaoDebito';
    if (isCred && !isDeb) return 'cartaoCredito';

    if (isDeb && isCred) {
      if (norm.includes('debito') && !norm.includes('credito')) return 'cartaoDebito';
      if (norm.includes('credito') && !norm.includes('debito')) return 'cartaoCredito';
      if (norm.includes('c deb') || norm.includes('cartao d')) return 'cartaoDebito';
      return 'cartaoCredito';
    }

    // 3. PIX
    if (norm.includes('pix') || norm.includes('transferencia') || norm.includes('ted') || norm.includes('doc') || norm.includes('qr')) {
      return 'pix';
    }

    // 4. CHEQUE
    if (norm.includes('cheque') || norm.includes('chq')) {
      return 'cheque';
    }

    // 5. DINHEIRO
    if (norm.includes('dinheiro') || norm.includes('especie') || norm.includes('esp') || norm.includes('cash') || norm.includes('moeda')) {
      return 'dinheiro';
    }

    // 6. CARTÃO GENÉRICO
    if (
      norm.includes('cartao') || 
      norm.includes('card') || 
      norm.includes('tef') || 
      norm.includes('pos') || 
      norm.includes('cielo') || 
      norm.includes('rede') || 
      norm.includes('stone') || 
      norm.includes('getnet') || 
      norm.includes('pagseguro')
    ) {
      return 'cartaoCredito';
    }

    return 'dinheiro';
  }

  function extractFirstName(fullName) {
    if (!fullName) return 'Importado via CSV';
    let clean = fixMojibake(fullName).trim();
    if (!clean || clean.toLowerCase() === 'importado via csv') return 'Importado via CSV';

    const parts = clean.split(/[\s\/,]+/);
    let first = parts[0] || '';
    if ((first.toLowerCase() === 'dr' || first.toLowerCase() === 'dra' || first.toLowerCase() === 'dr.') && parts[1]) {
      first = parts[1];
    }
    if (!first) return 'Importado via CSV';
    return first.charAt(0).toUpperCase() + first.slice(1).toLowerCase();
  }

  function parseCsvText(text) {
    const lines = text.split(/\r?\n/).map(l => l.trim()).filter(Boolean);
    if (lines.length === 0) return [];

    const firstCols = parseCsvLine(lines[0]);
    const isHeader = firstCols.some(c => {
      const norm = normalizeStr(c);
      return (
        norm.includes('data') || 
        norm.includes('lancado') || 
        norm.includes('operador') || 
        norm.includes('tipo') || 
        norm.includes('valor') || 
        norm.includes('recepcao') || 
        norm.includes('dinheiro') || 
        norm.includes('pix') || 
        norm.includes('cred') || 
        norm.includes('deb') || 
        norm.includes('cartao')
      );
    });

    let colDinheiroIdx = -1;
    let colPixIdx = -1;
    let colCartaoCreditoIdx = -1;
    let colCartaoDebitoIdx = -1;
    let colChequeIdx = -1;
    let colCartaoGenericoIdx = -1;

    let colDateIdx = -1;
    let colOperadorIdx = -1;
    let colRecepcaoIdx = -1;
    let colTipoIdx = -1;
    let colValorIdx = -1;

    if (isHeader) {
      firstCols.forEach((c, idx) => {
        const norm = normalizeStr(c);

        if (
          norm.includes('cred') || 
          norm === 'cc' || 
          norm === 'c c' || 
          norm.includes('cartao c') || 
          norm.includes('c cred')
        ) {
          if (!norm.includes('deb') && !norm.includes('cartao d')) {
            colCartaoCreditoIdx = idx;
          }
        }

        if (
          norm.includes('deb') || 
          norm === 'cd' || 
          norm === 'c d' || 
          norm.includes('cartao d') || 
          norm.includes('c deb') ||
          norm.includes('maestro') ||
          norm.includes('electron')
        ) {
          colCartaoDebitoIdx = idx;
        }

        if (norm.includes('dinheiro') || norm === 'esp' || norm.includes('especie') || norm.includes('cash')) {
          colDinheiroIdx = idx;
        }

        if (norm.includes('pix') || norm.includes('transferencia') || norm.includes('ted') || norm.includes('doc') || norm.includes('qr')) {
          colPixIdx = idx;
        }

        if (norm.includes('cheque') || norm.includes('chq')) {
          colChequeIdx = idx;
        }

        if (
          (norm.includes('cartao') || norm.includes('card') || norm.includes('pos') || norm.includes('tef')) && 
          colCartaoCreditoIdx === -1 && 
          colCartaoDebitoIdx === -1
        ) {
          colCartaoGenericoIdx = idx;
        }

        if (norm.includes('data') || norm.includes('dt') || norm.includes('dia') || norm.includes('emissao')) {
          colDateIdx = idx;
        } else if (norm.includes('lancado') || norm.includes('operador') || norm.includes('responsavel') || norm.includes('usuario') || norm.includes('atendente') || norm.includes('func')) {
          colOperadorIdx = idx;
        } else if (norm.includes('recepcao') || norm.includes('caixa') || norm.includes('unidade') || norm.includes('local') || norm.includes('setor')) {
          colRecepcaoIdx = idx;
        } else if (norm.includes('tipo') || norm.includes('forma') || norm.includes('meio') || norm.includes('pagamento') || norm.includes('pagto') || norm.includes('modalidade') || norm.includes('historico') || norm.includes('operacao') || norm.includes('descricao')) {
          colTipoIdx = idx;
        } else if (norm.includes('valor') || norm.includes('monto') || norm.includes('total') || norm.includes('quantia') || norm.includes('vlr') || norm.includes('val')) {
          colValorIdx = idx;
        }
      });
    }

    const isMultiColumn = (
      colCartaoCreditoIdx !== -1 || 
      colCartaoDebitoIdx !== -1 || 
      (colDinheiroIdx !== -1 && colPixIdx !== -1) || 
      (colDinheiroIdx !== -1 && colCartaoGenericoIdx !== -1)
    );
    const startIndex = isHeader ? 1 : 0;
    const rows = [];

    for (let i = startIndex; i < lines.length; i++) {
      const line = lines[i];
      if (!line) continue;

      const cols = parseCsvLine(line);
      if (cols.length < 2) continue;

      let dateObj = null;
      if (colDateIdx !== -1 && cols[colDateIdx]) {
        dateObj = parseDateStringToIso(cols[colDateIdx]);
      }
      if (!dateObj) {
        for (let cIdx = 0; cIdx < cols.length; cIdx++) {
          const testD = parseDateStringToIso(cols[cIdx]);
          if (testD) {
            dateObj = testD;
            break;
          }
        }
      }
      if (!dateObj) continue;

      let rawLancadoPor = '';
      if (colOperadorIdx !== -1 && cols[colOperadorIdx]) {
        rawLancadoPor = cols[colOperadorIdx];
      }
      const lancadoPor = extractFirstName(rawLancadoPor);

      let recepcao = 'Recepção Particular';
      if (colRecepcaoIdx !== -1 && cols[colRecepcaoIdx]) {
        const cleanRec = fixMojibake(cols[colRecepcaoIdx]).trim();
        if (cleanRec) recepcao = cleanRec;
      }

      if (isMultiColumn) {
        const valDinheiro = colDinheiroIdx !== -1 ? parseMoneyValue(cols[colDinheiroIdx]) : 0;
        const valPix = colPixIdx !== -1 ? parseMoneyValue(cols[colPixIdx]) : 0;
        let valCredito = colCartaoCreditoIdx !== -1 ? parseMoneyValue(cols[colCartaoCreditoIdx]) : 0;
        let valDebito = colCartaoDebitoIdx !== -1 ? parseMoneyValue(cols[colCartaoDebitoIdx]) : 0;
        const valCheque = colChequeIdx !== -1 ? parseMoneyValue(cols[colChequeIdx]) : 0;
        const valCartaoGen = colCartaoGenericoIdx !== -1 ? parseMoneyValue(cols[colCartaoGenericoIdx]) : 0;

        if (valCartaoGen > 0 && valCredito === 0 && valDebito === 0) {
          valCredito = valCartaoGen;
        }

        if (valDinheiro > 0) rows.push({ date: dateObj.isoDate, dateBr: dateObj.dateBr, lancadoPor, tipoPagamento: 'dinheiro', valor: valDinheiro, recepcao });
        if (valPix > 0) rows.push({ date: dateObj.isoDate, dateBr: dateObj.dateBr, lancadoPor, tipoPagamento: 'pix', valor: valPix, recepcao });
        if (valCredito > 0) rows.push({ date: dateObj.isoDate, dateBr: dateObj.dateBr, lancadoPor, tipoPagamento: 'cartaoCredito', valor: valCredito, recepcao });
        if (valDebito > 0) rows.push({ date: dateObj.isoDate, dateBr: dateObj.dateBr, lancadoPor, tipoPagamento: 'cartaoDebito', valor: valDebito, recepcao });
        if (valCheque > 0) rows.push({ date: dateObj.isoDate, dateBr: dateObj.dateBr, lancadoPor, tipoPagamento: 'cheque', valor: valCheque, recepcao });

      } else {
        let rawTipo = '';
        if (colTipoIdx !== -1 && cols[colTipoIdx]) {
          rawTipo = cols[colTipoIdx];
        }

        let rawValorStr = '0';
        if (colValorIdx !== -1 && cols[colValorIdx] !== undefined) {
          rawValorStr = cols[colValorIdx];
        }

        if (!rawTipo || !rawValorStr || colValorIdx === -1) {
          for (let cIdx = 0; cIdx < cols.length; cIdx++) {
            const colVal = cols[cIdx];
            const parsedV = parseMoneyValue(colVal);
            if (parsedV > 0 && rawValorStr === '0' && cIdx !== colDateIdx) {
              rawValorStr = colVal;
            } else {
              const classT = classifyPaymentType(colVal);
              if (classT !== 'dinheiro' || colVal.toLowerCase().includes('dinheiro') || colVal.toLowerCase().includes('especie')) {
                rawTipo = colVal;
              }
            }
          }
        }

        const tipoPagamento = classifyPaymentType(rawTipo);
        const valorNum = parseMoneyValue(rawValorStr);

        if (valorNum > 0) {
          rows.push({
            date: dateObj.isoDate,
            dateBr: dateObj.dateBr,
            lancadoPor,
            tipoPagamento,
            valor: valorNum,
            recepcao
          });
        }
      }
    }

    const grouped = {};
    rows.forEach(r => {
      const key = `${r.date}_${r.recepcao}`;
      if (!grouped[key]) {
        grouped[key] = {
          data: r.date,
          dataBr: r.dateBr,
          recepcao: r.recepcao,
          dinheiro: 0,
          pix: 0,
          cartaoCredito: 0,
          cartaoDebito: 0,
          cheque: 0,
          operadoresSet: new Set(),
          totalLancamentos: 0
        };
      }

      grouped[key][r.tipoPagamento] = (grouped[key][r.tipoPagamento] || 0) + r.valor;
      if (r.lancadoPor) grouped[key].operadoresSet.add(r.lancadoPor);
      grouped[key].totalLancamentos++;
    });

    return Object.values(grouped).map(g => {
      const totalEntradas = g.dinheiro + g.pix + g.cartaoCredito + g.cartaoDebito + g.cheque;
      const ops = Array.from(g.operadoresSet).filter(Boolean);
      return {
        data: g.data,
        dataBr: g.dataBr,
        recepcao: g.recepcao,
        dinheiro: Math.round(g.dinheiro * 100) / 100,
        pix: Math.round(g.pix * 100) / 100,
        cartaoCredito: Math.round(g.cartaoCredito * 100) / 100,
        cartaoDebito: Math.round(g.cartaoDebito * 100) / 100,
        cheque: Math.round(g.cheque * 100) / 100,
        totalEntradas: Math.round(totalEntradas * 100) / 100,
        responsavel: ops.join(', ') || 'Importado via CSV',
        status: 'Conferido',
        totalLancamentos: g.totalLancamentos,
        observacoes: `Importado via CSV (${g.totalLancamentos} itens)`
      };
    });
  }

