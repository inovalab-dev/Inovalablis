  async function saveImportedCsvBatch() {
    if (!parsedCsvItemsGlobal || parsedCsvItemsGlobal.length === 0) {
      alert('Nenhum fechamento para importar.');
      return;
    }

    const btn = document.getElementById('btn-save-imported-csv-batch');
    if (btn) btn.disabled = true;

    try {
      const response = await fetch('/api/admin/recepcao/fechamento-caixa/salvar-lote-csv', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: parsedCsvItemsGlobal })
      });

      const res = await response.json();
      if (!res.success) {
        throw new Error(res.error || 'Erro ao importar lançamentos do CSV.');
      }

      alert(res.message || 'Lançamentos importados e marcados como CONFERIDO com sucesso!');
      closeImportCsvModal();
      window.location.reload();
    } catch (err) {
      console.error('Erro ao importar CSV:', err);
      alert('Falha ao gravar lançamentos: ' + err.message);
    } finally {
      if (btn) btn.disabled = false;
    }
  }

  // Inicialização na carga da página
  document.addEventListener('DOMContentLoaded', () => {
    onRecepcaoOrDateChanged();
  });
</script>

