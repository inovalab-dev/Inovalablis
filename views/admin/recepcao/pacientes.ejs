  function searchCep() {
    const cep = document.getElementById('form-cep').value.replace(/\D/g, '');
    if (cep.length !== 8) {
      alert('Por favor, informe um CEP válido com 8 dígitos.');
      return;
    }

    fetch(`https://viacep.com.br/ws/${cep}/json/`)
      .then(res => res.json())
      .then(data => {
        if (data.erro) {
          alert('CEP não encontrado.');
          return;
        }
        document.getElementById('form-street').value = data.logradouro || '';
        document.getElementById('form-neighborhood').value = data.bairro || '';
        document.getElementById('form-city').value = data.localidade || 'Cambará';
        document.getElementById('form-state').value = data.uf || 'PR';
      })
      .catch(err => {
        console.error('Erro na busca de CEP:', err);
      });
  }

  function togglePatientStatus(id) {
    const p = allPatients.find(item => item.id === id || item.code === id);
    const isInactive = p && p.status === 'Inativo';
    const actionText = isInactive ? 'ativar' : 'inativar';
    
    if (!confirm(`Deseja realmente ${actionText} o cadastro do paciente ${p ? p.name : ''}?`)) return;

    fetch('/admin/recepcao/pacientes/toggle-status', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id })
    })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        if (p) {
          p.status = isInactive ? 'Ativo' : 'Inativo';
        }
        filterAndPaginatePatients();
      } else {
        alert('Erro ao alterar status do paciente.');
      }
    })
    .catch(err => {
      console.error('Erro ao alterar status:', err);
      alert('Erro na comunicação com o servidor.');
    });
  }

