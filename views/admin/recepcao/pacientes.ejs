  // Cálculos e Auxiliares
  function calculateAgeFromBirth() {
    const birthVal = document.getElementById('form-birthDate').value;
    if (!birthVal) {
      document.getElementById('form-ageValue').value = '';
      return;
    }

    const birth = new Date(birthVal + 'T00:00:00');
    const now = new Date();
    if (isNaN(birth.getTime())) return;

    let years = now.getFullYear() - birth.getFullYear();
    let months = now.getMonth() - birth.getMonth();
    let days = now.getDate() - birth.getDate();

    if (days < 0) {
      months--;
      const prevMonth = new Date(now.getFullYear(), now.getMonth(), 0);
      days += prevMonth.getDate();
    }
    if (months < 0) {
      years--;
      months += 12;
    }

    if (years >= 1) {
      document.getElementById('form-ageValue').value = years;
      document.getElementById('form-ageUnit').value = 'Ano(s)';
    } else if (months >= 1) {
      document.getElementById('form-ageValue').value = months;
      document.getElementById('form-ageUnit').value = 'Mês(es)';
    } else {
      document.getElementById('form-ageValue').value = Math.max(0, days);
      document.getElementById('form-ageUnit').value = 'Dia(s)';
    }
  }

