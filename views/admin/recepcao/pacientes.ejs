<!-- Form Escondido para Exclusão de Paciente -->
<form id="deletePatientForm" action="/admin/recepcao/pacientes/delete" method="POST" class="hidden">
  <input type="hidden" name="id" id="delete-patient-id">
</form>

<script>
  // Dados de pacientes carregados do servidor
  const rawPatients = <%- JSON.stringify(patients || []) %>;
  
  // Ordenar para que os últimos cadastros fiquem em primeiro
  const allPatients = [...rawPatients].reverse().sort((a, b) => {
    if (a.createdAt && b.createdAt) {
      return new Date(b.createdAt) - new Date(a.createdAt);
    }
    const numA = parseInt(String(a.code || a.id || '0').replace(/\D/g, ''), 10) || 0;
    const numB = parseInt(String(b.code || b.id || '0').replace(/\D/g, ''), 10) || 0;
    if (numA !== numB) return numB - numA;
    return 0;
  });

  let filteredPatients = [...allPatients];
  let currentPage = 1;
  let itemsPerPage = 50;

  // Inicialização ao carregar a página
  document.addEventListener('DOMContentLoaded', () => {
    filterAndPaginatePatients();
  });

  // Função para filtrar e paginar o histórico na tela principal
  function filterAndPaginatePatients() {
    const query = (document.getElementById('patientSearchInput').value || '').toLowerCase().trim();

    filteredPatients = allPatients.filter(p => {
      const name = (p.name || '').toLowerCase();
      const social = (p.socialName || '').toLowerCase();
      const code = (p.code || p.id || '').toLowerCase();
      const pront = (p.prontuario || '').toLowerCase();
      const cpf = (p.cpf || '').toLowerCase();
      const rg = (p.rg || '').toLowerCase();
      const phone = (p.phone || '').toLowerCase();
      const city = (p.city || '').toLowerCase();

      return !query || 
        name.includes(query) || 
        social.includes(query) || 
        code.includes(query) || 
        pront.includes(query) || 
        cpf.includes(query) || 
        rg.includes(query) || 
        phone.includes(query) || 
        city.includes(query);
    });

    currentPage = 1;
    renderPatientsTablePage();
  }

  function changeItemsPerPage() {
    itemsPerPage = parseInt(document.getElementById('itemsPerPageSelect').value, 10) || 50;
    currentPage = 1;
    renderPatientsTablePage();
  }

  function renderPatientsTablePage() {
    const totalItems = filteredPatients.length;
    const totalPages = Math.ceil(totalItems / itemsPerPage) || 1;

    if (currentPage > totalPages) currentPage = totalPages;
    if (currentPage < 1) currentPage = 1;

    const startIndex = (currentPage - 1) * itemsPerPage;
    const endIndex = Math.min(startIndex + itemsPerPage, totalItems);
    const pagePatients = filteredPatients.slice(startIndex, endIndex);

    const tbody = document.getElementById('patientsTableBody');
    tbody.innerHTML = '';

    if (pagePatients.length === 0) {
      tbody.innerHTML = `
        <tr>
          <td colspan="5" class="py-12 text-center text-gray-400 font-mono text-xs">
            Nenhum paciente encontrado com os filtros selecionados.
          </td>
        </tr>
      `;
    } else {
      pagePatients.forEach(p => {
        const tr = document.createElement('tr');
        const isInactive = p.status === 'Inativo';
        tr.className = `hover:bg-emerald-50/40 transition-colors border-b border-gray-100 ${isInactive ? 'bg-gray-50/70 text-gray-400' : ''}`;

        const isVipBadge = p.isVip ? '<span class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-amber-100 text-amber-800 border border-amber-300 ml-1">VIP</span>' : '';
        const statusBadge = isInactive ? '<span class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-rose-100 text-rose-800 border border-rose-200 ml-1">INATIVO</span>' : '';

        tr.innerHTML = `
          <td class="py-3 px-4 font-mono">
            <div class="font-bold ${isInactive ? 'text-gray-500' : 'text-emerald-800'} flex items-center">
              ${p.code || p.id} ${statusBadge}
            </div>
            <div class="text-[10px] text-gray-500">${p.sex || 'Não informado'}</div>
          </td>
          <td class="py-3 px-4">
            <div class="font-bold ${isInactive ? 'text-gray-600 line-through' : 'text-gray-900'} flex items-center">
              ${p.name} ${isVipBadge}
            </div>
            ${p.socialName ? `<div class="text-[10px] text-gray-500">Social: ${p.socialName}</div>` : ''}
            <div class="text-[10px] text-gray-500">Resp: ${p.responsibleName || p.motherName || 'Não informado'}</div>
          </td>
          <td class="py-3 px-4 font-mono">
            <div>CPF: ${p.cpf || 'Sem CPF'}</div>
            <div class="text-[10px] text-gray-500">
              ${p.rg ? 'RG: ' + p.rg + ' | ' : ''}Nasc: ${p.birthDate ? new Date(p.birthDate + 'T00:00:00').toLocaleDateString('pt-BR') : 'Sem data'} ${p.age ? '(' + p.age + 'a)' : ''}
            </div>
          </td>
          <td class="py-3 px-4">
            <div class="font-mono text-gray-800">${p.phone || p.whatsapp || 'Sem contato'}</div>
            <div class="text-[10px] text-gray-500">${p.city || 'Cambará'} - ${p.state || 'PR'}</div>
          </td>
          <td class="py-3 px-4 text-center">
            <div class="flex items-center justify-center gap-1.5">
              <button onclick="editPatient('${p.id}')" class="px-2.5 py-1 bg-amber-50 hover:bg-amber-600 hover:text-white text-amber-700 font-bold text-[11px] rounded-lg transition-colors cursor-pointer" title="Editar Ficha">
                Editar
              </button>
              <button onclick="togglePatientStatus('${p.id}')" class="px-2.5 py-1 ${isInactive ? 'bg-emerald-50 hover:bg-emerald-600 hover:text-white text-emerald-700' : 'bg-rose-50 hover:bg-rose-600 hover:text-white text-rose-700'} font-bold text-[11px] rounded-lg transition-colors cursor-pointer" title="${isInactive ? 'Ativar Cadastro' : 'Inativar Cadastro'}">
                ${isInactive ? 'Ativar' : 'Inativar'}
              </button>
              <a href="/admin/requisicoes?patientName=${encodeURIComponent(p.name)}&patientCpf=${encodeURIComponent(p.cpf || '')}" class="px-2 py-1 bg-emerald-50 hover:bg-emerald-600 hover:text-white text-emerald-700 font-bold text-[11px] rounded-lg transition-colors inline-block cursor-pointer" title="Emitir Ordem de Serviço">
                + OS
              </a>
            </div>
          </td>
        `;

        tbody.appendChild(tr);
      });
    }

    // Renderizar informações de paginação
    const displayStart = totalItems === 0 ? 0 : startIndex + 1;
    document.getElementById('paginationInfo').innerText = `Exibindo ${displayStart} - ${endIndex} de ${totalItems} pacientes registrados`;

    // Renderizar botões de paginação
    const controls = document.getElementById('paginationControls');
    controls.innerHTML = '';

    // Botao Anterior
    const prevBtn = document.createElement('button');
    prevBtn.className = `px-2.5 py-1 rounded border text-xs font-bold transition-all ${currentPage === 1 ? 'bg-gray-100 text-gray-400 border-gray-200 cursor-not-allowed' : 'bg-white hover:bg-gray-100 text-gray-700 border-gray-300 cursor-pointer'}`;
    prevBtn.innerText = '‹ Anterior';
    prevBtn.onclick = () => { if (currentPage > 1) { currentPage--; renderPatientsTablePage(); } };
    controls.appendChild(prevBtn);

    // Numeros das Paginas
    for (let i = 1; i <= totalPages; i++) {
      if (totalPages > 7 && Math.abs(i - currentPage) > 2 && i !== 1 && i !== totalPages) {
        if (i === 2 || i === totalPages - 1) {
          const dots = document.createElement('span');
          dots.className = 'px-1 text-gray-400';
          dots.innerText = '...';
          controls.appendChild(dots);
        }
        continue;
      }

      const pageBtn = document.createElement('button');
      pageBtn.className = `px-2.5 py-1 rounded border text-xs font-bold font-mono transition-all ${i === currentPage ? 'bg-emerald-600 text-white border-emerald-600 shadow-sm' : 'bg-white hover:bg-gray-100 text-gray-700 border-gray-300 cursor-pointer'}`;
      pageBtn.innerText = i;
      pageBtn.onclick = () => { currentPage = i; renderPatientsTablePage(); };
      controls.appendChild(pageBtn);
    }

    // Botao Proximo
    const nextBtn = document.createElement('button');
    nextBtn.className = `px-2.5 py-1 rounded border text-xs font-bold transition-all ${currentPage === totalPages ? 'bg-gray-100 text-gray-400 border-gray-200 cursor-not-allowed' : 'bg-white hover:bg-gray-100 text-gray-700 border-gray-300 cursor-pointer'}`;
    nextBtn.innerText = 'Próximo ›';
    nextBtn.onclick = () => { if (currentPage < totalPages) { currentPage++; renderPatientsTablePage(); } };
    controls.appendChild(nextBtn);
  }

