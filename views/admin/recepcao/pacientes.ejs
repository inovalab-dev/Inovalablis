  document.addEventListener('keydown', (e) => {
    // 1. Fechar Modal / ESC
    if (window.matchShortcut && window.matchShortcut(e, 'closeModal')) {
      closePatientModal();
      return;
    }

    // 2. Novo Registro (Ex: CTRL + N)
    if (window.matchShortcut && window.matchShortcut(e, 'newRecord')) {
      e.preventDefault();
      openPatientModal();
      return;
    }

    // 3. Salvar (Ex: CTRL + S)
    if (window.matchShortcut && window.matchShortcut(e, 'save')) {
      e.preventDefault();
      const modal = document.getElementById('patientModal');
      const form = document.getElementById('patientMainForm');
      if (form) {
        if (modal && modal.classList.contains('hidden')) {
          openPatientModal();
        } else {
          if (typeof form.requestSubmit === 'function') {
            form.requestSubmit();
          } else {
            form.submit();
          }
        }
      }
      return;
    }

    // 4. Cancelar / Limpar (Ex: CTRL + C)
    if (window.matchShortcut && window.matchShortcut(e, 'cancel')) {
      const selectedText = window.getSelection() ? window.getSelection().toString() : '';
      if (!selectedText) {
        e.preventDefault();
        closePatientModal();
      }
      return;
    }
  });
</script>

