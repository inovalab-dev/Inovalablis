<%- include('../../partials/header') %>

<div class="p-4 sm:p-6 lg:p-8 max-w-[98vw] xl:max-w-[96vw] mx-auto w-full flex-1">
  <!-- Cabeçalho Principal da Tela -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
    <div>
      <div class="flex items-center gap-2 text-xs text-brand-neutral/60 font-mono uppercase tracking-wider mb-1">
        <span>Recepção LIS</span>
        <span>•</span>
        <span class="text-brand-gold font-bold">Prontuário Eletrônico do Paciente (PEP)</span>
      </div>
      <h1 class="text-2xl font-black text-brand-neutralDark flex items-center gap-2">
        <svg class="w-7 h-7 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
        Cadastro de Pacientes (Histórico & Prontuários)
      </h1>
      <p class="text-xs text-brand-neutral/70 mt-1">
        Histórico paginado de pacientes cadastrados. Clique em "Novo Paciente" para abrir a ficha completa.
      </p>
    </div>

    <div class="flex items-center gap-3">
      <button onclick="openPatientModal()" class="inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs uppercase tracking-wider rounded-xl shadow-lg shadow-emerald-600/20 transition-all active:scale-95 cursor-pointer" title="Novo Registro (CTRL + N)">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
        <span>Novo Paciente <span class="font-mono text-[10px] opacity-80">(Ctrl+N)</span></span>
      </button>
    </div>
  </div>

  <!-- Barra de Busca, Filtros e Estatísticas Rápidas -->
  <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4 mb-6 space-y-3">
    <div class="flex flex-col sm:flex-row items-center gap-3">
      <div class="relative flex-1 w-full">
        <svg class="w-4 h-4 absolute left-3.5 top-3.5 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        <input type="text" id="patientSearchInput" onkeyup="filterAndPaginatePatients()" placeholder="Buscar paciente por nome, código, CPF, RG, prontuário, telefone ou cidade..." class="w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-xs font-medium focus:ring-2 focus:ring-emerald-500 focus:bg-white outline-none transition-all">
      </div>
      <select id="itemsPerPageSelect" onchange="changeItemsPerPage()" class="w-full sm:w-36 py-2.5 px-3 bg-gray-50 border border-gray-200 rounded-xl text-xs font-medium text-gray-700 focus:ring-2 focus:ring-emerald-500 outline-none font-mono">
        <option value="20">20 por pág.</option>
        <option value="50" selected>50 por pág.</option>
        <option value="100">100 por pág.</option>
      </select>
    </div>
  </div>

  <!-- Tabela com Histórico Paginado de Pacientes -->
  <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden mb-6">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-gray-50/80 border-b border-gray-100 text-[11px] font-bold text-gray-500 uppercase tracking-wider font-mono">
            <th class="py-3.5 px-4">Código / Sexo</th>
            <th class="py-3.5 px-4">Paciente / Responsável</th>
            <th class="py-3.5 px-4">CPF / RG / Nasc.</th>
            <th class="py-3.5 px-4">Contato / Cidade</th>
            <th class="py-3.5 px-4 text-center">Ações</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 text-xs text-gray-700 font-medium" id="patientsTableBody">
          <!-- Renderizado via JavaScript paginado -->
        </tbody>
      </table>
    </div>

    <!-- Controles de Paginação -->
    <div class="p-4 bg-gray-50/50 border-t border-gray-100 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-gray-500 font-mono">
      <div id="paginationInfo">
        Exibindo 0 - 0 de 0 pacientes
      </div>
      <div class="flex items-center gap-1.5" id="paginationControls">
        <!-- Botoes de paginacao gerados dinamicamente -->
      </div>
    </div>
  </div>
</div>

<!-- ========================================================= -->
<!-- MODAL DE POPUP COMPLETO - CADASTRO DE PACIENTES (LIS)    -->
<!-- ========================================================= -->
<div id="patientModal" class="fixed inset-0 z-50 bg-black/75 backdrop-blur-sm flex items-center justify-center p-2 sm:p-4 lg:p-6 hidden">
  <div class="bg-white rounded-2xl max-w-[98vw] xl:max-w-[95vw] 2xl:max-w-[90vw] w-full h-[95vh] max-h-[95vh] shadow-2xl overflow-hidden flex flex-col border border-gray-200">
    
    <!-- Cabeçalho do Modal LIS -->
    <div class="bg-gradient-to-r from-gray-50 via-gray-100 to-gray-50 px-6 py-3.5 border-b border-gray-200 flex items-center justify-between shrink-0">
      <div class="flex items-center gap-3">
        <div class="p-2 bg-emerald-600 text-white rounded-xl shadow-md">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
        </div>
        <div>
          <h2 class="text-lg font-black text-gray-900 tracking-tight" id="modalTitle">Cadastro de pacientes</h2>
          <p class="text-xs text-gray-500 font-mono">Formulário Unificado LIS - InovaLab Prontuário Eletrônico do Paciente</p>
        </div>
      </div>
      <button onclick="closePatientModal()" type="button" class="text-gray-400 hover:text-gray-700 p-2 hover:bg-gray-200 rounded-xl transition-colors cursor-pointer" title="Fechar (ESC)">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <!-- Conteúdo do Formulário -->
    <form action="/admin/recepcao/pacientes/save" method="POST" id="patientMainForm" class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-4 text-xs">
      <input type="hidden" name="id" id="form-patient-id">
      <input type="hidden" name="photo" id="form-patient-photo">

      <!-- PARTE SUPERIOR DA FICHA (Dados Principais) -->
      <div class="bg-gray-50/80 p-4 rounded-2xl border border-gray-200 shadow-sm space-y-3">
        
        <!-- Header do Card Dados Principais -->
        <div class="flex items-center justify-between pb-2 border-b border-gray-200">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-emerald-500 inline-block shadow-sm"></span>
            <h3 class="text-xs font-black text-gray-800 uppercase tracking-wider">Dados Principais</h3>
          </div>
          <span class="text-[10px] text-gray-500 font-medium">Informações do Paciente</span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 items-start">
          
          <!-- Lado Esquerdo: Campos Principais -->
          <div class="lg:col-span-10 space-y-2.5">
            
            <!-- Linha 1: Código & Nome completo & Nome Social -->
            <div class="grid grid-cols-1 sm:grid-cols-12 gap-2.5 items-center">
              <div class="sm:col-span-3 lg:col-span-2 flex flex-col">
                <label class="font-bold text-gray-700 text-[11px] mb-0.5">Código</label>
                <input type="text" name="code" id="form-code" class="w-full px-2.5 py-1.5 bg-gray-100 border border-gray-300 rounded-lg text-xs font-mono font-black text-emerald-800 outline-none cursor-not-allowed select-none" readonly title="Código numérico incremental (Gerado automaticamente)" placeholder="Automático">
              </div>
              <div class="sm:col-span-5 lg:col-span-6 flex flex-col">
                <label class="font-bold text-gray-700 text-[11px] mb-0.5">Nome completo *</label>
                <input type="text" name="name" id="form-name" required placeholder="Nome completo do paciente *" class="w-full px-3 py-1.5 bg-white border border-gray-300 rounded-lg text-xs font-bold text-gray-900 outline-none focus:ring-1 focus:ring-emerald-500">
              </div>
              <div class="sm:col-span-4 lg:col-span-4 flex flex-col">
                <label class="font-bold text-gray-700 text-[11px] mb-0.5">Nome Social</label>
                <input type="text" name="socialName" id="form-socialName" placeholder="Nome social (se houver)" class="w-full px-3 py-1.5 bg-white border border-gray-300 rounded-lg text-xs outline-none focus:ring-1 focus:ring-emerald-500">
              </div>
            </div>

            <!-- Linha 2: CPF, RG, WhatsApp, Responde WhatsApp -->
            <div class="grid grid-cols-1 sm:grid-cols-12 gap-2.5 items-center">
              <div class="sm:col-span-3 flex flex-col">
                <label class="font-bold text-gray-700 text-[11px] mb-0.5">CPF</label>
                <input type="text" name="cpf" id="form-cpf" placeholder="000.000.000-00" maxlength="14" oninput="this.value = applyCpfMask(this.value)" class="w-full px-2.5 py-1.5 bg-white border border-gray-300 rounded-lg text-xs font-mono outline-none focus:ring-1 focus:ring-emerald-500">
              </div>
              <div class="sm:col-span-3 flex flex-col">
                <label class="font-bold text-gray-700 text-[11px] mb-0.5">RG</label>
                <input type="text" name="rg" id="form-rg" placeholder="Número do RG" class="w-full px-2.5 py-1.5 bg-white border border-gray-300 rounded-lg text-xs font-mono outline-none focus:ring-1 focus:ring-emerald-500">
              </div>
              <div class="sm:col-span-3 flex flex-col">
                <label class="font-bold text-gray-700 text-[11px] mb-0.5">WhatsApp / Celular</label>
                <input type="text" name="whatsapp" id="form-whatsapp" placeholder="(43) 99999-9999" class="w-full px-2.5 py-1.5 bg-white border border-gray-300 rounded-lg text-xs font-mono outline-none focus:ring-1 focus:ring-emerald-500">
              </div>
              <div class="sm:col-span-3 flex flex-col">
                <label class="font-bold text-gray-700 text-[11px] mb-0.5">Responde WhatsApp?</label>
                <select name="respondsWhatsapp" id="form-respondsWhatsapp" onchange="toggleRespondsWhatsappField()" class="w-full px-2.5 py-1.5 bg-white border border-gray-300 rounded-lg text-xs font-bold outline-none focus:ring-1 focus:ring-emerald-500">
                  <option value="Sim">Sim (Próprio nº)</option>
                  <option value="Não">Não (Outro contato)</option>
                </select>
              </div>
            </div>

            <!-- Campo Dinâmico: Contato de WhatsApp se NÃO responde pelo próprio número -->
            <div id="container-whatsappAlt" class="hidden bg-amber-50/90 p-2.5 rounded-xl border border-amber-200">
              <div class="grid grid-cols-1 sm:grid-cols-12 gap-2.5 items-center">
                <div class="sm:col-span-5 flex items-center gap-2">
                  <svg class="w-4 h-4 text-amber-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                  <span class="text-xs font-bold text-amber-900">Contato de Recado/WhatsApp do Paciente:</span>
                </div>
                <div class="sm:col-span-7 flex items-center gap-2">
                  <label class="font-bold text-amber-900 shrink-0 text-xs">WhatsApp Contato:</label>
                  <input type="text" name="whatsappAlt" id="form-whatsappAlt" placeholder="(43) 98888-8888 (Nome do responsável/recado)" class="w-full px-3 py-1.5 bg-white border border-amber-300 rounded-lg text-xs font-mono font-bold text-amber-900 outline-none focus:ring-1 focus:ring-amber-500">
                </div>
              </div>
            </div>

            <!-- Linha 3: Sexo, Gênero, Nasc, Idade -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 items-center">
              <div class="flex flex-col">
                <label class="font-bold text-gray-700 text-[11px] mb-0.5">Sexo *</label>
                <select name="sex" id="form-sex" required class="w-full px-2.5 py-1.5 bg-white border border-gray-300 rounded-lg text-xs outline-none focus:ring-1 focus:ring-emerald-500">
                  <option value="">Selecione...</option>
                  <option value="Masculino">Masculino</option>
                  <option value="Feminino">Feminino</option>
                  <option value="Outro">Outro</option>
                </select>
              </div>
              <div class="flex flex-col">
                <label class="font-bold text-gray-700 text-[11px] mb-0.5">Gênero</label>
                <select name="gender" id="form-gender" class="w-full px-2.5 py-1.5 bg-white border border-gray-300 rounded-lg text-xs outline-none focus:ring-1 focus:ring-emerald-500">
                  <option value="Não informado">Não informado</option>
                  <option value="Cisgênero">Cisgênero</option>
                  <option value="Transgênero">Transgênero</option>
                  <option value="Não-binário">Não-binário</option>
                </select>
              </div>
              <div class="flex flex-col">
                <label class="font-bold text-gray-700 text-[11px] mb-0.5">Data Nasc. *</label>
                <input type="date" name="birthDate" id="form-birthDate" required onchange="calculateAgeFromBirth()" class="w-full px-2.5 py-1.5 bg-white border border-gray-300 rounded-lg text-xs outline-none focus:ring-1 focus:ring-emerald-500">
              </div>
              <div class="flex flex-col">
                <label class="font-bold text-gray-700 text-[11px] mb-0.5">Idade (automática)</label>
                <div class="flex items-center gap-1">
                  <input type="number" name="ageValue" id="form-ageValue" class="w-full px-2 py-1.5 bg-gray-100 border border-gray-300 rounded-lg text-xs font-mono font-bold text-gray-800 outline-none cursor-not-allowed select-none" readonly title="Idade calculada automaticamente a partir da Data de Nascimento" placeholder="0">
                  <select name="ageUnit" id="form-ageUnit" class="px-1.5 py-1.5 bg-gray-100 border border-gray-300 rounded-lg text-[11px] font-bold text-gray-700 outline-none cursor-not-allowed select-none pointer-events-none" title="Unidade da idade">
                    <option value="Ano(s)">Anos</option>
                    <option value="Mês(es)">Meses</option>
                    <option value="Dia(s)">Dias</option>
                  </select>
                </div>
              </div>
            </div>

            <!-- Linha 4: Nome da Mãe & Senha Web -->
            <div class="grid grid-cols-1 sm:grid-cols-12 gap-2.5 items-center">
              <div class="sm:col-span-8 flex flex-col">
                <label class="font-bold text-gray-700 text-[11px] mb-0.5">Nome completo da Mãe</label>
                <input type="text" name="motherName" id="form-motherName" placeholder="Nome completo da mãe do paciente" class="w-full px-3 py-1.5 bg-white border border-gray-300 rounded-lg text-xs outline-none focus:ring-1 focus:ring-emerald-500">
              </div>
              <div class="sm:col-span-4 flex flex-col">
                <label class="font-bold text-gray-700 text-[11px] mb-0.5">Senha Web</label>
                <div class="flex items-center gap-1.5">
                  <input type="text" name="webPassword" id="form-webPassword" class="w-full px-2.5 py-1.5 bg-white border border-gray-300 rounded-lg text-xs font-mono font-bold text-emerald-800 outline-none focus:ring-1 focus:ring-emerald-500">
                  <button type="button" onclick="generateWebPassword()" class="px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-800 border border-gray-300 rounded-lg text-[11px] font-bold shrink-0 transition-colors cursor-pointer" title="Gerar nova senha web">Gerar</button>
                </div>
              </div>
            </div>

            <!-- Linha 5: Observação Clínica & Observação Geral -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-2.5">
              <div class="flex flex-col">
                <label class="font-bold text-gray-700 text-[11px] mb-0.5">Observação Clínica</label>
                <textarea name="clinicalNotes" id="form-clinicalNotes" rows="1" placeholder="Histórico ou condição clínica relevante (ex: hipertensão, veias difíceis...)" class="w-full px-3 py-1.5 bg-white border border-gray-300 rounded-lg text-xs outline-none focus:ring-1 focus:ring-emerald-500"></textarea>
              </div>
              <div class="flex flex-col">
                <label class="font-bold text-gray-700 text-[11px] mb-0.5">Observação Geral / Atendimento</label>
                <textarea name="obs" id="form-obs" rows="1" placeholder="Observações administrativas ou de atendimento do paciente" class="w-full px-3 py-1.5 bg-white border border-gray-300 rounded-lg text-xs outline-none focus:ring-1 focus:ring-emerald-500"></textarea>
              </div>
            </div>

          </div>

          <!-- Lado Direito: Box de Foto do Paciente -->
          <div class="lg:col-span-2 flex flex-col items-center justify-center border-2 border-dashed border-gray-300 rounded-2xl p-3 bg-white text-center cursor-pointer hover:border-emerald-500 transition-colors group min-h-[220px]" onclick="triggerPhotoUpload()">
            <div id="photoPreviewContainer" class="flex flex-col items-center">
              <svg class="w-12 h-12 text-gray-300 group-hover:text-emerald-500 transition-colors" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg>
              <span class="text-[11px] text-gray-400 font-medium mt-1">Foto do Paciente</span>
            </div>
            <input type="file" id="patientPhotoInput" accept="image/*" class="hidden" onchange="handlePhotoSelect(event)">
          </div>

        </div>

      </div>

      <!-- SISTEMA DE ABAS (TABS) - Endereço em Primeiro Lugar -->
      <div class="border-b border-gray-200">
        <nav class="flex space-x-1 overflow-x-auto text-xs font-bold" id="patientTabs">
          <button type="button" onclick="switchTab('endereco')" id="tab-btn-endereco" class="px-4 py-2 border-b-2 border-emerald-600 text-emerald-700 bg-emerald-50/50 rounded-t-lg transition-all cursor-pointer">Endereço</button>
          <button type="button" onclick="switchTab('adicionais')" id="tab-btn-adicionais" class="px-4 py-2 border-b-2 border-transparent text-gray-500 hover:text-gray-800 rounded-t-lg transition-all cursor-pointer">Adicionais / Responsáveis</button>
          <button type="button" onclick="switchTab('convenio')" id="tab-btn-convenio" class="px-4 py-2 border-b-2 border-transparent text-gray-500 hover:text-gray-800 rounded-t-lg transition-all cursor-pointer">Convênio / Médico</button>
          <button type="button" onclick="switchTab('medicamento')" id="tab-btn-medicamento" class="px-4 py-2 border-b-2 border-transparent text-gray-500 hover:text-gray-800 rounded-t-lg transition-all cursor-pointer">Medicamento</button>
          <button type="button" onclick="switchTab('coleta')" id="tab-btn-coleta" class="px-4 py-2 border-b-2 border-transparent text-gray-500 hover:text-gray-800 rounded-t-lg transition-all cursor-pointer">Obs. Coleta</button>
          <button type="button" onclick="switchTab('historicos')" id="tab-btn-historicos" class="px-4 py-2 border-b-2 border-transparent text-gray-500 hover:text-gray-800 rounded-t-lg transition-all cursor-pointer">Históricos</button>
        </nav>
      </div>

      <!-- ABA 1: ENDEREÇO (PRIMEIRA ABA) -->
      <div id="tab-content-endereco" class="tab-pane space-y-3">
        <div class="bg-gray-50/60 p-4 rounded-xl border border-gray-200 space-y-3">
          <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 items-center">
            <div class="sm:col-span-4 flex items-center gap-1">
              <label class="w-20 font-bold text-gray-700 text-right pr-1">CEP:</label>
              <input type="text" name="cep" id="form-cep" placeholder="86390-000" class="flex-1 px-2 py-1 bg-white border border-gray-300 rounded text-xs font-mono outline-none">
              <button type="button" onclick="searchCep()" class="px-2 py-1 bg-emerald-600 hover:bg-emerald-700 text-white rounded text-xs font-bold">Buscar</button>
            </div>
            <div class="sm:col-span-8 flex items-center gap-1">
              <label class="w-20 font-bold text-gray-700 text-right pr-1">Logradouro:</label>
              <input type="text" name="street" id="form-street" placeholder="Rua / Avenida" class="flex-1 px-2 py-1 bg-white border border-gray-300 rounded text-xs outline-none">
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 items-center">
            <div class="sm:col-span-4 flex items-center gap-1">
              <label class="w-20 font-bold text-gray-700 text-right pr-1">Número:</label>
              <input type="text" name="number" id="form-number" placeholder="123" class="flex-1 px-2 py-1 bg-white border border-gray-300 rounded text-xs outline-none">
            </div>
            <div class="sm:col-span-8 flex items-center gap-1">
              <label class="w-20 font-bold text-gray-700 text-right pr-1">Complemento:</label>
              <input type="text" name="complement" id="form-complement" placeholder="Apto 101, Bloco B" class="flex-1 px-2 py-1 bg-white border border-gray-300 rounded text-xs outline-none">
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 items-center">
            <div class="sm:col-span-5 flex items-center gap-1">
              <label class="w-20 font-bold text-gray-700 text-right pr-1">Bairro:</label>
              <input type="text" name="neighborhood" id="form-neighborhood" placeholder="Centro" class="flex-1 px-2 py-1 bg-white border border-gray-300 rounded text-xs outline-none">
            </div>
            <div class="sm:col-span-5 flex items-center gap-1">
              <label class="w-16 font-bold text-gray-700 text-right pr-1">Cidade:</label>
              <input type="text" name="city" id="form-city" value="Cambará" class="flex-1 px-2 py-1 bg-white border border-gray-300 rounded text-xs outline-none">
            </div>
            <div class="sm:col-span-2 flex items-center gap-1">
              <label class="font-bold text-gray-700 pr-1">UF:</label>
              <select name="state" id="form-state" class="w-full px-1 py-1 bg-white border border-gray-300 rounded text-xs font-mono outline-none">
                <option value="PR">PR</option>
                <option value="SP">SP</option>
                <option value="SC">SC</option>
                <option value="RS">RS</option>
                <option value="MS">MS</option>
                <option value="MG">MG</option>
                <option value="RJ">RJ</option>
              </select>
            </div>
          </div>

          <div class="flex items-center gap-1">
            <label class="w-20 font-bold text-gray-700 text-right pr-1">Ponto Ref.:</label>
