        </div>
        <button type="button" class="px-3 py-1.5 bg-slate-100 group-hover:bg-emerald-600 text-slate-600 group-hover:text-white font-bold text-xs rounded-xl transition-all shrink-0">
          Selecionar →
        </button>
      `;
      container.appendChild(card);
    });
  }

  function selectGenericItemObj(item) {
    if (activeSearchType === 'convenio') {
      const raw = item.raw;
      const convName = raw ? (raw.fantasia || raw.razaoSocial) : item.name;
      const convCode = raw ? (raw.codigo || item.code.replace('Cód ', '')) : item.code;
      const convId = raw ? raw.id : '';

      const convSelect = document.getElementById('req-convenio');
      if (convSelect) {
        let optionExists = Array.from(convSelect.options).some(opt => opt.value === convName);
        if (!optionExists && convName) {
          const newOpt = document.createElement('option');
          newOpt.value = convName;
          newOpt.setAttribute('data-code', convCode);
          newOpt.setAttribute('data-id', convId);
          newOpt.textContent = convName;
          convSelect.appendChild(newOpt);
        }
        convSelect.value = convName;
      }
      if (document.getElementById('req-convenioCode')) document.getElementById('req-convenioCode').value = convCode;
      if (document.getElementById('req-convenioId')) document.getElementById('req-convenioId').value = convId;

      closeGenericSearchModal();
      recalculateRequisitionExamPrices();
    }
    else if (activeSearchType === 'exame') {
      const raw = item.raw || availableExamsList.find(e => (e.code || '').toLowerCase() === (item.code || '').toLowerCase());
      if (raw) {
        selectExamFromAutocomplete(raw.code);
      }
      closeGenericSearchModal();
    }
    else if (activeSearchType === 'medico') {
      const raw = item.raw;
      if (raw) {
        if (document.getElementById('req-doctorName')) document.getElementById('req-doctorName').value = raw.nome || '';
        if (document.getElementById('req-doctorCrmType')) document.getElementById('req-doctorCrmType').value = raw.conselho || 'CRM';
        if (document.getElementById('req-doctorCrm')) document.getElementById('req-doctorCrm').value = raw.numero || '';
        if (document.getElementById('req-doctorUf')) document.getElementById('req-doctorUf').value = raw.uf || 'PR';
      } else {
        if (document.getElementById('req-doctorName')) document.getElementById('req-doctorName').value = item.name || '';
        if (item.code && item.code.includes(' ')) {
          const parts = item.code.split(' ');
          if (parts[0]) document.getElementById('req-doctorCrmType').value = parts[0];
          if (parts[1] && parts[1].includes('/')) {
            const [num, uf] = parts[1].split('/');
            document.getElementById('req-doctorCrm').value = num;
            document.getElementById('req-doctorUf').value = uf;
          }
        }
      }
      closeGenericSearchModal();
    }
    else if (activeSearchType === 'situacao') {
      document.getElementById('req-situacao').value = item.name;
      closeGenericSearchModal();
    }
    else if (activeSearchType === 'coleta') {
      document.getElementById('req-coleta').value = item.name;
      closeGenericSearchModal();
    }
    else if (activeSearchType === 'destino') {
      document.getElementById('req-destino').value = item.name;
      closeGenericSearchModal();
    }
    else if (activeSearchType === 'empresa') {
      document.getElementById('req-empresa').value = item.name;
      closeGenericSearchModal();
    }
    else if (activeSearchType === 'dum') {
      closeGenericSearchModal();
    }
    else {
      closeGenericSearchModal();
    }
  }

  // Preenchimento automático ao selecionar ou digitar médico
  document.getElementById('req-doctorName')?.addEventListener('input', function(e) {
    const val = e.target.value.trim().toLowerCase();
    if (!val) return;
    const found = medicosListFromDb.find(m => (m.nome || '').toLowerCase() === val);
    if (found) {
      if (document.getElementById('req-doctorCrmType')) document.getElementById('req-doctorCrmType').value = found.conselho || 'CRM';
      if (document.getElementById('req-doctorCrm')) document.getElementById('req-doctorCrm').value = found.numero || '';
      if (document.getElementById('req-doctorUf')) document.getElementById('req-doctorUf').value = found.uf || 'PR';
    }
  });

  document.getElementById('req-doctorCrm')?.addEventListener('input', function(e) {
    const crmVal = e.target.value.trim();
    if (!crmVal) return;
    const found = medicosListFromDb.find(m => String(m.numero || '').trim() === crmVal);
    if (found) {
      if (document.getElementById('req-doctorName')) document.getElementById('req-doctorName').value = found.nome || '';
      if (document.getElementById('req-doctorCrmType')) document.getElementById('req-doctorCrmType').value = found.conselho || 'CRM';
      if (document.getElementById('req-doctorUf')) document.getElementById('req-doctorUf').value = found.uf || 'PR';
    }
  });

  // Preenchimento automático do nome do convênio ao digitar o código
  document.getElementById('req-convenioCode')?.addEventListener('input', function(e) {
    const codeVal = e.target.value.trim();
    const select = document.getElementById('req-convenio');
    if (!codeVal) {
      if (select) select.value = '';
      if (document.getElementById('req-convenioId')) document.getElementById('req-convenioId').value = '';
      recalculateRequisitionExamPrices();
      return;
    }
    const found = conveniosListFromDb.find(c => String(c.codigo) === codeVal || String(c.id) === codeVal);
    if (found && select) {
      const nameVal = found.fantasia || found.razaoSocial;
      let optionExists = Array.from(select.options).some(opt => opt.value === nameVal);
      if (!optionExists) {
        const newOpt = document.createElement('option');
        newOpt.value = nameVal;
        newOpt.setAttribute('data-code', found.codigo || '');
        newOpt.setAttribute('data-id', found.id || '');
        newOpt.textContent = nameVal;
        select.appendChild(newOpt);
      }
      select.value = nameVal;
      if (document.getElementById('req-convenioId')) document.getElementById('req-convenioId').value = found.id;
    } else if (select) {
      select.value = '';
      if (document.getElementById('req-convenioId')) document.getElementById('req-convenioId').value = '';
    }
    recalculateRequisitionExamPrices();
  });

  document.getElementById('req-convenio')?.addEventListener('change', function(e) {
    const selectedOpt = this.options[this.selectedIndex];
    if (selectedOpt && selectedOpt.value) {
      const codeVal = selectedOpt.getAttribute('data-code') || '';
      const idVal = selectedOpt.getAttribute('data-id') || '';
      if (document.getElementById('req-convenioCode')) document.getElementById('req-convenioCode').value = codeVal;
      if (document.getElementById('req-convenioId')) document.getElementById('req-convenioId').value = idVal;
    } else {
      if (document.getElementById('req-convenioCode')) document.getElementById('req-convenioCode').value = '';
      if (document.getElementById('req-convenioId')) document.getElementById('req-convenioId').value = '';
    }
    recalculateRequisitionExamPrices();
  });

  // Atalhos de Teclado Parametrizados no LIS (Novo Registro, Salvar, Cancelar, ESC, Busca, Navegação)
  document.addEventListener('keydown', (e) => {
    const reqModal = document.getElementById('requisitionFormModal');
    const isReqModalOpen = reqModal && !reqModal.classList.contains('hidden');

    // 1. ESC - Fechar modais / Cancelar
    if (e.key === 'Escape') {
      const qvModal = document.getElementById('requisitionQuickViewModal');
      const valModal = document.getElementById('validationErrorModal');
      const prepModal = document.getElementById('modalPrepInstructions');
      const pReg = document.getElementById('modalPatientRegister');
      const pSearch = document.getElementById('modalPatientSearch');
      const gSearch = document.getElementById('modalGenericSearch');

      if (qvModal && !qvModal.classList.contains('hidden')) {
        closeQuickViewModal();
        return;
      }
      const cashierModal = document.getElementById('modalPaymentCashier');
      if (cashierModal && !cashierModal.classList.contains('hidden')) {
        closePaymentCashierModal();
        return;
      }
      if (valModal && !valModal.classList.contains('hidden')) {
        closeValidationErrorModal();
        return;
      }
      if (prepModal && !prepModal.classList.contains('hidden')) {
        closePrepInstructionsModal();
        return;
      }
      if (pReg && !pReg.classList.contains('hidden')) {
        closePatientRegisterModal();
        return;
      }
      if (pSearch && !pSearch.classList.contains('hidden')) {
        closePatientSearchModal();
        return;
      }
      if (gSearch && !gSearch.classList.contains('hidden')) {
        closeGenericSearchModal();
        return;
      }
      if (isReqModalOpen) {
        cancelRequisitionForm();
        return;
      }
    }

    // 2. Atalhos de Navegação de Etapas na Requisição (Alt + Left ou Alt + V -> Voltar; Alt + Right ou Alt + P -> Próximo)
    if (isReqModalOpen && e.altKey) {
      if (e.key === 'ArrowLeft' || e.key.toLowerCase() === 'v') {
        e.preventDefault();
        const step2 = document.getElementById('requisitionStep2');
        const step3 = document.getElementById('requisitionStep3');
        if (step3 && !step3.classList.contains('hidden')) {
          switchRequisitionStep(2);
        } else {
          switchRequisitionStep(1);
        }
        return;
      }
      if (e.key === 'ArrowRight' || e.key.toLowerCase() === 'p') {
        e.preventDefault();
        const step1 = document.getElementById('requisitionStep1');
        const step2 = document.getElementById('requisitionStep2');
        if (step1 && !step1.classList.contains('hidden')) {
          switchRequisitionStep(2);
        } else if (step2 && !step2.classList.contains('hidden')) {
          switchRequisitionStep(3);
        }
        return;
      }
    }

    // 3. Finalizar Requisição / Salvar (Ctrl + Enter)
    if (isReqModalOpen && (e.ctrlKey || e.metaKey) && e.key === 'Enter') {
      e.preventDefault();
      const form = document.getElementById('requisitionMainForm');
      if (form) form.requestSubmit();
      return;
    }

    // 4. Fechar Modal via função global de atalhos
    if (window.matchShortcut && window.matchShortcut(e, 'closeModal')) {
      if (isReqModalOpen) cancelRequisitionForm();
      return;
    }

    // 5. Novo Registro (Ex: CTRL + N)
    if (window.matchShortcut && window.matchShortcut(e, 'newRecord')) {
      e.preventDefault();
      if (!document.getElementById('modalPatientSearch').classList.contains('hidden')) {
        openPatientRegisterModal();
      } else {
        startNewRequisition();
      }
      return;
    }

    // 6. Salvar (Ex: CTRL + S)
    if (window.matchShortcut && window.matchShortcut(e, 'save')) {
      e.preventDefault();
      if (!document.getElementById('modalPatientRegister').classList.contains('hidden')) {
        const pForm = document.getElementById('ajaxPatientForm');
        if (pForm) pForm.requestSubmit();
      } else if (isReqModalOpen) {
        const form = document.getElementById('requisitionMainForm');
        if (form) form.requestSubmit();
      }
      return;
    }

    // 7. Cancelar / Limpar (Ex: CTRL + C)
    if (window.matchShortcut && window.matchShortcut(e, 'cancel')) {
      const selectedText = window.getSelection() ? window.getSelection().toString() : '';
      if (!selectedText && isReqModalOpen) {
        e.preventDefault();
        cancelRequisitionForm();
      }
      return;
    }

    // 8. Buscar Paciente (Ex: CTRL + P)
    if (window.matchShortcut && window.matchShortcut(e, 'searchPatient')) {
      e.preventDefault();
      openPatientSearchModal();
      return;
    }
  });
</script>

