  function calcFinancials() {
    let subtotal = 0;
    (currentRequisitionExams || []).forEach(e => {
      subtotal += parseFloat(e.price) || 0;
    });

    const hiddenDisc = document.getElementById('req-discount');
    const hiddenDiscPct = document.getElementById('req-discountPercent');
    const valInput = document.getElementById('req-discountValInput');

    if (currentDiscountMode === 'percent') {
      const pctVal = valInput ? (parseFloat(valInput.value) || 0) : 0;
      const discountVal = (subtotal * pctVal) / 100;
      if (hiddenDisc) hiddenDisc.value = discountVal.toFixed(2);
      if (hiddenDiscPct) hiddenDiscPct.value = pctVal.toFixed(1);
    } else if (currentDiscountMode === 'currency') {
      const discountVal = valInput ? (parseFloat(valInput.value) || 0) : 0;
      const pctVal = subtotal > 0 ? (discountVal / subtotal) * 100 : 0;
      if (hiddenDisc) hiddenDisc.value = discountVal.toFixed(2);
      if (hiddenDiscPct) hiddenDiscPct.value = pctVal.toFixed(1);
    }

    const discount = hiddenDisc ? (parseFloat(hiddenDisc.value) || 0) : 0;
    const discountPct = hiddenDiscPct ? (parseFloat(hiddenDiscPct.value) || 0) : 0;

    const discountValRealLabel = document.getElementById('req-discountValRealLabel');
    const discountValPercentLabel = document.getElementById('req-discountValPercentLabel');
    if (discountValRealLabel) discountValRealLabel.textContent = 'R$ ' + discount.toFixed(2).replace('.', ',');
    if (discountValPercentLabel) discountValPercentLabel.textContent = discountPct.toFixed(1).replace('.', ',') + '%';

    let total = subtotal - discount;
    if (total < 0) total = 0;

    // Multiguias / Faturamento
    const isFat = isConvenioFaturamento();
    const isMG = isMultiguiaActive();

    let convenioCount = 0;
    let convenioSum = 0;
    let particularCount = 0;
    let particularSum = 0;

    (currentRequisitionExams || []).forEach(e => {
      const p = parseFloat(e.price) || 0;
      const cat = e.billingCategory || (isFat ? 'convenio' : 'particular');
      if (cat === 'particular') {
        particularCount++;
        particularSum += p;
      } else {
        convenioCount++;
        convenioSum += p;
      }
    });

    const convSumElem = document.getElementById('examSummaryConvenioVal');
    if (convSumElem) convSumElem.textContent = `${convenioCount} (${convenioCount === 1 ? '1 exame' : convenioCount + ' exames'}) - R$ ${convenioSum.toFixed(2).replace('.', ',')}`;

    const partSumElem = document.getElementById('examSummaryParticularVal');
    if (partSumElem) partSumElem.textContent = `${particularCount} (${particularCount === 1 ? '1 exame' : particularCount + ' exames'}) - R$ ${particularSum.toFixed(2).replace('.', ',')}`;

    const fatInput = document.getElementById('req-faturadoValInput');
    let faturadoVal = 0;
    if (fatInput) {
      if (fatInput.dataset.userTouched !== 'true') {
        faturadoVal = isMG ? Math.min(total, convenioSum) : (isFat ? total : 0);
        fatInput.value = faturadoVal.toFixed(2);
      } else {
        faturadoVal = parseFloat(fatInput.value) || 0;
      }
    } else {
      faturadoVal = isMG ? Math.min(total, convenioSum) : (isFat ? total : 0);
    }

    const balcaoDevido = Math.max(0, total - faturadoVal);

    // Atualizar resumo do Step 1 (quando a flag de Multiguias estiver ativa)
    const st1Conv = document.getElementById('step1ConvenioVal');
    if (st1Conv) st1Conv.textContent = 'R$ ' + (isMG ? convenioSum : (isFat ? total : 0)).toFixed(2).replace('.', ',');

    const st1Part = document.getElementById('step1ParticularVal');
    if (st1Part) st1Part.textContent = 'R$ ' + (isMG ? balcaoDevido : (isFat ? 0 : total)).toFixed(2).replace('.', ',');

    const st1Tot = document.getElementById('step1TotalVal');
    if (st1Tot) st1Tot.textContent = 'R$ ' + total.toFixed(2).replace('.', ',');

    // Calcular soma dos pagamentos da lista
    const paidSum = (currentRequisitionPayments || []).reduce((acc, p) => acc + (parseFloat(p.amount) || 0), 0);

    const paidInput = document.getElementById('req-paidAmount');
    if (paidInput) paidInput.value = paidSum.toFixed(2);
    const paid = paidSum;

    const balcaoRemaining = balcaoDevido - paid;

    // Atualizar displays do Painel de Multiguias
    const balcaoDevidoDisplay = document.getElementById('step3BalcaoDevidoDisplay');
    if (balcaoDevidoDisplay) {
      balcaoDevidoDisplay.textContent = 'R$ ' + balcaoDevido.toFixed(2).replace('.', ',');
    }

    const balcaoRemainingDisplay = document.getElementById('step3BalcaoRemainingDisplay');
    if (balcaoRemainingDisplay) {
      if (balcaoRemaining <= 0) {
        balcaoRemainingDisplay.textContent = 'R$ 0,00 (QUITADO)';
        balcaoRemainingDisplay.className = 'text-sm font-extrabold font-mono text-emerald-700 block pt-0.5';
      } else {
        balcaoRemainingDisplay.textContent = 'R$ ' + balcaoRemaining.toFixed(2).replace('.', ',');
        balcaoRemainingDisplay.className = 'text-sm font-extrabold font-mono text-amber-700 block pt-0.5';
      }
    }

    // Atualizar JSON oculto dos pagamentos
    const paymentsJsonElem = document.getElementById('req-paymentsJson');
    if (paymentsJsonElem) paymentsJsonElem.value = JSON.stringify(currentRequisitionPayments || []);

    if (currentRequisitionPayments && currentRequisitionPayments.length > 0) {
      const uniqueMethods = [...new Set(currentRequisitionPayments.map(p => p.methodName).filter(Boolean))];
      const uniqueConds = [...new Set(currentRequisitionPayments.map(p => p.conditionName).filter(Boolean))];
      const reqMethodElem = document.getElementById('req-paymentMethod');
      const reqCondElem = document.getElementById('req-paymentCondition');
      if (reqMethodElem) reqMethodElem.value = uniqueMethods.join(' + ');
      if (reqCondElem) reqCondElem.value = uniqueConds.join(' + ');
    }

    const remaining = total - paid;

    const subtotalDisplay = document.getElementById('req-subtotalSummary');
    const subtotalDisplayInput = document.getElementById('req-subtotalDisplay');
    const tableSubtotalVal = document.getElementById('tableSubtotalVal');
    const subtotalInput = document.getElementById('req-subtotalInput');
    const totalDisplay = document.getElementById('req-totalAmountDisplay');
    const headerTotalDisplay = document.getElementById('headerTotalDisplay');
    const totalInput = document.getElementById('req-totalAmountInput');
    const remainingLabel = document.getElementById('req-remainingBalanceLabel');
    const remainingDisplay = document.getElementById('req-remainingBalanceDisplay');
    const statusSelect = document.getElementById('req-financialStatus');

    const formattedSub = 'R$ ' + subtotal.toFixed(2).replace('.', ',');
    const formattedTot = 'R$ ' + total.toFixed(2).replace('.', ',');

    if (subtotalDisplay) subtotalDisplay.textContent = formattedSub;
    if (subtotalDisplayInput) subtotalDisplayInput.value = subtotal.toFixed(2).replace('.', ',');
    if (tableSubtotalVal) tableSubtotalVal.textContent = formattedSub;
    if (subtotalInput) subtotalInput.value = subtotal.toFixed(2);

    if (totalDisplay) {
      if (totalDisplay.tagName === 'INPUT') {
        totalDisplay.value = total.toFixed(2).replace('.', ',');
      } else {
        totalDisplay.textContent = formattedTot;
      }
    }
    if (headerTotalDisplay) headerTotalDisplay.textContent = 'Líquido: ' + formattedTot;
    if (totalInput) totalInput.value = total.toFixed(2);

    if (remainingDisplay && remainingLabel) {
      if (balcaoRemaining <= 0) {
        remainingLabel.textContent = 'Balcão Quitado:';
        remainingLabel.className = 'text-emerald-400 font-bold';
        remainingDisplay.textContent = 'R$ ' + Math.abs(balcaoRemaining).toFixed(2).replace('.', ',');
        remainingDisplay.className = 'text-emerald-300 font-black';
      } else {
        remainingLabel.textContent = 'Balcão Devedor:';
        remainingLabel.className = 'text-amber-400 font-bold';
        remainingDisplay.textContent = 'R$ ' + balcaoRemaining.toFixed(2).replace('.', ',');
        remainingDisplay.className = 'text-amber-300 font-black';
      }
    }

    let calculatedStatus = 'Pendente';
    if (faturadoVal >= total && total > 0) {
      calculatedStatus = 'Faturado Convênio';
    } else if (faturadoVal > 0 && balcaoDevido > 0) {
      if (paid >= balcaoDevido) {
        calculatedStatus = 'Faturado + Quitado';
      } else {
        calculatedStatus = 'Parcial';
      }
    } else if (paid >= total && total > 0) {
      calculatedStatus = 'Pago';
    } else if (paid > 0 && paid < total) {
      calculatedStatus = 'Parcial';
    } else if (paid === 0) {
      calculatedStatus = 'Pendente';
    }

    if (statusSelect) statusSelect.value = calculatedStatus;

    // Atualizar displays da Etapa 3 (Resumo de Pagamentos)
    const st3Subtotal = document.getElementById('step3SubtotalDisplay');
    const st3Discount = document.getElementById('step3DiscountDisplay');
    const st3Total = document.getElementById('step3TotalDisplay');
    const st3Paid = document.getElementById('step3PaidDisplay');
    const st3Remaining = document.getElementById('step3RemainingDisplay');
    const st3RemainingLabel = document.getElementById('step3RemainingLabel');
    const st3StatusBadge = document.getElementById('step3StatusBadge');

    if (st3Subtotal) st3Subtotal.textContent = formattedSub;
    if (st3Discount) st3Discount.textContent = 'R$ ' + discount.toFixed(2).replace('.', ',');
    if (st3Total) st3Total.textContent = formattedTot;
    if (st3Paid) st3Paid.textContent = 'R$ ' + paid.toFixed(2).replace('.', ',');

    if (st3Remaining && st3RemainingLabel) {
      if (balcaoRemaining <= 0) {
        st3RemainingLabel.textContent = 'BALCÃO QUITADO';
        st3RemainingLabel.className = 'block text-[10px] font-bold text-emerald-700 uppercase tracking-wider';
        st3Remaining.textContent = 'R$ ' + Math.abs(balcaoRemaining).toFixed(2).replace('.', ',');
        st3Remaining.className = 'text-sm font-extrabold font-mono text-emerald-700';
      } else {
        st3RemainingLabel.textContent = 'SALDO DEVEDOR BALCÃO';
        st3RemainingLabel.className = 'block text-[10px] font-bold text-amber-700 uppercase tracking-wider';
        st3Remaining.textContent = 'R$ ' + balcaoRemaining.toFixed(2).replace('.', ',');
        st3Remaining.className = 'text-sm font-extrabold font-mono text-amber-700';
      }
    }

    if (st3StatusBadge) {
      if (calculatedStatus === 'Pago' || calculatedStatus === 'Faturado Convênio' || calculatedStatus === 'Cortesia' || calculatedStatus === 'Faturado + Quitado') {
        st3StatusBadge.className = "px-3 py-1 rounded-xl text-xs font-mono font-black uppercase bg-emerald-100 text-emerald-900 border border-emerald-300";
        st3StatusBadge.textContent = "QUITADO (" + calculatedStatus + ")";
      } else if (calculatedStatus === 'Parcial') {
        st3StatusBadge.className = "px-3 py-1 rounded-xl text-xs font-mono font-black uppercase bg-sky-100 text-sky-900 border border-sky-300";
        st3StatusBadge.textContent = "PARCIAL";
      } else {
        st3StatusBadge.className = "px-3 py-1 rounded-xl text-xs font-mono font-black uppercase bg-amber-100 text-amber-900 border border-amber-300";
        st3StatusBadge.textContent = "PENDENTE";
      }
    }

    const stepBadge = document.getElementById('stepTabExamsBadge');
    if (stepBadge) {
      stepBadge.textContent = `${currentRequisitionExams.length} exame(s) (${formattedTot})`;
    }

    const payTabBadge = document.getElementById('stepTabPaymentsBadge');
    if (payTabBadge) {
      if (paid >= total && total > 0) {
        payTabBadge.className = "bg-emerald-100 text-emerald-900 text-[10px] font-mono px-2 py-0.5 rounded-full font-extrabold border border-emerald-300/80";
        payTabBadge.textContent = `Quitado (R$ ${paid.toFixed(2).replace('.', ',')})`;
      } else if (paid > 0) {
        payTabBadge.className = "bg-sky-100 text-sky-900 text-[10px] font-mono px-2 py-0.5 rounded-full font-extrabold border border-sky-300/80";
        payTabBadge.textContent = `Parcial (R$ ${paid.toFixed(2).replace('.', ',')})`;
      } else {
        payTabBadge.className = "bg-amber-100 text-amber-900 text-[10px] font-mono px-2 py-0.5 rounded-full font-extrabold border border-amber-300/80";
        payTabBadge.textContent = `Pendente (R$ 0,00)`;
      }
    }
  }

  // --- AUTOCOMPLETE DE EXAMES NA BUSCA ---
  function filterExamAutocomplete(val) {
    const list = document.getElementById('examAutocompleteList');
    if (!list) return;

    const q = (val || '').trim().toLowerCase();
    if (!q || q.length < 1) {
      list.classList.add('hidden');
      currentlySelectedExamForInput = null;
      populateExamMaterialsCombo(null);
      return;
    }

    if (currentlySelectedExamForInput) {
      const exName = (currentlySelectedExamForInput.name || '').toLowerCase();
      const exCode = (currentlySelectedExamForInput.code || '').toLowerCase();
      if (!val.toLowerCase().includes(exCode) && !val.toLowerCase().includes(exName)) {
        currentlySelectedExamForInput = null;
        populateExamMaterialsCombo(null);
      }
    }

    const matches = availableExamsList.filter(e => 
      (e.code || '').toLowerCase().includes(q) ||
      (e.name || '').toLowerCase().includes(q) ||
      (e.category || '').toLowerCase().includes(q)
    ).slice(0, 10);

    if (matches.length === 0) {
      list.innerHTML = `
        <div class="p-3 text-center text-gray-500 italic text-xs">
          Nenhum exame encontrado com "${val}". Clique em <b>+ Add</b> para incluir como personalizado.
        </div>
      `;
      list.classList.remove('hidden');
      return;
    }

    let html = '';
    matches.forEach(e => {
      const price = getExamPriceForConvenio(e);
      html += `
        <div class="p-3 hover:bg-emerald-50 cursor-pointer flex items-center justify-between transition-colors border-b border-gray-100" onclick="selectExamFromAutocomplete('${e.code}')">
          <div>
            <div class="flex items-center gap-2">
              <span class="font-mono font-extrabold text-emerald-800 text-xs bg-emerald-100 px-1.5 py-0.5 rounded">${e.code}</span>
              <strong class="text-gray-900 text-xs">${e.name}</strong>
            </div>
            <p class="text-[10px] text-gray-500 mt-0.5 font-mono">Categoria: ${e.category || 'Geral'} | Jejum: ${e.fasting || '4h'}</p>
          </div>
          <span class="font-mono font-black text-emerald-800 text-xs">R$ ${price.toFixed(2).replace('.', ',')}</span>
        </div>
      `;
    });

    list.innerHTML = html;
    list.classList.remove('hidden');
  }

  function selectExamFromAutocomplete(code) {
    const found = availableExamsList.find(e => (e.code || '').toLowerCase() === (code || '').toLowerCase());
    if (found) {
      currentlySelectedExamForInput = found;
      const searchInput = document.getElementById('req-examSearchInput');
      const priceInput = document.getElementById('req-examPrice');
      const list = document.getElementById('examAutocompleteList');

      if (searchInput) searchInput.value = `[${found.code}] ${found.name}`;
      if (list) list.classList.add('hidden');

      populateExamMaterialsCombo(found);

      if (priceInput) priceInput.value = '';

      const materialSelect = document.getElementById('req-examMaterial');
      if (materialSelect) materialSelect.focus();
    }
  }

  // Mask helper for CPF
  function applyCpfMask(v) {
    if (!v) return '';
    v = v.replace(/\D/g, '');
    if (v.length > 11) v = v.substring(0, 11);
    return v
      .replace(/(\d{3})(\d)/, '$1.$2')
      .replace(/(\d{3})(\d)/, '$1.$2')
      .replace(/(\d{3})(\d{1,2})$/, '$1-$2');
  }

  // Calculation of Age
  function calcReqAge() {
    const dob = document.getElementById('req-patientBirthDate').value;
    if (!dob) {
      document.getElementById('req-patientAge').value = '';
      return;
    }
    const birth = new Date(dob);
    const now = new Date();
    let years = now.getFullYear() - birth.getFullYear();
    let months = now.getMonth() - birth.getMonth();
    if (months < 0 || (months === 0 && now.getDate() < birth.getDate())) {
      years--;
    }
    document.getElementById('req-patientAge').value = years + ' ano(s)';
  }

  function calcModalPAge() {
    const dob = document.getElementById('modal-p-birthDate').value;
    if (!dob) return;
    const birth = new Date(dob);
    const now = new Date();
    let years = now.getFullYear() - birth.getFullYear();
    if (now.getMonth() < birth.getMonth() || (now.getMonth() === birth.getMonth() && now.getDate() < birth.getDate())) {
      years--;
    }
    document.getElementById('modal-p-ageValue').value = years;
  }

  // Preencher Formulario de Requisição a partir de um Objeto Paciente
  function fillPatientIntoRequisition(p) {
    if (!p) return;
    document.getElementById('req-patientCode').value = p.code || p.id || '';
    document.getElementById('req-patientName').value = p.name || '';
    document.getElementById('req-patientBirthDate').value = p.birthDate || '';
    calcReqAge();
    if (p.sex) document.getElementById('req-patientSex').value = p.sex;
    document.getElementById('req-address').value = p.street ? (p.street + (p.number ? ', ' + p.number : '') + (p.neighborhood ? ' - ' + p.neighborhood : '')) : '';
    document.getElementById('req-complement').value = p.complement || '';
    document.getElementById('req-city').value = p.city || 'Cambará';
    document.getElementById('req-cep').value = p.cep || '';
    document.getElementById('req-patientPhone').value = p.whatsapp || p.phone || '';
    document.getElementById('req-responsibleName').value = p.responsibleName || p.motherName || '';
    document.getElementById('req-clinicalNotes').value = p.clinicalNotes || '';
    
    const convSelect = document.getElementById('req-convenio');
    const isEditingExistingReq = !!document.getElementById('req-id').value;

    if (isEditingExistingReq) {
      const pConv = p.convenio || '';
      const pConvCode = p.convenioCode || '';
      const pConvId = p.convenioId || '';

      if (convSelect) {
        if (pConv) {
          let optionExists = Array.from(convSelect.options).some(opt => opt.value === pConv);
          if (!optionExists) {
            const newOpt = document.createElement('option');
            newOpt.value = pConv;
            newOpt.setAttribute('data-code', pConvCode);
            newOpt.setAttribute('data-id', pConvId);
            newOpt.textContent = `[Cód ${pConvCode || '?'}] ${pConv}`;
            convSelect.appendChild(newOpt);
          }
          convSelect.value = pConv;
          document.getElementById('req-convenioCode').value = pConvCode;
          if (document.getElementById('req-convenioId')) document.getElementById('req-convenioId').value = pConvId;
        } else {
          convSelect.value = '';
          document.getElementById('req-convenioCode').value = '';
          if (document.getElementById('req-convenioId')) document.getElementById('req-convenioId').value = '';
        }
      }
    } else {
      // Nova requisição: sempre mantém o campo Convênio limpo/vazio para forçar a escolha manual
      if (convSelect) convSelect.value = '';
      if (document.getElementById('req-convenioCode')) document.getElementById('req-convenioCode').value = '';
      if (document.getElementById('req-convenioId')) document.getElementById('req-convenioId').value = '';
    }

    if (p.weight) document.getElementById('req-weight').value = p.weight;
    if (p.height) document.getElementById('req-height').value = p.height;

    // Atualizar o card visual de texto do paciente
    updatePatientCardDisplay();
  }

  // Atualizar visualização de texto do Card "Dados do Paciente"
  function updatePatientCardDisplay() {
    const codeElem = document.getElementById('req-patientCode');
    const nameElem = document.getElementById('req-patientName');
    const birthElem = document.getElementById('req-patientBirthDate');
    const ageElem = document.getElementById('req-patientAge');
    const sexElem = document.getElementById('req-patientSex');
    const addressElem = document.getElementById('req-address');
    const cityElem = document.getElementById('req-city');
    const phoneElem = document.getElementById('req-patientPhone');
    const respElem = document.getElementById('req-responsibleName');

    const code = codeElem ? codeElem.value : '';
    const name = nameElem ? nameElem.value : '';
    const birth = birthElem ? birthElem.value : '';
    const age = ageElem ? ageElem.value : '';
    const sex = sexElem ? sexElem.value : '';
    const address = addressElem ? addressElem.value : '';
    const city = cityElem ? cityElem.value : '';
    const phone = phoneElem ? phoneElem.value : '';
    const resp = respElem ? respElem.value : '';

    const emptyState = document.getElementById('patientCardEmptyState');
    const activeState = document.getElementById('patientCardActiveState');

    if (!name && !code) {
      if (emptyState) emptyState.classList.remove('hidden');
      if (activeState) activeState.classList.add('hidden');
      return;
    }

    if (emptyState) emptyState.classList.add('hidden');
    if (activeState) activeState.classList.remove('hidden');

    // Iniciais do Avatar
    const nameParts = (name || 'Paciente').trim().split(' ');
    let initials = nameParts[0][0] || 'P';
    if (nameParts.length > 1) initials += nameParts[nameParts.length - 1][0] || '';
    const avatarEl = document.getElementById('displayPatientAvatar');
    if (avatarEl) avatarEl.textContent = initials.toUpperCase();

    const dName = document.getElementById('displayPatientName');
    if (dName) dName.textContent = name || 'Paciente sem nome';

    const dCode = document.getElementById('displayPatientCodeBadge');
    if (dCode) dCode.textContent = 'Cód: ' + (code || '—');

    // Localizar CPF cadastrado
    let patientObj = patientsList.find(p => (p.code || p.id) === code || p.name === name);
    let cpfText = 'CPF: Não informado';
    if (patientObj && patientObj.cpf) {
      cpfText = 'CPF: ' + applyCpfMask(patientObj.cpf);
    }
    const dCpf = document.getElementById('displayPatientCpf');
    if (dCpf) dCpf.textContent = cpfText;

    const dSex = document.getElementById('displayPatientSex');
    if (dSex) dSex.textContent = 'Sexo: ' + (sex || 'Não informado');

    let birthFormatted = 'Não informada';
    if (birth) {
      const parts = birth.split('-');
      if (parts.length === 3) {
        birthFormatted = `${parts[2]}/${parts[1]}/${parts[0]}`;
      } else {
        birthFormatted = birth;
      }
    }
    const dBirth = document.getElementById('displayPatientBirth');
    if (dBirth) dBirth.textContent = birthFormatted;

    const dAge = document.getElementById('displayPatientAge');
    if (dAge) dAge.textContent = age || '—';

    let fullAddress = address || '';
    if (city && !fullAddress.includes(city)) {
      fullAddress += (fullAddress ? ' - ' : '') + city;
    }
    const dAddress = document.getElementById('displayPatientAddress');
    if (dAddress) dAddress.textContent = fullAddress || 'Não informado';

    const dPhone = document.getElementById('displayPatientPhone');
    if (dPhone) dPhone.textContent = phone ? '📱 ' + phone : 'Não informado';

    const dResp = document.getElementById('displayPatientResp');
    if (dResp) dResp.textContent = resp || 'Não informado';

    // Garantir que o painel de detalhes adicionais permaneça fechado por padrão ao trocar/atualizar paciente
    const details = document.getElementById('patientDetailsCollapse');
    const btnText = document.getElementById('togglePatientDetailsBtnText');
    const btnIcon = document.getElementById('togglePatientDetailsBtnIcon');
    if (details) details.classList.add('hidden');
    if (btnText) btnText.textContent = 'Mais detalhes';
    if (btnIcon) btnIcon.textContent = '▼';
  }

  function togglePatientDetailsCollapse() {
    const details = document.getElementById('patientDetailsCollapse');
    const btnText = document.getElementById('togglePatientDetailsBtnText');
    const btnIcon = document.getElementById('togglePatientDetailsBtnIcon');
    if (!details) return;
    if (details.classList.contains('hidden')) {
      details.classList.remove('hidden');
      if (btnText) btnText.textContent = 'Menos detalhes';
      if (btnIcon) btnIcon.textContent = '▲';
    } else {
      details.classList.add('hidden');
      if (btnText) btnText.textContent = 'Mais detalhes';
      if (btnIcon) btnIcon.textContent = '▼';
    }
  }

  function openRequisitionFormModal() {
    const modal = document.getElementById('requisitionFormModal');
    if (modal) modal.classList.remove('hidden');

    const reqId = document.getElementById('req-id').value;
    const reqCodeCard = document.getElementById('requisitionCodeCard');
    if (reqCodeCard) {
      if (reqId && reqId.trim() !== '') {
        reqCodeCard.classList.remove('hidden');
      } else {
        reqCodeCard.classList.add('hidden');
      }
    }
