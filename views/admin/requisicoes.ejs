<script>
  // Dados sincronizados do backend
  let patientsList = <%- JSON.stringify(patients) %>;
  let requisitionsData = <%- JSON.stringify(requisitions) %>;
  const templatesData = <%- JSON.stringify(messageTemplates) %>;
  const availableExamsList = <%- JSON.stringify(exams || []) %>;
  const requisitionShortcutsList = <%- JSON.stringify(locals.requisitionShortcuts || []) %>;

  let currentRequisitionExams = [];
  let selectedPatientInModal = null;
  let activeSearchType = null;

  let pendingValidationFocusAction = null;

  // Validar campos obrigatórios da Etapa 1
  function validateStep1() {
    const patientName = document.getElementById('req-patientName')?.value?.trim() || '';
    const convenio = document.getElementById('req-convenio')?.value?.trim() || '';
    const doctorName = document.getElementById('req-doctorName')?.value?.trim() || '';
    const dateInput = document.getElementById('req-deliveryDate');
    const errors = [];

    const convSelect = document.getElementById('req-convenio');
    const doctorInput = document.getElementById('req-doctorName');
    const patientCard = document.getElementById('patientCardDisplay');

    if (convSelect) {
      convSelect.classList.remove('ring-2', 'ring-rose-500', 'border-rose-500', 'bg-rose-50');
    }
    if (doctorInput) {
      doctorInput.classList.remove('ring-2', 'ring-rose-500', 'border-rose-500', 'bg-rose-50');
    }
    if (patientCard) {
      patientCard.classList.remove('ring-2', 'ring-rose-500', 'border-rose-500');
    }

    let firstMissing = null;

    if (!patientName) {
      errors.push({ field: 'Paciente', msg: 'Nenhum paciente selecionado. É necessário selecionar um paciente cadastrado.' });
      if (patientCard) {
        patientCard.classList.add('ring-2', 'ring-rose-500', 'border-rose-500');
      }
      if (!firstMissing) firstMissing = 'patient';
    }

    if (!convenio) {
      errors.push({ field: 'Convênio', msg: 'O campo Convênio é obrigatório. Por favor, selecione um convênio cadastrado.' });
      if (convSelect) {
        convSelect.classList.add('ring-2', 'ring-rose-500', 'border-rose-500');
      }
      if (!firstMissing) firstMissing = 'convenio';
    }

    if (!doctorName) {
      errors.push({ field: 'Médico Solicitante', msg: 'O preenchimento do Médico Solicitante é obrigatório.' });
      if (doctorInput) {
        doctorInput.classList.add('ring-2', 'ring-rose-500', 'border-rose-500');
      }
      if (!firstMissing) firstMissing = 'doctor';
    }

    return { isValid: errors.length === 0, errors, firstMissing };
  }

  // Validar requisição completa (Etapa 1 + Exames + Data Prevista)
  function validateFullRequisition() {
    const step1Result = validateStep1();
    const errors = [...step1Result.errors];
    let firstMissing = step1Result.firstMissing;

    const validExams = (currentRequisitionExams || []).filter(ex => ex && (ex.code || ex.examCode || ex.name || ex.examName));
    if (!validExams || validExams.length === 0) {
      errors.push({ field: 'Exames da Requisição', msg: 'A requisição não pode ser salva sem exames. Por favor, adicione ao menos 1 (um) exame.' });
      if (!firstMissing) firstMissing = 'exam';
    }

    const dateInput = document.getElementById('req-deliveryDate');
    if (dateInput) {
      if (!dateInput.value) {
        errors.push({ field: 'Data Prevista de Entrega', msg: 'A data prevista de entrega é obrigatória.' });
        if (!firstMissing) firstMissing = 'deliveryDate';
      } else if (checkDeliveryDateWeekend()) {
        errors.push({ field: 'Data Prevista de Entrega', msg: 'A data prevista precisa ser um dia útil (sábado e domingo não são permitidos).' });
        if (!firstMissing) firstMissing = 'deliveryDate';
      }
    }

    return { isValid: errors.length === 0, errors, firstMissing };
  }

  function showStep1ValidationError(errors, firstMissing) {
    pendingValidationFocusAction = firstMissing;
    const modal = document.getElementById('validationErrorModal');
    const alertList = document.getElementById('validationErrorModalList');

    if (!modal || !alertList) return;

    alertList.innerHTML = '';
    errors.forEach(item => {
      const li = document.createElement('li');
      li.className = 'flex items-start gap-2.5 p-3 bg-slate-50 border border-slate-200/90 text-slate-700 rounded-xl text-xs font-medium';
      li.innerHTML = `<span class="text-amber-600 font-bold text-sm shrink-0">⚠️</span> <div><strong class="font-extrabold text-slate-800 uppercase text-[10px] block tracking-wider mb-0.5">${item.field}</strong><span class="text-slate-600">${item.msg}</span></div>`;
      alertList.appendChild(li);
    });

    modal.classList.remove('hidden');
  }

  function closeValidationErrorModal() {
    const modal = document.getElementById('validationErrorModal');
    if (modal) modal.classList.add('hidden');

    const action = pendingValidationFocusAction;
    pendingValidationFocusAction = null;

    if (action === 'patient') {
      switchRequisitionStep(1, true);
      openPatientSearchModal();
    } else if (action === 'convenio') {
      switchRequisitionStep(1, true);
      const convSelect = document.getElementById('req-convenio');
      if (convSelect) convSelect.focus();
    } else if (action === 'doctor') {
      switchRequisitionStep(1, true);
      const doctorInput = document.getElementById('req-doctorName');
      if (doctorInput) doctorInput.focus();
    } else if (action === 'exam') {
      switchRequisitionStep(2, true);
      const quickInput = document.getElementById('req-quickCodeInput');
      if (quickInput) quickInput.focus();
    } else if (action === 'deliveryDate') {
      switchRequisitionStep(1, true);
      const dateInput = document.getElementById('req-deliveryDate');
      if (dateInput) dateInput.focus();
    }
  }

  function clearStep1ValidationError() {
    const modal = document.getElementById('validationErrorModal');
    if (modal) modal.classList.add('hidden');

    const convSelect = document.getElementById('req-convenio');
    const doctorInput = document.getElementById('req-doctorName');
    const patientCard = document.getElementById('patientCardDisplay');
    if (convSelect) {
      convSelect.classList.remove('ring-2', 'ring-rose-500', 'border-rose-500', 'bg-rose-50');
    }
    if (doctorInput) {
      doctorInput.classList.remove('ring-2', 'ring-rose-500', 'border-rose-500', 'bg-rose-50');
    }
    if (patientCard) {
      patientCard.classList.remove('ring-2', 'ring-rose-500', 'border-rose-500');
    }
  }

  function isConvenioFaturamento(convenioNameOrCode) {
    const currentConvName = (convenioNameOrCode || document.getElementById('req-convenio')?.value || 'Particular').trim();
    const currentConvCode = document.getElementById('req-convenioCode')?.value?.trim();
    const currentConvId = document.getElementById('req-convenioId')?.value?.trim();

    if (!currentConvName || currentConvName.toLowerCase() === 'particular') {
      return false; // Particular is always paid at counter
    }

    if (typeof conveniosListFromDb !== 'undefined' && Array.isArray(conveniosListFromDb)) {
      let conv = conveniosListFromDb.find(c => 
        (currentConvId && String(c.id) === String(currentConvId)) ||
        (currentConvCode && String(c.codigo) === String(currentConvCode)) ||
        (c.fantasia && c.fantasia.toLowerCase() === currentConvName.toLowerCase()) ||
        (c.razaoSocial && c.razaoSocial.toLowerCase() === currentConvName.toLowerCase())
      );

      if (conv) {
        if (conv.tipoCobranca === 'balcao') return false;
        if (conv.tipoCobranca === 'faturamento') return true;
      }
    }

    return true; // Default for non-Particular convenios
  }

  function updateConvenioUI() {
    const isFat = isConvenioFaturamento();

    // 1. Tab de Pagamento (Step 3) - SEMPRE VISÍVEL para permitir Multiguias / Cobrança Mista
    const step3Tab = document.getElementById('stepTabBtn3');
    if (step3Tab) {
      step3Tab.style.display = '';
    }

    // 2. Campo de Valor R$ na inserção rápida do exame - SEMPRE VISÍVEL
    const priceContainer = document.getElementById('req-examPriceContainer');
    if (priceContainer) {
      priceContainer.classList.remove('hidden');
    }

    // 3. Coluna de Valor na Tabela de Exames - SEMPRE VISÍVEL
    document.querySelectorAll('.exam-table-price-col').forEach(el => {
      el.classList.remove('hidden');
    });
    const tfoot = document.getElementById('addedExamsTfoot');
    if (tfoot) {
      tfoot.classList.remove('hidden');
    }

    // 4. Resumo Financeiro em Step 2 - SEMPRE VISÍVEL
    const finSummary = document.getElementById('req-step2FinancialSummary');
    if (finSummary) {
      finSummary.classList.remove('hidden');
    }

    // 5. Botões de ação no footer do Step 2
