    document.getElementById('req-isPregnant').checked = !!req.isPregnant;
    document.getElementById('req-gestationalPeriod').value = req.gestationalPeriod || '';
    document.getElementById('req-isNeonate').checked = !!req.isNeonate;
    document.getElementById('req-isIncapacitated').checked = !!req.isIncapacitated;
    document.getElementById('req-isPsr').checked = !!req.isPsr;

    document.getElementById('req-dum').value = req.dum || '';
    document.getElementById('req-weight').value = req.weight || '';
    document.getElementById('req-height').value = req.height || '';
    document.getElementById('req-address').value = req.address || '';
    document.getElementById('req-complement').value = req.complement || '';
    document.getElementById('req-city').value = req.city || 'Cambará';
    document.getElementById('req-cep').value = req.cep || '';
    document.getElementById('req-patientPhone').value = req.patientPhone || '';
    document.getElementById('req-responsibleName').value = req.responsibleName || '';
    document.getElementById('req-clinicalNotes').value = req.clinicalNotes || '';
    
    const convSelect = document.getElementById('req-convenio');
    const rConv = req.convenio || '';
    const rCode = req.convenioCode || '';
    const rId = req.convenioId || '';

    document.getElementById('req-convenioCode').value = rCode;
    if (document.getElementById('req-convenioId')) document.getElementById('req-convenioId').value = rId;

    if (convSelect) {
      if (rConv) {
        let optionExists = Array.from(convSelect.options).some(opt => opt.value === rConv);
        if (!optionExists) {
          const newOpt = document.createElement('option');
          newOpt.value = rConv;
          newOpt.setAttribute('data-code', rCode);
          newOpt.setAttribute('data-id', rId);
          newOpt.textContent = rConv;
          convSelect.appendChild(newOpt);
        }
        convSelect.value = rConv;
      } else {
        convSelect.value = '';
      }
    }

    document.getElementById('req-situacaoCode').value = req.situacaoCode || '';
    if (req.situacao) document.getElementById('req-situacao').value = req.situacao;

    document.getElementById('req-matricula').value = req.matricula || '';
    document.getElementById('req-guia').value = req.guia || '';
    document.getElementById('req-coleta').value = req.coleta || 'Sede / Central';
    document.getElementById('req-susCard').value = req.susCard || '';
    document.getElementById('req-destino').value = req.destino || 'Laboratório Principal';

    if (req.doctorCrmType) document.getElementById('req-doctorCrmType').value = req.doctorCrmType;
    document.getElementById('req-doctorCrm').value = req.doctorCrm || '';
    if (req.doctorUf) document.getElementById('req-doctorUf').value = req.doctorUf;
    document.getElementById('req-doctorName').value = req.doctorName || '';

    document.getElementById('req-fatura').value = req.fatura || new Date().toLocaleDateString('pt-BR');
    document.getElementById('req-hora').value = req.hora || '';
    document.getElementById('req-isUrgent').checked = !!req.isUrgent;
    document.getElementById('req-obs').value = req.obs || '';
    document.getElementById('req-empresa').value = req.empresa || '';

    // Carregar dados de Exames e Financeiro
    if (Array.isArray(req.exams)) {
      currentRequisitionExams = [...req.exams];
    } else if (req.examsJson) {
      try {
        currentRequisitionExams = JSON.parse(req.examsJson);
      } catch(e) {
        currentRequisitionExams = [];
      }
    } else {
      currentRequisitionExams = [];
    }

    const fatInput = document.getElementById('req-faturadoValInput');
    if (fatInput) {
      if (req.faturadoAmount !== undefined && req.faturadoAmount !== null && req.faturadoAmount !== '') {
        fatInput.value = parseFloat(req.faturadoAmount).toFixed(2);
        fatInput.dataset.userTouched = 'true';
      } else {
        delete fatInput.dataset.userTouched;
      }
    }

    if (document.getElementById('req-discount')) document.getElementById('req-discount').value = req.discount || '0.00';
    if (document.getElementById('req-discountPercent')) document.getElementById('req-discountPercent').value = req.discountPercent || '0';
    if (document.getElementById('req-discountValInput')) document.getElementById('req-discountValInput').value = req.discount || '0.00';
    setDiscountMode('currency');
    if (document.getElementById('req-paymentMethod') && req.paymentMethod) document.getElementById('req-paymentMethod').value = req.paymentMethod;
    if (document.getElementById('req-paymentCondition') && req.paymentCondition) document.getElementById('req-paymentCondition').value = req.paymentCondition;
    if (document.getElementById('req-paidAmount')) document.getElementById('req-paidAmount').value = req.paidAmount || '0.00';
    if (document.getElementById('req-financialStatus') && req.financialStatus) document.getElementById('req-financialStatus').value = req.financialStatus;
    if (document.getElementById('req-status')) document.getElementById('req-status').value = req.status || 'Em Andamento';

    if (document.getElementById('req-deliveryDays')) {
      if (req.deliveryDays !== undefined && req.deliveryDays !== null && req.deliveryDays !== '') {
        document.getElementById('req-deliveryDays').value = req.deliveryDays;
      }
    }
    if (document.getElementById('req-deliveryDate')) {
      document.getElementById('req-deliveryDate').value = req.deliveryDate || '';
      if (req.deliveryDate) {
        onDeliveryDateChange();
      } else if (req.deliveryDays) {
        onDeliveryDaysInput();
      }
    }
    if (document.getElementById('req-deliveryTime')) document.getElementById('req-deliveryTime').value = req.deliveryTime || '17:00';
    if (document.getElementById('req-cid10')) document.getElementById('req-cid10').value = req.cid10 || '';
    if (document.getElementById('req-fastingHours')) document.getElementById('req-fastingHours').value = req.fastingHours || '';
    if (document.getElementById('req-notifyWhatsapp')) document.getElementById('req-notifyWhatsapp').checked = req.notifyWhatsapp !== false;
    if (document.getElementById('req-separateLabel')) document.getElementById('req-separateLabel').checked = !!req.separateLabel;

    // Carregar dados de Pagamentos
    if (Array.isArray(req.payments) && req.payments.length > 0) {
      currentRequisitionPayments = [...req.payments];
    } else if (typeof req.payments === 'string' && req.payments.trim().startsWith('[')) {
      try {
        currentRequisitionPayments = JSON.parse(req.payments);
      } catch(e) {
        currentRequisitionPayments = [];
      }
    } else if (parseFloat(req.paidAmount) > 0) {
      currentRequisitionPayments = [{
        id: 'pay_legacy_1',
        methodName: req.paymentMethod || 'Dinheiro',
        conditionName: req.paymentCondition || 'À Vista',
        amount: parseFloat(req.paidAmount),
        date: req.fatura ? (req.fatura + 'T12:00') : new Date().toISOString().slice(0, 16),
        obs: 'Lançamento do cadastro'
      }];
    } else {
      currentRequisitionPayments = [];
    }

    // Atualizar estado da flag Multiguias
    const chkMG = document.getElementById('req-isMultiguia');
    if (chkMG) {
      const hasFatVal = req.faturadoAmount !== undefined && req.faturadoAmount !== null && parseFloat(req.faturadoAmount) > 0;
      const hasMixedExams = currentRequisitionExams.some(e => e.billingCategory === 'particular') && currentRequisitionExams.some(e => e.billingCategory === 'convenio');
      chkMG.checked = !!(req.isMultiguia || hasFatVal || hasMixedExams);
    }
    toggleMultiguiaMode();

    switchRequisitionStep(targetStep, true);
    renderExamsTable();
    renderRequisitionPaymentsTable();
    calcFinancials();

    // Atualizar o card visual de dados do paciente
    updatePatientCardDisplay();

    // Exibir ou ocultar o botão de Visualizar Laudo no modal se a requisição estiver Pronta
    const reqStatusLower = String(req.status || '').toLowerCase();
    const isPronto = reqStatusLower.includes('pronto') || reqStatusLower.includes('liberado') || reqStatusLower.includes('conferido');
    const pdfBtn = document.getElementById('req-modal-view-pdf-btn');
    if (pdfBtn) {
      if (isPronto) {
        pdfBtn.href = `/api/laudo/pdf?requisicao=${encodeURIComponent(req.requisitionCode || req.id)}`;
        pdfBtn.classList.remove('hidden');
      } else {
        pdfBtn.classList.add('hidden');
      }
    }

    // Abrir o modal com os dados carregados!
    openRequisitionFormModal();
  }

