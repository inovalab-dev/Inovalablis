  function filterGenericList() {
    const searchVal = (document.getElementById('genericSearchInput')?.value || '').toLowerCase().trim();
    const fieldVal = document.getElementById('genericSearchFieldSelect')?.value || 'all';
    const clearBtn = document.getElementById('genericSearchClearBtn');

    if (clearBtn) {
      if (searchVal) clearBtn.classList.remove('hidden');
      else clearBtn.classList.add('hidden');
    }

    let filtered = currentGenericItemsList;

    if (searchVal) {
      filtered = currentGenericItemsList.filter(item => {
        const codeStr = (item.code || '').toLowerCase();
        const nameStr = (item.name || '').toLowerCase();
        const detailsStr = (item.details || '').toLowerCase();

        if (fieldVal === 'code') {
          return codeStr.includes(searchVal);
        } else if (fieldVal === 'name') {
          return nameStr.includes(searchVal);
        } else if (fieldVal === 'details') {
          return detailsStr.includes(searchVal);
        } else {
          return codeStr.includes(searchVal) || nameStr.includes(searchVal) || detailsStr.includes(searchVal);
        }
      });
    }

    renderGenericList(filtered);
  }

