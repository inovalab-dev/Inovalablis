  function onReqPayMethodChange() {
    const methodSelect = document.getElementById('reqPayMethodSelect');
    const condSelect = document.getElementById('reqPayConditionSelect');
    if (!methodSelect || !condSelect) return;

    const selectedMethodId = methodSelect.value;
    const methodObj = allPaymentMethodsData.find(m => String(m.id) === String(selectedMethodId));

    condSelect.innerHTML = '';
    if (methodObj && Array.isArray(methodObj.conditions) && methodObj.conditions.length > 0) {
      methodObj.conditions.forEach(c => {
        if (c.active !== false) {
          const opt = document.createElement('option');
          opt.value = c.id;
          opt.textContent = c.description + (c.installments > 1 ? ` (${c.installments}x)` : '');
          condSelect.appendChild(opt);
        }
      });
    } else {
      const opt = document.createElement('option');
      opt.value = 'a_vista';
      opt.textContent = 'À Vista';
      condSelect.appendChild(opt);
    }
