<%- include('../partials/header') %>

<div class="p-4 sm:p-6 lg:p-8 max-w-[98vw] xl:max-w-[96vw] mx-auto w-full flex-1">

  <!-- Cabeçalho Principal da Tela (Estilo LIS PEP/Recepção) -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
    <div>
      <div class="flex items-center gap-2 text-xs text-brand-neutral/60 font-mono uppercase tracking-wider mb-1">
        <span>Recepção LIS</span>
        <span>•</span>
        <span class="text-brand-gold font-bold">Solicitações & Protocolos de Exames</span>
      </div>
      <h1 class="text-2xl font-black text-brand-neutralDark flex items-center gap-2">
        <svg class="w-7 h-7 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        Cadastro de Requisições
      </h1>
      <p class="text-xs text-brand-neutral/70 mt-1">
        Histórico e montagem de solicitações de exames. Clique em "Nova Requisição" ou pressione CTRL + N para iniciar a ficha.
      </p>
    </div>

    <div class="flex items-center gap-3">
      <button onclick="startNewRequisition()" class="inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs uppercase tracking-wider rounded-xl shadow-lg shadow-emerald-600/20 transition-all active:scale-95 cursor-pointer" title="Nova Requisição (CTRL + N)">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
        <span>Nova Requisição <span class="font-mono text-[10px] opacity-80">(Ctrl+N)</span></span>
      </button>
    </div>
  </div>

  <!-- Barra de Busca, Filtros e Itens por Página -->
  <div class="bg-white rounded-xl border border-gray-100 shadow-xs p-2 mb-3">
    <div class="flex flex-col sm:flex-row items-center gap-2">
      <div class="relative flex-1 w-full">
        <svg class="w-3.5 h-3.5 absolute left-3 top-2.5 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        <input type="text" id="req-search-input" onkeyup="filterRequisitionsTable()" placeholder="Buscar paciente por nome, código de requisição, CPF, telefone ou convênio..." class="w-full pl-8 pr-3 py-1.5 bg-gray-50 border border-gray-200 rounded-lg text-xs font-medium focus:ring-2 focus:ring-emerald-500 focus:bg-white outline-none transition-all">
      </div>
      <select id="itemsPerPageSelect" class="w-full sm:w-32 py-1.5 px-2.5 bg-gray-50 border border-gray-200 rounded-lg text-xs font-medium text-gray-700 focus:ring-2 focus:ring-emerald-500 outline-none font-mono">
        <option value="20">20 por pág.</option>
        <option value="50" selected>50 por pág.</option>
        <option value="100">100 por pág.</option>
      </select>
    </div>
  </div>

  <!-- Tabela Histórica de Requisições Cadastradas -->
  <div class="bg-white rounded-xl border border-gray-100 shadow-xs overflow-hidden mb-4">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs" id="requisitions-table">
        <thead>
          <tr class="bg-gray-50/80 border-b border-gray-100 text-[10px] font-bold text-gray-500 uppercase tracking-wider font-mono">
            <th class="py-2 px-2.5 whitespace-nowrap">Cód. Req.</th>
            <th class="py-2 px-2.5 whitespace-nowrap">Data Req.</th>
            <th class="py-2 px-3">Paciente</th>
            <th class="py-2 px-2.5 whitespace-nowrap">Médico</th>
            <th class="py-2 px-2.5 whitespace-nowrap">Convênio</th>
            <th class="py-2 px-2.5 text-right whitespace-nowrap">Valor Total</th>
            <th class="py-2 px-2.5 text-right whitespace-nowrap">Saldo Pendente</th>
            <th class="py-2 px-2.5 whitespace-nowrap">Previsão Entrega</th>
            <th class="py-2 px-2.5 text-center whitespace-nowrap">Status</th>
            <th class="py-2 px-3 text-center whitespace-nowrap">Ações</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 text-xs text-gray-700 font-medium">
          <% requisitions.forEach(req => { %>
            <%
              let formattedBirth = req.patientBirthDate || '-';
              if (req.patientBirthDate && req.patientBirthDate.includes('-') && req.patientBirthDate.split('-').length === 3) {
                const [y, m, d] = req.patientBirthDate.split('-');
                if (y.length === 4) {
                  formattedBirth = `${d}/${m}/${y}`;
                }
              }
              let displayCpf = req.patientCpf || '-';
              if (displayCpf === '-' && req.patientCode && typeof patients !== 'undefined') {
                let pFound = patients.find(p => (p.code || p.id) === req.patientCode || p.name === req.patientName);
                if (pFound && pFound.cpf) displayCpf = pFound.cpf;
              }
              let displayPhone = req.patientPhone || req.patientWhatsapp || '-';
              if (displayPhone === '-' && req.patientCode && typeof patients !== 'undefined') {
                let pFound = patients.find(p => (p.code || p.id) === req.patientCode || p.name === req.patientName);
                if (pFound && (pFound.whatsapp || pFound.phone)) displayPhone = pFound.whatsapp || pFound.phone;
              }
              let displayBirth = formattedBirth;
              let rawBirthStr = req.patientBirthDate;
              if (displayBirth === '-' && req.patientCode && typeof patients !== 'undefined') {
                let pFound = patients.find(p => (p.code || p.id) === req.patientCode || p.name === req.patientName);
                if (pFound && pFound.birthDate) {
                  rawBirthStr = pFound.birthDate;
                  const [y, m, d] = pFound.birthDate.split('-');
                  if (y && m && d) displayBirth = `${d}/${m}/${y}`;
                }
              }

              let displayAge = '';
              if (rawBirthStr && rawBirthStr !== '-') {
                let dt;
                if (rawBirthStr.includes('-')) {
                  const parts = rawBirthStr.split('-');
                  if (parts[0].length === 4) {
                    dt = new Date(rawBirthStr + 'T00:00:00');
                  } else if (parts[2].length === 4) {
                    dt = new Date(`${parts[2]}-${parts[1]}-${parts[0]}T00:00:00`);
                  }
                } else if (rawBirthStr.includes('/')) {
                  const parts = rawBirthStr.split('/');
                  if (parts[2] && parts[2].length === 4) {
                    dt = new Date(`${parts[2]}-${parts[1]}-${parts[0]}T00:00:00`);
                  }
                }

                if (dt && !isNaN(dt.getTime())) {
                  const now = new Date();
                  let years = now.getFullYear() - dt.getFullYear();
                  let months = now.getMonth() - dt.getMonth();
                  let days = now.getDate() - dt.getDate();

                  if (days < 0) {
                    months--;
                    const prevMonth = new Date(now.getFullYear(), now.getMonth(), 0);
                    days += prevMonth.getDate();
                  }
                  if (months < 0) {
                    years--;
                    months += 12;
                  }

                  if (years >= 1) {
                    displayAge = `(${years}anos)`;
                  } else if (months >= 1) {
                    displayAge = `(${months}meses)`;
                  } else {
                    displayAge = `(${Math.max(0, days)}dias)`;
                  }
                }
              }

              if (!displayAge && req.patientAge) {
                let ageVal = parseInt(req.patientAge, 10);
                if (!isNaN(ageVal)) {
                  let u = (req.patientAgeUnit || 'anos').toLowerCase();
                  if (u.includes('mes')) displayAge = `(${ageVal}meses)`;
                  else if (u.includes('dia')) displayAge = `(${ageVal}dias)`;
                  else displayAge = `(${ageVal}anos)`;
                }
              }

              // Extração de Data e Hora
              let datePart = req.createdAt || '-';
              let timePart = req.hora || '';
              if (req.createdAt) {
                let raw = req.createdAt;
                if (raw.includes(',')) {
                  const parts = raw.split(',');
                  datePart = parts[0].trim();
                  timePart = parts[1].trim();
                } else if (raw.includes(' ')) {
                  const parts = raw.split(' ');
                  datePart = parts[0].trim();
                  timePart = parts[1].trim();
                }
              }
              if (timePart && timePart.split(':').length === 3) {
                const tParts = timePart.split(':');
                timePart = `${tParts[0]}:${tParts[1]}`;
              }

              const reqConvName = (req.convenio || 'Particular').trim();
              const reqConvCode = (req.convenioCode || '').trim();
              const reqConvId = (req.convenioId || '').trim();

              let isFat = false;
              if (reqConvName.toLowerCase() !== 'particular' && reqConvName !== '') {
                isFat = true;
                if (locals.convenios && Array.isArray(locals.convenios)) {
                  const convObj = locals.convenios.find(c =>
                    (reqConvId && String(c.id) === String(reqConvId)) ||
                    (reqConvCode && String(c.codigo) === String(reqConvCode)) ||
                    (c.fantasia && c.fantasia.toLowerCase() === reqConvName.toLowerCase()) ||
                    (c.razaoSocial && c.razaoSocial.toLowerCase() === reqConvName.toLowerCase())
                  );
                  if (convObj) {
                    if (convObj.tipoCobranca === 'balcao') isFat = false;
                    else if (convObj.tipoCobranca === 'faturamento') isFat = true;
                  }
                }
              }

              const finSt = String(req.financialStatus || '').toLowerCase();
              const pm = String(req.paymentMethod || '').toLowerCase();
              const paidVal = parseFloat(req.paidAmount || 0);
              const subVal = parseFloat(req.subtotal || 0);
              const discVal = parseFloat(req.discount || 0);
              const totVal = parseFloat(req.totalAmount || (subVal - discVal));

              let isRowPago = false;
              if (finSt.includes('pago') || finSt.includes('faturado') || finSt.includes('cortesia') || pm.includes('convênio') || pm.includes('cortesia')) {
                isRowPago = true;
              } else if (totVal > 0 && paidVal >= totVal) {
                isRowPago = true;
              } else if (totVal === 0 && (finSt.includes('pago') || finSt.includes('cortesia'))) {
                isRowPago = true;
              }

              let fatAmtVal = req.faturadoAmount !== undefined && req.faturadoAmount !== null && req.faturadoAmount !== ''
                ? parseFloat(req.faturadoAmount)
                : (isFat ? totVal : 0);
              let balcaoDevidoVal = Math.max(0, totVal - fatAmtVal);
              let balcaoPendingVal = Math.max(0, balcaoDevidoVal - paidVal);
              let isBalcaoQuitado = balcaoDevidoVal > 0 ? (paidVal >= balcaoDevidoVal) : (fatAmtVal > 0 || isRowPago);

              let pendingVal = isRowPago ? 0 : Math.max(0, totVal - paidVal);

              let formattedDelivery = req.deliveryDate || '-';
              if (formattedDelivery && formattedDelivery.includes('-') && formattedDelivery.split('-').length === 3) {
                const [dy, dm, dd] = formattedDelivery.split('-');
                if (dy.length === 4) formattedDelivery = `${dd}/${dm}/${dy}`;
              }
            %>
            <tr class="hover:bg-emerald-50/40 transition-colors req-row cursor-pointer" onclick="openRequisitionQuickViewModal('<%= req.id %>')" data-name="<%= (req.patientName || '').toLowerCase() %>" data-code="<%= (req.requisitionCode || '').toLowerCase() %>" data-cpf="<%= (displayCpf || '').toLowerCase() %>" data-phone="<%= (displayPhone || '').toLowerCase() %>" data-convenio="<%= (req.convenio || '').toLowerCase() %>" data-doctor="<%= (req.doctorName || '').toLowerCase() %>" data-status="<%= (req.status || 'A Coletar').toLowerCase() %>">
              
              <!-- 1. Cód. Req. -->
              <td class="py-1.5 px-2.5 font-mono font-extrabold text-emerald-800 text-xs whitespace-nowrap">
                <span class="bg-emerald-50 text-emerald-900 border border-emerald-200/80 px-1.5 py-0.5 rounded text-[10px]">
                  #<%= req.requisitionCode || req.id %>
                </span>
              </td>

              <!-- 2. Data Req. (Data e Hora compactas) -->
              <td class="py-1.5 px-2.5 text-gray-700 font-mono text-[11px] whitespace-nowrap">
                <div class="flex items-center gap-1.5">
                  <span class="font-bold text-gray-900"><%= datePart %></span>
                  <span class="text-[10px] text-gray-400 font-medium"><%= timePart || '12:00' %></span>
                </div>
              </td>

              <!-- 3. Paciente (sem CPF na listagem, com idade em parênteses) -->
              <td class="py-1.5 px-3">
                <div class="flex items-center gap-1.5">
                  <span class="font-bold text-gray-900 text-xs leading-snug"><%= req.patientName %></span>
                  <% if (displayAge) { %>
                    <span class="font-mono text-[11px] text-slate-500 font-medium"><%= displayAge %></span>
                  <% } %>
                </div>
              </td>

              <!-- 5. Médico Solicitante -->
              <td class="py-1.5 px-2.5 text-gray-800 text-xs truncate max-w-[140px]" title="<%= req.doctorName || '-' %>">
                <span class="font-bold text-slate-800"><%= req.doctorName || '-' %></span>
              </td>

              <!-- 6. Convênio -->
              <td class="py-1.5 px-2.5 whitespace-nowrap">
                <div class="flex items-center gap-1">
                  <span class="font-bold text-gray-800 text-xs"><%= req.convenio || 'Particular' %></span>
                  <span class="font-mono text-[9px] text-gray-400">(<%= req.convenioCode || '1' %>)</span>
                </div>
              </td>

              <!-- 7. Valor Total -->
              <td class="py-1.5 px-2.5 font-mono text-xs font-bold text-slate-800 text-right whitespace-nowrap">
                R$ <%= totVal.toFixed(2).replace('.', ',') %>
              </td>

              <!-- 8. Valor Pendente (Suporte a Multiguias) -->
              <td class="py-1.5 px-2.5 font-mono text-xs font-bold text-right whitespace-nowrap">
                <% if (fatAmtVal >= totVal && totVal > 0) { %>
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-black font-mono bg-blue-100 text-blue-900 border border-blue-300/80 shadow-2xs">
                    Faturamento
                  </span>
                <% } else if (fatAmtVal > 0 && balcaoDevidoVal > 0) { %>
                  <% if (balcaoPendingVal > 0) { %>
                    <div class="flex flex-col items-end leading-tight">
                      <span class="text-rose-600 font-bold">R$ <%= balcaoPendingVal.toFixed(2).replace('.', ',') %></span>
                      <span class="text-[9px] text-blue-800 bg-blue-50 border border-blue-200 px-1 rounded">Fat R$ <%= fatAmtVal.toFixed(2).replace('.', ',') %></span>
                    </div>
                  <% } else { %>
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-extrabold font-mono bg-emerald-100 text-emerald-800 border border-emerald-300 shadow-2xs">
                      Fat + Quitado
                    </span>
                  <% } %>
                <% } else if (pendingVal > 0 && !isRowPago) { %>
                  <span class="text-rose-600">R$ <%= pendingVal.toFixed(2).replace('.', ',') %></span>
                <% } else { %>
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-extrabold font-mono bg-emerald-100 text-emerald-800 border border-emerald-300 shadow-2xs">
                    <svg class="w-3 h-3 text-emerald-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
                    </svg>
                    Pago
                  </span>
                <% } %>
              </td>

              <!-- 9. Previsão Entrega -->
              <td class="py-1.5 px-2.5 font-mono text-[11px] text-gray-700 whitespace-nowrap">
                <%= formattedDelivery %>
              </td>

              <!-- 10. Status da Requisição -->
              <td class="py-1.5 px-2.5 text-center whitespace-nowrap" onclick="event.stopPropagation()">
                <%
                  let st = req.status || 'Em Andamento';
                  if (st.toLowerCase().includes('cancel')) st = 'Cancelado';
                  else if (st === 'Conferido' || st === 'Liberado' || st === 'Concluído') st = 'Pronto';
                  
                  let bgClass = 'bg-amber-100 text-amber-900 border-amber-300';
                  let icon = '⏳';
                  if (st === 'Pronto') {
                    bgClass = 'bg-emerald-100 text-emerald-900 border-emerald-300';
                    icon = '✅';
                  } else if (st === 'Cancelado') {
                    bgClass = 'bg-rose-100 text-rose-900 border-rose-300';
                    icon = '❌';
                  }
                %>
                <span class="inline-flex items-center gap-0.5 px-2 py-0.2 rounded-full text-[10px] font-extrabold font-mono border <%= bgClass %>">
                  <span><%= icon %></span>
                  <span><%= st %></span>
                </span>
              </td>

              <!-- 9. Ações (Resumo [Olho] / Caixa [$] / Visualizar Laudo [se Pronto & (Pago ou Faturamento)] / Editar [Lápis] / Cancelar [Ícone]) -->
              <td class="py-1.5 px-3 text-center whitespace-nowrap" onclick="event.stopPropagation()">
                <% 
                  const reqStatusLower = String(req.status || '').toLowerCase();
                  const isCancelado = reqStatusLower.includes('cancel');
                  const isPronto = reqStatusLower.includes('pronto') || reqStatusLower.includes('liberado') || reqStatusLower.includes('conferido');
                  const canPrintPdf = isPronto && (isRowPago || isFat || fatAmtVal > 0 || isBalcaoQuitado);
                  const showCashierBtn = balcaoDevidoVal > 0 || (!isFat && fatAmtVal < totVal);
                %>
                <div class="flex items-center justify-center gap-1">
                  <!-- Botão de Olho: Visualização Rápida de Detalhes -->
                  <button type="button" onclick="openRequisitionQuickViewModal('<%= req.id %>')" class="p-1.5 bg-blue-50 hover:bg-blue-600 text-blue-700 hover:text-white border border-blue-200/80 rounded-lg transition-all cursor-pointer active:scale-95 flex items-center justify-center shrink-0" title="Visualizar Detalhes & Pagamento da Requisição">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.573 16.49 16.638 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                  </button>

                  <!-- Botão $ (Cifrão / Caixa) - Exibido quando houver saldo/copagamento balcão -->
                  <% if (showCashierBtn) { %>
                    <% if (balcaoPendingVal <= 0 && (paidVal > 0 || balcaoDevidoVal === 0)) { %>
                      <button type="button" onclick="openPaymentCashierModal('<%= req.id %>')" class="p-1.5 bg-emerald-50 hover:bg-emerald-600 text-emerald-700 hover:text-white border border-emerald-200/80 rounded-lg transition-all cursor-pointer active:scale-95 flex items-center justify-center shrink-0 font-black font-mono leading-none text-xs" title="Pagamento Balcão Confirmado - Clique para abrir o Caixa">
                        $
                      </button>
                    <% } else { %>
                      <button type="button" onclick="openPaymentCashierModal('<%= req.id %>')" class="p-1.5 bg-rose-50 hover:bg-rose-600 text-rose-700 hover:text-white border border-rose-200/80 rounded-lg transition-all cursor-pointer active:scale-95 flex items-center justify-center shrink-0 font-black font-mono leading-none text-xs animate-pulse hover:animate-none" title="Pagamento Balcão Pendente - Clique para dar baixa no Caixa">
                        $
                      </button>
                    <% } %>
                  <% } %>

                  <% if (canPrintPdf) { %>
                    <a href="/api/laudo/pdf?requisicao=<%= req.requisitionCode || req.id %>" target="_blank" class="p-1.5 bg-emerald-50 hover:bg-emerald-600 text-emerald-700 hover:text-white border border-emerald-200/80 rounded-lg transition-all cursor-pointer active:scale-95 flex items-center justify-center shrink-0" title="Visualizar / Imprimir Laudo (Pronto)">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0110.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0l.229 2.523a1.125 1.125 0 01-1.12 1.227H7.231a1.125 1.125 0 01-1.12-1.227L6.34 18m11.318 0h1.091A2.25 2.25 0 0021 15.75V9.456c0-1.081-.768-2.015-1.837-2.175a48.055 48.055 0 00-19.126 0C1.081 7.441.312 8.375.312 9.456V15.75a2.25 2.25 0 002.25 2.25h1.091M6 9h12V4.5A1.5 1.5 0 0016.5 3h-9A1.5 1.5 0 006 4.5V9z"/>
                      </svg>
                    </a>
                  <% } else { %>
                    <span class="p-1.5 bg-gray-100 text-gray-400 border border-gray-200/80 rounded-lg opacity-60 cursor-not-allowed flex items-center justify-center shrink-0" title="<%= !isRowPago && !isFat ? 'Laudo bloqueado - Aguardando Pagamento' : 'Laudo Indisponível (Exame não concluído)' %>">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0110.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0l.229 2.523a1.125 1.125 0 01-1.12 1.227H7.231a1.125 1.125 0 01-1.12-1.227L6.34 18m11.318 0h1.091A2.25 2.25 0 0021 15.75V9.456c0-1.081-.768-2.015-1.837-2.175a48.055 48.055 0 00-19.126 0C1.081 7.441.312 8.375.312 9.456V15.75a2.25 2.25 0 002.25 2.25h1.091M6 9h12V4.5A1.5 1.5 0 0016.5 3h-9A1.5 1.5 0 006 4.5V9z"/>
                      </svg>
                    </span>
                  <% } %>

                  <% if (isCancelado) { %>
                    <button type="button" onclick="selectRequisitionToForm('<%= req.id %>')" class="p-1.5 bg-slate-100 hover:bg-slate-700 text-slate-700 hover:text-white border border-slate-300/80 rounded-lg transition-all cursor-pointer active:scale-95 flex items-center justify-center shrink-0" title="Visualizar Requisição Cancelada">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.573 16.49 16.638 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                      </svg>
                    </button>
                    <span class="p-1.5 bg-rose-100 text-rose-800 border border-rose-200 rounded-lg opacity-70 cursor-not-allowed inline-flex items-center justify-center shrink-0" title="Requisição já cancelada">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>
                      </svg>
                    </span>
                  <% } else { %>
                    <button type="button" onclick="selectRequisitionToForm('<%= req.id %>')" class="p-1.5 bg-amber-50 hover:bg-amber-500 text-amber-700 hover:text-white border border-amber-200/80 rounded-lg transition-all cursor-pointer active:scale-95 flex items-center justify-center shrink-0" title="Editar Requisição">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125"/>
                      </svg>
                    </button>
                    <button type="button" onclick="openCancelModal('<%= req.id %>', '<%= req.requisitionCode || req.id %>')" class="p-1.5 bg-rose-50 hover:bg-rose-600 text-rose-700 hover:text-white border border-rose-200/80 rounded-lg transition-all cursor-pointer active:scale-95 flex items-center justify-center shrink-0" title="Cancelar Requisição">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                      </svg>
                    </button>
                  <% } %>
                </div>
              </td>

            </tr>
          <% }) %>

          <% if (requisitions.length === 0) { %>
            <tr>
              <td colspan="8" class="text-center py-10 text-gray-400 italic">
                Nenhuma requisição cadastrada no sistema.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Controles de Paginação -->
    <div class="p-4 bg-gray-50/50 border-t border-gray-100 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-gray-500 font-mono">
      <div id="paginationInfo">
        Exibindo <%= requisitions.length > 0 ? `1 - ${requisitions.length} de ${requisitions.length}` : '0 - 0 de 0' %> requisições registradas
      </div>
      <div class="flex items-center gap-1.5" id="paginationControls">
        <button class="px-3 py-1.5 rounded-lg border border-gray-200 bg-white text-gray-400 cursor-not-allowed text-xs font-bold" disabled>&lt; Anterior</button>
        <button class="px-3 py-1.5 rounded-lg border border-emerald-500 bg-emerald-600 text-white text-xs font-bold">1</button>
        <button class="px-3 py-1.5 rounded-lg border border-gray-200 bg-white text-gray-400 cursor-not-allowed text-xs font-bold" disabled>Próximo &gt;</button>
      </div>
    </div>
  </div>

</div>

<!-- ========================================================= -->
<!-- MODAL DE POPUP COMPLETO - CADASTRO DE REQUISIÇÃO (LIS)    -->
<!-- ========================================================= -->
<div id="requisitionFormModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-2 sm:p-4 md:p-6 bg-black/75 backdrop-blur-sm overflow-hidden">
  <div class="bg-white rounded-2xl border border-gray-300 w-full max-w-7xl max-h-[94vh] shadow-2xl overflow-hidden flex flex-col my-auto">
    
    <!-- Cabeçalho do Modal LIS com Stepper de Abas -->
    <div class="bg-gradient-to-r from-gray-50 via-gray-100 to-gray-50 px-6 py-3.5 border-b border-gray-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 shrink-0">
      <div class="flex items-center gap-3">
        <div class="p-2 bg-emerald-600 text-white rounded-xl shadow-md">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        </div>
        <div>
          <h2 class="text-lg font-black text-gray-900 tracking-tight" id="requisitionModalTitle">Cadastro e Montagem de Requisição</h2>
          <p class="text-xs text-gray-500 font-mono">Formulário Unificado LIS - InovaLab Prontuário Eletrônico</p>
        </div>
      </div>

      <!-- BOTÕES DE ABAS / STEPPER DO MODAL -->
      <div class="flex items-center gap-1.5 bg-gray-200/80 p-1 rounded-2xl border border-gray-300/60 shadow-inner overflow-x-auto">
        <button type="button" onclick="switchRequisitionStep(1)" id="stepTabBtn1" class="px-3.5 py-1.5 rounded-xl text-xs font-black transition-all flex items-center gap-2 bg-white text-emerald-950 shadow-xs cursor-pointer shrink-0">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>1. Geral</span>
        </button>
        <button type="button" onclick="switchRequisitionStep(2)" id="stepTabBtn2" class="px-3.5 py-1.5 rounded-xl text-xs font-black transition-all flex items-center gap-2 text-gray-600 hover:text-gray-900 cursor-pointer shrink-0">
          <span class="w-2 h-2 rounded-full bg-gray-400"></span>
          <span>2. Lançamentos de Exames</span>
        </button>
        <button type="button" onclick="switchRequisitionStep(3)" id="stepTabBtn3" class="px-3.5 py-1.5 rounded-xl text-xs font-black transition-all flex items-center gap-2 text-gray-600 hover:text-gray-900 cursor-pointer shrink-0">
          <span class="w-2 h-2 rounded-full bg-gray-400"></span>
          <span>3. Pagamento</span>
            </button>
      </div>

      <button onclick="closeRequisitionFormModal()" type="button" class="text-gray-400 hover:text-gray-700 p-2 hover:bg-gray-200 rounded-xl transition-colors cursor-pointer" title="Fechar (ESC)">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <!-- Conteúdo do Formulário -->
    <form id="requisitionMainForm" action="/admin/requisicoes/add" method="POST" onsubmit="return handleFormSubmit(event)" class="flex-1 overflow-y-auto p-4 sm:p-6 text-xs">
      <input type="hidden" name="id" id="req-id" value="">
      <input type="hidden" name="examsJson" id="req-examsJson" value="[]">
      <input type="hidden" name="subtotal" id="req-subtotalInput" value="0.00">
      <input type="hidden" name="totalAmount" id="req-totalAmountInput" value="0.00">

      <!-- ========================================================= -->
      <!-- ETAPA 1: DADOS DO PACIENTE & PARÂMETROS CLÍNICOS          -->
      <!-- ========================================================= -->
      <div id="requisitionStep1" class="space-y-4">

      <!-- CARD 1: Código da Requisição -->
      <div id="requisitionCodeCard" class="bg-gray-50/80 p-3.5 sm:p-4 rounded-2xl border border-gray-200 shadow-2xs flex items-center justify-between gap-3">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block shadow-sm"></span>
          <h3 class="text-xs font-black text-gray-800 uppercase tracking-wider">Identificador da Requisição</h3>
        </div>
        
        <div class="flex items-center gap-2">
          <a id="req-modal-view-pdf-btn" href="#" target="_blank" class="hidden px-2.5 py-1 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl font-extrabold text-[11px] transition-all flex items-center gap-1 shadow-xs active:scale-95 cursor-pointer mr-1" title="Visualizar / Imprimir Laudo em PDF">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0110.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0l.229 2.523a1.125 1.125 0 01-1.12 1.227H7.231a1.125 1.125 0 01-1.12-1.227L6.34 18m11.318 0h1.091A2.25 2.25 0 0021 15.75V9.456c0-1.081-.768-2.015-1.837-2.175a48.055 48.055 0 00-19.126 0C1.081 7.441.312 8.375.312 9.456V15.75a2.25 2.25 0 002.25 2.25h1.091M6 9h12V4.5A1.5 1.5 0 0016.5 3h-9A1.5 1.5 0 006 4.5V9z"/>
            </svg>
            <span>Visualizar Laudo</span>
          </a>
          <label class="font-bold text-gray-700 text-xs shrink-0 font-mono">Nº Requisição:</label>
          <div class="relative flex items-center">
            <input type="text" name="requisitionCode" id="req-requisitionCode" value="<%= nextReqCode %>" class="w-32 pl-3 pr-8 py-1.5 bg-white border border-gray-200 rounded-xl text-xs font-mono font-extrabold text-emerald-800 outline-none focus:ring-2 focus:ring-emerald-500 shadow-2xs">
            <button type="button" onclick="openSearchModal('req')" class="absolute right-1 w-6 h-6 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-600 border border-emerald-200/80 flex items-center justify-center transition-all cursor-pointer shadow-2xs" title="Buscar requisições anteriores">
              <svg class="w-3.5 h-3.5 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            </button>
          </div>
        </div>
      </div>

      <!-- CARD 2: DADOS DO PACIENTE (Importados do Cadastro de Clientes - Somente Leitura em Texto com Collapse Fechado) -->
      <div class="bg-white p-3.5 sm:p-4 rounded-2xl border border-slate-200/90 shadow-2xs space-y-2.5">
        
        <div class="flex items-center justify-between pb-2 border-b border-slate-100 flex-wrap gap-2">
          <div class="flex items-center gap-2.5">
            <div class="w-7 h-7 rounded-xl bg-emerald-50 text-emerald-700 border border-emerald-200/80 flex items-center justify-center font-black text-xs">
              👤
            </div>
            <div>
              <h3 class="text-xs font-black text-slate-800 uppercase tracking-wider">Dados do Paciente</h3>
              <p class="text-[10px] text-slate-500 font-mono">Informações registradas no Cadastro de Clientes</p>
            </div>
          </div>
          <button type="button" onclick="openPatientSearchModal()" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl font-bold text-xs shadow-xs shadow-emerald-600/20 transition-all flex items-center gap-1.5 cursor-pointer active:scale-95">
            <svg class="w-3.5 h-3.5 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            <span>Pesquisar / Selecionar Paciente</span>
          </button>
        </div>

        <!-- Campos ocultos para submissão via POST no formulário -->
        <input type="hidden" name="patientCode" id="req-patientCode" value="">
        <input type="hidden" name="patientName" id="req-patientName" value="" required>
        <input type="hidden" name="patientBirthDate" id="req-patientBirthDate" value="">
        <input type="hidden" name="patientAge" id="req-patientAge" value="">
        <input type="hidden" name="patientSex" id="req-patientSex" value="">
        <input type="hidden" name="address" id="req-address" value="">
        <input type="hidden" name="complement" id="req-complement" value="">
        <input type="hidden" name="city" id="req-city" value="Cambará">
        <input type="hidden" name="cep" id="req-cep" value="">
        <input type="hidden" name="patientPhone" id="req-patientPhone" value="">
        <input type="hidden" name="responsibleName" id="req-responsibleName" value="">

        <!-- CARD INTERATIVO DE EXIBIÇÃO DO PACIENTE (COMPACTO / COLLAPSE) -->
        <div id="patientCardDisplay" class="bg-slate-50/80 rounded-2xl p-3 border border-slate-200/90 text-slate-800 transition-all">
          
          <!-- ESTADO 1: Nenhum paciente associado ainda -->
          <div id="patientCardEmptyState" class="flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left py-1">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-xl bg-amber-50 text-amber-700 border border-amber-200/80 flex items-center justify-center font-bold text-sm shrink-0">
                ⚠️
              </div>
              <div>
                <h4 class="font-black text-slate-800 text-xs">Nenhum Paciente Selecionado</h4>
                <p class="text-[11px] text-slate-500">Selecione um paciente cadastrado para vincular a esta requisição.</p>
              </div>
            </div>
            <button type="button" onclick="openPatientSearchModal()" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl text-xs transition-all cursor-pointer shadow-2xs shrink-0 flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
              <span>Localizar Paciente</span>
            </button>
          </div>

          <!-- ESTADO 2: Exibição Compacta com Dados do Paciente e Collapse Fechado -->
          <div id="patientCardActiveState" class="hidden space-y-2">
            
            <!-- Linha Resumo Única: Avatar, Nome, Cód, CPF, Nascimento, Sexo e Botões de Ação -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div class="flex items-center gap-2.5 min-w-0">
                <div id="displayPatientAvatar" class="w-8 h-8 rounded-xl bg-gradient-to-br from-emerald-600 to-teal-700 text-white font-black text-xs flex items-center justify-center shrink-0 shadow-2xs uppercase tracking-wider">
                  --
                </div>
                <div class="min-w-0">
                  <div class="flex items-center gap-2 flex-wrap">
                    <h4 id="displayPatientName" class="font-black text-slate-900 text-xs tracking-tight truncate">Nome do Paciente</h4>
                    <span id="displayPatientCodeBadge" class="bg-emerald-100/80 text-emerald-900 border border-emerald-200 font-mono font-black text-[10px] px-2 py-0.5 rounded-lg shrink-0">
                      Cód: --
                    </span>
                  </div>
                  <div class="flex items-center gap-2 mt-0.5 text-[11px] text-slate-600 font-medium flex-wrap">
                    <span id="displayPatientCpf" class="font-mono text-slate-700 font-semibold">CPF: --</span>
                    <span class="text-slate-300">•</span>
                    <span id="displayPatientSex" class="font-bold text-slate-700">Sexo: --</span>
                    <span class="text-slate-300">•</span>
                    <span class="text-slate-700 font-semibold">🎂 <span id="displayPatientBirth">--</span> (<span id="displayPatientAge" class="font-bold text-emerald-800">--</span>)</span>
                  </div>
                </div>
              </div>

              <!-- Botões de Ação no Card: Trocar Paciente & Expandir/Recolher Detalhes -->
              <div class="flex items-center gap-1.5 self-end sm:self-auto shrink-0">
                <button type="button" onclick="openPatientSearchModal()" class="px-2.5 py-1 bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 rounded-xl font-bold text-[11px] transition-all cursor-pointer flex items-center gap-1 shadow-2xs">
                  <svg class="w-3 h-3 text-emerald-600 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                  <span>Trocar Paciente</span>
                </button>
                <button type="button" onclick="togglePatientDetailsCollapse()" class="px-2.5 py-1 bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200/80 rounded-xl font-bold text-[11px] transition-all cursor-pointer flex items-center gap-1 shadow-2xs">
                  <span id="togglePatientDetailsBtnText">Mais detalhes</span>
                  <span id="togglePatientDetailsBtnIcon" class="text-[10px]">▼</span>
                </button>
              </div>
            </div>

            <!-- Painel Colapsável de Detalhes Adicionais (Inicia FECHADO / HIDDEN) -->
            <div id="patientDetailsCollapse" class="hidden pt-2 border-t border-slate-200/80 animate-fadeIn">
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 text-xs">
                <div class="bg-white rounded-xl p-2 border border-slate-200/80 shadow-2xs">
                  <span class="text-[10px] font-mono font-bold text-slate-500 uppercase block tracking-wider">📍 Endereço Residencial</span>
                  <p id="displayPatientAddress" class="font-semibold text-slate-800 text-[11px] mt-0.5 truncate">--</p>
                </div>

                <div class="bg-white rounded-xl p-2 border border-slate-200/80 shadow-2xs">
                  <span class="text-[10px] font-mono font-bold text-slate-500 uppercase block tracking-wider">📱 Contato / WhatsApp</span>
                  <p id="displayPatientPhone" class="font-mono font-bold text-emerald-700 text-[11px] mt-0.5">--</p>
                </div>

                <div class="bg-white rounded-xl p-2 border border-slate-200/80 shadow-2xs">
                  <span class="text-[10px] font-mono font-bold text-slate-500 uppercase block tracking-wider">👥 Responsável / Mãe</span>
                  <p id="displayPatientResp" class="font-semibold text-slate-800 text-[11px] mt-0.5 truncate">--</p>
                </div>
              </div>
            </div>

          </div>

        </div>

      </div>

      <!-- CARD 3: Parâmetros Clínicos da Requisição -->
      <div class="bg-slate-100/70 p-4 sm:p-5 rounded-2xl border border-slate-200 shadow-xs space-y-4">
        
        <div class="flex items-center justify-between pb-2.5 border-b border-slate-200">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-emerald-600 inline-block shadow-sm"></span>
            <h3 class="text-xs font-black text-slate-800 uppercase tracking-wider">Parâmetros Clínicos & Fisiológicos</h3>
          </div>
          <span class="text-[11px] text-slate-500 font-semibold bg-white px-2.5 py-1 rounded-full border border-slate-200 shadow-2xs">4 Sub-Módulos Clínicos</span>
        </div>

        <!-- GRID DE CARDS CLÍNICOS (2 COLUNAS EM TELAS GRANDES) -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">

          <!-- CARD 1: CONVÊNIO, GUIA & FATURAMENTO -->
          <div class="bg-white p-4 rounded-xl border border-slate-200/90 shadow-2xs space-y-3 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between pb-2 border-b border-slate-100 mb-3">
                <div class="flex items-center gap-1.5 font-black text-xs text-emerald-800 uppercase tracking-wide">
                  <span>💳</span>
                  <span>1. Convênio, Guia & Faturamento</span>
                </div>
                <span class="text-[10px] font-bold text-slate-400 uppercase">Faturamento</span>
              </div>

              <div class="space-y-2.5">
                <!-- Convênio e Situação -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                  <div>
                    <label class="block font-bold text-[11px] text-slate-600 mb-0.5">Convênio <span class="text-rose-500">*</span>:</label>
                    <div class="flex items-center gap-1">
                      <input type="hidden" name="convenioId" id="req-convenioId" value="">
                      <input type="text" name="convenioCode" id="req-convenioCode" placeholder="Cód" class="w-12 px-1 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs font-mono text-center outline-none">
                      <div class="relative flex-1 flex items-center">
                        <select name="convenio" id="req-convenio" required class="w-full pl-2 pr-8 py-1.5 bg-slate-50/80 border border-slate-200 rounded-lg text-xs font-bold outline-none focus:bg-white focus:ring-2 focus:ring-emerald-500 text-slate-800">
                          <option value="">-- Selecione o Convênio * --</option>
                          <% if (locals.convenios && locals.convenios.length > 0) { %>
                            <% locals.convenios.forEach(function(conv) { %>
                              <option value="<%= conv.fantasia || conv.razaoSocial %>" data-code="<%= conv.codigo || '' %>" data-id="<%= conv.id || '' %>">
                                <%= conv.fantasia || conv.razaoSocial %>
                              </option>
                            <% }); %>
                          <% } else { %>
                            <option value="" disabled>(Nenhum convênio cadastrado)</option>
                          <% } %>
                        </select>
                        <button type="button" onclick="openSearchModal('convenio')" class="absolute right-1 w-6 h-6 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-600 border border-emerald-200/80 flex items-center justify-center transition-all cursor-pointer shadow-2xs" title="Pesquisar Convênio">
                          <svg class="w-3.5 h-3.5 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                        </button>
                      </div>
                    </div>
                  </div>

                  <div>
                    <label class="block font-bold text-[11px] text-slate-600 mb-0.5">Situação:</label>
                    <div class="flex items-center gap-1">
                      <input type="text" name="situacaoCode" id="req-situacaoCode" placeholder="Cód" class="w-12 px-1 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs font-mono text-center outline-none">
                      <div class="relative flex-1 flex items-center">
                        <select name="situacao" id="req-situacao" class="w-full pl-2 pr-8 py-1.5 bg-slate-50/80 border border-slate-200 rounded-lg text-xs outline-none focus:bg-white focus:ring-2 focus:ring-emerald-500">
                          <option value="Normal">Normal</option>
                          <option value="Urgente">Urgente</option>
                          <option value="Prioritário">Prioritário</option>
                          <option value="Aguardando Coleta">Aguardando Coleta</option>
                        </select>
                        <button type="button" onclick="openSearchModal('situacao')" class="absolute right-1 w-6 h-6 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-600 border border-emerald-200/80 flex items-center justify-center transition-all cursor-pointer shadow-2xs" title="Pesquisar Situação">
                          <svg class="w-3.5 h-3.5 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                        </button>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Matrícula & Guia -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                  <div>
                    <label class="block font-bold text-[11px] text-slate-600 mb-0.5">Matrícula / Carteirinha:</label>
                    <input type="text" name="matricula" id="req-matricula" placeholder="Nº da carteirinha" class="w-full px-2.5 py-1.5 bg-slate-50/80 border border-slate-200 rounded-lg text-xs outline-none focus:bg-white focus:ring-2 focus:ring-emerald-500">
                  </div>
                  <div>
                    <label class="block font-bold text-[11px] text-slate-600 mb-0.5">Nº Guia de Autorização:</label>
                    <input type="text" name="guia" id="req-guia" placeholder="Número da guia" class="w-full px-2.5 py-1.5 bg-slate-50/80 border border-slate-200 rounded-lg text-xs outline-none focus:bg-white focus:ring-2 focus:ring-emerald-500">
                  </div>
                </div>

                <!-- Empresa Parceira -->
                <div>
                  <label class="block font-bold text-[11px] text-slate-600 mb-0.5">Empresa Parceira / Faturamento:</label>
                  <div class="relative flex items-center">
                    <input type="text" name="empresa" id="req-empresa" placeholder="Empresa parceira / faturamento" class="w-full pl-2.5 pr-8 py-1.5 bg-slate-50/80 border border-slate-200 rounded-lg text-xs outline-none focus:bg-white focus:ring-2 focus:ring-emerald-500">
                    <button type="button" onclick="openSearchModal('empresa')" class="absolute right-1 w-6 h-6 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-600 border border-emerald-200/80 flex items-center justify-center transition-all cursor-pointer shadow-2xs" title="Pesquisar Empresa">
                      <svg class="w-3.5 h-3.5 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                    </button>
                  </div>
                </div>

                <!-- Flag Multiguias / Cobrança Mista -->
                <div class="pt-2 border-t border-slate-100">
                  <label class="inline-flex items-center gap-2 cursor-pointer font-bold text-xs text-blue-900 bg-blue-50/80 hover:bg-blue-100 px-3 py-1.5 rounded-lg border border-blue-200 transition-colors shadow-2xs w-full justify-between">
                    <div class="flex items-center gap-2">
                      <input type="checkbox" name="isMultiguia" id="req-isMultiguia" onchange="toggleMultiguiaMode()" class="w-4 h-4 rounded border-blue-300 text-blue-600 focus:ring-blue-500 cursor-pointer">
                      <span>📑 Requisição Multiguias / Cobrança Mista</span>
                    </div>
                    <span class="text-[10px] text-blue-700 font-mono font-normal">(Faturamento + Balcão)</span>
                  </label>

                  <!-- Live Summary breakdown for Step 1 -->
                  <div id="step1MultiguiaSummary" class="hidden mt-2 p-2.5 bg-blue-50/90 border border-blue-200 rounded-xl text-xs space-y-1.5 shadow-2xs">
                    <div class="flex items-center justify-between font-mono text-[11px]">
                      <span class="font-bold text-blue-900 flex items-center gap-1">
                        <span>🏢</span> Faturamento Convênio:
                      </span>
                      <span id="step1ConvenioVal" class="font-black text-blue-950">R$ 0,00</span>
                    </div>
                    <div class="flex items-center justify-between font-mono text-[11px]">
                      <span class="font-bold text-amber-900 flex items-center gap-1">
                        <span>💳</span> Cobrança Balcão:
                      </span>
                      <span id="step1ParticularVal" class="font-black text-amber-950">R$ 0,00</span>
                    </div>
                    <div class="flex items-center justify-between font-mono text-[11px] pt-1 border-t border-blue-200/80 font-black">
                      <span class="text-slate-700">Total Previsto:</span>
                      <span id="step1TotalVal" class="text-emerald-800">R$ 0,00</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- CARD 2: POSTO, TRIAGEM & DESTINO -->
          <div class="bg-white p-4 rounded-xl border border-slate-200/90 shadow-2xs space-y-3 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between pb-2 border-b border-slate-100 mb-3">
                <div class="flex items-center gap-1.5 font-black text-xs text-emerald-800 uppercase tracking-wide">
                  <span>🧪</span>
                  <span>2. Posto de Coleta, Triagem & Destino</span>
                </div>
                <span class="text-[10px] font-bold text-slate-400 uppercase">Logística Técnica</span>
              </div>

              <div class="space-y-2.5">
                <!-- Coleta & Cartão SUS -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                  <div>
                    <label class="block font-bold text-[11px] text-slate-600 mb-0.5">Posto / Local de Coleta:</label>
                    <div class="relative flex items-center">
                      <input type="text" name="coleta" id="req-coleta" value="Sede / Central" placeholder="Posto de Coleta" class="w-full pl-2.5 pr-8 py-1.5 bg-slate-50/80 border border-slate-200 rounded-lg text-xs outline-none focus:bg-white focus:ring-2 focus:ring-emerald-500">
                      <button type="button" onclick="openSearchModal('coleta')" class="absolute right-1 w-6 h-6 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-600 border border-emerald-200/80 flex items-center justify-center transition-all cursor-pointer shadow-2xs" title="Pesquisar Posto de Coleta">
                        <svg class="w-3.5 h-3.5 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                      </button>
                    </div>
                  </div>

                  <div>
                    <label class="block font-bold text-[11px] text-slate-600 mb-0.5">Cartão SUS:</label>
                    <div class="flex items-center gap-1">
                      <input type="text" name="susCard" id="req-susCard" placeholder="000 0000 0000 0000" class="flex-1 px-2 py-1.5 bg-slate-50/80 border border-slate-200 rounded-lg text-xs font-mono outline-none focus:bg-white focus:ring-2 focus:ring-emerald-500">
                      <button type="button" onclick="useCpfForSus()" class="px-2 py-1.5 bg-slate-100 hover:bg-slate-200 border border-slate-200 rounded-lg font-bold text-[10px] shrink-0 cursor-pointer">Usar CPF</button>
                    </div>
                  </div>
                </div>

                <!-- Destino & Horário -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 items-end">
                  <div class="sm:col-span-2">
                    <label class="block font-bold text-[11px] text-slate-600 mb-0.5">Destino / Lab. Apoio:</label>
                    <div class="relative flex items-center">
                      <input type="text" name="destino" id="req-destino" value="Laboratório Principal" placeholder="Laboratório de Apoio" class="w-full pl-2.5 pr-8 py-1.5 bg-slate-50/80 border border-slate-200 rounded-lg text-xs outline-none focus:bg-white focus:ring-2 focus:ring-emerald-500">
                      <button type="button" onclick="openSearchModal('destino')" class="absolute right-1 w-6 h-6 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-600 border border-emerald-200/80 flex items-center justify-center transition-all cursor-pointer shadow-2xs" title="Pesquisar Destino">
                        <svg class="w-3.5 h-3.5 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                      </button>
                    </div>
                  </div>

                  <div>
                    <label class="block font-bold text-[11px] text-slate-600 mb-0.5">Data Fatura:</label>
                    <div class="relative flex items-center">
                      <input type="text" name="fatura" id="req-fatura" value="<%= new Date().toLocaleDateString('pt-BR') %>" class="w-full pl-2 pr-7 py-1.5 bg-slate-50/80 border border-slate-200 rounded-lg text-xs outline-none focus:bg-white focus:ring-2 focus:ring-emerald-500">
                      <button type="button" onclick="openSearchModal('fatura')" class="absolute right-1 w-6 h-6 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-600 border border-emerald-200/80 flex items-center justify-center transition-all cursor-pointer shadow-2xs" title="Pesquisar Fatura">
                        <svg class="w-3.5 h-3.5 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                      </button>
                    </div>
                  </div>
                </div>

                <!-- Hora & Flag Urgente -->
                <div class="flex items-center justify-between gap-2 pt-1">
                  <div class="flex items-center gap-1.5">
                    <label class="font-bold text-[11px] text-slate-600">Hora Entrada:</label>
                    <input type="time" name="hora" id="req-hora" value="<%= new Date().toLocaleTimeString('pt-BR', { timeZone: 'America/Sao_Paulo', hour: '2-digit', minute: '2-digit' }) %>" class="w-24 px-2 py-1 bg-slate-50/80 border border-slate-200 rounded-lg text-xs font-mono outline-none focus:bg-white focus:ring-2 focus:ring-emerald-500">
                  </div>

                  <label class="inline-flex items-center gap-2 cursor-pointer font-bold text-xs text-rose-700 bg-rose-50 hover:bg-rose-100/80 px-3 py-1.5 rounded-lg border border-rose-200 transition-colors">
                    <input type="checkbox" name="isUrgent" id="req-isUrgent" class="w-4 h-4 rounded border-rose-300 text-rose-600 focus:ring-rose-500">
                    <span>🚨 Urgência Médica</span>
                  </label>
                </div>
              </div>
            </div>
          </div>

          <!-- CARD 3: MÉDICO SOLICITANTE & OBSERVAÇÕES -->
          <div class="bg-white p-4 rounded-xl border border-slate-200/90 shadow-2xs space-y-3 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between pb-2 border-b border-slate-100 mb-3">
                <div class="flex items-center gap-1.5 font-black text-xs text-emerald-800 uppercase tracking-wide">
                  <span>👨‍⚕️</span>
                  <span>3. Médico Solicitante & Observações</span>
                </div>
                <span class="text-[10px] font-bold text-slate-400 uppercase">Prescritor</span>
              </div>

              <div class="space-y-2.5">
                <!-- Médico Solicitante completo -->
                <div>
                  <label class="block font-bold text-[11px] text-slate-700 mb-0.5">Médico Solicitante <span class="text-rose-600 font-extrabold">*</span>:</label>
                  <div class="flex items-center gap-1">
                    <select name="doctorCrmType" id="req-doctorCrmType" class="px-1.5 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs font-bold outline-none focus:bg-white focus:ring-1 focus:ring-emerald-500">
                      <% 
                        const conselhosReq = [
                          'CRM', 'CRV', 'CRN', 'CRO', 'CRF', 'CRQ', 'CRAS', 'COREN', 
                          'CRP', 'CRFA', 'CRBM', 'CRBIO', 'CRFITO', 'RMS', 'CRT', 'CRMV', 
                          'ABQ', 'CREF', 'CRTR', 'CRTH'
                        ];
                      %>
                      <% conselhosReq.forEach(c => { %>
                        <option value="<%= c %>"><%= c %></option>
                      <% }) %>
                    </select>
                    <input type="text" name="doctorCrm" id="req-doctorCrm" placeholder="000000" class="w-20 px-2 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs font-mono outline-none focus:bg-white focus:ring-1 focus:ring-emerald-500">
                    <select name="doctorUf" id="req-doctorUf" class="px-1.5 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs font-mono font-bold outline-none focus:bg-white focus:ring-1 focus:ring-emerald-500">
                      <% 
                        const ufsReq = [
                          'AC', 'AL', 'AP', 'AM', 'BA', 'CE', 'DF', 'ES', 'GO', 'MA', 
                          'MT', 'MS', 'MG', 'PA', 'PB', 'PR', 'PE', 'PI', 'RJ', 'RN', 
                          'RS', 'RO', 'RR', 'SC', 'SP', 'SE', 'TO'
                        ];
                      %>
                      <% ufsReq.forEach(uf => { %>
                        <option value="<%= uf %>" <%= uf === 'PR' ? 'selected' : '' %>><%= uf %></option>
                      <% }) %>
                    </select>
                    <div class="relative flex-1 flex items-center">
                      <input type="text" name="doctorName" id="req-doctorName" list="medicosDatalist" placeholder="Nome do Médico Solicitante *" required class="w-full pl-2.5 pr-8 py-1.5 bg-slate-50/80 border border-slate-200 rounded-lg text-xs font-bold text-slate-800 outline-none focus:bg-white focus:ring-2 focus:ring-emerald-500 transition-all">
                      <datalist id="medicosDatalist">
                        <% if (locals.medicos && locals.medicos.length > 0) { %>
                          <% locals.medicos.forEach(m => { %>
                            <option value="<%= m.nome %>"><%= m.conselho || 'CRM' %> <%= m.numero %>/<%= m.uf || 'PR' %> - <%= m.nome %></option>
                          <% }) %>
                        <% } %>
                      </datalist>
                      <button type="button" onclick="openSearchModal('medico')" class="absolute right-1 w-6 h-6 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-600 border border-emerald-200/80 flex items-center justify-center transition-all cursor-pointer shadow-2xs" title="Buscar Médico no Cadastro">
                        <svg class="w-3.5 h-3.5 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                      </button>
                    </div>
                  </div>
                </div>

                <!-- Observações -->
                <div>
                  <label class="block font-bold text-[11px] text-slate-600 mb-0.5">Observações Adicionais:</label>
                  <textarea name="obs" id="req-obs" rows="2" placeholder="Observações específicas para esta requisição..." class="w-full px-2.5 py-1.5 bg-slate-50/80 border border-slate-200 rounded-lg text-xs outline-none focus:bg-white focus:ring-2 focus:ring-emerald-500 resize-none"></textarea>
                </div>
              </div>
            </div>
          </div>

          <!-- CARD 4: CONDIÇÕES FISIOLÓGICAS & BIOMETRIA -->
          <div class="bg-white p-4 rounded-xl border border-slate-200/90 shadow-2xs space-y-3 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between pb-2 border-b border-slate-100 mb-3">
                <div class="flex items-center gap-1.5 font-black text-xs text-emerald-800 uppercase tracking-wide">
                  <span>🩺</span>
                  <span>4. Condições Fisiológicas & Biometria</span>
                </div>
                <span class="text-[10px] font-bold text-slate-400 uppercase">Perfil Fisiológico</span>
              </div>

              <!-- Pílulas de Checkboxes de Condição Especial -->
              <div class="flex flex-wrap items-center gap-2 mb-3 bg-emerald-50/50 p-2.5 rounded-xl border border-emerald-100/80">
                <label class="inline-flex items-center gap-1.5 cursor-pointer font-bold text-xs text-slate-800 bg-white px-2.5 py-1 rounded-lg border border-slate-200 hover:border-emerald-400 transition-colors">
                  <input type="checkbox" name="isPregnant" id="req-isPregnant" class="w-3.5 h-3.5 rounded border-gray-300 text-emerald-600 focus:ring-emerald-500 cursor-pointer">
                  <span>Gestante</span>
                </label>

                <div class="inline-flex items-center gap-1 bg-white px-2 py-0.5 rounded-lg border border-slate-200 text-xs">
                  <span class="font-bold text-slate-600">Período:</span>
                  <input type="text" name="gestationalPeriod" id="req-gestationalPeriod" placeholder="0" class="w-9 px-1 py-0.5 bg-slate-50 border border-slate-300 rounded text-center text-xs font-bold outline-none focus:bg-white focus:ring-1 focus:ring-emerald-500">
                  <span class="text-slate-500 font-medium">sem.</span>
                </div>

                <label class="inline-flex items-center gap-1.5 cursor-pointer font-bold text-xs text-slate-800 bg-white px-2.5 py-1 rounded-lg border border-slate-200 hover:border-emerald-400 transition-colors">
                  <input type="checkbox" name="isNeonate" id="req-isNeonate" class="w-3.5 h-3.5 rounded border-gray-300 text-emerald-600 focus:ring-emerald-500 cursor-pointer">
                  <span>Neonato</span>
                </label>

                <label class="inline-flex items-center gap-1.5 cursor-pointer font-bold text-xs text-slate-800 bg-white px-2.5 py-1 rounded-lg border border-slate-200 hover:border-emerald-400 transition-colors">
                  <input type="checkbox" name="isIncapacitated" id="req-isIncapacitated" class="w-3.5 h-3.5 rounded border-gray-300 text-emerald-600 focus:ring-emerald-500 cursor-pointer">
                  <span>Incapacitado</span>
                </label>

                <label class="inline-flex items-center gap-1.5 cursor-pointer font-bold text-xs text-slate-800 bg-white px-2.5 py-1 rounded-lg border border-slate-200 hover:border-emerald-400 transition-colors">
                  <input type="checkbox" name="isPsr" id="req-isPsr" class="w-3.5 h-3.5 rounded border-gray-300 text-emerald-600 focus:ring-emerald-500 cursor-pointer">
                  <span>PSR</span>
                </label>
              </div>

              <!-- Grid Biométrico (DUM, Peso, Altura, Obs Clínicas) -->
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                <div>
                  <label class="block font-bold text-[11px] text-slate-600 mb-0.5">D.U.M.</label>
                  <input type="date" name="dum" id="req-dum" class="w-full px-2 py-1.5 bg-slate-50/80 border border-slate-200 rounded-lg text-xs outline-none focus:bg-white focus:ring-2 focus:ring-emerald-500">
                </div>
                <div>
                  <label class="block font-bold text-[11px] text-slate-600 mb-0.5">Peso (kg)</label>
                  <input type="number" step="0.1" name="weight" id="req-weight" placeholder="kg" class="w-full px-2 py-1.5 bg-slate-50/80 border border-slate-200 rounded-lg text-xs outline-none focus:bg-white focus:ring-2 focus:ring-emerald-500">
                </div>
                <div>
                  <label class="block font-bold text-[11px] text-slate-600 mb-0.5">Altura (m)</label>
                  <input type="number" step="0.01" name="height" id="req-height" placeholder="m" class="w-full px-2 py-1.5 bg-slate-50/80 border border-slate-200 rounded-lg text-xs outline-none focus:bg-white focus:ring-2 focus:ring-emerald-500">
                </div>
                <div>
                  <label class="block font-bold text-[11px] text-slate-600 mb-0.5">Obs. Clínicas</label>
                  <input type="text" name="clinicalNotes" id="req-clinicalNotes" placeholder="Resumo clínico" class="w-full px-2 py-1.5 bg-slate-50/80 border border-slate-200 rounded-lg text-xs outline-none focus:bg-white focus:ring-2 focus:ring-emerald-500">
                </div>
              </div>
            </div>
          </div>

        </div> <!-- Fim do Grid de 4 Cards -->

      </div> <!-- Fim do CARD 3 -->

        <!-- BARRA DE NAVEGAÇÃO DA ETAPA 1 -->
        <div class="bg-gray-50 px-6 py-4 border-t border-gray-200 flex items-center justify-end gap-3 shrink-0 rounded-b-2xl">
          <button type="button" onclick="cancelRequisitionForm()" class="px-5 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-2xl font-bold text-xs uppercase tracking-wider transition-all cursor-pointer">
            <span>Cancelar</span>
            <span class="text-[10px] text-gray-400 font-normal ml-1">(ESC)</span>
          </button>
          <button type="button" onclick="switchRequisitionStep(2)" class="px-6 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-2xl font-black text-xs uppercase tracking-wider shadow-md shadow-emerald-600/20 transition-all active:scale-95 cursor-pointer flex items-center gap-2">
            <span>Próximo</span>
            <span class="text-[10px] opacity-80 font-mono">(Alt + →)</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </button>
        </div>

      </div> <!-- Fim de requisitionStep1 -->


      <!-- ========================================================= -->
      <!-- ETAPA 2: LANÇAMENTO DE EXAMES & INFORMAÇÕES FINANCEIRAS   -->
      <!-- ========================================================= -->
      <div id="requisitionStep2" class="hidden space-y-4">

        <!-- PAINEL DE ADIÇÃO RÁPIDA DE EXAMES (CARD CLARO E AMIGÁVEL) -->
        <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200/90 shadow-2xs space-y-3">
          <div class="flex items-center justify-between pb-2.5 border-b border-slate-100 flex-wrap gap-2">
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-xl bg-emerald-50 text-emerald-700 border border-emerald-200/80 flex items-center justify-center font-black text-sm">
                🧪
              </div>
              <div>
                <h3 class="text-xs font-black text-slate-900 uppercase tracking-wider">Lançar Exame na Requisição</h3>
                <p class="text-[10px] text-slate-500 font-mono">Pesquise por código, nome ou informe o código direto no campo rápido</p>
              </div>
            </div>
            <span class="text-[11px] font-mono text-emerald-800 font-bold bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200">
              Catálogo LIS Ativo
            </span>
          </div>

          <!-- INPUT DE BUSCA + CAMPO RÁPIDO DE CÓDIGO -->
          <div class="grid grid-cols-1 md:grid-cols-12 gap-2.5 items-end">
            
            <!-- CAMPO DE Lançamento Rápido por Código com Botão de Lupa -->
            <div class="md:col-span-3">
              <label class="block font-bold text-[11px] text-amber-800 mb-1">⚡ Código do Exame (Enter / Lupa)</label>
              <div class="relative flex items-center">
                <input type="text" id="req-quickCodeInput" placeholder="Ex: HEM, GLI, EAS" onkeydown="if(event.key==='Enter'){ event.preventDefault(); addQuickExamByCodeDirect(); }" class="w-full pl-3 pr-8 py-2 bg-amber-50/60 border border-amber-300 rounded-xl text-xs font-mono font-black text-amber-900 uppercase placeholder-amber-400/80 outline-none focus:bg-white focus:ring-2 focus:ring-amber-500 shadow-2xs">
                <button type="button" onclick="openSearchModal('exame')" title="Busca Avançada de Exames" class="absolute right-1 text-amber-700 hover:text-amber-950 hover:bg-amber-200/60 p-1 rounded-lg transition-all cursor-pointer flex items-center justify-center">
                  <svg class="w-4 h-4 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                </button>
              </div>
            </div>

            <!-- CAMPO DE EXAME (CARREGADO PELO FILTRO) -->
            <div class="md:col-span-4 relative">
              <label class="block font-bold text-[11px] text-slate-700 mb-1">Exame</label>
              <div class="relative flex items-center">
                <input type="text" id="req-examSearchInput" readonly tabindex="-1" placeholder="Selecione pelo código ou pela lupa..." class="w-full px-3 py-2 bg-slate-100 border border-slate-200 rounded-xl text-xs font-bold text-slate-800 outline-none cursor-not-allowed select-none transition-all">
                <div class="absolute right-2 text-slate-400 pointer-events-none">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                </div>
              </div>
              
              <!-- Lista Autocomplete Desativada -->
              <div id="examAutocompleteList" class="hidden"></div>
            </div>

            <div class="md:col-span-3">
              <label class="block font-bold text-[11px] text-slate-700 mb-1">Material Biológico</label>
              <select id="req-examMaterial" onchange="onReqExamMaterialChange()" onkeydown="if(event.key==='Enter'){ event.preventDefault(); if(this.value){ document.getElementById('req-btnAddExam')?.focus(); } }" class="w-full px-3 py-2 bg-slate-50/80 border border-slate-200 rounded-xl text-xs text-slate-800 outline-none focus:bg-white focus:ring-2 focus:ring-emerald-500 font-medium">
                <option value="">Selecione o material...</option>
              </select>
            </div>

            <div class="md:col-span-1" id="req-examPriceContainer">
              <label class="block font-bold text-[11px] text-slate-700 mb-1">Valor R$</label>
              <input type="number" step="0.01" id="req-examPrice" placeholder="0.00" readonly class="w-full px-2 py-2 bg-slate-100 border border-slate-200 rounded-xl text-xs font-mono font-bold text-emerald-800 outline-none cursor-not-allowed select-none">
            </div>

            <div class="md:col-span-1">
              <button type="button" id="req-btnAddExam" onclick="addManualExamFromInput()" class="w-full py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-black rounded-xl text-xs shadow-xs shadow-emerald-600/20 transition-all cursor-pointer flex items-center justify-center gap-1 active:scale-95 focus:ring-2 focus:ring-emerald-500 focus:ring-offset-1 outline-none">
                <span>+ Add</span>
              </button>
            </div>

          </div>

          <!-- CHIPS RÁPIDOS DE EXAMES MAIS PEDIDOS -->
          <div class="pt-2.5 border-t border-slate-100 flex items-center gap-1.5 flex-wrap">
            <span class="text-[10px] font-mono text-slate-500 uppercase font-bold mr-1">Atalhos Rápido:</span>
            <% if (locals.requisitionShortcuts && requisitionShortcuts.length > 0) { %>
              <% requisitionShortcuts.forEach(s => { %>
                <button type="button" onclick="triggerRequisitionShortcut('<%= s.id %>')" title="Exame: <%= s.examName || s.examCode %> | Material: <%= s.material %>" class="px-2.5 py-1 bg-amber-50/80 hover:bg-amber-100 text-amber-900 border border-amber-200/80 hover:border-amber-400 rounded-lg text-[10px] font-bold transition-all cursor-pointer shadow-2xs flex items-center gap-1 active:scale-95">
                  <span class="text-amber-600 font-bold">⚡</span>
                  <span>+ <%= s.description %></span>
                </button>
              <% }); %>
            <% } else { %>
              <span class="text-[10px] text-gray-400 italic">Nenhum atalho cadastrado.</span>
            <% } %>
          </div>

        </div>

        <!-- TABELA DE EXAMES SOLICITADOS (LARGURA COMPLETA - GRID INTEIRO) -->
        <div class="bg-white rounded-2xl border border-gray-200 shadow-xs overflow-hidden">
          <div class="px-4 py-3 bg-gray-50 border-b border-gray-200 flex items-center justify-between flex-wrap gap-2">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-600"></span>
              <h4 class="font-black text-gray-800 uppercase tracking-wider text-xs">Exames Solicitados na Requisição</h4>
              <span id="examsCountBadge" class="bg-emerald-50 text-emerald-800 border border-emerald-200 font-mono text-[10px] font-black px-2.5 py-0.5 rounded-full">
                0 Exames
              </span>
            </div>

            <div class="flex items-center gap-2 flex-wrap">
              <!-- Campo de Horas em Jejum informadas pelo paciente -->
              <div class="flex items-center gap-1.5 bg-amber-50/90 border border-amber-300 px-3 py-1 rounded-xl shadow-2xs">
                <span class="text-amber-700 text-xs">⏱️</span>
                <label for="req-fastingHours" class="font-bold text-xs text-amber-950 shrink-0 select-none">Jejum informado:</label>
                <div class="flex items-center gap-1">
                  <input type="number" min="0" max="72" step="1" name="fastingHours" id="req-fastingHours" placeholder="8" title="Quantidade de horas em jejum informadas pelo paciente" class="w-14 px-1.5 py-0.5 bg-white border border-amber-300 rounded-lg text-xs font-mono font-bold text-amber-950 text-center outline-none focus:ring-2 focus:ring-amber-500 shadow-2xs">
                  <span class="text-[10px] font-extrabold text-amber-800 uppercase font-mono">Horas</span>
                </div>
              </div>

              <!-- BOTÃO PARA ABRIR O MODAL POPUP DE ORIENTAÇÕES DE COLETA -->
              <button type="button" onclick="openPrepInstructionsModal()" class="px-3 py-1.5 bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-300 rounded-xl font-bold text-xs flex items-center gap-1.5 transition-all active:scale-95 cursor-pointer shadow-2xs">
                <span>📋</span>
                <span>Orientações de Coleta & Jejum</span>
              </button>
            </div>
          </div>

          <!-- RESUMO DE CATEGORIZAÇÃO DE COBRANÇA DE EXAMES (CONVÊNIO x PARTICULAR) -->
          <div id="examSummaryBanner" class="px-3 py-2 bg-slate-100/90 border-y border-slate-200/80 flex flex-wrap items-center justify-between gap-2 text-xs font-mono hidden">
            <div class="flex items-center gap-2.5 flex-wrap">
              <span class="font-extrabold text-slate-700 uppercase tracking-wider text-[11px]">Tipo de Cobrança:</span>
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-extrabold bg-blue-100 text-blue-900 border border-blue-300 shadow-2xs">
                🏢 Convênio: <strong id="examSummaryConvenioVal" class="ml-1">0 exames (R$ 0,00)</strong>
              </span>
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-extrabold bg-amber-100 text-amber-900 border border-amber-300 shadow-2xs">
                💳 Particular: <strong id="examSummaryParticularVal" class="ml-1">0 exames (R$ 0,00)</strong>
              </span>
            </div>
            <div class="flex items-center gap-1.5">
              <button type="button" onclick="setAllExamsBillingCategory('convenio')" class="px-2 py-0.5 bg-blue-50 hover:bg-blue-100 text-blue-800 border border-blue-200 rounded text-[10px] font-bold transition-all cursor-pointer" title="Marcar todos os exames como Convênio">
                Todos Convênio
              </button>
              <button type="button" onclick="setAllExamsBillingCategory('particular')" class="px-2 py-0.5 bg-amber-50 hover:bg-amber-100 text-amber-800 border border-amber-200 rounded text-[10px] font-bold transition-all cursor-pointer" title="Marcar todos os exames como Particular">
                Todos Particular
              </button>
              <button type="button" onclick="syncFaturadoFromExams()" class="px-2 py-0.5 bg-emerald-100 hover:bg-emerald-200 text-emerald-900 border border-emerald-300 rounded text-[10px] font-bold transition-all cursor-pointer" title="Sincronizar valor faturado com a soma dos exames do convênio">
                ⚡ Sincronizar Faturamento
              </button>
            </div>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="bg-slate-50 text-slate-500 font-mono text-[10px] uppercase border-b border-gray-200">
                <tr>
                  <th class="px-3 py-2">#</th>
                  <th class="px-3 py-2">Código</th>
                  <th class="px-3 py-2">Nome do Exame</th>
                  <th class="px-3 py-2">Material</th>
                  <th class="px-3 py-2 text-center">Cobrança</th>
                  <th class="px-3 py-2">Jejum</th>
                  <th class="px-3 py-2">Prazo</th>
                  <th class="px-3 py-2 text-right exam-table-price-col">Valor R$</th>
                  <th class="px-3 py-2 text-center">Ações</th>
                </tr>
              </thead>
              <tbody id="addedExamsTbody" class="divide-y divide-gray-100">
                <!-- Preenchido dinamicamente via JS -->
                <tr id="addedExamsEmptyRow">
                  <td colspan="9" class="px-4 py-8 text-center text-gray-400 italic">
                    <div class="flex flex-col items-center justify-center gap-1">
                      <span class="text-2xl">🧪</span>
                      <span class="font-bold text-gray-600 text-xs">Nenhum exame adicionado a esta requisição</span>
                      <span class="text-[11px] text-gray-400">Utilize o campo acima para pesquisar ou clique nos atalhos rápidos</span>
                    </div>
                  </td>
                </tr>
              </tbody>
              <tfoot id="addedExamsTfoot" class="bg-emerald-50/50 border-t border-emerald-100 font-bold text-xs">
                <tr>
                  <td colspan="7" class="px-3 py-2.5 text-right font-mono uppercase text-emerald-900">Subtotal dos Exames:</td>
                  <td id="tableSubtotalVal" class="px-3 py-2.5 text-right font-mono font-black text-emerald-800 text-sm">R$ 0,00</td>
                  <td></td>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>

          <!-- RESUMO FINANCEIRO DOS EXAMES (DESCONTO R$/% E VALOR TOTAL A PAGAR) -->
          <div id="req-step2FinancialSummary" class="bg-gradient-to-r from-emerald-50/80 via-emerald-50/40 to-slate-50 p-4 rounded-2xl border border-emerald-200/80 shadow-2xs space-y-3">
            <div class="flex flex-col sm:flex-row items-center justify-end gap-3 w-full">
              <!-- Label e Campo de Valor de Desconto (Alinhados à Direita) -->
              <div class="flex flex-col sm:flex-row items-start sm:items-center justify-end gap-2 w-full sm:w-auto ml-auto">
                <label for="req-discountValInput" class="text-xs font-extrabold text-gray-700 shrink-0 select-none">Valor de Desconto:</label>
                <div class="flex flex-wrap items-center justify-start sm:justify-end gap-1.5 w-full sm:w-auto">
                  <div class="relative flex items-center w-full sm:w-36">
                    <span id="req-discountPrefix" class="absolute left-3 text-xs font-bold text-emerald-700 font-mono">R$</span>
                    <input type="number" step="0.01" min="0" id="req-discountValInput" value="0.00" oninput="onDiscountInputChange()" class="w-full pl-9 pr-3 py-1.5 bg-white border border-emerald-300 rounded-xl text-xs font-mono font-bold text-emerald-950 focus:ring-2 focus:ring-emerald-500 outline-none shadow-2xs">
                    <span id="req-discountSuffix" class="hidden absolute right-3 text-xs font-bold text-emerald-700 font-mono">%</span>
                  </div>

                  <!-- Seletor de Tipo de Desconto: [ R$ ] e [ % ] -->
                  <div class="flex items-center bg-emerald-100/90 p-0.5 rounded-xl border border-emerald-300 shrink-0">
                    <button type="button" id="btnDiscountModeReal" onclick="setDiscountMode('currency')" class="px-2.5 py-1 rounded-lg text-xs font-black transition-all cursor-pointer bg-emerald-700 text-white shadow-xs" title="Desconto em Reais (R$)">
                      R$
                    </button>
                    <button type="button" id="btnDiscountModePercent" onclick="setDiscountMode('percent')" class="px-2.5 py-1 rounded-lg text-xs font-black transition-all cursor-pointer text-emerald-900 hover:text-emerald-950 hover:bg-emerald-200/60" title="Desconto em Porcentagem (%)">
                      %
                    </button>
                  </div>

                  <!-- Label com o valor do desconto em Reais e em Porcentagem -->
                  <div id="req-discountSummaryBadge" class="flex items-center gap-1.5 bg-emerald-100/90 px-3 py-1 rounded-xl border border-emerald-300 text-xs font-mono font-bold text-emerald-900 shrink-0 shadow-2xs">
                    <span id="req-discountValRealLabel" class="text-emerald-950 font-black">R$ 0,00</span>
                    <span class="text-emerald-500 font-normal">|</span>
                    <span id="req-discountValPercentLabel" class="text-emerald-950 font-black">0,0%</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Label do Valor Total a Pagar (Abaixo do valor de desconto) -->
            <div class="flex items-center justify-end gap-3 sm:gap-4 bg-white px-4 py-2.5 rounded-xl border border-emerald-300/90 shadow-2xs text-right">
              <span class="text-xs sm:text-sm font-black text-emerald-950 font-mono uppercase tracking-tight flex items-center gap-2">
                <span>💳</span>
                <span>Valor Total a Pagar:</span>
              </span>
              <span id="req-totalAmountDisplay" class="text-base sm:text-xl font-black font-mono text-emerald-700">R$ 0,00</span>
            </div>
          </div>

        <!-- Inputs ocultos para envio do formulário -->
        <input type="hidden" name="discount" id="req-discount" value="0.00">
        <input type="hidden" name="discountPercent" id="req-discountPercent" value="0">
        <input type="hidden" name="subtotal" id="req-subtotalInput" value="0.00">
        <input type="hidden" name="totalAmount" id="req-totalAmountInput" value="0.00">
        <input type="hidden" name="paymentMethod" id="req-paymentMethod" value="Particular - Dinheiro">
        <input type="hidden" name="paymentCondition" id="req-paymentCondition" value="À Vista">
        <input type="hidden" name="paidAmount" id="req-paidAmount" value="0.00">
        <input type="hidden" name="financialStatus" id="req-financialStatus" value="Pendente">
        <input type="hidden" name="status" id="req-status" value="Em Andamento">

        <!-- CARDS FULL-WIDTH ABAIXO DOS EXAMES (LOGÍSTICA & PREVISÃO DE ENTREGA) -->
        <div class="space-y-4">
          <div class="bg-white p-4 sm:p-5 rounded-2xl border border-gray-200 shadow-2xs space-y-3.5">
            <div class="flex items-center gap-2 pb-2 border-b border-gray-100">
              <span class="text-base">📅</span>
              <h4 class="font-black text-gray-800 uppercase tracking-wider text-xs">Logística & Previsão de Entrega</h4>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-12 gap-3.5 items-end">
              <!-- Qtd de Dias p/ Ficar Pronto -->
              <div class="sm:col-span-3">
                <label class="block font-bold text-[11px] text-amber-900 mb-1">
                  ⏱️ Qtd. Dias p/ Ficar Pronto <span class="text-rose-500">*</span>
                </label>
                <div class="relative flex items-center">
                  <input type="number" min="0" step="1" name="deliveryDays" id="req-deliveryDays" placeholder="Ex: 2" oninput="onDeliveryDaysInput()" onchange="onDeliveryDaysInput()" class="w-full pl-3 pr-12 py-2 bg-amber-50/60 border border-amber-300 rounded-xl text-xs font-mono font-black text-amber-950 focus:bg-white focus:ring-2 focus:ring-amber-500 outline-none shadow-2xs" required>
                  <span class="absolute right-3 text-[10px] font-extrabold text-amber-700 uppercase font-mono select-none">Dias</span>
                </div>
              </div>

              <!-- Data Prevista Entrega -->
              <div class="sm:col-span-3">
                <label class="block font-bold text-[11px] text-gray-700 mb-1">
                  Data Prevista Entrega <span class="text-rose-500">*</span>
                </label>
                <input type="date" name="deliveryDate" id="req-deliveryDate" required onchange="onDeliveryDateChange()" oninput="onDeliveryDateChange()" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-xs outline-none focus:ring-2 focus:ring-emerald-500 font-bold text-emerald-900">
                <p id="req-deliveryDateWarning" class="hidden text-[10px] text-rose-600 font-bold mt-1">⚠️ A data prevista cai em um fim de semana (Sábado/Domingo). Escolha um dia útil.</p>
              </div>

              <!-- Hora Prevista -->
              <div class="sm:col-span-2">
                <label class="block font-bold text-[11px] text-gray-700 mb-1">Hora Prevista</label>
                <input type="time" name="deliveryTime" id="req-deliveryTime" value="17:00" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-xs outline-none focus:ring-2 focus:ring-emerald-500 font-bold text-emerald-900">
              </div>

              <!-- CID-10 -->
              <div class="sm:col-span-4">
                <label class="block font-bold text-[11px] text-gray-700 mb-1">Código CID-10 (Diagnóstico)</label>
                <div class="relative">
                  <input type="text" name="cid10" id="req-cid10" placeholder="Ex: E11 (Diabetes), Z00" class="w-full pl-3 pr-8 py-2 bg-gray-50 border border-gray-200 rounded-xl text-xs font-mono uppercase outline-none focus:ring-2 focus:ring-emerald-500">
                  <button type="button" onclick="openCidModal()" class="absolute right-2.5 top-2.5 text-gray-400 hover:text-emerald-700">🔍</button>
                </div>
              </div>
            </div>

            <!-- Checkboxes Extras -->
            <div class="flex items-center gap-6 pt-1.5 border-t border-gray-100 flex-wrap text-xs font-bold text-gray-800">
              <label class="inline-flex items-center gap-2 cursor-pointer">
                <input type="checkbox" name="notifyWhatsapp" id="req-notifyWhatsapp" checked class="w-4 h-4 rounded border-gray-300 text-emerald-600 focus:ring-emerald-500">
                <span>📱 Notificar paciente por WhatsApp ao liberar laudo</span>
              </label>
              <label class="inline-flex items-center gap-2 cursor-pointer">
                <input type="checkbox" name="separateLabel" id="req-separateLabel" class="w-4 h-4 rounded border-gray-300 text-emerald-600 focus:ring-emerald-500">
                <span>🏷️ Imprimir etiquetas de tubo de ensaio separadas</span>
              </label>
            </div>
          </div>

        </div>

        <!-- BARRA DE NAVEGAÇÃO DA ETAPA 2 -->
        <div class="bg-gray-50 px-6 py-4 border-t border-gray-200 flex items-center justify-between gap-3 shrink-0 rounded-b-2xl flex-wrap">
          <div class="flex items-center gap-2">
            <button type="button" onclick="cancelRequisitionForm()" class="px-4 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-2xl font-bold text-xs uppercase tracking-wider transition-all cursor-pointer">
              <span>Cancelar</span>
              <span class="text-[10px] text-gray-400 font-normal ml-1">(ESC)</span>
            </button>
            <button type="button" onclick="switchRequisitionStep(1)" class="px-4 py-2.5 bg-gray-200 hover:bg-gray-300 text-gray-800 rounded-2xl font-bold text-xs uppercase tracking-wider transition-all cursor-pointer flex items-center gap-1.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
              <span>Voltar</span>
              <span class="text-[10px] text-gray-500 font-mono">(Alt + ←)</span>
            </button>
          </div>
          
          <div class="flex items-center gap-2">
            <button type="submit" id="req-btnFinalizeDirect" class="px-4 py-2.5 bg-slate-200 hover:bg-slate-300 text-slate-800 rounded-2xl font-bold text-xs uppercase tracking-wider transition-all cursor-pointer flex items-center gap-1.5" title="Salvar requisição sem informar pagamento agora">
              <span>Finalizar sem Pagamento</span>
            </button>
            <button type="button" id="req-btnNextToPayment" onclick="switchRequisitionStep(3)" class="px-6 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-2xl font-black text-xs uppercase tracking-wider shadow-md shadow-emerald-600/20 transition-all active:scale-95 cursor-pointer flex items-center gap-2">
              <span>Avançar para Pagamento</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </button>
          </div>
        </div>

      </div> <!-- Fim de requisitionStep2 -->

      <!-- ========================================================= -->
      <!-- ETAPA 3: LANÇAMENTO DE PAGAMENTO (MÚLTIPLOS LANÇAMENTOS)  -->
      <!-- ========================================================= -->
      <div id="requisitionStep3" class="hidden space-y-4">

        <!-- CARD 1: RESUMO FINANCEIRO DA REQUISIÇÃO -->
        <div class="bg-gradient-to-br from-emerald-50/90 via-emerald-50/50 to-teal-50/80 p-4 sm:p-5 rounded-2xl border border-emerald-200/90 text-gray-800 shadow-2xs space-y-3">
          <div class="flex items-center justify-between pb-3 border-b border-emerald-200/80 flex-wrap gap-2">
            <div class="flex items-center gap-2.5">
              <div class="p-2 bg-emerald-100 text-emerald-800 rounded-xl border border-emerald-200">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V6m0 12v-2m0 0e1.11 0 2.08-.402 2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <div>
                <h3 class="text-xs font-black uppercase tracking-wider text-emerald-950">Resumo Financeiro & Totais da Requisição</h3>
                <p class="text-[11px] text-emerald-900/80 font-medium">Balanço atual e status do acerto de contas</p>
              </div>
            </div>
            <div id="step3StatusBadge" class="px-3 py-1 rounded-xl text-xs font-mono font-black uppercase bg-amber-100 text-amber-900 border border-amber-300">
              PENDENTE
            </div>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-5 gap-3 pt-1">
            <div class="bg-white/90 p-3 rounded-xl border border-emerald-200/80 shadow-2xs">
              <span class="block text-[10px] font-bold text-gray-500 uppercase tracking-wider">Subtotal Exames</span>
              <span id="step3SubtotalDisplay" class="text-sm font-extrabold font-mono text-gray-900">R$ 0,00</span>
            </div>
            <div class="bg-white/90 p-3 rounded-xl border border-emerald-200/80 shadow-2xs">
              <span class="block text-[10px] font-bold text-gray-500 uppercase tracking-wider">Desconto Aplicado</span>
              <span id="step3DiscountDisplay" class="text-sm font-extrabold font-mono text-rose-600">R$ 0,00</span>
            </div>
            <div class="bg-white/90 p-3 rounded-xl border border-emerald-200/80 shadow-2xs">
              <span class="block text-[10px] font-bold text-gray-500 uppercase tracking-wider">Total Líquido</span>
              <span id="step3TotalDisplay" class="text-sm font-extrabold font-mono text-emerald-700">R$ 0,00</span>
            </div>
            <div class="bg-white/90 p-3 rounded-xl border border-emerald-200/80 shadow-2xs">
              <span class="block text-[10px] font-bold text-gray-500 uppercase tracking-wider">Total Já Pago</span>
              <span id="step3PaidDisplay" class="text-sm font-extrabold font-mono text-sky-700">R$ 0,00</span>
            </div>
            <div class="bg-white/90 p-3 rounded-xl border border-emerald-200/80 shadow-2xs col-span-2 sm:col-span-1">
              <span id="step3RemainingLabel" class="block text-[10px] font-bold text-amber-700 uppercase tracking-wider">Saldo Devedor</span>
              <span id="step3RemainingDisplay" class="text-sm font-extrabold font-mono text-amber-700">R$ 0,00</span>
            </div>
          </div>

          <!-- APLICAR / AJUSTAR DESCONTO DA REQUISIÇÃO NA TELA DE PAGAMENTO -->
          <div class="pt-3 border-t border-emerald-200/80 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
            <div class="flex items-center gap-2">
              <span class="text-base">🏷️</span>
              <div>
                <span class="font-bold text-emerald-950 block text-xs">Desconto Geral da Requisição:</span>
                <span class="text-[10px] text-gray-600">Aplica desconto no total dos exames</span>
              </div>
            </div>

            <div class="flex flex-wrap items-center justify-end gap-2 w-full sm:w-auto">
              <div class="relative flex items-center w-full sm:w-36">
                <span id="req-discountPrefixStep3" class="absolute left-3 text-xs font-bold text-emerald-700 font-mono">R$</span>
                <input type="number" step="0.01" min="0" id="req-discountValInputStep3" value="0.00" oninput="onDiscountInputChange('step3')" class="w-full pl-9 pr-3 py-1.5 bg-white border border-emerald-300 rounded-xl text-xs font-mono font-bold text-emerald-950 focus:ring-2 focus:ring-emerald-500 outline-none shadow-2xs">
                <span id="req-discountSuffixStep3" class="hidden absolute right-3 text-xs font-bold text-emerald-700 font-mono">%</span>
              </div>

              <!-- Seletor de Tipo de Desconto: [ R$ ] e [ % ] -->
              <div class="flex items-center bg-emerald-100/90 p-0.5 rounded-xl border border-emerald-300 shrink-0">
                <button type="button" id="btnDiscountModeRealStep3" onclick="setDiscountMode('currency')" class="px-2.5 py-1 rounded-lg text-xs font-black transition-all cursor-pointer bg-emerald-700 text-white shadow-xs" title="Desconto em Reais (R$)">
                  R$
                </button>
                <button type="button" id="btnDiscountModePercentStep3" onclick="setDiscountMode('percent')" class="px-2.5 py-1 rounded-lg text-xs font-black transition-all cursor-pointer text-emerald-900 hover:text-emerald-950 hover:bg-emerald-200/60" title="Desconto em Porcentagem (%)">
                  %
                </button>
              </div>

              <!-- Badge com o valor do desconto calculado -->
              <div id="req-discountSummaryBadgeStep3" class="flex items-center gap-1.5 bg-emerald-100/90 px-3 py-1 rounded-xl border border-emerald-300 text-xs font-mono font-bold text-emerald-900 shrink-0 shadow-2xs">
                <span id="req-discountValRealLabelStep3" class="text-emerald-950 font-black">R$ 0,00</span>
                <span class="text-emerald-400 font-normal">|</span>
                <span id="req-discountValPercentLabelStep3" class="text-emerald-950 font-black">0,0%</span>
              </div>
            </div>
          </div>

          <!-- PAINEL DE MULTIGUIAS / DIVISÃO DE COBRANÇA (CONVÊNIO x BALCÃO) -->
          <div id="multiguiasPanel" class="pt-3 border-t border-emerald-200/80 space-y-2.5 hidden">
            <div class="flex items-center justify-between flex-wrap gap-2">
              <div class="flex items-center gap-2">
                <span class="text-base">📑</span>
                <div>
                  <span class="font-bold text-emerald-950 block text-xs uppercase tracking-wider">Divisão de Cobrança / Multiguias</span>
                  <span class="text-[10px] text-emerald-800 font-medium">Divisão entre Faturamento no Convênio e Copagamento/Balcão do Paciente</span>
                </div>
              </div>
              <div class="flex items-center gap-2">
                <button type="button" onclick="setMultiguiaFullFaturamento()" class="px-2.5 py-1 bg-blue-100 hover:bg-blue-200 text-blue-900 border border-blue-300 rounded-lg text-[11px] font-bold cursor-pointer transition-all active:scale-95 shadow-2xs" title="Faturar 100% no Convênio">
                  100% Convênio
                </button>
                <button type="button" onclick="setMultiguiaFullBalcao()" class="px-2.5 py-1 bg-amber-100 hover:bg-amber-200 text-amber-900 border border-amber-300 rounded-lg text-[11px] font-bold cursor-pointer transition-all active:scale-95 shadow-2xs" title="Cobrar 100% no Balcão">
                  100% Balcão
                </button>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1">
              <div class="bg-white/90 p-2.5 rounded-xl border border-blue-200 shadow-2xs">
                <label class="block text-[10px] font-extrabold text-blue-900 uppercase tracking-wider mb-1">Faturar ao Convênio (R$)</label>
                <div class="relative flex items-center">
                  <span class="absolute left-2.5 text-xs font-bold text-blue-700 font-mono">R$</span>
                  <input type="number" step="0.01" min="0" name="faturadoAmount" id="req-faturadoValInput" value="0.00" oninput="this.dataset.userTouched='true'; calcFinancials();" class="w-full pl-8 pr-2 py-1 bg-blue-50/50 border border-blue-300 rounded-lg text-xs font-mono font-black text-blue-950 focus:ring-2 focus:ring-blue-500 outline-none">
                </div>
              </div>

              <div class="bg-white/90 p-2.5 rounded-xl border border-amber-200 shadow-2xs">
                <span class="block text-[10px] font-extrabold text-amber-900 uppercase tracking-wider mb-1">Devido no Balcão (Copagamento)</span>
                <span id="step3BalcaoDevidoDisplay" class="text-sm font-extrabold font-mono text-amber-900 block pt-0.5">R$ 0,00</span>
              </div>

              <div class="bg-white/90 p-2.5 rounded-xl border border-emerald-200 shadow-2xs">
                <span class="block text-[10px] font-extrabold text-emerald-900 uppercase tracking-wider mb-1">Saldo Devedor Balcão</span>
                <span id="step3BalcaoRemainingDisplay" class="text-sm font-extrabold font-mono text-emerald-800 block pt-0.5">R$ 0,00</span>
              </div>
            </div>
          </div>
        </div>

        <!-- CARD 2: ADICIONAR NOVO LANÇAMENTO DE PAGAMENTO -->
        <div class="bg-white p-4 sm:p-5 rounded-2xl border border-gray-200 shadow-2xs space-y-3.5">
          <div class="flex items-center justify-between pb-2.5 border-b border-gray-100">
            <div class="flex items-center gap-2">
              <span class="text-base">💳</span>
              <div>
                <h4 class="font-black text-gray-800 uppercase tracking-wider text-xs">Novo Lançamento de Pagamento</h4>
                <p class="text-[11px] text-gray-500 font-medium">Permite dividir o pagamento em múltiplas formas (Dinheiro, Cartão, PIX, etc.)</p>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-12 gap-3.5 items-end">
            <!-- Forma de Pagamento -->
            <div class="sm:col-span-3">
              <label class="block font-bold text-[11px] text-gray-700 mb-1">Forma de Pagamento</label>
              <select id="reqPayMethodSelect" onchange="onReqPayMethodChange()" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-xs font-bold text-gray-800 focus:bg-white focus:ring-2 focus:ring-emerald-500 outline-none">
              </select>
            </div>

            <!-- Condição / Parcelamento -->
            <div class="sm:col-span-3">
              <label class="block font-bold text-[11px] text-gray-700 mb-1">Condição de Pagamento</label>
              <select id="reqPayConditionSelect" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-xs font-bold text-gray-800 focus:bg-white focus:ring-2 focus:ring-emerald-500 outline-none">
              </select>
            </div>

            <!-- Valor (R$) -->
            <div class="sm:col-span-3">
              <div class="flex items-center justify-between mb-1">
                <label class="block font-bold text-[11px] text-gray-700">Valor Pago (R$)</label>
                <button type="button" onclick="fillRemainingPayAmount()" class="text-[10px] font-black text-emerald-700 hover:text-emerald-900 hover:underline cursor-pointer">
                  Preencher Restante
                </button>
              </div>
              <input type="number" step="0.01" id="reqPayAmountInput" placeholder="0.00" class="w-full px-3 py-2 bg-emerald-50/50 border border-emerald-300 rounded-xl text-xs font-mono font-black text-emerald-950 focus:bg-white focus:ring-2 focus:ring-emerald-500 outline-none">
            </div>

            <!-- Data / Hora -->
            <div class="sm:col-span-3">
              <label class="block font-bold text-[11px] text-gray-700 mb-1">Data e Hora do Pagamento</label>
              <input type="datetime-local" id="reqPayDateInput" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-xs font-bold text-gray-800 focus:bg-white focus:ring-2 focus:ring-emerald-500 outline-none">
            </div>

            <!-- Observação / Comprovante -->
            <div class="sm:col-span-9">
              <label class="block font-bold text-[11px] text-gray-700 mb-1">Observação / NSU / Comprovante (Opcional)</label>
              <input type="text" id="reqPayObsInput" placeholder="Ex: Chave PIX, NSU 48291, Pago em espécie em mãos" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-xs text-gray-800 focus:bg-white focus:ring-2 focus:ring-emerald-500 outline-none">
            </div>

            <!-- Botão Adicionar -->
            <div class="sm:col-span-3">
              <button type="button" onclick="addPaymentToRequisitionList()" class="w-full py-2 px-4 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl font-extrabold text-xs transition-all shadow-xs active:scale-95 cursor-pointer flex items-center justify-center gap-1.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                <span>+ Adicionar Lançamento</span>
              </button>
            </div>
          </div>
        </div>

        <!-- CARD 3: TABELA DE LANÇAMENTOS DE PAGAMENTO -->
        <div class="bg-white p-4 sm:p-5 rounded-2xl border border-gray-200 shadow-2xs space-y-3">
          <div class="flex items-center justify-between pb-2 border-b border-gray-100">
            <div class="flex items-center gap-2">
              <span class="text-base">📋</span>
              <h4 class="font-black text-gray-800 uppercase tracking-wider text-xs">Pagamentos Registrados nesta Requisição</h4>
            </div>
            <span id="reqPayCountBadge" class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-slate-100 text-slate-700 border border-slate-200">
              0 lançamento(s)
            </span>
          </div>

          <div class="overflow-x-auto border border-gray-200 rounded-xl">
            <table class="w-full text-left text-xs">
              <thead class="bg-gray-100 text-gray-700 font-extrabold uppercase text-[10px] tracking-wider border-b border-gray-200">
                <tr>
                  <th class="px-3.5 py-2.5">Forma de Pagamento</th>
                  <th class="px-3.5 py-2.5">Condição</th>
                  <th class="px-3.5 py-2.5 text-right">Valor Pago</th>
                  <th class="px-3.5 py-2.5">Data / Hora</th>
                  <th class="px-3.5 py-2.5">Observação</th>
                  <th class="px-3.5 py-2.5 text-center">Ações</th>
                </tr>
              </thead>
              <tbody id="reqPaymentsTableBody" class="divide-y divide-gray-100 font-medium text-gray-800">
                <tr>
                  <td colspan="6" class="px-4 py-8 text-center text-gray-400 italic">
                    Nenhum pagamento lançado. O status permanecerá como Pendente.
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Hidden input holding JSON stringified array of payments -->
        <input type="hidden" name="payments" id="req-paymentsJson" value="[]">

        <!-- BARRA DE NAVEGAÇÃO DA ETAPA 3 -->
        <div class="bg-gray-50 px-6 py-4 border-t border-gray-200 flex items-center justify-between gap-3 shrink-0 rounded-b-2xl">
          <div class="flex items-center gap-2">
            <button type="button" onclick="cancelRequisitionForm()" class="px-4 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-2xl font-bold text-xs uppercase tracking-wider transition-all cursor-pointer">
              <span>Cancelar (ESC)</span>
            </button>
            <button type="button" onclick="switchRequisitionStep(2)" class="px-4 py-2.5 bg-gray-200 hover:bg-gray-300 text-gray-800 rounded-2xl font-bold text-xs uppercase tracking-wider transition-all cursor-pointer flex items-center gap-1.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
              <span>Voltar Exames (Alt + ←)</span>
            </button>
          </div>
          
          <button type="submit" class="px-6 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-2xl font-black text-xs uppercase tracking-wider shadow-md shadow-emerald-600/20 transition-all active:scale-95 cursor-pointer flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            <span>Finalizar Requisição</span>
            <span class="text-[10px] opacity-80 font-mono">(Ctrl + Enter)</span>
          </button>
        </div>

      </div> <!-- Fim de requisitionStep3 -->

    </form>
  </div>
</div>

