  function addPaymentToRequisitionList() {
    const methodSelect = document.getElementById('reqPayMethodSelect');
    const condSelect = document.getElementById('reqPayConditionSelect');
    const amountInput = document.getElementById('reqPayAmountInput');
    const dateInput = document.getElementById('reqPayDateInput');
    const obsInput = document.getElementById('reqPayObsInput');

    if (!methodSelect || !amountInput) return;

    const val = parseFloat(amountInput.value) || 0;
    if (val <= 0) {
      alert('Por favor, informe um valor de pagamento válido maior que zero.');
      amountInput.focus();
      return;
    }

    const selectedMethodId = methodSelect.value;
    const methodObj = allPaymentMethodsData.find(m => String(m.id) === String(selectedMethodId));
    const methodName = methodObj ? methodObj.name : (methodSelect.options[methodSelect.selectedIndex]?.text || 'Dinheiro');

    const condText = condSelect && condSelect.selectedIndex >= 0 ? condSelect.options[condSelect.selectedIndex].text : 'À Vista';

    let dateVal = dateInput && dateInput.value ? dateInput.value : '';
    if (!dateVal) {
      const now = new Date();
      now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
      dateVal = now.toISOString().slice(0, 16);
    }

    const obsVal = obsInput ? obsInput.value.trim() : '';

    const newPayment = {
      id: 'pay_' + Date.now() + '_' + Math.random().toString(36).substring(2, 5),
      methodId: selectedMethodId,
      methodName: methodName,
      conditionName: condText,
      amount: val,
      date: dateVal,
      obs: obsVal
    };

    currentRequisitionPayments.push(newPayment);

    // Limpar campos
    amountInput.value = '';
    if (obsInput) obsInput.value = '';

    renderRequisitionPaymentsTable();
    calcFinancials();
    fillRemainingPayAmount();
  }

  function removePaymentFromRequisitionList(index) {
    if (index >= 0 && index < currentRequisitionPayments.length) {
      currentRequisitionPayments.splice(index, 1);
      renderRequisitionPaymentsTable();
      calcFinancials();
      fillRemainingPayAmount();
    }
  }

