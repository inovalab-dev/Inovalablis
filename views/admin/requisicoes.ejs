  async function executeRequisitionCancellation() {
    const reqId = document.getElementById('cancelReqId').value;
    const inputVal = (document.getElementById('cancelConfirmInput').value || '').trim();
    const errorEl = document.getElementById('cancelConfirmError');

    if (inputVal.toUpperCase() !== 'CANCELAR') {
      if (errorEl) errorEl.classList.remove('hidden');
      return;
    }
    if (errorEl) errorEl.classList.add('hidden');

    try {
      const res = await fetch('/admin/requisicoes/cancel', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ id: reqId })
      });
      const data = await res.json();
      if (data.success) {
        closeCancelModal();
        if (typeof showToast === 'function') {
          showToast('Requisição e exames cancelados com sucesso!', 'success');
        } else {
          alert('Requisição e exames cancelados com sucesso!');
        }
        setTimeout(() => {
          window.location.reload();
        }, 400);
      } else {
        alert(data.message || 'Erro ao cancelar requisição.');
      }
    } catch (err) {
      console.error(err);
      alert('Erro de comunicação ao cancelar a requisição.');
    }
  }

  function setFormReadOnlyMode(isReadOnly) {
    window.isCurrentReqReadOnly = !!isReadOnly;
    const form = document.getElementById('requisitionMainForm');
    if (!form) return;

    const modalContainer = document.getElementById('requisitionFormModal')?.querySelector('.relative');
    let banner = document.getElementById('req-cancel-readonly-banner');
    if (isReadOnly) {
      if (!banner && modalContainer) {
        banner = document.createElement('div');
        banner.id = 'req-cancel-readonly-banner';
        banner.className = 'mx-6 mt-4 p-3.5 bg-rose-100 border border-rose-300 rounded-2xl text-rose-900 font-bold text-xs flex items-center justify-between shrink-0 shadow-xs animate-fadeIn';
        banner.innerHTML = `
          <div class="flex items-center gap-2.5">
            <span class="text-xl">🚫</span>
            <div>
              <div class="font-black uppercase tracking-wider text-rose-900">Requisição Cancelada</div>
              <div class="text-[11px] text-rose-700 font-medium">Esta requisição foi cancelada e está sendo exibida apenas para consulta (somente leitura).</div>
            </div>
          </div>
          <span class="px-3 py-1 bg-rose-600 text-white font-black uppercase text-[10px] rounded-xl tracking-wider shrink-0 shadow-2xs">Somente Leitura</span>
        `;
        modalContainer.insertBefore(banner, modalContainer.children[1] || form);
      } else if (banner) {
        banner.classList.remove('hidden');
      }
    } else {
      if (banner) banner.classList.add('hidden');
    }

    const controls = form.querySelectorAll('input, select, textarea');
    controls.forEach(el => {
      el.disabled = isReadOnly;
    });

    const submitBtns = form.querySelectorAll('button[type="submit"]');
    submitBtns.forEach(btn => {
      btn.style.display = isReadOnly ? 'none' : '';
    });

    const searchInput = document.getElementById('examSearchInput');
    if (searchInput) searchInput.disabled = isReadOnly;

    renderExamsTable();
  }

  function selectRequisitionToForm(reqId, targetStep = 1) {
    const req = requisitionsData.find(r => String(r.id) === String(reqId) || String(r.requisitionCode) === String(reqId));
    if (!req) return;

    const isCancelado = String(req.status || '').toLowerCase().includes('cancel');
