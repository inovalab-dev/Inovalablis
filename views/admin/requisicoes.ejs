<!-- MODAL 1: SELEÇÃO DE PACIENTES (ESTILO COMPACTO LIS INOVALAB)-->
<!-- ========================================================= -->
<div id="modalPatientSearch" class="hidden fixed inset-0 z-50 flex items-center justify-center p-2 sm:p-3 bg-slate-900/70 backdrop-blur-md animate-fadeIn">
  <div class="bg-white rounded-2xl border border-gray-100 w-[85vw] max-w-7xl h-[85vh] shadow-2xl overflow-hidden font-sans flex flex-col">
    
    <!-- Cabeçalho LIS Premium Compacto -->
    <div class="px-4 py-2.5 bg-gradient-to-r from-emerald-950 via-teal-900 to-emerald-900 text-white flex items-center justify-between shrink-0 shadow-md">
      <div class="flex items-center gap-2.5">
        <div class="w-7 h-7 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-400/30 flex items-center justify-center font-black text-sm shadow-inner">
          <svg class="w-4 h-4 text-emerald-300" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h3 class="text-sm font-black text-white tracking-tight">Buscar Paciente</h3>
            <span id="patientModalCountBadge" class="bg-emerald-500/20 text-emerald-200 border border-emerald-400/30 text-[10px] font-mono px-2 py-0.2 rounded-full font-bold">
              0 cadastrados
            </span>
          </div>
        </div>
      </div>
      <button onclick="closePatientSearchModal()" type="button" class="text-emerald-200/80 hover:text-white hover:bg-white/10 p-1 rounded-lg transition-all cursor-pointer" title="Fechar (ESC)">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <!-- Central de Filtros e Busca Compacta -->
    <div class="p-2.5 bg-slate-50/90 border-b border-gray-200/80 shrink-0">
      <div class="flex flex-col sm:flex-row items-center gap-2">
        <!-- Campo de Texto Principal -->
        <div class="relative flex-1 w-full">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-emerald-600">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          </div>
          <input type="text" id="modalFilterQuery" oninput="executePatientFilter()" onkeyup="if(event.key==='Enter') executePatientFilter()" placeholder="Digite nome, CPF, código, data de nascimento (DD/MM/AAAA)..." class="w-full pl-8 pr-16 py-1.5 bg-white border border-gray-200 rounded-xl text-xs font-semibold text-gray-900 focus:ring-2 focus:ring-emerald-500 outline-none transition-all placeholder:text-gray-400">
          <button type="button" onclick="executePatientFilter()" class="absolute right-1 top-1 bottom-1 px-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg font-bold text-xs transition-all cursor-pointer">
            <span>Buscar</span>
          </button>
        </div>

        <!-- Seletor de Campo -->
        <div class="flex items-center gap-2 shrink-0">
          <div class="flex items-center gap-1 bg-white border border-gray-200 rounded-xl px-2 py-1 shadow-2xs">
            <span class="text-[10px] font-bold text-gray-400 font-mono uppercase">Campo:</span>
            <select id="modalFilterField" onchange="executePatientFilter()" class="bg-transparent text-xs font-bold text-gray-700 outline-none cursor-pointer">
              <option value="name">Nome do Paciente</option>
              <option value="cpf">CPF</option>
              <option value="code">Código / Prontuário</option>
              <option value="birthDate">Data de Nascimento</option>
            </select>
          </div>

