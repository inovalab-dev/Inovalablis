<%- include('../partials/header') %>

<div class="p-4 sm:p-6 lg:p-8 max-w-[98vw] xl:max-w-[96vw] mx-auto w-full flex-1">

  <!-- Cabeçalho Principal da Tela (Estilo LIS PEP/Recepção) -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
    <div>
      <div class="flex items-center gap-2 text-xs text-brand-neutral/60 font-mono uppercase tracking-wider mb-1">
        <span>Recepção LIS</span>
        <span>•</span>
        <span class="text-brand-gold font-bold">Solicitações & Protocolos de Exames</span>
      </div>
      <h1 class="text-2xl font-black text-brand-neutralDark flex items-center gap-2">
        <svg class="w-7 h-7 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        Cadastro de Requisições
      </h1>
      <p class="text-xs text-brand-neutral/70 mt-1">
        Histórico e montagem de solicitações de exames. Clique em "Nova Requisição" ou pressione CTRL + N para iniciar a ficha.
      </p>
    </div>

    <div class="flex items-center gap-3">
      <button onclick="startNewRequisition()" class="inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs uppercase tracking-wider rounded-xl shadow-lg shadow-emerald-600/20 transition-all active:scale-95 cursor-pointer" title="Nova Requisição (CTRL + N)">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
        <span>Nova Requisição <span class="font-mono text-[10px] opacity-80">(Ctrl+N)</span></span>
      </button>
    </div>
  </div>

  <!-- Barra de Busca, Filtros e Itens por Página -->
  <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4 mb-6 space-y-3">
    <div class="flex flex-col sm:flex-row items-center gap-3">
      <div class="relative flex-1 w-full">
        <svg class="w-4 h-4 absolute left-3.5 top-3.5 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        <input type="text" id="req-search-input" onkeyup="filterRequisitionsTable()" placeholder="Buscar paciente por nome, código de requisição, CPF, telefone ou convênio..." class="w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-xs font-medium focus:ring-2 focus:ring-emerald-500 focus:bg-white outline-none transition-all">
      </div>
      <select id="itemsPerPageSelect" class="w-full sm:w-36 py-2.5 px-3 bg-gray-50 border border-gray-200 rounded-xl text-xs font-medium text-gray-700 focus:ring-2 focus:ring-emerald-500 outline-none font-mono">
        <option value="20">20 por pág.</option>
        <option value="50" selected>50 por pág.</option>
        <option value="100">100 por pág.</option>
      </select>
    </div>
  </div>

  <!-- Tabela Histórica de Requisições Cadastradas -->
  <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden mb-6">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse" id="requisitions-table">
        <thead>
          <tr class="bg-gray-50/80 border-b border-gray-100 text-[11px] font-bold text-gray-500 uppercase tracking-wider font-mono">
            <th class="py-3.5 px-3 whitespace-nowrap">Cód. Req.</th>
            <th class="py-3.5 px-3 whitespace-nowrap">Data Req.</th>
            <th class="py-3.5 px-3 whitespace-nowrap">Dt. Nasc.</th>
            <th class="py-3.5 px-4 min-w-[220px] md:min-w-[260px]">Paciente / CPF</th>
            <th class="py-3.5 px-3 whitespace-nowrap">Contato</th>
            <th class="py-3.5 px-3 whitespace-nowrap">Convênio</th>
            <th class="py-3.5 px-3 text-center whitespace-nowrap">Status</th>
            <th class="py-3.5 px-4 text-center whitespace-nowrap">Ações</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 text-xs text-gray-700 font-medium">
          <% requisitions.forEach(req => { %>
            <%
              let formattedBirth = req.patientBirthDate || '-';
              if (req.patientBirthDate && req.patientBirthDate.includes('-') && req.patientBirthDate.split('-').length === 3) {
                const [y, m, d] = req.patientBirthDate.split('-');
                if (y.length === 4) {
                  formattedBirth = `${d}/${m}/${y}`;
                }
              }
              let displayCpf = req.patientCpf || '-';
              if (displayCpf === '-' && req.patientCode && typeof patients !== 'undefined') {
                let pFound = patients.find(p => (p.code || p.id) === req.patientCode || p.name === req.patientName);
                if (pFound && pFound.cpf) displayCpf = pFound.cpf;
              }
              let displayPhone = req.patientPhone || req.patientWhatsapp || '-';
              if (displayPhone === '-' && req.patientCode && typeof patients !== 'undefined') {
                let pFound = patients.find(p => (p.code || p.id) === req.patientCode || p.name === req.patientName);
                if (pFound && (pFound.whatsapp || pFound.phone)) displayPhone = pFound.whatsapp || pFound.phone;
              }
              let displayBirth = formattedBirth;
              if (displayBirth === '-' && req.patientCode && typeof patients !== 'undefined') {
                let pFound = patients.find(p => (p.code || p.id) === req.patientCode || p.name === req.patientName);
                if (pFound && pFound.birthDate) {
                  const [y, m, d] = pFound.birthDate.split('-');
                  if (y && m && d) displayBirth = `${d}/${m}/${y}`;
                }
              }

              // Extração de Data e Hora em 2 linhas
              let datePart = req.createdAt || '-';
              let timePart = req.hora || '';
              if (req.createdAt) {
                let raw = req.createdAt;
                if (raw.includes(',')) {
                  const parts = raw.split(',');
                  datePart = parts[0].trim();
                  timePart = parts[1].trim();
                } else if (raw.includes(' ')) {
                  const parts = raw.split(' ');
                  datePart = parts[0].trim();
                  timePart = parts[1].trim();
                }
              }
              if (timePart && timePart.split(':').length === 3) {
                const tParts = timePart.split(':');
                timePart = `${tParts[0]}:${tParts[1]}`;
              }
            %>
            <tr class="hover:bg-emerald-50/40 transition-colors req-row cursor-pointer" onclick="selectRequisitionToForm('<%= req.id %>')" data-name="<%= (req.patientName || '').toLowerCase() %>" data-code="<%= (req.requisitionCode || '').toLowerCase() %>" data-cpf="<%= (displayCpf || '').toLowerCase() %>" data-phone="<%= (displayPhone || '').toLowerCase() %>" data-convenio="<%= (req.convenio || '').toLowerCase() %>" data-status="<%= (req.status || 'A Coletar').toLowerCase() %>">
              
              <!-- 1. Cód. Req. -->
              <td class="py-3.5 px-3 font-mono font-extrabold text-emerald-800 text-xs whitespace-nowrap">
                <span class="bg-emerald-50 text-emerald-900 border border-emerald-200/80 px-2.5 py-1 rounded-lg">
                  #<%= req.requisitionCode || req.id %>
                </span>
              </td>

              <!-- 2. Data Req. (2 linhas: Data e Hora) -->
              <td class="py-3.5 px-3 text-gray-700 font-mono text-xs whitespace-nowrap">
                <div class="flex flex-col">
                  <span class="font-bold text-gray-900 text-xs"><%= datePart %></span>
                  <span class="text-[11px] text-gray-500 font-medium pl-0.5"><%= timePart || '12:00' %></span>
                </div>
              </td>

              <!-- 3. Dt. Nasc. -->
              <td class="py-3.5 px-3 text-gray-700 font-mono text-xs whitespace-nowrap">
                <%= displayBirth %>
              </td>

              <!-- 4. Paciente / CPF (Espaço amplo para Nome Completo) -->
              <td class="py-3.5 px-4 min-w-[220px] md:min-w-[260px]">
                <div class="flex flex-col">
                  <span class="font-mono text-[11px] text-gray-600 font-bold"><%= displayCpf %></span>
                  <span class="font-black text-gray-900 text-xs leading-snug"><%= req.patientName %></span>
                </div>
              </td>

              <!-- 5. Contato -->
              <td class="py-3.5 px-3 text-gray-700 font-mono text-xs whitespace-nowrap">
                <% if (displayPhone && displayPhone !== '-') { %>
                  <span class="text-emerald-700 font-bold inline-flex items-center gap-1">
                    <span>📱</span> <%= displayPhone %>
                  </span>
                <% } else { %>
                  <span class="text-gray-400 font-normal">-</span>
                <% } %>
              </td>

              <!-- 6. Convênio (2 linhas: Código e Nome) -->
              <td class="py-3.5 px-3 whitespace-nowrap">
                <div class="flex flex-col">
                  <span class="font-mono text-[10px] text-gray-500 font-bold"><%= req.convenioCode || '1' %></span>
                  <span class="font-bold text-gray-800 text-xs"><%= req.convenio || 'Particular' %></span>
                </div>
              </td>

              <!-- 7. Status da Requisição -->
              <td class="py-3.5 px-3 text-center whitespace-nowrap" onclick="event.stopPropagation()">
                <%
                  const st = req.status || 'A Coletar';
                  let bgClass = 'bg-amber-100 text-amber-900 border-amber-300';
                  let icon = '🧪';
                  if (st === 'Coletado') {
                    bgClass = 'bg-blue-100 text-blue-900 border-blue-300';
                    icon = '💉';
                  } else if (st === 'Em Análise') {
                    bgClass = 'bg-purple-100 text-purple-900 border-purple-300';
                    icon = '🔬';
                  } else if (st === 'Liberado' || st === 'Pronto' || st === 'Concluído') {
                    bgClass = 'bg-emerald-100 text-emerald-900 border-emerald-300';
                    icon = '✅';
                  } else if (st === 'Entregue') {
                    bgClass = 'bg-teal-100 text-teal-900 border-teal-300';
                    icon = '📦';
                  } else if (st === 'Cancelado') {
                    bgClass = 'bg-rose-100 text-rose-900 border-rose-300';
                    icon = '❌';
                  }
                %>
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-extrabold font-mono border <%= bgClass %> shadow-2xs">
                  <span><%= icon %></span>
                  <span><%= st %></span>
                </span>
              </td>

              <!-- 7. Ações (Editar e Remover) -->
              <td class="py-3.5 px-4 text-center whitespace-nowrap" onclick="event.stopPropagation()">
                <div class="flex items-center justify-center gap-1.5">
                  <button type="button" onclick="selectRequisitionToForm('<%= req.id %>')" class="px-2.5 py-1 bg-amber-50 hover:bg-amber-500 text-amber-700 hover:text-white border border-amber-200/80 rounded-xl font-bold text-[11px] inline-flex items-center gap-1 transition-all cursor-pointer shadow-2xs active:scale-95" title="Editar Requisição">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                    <span>Editar</span>
                  </button>

                  <form action="/admin/requisicoes/delete" method="POST" onsubmit="return confirm('Deseja realmente remover a requisição <%= req.requisitionCode %>?')" class="inline m-0">
                    <input type="hidden" name="id" value="<%= req.id %>">
                    <button type="submit" class="px-2.5 py-1 bg-rose-50 hover:bg-rose-600 text-rose-700 hover:text-white border border-rose-200/80 rounded-xl font-bold text-[11px] inline-flex items-center gap-1 transition-all cursor-pointer shadow-2xs active:scale-95" title="Remover Requisição">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                      <span>Remover</span>
                    </button>
                  </form>
                </div>
              </td>

            </tr>
          <% }) %>

          <% if (requisitions.length === 0) { %>
            <tr>
              <td colspan="7" class="text-center py-10 text-gray-400 italic">
                Nenhuma requisição cadastrada no sistema.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Controles de Paginação -->
    <div class="p-4 bg-gray-50/50 border-t border-gray-100 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-gray-500 font-mono">
      <div id="paginationInfo">
        Exibindo <%= requisitions.length > 0 ? `1 - ${requisitions.length} de ${requisitions.length}` : '0 - 0 de 0' %> requisições registradas
      </div>
      <div class="flex items-center gap-1.5" id="paginationControls">
        <button class="px-3 py-1.5 rounded-lg border border-gray-200 bg-white text-gray-400 cursor-not-allowed text-xs font-bold" disabled>&lt; Anterior</button>
        <button class="px-3 py-1.5 rounded-lg border border-emerald-500 bg-emerald-600 text-white text-xs font-bold">1</button>
        <button class="px-3 py-1.5 rounded-lg border border-gray-200 bg-white text-gray-400 cursor-not-allowed text-xs font-bold" disabled>Próximo &gt;</button>
      </div>
    </div>
  </div>

</div>

<!-- ========================================================= -->
<!-- MODAL DE POPUP COMPLETO - CADASTRO DE REQUISIÇÃO (LIS)    -->
<!-- ========================================================= -->
<div id="requisitionFormModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-2 sm:p-4 md:p-6 bg-black/75 backdrop-blur-sm overflow-hidden">
  <div class="bg-white rounded-2xl border border-gray-300 w-full max-w-7xl max-h-[94vh] shadow-2xl overflow-hidden flex flex-col my-auto">
    
    <!-- Cabeçalho do Modal LIS com Stepper de Abas -->
    <div class="bg-gradient-to-r from-gray-50 via-gray-100 to-gray-50 px-6 py-3.5 border-b border-gray-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 shrink-0">
      <div class="flex items-center gap-3">
        <div class="p-2 bg-emerald-600 text-white rounded-xl shadow-md">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        </div>
        <div>
          <h2 class="text-lg font-black text-gray-900 tracking-tight" id="requisitionModalTitle">Cadastro e Montagem de Requisição</h2>
          <p class="text-xs text-gray-500 font-mono">Formulário Unificado LIS - InovaLab Prontuário Eletrônico</p>
        </div>
      </div>

      <!-- BOTÕES DE ABAS / STEPPER DO MODAL -->
      <div class="flex items-center gap-1.5 bg-gray-200/80 p-1 rounded-2xl border border-gray-300/60 shadow-inner">
        <button type="button" onclick="switchRequisitionStep(1)" id="stepTabBtn1" class="px-3.5 py-1.5 rounded-xl text-xs font-black transition-all flex items-center gap-2 bg-white text-emerald-950 shadow-xs cursor-pointer">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>1. Paciente & Dados Clínicos</span>
        </button>
        <button type="button" onclick="switchRequisitionStep(2)" id="stepTabBtn2" class="px-3.5 py-1.5 rounded-xl text-xs font-black transition-all flex items-center gap-2 text-gray-600 hover:text-gray-900 cursor-pointer">
          <span class="w-2 h-2 rounded-full bg-gray-400"></span>
          <span>2. Lançamento de Exames</span>
          <span id="stepTabExamsBadge" class="bg-emerald-100 text-emerald-900 text-[10px] font-mono px-2 py-0.5 rounded-full font-extrabold border border-emerald-300/80">
            0 exames (R$ 0,00)
          </span>
        </button>
      </div>

      <button onclick="closeRequisitionFormModal()" type="button" class="text-gray-400 hover:text-gray-700 p-2 hover:bg-gray-200 rounded-xl transition-colors cursor-pointer" title="Fechar (ESC)">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <!-- Conteúdo do Formulário -->
    <form id="requisitionMainForm" action="/admin/requisicoes/add" method="POST" onsubmit="return handleFormSubmit(event)" class="flex-1 overflow-y-auto p-4 sm:p-6 text-xs">
      <input type="hidden" name="id" id="req-id" value="">
      <input type="hidden" name="examsJson" id="req-examsJson" value="[]">
      <input type="hidden" name="subtotal" id="req-subtotalInput" value="0.00">
      <input type="hidden" name="totalAmount" id="req-totalAmountInput" value="0.00">

      <!-- ========================================================= -->
      <!-- ETAPA 1: DADOS DO PACIENTE & PARÂMETROS CLÍNICOS          -->
      <!-- ========================================================= -->
      <div id="requisitionStep1" class="space-y-4">

      <!-- CARD 1: Código da Requisição -->
      <div id="requisitionCodeCard" class="bg-gray-50/80 p-3.5 sm:p-4 rounded-2xl border border-gray-200 shadow-2xs flex items-center justify-between gap-3">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block shadow-sm"></span>
          <h3 class="text-xs font-black text-gray-800 uppercase tracking-wider">Identificador da Requisição</h3>
        </div>
        
        <div class="flex items-center gap-2">
          <label class="font-bold text-gray-700 text-xs shrink-0 font-mono">Nº Requisição:</label>
          <div class="relative flex items-center">
            <input type="text" name="requisitionCode" id="req-requisitionCode" value="<%= nextReqCode %>" class="w-32 pl-3 pr-8 py-1.5 bg-white border border-gray-200 rounded-xl text-xs font-mono font-extrabold text-emerald-800 outline-none focus:ring-2 focus:ring-emerald-500 shadow-2xs">
            <button type="button" onclick="openSearchModal('req')" class="absolute right-1 w-6 h-6 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-600 border border-emerald-200/80 flex items-center justify-center transition-all cursor-pointer shadow-2xs" title="Buscar requisições anteriores">
              <svg class="w-3.5 h-3.5 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            </button>
          </div>
        </div>
      </div>

      <!-- CARD 2: DADOS DO PACIENTE (Importados do Cadastro de Clientes - Somente Leitura em Texto com Collapse Fechado) -->
      <div class="bg-white p-3.5 sm:p-4 rounded-2xl border border-slate-200/90 shadow-2xs space-y-2.5">
        
        <div class="flex items-center justify-between pb-2 border-b border-slate-100 flex-wrap gap-2">
          <div class="flex items-center gap-2.5">
            <div class="w-7 h-7 rounded-xl bg-emerald-50 text-emerald-700 border border-emerald-200/80 flex items-center justify-center font-black text-xs">
              👤
            </div>
            <div>
              <h3 class="text-xs font-black text-slate-800 uppercase tracking-wider">Dados do Paciente</h3>
              <p class="text-[10px] text-slate-500 font-mono">Informações registradas no Cadastro de Clientes</p>
            </div>
          </div>
          <button type="button" onclick="openPatientSearchModal()" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl font-bold text-xs shadow-xs shadow-emerald-600/20 transition-all flex items-center gap-1.5 cursor-pointer active:scale-95">
            <svg class="w-3.5 h-3.5 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            <span>Pesquisar / Selecionar Paciente</span>
          </button>
        </div>

        <!-- Campos ocultos para submissão via POST no formulário -->
        <input type="hidden" name="patientCode" id="req-patientCode" value="">
        <input type="hidden" name="patientName" id="req-patientName" value="" required>
        <input type="hidden" name="patientBirthDate" id="req-patientBirthDate" value="">
        <input type="hidden" name="patientAge" id="req-patientAge" value="">
        <input type="hidden" name="patientSex" id="req-patientSex" value="">
        <input type="hidden" name="address" id="req-address" value="">
        <input type="hidden" name="complement" id="req-complement" value="">
        <input type="hidden" name="city" id="req-city" value="Cambará">
        <input type="hidden" name="cep" id="req-cep" value="">
        <input type="hidden" name="patientPhone" id="req-patientPhone" value="">
        <input type="hidden" name="responsibleName" id="req-responsibleName" value="">

        <!-- CARD INTERATIVO DE EXIBIÇÃO DO PACIENTE (COMPACTO / COLLAPSE) -->
        <div id="patientCardDisplay" class="bg-slate-50/80 rounded-2xl p-3 border border-slate-200/90 text-slate-800 transition-all">
          
          <!-- ESTADO 1: Nenhum paciente associado ainda -->
          <div id="patientCardEmptyState" class="flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left py-1">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-xl bg-amber-50 text-amber-700 border border-amber-200/80 flex items-center justify-center font-bold text-sm shrink-0">
                ⚠️
              </div>
              <div>
                <h4 class="font-black text-slate-800 text-xs">Nenhum Paciente Selecionado</h4>
                <p class="text-[11px] text-slate-500">Selecione um paciente cadastrado para vincular a esta requisição.</p>
              </div>
            </div>
            <button type="button" onclick="openPatientSearchModal()" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl text-xs transition-all cursor-pointer shadow-2xs shrink-0 flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
              <span>Localizar Paciente</span>
            </button>
          </div>

          <!-- ESTADO 2: Exibição Compacta com Dados do Paciente e Collapse Fechado -->
          <div id="patientCardActiveState" class="hidden space-y-2">
            
            <!-- Linha Resumo Única: Avatar, Nome, Cód, CPF, Nascimento, Sexo e Botões de Ação -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div class="flex items-center gap-2.5 min-w-0">
                <div id="displayPatientAvatar" class="w-8 h-8 rounded-xl bg-gradient-to-br from-emerald-600 to-teal-700 text-white font-black text-xs flex items-center justify-center shrink-0 shadow-2xs uppercase tracking-wider">
                  --
                </div>
                <div class="min-w-0">
                  <div class="flex items-center gap-2 flex-wrap">
                    <h4 id="displayPatientName" class="font-black text-slate-900 text-xs tracking-tight truncate">Nome do Paciente</h4>
                    <span id="displayPatientCodeBadge" class="bg-emerald-100/80 text-emerald-900 border border-emerald-200 font-mono font-black text-[10px] px-2 py-0.5 rounded-lg shrink-0">
                      Cód: --
                    </span>
                  </div>
                  <div class="flex items-center gap-2 mt-0.5 text-[11px] text-slate-600 font-medium flex-wrap">
                    <span id="displayPatientCpf" class="font-mono text-slate-700 font-semibold">CPF: --</span>
                    <span class="text-slate-300">•</span>
                    <span id="displayPatientSex" class="font-bold text-slate-700">Sexo: --</span>
                    <span class="text-slate-300">•</span>
                    <span class="text-slate-700 font-semibold">🎂 <span id="displayPatientBirth">--</span> (<span id="displayPatientAge" class="font-bold text-emerald-800">--</span>)</span>
                  </div>
                </div>
              </div>

              <!-- Botões de Ação no Card: Trocar Paciente & Expandir/Recolher Detalhes -->
              <div class="flex items-center gap-1.5 self-end sm:self-auto shrink-0">
                <button type="button" onclick="openPatientSearchModal()" class="px-2.5 py-1 bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 rounded-xl font-bold text-[11px] transition-all cursor-pointer flex items-center gap-1 shadow-2xs">
                  <svg class="w-3 h-3 text-emerald-600 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                  <span>Trocar Paciente</span>
                </button>
                <button type="button" onclick="togglePatientDetailsCollapse()" class="px-2.5 py-1 bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200/80 rounded-xl font-bold text-[11px] transition-all cursor-pointer flex items-center gap-1 shadow-2xs">
                  <span id="togglePatientDetailsBtnText">Mais detalhes</span>
                  <span id="togglePatientDetailsBtnIcon" class="text-[10px]">▼</span>
                </button>
              </div>
            </div>

            <!-- Painel Colapsável de Detalhes Adicionais (Inicia FECHADO / HIDDEN) -->
            <div id="patientDetailsCollapse" class="hidden pt-2 border-t border-slate-200/80 animate-fadeIn">
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 text-xs">
                <div class="bg-white rounded-xl p-2 border border-slate-200/80 shadow-2xs">
                  <span class="text-[10px] font-mono font-bold text-slate-500 uppercase block tracking-wider">📍 Endereço Residencial</span>
                  <p id="displayPatientAddress" class="font-semibold text-slate-800 text-[11px] mt-0.5 truncate">--</p>
                </div>

                <div class="bg-white rounded-xl p-2 border border-slate-200/80 shadow-2xs">
                  <span class="text-[10px] font-mono font-bold text-slate-500 uppercase block tracking-wider">📱 Contato / WhatsApp</span>
                  <p id="displayPatientPhone" class="font-mono font-bold text-emerald-700 text-[11px] mt-0.5">--</p>
                </div>

                <div class="bg-white rounded-xl p-2 border border-slate-200/80 shadow-2xs">
                  <span class="text-[10px] font-mono font-bold text-slate-500 uppercase block tracking-wider">👥 Responsável / Mãe</span>
                  <p id="displayPatientResp" class="font-semibold text-slate-800 text-[11px] mt-0.5 truncate">--</p>
                </div>
              </div>
            </div>

          </div>

        </div>

      </div>

      <!-- CARD 3: Parâmetros Clínicos da Requisição -->
      <div class="bg-slate-100/70 p-4 sm:p-5 rounded-2xl border border-slate-200 shadow-xs space-y-4">
        
        <div class="flex items-center justify-between pb-2.5 border-b border-slate-200">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-emerald-600 inline-block shadow-sm"></span>
            <h3 class="text-xs font-black text-slate-800 uppercase tracking-wider">Parâmetros Clínicos & Fisiológicos</h3>
          </div>
          <span class="text-[11px] text-slate-500 font-semibold bg-white px-2.5 py-1 rounded-full border border-slate-200 shadow-2xs">4 Sub-Módulos Clínicos</span>
        </div>

        <!-- GRID DE CARDS CLÍNICOS (2 COLUNAS EM TELAS GRANDES) -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">

          <!-- CARD 1: CONVÊNIO, GUIA & FATURAMENTO -->
          <div class="bg-white p-4 rounded-xl border border-slate-200/90 shadow-2xs space-y-3 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between pb-2 border-b border-slate-100 mb-3">
                <div class="flex items-center gap-1.5 font-black text-xs text-emerald-800 uppercase tracking-wide">
                  <span>💳</span>
                  <span>1. Convênio, Guia & Faturamento</span>
                </div>
                <span class="text-[10px] font-bold text-slate-400 uppercase">Faturamento</span>
              </div>

              <div class="space-y-2.5">
                <!-- Convênio e Situação -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                  <div>
                    <label class="block font-bold text-[11px] text-slate-600 mb-0.5">Convênio <span class="text-rose-500">*</span>:</label>
                    <div class="flex items-center gap-1">
                      <input type="hidden" name="convenioId" id="req-convenioId" value="">
                      <input type="text" name="convenioCode" id="req-convenioCode" placeholder="Cód" class="w-12 px-1 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs font-mono text-center outline-none">
                      <div class="relative flex-1 flex items-center">
                        <select name="convenio" id="req-convenio" required class="w-full pl-2 pr-8 py-1.5 bg-slate-50/80 border border-slate-200 rounded-lg text-xs font-bold outline-none focus:bg-white focus:ring-2 focus:ring-emerald-500 text-slate-800">
                          <option value="">-- Selecione o Convênio * --</option>
                          <% if (locals.convenios && locals.convenios.length > 0) { %>
                            <% locals.convenios.forEach(function(conv) { %>
                              <option value="<%= conv.fantasia || conv.razaoSocial %>" data-code="<%= conv.codigo || '' %>" data-id="<%= conv.id || '' %>">
                                <%= conv.fantasia || conv.razaoSocial %>
                              </option>
                            <% }); %>
                          <% } else { %>
                            <option value="" disabled>(Nenhum convênio cadastrado)</option>
                          <% } %>
                        </select>
                        <button type="button" onclick="openSearchModal('convenio')" class="absolute right-1 w-6 h-6 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-600 border border-emerald-200/80 flex items-center justify-center transition-all cursor-pointer shadow-2xs" title="Pesquisar Convênio">
                          <svg class="w-3.5 h-3.5 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                        </button>
                      </div>
                    </div>
                  </div>

                  <div>
                    <label class="block font-bold text-[11px] text-slate-600 mb-0.5">Situação:</label>
                    <div class="flex items-center gap-1">
                      <input type="text" name="situacaoCode" id="req-situacaoCode" placeholder="Cód" class="w-12 px-1 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs font-mono text-center outline-none">
                      <div class="relative flex-1 flex items-center">
                        <select name="situacao" id="req-situacao" class="w-full pl-2 pr-8 py-1.5 bg-slate-50/80 border border-slate-200 rounded-lg text-xs outline-none focus:bg-white focus:ring-2 focus:ring-emerald-500">
                          <option value="Normal">Normal</option>
                          <option value="Urgente">Urgente</option>
                          <option value="Prioritário">Prioritário</option>
                          <option value="Aguardando Coleta">Aguardando Coleta</option>
                        </select>
                        <button type="button" onclick="openSearchModal('situacao')" class="absolute right-1 w-6 h-6 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-600 border border-emerald-200/80 flex items-center justify-center transition-all cursor-pointer shadow-2xs" title="Pesquisar Situação">
                          <svg class="w-3.5 h-3.5 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                        </button>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Matrícula & Guia -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                  <div>
                    <label class="block font-bold text-[11px] text-slate-600 mb-0.5">Matrícula / Carteirinha:</label>
                    <input type="text" name="matricula" id="req-matricula" placeholder="Nº da carteirinha" class="w-full px-2.5 py-1.5 bg-slate-50/80 border border-slate-200 rounded-lg text-xs outline-none focus:bg-white focus:ring-2 focus:ring-emerald-500">
                  </div>
                  <div>
                    <label class="block font-bold text-[11px] text-slate-600 mb-0.5">Nº Guia de Autorização:</label>
                    <input type="text" name="guia" id="req-guia" placeholder="Número da guia" class="w-full px-2.5 py-1.5 bg-slate-50/80 border border-slate-200 rounded-lg text-xs outline-none focus:bg-white focus:ring-2 focus:ring-emerald-500">
                  </div>
                </div>

                <!-- Empresa Parceira -->
                <div>
                  <label class="block font-bold text-[11px] text-slate-600 mb-0.5">Empresa Parceira / Faturamento:</label>
                  <div class="relative flex items-center">
                    <input type="text" name="empresa" id="req-empresa" placeholder="Empresa parceira / faturamento" class="w-full pl-2.5 pr-8 py-1.5 bg-slate-50/80 border border-slate-200 rounded-lg text-xs outline-none focus:bg-white focus:ring-2 focus:ring-emerald-500">
                    <button type="button" onclick="openSearchModal('empresa')" class="absolute right-1 w-6 h-6 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-600 border border-emerald-200/80 flex items-center justify-center transition-all cursor-pointer shadow-2xs" title="Pesquisar Empresa">
                      <svg class="w-3.5 h-3.5 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- CARD 2: POSTO, TRIAGEM & DESTINO -->
          <div class="bg-white p-4 rounded-xl border border-slate-200/90 shadow-2xs space-y-3 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between pb-2 border-b border-slate-100 mb-3">
                <div class="flex items-center gap-1.5 font-black text-xs text-emerald-800 uppercase tracking-wide">
                  <span>🧪</span>
                  <span>2. Posto de Coleta, Triagem & Destino</span>
                </div>
                <span class="text-[10px] font-bold text-slate-400 uppercase">Logística Técnica</span>
              </div>

              <div class="space-y-2.5">
                <!-- Coleta & Cartão SUS -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                  <div>
                    <label class="block font-bold text-[11px] text-slate-600 mb-0.5">Posto / Local de Coleta:</label>
                    <div class="relative flex items-center">
                      <input type="text" name="coleta" id="req-coleta" value="Sede / Central" placeholder="Posto de Coleta" class="w-full pl-2.5 pr-8 py-1.5 bg-slate-50/80 border border-slate-200 rounded-lg text-xs outline-none focus:bg-white focus:ring-2 focus:ring-emerald-500">
                      <button type="button" onclick="openSearchModal('coleta')" class="absolute right-1 w-6 h-6 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-600 border border-emerald-200/80 flex items-center justify-center transition-all cursor-pointer shadow-2xs" title="Pesquisar Posto de Coleta">
                        <svg class="w-3.5 h-3.5 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                      </button>
                    </div>
                  </div>

                  <div>
                    <label class="block font-bold text-[11px] text-slate-600 mb-0.5">Cartão SUS:</label>
                    <div class="flex items-center gap-1">
                      <input type="text" name="susCard" id="req-susCard" placeholder="000 0000 0000 0000" class="flex-1 px-2 py-1.5 bg-slate-50/80 border border-slate-200 rounded-lg text-xs font-mono outline-none focus:bg-white focus:ring-2 focus:ring-emerald-500">
                      <button type="button" onclick="useCpfForSus()" class="px-2 py-1.5 bg-slate-100 hover:bg-slate-200 border border-slate-200 rounded-lg font-bold text-[10px] shrink-0 cursor-pointer">Usar CPF</button>
                    </div>
                  </div>
                </div>

                <!-- Destino & Horário -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 items-end">
                  <div class="sm:col-span-2">
                    <label class="block font-bold text-[11px] text-slate-600 mb-0.5">Destino / Lab. Apoio:</label>
                    <div class="relative flex items-center">
                      <input type="text" name="destino" id="req-destino" value="Laboratório Principal" placeholder="Laboratório de Apoio" class="w-full pl-2.5 pr-8 py-1.5 bg-slate-50/80 border border-slate-200 rounded-lg text-xs outline-none focus:bg-white focus:ring-2 focus:ring-emerald-500">
                      <button type="button" onclick="openSearchModal('destino')" class="absolute right-1 w-6 h-6 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-600 border border-emerald-200/80 flex items-center justify-center transition-all cursor-pointer shadow-2xs" title="Pesquisar Destino">
                        <svg class="w-3.5 h-3.5 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                      </button>
                    </div>
                  </div>

                  <div>
                    <label class="block font-bold text-[11px] text-slate-600 mb-0.5">Data Fatura:</label>
                    <div class="relative flex items-center">
                      <input type="text" name="fatura" id="req-fatura" value="<%= new Date().toLocaleDateString('pt-BR') %>" class="w-full pl-2 pr-7 py-1.5 bg-slate-50/80 border border-slate-200 rounded-lg text-xs outline-none focus:bg-white focus:ring-2 focus:ring-emerald-500">
                      <button type="button" onclick="openSearchModal('fatura')" class="absolute right-1 w-6 h-6 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-600 border border-emerald-200/80 flex items-center justify-center transition-all cursor-pointer shadow-2xs" title="Pesquisar Fatura">
                        <svg class="w-3.5 h-3.5 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                      </button>
                    </div>
                  </div>
                </div>

                <!-- Hora & Flag Urgente -->
                <div class="flex items-center justify-between gap-2 pt-1">
                  <div class="flex items-center gap-1.5">
                    <label class="font-bold text-[11px] text-slate-600">Hora Entrada:</label>
                    <input type="time" name="hora" id="req-hora" value="<%= new Date().toLocaleTimeString('pt-BR', { timeZone: 'America/Sao_Paulo', hour: '2-digit', minute: '2-digit' }) %>" class="w-24 px-2 py-1 bg-slate-50/80 border border-slate-200 rounded-lg text-xs font-mono outline-none focus:bg-white focus:ring-2 focus:ring-emerald-500">
                  </div>

                  <label class="inline-flex items-center gap-2 cursor-pointer font-bold text-xs text-rose-700 bg-rose-50 hover:bg-rose-100/80 px-3 py-1.5 rounded-lg border border-rose-200 transition-colors">
                    <input type="checkbox" name="isUrgent" id="req-isUrgent" class="w-4 h-4 rounded border-rose-300 text-rose-600 focus:ring-rose-500">
                    <span>🚨 Urgência Médica</span>
                  </label>
                </div>
              </div>
            </div>
          </div>

          <!-- CARD 3: MÉDICO SOLICITANTE & OBSERVAÇÕES -->
          <div class="bg-white p-4 rounded-xl border border-slate-200/90 shadow-2xs space-y-3 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between pb-2 border-b border-slate-100 mb-3">
                <div class="flex items-center gap-1.5 font-black text-xs text-emerald-800 uppercase tracking-wide">
                  <span>👨‍⚕️</span>
                  <span>3. Médico Solicitante & Observações</span>
                </div>
                <span class="text-[10px] font-bold text-slate-400 uppercase">Prescritor</span>
              </div>

              <div class="space-y-2.5">
                <!-- Médico Solicitante completo -->
                <div>
                  <label class="block font-bold text-[11px] text-slate-700 mb-0.5">Médico Solicitante <span class="text-rose-600 font-extrabold">*</span>:</label>
                  <div class="flex items-center gap-1">
                    <select name="doctorCrmType" id="req-doctorCrmType" class="px-1.5 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs font-bold outline-none focus:bg-white focus:ring-1 focus:ring-emerald-500">
                      <% 
                        const conselhosReq = [
                          'CRM', 'CRV', 'CRN', 'CRO', 'CRF', 'CRQ', 'CRAS', 'COREN', 
                          'CRP', 'CRFA', 'CRBM', 'CRBIO', 'CRFITO', 'RMS', 'CRT', 'CRMV', 
                          'ABQ', 'CREF', 'CRTR', 'CRTH'
                        ];
                      %>
                      <% conselhosReq.forEach(c => { %>
                        <option value="<%= c %>"><%= c %></option>
                      <% }) %>
                    </select>
                    <input type="text" name="doctorCrm" id="req-doctorCrm" placeholder="000000" class="w-20 px-2 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs font-mono outline-none focus:bg-white focus:ring-1 focus:ring-emerald-500">
                    <select name="doctorUf" id="req-doctorUf" class="px-1.5 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs font-mono font-bold outline-none focus:bg-white focus:ring-1 focus:ring-emerald-500">
                      <% 
                        const ufsReq = [
                          'AC', 'AL', 'AP', 'AM', 'BA', 'CE', 'DF', 'ES', 'GO', 'MA', 
                          'MT', 'MS', 'MG', 'PA', 'PB', 'PR', 'PE', 'PI', 'RJ', 'RN', 
                          'RS', 'RO', 'RR', 'SC', 'SP', 'SE', 'TO'
                        ];
                      %>
                      <% ufsReq.forEach(uf => { %>
                        <option value="<%= uf %>" <%= uf === 'PR' ? 'selected' : '' %>><%= uf %></option>
                      <% }) %>
                    </select>
                    <div class="relative flex-1 flex items-center">
                      <input type="text" name="doctorName" id="req-doctorName" list="medicosDatalist" placeholder="Nome do Médico Solicitante *" required class="w-full pl-2.5 pr-8 py-1.5 bg-slate-50/80 border border-slate-200 rounded-lg text-xs font-bold text-slate-800 outline-none focus:bg-white focus:ring-2 focus:ring-emerald-500 transition-all">
                      <datalist id="medicosDatalist">
                        <% if (locals.medicos && locals.medicos.length > 0) { %>
                          <% locals.medicos.forEach(m => { %>
                            <option value="<%= m.nome %>"><%= m.conselho || 'CRM' %> <%= m.numero %>/<%= m.uf || 'PR' %> - <%= m.nome %></option>
                          <% }) %>
                        <% } %>
                      </datalist>
                      <button type="button" onclick="openSearchModal('medico')" class="absolute right-1 w-6 h-6 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-600 border border-emerald-200/80 flex items-center justify-center transition-all cursor-pointer shadow-2xs" title="Buscar Médico no Cadastro">
                        <svg class="w-3.5 h-3.5 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                      </button>
                    </div>
                  </div>
                </div>

                <!-- Observações -->
                <div>
                  <label class="block font-bold text-[11px] text-slate-600 mb-0.5">Observações Adicionais:</label>
                  <textarea name="obs" id="req-obs" rows="2" placeholder="Observações específicas para esta requisição..." class="w-full px-2.5 py-1.5 bg-slate-50/80 border border-slate-200 rounded-lg text-xs outline-none focus:bg-white focus:ring-2 focus:ring-emerald-500 resize-none"></textarea>
                </div>
              </div>
            </div>
          </div>

          <!-- CARD 4: CONDIÇÕES FISIOLÓGICAS & BIOMETRIA -->
          <div class="bg-white p-4 rounded-xl border border-slate-200/90 shadow-2xs space-y-3 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between pb-2 border-b border-slate-100 mb-3">
                <div class="flex items-center gap-1.5 font-black text-xs text-emerald-800 uppercase tracking-wide">
                  <span>🩺</span>
                  <span>4. Condições Fisiológicas & Biometria</span>
                </div>
                <span class="text-[10px] font-bold text-slate-400 uppercase">Perfil Fisiológico</span>
              </div>

              <!-- Pílulas de Checkboxes de Condição Especial -->
              <div class="flex flex-wrap items-center gap-2 mb-3 bg-emerald-50/50 p-2.5 rounded-xl border border-emerald-100/80">
                <label class="inline-flex items-center gap-1.5 cursor-pointer font-bold text-xs text-slate-800 bg-white px-2.5 py-1 rounded-lg border border-slate-200 hover:border-emerald-400 transition-colors">
                  <input type="checkbox" name="isPregnant" id="req-isPregnant" class="w-3.5 h-3.5 rounded border-gray-300 text-emerald-600 focus:ring-emerald-500 cursor-pointer">
                  <span>Gestante</span>
                </label>

                <div class="inline-flex items-center gap-1 bg-white px-2 py-0.5 rounded-lg border border-slate-200 text-xs">
                  <span class="font-bold text-slate-600">Período:</span>
                  <input type="text" name="gestationalPeriod" id="req-gestationalPeriod" placeholder="0" class="w-9 px-1 py-0.5 bg-slate-50 border border-slate-300 rounded text-center text-xs font-bold outline-none focus:bg-white focus:ring-1 focus:ring-emerald-500">
                  <span class="text-slate-500 font-medium">sem.</span>
                </div>

                <label class="inline-flex items-center gap-1.5 cursor-pointer font-bold text-xs text-slate-800 bg-white px-2.5 py-1 rounded-lg border border-slate-200 hover:border-emerald-400 transition-colors">
                  <input type="checkbox" name="isNeonate" id="req-isNeonate" class="w-3.5 h-3.5 rounded border-gray-300 text-emerald-600 focus:ring-emerald-500 cursor-pointer">
                  <span>Neonato</span>
                </label>

