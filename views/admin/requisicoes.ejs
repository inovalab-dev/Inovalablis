          <input type="text" id="genericSearchInput" onkeyup="filterGenericList()" placeholder="Digite para filtrar em tempo real..." class="w-full pl-10 pr-8 py-2 bg-white border border-slate-200 rounded-xl text-xs outline-none focus:ring-2 focus:ring-emerald-500 font-medium text-slate-800">
