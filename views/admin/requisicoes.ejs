  function filterPatientsDropdown(val) {
    const dropdown = document.getElementById('patientAutocompleteList');
    const q = val.toLowerCase().trim();
    const qDigits = q.replace(/\D/g, '');

    if (!q || q.length < 2) {
      dropdown.classList.add('hidden');
      return;
    }

    const matches = patientsList.filter(p => {
      const pCpf = (p.cpf || '').toLowerCase();
      const pCpfDigits = pCpf.replace(/\D/g, '');
      return (p.name || '').toLowerCase().includes(q) || 
        pCpf.includes(q) ||
        (qDigits.length >= 3 && pCpfDigits.includes(qDigits)) ||
        (p.code || p.id || '').toLowerCase().includes(q);
    }).slice(0, 8);

    if (matches.length === 0) {
      dropdown.classList.add('hidden');
      return;
    }

    dropdown.innerHTML = '';
    matches.forEach(p => {
      const div = document.createElement('div');
      div.className = "px-3 py-2 hover:bg-emerald-50 cursor-pointer border-b border-gray-100 flex justify-between items-center text-xs";
