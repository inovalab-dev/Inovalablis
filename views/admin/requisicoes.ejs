    if (modal) modal.classList.add('hidden');
  }

  // Iniciar Nova Requisição (Limpar e Abrir Modal da Requisição e de Pacientes)
  function startNewRequisition() {
    setFormReadOnlyMode(false);
    document.getElementById('requisitionMainForm').reset();
    document.getElementById('req-id').value = '';
    currentRequisitionExams = [];
    currentRequisitionPayments = [];
    switchRequisitionStep(1);
    renderExamsTable();
    renderRequisitionPaymentsTable();
    calcFinancials();
    
    // Esconder o Card de Identificador da Requisição no cadastro de nova requisição
    const reqCodeCard = document.getElementById('requisitionCodeCard');
    if (reqCodeCard) reqCodeCard.classList.add('hidden');
    const pdfBtn = document.getElementById('req-modal-view-pdf-btn');
    if (pdfBtn) pdfBtn.classList.add('hidden');
    document.getElementById('req-requisitionCode').value = '';

    document.getElementById('req-city').value = 'Cambará';
    if (document.getElementById('req-convenio')) document.getElementById('req-convenio').value = '';
    if (document.getElementById('req-convenioCode')) document.getElementById('req-convenioCode').value = '';
    if (document.getElementById('req-convenioId')) document.getElementById('req-convenioId').value = '';
    document.getElementById('req-coleta').value = 'Sede / Central';
    document.getElementById('req-destino').value = 'Laboratório Principal';
    document.getElementById('req-fatura').value = new Date().toLocaleDateString('pt-BR');
    document.getElementById('req-hora').value = new Date().toLocaleTimeString('pt-BR', { timeZone: 'America/Sao_Paulo', hour: '2-digit', minute: '2-digit' });
    if (document.getElementById('req-status')) document.getElementById('req-status').value = 'Em Andamento';
    if (document.getElementById('req-fastingHours')) document.getElementById('req-fastingHours').value = '';
    if (document.getElementById('req-deliveryDays')) {
      document.getElementById('req-deliveryDays').value = '2';
      onDeliveryDaysInput();
    }

    // Reset do desconto, multiguias e modo R$ / %
    const chkMG = document.getElementById('req-isMultiguia');
    if (chkMG) chkMG.checked = false;
    toggleMultiguiaMode();

    const fatInput = document.getElementById('req-faturadoValInput');
    if (fatInput) {
      fatInput.value = '0.00';
      delete fatInput.dataset.userTouched;
    }
