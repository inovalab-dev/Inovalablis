  function onDiscountInputChange(callerSource) {
    let subtotal = 0;
    (currentRequisitionExams || []).forEach(e => {
      subtotal += parseFloat(e.price) || 0;
    });

    const valInput = document.getElementById('req-discountValInput');
    const valInputStep3 = document.getElementById('req-discountValInputStep3');
    const hiddenDisc = document.getElementById('req-discount');
    const hiddenDiscPct = document.getElementById('req-discountPercent');

    let activeInput = valInput;
    if (callerSource === 'step3' && valInputStep3) {
      activeInput = valInputStep3;
    } else if (!valInput && valInputStep3) {
      activeInput = valInputStep3;
    }

    let rawVal = activeInput ? (parseFloat(activeInput.value) || 0) : 0;
    if (rawVal < 0) rawVal = 0;

    if (currentDiscountMode === 'currency') {
      let discountVal = rawVal;
      let pctVal = subtotal > 0 ? (discountVal / subtotal) * 100 : 0;

      if (hiddenDisc) hiddenDisc.value = discountVal.toFixed(2);
      if (hiddenDiscPct) hiddenDiscPct.value = pctVal.toFixed(1);

      if (callerSource === 'step3' && valInput) {
        valInput.value = discountVal.toFixed(2);
      } else if (callerSource !== 'step3' && valInputStep3) {
        valInputStep3.value = discountVal.toFixed(2);
      }
    } else { // percent
      let pctVal = rawVal;
      if (pctVal > 100) {
        pctVal = 100;
        if (activeInput) activeInput.value = '100';
      }
      let discountVal = (subtotal * pctVal) / 100;

      if (hiddenDisc) hiddenDisc.value = discountVal.toFixed(2);
      if (hiddenDiscPct) hiddenDiscPct.value = pctVal.toFixed(1);

      if (callerSource === 'step3' && valInput) {
        valInput.value = pctVal.toString();
      } else if (callerSource !== 'step3' && valInputStep3) {
        valInputStep3.value = pctVal.toString();
      }
    }

    calcFinancials();
  }

