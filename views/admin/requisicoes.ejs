  function fillRemainingPayAmount() {
    const subtotal = (currentRequisitionExams || []).reduce((acc, e) => acc + (parseFloat(e.price) || 0), 0);
    const hiddenDisc = document.getElementById('req-discount');
    const discount = hiddenDisc ? (parseFloat(hiddenDisc.value) || 0) : 0;
    let total = subtotal - discount;
    if (total < 0) total = 0;

    const fatInput = document.getElementById('req-faturadoValInput');
    const fatVal = fatInput ? (parseFloat(fatInput.value) || 0) : 0;
    const balcaoDevido = Math.max(0, total - fatVal);

    const currentPaid = (currentRequisitionPayments || []).reduce((acc, p) => acc + (parseFloat(p.amount) || 0), 0);
    const remaining = balcaoDevido - currentPaid;

    const amountInput = document.getElementById('reqPayAmountInput');
    if (amountInput) {
      amountInput.value = remaining > 0 ? remaining.toFixed(2) : '0.00';
    }
  }

