<!-- MODAL 2: CADASTRO COMPLETO DE PACIENTES VIA POPUP         -->
<!-- ========================================================= -->
<div id="modalPatientRegister" class="hidden fixed inset-0 z-50 flex items-center justify-center p-2 sm:p-4 bg-black/75 backdrop-blur-sm overflow-y-auto">
  <div class="bg-white rounded-2xl border border-gray-200 w-full max-w-4xl shadow-2xl overflow-hidden my-auto">
    
    <!-- Header do Modal -->
    <div class="px-6 py-3.5 bg-gradient-to-r from-gray-50 via-gray-100 to-gray-50 border-b border-gray-200 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="p-2 bg-emerald-600 text-white rounded-xl shadow-md">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
        </div>
        <div>
          <h3 class="text-sm font-black text-gray-900 tracking-tight">Cadastro Rápido de Pacientes</h3>
          <p class="text-[10px] text-gray-500 font-mono">Cadastre o paciente e vincule direto na requisição</p>
        </div>
      </div>
      <button onclick="closePatientRegisterModal()" class="text-gray-400 hover:text-gray-700 p-1.5 rounded-xl hover:bg-gray-200 transition-colors cursor-pointer">✕</button>
    </div>

    <!-- Formulário do Paciente -->
    <form id="ajaxPatientForm" onsubmit="submitAjaxPatient(event)" class="p-5 space-y-4 text-xs">
      <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 items-center">
        <div class="sm:col-span-2">
          <label class="font-bold text-gray-700 text-[11px] block">Código</label>
          <input type="text" name="code" id="modal-p-code" placeholder="Auto" readonly class="w-full px-2.5 py-1.5 bg-gray-100 border border-gray-200 rounded-xl text-xs font-mono font-bold text-emerald-800">
        </div>
        <div class="sm:col-span-6">
          <label class="font-bold text-gray-700 text-[11px] block">Nome Completo *</label>
          <input type="text" name="name" id="modal-p-name" required placeholder="Nome completo do paciente *" class="w-full px-3 py-1.5 bg-white border border-gray-200 rounded-xl text-xs font-bold outline-none focus:ring-2 focus:ring-emerald-500">
        </div>
        <div class="sm:col-span-4">
          <label class="font-bold text-gray-700 text-[11px] block">Nome Social</label>
          <input type="text" name="socialName" id="modal-p-socialName" placeholder="Nome social" class="w-full px-3 py-1.5 bg-white border border-gray-200 rounded-xl text-xs outline-none focus:ring-2 focus:ring-emerald-500">
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 items-center">
        <div class="sm:col-span-3">
          <label class="font-bold text-gray-700 text-[11px] block">CPF</label>
          <input type="text" name="cpf" id="modal-p-cpf" placeholder="000.000.000-00" maxlength="14" oninput="this.value = applyCpfMask(this.value)" class="w-full px-2.5 py-1.5 bg-white border border-gray-200 rounded-xl text-xs font-mono outline-none focus:ring-2 focus:ring-emerald-500">
        </div>
        <div class="sm:col-span-3">
          <label class="font-bold text-gray-700 text-[11px] block">RG</label>
          <input type="text" name="rg" id="modal-p-rg" placeholder="Número do RG" class="w-full px-2.5 py-1.5 bg-white border border-gray-200 rounded-xl text-xs font-mono outline-none focus:ring-2 focus:ring-emerald-500">
        </div>
        <div class="sm:col-span-3">
          <label class="font-bold text-gray-700 text-[11px] block">WhatsApp / Celular</label>
          <input type="text" name="whatsapp" id="modal-p-whatsapp" placeholder="(43) 99999-9999" class="w-full px-2.5 py-1.5 bg-white border border-gray-200 rounded-xl text-xs font-mono outline-none focus:ring-2 focus:ring-emerald-500">
        </div>
        <div class="sm:col-span-3">
          <label class="font-bold text-gray-700 text-[11px] block">Sexo *</label>
          <select name="sex" id="modal-p-sex" required class="w-full px-2.5 py-1.5 bg-white border border-gray-200 rounded-xl text-xs font-bold outline-none focus:ring-2 focus:ring-emerald-500">
            <option value="">Selecione...</option>
            <option value="Masculino">Masculino</option>
            <option value="Feminino">Feminino</option>
            <option value="Outro">Outro</option>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 items-center">
        <div class="sm:col-span-3">
          <label class="font-bold text-gray-700 text-[11px] block">Data Nasc. *</label>
          <input type="date" name="birthDate" id="modal-p-birthDate" required onchange="calcModalPAge()" class="w-full px-2.5 py-1.5 bg-white border border-gray-200 rounded-xl text-xs outline-none focus:ring-2 focus:ring-emerald-500">
        </div>
        <div class="sm:col-span-3">
          <label class="font-bold text-gray-700 text-[11px] block">Idade (automática)</label>
          <input type="text" name="ageValue" id="modal-p-ageValue" readonly placeholder="0" class="w-full px-2.5 py-1.5 bg-gray-100 border border-gray-200 rounded-xl text-xs font-mono outline-none">
        </div>
        <div class="sm:col-span-6">
          <label class="font-bold text-gray-700 text-[11px] block">Nome da Mãe</label>
          <input type="text" name="motherName" id="modal-p-motherName" placeholder="Nome completo da mãe" class="w-full px-3 py-1.5 bg-white border border-gray-200 rounded-xl text-xs outline-none focus:ring-2 focus:ring-emerald-500">
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 items-center">
        <div class="sm:col-span-4">
          <label class="font-bold text-gray-700 text-[11px] block">CEP</label>
          <input type="text" name="cep" id="modal-p-cep" placeholder="86390-000" class="w-full px-2.5 py-1.5 bg-white border border-gray-200 rounded-xl text-xs font-mono outline-none focus:ring-2 focus:ring-emerald-500">
        </div>
        <div class="sm:col-span-5">
          <label class="font-bold text-gray-700 text-[11px] block">Logradouro / Endereço</label>
          <input type="text" name="street" id="modal-p-street" placeholder="Rua / Avenida / Número" class="w-full px-2.5 py-1.5 bg-white border border-gray-200 rounded-xl text-xs outline-none focus:ring-2 focus:ring-emerald-500">
        </div>
        <div class="sm:col-span-3">
          <label class="font-bold text-gray-700 text-[11px] block">Cidade</label>
          <input type="text" name="city" id="modal-p-city" value="Cambará" class="w-full px-2.5 py-1.5 bg-white border border-gray-200 rounded-xl text-xs outline-none focus:ring-2 focus:ring-emerald-500">
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 items-center">
        <div class="sm:col-span-4">
          <label class="font-bold text-gray-700 text-[11px] block">Convênio</label>
          <input type="text" name="convenio" id="modal-p-convenio" value="Particular" class="w-full px-2.5 py-1.5 bg-white border border-gray-200 rounded-xl text-xs outline-none focus:ring-2 focus:ring-emerald-500">
        </div>
        <div class="sm:col-span-8">
          <label class="font-bold text-gray-700 text-[11px] block">Observações do Atendimento</label>
          <input type="text" name="obs" id="modal-p-obs" placeholder="Observações..." class="w-full px-2.5 py-1.5 bg-white border border-gray-200 rounded-xl text-xs outline-none focus:ring-2 focus:ring-emerald-500">
        </div>
      </div>

      <div class="pt-4 border-t border-gray-200 flex justify-end gap-2">
        <button type="button" onclick="closePatientRegisterModal()" class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-700 rounded-xl font-bold text-xs transition-all">Cancelar</button>
        <button type="submit" class="px-5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl font-extrabold text-xs shadow-md transition-all cursor-pointer">Salvar e Selecionar Paciente</button>
      </div>
    </form>

  </div>
</div>

<!-- MODAL GENÉRICO PARA DEMAIS BUSCAS (CONVÊNIO, MÉDICO, COLETA, DESTINO, EMPRESA) -->
<div id="modalGenericSearch" class="hidden fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 bg-slate-900/60 backdrop-blur-xs animate-fadeIn">
  <div class="bg-white rounded-3xl border border-slate-200/90 w-full max-w-2xl shadow-2xl overflow-hidden font-sans flex flex-col max-h-[90vh] transform transition-all animate-scaleUp">
    <!-- Header -->
    <div class="px-6 py-4 bg-white border-b border-slate-100 flex items-center justify-between shrink-0">
