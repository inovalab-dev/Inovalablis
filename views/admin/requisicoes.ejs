  async function deleteCurrentRequisition() {
    const currentId = document.getElementById('req-id').value;
    if (!currentId) {
      alert('Nenhuma requisição selecionada para excluir.');
      return;
    }
    if (!confirm('Deseja realmente excluir esta requisição?')) return;

    try {
      const response = await fetch('/admin/requisicoes/delete-ajax', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: currentId })
      });
      const data = await response.json();
      if (data.success) {
        alert('Requisição excluída com sucesso!');
        window.location.reload();
      } else {
        alert('Erro ao excluir requisição.');
      }
    } catch (err) {
      console.error(err);
      alert('Erro na requisição de exclusão.');
    }
  }

