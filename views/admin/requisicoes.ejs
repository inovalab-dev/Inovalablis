        btnNextPayment.innerHTML = `<span>Avançar para Pagamento / Balcão</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>`;
      } else {
        btnNextPayment.innerHTML = `<span>Avançar para Pagamento</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>`;
      }
    }

    const btnFinalizeDirect = document.getElementById('req-btnFinalizeDirect');
    if (btnFinalizeDirect) {
      if (isFat) {
        btnFinalizeDirect.innerHTML = `<span>Finalizar (100% Faturamento)</span>`;
        btnFinalizeDirect.className = "px-4 py-2.5 bg-slate-200 hover:bg-slate-300 text-slate-800 rounded-2xl font-bold text-xs uppercase tracking-wider transition-all cursor-pointer flex items-center gap-1.5";
        btnFinalizeDirect.title = "Finalizar e salvar requisição faturando 100% no Convênio";
      } else {
        btnFinalizeDirect.innerHTML = `<span>Finalizar sem Pagamento</span>`;
        btnFinalizeDirect.className = "px-4 py-2.5 bg-slate-200 hover:bg-slate-300 text-slate-800 rounded-2xl font-bold text-xs uppercase tracking-wider transition-all cursor-pointer flex items-center gap-1.5";
        btnFinalizeDirect.title = "Salvar requisição sem informar pagamento agora";
      }
    }
  }

  // Alternar entre Etapa 1, Etapa 2 e Etapa 3 no Modal
  function switchRequisitionStep(step, force = false) {
    if ((step === 2 || step === 3) && !force) {
      const validation = validateStep1();
      if (!validation.isValid) {
        showStep1ValidationError(validation.errors, validation.firstMissing);
        return false;
      } else {
        clearStep1ValidationError();
      }
    } else if (step === 1) {
      clearStep1ValidationError();
    }

    const step1 = document.getElementById('requisitionStep1');
    const step2 = document.getElementById('requisitionStep2');
    const step3 = document.getElementById('requisitionStep3');
    const btn1 = document.getElementById('stepTabBtn1');
    const btn2 = document.getElementById('stepTabBtn2');
    const btn3 = document.getElementById('stepTabBtn3');

    if (step1) step1.classList.toggle('hidden', step !== 1);
    if (step2) step2.classList.toggle('hidden', step !== 2);
    if (step3) step3.classList.toggle('hidden', step !== 3);

    const tabs = [
      { btn: btn1, isCurrent: step === 1 },
      { btn: btn2, isCurrent: step === 2 },
      { btn: btn3, isCurrent: step === 3 }
    ];

    tabs.forEach(item => {
      if (item.btn) {
        if (item.isCurrent) {
          item.btn.className = "px-3.5 py-1.5 rounded-xl text-xs font-black transition-all flex items-center gap-2 bg-white text-emerald-950 shadow-xs cursor-pointer shrink-0";
          const dot = item.btn.querySelector('span');
          if (dot) dot.className = "w-2 h-2 rounded-full bg-emerald-500";
        } else {
          item.btn.className = "px-3.5 py-1.5 rounded-xl text-xs font-black transition-all flex items-center gap-2 text-gray-600 hover:text-gray-900 cursor-pointer shrink-0";
          const dot = item.btn.querySelector('span');
          if (dot) dot.className = "w-2 h-2 rounded-full bg-gray-400";
        }
      }
    });

    if (step === 3) {
      initReqPayMethodsSelect();
      fillRemainingPayAmount();
      const dateInput = document.getElementById('reqPayDateInput');
      if (dateInput && !dateInput.value) {
        const now = new Date();
        now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
        dateInput.value = now.toISOString().slice(0, 16);
      }
    }

    updateConvenioUI();
  }

  // --- GERENCIAMENTO DE EXAMES DA REQUISIÇÃO ---
  let currentlySelectedExamForInput = null;

  function populateExamMaterialsCombo(exam) {
    const materialSelect = document.getElementById('req-examMaterial');
    if (!materialSelect) return;

    materialSelect.innerHTML = '<option value="">Selecione o material...</option>';

    if (!exam) {
      materialSelect.value = '';
      return;
    }

    let mats = [];
    if (Array.isArray(exam.materiaisColetados) && exam.materiaisColetados.length > 0) {
      mats = exam.materiaisColetados;
    } else if (Array.isArray(exam.materiais) && exam.materiais.length > 0) {
      mats = exam.materiais;
    }

    const addedNames = new Set();

    if (mats.length > 0) {
      mats.forEach(m => {
        let matName = '';
        if (typeof m === 'object' && m !== null) {
          matName = (m.nome || m.material || m.abrev || '').trim();
        } else {
          matName = String(m || '').trim();
        }
        if (matName && !addedNames.has(matName.toLowerCase())) {
          addedNames.add(matName.toLowerCase());
          const opt = document.createElement('option');
          opt.value = matName;
          opt.textContent = matName;
          materialSelect.appendChild(opt);
        }
      });
    }

    if (addedNames.size === 0 && (exam.material || exam.category)) {
      const matName = (exam.material || exam.category).trim();
      if (matName) {
        addedNames.add(matName.toLowerCase());
        const opt = document.createElement('option');
        opt.value = matName;
        opt.textContent = matName;
        materialSelect.appendChild(opt);
      }
    }

    if (addedNames.size === 0) {
      const defaultMats = ['Sangue', 'Sangue Total', 'Soro', 'Plasma', 'Urina', 'Fezes', 'Escarrado', 'Swab', 'Líquor', 'Outro'];
      defaultMats.forEach(dm => {
        const opt = document.createElement('option');
        opt.value = dm;
        opt.textContent = dm;
        materialSelect.appendChild(opt);
      });
    }

    // Se tiver exatamente 1 material coletado, seleciona automaticamente
    const uniqueMats = Array.from(addedNames);
    if (uniqueMats.length === 1) {
      const optVal = Array.from(materialSelect.options).find(o => o.value.toLowerCase() === uniqueMats[0].toLowerCase())?.value || uniqueMats[0];
      materialSelect.value = optVal;
      onReqExamMaterialChange();
    } else {
      materialSelect.value = '';
    }
  }

  function onReqExamMaterialChange() {
    const materialSelect = document.getElementById('req-examMaterial');
    const priceInput = document.getElementById('req-examPrice');
    if (!materialSelect || !priceInput) return;

    const selectedMat = materialSelect.value.trim();
    if (!selectedMat) {
      priceInput.value = '';
      return;
    }

    if (currentlySelectedExamForInput) {
      const examWithMat = { ...currentlySelectedExamForInput, material: selectedMat };
      const price = getExamPriceForConvenio(examWithMat);
      priceInput.value = price.toFixed(2);
    }
  }

  function addExamToRequisition(exam) {
    if (!exam) return false;

    const newCode = (exam.code || '').trim().toUpperCase();
    const newName = (exam.name || '').trim().toUpperCase();
    const newMat = (exam.material || exam.category || 'Sangue').trim().toUpperCase();

    const isDuplicate = currentRequisitionExams.some(item => {
      const itemCode = (item.code || '').trim().toUpperCase();
      const itemName = (item.name || '').trim().toUpperCase();
      const itemMat = (item.material || '').trim().toUpperCase();

      const sameExam = (newCode && itemCode === newCode) || (newName && itemName === newName);
      const sameMaterial = itemMat === newMat;
      return sameExam && sameMaterial;
    });

    if (isDuplicate) {
      alert('Este exame já foi lançado na requisição para este mesmo material biológico.');
      return false;
    }

    const isFat = isConvenioFaturamento();
    const defaultBilling = exam.billingCategory || (isFat ? 'convenio' : 'particular');

    currentRequisitionExams.push({
      code: exam.code || 'EX' + (currentRequisitionExams.length + 1),
      name: exam.name || 'Exame Personalizado',
      category: exam.category || 'Geral',
      material: exam.material || exam.category || 'Sangue',
      price: exam.pricePrivate !== undefined ? exam.pricePrivate : getExamPriceForConvenio(exam),
      fasting: exam.fasting || 'Não informado',
      timeframe: exam.timeframe || '24 horas',
      instructions: exam.instructions || 'Procedimento padrão do laboratório.',
      status: exam.status || 'A Coletar',
      billingCategory: defaultBilling
    });

    renderExamsTable();
    calcFinancials();

    const searchInput = document.getElementById('req-examSearchInput');
    const priceInput = document.getElementById('req-examPrice');
    const list = document.getElementById('examAutocompleteList');
    if (searchInput) searchInput.value = '';
    if (priceInput) priceInput.value = '';
    if (list) list.classList.add('hidden');

    currentlySelectedExamForInput = null;
    populateExamMaterialsCombo(null);

    const quickInput = document.getElementById('req-quickCodeInput');
    if (quickInput) {
      quickInput.focus();
      quickInput.select();
    }
    return true;
  }

  function addManualExamFromInput() {
    const nameInput = document.getElementById('req-examSearchInput');
    const materialSelect = document.getElementById('req-examMaterial');
    const priceInput = document.getElementById('req-examPrice');

    const name = nameInput ? nameInput.value.trim() : '';
    if (!name) {
      alert('Digite o código ou nome do exame.');
      return;
    }

    const material = materialSelect ? materialSelect.value.trim() : '';
    if (!material) {
      alert('Por favor, selecione o Material Biológico.');
      if (materialSelect) materialSelect.focus();
      return;
    }

    let examObj = null;
    if (currentlySelectedExamForInput) {
      const price = priceInput && priceInput.value !== '' 
        ? parseFloat(priceInput.value) 
        : getExamPriceForConvenio({ ...currentlySelectedExamForInput, material });

      examObj = {
        code: currentlySelectedExamForInput.code,
        name: currentlySelectedExamForInput.name,
        category: currentlySelectedExamForInput.category || 'Geral',
        material: material,
        pricePrivate: price,
        fasting: currentlySelectedExamForInput.fasting || '4h',
        timeframe: currentlySelectedExamForInput.timeframe || '24h',
        instructions: currentlySelectedExamForInput.instructions || 'Procedimento padrão do laboratório.'
      };
    } else {
      const price = priceInput && priceInput.value !== '' ? parseFloat(priceInput.value) : 0;
      examObj = {
        code: name.slice(0, 6).toUpperCase(),
        name: name,
        category: material,
        material: material,
        pricePrivate: price,
        fasting: 'Recomendado 4 horas',
        timeframe: '24 horas',
        instructions: 'Instruções padrão para ' + name
      };
    }

    addExamToRequisition(examObj);
  }

  function triggerRequisitionShortcut(shortcutId) {
    const sc = (requisitionShortcutsList || []).find(s => String(s.id) === String(shortcutId));
    if (!sc) return;

    let foundExam = availableExamsList.find(e => 
      (sc.examId && String(e.id) === String(sc.examId)) || 
      (sc.examCode && (e.code || '').toLowerCase() === String(sc.examCode).toLowerCase()) ||
      (sc.examCode && (e.jalisCode || '').toLowerCase() === String(sc.examCode).toLowerCase())
    );

    if (!foundExam && sc.examCode) {
      foundExam = availableExamsList.find(e => (e.code || '').toLowerCase() === String(sc.examCode).toLowerCase());
    }

    const materialToUse = sc.material || (foundExam ? (foundExam.category || 'Sangue Total') : 'Sangue Total');

    if (foundExam) {
      const price = getExamPriceForConvenio({ ...foundExam, material: materialToUse });
      const examObj = {
        code: foundExam.code || foundExam.jalisCode || sc.examCode || 'EX',
        name: foundExam.name || sc.examName || 'Exame',
        category: foundExam.category || 'Geral',
        material: materialToUse,
        pricePrivate: price,
        fasting: foundExam.fasting || 'Não informado',
        timeframe: foundExam.timeframe || '24 horas',
        instructions: foundExam.instructions || 'Procedimento padrão do laboratório.',
        status: 'A Coletar'
      };
      addExamToRequisition(examObj);
    } else {
      const examObj = {
        code: sc.examCode || 'EX',
        name: sc.examName || sc.description || 'Exame Personalizado',
        category: 'Geral',
        material: materialToUse,
        pricePrivate: 0,
        fasting: 'Não informado',
        timeframe: '24 horas',
        instructions: 'Procedimento padrão do laboratório.',
        status: 'A Coletar'
      };
      addExamToRequisition(examObj);
    }
  }

  function quickAddExam(code) {
    const sc = (requisitionShortcutsList || []).find(s => 
      String(s.id) === String(code) || 
      (s.description || '').toLowerCase() === String(code).toLowerCase() || 
      (s.examCode || '').toLowerCase() === String(code).toLowerCase()
    );
    if (sc) {
      triggerRequisitionShortcut(sc.id);
      return;
    }
    const found = availableExamsList.find(e => (e.code || '').toLowerCase() === (code || '').toLowerCase());
    if (found) {
      selectExamFromAutocomplete(found.code);
    } else {
      const nameInput = document.getElementById('req-examSearchInput');
      if (nameInput) nameInput.value = code;
      currentlySelectedExamForInput = null;
      populateExamMaterialsCombo(null);
    }
  }

  function addQuickExamByCodeDirect() {
    const input = document.getElementById('req-quickCodeInput');
    if (!input) return;
    const rawVal = input.value.trim();
    if (!rawVal) {
      openSearchModal('exame');
      return;
    }

    const queryUpper = rawVal.toUpperCase();

    let found = availableExamsList.find(e => (e.code || '').toUpperCase() === queryUpper);
    if (!found) {
      found = availableExamsList.find(e => (e.code || '').toUpperCase().startsWith(queryUpper));
    }
    if (!found) {
      found = availableExamsList.find(e => (e.name || '').toUpperCase().includes(queryUpper));
    }

    if (found) {
      selectExamFromAutocomplete(found.code);
      input.value = '';
    } else {
      openSearchModal('exame');
      setTimeout(() => {
        const gInput = document.getElementById('genericSearchInput');
        if (gInput) {
          gInput.value = rawVal;
          filterGenericList();
        }
      }, 150);
      input.value = '';
    }
  }

  function removeExamFromRequisition(index) {
    if (index >= 0 && index < currentRequisitionExams.length) {
      currentRequisitionExams.splice(index, 1);
      renderExamsTable();
      calcFinancials();
    }
  }

  let draggedExamIndex = null;

  function handleExamDragStart(e, index) {
    draggedExamIndex = index;
    e.dataTransfer.effectAllowed = 'move';
    e.dataTransfer.setData('text/plain', index);
    e.currentTarget.classList.add('opacity-40', 'bg-emerald-100');
  }

  function handleExamDragOver(e) {
    e.preventDefault();
    e.dataTransfer.dropEffect = 'move';
    const tr = e.currentTarget;
    tr.classList.add('bg-emerald-100/80', 'border-y-2', 'border-emerald-500');
  }

  function handleExamDragLeave(e) {
    const tr = e.currentTarget;
    tr.classList.remove('bg-emerald-100/80', 'border-y-2', 'border-emerald-500');
  }

  function handleExamDrop(e, targetIndex) {
    e.preventDefault();
    const tr = e.currentTarget;
    tr.classList.remove('bg-emerald-100/80', 'border-y-2', 'border-emerald-500');

    if (draggedExamIndex === null || draggedExamIndex === targetIndex) return;

    const movedExam = currentRequisitionExams.splice(draggedExamIndex, 1)[0];
    currentRequisitionExams.splice(targetIndex, 0, movedExam);

    draggedExamIndex = null;
    renderExamsTable();
    if (typeof calcFinancials === 'function') calcFinancials();
  }

  function handleExamDragEnd(e) {
    e.currentTarget.classList.remove('opacity-40', 'bg-emerald-100');
    draggedExamIndex = null;
    document.querySelectorAll('#addedExamsTbody tr').forEach(tr => {
      tr.classList.remove('opacity-40', 'bg-emerald-100/80', 'border-y-2', 'border-emerald-500');
    });
  }

  function isMultiguiaActive() {
    const chk = document.getElementById('req-isMultiguia');
    return chk ? chk.checked : false;
  }

  function toggleMultiguiaMode() {
    const active = isMultiguiaActive();
    const summaryBanner = document.getElementById('examSummaryBanner');
    if (summaryBanner) {
      if (active) {
        summaryBanner.classList.remove('hidden');
      } else {
        summaryBanner.classList.add('hidden');
      }
    }

    const mgPanel = document.getElementById('multiguiasPanel');
    if (mgPanel) {
      if (active) {
        mgPanel.classList.remove('hidden');
      } else {
        mgPanel.classList.add('hidden');
      }
    }

    renderExamsTable();
    calcFinancials();
  }

  function toggleExamBillingCategory(idx) {
    if (idx < 0 || idx >= currentRequisitionExams.length) return;
    const isFat = isConvenioFaturamento();
    const currentCat = currentRequisitionExams[idx].billingCategory || (isFat ? 'convenio' : 'particular');
    currentRequisitionExams[idx].billingCategory = (currentCat === 'particular') ? 'convenio' : 'particular';
    
    syncFaturadoFromExams();
  }

  function setAllExamsBillingCategory(cat) {
    if (!currentRequisitionExams || currentRequisitionExams.length === 0) return;
    currentRequisitionExams.forEach(e => {
      e.billingCategory = cat;
    });
    syncFaturadoFromExams();
  }

  function syncFaturadoFromExams() {
    const fatInput = document.getElementById('req-faturadoValInput');
    if (fatInput) {
      fatInput.dataset.userTouched = 'false';
    }

    renderExamsTable();
    calcFinancials();
  }

  function renderExamsTable() {
    const tbody = document.getElementById('addedExamsTbody');
    const countBadge = document.getElementById('examsCountBadge');
    const stepBadge = document.getElementById('stepTabExamsBadge');
    const jsonInput = document.getElementById('req-examsJson');
    const isFat = isConvenioFaturamento();
    const isMG = isMultiguiaActive();

    if (jsonInput) jsonInput.value = JSON.stringify(currentRequisitionExams);

    if (!tbody) return;

    if (currentRequisitionExams.length === 0) {
      tbody.innerHTML = `
        <tr id="addedExamsEmptyRow">
          <td colspan="9" class="px-4 py-8 text-center text-gray-400 italic">
            <div class="flex flex-col items-center justify-center gap-1">
              <span class="text-2xl">🧪</span>
              <span class="font-bold text-gray-600 text-xs">Nenhum exame adicionado a esta requisição</span>
              <span class="text-[11px] text-gray-400">Utilize o campo acima para pesquisar ou clique nos atalhos rápidos</span>
            </div>
          </td>
        </tr>
      `;
      if (countBadge) countBadge.textContent = '0 Exames';
      if (stepBadge) stepBadge.textContent = isFat ? '0 exames' : '0 exames (R$ 0,00)';
      updatePrepInfoCard();
      updateConvenioUI();
      return;
    }

    let html = '';
    let subtotal = 0;

    currentRequisitionExams.forEach((e, idx) => {
      const price = parseFloat(e.price) || 0;
      subtotal += price;

      const billingCat = e.billingCategory || (isFat ? 'convenio' : 'particular');
      let billingBadge = '';
      if (isMG) {
        billingBadge = window.isCurrentReqReadOnly 
          ? (billingCat === 'particular'
            ? `<span class="px-2 py-0.5 rounded-full text-[10px] font-black font-mono bg-amber-100 text-amber-900 border border-amber-300">💳 Particular</span>`
            : `<span class="px-2 py-0.5 rounded-full text-[10px] font-black font-mono bg-blue-100 text-blue-900 border border-blue-300">🏢 Convênio</span>`)
          : (billingCat === 'particular'
            ? `<button type="button" onclick="event.stopPropagation(); toggleExamBillingCategory(${idx})" class="px-2 py-0.5 rounded-full text-[10px] font-black font-mono bg-amber-100 text-amber-900 border border-amber-300 hover:bg-amber-200 transition-all cursor-pointer shadow-2xs" title="Exame cobrado no Balcão/Particular. Clique para alternar para Convênio">💳 Particular</button>`
            : `<button type="button" onclick="event.stopPropagation(); toggleExamBillingCategory(${idx})" class="px-2 py-0.5 rounded-full text-[10px] font-black font-mono bg-blue-100 text-blue-900 border border-blue-300 hover:bg-blue-200 transition-all cursor-pointer shadow-2xs" title="Exame faturado no Convênio. Clique para alternar para Particular">🏢 Convênio</button>`);
      } else {
        billingBadge = `<span class="text-slate-400 font-mono text-[10px]">—</span>`;
      }

      html += `
        <tr class="hover:bg-emerald-50/60 cursor-grab active:cursor-grabbing transition-colors text-xs" 
            draggable="true" 
            data-index="${idx}"
            ondragstart="handleExamDragStart(event, ${idx})"
            ondragover="handleExamDragOver(event)"
            ondragleave="handleExamDragLeave(event)"
            ondrop="handleExamDrop(event, ${idx})"
            ondragend="handleExamDragEnd(event)"
            onclick="selectExamForPrepInfo(${idx})">
          <td class="px-3 py-2 font-mono text-gray-400 font-bold select-none"><span class="text-gray-400 text-sm mr-1">⠿</span>${idx + 1}</td>
          <td class="px-3 py-2 font-mono font-bold text-emerald-800">${e.code}</td>
          <td class="px-3 py-2 font-black text-gray-900">${e.name}</td>
          <td class="px-3 py-2"><span class="bg-gray-100 text-gray-700 px-2 py-0.5 rounded font-mono text-[10px]">${e.material || e.category || 'Sangue'}</span></td>
          <td class="px-3 py-2 text-center" onclick="event.stopPropagation()">${billingBadge}</td>
          <td class="px-3 py-2 font-mono text-[11px] font-bold text-amber-800"><span class="bg-amber-50 text-amber-900 border border-amber-200 px-2 py-0.5 rounded font-mono text-[10px]">${e.fasting || 'Sem jejum'}</span></td>
          <td class="px-3 py-2 font-mono text-[11px] text-gray-500">${e.timeframe || '24h'}</td>
          <td class="px-3 py-2 text-right font-mono font-bold text-emerald-900 exam-table-price-col ${isFat ? 'hidden' : ''}">R$ ${price.toFixed(2).replace('.', ',')}</td>
          <td class="px-3 py-2 text-center" onclick="event.stopPropagation()">
            ${window.isCurrentReqReadOnly ? '<span class="text-gray-300 text-[10px] font-mono" title="Somente leitura">🔒</span>' : `
              <button type="button" onclick="removeExamFromRequisition(${idx})" class="p-1 text-rose-500 hover:text-rose-700 hover:bg-rose-50 rounded-lg transition-colors cursor-pointer" title="Remover Exame">
                🗑️
              </button>
            `}
          </td>
        </tr>
      `;
    });

    tbody.innerHTML = html;
    if (countBadge) countBadge.textContent = currentRequisitionExams.length + ' Exame(s)';
    if (stepBadge) stepBadge.textContent = isFat ? `${currentRequisitionExams.length} exame(s)` : `${currentRequisitionExams.length} exame(s) (R$ ${subtotal.toFixed(2).replace('.', ',')})`;
    updatePrepInfoCard();
    updateConvenioUI();
  }

  function updatePrepInfoCard() {
    const maxFastingDisplay = document.getElementById('maxFastingDisplayVal');
    const listContainer = document.getElementById('prepExamsListContainer');

    if (!listContainer) return;

    if (!currentRequisitionExams || currentRequisitionExams.length === 0) {
      if (maxFastingDisplay) maxFastingDisplay.textContent = 'Sem exames';
      listContainer.innerHTML = `
        <div class="bg-white p-4 rounded-xl border border-slate-200 text-center text-slate-400 italic text-xs">
          Nenhum exame adicionado. Ao selecionar ou lançar exames, as orientações de preparo serão listadas automaticamente aqui.
        </div>
      `;
      return;
    }

    // Calcular o maior jejum em horas entre todos os exames adicionados
    let maxHours = 0;
    let maxHoursExam = '';

    currentRequisitionExams.forEach(e => {
      const fStr = (e.fasting || '').toString();
      const matches = fStr.match(/\d+/g);
      if (matches) {
        matches.forEach(mStr => {
          const num = parseInt(mStr, 10);
          if (num > maxHours && num <= 48) {
            maxHours = num;
            maxHoursExam = e.name;
          }
        });
      }
    });

    if (maxFastingDisplay) {
      if (maxHours > 0) {
        maxFastingDisplay.textContent = `${maxHours} Horas (${maxHoursExam || 'Exame LIS'})`;
      } else {
        maxFastingDisplay.textContent = 'Sem exigência de jejum prolongado';
      }
    }

    // Listar as orientações de TODOS os exames da requisição
    let html = '';
    currentRequisitionExams.forEach((e) => {
      html += `
        <div class="bg-white p-3 rounded-xl border border-slate-200 space-y-1.5 hover:border-emerald-300 transition-colors">
          <div class="flex items-center justify-between gap-2 flex-wrap">
            <div class="flex items-center gap-1.5 font-bold text-slate-800 text-xs">
              <span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0"></span>
              <span class="font-mono text-[10px] text-emerald-800 bg-emerald-100 px-1.5 py-0.5 rounded font-extrabold">${e.code}</span>
              <span class="text-slate-900">${e.name}</span>
            </div>
            <span class="bg-amber-50 text-amber-900 border border-amber-200 font-mono text-[10px] font-bold px-2 py-0.5 rounded-full">
              ⌛ Jejum: ${e.fasting || 'Não informado'}
            </span>
          </div>
          <div class="text-[11px] text-slate-600 flex items-center justify-between font-mono pt-0.5">
            <span>Amostra: <b>${e.material || e.category || 'Sangue'}</b></span>
            <span>Prazo Laudo: <b>${e.timeframe || '24h'}</b></span>
          </div>
          <div class="text-[11px] text-slate-600 bg-slate-50 p-2 rounded-lg border border-slate-100 mt-1">
            💡 <b>Orientações de Coleta & Preparo:</b> ${e.instructions || 'Procedimento padrão de coleta laboratorial.'}
          </div>
        </div>
      `;
    });

    listContainer.innerHTML = html;
  }

  function openPrepInstructionsModal() {
    updatePrepInfoCard();
    const modal = document.getElementById('modalPrepInstructions');
    if (modal) modal.classList.remove('hidden');
  }

  function closePrepInstructionsModal() {
    const modal = document.getElementById('modalPrepInstructions');
    if (modal) modal.classList.add('hidden');
  }

  // --- MODAL DE VISUALIZAÇÃO RÁPIDA DA REQUISIÇÃO (BOTÃO DE OLHO) ---
  let activeQuickViewReqId = null;

  function openRequisitionQuickViewModal(reqId) {
    const req = requisitionsData.find(r => String(r.id) === String(reqId));
    if (!req) return;

    activeQuickViewReqId = req.id;

    // Cabeçalho da Requisição
    const codeElem = document.getElementById('qv-reqCode');
    if (codeElem) codeElem.textContent = '#' + (req.requisitionCode || req.id || '---');

    const dateElem = document.getElementById('qv-reqDate');
    if (dateElem) dateElem.textContent = (req.fatura || '-') + (req.hora ? (' às ' + req.hora) : '');

    const coletaHeaderElem = document.getElementById('qv-reqColeta');
    if (coletaHeaderElem) coletaHeaderElem.textContent = req.coleta || 'Sede / Central';

    // Badge de Status
    const statusBadge = document.getElementById('qv-reqStatusBadge');
    const st = req.status || 'Em Andamento';
    const stLower = st.toLowerCase();
    if (statusBadge) {
      if (stLower.includes('pronto') || stLower.includes('liberado') || stLower.includes('conferido')) {
        statusBadge.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-extrabold font-mono border bg-emerald-700/80 text-white border-emerald-400/60';
      } else if (stLower.includes('cancel')) {
        statusBadge.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-extrabold font-mono border bg-rose-600/80 text-white border-rose-400/60';
      } else {
        statusBadge.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-extrabold font-mono border bg-amber-600/80 text-white border-amber-300/60';
      }
      statusBadge.textContent = st;
    }

    // Card Paciente
    const pNameElem = document.getElementById('qv-patientName');
    if (pNameElem) pNameElem.textContent = req.patientName || 'Não Informado';

    let cpf = req.patientCpf || '-';
    if ((cpf === '-' || !cpf) && req.patientCode && typeof patientsList !== 'undefined') {
      let pFound = patientsList.find(p => String(p.code || p.id) === String(req.patientCode) || p.name === req.patientName);
      if (pFound && pFound.cpf) cpf = pFound.cpf;
    }
    const pCpfElem = document.getElementById('qv-patientCpf');
    if (pCpfElem) pCpfElem.textContent = cpf;

    let birth = req.patientBirthDate || '-';
    if (birth && birth.includes('-') && birth.split('-').length === 3) {
      const [y, m, d] = birth.split('-');
      if (y.length === 4) birth = `${d}/${m}/${y}`;
    }
    let ageStr = '';
    if (req.patientBirthDate) {
      const bDate = new Date(req.patientBirthDate);
      if (!isNaN(bDate)) {
        const ageDiff = Date.now() - bDate.getTime();
        const ageDate = new Date(ageDiff);
        const yrs = Math.abs(ageDate.getUTCFullYear() - 1970);
        ageStr = ` (${yrs} yrs)`;
      }
    }
    const pBirthElem = document.getElementById('qv-patientBirth');
    if (pBirthElem) pBirthElem.textContent = birth + ageStr;

    let phone = req.patientPhone || req.patientWhatsapp || '-';
    if ((phone === '-' || !phone) && req.patientCode && typeof patientsList !== 'undefined') {
      let pFound = patientsList.find(p => String(p.code || p.id) === String(req.patientCode) || p.name === req.patientName);
      if (pFound && (pFound.whatsapp || pFound.phone)) phone = pFound.whatsapp || pFound.phone;
    }
    const pPhoneElem = document.getElementById('qv-patientPhone');
    if (pPhoneElem) pPhoneElem.textContent = phone;

    const pSexElem = document.getElementById('qv-patientSex');
    if (pSexElem) pSexElem.textContent = req.patientSex || 'Não informado';

    // Card Convênio
    const convElem = document.getElementById('qv-convenio');
    if (convElem) convElem.textContent = req.convenio || 'Particular';

    const guiaElem = document.getElementById('qv-guia');
    if (guiaElem) guiaElem.textContent = req.guia || req.matricula || '-';

    const coletaDetailElem = document.getElementById('qv-coletaDetail');
    if (coletaDetailElem) coletaDetailElem.textContent = req.coleta || 'Sede / Central';

    const destElem = document.getElementById('qv-destino');
    if (destElem) destElem.textContent = req.destino || 'Laboratório Principal';

    const cityElem = document.getElementById('qv-city');
    if (cityElem) cityElem.textContent = req.city || 'Cambará';

    // Card Solicitante
    const docNameElem = document.getElementById('qv-doctorName');
    if (docNameElem) docNameElem.textContent = req.doctorName || 'Dr. Solicitante / Próprio';

    const docCrmElem = document.getElementById('qv-doctorCrm');
    if (docCrmElem) docCrmElem.textContent = (req.doctorCrmType || 'CRM') + ': ' + (req.doctorCrm || '-') + (req.doctorUf ? ('/' + req.doctorUf) : '');

    const delivElem = document.getElementById('qv-deliveryDate');
    if (delivElem) delivElem.textContent = (req.deliveryDate || 'A definir') + (req.deliveryTime ? (' às ' + req.deliveryTime) : '');

    const obsElem = document.getElementById('qv-obs');
    if (obsElem) obsElem.textContent = req.obs || req.clinicalNotes || 'Sem observações adicionais.';

    // Tabela de Exames
    let examList = [];
    if (Array.isArray(req.exams)) {
      examList = req.exams;
    } else if (req.examsJson) {
      try { examList = JSON.parse(req.examsJson); } catch(e) { examList = []; }
    }

    const examsBadge = document.getElementById('qv-examsBadge');
    if (examsBadge) examsBadge.textContent = `${examList.length} ${examList.length === 1 ? 'exame' : 'exames'}`;

    const tbody = document.getElementById('qv-examsTbody');
    if (tbody) {
      if (!examList || examList.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="7" class="px-4 py-6 text-center text-gray-400 italic">Nenhum exame vinculado a esta requisição.</td>
          </tr>
        `;
        const subtotalElem = document.getElementById('qv-examsSubtotal');
        if (subtotalElem) subtotalElem.textContent = 'R$ 0,00';
      } else {
        let html = '';
        let subtotalCalc = 0;
        examList.forEach((ex, idx) => {
          const priceVal = parseFloat(ex.price || ex.pricePrivate || 0);
          subtotalCalc += priceVal;

          const exSt = ex.status || 'A Coletar';
          let exBg = 'bg-slate-100 text-slate-700 border-slate-300';
          const exStLower = exSt.toLowerCase();
          if (exStLower.includes('pronto') || exStLower.includes('conferido') || exStLower.includes('liberado')) {
            exBg = 'bg-emerald-100 text-emerald-900 border-emerald-300';
          } else if (exStLower.includes('análise') || exStLower.includes('andamento')) {
            exBg = 'bg-blue-100 text-blue-900 border-blue-300';
          } else if (exStLower.includes('coletado')) {
            exBg = 'bg-amber-100 text-amber-900 border-amber-300';
          }

          const exBillingCat = ex.billingCategory || (isQvFat ? 'convenio' : 'particular');
          const billingTag = exBillingCat === 'particular'
            ? `<span class="px-2 py-0.5 rounded-full text-[9px] font-black font-mono bg-amber-100 text-amber-900 border border-amber-300">💳 Particular</span>`
            : `<span class="px-2 py-0.5 rounded-full text-[9px] font-black font-mono bg-blue-100 text-blue-900 border border-blue-300">🏢 Convênio</span>`;

          html += `
            <tr class="hover:bg-slate-50 transition-colors text-xs">
              <td class="px-3 py-2 text-center font-mono font-bold text-slate-400">${idx + 1}</td>
              <td class="px-3 py-2 font-mono font-extrabold text-emerald-800">${ex.code || ex.examCode || 'EX'}</td>
              <td class="px-3 py-2 font-bold text-slate-900 flex items-center justify-between gap-1">
                <span>${ex.name || ex.examName || 'Exame'}</span>
                ${billingTag}
              </td>
              <td class="px-3 py-2 font-mono text-slate-600">${ex.material || ex.category || 'Sangue'}</td>
              <td class="px-3 py-2 font-mono text-slate-500">${ex.fasting || '4h'} / ${ex.timeframe || '24h'}</td>
              <td class="px-3 py-2 text-center">
                <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold font-mono border ${exBg}">
                  ${exSt}
                </span>
              </td>
              <td class="px-3 py-2 text-right font-mono font-bold text-slate-900">R$ ${priceVal.toFixed(2).replace('.', ',')}</td>
            </tr>
          `;
        });
        tbody.innerHTML = html;
        const subtotalElem = document.getElementById('qv-examsSubtotal');
        if (subtotalElem) subtotalElem.textContent = `R$ ${subtotalCalc.toFixed(2).replace('.', ',')}`;
      }
    }

    // Informações Financeiras e Pagamento
    const isQvFat = isConvenioFaturamento(req.convenio, req.convenioCode, req.convenioId);
    const subtotal = parseFloat(req.subtotal || 0);
    const discount = parseFloat(req.discount || 0);
    const total = parseFloat(req.totalAmount || (subtotal - discount));
    const paid = parseFloat(req.paidAmount || 0);
    const balance = Math.max(0, total - paid);

    const fatVal = req.faturadoAmount !== undefined && req.faturadoAmount !== null && req.faturadoAmount !== ''
      ? parseFloat(req.faturadoAmount)
      : (isQvFat ? total : 0);
    const balcaoDevido = Math.max(0, total - fatVal);
    const balcaoRemaining = Math.max(0, balcaoDevido - paid);

    const finSubElem = document.getElementById('qv-finSubtotal');
    if (finSubElem) finSubElem.textContent = `R$ ${subtotal.toFixed(2).replace('.', ',')}`;

    const finDiscElem = document.getElementById('qv-finDiscount');
    if (finDiscElem) finDiscElem.textContent = `R$ ${discount.toFixed(2).replace('.', ',')}`;

    const finTotElem = document.getElementById('qv-finTotal');
    if (finTotElem) finTotElem.textContent = `R$ ${total.toFixed(2).replace('.', ',')}`;

    const finPaidElem = document.getElementById('qv-finPaid');
    if (finPaidElem) finPaidElem.textContent = `R$ ${paid.toFixed(2).replace('.', ',')}`;

    const finBalElem = document.getElementById('qv-finBalance');
    if (finBalElem) {
      if (fatVal >= total && total > 0) {
        finBalElem.textContent = 'Faturamento';
      } else if (fatVal > 0 && balcaoDevido > 0) {
        if (balcaoRemaining <= 0) {
          finBalElem.textContent = `R$ 0,00 (Fat R$ ${fatVal.toFixed(2).replace('.', ',')})`;
        } else {
          finBalElem.textContent = `R$ ${balcaoRemaining.toFixed(2).replace('.', ',')} (Fat R$ ${fatVal.toFixed(2).replace('.', ',')})`;
        }
      } else {
        finBalElem.textContent = `R$ ${balance.toFixed(2).replace('.', ',')}`;
      }
    }

    const finMethodElem = document.getElementById('qv-finMethod');
    if (finMethodElem) finMethodElem.textContent = req.paymentMethod || (isQvFat ? 'Faturamento' : 'Particular - Dinheiro');

    const finCondElem = document.getElementById('qv-finCondition');
    if (finCondElem) finCondElem.textContent = req.paymentCondition || (isQvFat ? 'Faturamento' : 'À Vista');

    // Status Financeiro Badge
    const finBadge = document.getElementById('qv-finStatusBadge');
    if (finBadge) {
      if (fatVal >= total && total > 0) {
        finBadge.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-mono font-extrabold uppercase border bg-blue-100 text-blue-900 border-blue-300';
        finBadge.textContent = 'Faturamento';
      } else {
        const finSt = req.financialStatus || (paid >= total && total > 0 ? 'Pago' : (paid > 0 ? 'Parcial' : 'Pendente'));
        const finStLower = finSt.toLowerCase();
        if (finStLower.includes('pago') || finStLower.includes('faturado') || finStLower.includes('cortesia')) {
          finBadge.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-mono font-extrabold uppercase border bg-emerald-100 text-emerald-900 border-emerald-300';
        } else if (finStLower.includes('parcial')) {
          finBadge.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-mono font-extrabold uppercase border bg-blue-100 text-blue-900 border-blue-300';
        } else {
          finBadge.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-mono font-extrabold uppercase border bg-amber-100 text-amber-900 border-amber-300';
        }
        finBadge.textContent = finSt;
      }
    }

    // Botão Laudo PDF (Requer Exame Pronto e Pagamento Pago ou Faturamento)
    const isPronto = stLower.includes('pronto') || stLower.includes('liberado') || stLower.includes('conferido');
    const finStLower = (req.financialStatus || '').toLowerCase();
    const pmLower = (req.paymentMethod || '').toLowerCase();
    const isQvPago = isQvFat || fatVal > 0 || (finStLower.includes('pago') || finStLower.includes('faturado') || finStLower.includes('cortesia') || pmLower.includes('convênio') || pmLower.includes('cortesia') || (total > 0 && paid >= total) || total === 0);

    const qvPdfBtn = document.getElementById('qv-viewPdfBtn');
    if (qvPdfBtn) {
      if (isPronto && isQvPago) {
        qvPdfBtn.href = `/api/laudo/pdf?requisicao=${encodeURIComponent(req.requisitionCode || req.id)}`;
        qvPdfBtn.classList.remove('hidden');
      } else {
        qvPdfBtn.classList.add('hidden');
      }
    }

    const qvCashierBtn = document.getElementById('qv-cashierBtn');
    if (qvCashierBtn) {
      if (fatVal >= total && total > 0) {
        qvCashierBtn.classList.add('hidden');
      } else {
        qvCashierBtn.classList.remove('hidden');
      }
    }

    const modal = document.getElementById('requisitionQuickViewModal');
    if (modal) modal.classList.remove('hidden');
  }

  function closeQuickViewModal() {
    const modal = document.getElementById('requisitionQuickViewModal');
    if (modal) modal.classList.add('hidden');
  }

  function openEditFromQuickView() {
    closeQuickViewModal();
    if (activeQuickViewReqId) {
      selectRequisitionToForm(activeQuickViewReqId);
    }
  }

  // --- MODAL DE CAIXA / BAIXA DE PAGAMENTO ---
  let activeCashierReqId = null;
  let activeCashierReq = null;

  function openPaymentCashierModal(reqId) {
    selectRequisitionToForm(reqId, 3);
  }

  function openPaymentCashierFromQuickView() {
    closeQuickViewModal();
    if (activeQuickViewReqId) {
      openPaymentCashierModal(activeQuickViewReqId);
    }
  }

  function closePaymentCashierModal() {
    const modal = document.getElementById('modalPaymentCashier');
    if (modal) modal.classList.add('hidden');
  }

  function cashierSetFullPay() {
    if (!activeCashierReq) return;
    let subtotal = parseFloat(activeCashierReq.subtotal || 0);
    if (!subtotal && Array.isArray(activeCashierReq.exams)) {
      activeCashierReq.exams.forEach(ex => { subtotal += parseFloat(ex.price || 0); });
    }
    const discount = parseFloat(activeCashierReq.discount || 0);
    const total = parseFloat(activeCashierReq.totalAmount || (subtotal - discount));

    const amountInput = document.getElementById('cashier-amountInput');
    if (amountInput) amountInput.value = total.toFixed(2);

    const statusSelect = document.getElementById('cashier-statusSelect');
    if (statusSelect) statusSelect.value = 'Pago';

    const methodSelect = document.getElementById('cashier-methodSelect');
    if (methodSelect && methodSelect.value.includes('Convênio')) {
      methodSelect.value = 'Particular - Pix';
    }
  }

  function cashierSetConvenio() {
    if (!activeCashierReq) return;
    let subtotal = parseFloat(activeCashierReq.subtotal || 0);
    if (!subtotal && Array.isArray(activeCashierReq.exams)) {
      activeCashierReq.exams.forEach(ex => { subtotal += parseFloat(ex.price || 0); });
    }
    const discount = parseFloat(activeCashierReq.discount || 0);
