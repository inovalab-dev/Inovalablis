  async function submitCashierPayment(event) {
    event.preventDefault();
    const submitBtn = document.getElementById('cashier-submitBtn');
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span>⏳</span> Processando...';
    }

    const reqId = document.getElementById('cashier-reqId').value;
    const amountVal = parseFloat(document.getElementById('cashier-amountInput').value) || 0;
    const paymentMethod = document.getElementById('cashier-methodSelect').value;
    const paymentCondition = document.getElementById('cashier-conditionSelect').value;
    const financialStatus = document.getElementById('cashier-statusSelect').value;
    const paymentObs = document.getElementById('cashier-obsInput').value;

    try {
      const response = await fetch('/admin/requisicoes/update-payment', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          id: reqId,
          paidAmount: amountVal,
          paymentMethod,
          paymentCondition,
          financialStatus,
          paymentObs
        })
      });

      const res = await response.json();
      if (res.success) {
        closePaymentCashierModal();
        if (typeof showToast === 'function') {
          showToast('Baixa de pagamento efetuada com sucesso!', 'success');
        } else {
          alert('Baixa de pagamento efetuada com sucesso!');
        }
        window.location.reload();
      } else {
        alert(res.message || 'Erro ao registrar pagamento.');
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = '<span>💾</span> Confirmar e Dar Baixa no Pagamento';
        }
      }
    } catch (e) {
      console.error(e);
      alert('Erro de conexão ao salvar pagamento.');
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<span>💾</span> Confirmar e Dar Baixa no Pagamento';
      }
    }
  }

