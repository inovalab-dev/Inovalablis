          ⚠️
        </div>
        <div>
          <h3 class="text-xs font-black text-slate-800 uppercase tracking-wider">Atenção ao Preenchimento</h3>
          <p class="text-[11px] text-slate-500 font-medium">Campos pendentes de preenchimento</p>
        </div>
      </div>
      <button type="button" onclick="closeValidationErrorModal()" class="text-slate-400 hover:text-slate-600 hover:bg-slate-100 p-1.5 rounded-xl transition-all cursor-pointer">
