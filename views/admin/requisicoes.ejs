  function executePatientFilter() {
    const fieldElem = document.getElementById('modalFilterField');
    const typeElem = document.getElementById('modalFilterType');
    const queryElem = document.getElementById('modalFilterQuery');

    const field = fieldElem ? fieldElem.value : 'name';
    const matchType = typeElem ? typeElem.value : 'contains';
    const query = queryElem ? queryElem.value.toLowerCase().trim() : '';

    if (!query) {
      renderModalPatientsTable(patientsList.slice().reverse());
      return;
    }

    const filtered = patientsList.filter(p => {
      if (field === 'birthDate') {
        let rawDate = (p.birthDate || '').toLowerCase(); // Ex: "1990-05-20"
        let brDate = '';
        if (rawDate && rawDate.includes('-')) {
          const parts = rawDate.split('T')[0].split('-');
          if (parts.length === 3) {
            brDate = `${parts[2]}/${parts[1]}/${parts[0]}`; // Ex: "20/05/1990"
          }
        } else if (rawDate) {
          brDate = rawDate;
        }

        const qClean = query;
        const digitsOnlyP = (brDate + rawDate).replace(/\D/g, '');
        const digitsOnlyQ = query.replace(/\D/g, '');

        if (matchType === 'equals') {
          return rawDate === qClean || brDate === qClean || (digitsOnlyQ.length >= 4 && digitsOnlyP === digitsOnlyQ);
        } else if (matchType === 'starts') {
          return rawDate.startsWith(qClean) || brDate.startsWith(qClean) || (digitsOnlyQ && digitsOnlyP.startsWith(digitsOnlyQ));
        } else {
          return rawDate.includes(qClean) || brDate.includes(qClean) || (digitsOnlyQ && digitsOnlyP.includes(digitsOnlyQ));
        }
      }

      let val = '';
      if (field === 'name') val = (p.name || '').toLowerCase();
      else if (field === 'cpf') val = (p.cpf || '').replace(/\D/g, '');
      else if (field === 'code') val = (p.code || p.id || '').toLowerCase();
      else if (field === 'prontuario') val = (p.prontuario || '').toLowerCase();

      const qClean = field === 'cpf' ? query.replace(/\D/g, '') : query;

      if (matchType === 'equals') return val === qClean;
      if (matchType === 'starts') return val.startsWith(qClean);
      return val.includes(qClean);
    });

    renderModalPatientsTable(filtered);
  }

  function filterLocalizarTable(val) {
    const q = val.toLowerCase().trim();
    const qDigits = q.replace(/\D/g, '');
    if (!q) {
      renderModalPatientsTable(patientsList.slice(-15).reverse());
      return;
    }
    const filtered = patientsList.filter(p => {
      const pCpf = (p.cpf || '').toLowerCase();
      const pCpfDigits = pCpf.replace(/\D/g, '');
      return (p.name || '').toLowerCase().includes(q) ||
        pCpf.includes(q) ||
        (qDigits.length >= 3 && pCpfDigits.includes(qDigits)) ||
        (p.code || p.id || '').toLowerCase().includes(q);
    });
    renderModalPatientsTable(filtered);
  }

