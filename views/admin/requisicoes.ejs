  async function submitAjaxPatient(e) {
    e.preventDefault();
    const form = document.getElementById('ajaxPatientForm');
    const formData = new FormData(form);
    const data = {};
    formData.forEach((val, key) => data[key] = val);

    try {
      const response = await fetch('/admin/recepcao/pacientes/save-ajax', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      const resData = await response.json();
      if (resData.success && resData.patient) {
        patientsList = resData.patients || patientsList;
        patientsList.push(resData.patient);
        fillPatientIntoRequisition(resData.patient);
        closePatientRegisterModal();
        closePatientSearchModal();
        alert('Paciente ' + resData.patient.name + ' cadastrado e selecionado com sucesso!');
      } else {
        alert('Erro ao cadastrar paciente: ' + (resData.error || 'Verifique os dados.'));
      }
    } catch (err) {
      console.error(err);
      alert('Erro na comunicação ao salvar paciente.');
    }
  }

  // --- AUTOCOMPLETE NO CAMPO DE PACIENTE ---
  function filterPatientsDropdown(val) {
    const dropdown = document.getElementById('patientAutocompleteList');
    const q = val.toLowerCase().trim();

    if (!q || q.length < 2) {
      dropdown.classList.add('hidden');
      return;
    }

    const matches = patientsList.filter(p => 
      (p.name || '').toLowerCase().includes(q) || 
      (p.cpf || '').includes(q) ||
      (p.code || p.id || '').toLowerCase().includes(q)
    ).slice(0, 8);

    if (matches.length === 0) {
      dropdown.classList.add('hidden');
      return;
    }

    dropdown.innerHTML = '';
    matches.forEach(p => {
      const div = document.createElement('div');
      div.className = "px-3 py-2 hover:bg-emerald-50 cursor-pointer border-b border-gray-100 flex justify-between items-center text-xs";
      div.onclick = () => {
        fillPatientIntoRequisition(p);
        dropdown.classList.add('hidden');
      };
      div.innerHTML = `
        <div>
          <strong class="text-gray-900 block">${p.name}</strong>
          <span class="text-[10px] text-gray-500 font-mono">CPF: ${p.cpf ? applyCpfMask(p.cpf) : 'Não inf.'} | Nasc: ${p.birthDate || ''}</span>
        </div>
        <span class="font-mono text-[10px] text-emerald-800 font-bold bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">${p.code || p.id}</span>
      `;
      dropdown.appendChild(div);
    });

