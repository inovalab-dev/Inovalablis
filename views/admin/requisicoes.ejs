  // MODAL GENÉRICO DE BUSCA COM INTEGRAÇÃO DE CONVÊNIOS E MÉDICOS DO CADASTRO
  const conveniosListFromDb = <%- JSON.stringify(locals.convenios || []) %>;
  const priceTablesFromDb = <%- JSON.stringify(locals.priceTables || []) %>;
  const medicosListFromDb = <%- JSON.stringify(locals.medicos || []) %>;

  function getExamPriceForConvenio(exam, convenioNameOrCode) {
    if (!exam) return 0;
    
    const currentConvName = (convenioNameOrCode || document.getElementById('req-convenio')?.value || 'Particular').trim();
    const currentConvCode = document.getElementById('req-convenioCode')?.value?.trim();
    
    let conv = conveniosListFromDb.find(c => 
      (currentConvCode && String(c.codigo) === currentConvCode) ||
      (c.fantasia && c.fantasia.toLowerCase() === currentConvName.toLowerCase()) ||
      (c.razaoSocial && c.razaoSocial.toLowerCase() === currentConvName.toLowerCase())
    );

    if (!conv) {
      conv = conveniosListFromDb.find(c => (c.fantasia || c.razaoSocial || '').toLowerCase().includes('particular')) || conveniosListFromDb[0];
    }

    const tabelaId = conv ? conv.tabelaPrecoId : null;
    let priceTable = null;
    if (tabelaId) {
      priceTable = priceTablesFromDb.find(pt => String(pt.id) === String(tabelaId));
    }
    if (!priceTable && priceTablesFromDb.length > 0) {
      priceTable = priceTablesFromDb[0];
    }

    if (!priceTable || !priceTable.precios) {
      return parseFloat(exam.pricePrivate || exam.price || 0);
    }

    const examCode = (exam.code || exam.codigo || '').toLowerCase();
    const examName = (exam.name || exam.nome || '').toLowerCase();
    const examId = (exam.id || '').toLowerCase();
    const examMat = (exam.material || exam.materialColetado || exam.materialNome || '').toLowerCase().trim();

    let priceItem = null;
    if (examMat) {
      priceItem = priceTable.precios.find(p => {
        const pCode = (p.exameCodigo || p.examCode || p.code || '').toLowerCase();
        const pName = (p.exameNome || p.examName || p.name || '').toLowerCase();
        const pId = (p.exameId || p.id || '').toLowerCase();
        const pMat = (p.material || '').toLowerCase().trim();

        const matchExam = (examCode && pCode === examCode) || (examId && pId === examId) || (examName && pName === examName);
        return matchExam && pMat === examMat;
      });
    }

    if (!priceItem) {
      priceItem = priceTable.precios.find(p => {
        const pCode = (p.exameCodigo || p.examCode || p.code || '').toLowerCase();
        const pName = (p.exameNome || p.examName || p.name || '').toLowerCase();
        const pId = (p.exameId || p.id || '').toLowerCase();
        return (examCode && pCode === examCode) || (examId && pId === examId) || (examName && pName === examName);
      });
    }

    if (priceItem && priceItem.valor !== undefined && priceItem.valor !== null && priceItem.valor !== '') {
      return parseFloat(priceItem.valor) || 0;
    }

    return parseFloat(exam.pricePrivate || exam.price || 0);
  }

  function recalculateRequisitionExamPrices() {
    if (!currentRequisitionExams || currentRequisitionExams.length === 0) {
      updateConvenioUI();
      return;
    }
    currentRequisitionExams.forEach(item => {
      const foundInAvailable = availableExamsList.find(e => (e.code && e.code.toLowerCase() === (item.code || '').toLowerCase()) || (e.name && e.name.toLowerCase() === (item.name || '').toLowerCase()));
      item.price = getExamPriceForConvenio(foundInAvailable || item);
    });
    renderExamsTable();
    calcFinancials();
    updateConvenioUI();
  }

  let currentGenericItemsList = [];

  function getGenericSearchItems(type) {
    if (type === 'exame') {
      if (availableExamsList && availableExamsList.length > 0) {
        return availableExamsList.map(e => ({
          code: e.code || 'EXAME',
          name: e.name || e.nome || 'Exame Sem Nome',
          details: [
            e.category ? `Cat: ${e.category}` : '',
            e.fasting ? `Jejum: ${e.fasting}` : '',
            e.material ? `Mat: ${e.material}` : (Array.isArray(e.materiaisColetados) && e.materiaisColetados.length > 0 ? `Mat: ${e.materiaisColetados.join(', ')}` : '')
          ].filter(Boolean).join(' • ') || 'Exame do Catálogo LIS',
          raw: e
        }));
      }
      return [];
    }

    if (type === 'convenio') {
      if (conveniosListFromDb && conveniosListFromDb.length > 0) {
        return conveniosListFromDb.map(c => ({
          code: c.codigo ? `Cód ${c.codigo}` : (c.id ? `ID ${c.id}` : 'CONV'),
          name: c.fantasia || c.razaoSocial || 'Convênio sem nome',
          details: [
            c.razaoSocial && c.razaoSocial !== c.fantasia ? `Razão: ${c.razaoSocial}` : '',
            c.registroAns ? `ANS: ${c.registroAns}` : '',
            c.cnpj ? `CNPJ: ${c.cnpj}` : ''
          ].filter(Boolean).join(' • ') || 'Convênio Cadastrado no Sistema',
          raw: c
        }));
      }
      return [];
    }

    if (type === 'medico') {
      if (medicosListFromDb && medicosListFromDb.length > 0) {
        return medicosListFromDb.map(m => ({
          code: `${m.conselho || 'CRM'} ${m.numero || ''}/${m.uf || 'PR'}`,
          name: m.nome,
          details: [
            m.especialidade ? `Espec: ${m.especialidade}` : '',
            m.cpf ? `CPF: ${m.cpf}` : '',
            (m.telefone || m.whatsapp) ? `Tel: ${m.telefone || m.whatsapp}` : ''
          ].filter(Boolean).join(' • ') || 'Médico Cadastrado no Sistema',
          raw: m
        }));
      } else {
        const defaults = [
          { name: 'Dr. Carlos Eduardo', code: 'CRM 12345/PR', details: 'Clínica Médica / Geral' },
          { name: 'Dra. Ana Paula', code: 'CRM 23456/PR', details: 'Pediatria / Medicina da Família' },
          { name: 'Dr. Marcos Roberto', code: 'CRM 34567/PR', details: 'Cardiologia' },
          { name: 'Dra. Juliana Lima', code: 'CRM 45678/SP', details: 'Ginecologia e Obstetrícia' }
        ];
        return defaults.map(d => ({
          code: d.code,
          name: d.name,
          details: d.details,
          raw: null
        }));
      }
    }

    const staticLists = {
      situacao: ['Normal', 'Urgente', 'Prioritário', 'Aguardando Coleta'],
      coleta: ['Sede / Central', 'Posto Cambará', 'Posto Jacarezinho', 'Coleta Domiciliar', 'Hospital Municipal'],
      destino: ['Laboratório Principal', 'Apoio Hermes Pardini', 'Apoio Fleury', 'Apoio DB Diagnósticos'],
      empresa: ['InovaLab Cambará', 'Prefeitura Municipal', 'Usina Jacarezinho', 'Empresa Teste LTDA'],
      dum: ['Informado no formulário', 'Não informado', 'Menopausa', 'Gestante', 'Histerectomia']
    };

    const arr = staticLists[type] || [];
    return arr.map((item, idx) => ({
      code: `OPÇÃO #${idx + 1}`,
      name: item,
      details: `Opção predefinida para ${type}`,
      raw: item
    }));
  }

