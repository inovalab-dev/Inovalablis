<script>
  // Dados sincronizados do backend
  let patientsList = <%- JSON.stringify(patients) %>;
  let requisitionsData = <%- JSON.stringify(requisitions) %>;
  const templatesData = <%- JSON.stringify(messageTemplates) %>;
  const availableExamsList = <%- JSON.stringify(exams || []) %>;

  let currentRequisitionExams = [];
  let selectedPatientInModal = null;
  let activeSearchType = null;

  let pendingValidationFocusAction = null;

  // Validar campos obrigatórios da Etapa 1
  function validateStep1() {
    const patientName = document.getElementById('req-patientName')?.value?.trim() || '';
    const convenio = document.getElementById('req-convenio')?.value?.trim() || '';
    const doctorName = document.getElementById('req-doctorName')?.value?.trim() || '';
    const errors = [];

    const convSelect = document.getElementById('req-convenio');
    const doctorInput = document.getElementById('req-doctorName');
    const patientCard = document.getElementById('patientCardDisplay');

    if (convSelect) {
      convSelect.classList.remove('ring-2', 'ring-rose-500', 'border-rose-500', 'bg-rose-50');
    }
    if (doctorInput) {
      doctorInput.classList.remove('ring-2', 'ring-rose-500', 'border-rose-500', 'bg-rose-50');
    }
    if (patientCard) {
      patientCard.classList.remove('ring-2', 'ring-rose-500', 'border-rose-500');
    }

    let firstMissing = null;

    if (!patientName) {
      errors.push({ field: 'Paciente', msg: 'Nenhum paciente selecionado. É necessário selecionar um paciente cadastrado.' });
      if (patientCard) {
        patientCard.classList.add('ring-2', 'ring-rose-500', 'border-rose-500');
      }
      if (!firstMissing) firstMissing = 'patient';
    }

    if (!convenio) {
      errors.push({ field: 'Convênio', msg: 'O campo Convênio é obrigatório. Por favor, selecione um convênio cadastrado.' });
      if (convSelect) {
        convSelect.classList.add('ring-2', 'ring-rose-500', 'border-rose-500');
      }
      if (!firstMissing) firstMissing = 'convenio';
    }

    if (!doctorName) {
      errors.push({ field: 'Médico Solicitante', msg: 'O preenchimento do Médico Solicitante é obrigatório.' });
      if (doctorInput) {
        doctorInput.classList.add('ring-2', 'ring-rose-500', 'border-rose-500');
      }
      if (!firstMissing) firstMissing = 'doctor';
    }

    return { isValid: errors.length === 0, errors, firstMissing };
  }

  // Validar requisição completa (Etapa 1 + Exames)
  function validateFullRequisition() {
    const step1Result = validateStep1();
    const errors = [...step1Result.errors];
    let firstMissing = step1Result.firstMissing;

    if (!currentRequisitionExams || !Array.isArray(currentRequisitionExams) || currentRequisitionExams.length === 0) {
      errors.push({ field: 'Exames da Requisição', msg: 'A requisição deve conter ao menos 1 (um) exame adicionado.' });
      if (!firstMissing) firstMissing = 'exam';
    }

    return { isValid: errors.length === 0, errors, firstMissing };
  }

  function showStep1ValidationError(errors, firstMissing) {
    pendingValidationFocusAction = firstMissing;
    const modal = document.getElementById('validationErrorModal');
    const alertList = document.getElementById('validationErrorModalList');

    if (!modal || !alertList) return;

    alertList.innerHTML = '';
    errors.forEach(item => {
      const li = document.createElement('li');
      li.className = 'flex items-start gap-2.5 p-3 bg-slate-50 border border-slate-200/90 text-slate-700 rounded-xl text-xs font-medium';
      li.innerHTML = `<span class="text-amber-600 font-bold text-sm shrink-0">⚠️</span> <div><strong class="font-extrabold text-slate-800 uppercase text-[10px] block tracking-wider mb-0.5">${item.field}</strong><span class="text-slate-600">${item.msg}</span></div>`;
      alertList.appendChild(li);
    });

    modal.classList.remove('hidden');
  }

  function closeValidationErrorModal() {
    const modal = document.getElementById('validationErrorModal');
    if (modal) modal.classList.add('hidden');

    const action = pendingValidationFocusAction;
    pendingValidationFocusAction = null;

    if (action === 'patient') {
      switchRequisitionStep(1, true);
      openPatientSearchModal();
    } else if (action === 'convenio') {
      switchRequisitionStep(1, true);
      const convSelect = document.getElementById('req-convenio');
      if (convSelect) convSelect.focus();
    } else if (action === 'doctor') {
      switchRequisitionStep(1, true);
      const doctorInput = document.getElementById('req-doctorName');
      if (doctorInput) doctorInput.focus();
    } else if (action === 'exam') {
      switchRequisitionStep(2, true);
      const examInput = document.getElementById('req-examSearchInput');
      if (examInput) examInput.focus();
    }
  }

  function clearStep1ValidationError() {
    const modal = document.getElementById('validationErrorModal');
    if (modal) modal.classList.add('hidden');

    const convSelect = document.getElementById('req-convenio');
    const doctorInput = document.getElementById('req-doctorName');
    const patientCard = document.getElementById('patientCardDisplay');
    if (convSelect) {
      convSelect.classList.remove('ring-2', 'ring-rose-500', 'border-rose-500', 'bg-rose-50');
    }
    if (doctorInput) {
      doctorInput.classList.remove('ring-2', 'ring-rose-500', 'border-rose-500', 'bg-rose-50');
    }
    if (patientCard) {
      patientCard.classList.remove('ring-2', 'ring-rose-500', 'border-rose-500');
    }
  }

  // Alternar entre Etapa 1 e Etapa 2 no Modal
  function switchRequisitionStep(step, force = false) {
    if (step === 2 && !force) {
      const validation = validateStep1();
      if (!validation.isValid) {
        showStep1ValidationError(validation.errors, validation.firstMissing);
        return false;
      } else {
        clearStep1ValidationError();
      }
    } else if (step === 1) {
      clearStep1ValidationError();
    }

    const step1 = document.getElementById('requisitionStep1');
    const step2 = document.getElementById('requisitionStep2');
    const btn1 = document.getElementById('stepTabBtn1');
    const btn2 = document.getElementById('stepTabBtn2');

    if (step === 1) {
      if (step1) step1.classList.remove('hidden');
      if (step2) step2.classList.add('hidden');

      if (btn1) {
        btn1.className = "px-3.5 py-1.5 rounded-xl text-xs font-black transition-all flex items-center gap-2 bg-white text-emerald-950 shadow-xs cursor-pointer";
        const dot = btn1.querySelector('span');
        if (dot) dot.className = "w-2 h-2 rounded-full bg-emerald-500";
      }
      if (btn2) {
        btn2.className = "px-3.5 py-1.5 rounded-xl text-xs font-black transition-all flex items-center gap-2 text-gray-600 hover:text-gray-900 cursor-pointer";
        const dot = btn2.querySelector('span');
        if (dot) dot.className = "w-2 h-2 rounded-full bg-gray-400";
      }
    } else {
      if (step1) step1.classList.add('hidden');
      if (step2) step2.classList.remove('hidden');

      if (btn2) {
        btn2.className = "px-3.5 py-1.5 rounded-xl text-xs font-black transition-all flex items-center gap-2 bg-white text-emerald-950 shadow-xs cursor-pointer";
        const dot = btn2.querySelector('span');
        if (dot) dot.className = "w-2 h-2 rounded-full bg-emerald-500";
      }
      if (btn1) {
        btn1.className = "px-3.5 py-1.5 rounded-xl text-xs font-black transition-all flex items-center gap-2 text-gray-600 hover:text-gray-900 cursor-pointer";
        const dot = btn1.querySelector('span');
        if (dot) dot.className = "w-2 h-2 rounded-full bg-gray-400";
      }
    }
  }

  // --- GERENCIAMENTO DE EXAMES DA REQUISIÇÃO ---
  let currentlySelectedExamForInput = null;

  function populateExamMaterialsCombo(exam) {
    const materialSelect = document.getElementById('req-examMaterial');
    if (!materialSelect) return;

    materialSelect.innerHTML = '<option value="">Selecione o material...</option>';

    if (!exam) {
      materialSelect.value = '';
      return;
    }

    let mats = [];
    if (Array.isArray(exam.materiaisColetados) && exam.materiaisColetados.length > 0) {
      mats = exam.materiaisColetados;
    } else if (Array.isArray(exam.materiais) && exam.materiais.length > 0) {
      mats = exam.materiais;
    }

    const addedNames = new Set();

    if (mats.length > 0) {
      mats.forEach(m => {
        let matName = '';
        if (typeof m === 'object' && m !== null) {
          matName = (m.nome || m.material || m.abrev || '').trim();
        } else {
          matName = String(m || '').trim();
        }
        if (matName && !addedNames.has(matName.toLowerCase())) {
          addedNames.add(matName.toLowerCase());
          const opt = document.createElement('option');
          opt.value = matName;
          opt.textContent = matName;
          materialSelect.appendChild(opt);
        }
      });
    }

    if (addedNames.size === 0 && (exam.material || exam.category)) {
      const matName = (exam.material || exam.category).trim();
      if (matName) {
        addedNames.add(matName.toLowerCase());
        const opt = document.createElement('option');
        opt.value = matName;
        opt.textContent = matName;
        materialSelect.appendChild(opt);
      }
    }

    if (addedNames.size === 0) {
      const defaultMats = ['Sangue', 'Sangue Total', 'Soro', 'Plasma', 'Urina', 'Fezes', 'Escarrado', 'Swab', 'Líquor', 'Outro'];
      defaultMats.forEach(dm => {
        const opt = document.createElement('option');
        opt.value = dm;
        opt.textContent = dm;
        materialSelect.appendChild(opt);
      });
    }

    // Deve ficar vazio após o cliente selecionar o exame
    materialSelect.value = '';
  }

  function onReqExamMaterialChange() {
    const materialSelect = document.getElementById('req-examMaterial');
    const priceInput = document.getElementById('req-examPrice');
    if (!materialSelect || !priceInput) return;

    const selectedMat = materialSelect.value.trim();
    if (!selectedMat) {
      priceInput.value = '';
      return;
    }

    if (currentlySelectedExamForInput) {
      const examWithMat = { ...currentlySelectedExamForInput, material: selectedMat };
      const price = getExamPriceForConvenio(examWithMat);
      priceInput.value = price.toFixed(2);
    }
  }

  function addExamToRequisition(exam) {
    if (!exam) return false;

    const newCode = (exam.code || '').trim().toUpperCase();
    const newName = (exam.name || '').trim().toUpperCase();
    const newMat = (exam.material || exam.category || 'Sangue').trim().toUpperCase();

    const isDuplicate = currentRequisitionExams.some(item => {
      const itemCode = (item.code || '').trim().toUpperCase();
      const itemName = (item.name || '').trim().toUpperCase();
      const itemMat = (item.material || '').trim().toUpperCase();

      const sameExam = (newCode && itemCode === newCode) || (newName && itemName === newName);
      const sameMaterial = itemMat === newMat;
      return sameExam && sameMaterial;
    });

    if (isDuplicate) {
      alert('Este exame já foi lançado na requisição para este mesmo material biológico.');
      return false;
    }

    currentRequisitionExams.push({
      code: exam.code || 'EX' + (currentRequisitionExams.length + 1),
      name: exam.name || 'Exame Personalizado',
      category: exam.category || 'Geral',
      material: exam.material || exam.category || 'Sangue',
      price: exam.pricePrivate !== undefined ? exam.pricePrivate : getExamPriceForConvenio(exam),
      fasting: exam.fasting || 'Não informado',
      timeframe: exam.timeframe || '24 horas',
      instructions: exam.instructions || 'Procedimento padrão do laboratório.',
      status: exam.status || 'A Coletar'
    });

    renderExamsTable();
    calcFinancials();

    const searchInput = document.getElementById('req-examSearchInput');
    const priceInput = document.getElementById('req-examPrice');
    const list = document.getElementById('examAutocompleteList');
    if (searchInput) searchInput.value = '';
    if (priceInput) priceInput.value = '';
    if (list) list.classList.add('hidden');

    currentlySelectedExamForInput = null;
    populateExamMaterialsCombo(null);
    return true;
  }

  function addManualExamFromInput() {
    const nameInput = document.getElementById('req-examSearchInput');
    const materialSelect = document.getElementById('req-examMaterial');
    const priceInput = document.getElementById('req-examPrice');

    const name = nameInput ? nameInput.value.trim() : '';
    if (!name) {
      alert('Digite o código ou nome do exame.');
      return;
    }

    const material = materialSelect ? materialSelect.value.trim() : '';
    if (!material) {
      alert('Por favor, selecione o Material Biológico.');
      if (materialSelect) materialSelect.focus();
      return;
    }

    let examObj = null;
    if (currentlySelectedExamForInput) {
      const price = priceInput && priceInput.value !== '' 
        ? parseFloat(priceInput.value) 
        : getExamPriceForConvenio({ ...currentlySelectedExamForInput, material });

      examObj = {
        code: currentlySelectedExamForInput.code,
        name: currentlySelectedExamForInput.name,
        category: currentlySelectedExamForInput.category || 'Geral',
        material: material,
        pricePrivate: price,
        fasting: currentlySelectedExamForInput.fasting || '4h',
        timeframe: currentlySelectedExamForInput.timeframe || '24h',
        instructions: currentlySelectedExamForInput.instructions || 'Procedimento padrão do laboratório.'
      };
    } else {
      const price = priceInput && priceInput.value !== '' ? parseFloat(priceInput.value) : 0;
      examObj = {
        code: name.slice(0, 6).toUpperCase(),
        name: name,
        category: material,
        material: material,
        pricePrivate: price,
        fasting: 'Recomendado 4 horas',
        timeframe: '24 horas',
        instructions: 'Instruções padrão para ' + name
      };
    }

    addExamToRequisition(examObj);
  }

  function quickAddExam(code) {
    const found = availableExamsList.find(e => (e.code || '').toLowerCase() === (code || '').toLowerCase());
    if (found) {
      selectExamFromAutocomplete(found.code);
    } else {
      const nameInput = document.getElementById('req-examSearchInput');
      if (nameInput) nameInput.value = code;
      currentlySelectedExamForInput = null;
      populateExamMaterialsCombo(null);
    }
  }

  function addQuickExamByCodeDirect() {
    const input = document.getElementById('req-quickCodeInput');
    if (!input) return;
    const rawVal = input.value.trim();
    if (!rawVal) return;

    const queryUpper = rawVal.toUpperCase();

    let found = availableExamsList.find(e => (e.code || '').toUpperCase() === queryUpper);
    if (!found) {
      found = availableExamsList.find(e => (e.code || '').toUpperCase().startsWith(queryUpper));
    }
    if (!found) {
      found = availableExamsList.find(e => (e.name || '').toUpperCase().includes(queryUpper));
    }

    if (found) {
      selectExamFromAutocomplete(found.code);
    } else {
      const nameInput = document.getElementById('req-examSearchInput');
      if (nameInput) nameInput.value = queryUpper;
      currentlySelectedExamForInput = null;
      populateExamMaterialsCombo(null);
    }

    input.value = '';
    input.focus();
  }

  function removeExamFromRequisition(index) {
    if (index >= 0 && index < currentRequisitionExams.length) {
      currentRequisitionExams.splice(index, 1);
      renderExamsTable();
      calcFinancials();
    }
  }

  let draggedExamIndex = null;

  function handleExamDragStart(e, index) {
    draggedExamIndex = index;
    e.dataTransfer.effectAllowed = 'move';
    e.dataTransfer.setData('text/plain', index);
    e.currentTarget.classList.add('opacity-40', 'bg-emerald-100');
  }

  function handleExamDragOver(e) {
    e.preventDefault();
    e.dataTransfer.dropEffect = 'move';
    const tr = e.currentTarget;
    tr.classList.add('bg-emerald-100/80', 'border-y-2', 'border-emerald-500');
  }

  function handleExamDragLeave(e) {
    const tr = e.currentTarget;
    tr.classList.remove('bg-emerald-100/80', 'border-y-2', 'border-emerald-500');
  }

  function handleExamDrop(e, targetIndex) {
    e.preventDefault();
    const tr = e.currentTarget;
    tr.classList.remove('bg-emerald-100/80', 'border-y-2', 'border-emerald-500');

    if (draggedExamIndex === null || draggedExamIndex === targetIndex) return;

    const movedExam = currentRequisitionExams.splice(draggedExamIndex, 1)[0];
    currentRequisitionExams.splice(targetIndex, 0, movedExam);

    draggedExamIndex = null;
    renderExamsTable();
    if (typeof calcFinancials === 'function') calcFinancials();
  }

  function handleExamDragEnd(e) {
    e.currentTarget.classList.remove('opacity-40', 'bg-emerald-100');
    draggedExamIndex = null;
    document.querySelectorAll('#addedExamsTbody tr').forEach(tr => {
      tr.classList.remove('opacity-40', 'bg-emerald-100/80', 'border-y-2', 'border-emerald-500');
    });
  }

  function renderExamsTable() {
    const tbody = document.getElementById('addedExamsTbody');
    const countBadge = document.getElementById('examsCountBadge');
    const stepBadge = document.getElementById('stepTabExamsBadge');
    const jsonInput = document.getElementById('req-examsJson');

    if (jsonInput) jsonInput.value = JSON.stringify(currentRequisitionExams);

    if (!tbody) return;

    if (currentRequisitionExams.length === 0) {
      tbody.innerHTML = `
        <tr id="addedExamsEmptyRow">
          <td colspan="8" class="px-4 py-8 text-center text-gray-400 italic">
            <div class="flex flex-col items-center justify-center gap-1">
              <span class="text-2xl">🧪</span>
              <span class="font-bold text-gray-600 text-xs">Nenhum exame adicionado a esta requisição</span>
              <span class="text-[11px] text-gray-400">Utilize o campo acima para pesquisar ou clique nos atalhos rápidos</span>
            </div>
          </td>
        </tr>
      `;
      if (countBadge) countBadge.textContent = '0 Exames';
      if (stepBadge) stepBadge.textContent = '0 exames (R$ 0,00)';
      updatePrepInfoCard();
      return;
    }

    let html = '';
    let subtotal = 0;

    currentRequisitionExams.forEach((e, idx) => {
      const price = parseFloat(e.price) || 0;
      subtotal += price;

      html += `
        <tr class="hover:bg-emerald-50/60 cursor-grab active:cursor-grabbing transition-colors text-xs" 
            draggable="true" 
            data-index="${idx}"
            ondragstart="handleExamDragStart(event, ${idx})"
            ondragover="handleExamDragOver(event)"
            ondragleave="handleExamDragLeave(event)"
            ondrop="handleExamDrop(event, ${idx})"
            ondragend="handleExamDragEnd(event)"
            onclick="selectExamForPrepInfo(${idx})">
          <td class="px-3 py-2 font-mono text-gray-400 font-bold select-none"><span class="text-gray-400 text-sm mr-1">⠿</span>${idx + 1}</td>
          <td class="px-3 py-2 font-mono font-bold text-emerald-800">${e.code}</td>
          <td class="px-3 py-2 font-black text-gray-900">${e.name}</td>
          <td class="px-3 py-2"><span class="bg-gray-100 text-gray-700 px-2 py-0.5 rounded font-mono text-[10px]">${e.material || e.category || 'Sangue'}</span></td>
          <td class="px-3 py-2 font-mono text-[11px] font-bold text-amber-800"><span class="bg-amber-50 text-amber-900 border border-amber-200 px-2 py-0.5 rounded font-mono text-[10px]">${e.fasting || 'Sem jejum'}</span></td>
          <td class="px-3 py-2 font-mono text-[11px] text-gray-500">${e.timeframe || '24h'}</td>
          <td class="px-3 py-2 text-right font-mono font-bold text-emerald-900">R$ ${price.toFixed(2).replace('.', ',')}</td>
          <td class="px-3 py-2 text-center" onclick="event.stopPropagation()">
            <button type="button" onclick="removeExamFromRequisition(${idx})" class="p-1 text-rose-500 hover:text-rose-700 hover:bg-rose-50 rounded-lg transition-colors cursor-pointer" title="Remover Exame">
              🗑️
            </button>
          </td>
        </tr>
      `;
    });

    tbody.innerHTML = html;

    if (countBadge) countBadge.textContent = currentRequisitionExams.length + ' Exame(s)';
    if (stepBadge) stepBadge.textContent = `${currentRequisitionExams.length} exame(s) (R$ ${subtotal.toFixed(2).replace('.', ',')})`;

    updatePrepInfoCard();
  }

  function updatePrepInfoCard() {
    const maxFastingDisplay = document.getElementById('maxFastingDisplayVal');
    const listContainer = document.getElementById('prepExamsListContainer');

    if (!listContainer) return;

    if (!currentRequisitionExams || currentRequisitionExams.length === 0) {
      if (maxFastingDisplay) maxFastingDisplay.textContent = 'Sem exames';
      listContainer.innerHTML = `
        <div class="bg-white p-4 rounded-xl border border-slate-200 text-center text-slate-400 italic text-xs">
          Nenhum exame adicionado. Ao selecionar ou lançar exames, as orientações de preparo serão listadas automaticamente aqui.
        </div>
      `;
      return;
    }

    // Calcular o maior jejum em horas entre todos os exames adicionados
    let maxHours = 0;
    let maxHoursExam = '';

    currentRequisitionExams.forEach(e => {
      const fStr = (e.fasting || '').toString();
      const matches = fStr.match(/\d+/g);
      if (matches) {
        matches.forEach(mStr => {
          const num = parseInt(mStr, 10);
          if (num > maxHours && num <= 48) {
            maxHours = num;
            maxHoursExam = e.name;
          }
        });
      }
    });

    if (maxFastingDisplay) {
      if (maxHours > 0) {
        maxFastingDisplay.textContent = `${maxHours} Horas (${maxHoursExam || 'Exame LIS'})`;
      } else {
        maxFastingDisplay.textContent = 'Sem exigência de jejum prolongado';
      }
    }

    // Listar as orientações de TODOS os exames da requisição
    let html = '';
    currentRequisitionExams.forEach((e) => {
      html += `
        <div class="bg-white p-3 rounded-xl border border-slate-200 space-y-1.5 hover:border-emerald-300 transition-colors">
          <div class="flex items-center justify-between gap-2 flex-wrap">
            <div class="flex items-center gap-1.5 font-bold text-slate-800 text-xs">
              <span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0"></span>
              <span class="font-mono text-[10px] text-emerald-800 bg-emerald-100 px-1.5 py-0.5 rounded font-extrabold">${e.code}</span>
              <span class="text-slate-900">${e.name}</span>
            </div>
            <span class="bg-amber-50 text-amber-900 border border-amber-200 font-mono text-[10px] font-bold px-2 py-0.5 rounded-full">
              ⌛ Jejum: ${e.fasting || 'Não informado'}
            </span>
          </div>
          <div class="text-[11px] text-slate-600 flex items-center justify-between font-mono pt-0.5">
            <span>Amostra: <b>${e.material || e.category || 'Sangue'}</b></span>
            <span>Prazo Laudo: <b>${e.timeframe || '24h'}</b></span>
          </div>
          <div class="text-[11px] text-slate-600 bg-slate-50 p-2 rounded-lg border border-slate-100 mt-1">
            💡 <b>Orientações de Coleta & Preparo:</b> ${e.instructions || 'Procedimento padrão de coleta laboratorial.'}
          </div>
        </div>
      `;
    });

    listContainer.innerHTML = html;
  }

  function openPrepInstructionsModal() {
    updatePrepInfoCard();
    const modal = document.getElementById('modalPrepInstructions');
    if (modal) modal.classList.remove('hidden');
  }

  function closePrepInstructionsModal() {
    const modal = document.getElementById('modalPrepInstructions');
    if (modal) modal.classList.add('hidden');
  }

  function selectExamForPrepInfo(idx) {
    const exam = currentRequisitionExams[idx];
    if (!exam) return;
    openPrepInstructionsModal();
  }

  // --- CÁLCULOS FINANCEIROS COMPLETOS ---
  function calcFinancials() {
    let subtotal = 0;
    currentRequisitionExams.forEach(e => {
      subtotal += parseFloat(e.price) || 0;
    });

    const discountInput = document.getElementById('req-discount');
    const discount = discountInput ? (parseFloat(discountInput.value) || 0) : 0;

    let total = subtotal - discount;
    if (total < 0) total = 0;

    const paidInput = document.getElementById('req-paidAmount');
    const paid = paidInput ? (parseFloat(paidInput.value) || 0) : 0;

    const remaining = total - paid;

    const subtotalDisplay = document.getElementById('req-subtotalSummary');
    const tableSubtotalVal = document.getElementById('tableSubtotalVal');
    const subtotalInput = document.getElementById('req-subtotalInput');
    const totalDisplay = document.getElementById('req-totalAmountDisplay');
    const totalInput = document.getElementById('req-totalAmountInput');
    const remainingLabel = document.getElementById('req-remainingBalanceLabel');
    const remainingDisplay = document.getElementById('req-remainingBalanceDisplay');
    const statusSelect = document.getElementById('req-financialStatus');

    if (subtotalDisplay) subtotalDisplay.textContent = 'R$ ' + subtotal.toFixed(2).replace('.', ',');
    if (tableSubtotalVal) tableSubtotalVal.textContent = 'R$ ' + subtotal.toFixed(2).replace('.', ',');
    if (subtotalInput) subtotalInput.value = subtotal.toFixed(2);

    if (totalDisplay) totalDisplay.textContent = 'R$ ' + total.toFixed(2).replace('.', ',');
    if (totalInput) totalInput.value = total.toFixed(2);

    if (remainingDisplay && remainingLabel) {
      if (remaining <= 0) {
        remainingLabel.textContent = 'Troco / Quitado:';
        remainingLabel.className = 'text-emerald-400 font-bold';
        remainingDisplay.textContent = 'R$ ' + Math.abs(remaining).toFixed(2).replace('.', ',');
        remainingDisplay.className = 'text-emerald-300 font-black';
      } else {
        remainingLabel.textContent = 'Saldo Devedor:';
        remainingLabel.className = 'text-amber-400 font-bold';
        remainingDisplay.textContent = 'R$ ' + remaining.toFixed(2).replace('.', ',');
        remainingDisplay.className = 'text-amber-300 font-black';
      }
    }

    if (statusSelect) {
      const pm = document.getElementById('req-paymentMethod')?.value || '';
      if (pm.includes('Convênio')) {
        statusSelect.value = 'Faturado Convênio';
      } else if (pm.includes('Cortesia')) {
        statusSelect.value = 'Cortesia';
      } else if (paid >= total && total > 0) {
        statusSelect.value = 'Pago';
      } else if (paid > 0 && paid < total) {
        statusSelect.value = 'Parcial';
      } else if (paid === 0) {
        statusSelect.value = 'Pendente';
      }
    }

    const stepBadge = document.getElementById('stepTabExamsBadge');
    if (stepBadge) {
      stepBadge.textContent = `${currentRequisitionExams.length} exame(s) (R$ ${total.toFixed(2).replace('.', ',')})`;
    }
  }

  // --- AUTOCOMPLETE DE EXAMES NA BUSCA ---
  function filterExamAutocomplete(val) {
    const list = document.getElementById('examAutocompleteList');
    if (!list) return;

    const q = (val || '').trim().toLowerCase();
    if (!q || q.length < 1) {
      list.classList.add('hidden');
      currentlySelectedExamForInput = null;
      populateExamMaterialsCombo(null);
      return;
    }

    if (currentlySelectedExamForInput) {
      const exName = (currentlySelectedExamForInput.name || '').toLowerCase();
      const exCode = (currentlySelectedExamForInput.code || '').toLowerCase();
      if (!val.toLowerCase().includes(exCode) && !val.toLowerCase().includes(exName)) {
        currentlySelectedExamForInput = null;
        populateExamMaterialsCombo(null);
      }
    }

    const matches = availableExamsList.filter(e => 
      (e.code || '').toLowerCase().includes(q) ||
      (e.name || '').toLowerCase().includes(q) ||
      (e.category || '').toLowerCase().includes(q)
    ).slice(0, 10);

    if (matches.length === 0) {
      list.innerHTML = `
        <div class="p-3 text-center text-gray-500 italic text-xs">
          Nenhum exame encontrado com "${val}". Clique em <b>+ Add</b> para incluir como personalizado.
        </div>
      `;
      list.classList.remove('hidden');
      return;
    }

    let html = '';
    matches.forEach(e => {
      const price = getExamPriceForConvenio(e);
      html += `
        <div class="p-3 hover:bg-emerald-50 cursor-pointer flex items-center justify-between transition-colors border-b border-gray-100" onclick="selectExamFromAutocomplete('${e.code}')">
          <div>
            <div class="flex items-center gap-2">
              <span class="font-mono font-extrabold text-emerald-800 text-xs bg-emerald-100 px-1.5 py-0.5 rounded">${e.code}</span>
              <strong class="text-gray-900 text-xs">${e.name}</strong>
            </div>
            <p class="text-[10px] text-gray-500 mt-0.5 font-mono">Categoria: ${e.category || 'Geral'} | Jejum: ${e.fasting || '4h'}</p>
          </div>
          <span class="font-mono font-black text-emerald-800 text-xs">R$ ${price.toFixed(2).replace('.', ',')}</span>
        </div>
      `;
    });

    list.innerHTML = html;
    list.classList.remove('hidden');
  }

  function selectExamFromAutocomplete(code) {
    const found = availableExamsList.find(e => (e.code || '').toLowerCase() === (code || '').toLowerCase());
    if (found) {
      currentlySelectedExamForInput = found;
      const searchInput = document.getElementById('req-examSearchInput');
      const priceInput = document.getElementById('req-examPrice');
      const list = document.getElementById('examAutocompleteList');

      if (searchInput) searchInput.value = `[${found.code}] ${found.name}`;
      if (list) list.classList.add('hidden');

      populateExamMaterialsCombo(found);

      if (priceInput) priceInput.value = '';

      const materialSelect = document.getElementById('req-examMaterial');
      if (materialSelect) materialSelect.focus();
    }
  }

  // Mask helper for CPF
  function applyCpfMask(v) {
    if (!v) return '';
    v = v.replace(/\D/g, '');
    if (v.length > 11) v = v.substring(0, 11);
    return v
      .replace(/(\d{3})(\d)/, '$1.$2')
      .replace(/(\d{3})(\d)/, '$1.$2')
      .replace(/(\d{3})(\d{1,2})$/, '$1-$2');
  }

  // Calculation of Age
  function calcReqAge() {
    const dob = document.getElementById('req-patientBirthDate').value;
    if (!dob) {
      document.getElementById('req-patientAge').value = '';
      return;
    }
    const birth = new Date(dob);
    const now = new Date();
    let years = now.getFullYear() - birth.getFullYear();
    let months = now.getMonth() - birth.getMonth();
    if (months < 0 || (months === 0 && now.getDate() < birth.getDate())) {
      years--;
    }
    document.getElementById('req-patientAge').value = years + ' ano(s)';
  }

  function calcModalPAge() {
    const dob = document.getElementById('modal-p-birthDate').value;
    if (!dob) return;
    const birth = new Date(dob);
    const now = new Date();
    let years = now.getFullYear() - birth.getFullYear();
    if (now.getMonth() < birth.getMonth() || (now.getMonth() === birth.getMonth() && now.getDate() < birth.getDate())) {
      years--;
    }
    document.getElementById('modal-p-ageValue').value = years;
  }

  // Preencher Formulario de Requisição a partir de um Objeto Paciente
  function fillPatientIntoRequisition(p) {
    if (!p) return;
    document.getElementById('req-patientCode').value = p.code || p.id || '';
    document.getElementById('req-patientName').value = p.name || '';
    document.getElementById('req-patientBirthDate').value = p.birthDate || '';
    calcReqAge();
    if (p.sex) document.getElementById('req-patientSex').value = p.sex;
    document.getElementById('req-address').value = p.street ? (p.street + (p.number ? ', ' + p.number : '') + (p.neighborhood ? ' - ' + p.neighborhood : '')) : '';
    document.getElementById('req-complement').value = p.complement || '';
    document.getElementById('req-city').value = p.city || 'Cambará';
    document.getElementById('req-cep').value = p.cep || '';
    document.getElementById('req-patientPhone').value = p.whatsapp || p.phone || '';
    document.getElementById('req-responsibleName').value = p.responsibleName || p.motherName || '';
    document.getElementById('req-clinicalNotes').value = p.clinicalNotes || '';
    
    const convSelect = document.getElementById('req-convenio');
    const isEditingExistingReq = !!document.getElementById('req-id').value;

    if (isEditingExistingReq) {
      const pConv = p.convenio || '';
      const pConvCode = p.convenioCode || '';
      const pConvId = p.convenioId || '';

      if (convSelect) {
        if (pConv) {
          let optionExists = Array.from(convSelect.options).some(opt => opt.value === pConv);
          if (!optionExists) {
            const newOpt = document.createElement('option');
            newOpt.value = pConv;
            newOpt.setAttribute('data-code', pConvCode);
            newOpt.setAttribute('data-id', pConvId);
            newOpt.textContent = `[Cód ${pConvCode || '?'}] ${pConv}`;
            convSelect.appendChild(newOpt);
          }
          convSelect.value = pConv;
          document.getElementById('req-convenioCode').value = pConvCode;
          if (document.getElementById('req-convenioId')) document.getElementById('req-convenioId').value = pConvId;
        } else {
          convSelect.value = '';
          document.getElementById('req-convenioCode').value = '';
          if (document.getElementById('req-convenioId')) document.getElementById('req-convenioId').value = '';
        }
      }
    } else {
      // Nova requisição: sempre mantém o campo Convênio limpo/vazio para forçar a escolha manual
      if (convSelect) convSelect.value = '';
      if (document.getElementById('req-convenioCode')) document.getElementById('req-convenioCode').value = '';
      if (document.getElementById('req-convenioId')) document.getElementById('req-convenioId').value = '';
    }

    if (p.weight) document.getElementById('req-weight').value = p.weight;
    if (p.height) document.getElementById('req-height').value = p.height;

    // Atualizar o card visual de texto do paciente
    updatePatientCardDisplay();
  }

  // Atualizar visualização de texto do Card "Dados do Paciente"
  function updatePatientCardDisplay() {
    const codeElem = document.getElementById('req-patientCode');
    const nameElem = document.getElementById('req-patientName');
    const birthElem = document.getElementById('req-patientBirthDate');
    const ageElem = document.getElementById('req-patientAge');
    const sexElem = document.getElementById('req-patientSex');
    const addressElem = document.getElementById('req-address');
    const cityElem = document.getElementById('req-city');
    const phoneElem = document.getElementById('req-patientPhone');
    const respElem = document.getElementById('req-responsibleName');

    const code = codeElem ? codeElem.value : '';
    const name = nameElem ? nameElem.value : '';
    const birth = birthElem ? birthElem.value : '';
    const age = ageElem ? ageElem.value : '';
    const sex = sexElem ? sexElem.value : '';
    const address = addressElem ? addressElem.value : '';
    const city = cityElem ? cityElem.value : '';
    const phone = phoneElem ? phoneElem.value : '';
    const resp = respElem ? respElem.value : '';

    const emptyState = document.getElementById('patientCardEmptyState');
    const activeState = document.getElementById('patientCardActiveState');

    if (!name && !code) {
      if (emptyState) emptyState.classList.remove('hidden');
      if (activeState) activeState.classList.add('hidden');
      return;
    }

    if (emptyState) emptyState.classList.add('hidden');
    if (activeState) activeState.classList.remove('hidden');

    // Iniciais do Avatar
    const nameParts = (name || 'Paciente').trim().split(' ');
    let initials = nameParts[0][0] || 'P';
    if (nameParts.length > 1) initials += nameParts[nameParts.length - 1][0] || '';
    const avatarEl = document.getElementById('displayPatientAvatar');
    if (avatarEl) avatarEl.textContent = initials.toUpperCase();

    const dName = document.getElementById('displayPatientName');
    if (dName) dName.textContent = name || 'Paciente sem nome';

    const dCode = document.getElementById('displayPatientCodeBadge');
    if (dCode) dCode.textContent = 'Cód: ' + (code || '—');

    // Localizar CPF cadastrado
    let patientObj = patientsList.find(p => (p.code || p.id) === code || p.name === name);
    let cpfText = 'CPF: Não informado';
    if (patientObj && patientObj.cpf) {
      cpfText = 'CPF: ' + applyCpfMask(patientObj.cpf);
    }
    const dCpf = document.getElementById('displayPatientCpf');
    if (dCpf) dCpf.textContent = cpfText;

    const dSex = document.getElementById('displayPatientSex');
    if (dSex) dSex.textContent = 'Sexo: ' + (sex || 'Não informado');

    let birthFormatted = 'Não informada';
    if (birth) {
      const parts = birth.split('-');
      if (parts.length === 3) {
        birthFormatted = `${parts[2]}/${parts[1]}/${parts[0]}`;
      } else {
        birthFormatted = birth;
      }
    }
    const dBirth = document.getElementById('displayPatientBirth');
    if (dBirth) dBirth.textContent = birthFormatted;

    const dAge = document.getElementById('displayPatientAge');
    if (dAge) dAge.textContent = age || '—';

    let fullAddress = address || '';
    if (city && !fullAddress.includes(city)) {
      fullAddress += (fullAddress ? ' - ' : '') + city;
    }
    const dAddress = document.getElementById('displayPatientAddress');
    if (dAddress) dAddress.textContent = fullAddress || 'Não informado';

