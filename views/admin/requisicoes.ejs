  function filterRequisitionsTable() {
    const input = document.getElementById('req-search-input');
    const filter = input.value.toLowerCase().trim();
    const filterDigits = filter.replace(/\D/g, '');
    const rows = document.querySelectorAll('.req-row');

    rows.forEach(row => {
      const name = row.getAttribute('data-name') || '';
      const code = row.getAttribute('data-code') || '';
      const cpf = row.getAttribute('data-cpf') || '';
      const cpfDigits = cpf.replace(/\D/g, '');
      const phone = row.getAttribute('data-phone') || '';
      const phoneDigits = phone.replace(/\D/g, '');
      const convenio = row.getAttribute('data-convenio') || '';
      const doctor = row.getAttribute('data-doctor') || '';
      const status = row.getAttribute('data-status') || '';

      const matchesText = name.includes(filter) || code.includes(filter) || cpf.includes(filter) || phone.includes(filter) || convenio.includes(filter) || doctor.includes(filter) || status.includes(filter);
      const matchesDigits = filterDigits.length >= 3 && (cpfDigits.includes(filterDigits) || phoneDigits.includes(filterDigits) || code.includes(filterDigits));

      if (matchesText || matchesDigits) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });
  }

