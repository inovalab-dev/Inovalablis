  function initReqPayMethodsSelect() {
    const methodSelect = document.getElementById('reqPayMethodSelect');
    if (!methodSelect) return;

    const currVal = methodSelect.value;
    methodSelect.innerHTML = '';
    allPaymentMethodsData.forEach(m => {
      if (m.active !== false) {
        const opt = document.createElement('option');
        opt.value = m.id;
        opt.textContent = m.name;
        methodSelect.appendChild(opt);
      }
    });

    if (currVal && Array.from(methodSelect.options).some(o => o.value === currVal)) {
      methodSelect.value = currVal;
    }

    onReqPayMethodChange();
