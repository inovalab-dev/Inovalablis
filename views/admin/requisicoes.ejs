                <select name="status" id="req-status" class="w-full px-3 py-2 bg-slate-900 border border-emerald-600 rounded-xl text-xs font-bold text-emerald-200 outline-none focus:ring-2 focus:ring-emerald-400">
                  <option value="A Coletar">🧪 A Coletar (Padrão ao Finalizar)</option>
                  <option value="Coletado">💉 Coletado</option>
                  <option value="Em Análise">🔬 Em Análise</option>
                  <option value="Liberado">✅ Liberado / Concluído</option>
                  <option value="Entregue">📦 Entregue</option>
                  <option value="Cancelado">❌ Cancelado</option>
                </select>
              </div>
            </div>

          </div>

        </div>

        <!-- BARRA DE NAVEGAÇÃO DA ETAPA 2 -->
        <div class="bg-gray-50 px-6 py-4 border-t border-gray-200 flex items-center justify-end gap-3 shrink-0 rounded-b-2xl">
          <button type="button" onclick="cancelRequisitionForm()" class="px-5 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-2xl font-bold text-xs uppercase tracking-wider transition-all cursor-pointer">
            <span>Cancelar</span>
            <span class="text-[10px] text-gray-400 font-normal ml-1">(ESC)</span>
          </button>
          
          <button type="button" onclick="switchRequisitionStep(1)" class="px-5 py-2.5 bg-gray-200 hover:bg-gray-300 text-gray-800 rounded-2xl font-bold text-xs uppercase tracking-wider transition-all cursor-pointer flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
            <span>Voltar</span>
            <span class="text-[10px] text-gray-500 font-mono">(Alt + ←)</span>
          </button>
          
          <button type="submit" class="px-6 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-2xl font-black text-xs uppercase tracking-wider shadow-md shadow-emerald-600/20 transition-all active:scale-95 cursor-pointer flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            <span>Finalizar requisição</span>
            <span class="text-[10px] opacity-80 font-mono">(Ctrl + Enter)</span>
          </button>
        </div>

      </div> <!-- Fim de requisitionStep2 -->

    </form>
  </div>
</div>

