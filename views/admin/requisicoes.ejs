  // --- CÁLCULO DE PRAZO DE ENTREGA (DIAS E DATA PREVISTA COM MARCAÇÃO DE FIM DE SEMANA) ---
  function checkDeliveryDateWeekend() {
    const dateInput = document.getElementById('req-deliveryDate');
    const warningLabel = document.getElementById('req-deliveryDateWarning');
    if (!dateInput || !dateInput.value) {
      if (warningLabel) warningLabel.classList.add('hidden');
      if (dateInput) {
        dateInput.classList.remove('border-rose-500', 'bg-rose-50', 'text-rose-900', 'ring-2', 'ring-rose-500');
        dateInput.classList.add('bg-gray-50', 'border-gray-200', 'text-emerald-900');
      }
      return false;
    }

    const parts = dateInput.value.split('-').map(Number);
    if (parts.length !== 3 || isNaN(parts[0]) || isNaN(parts[1]) || isNaN(parts[2])) {
      if (warningLabel) warningLabel.classList.add('hidden');
      return false;
    }

    const selectedDate = new Date(parts[0], parts[1] - 1, parts[2]);
    selectedDate.setHours(0, 0, 0, 0);

    const dayOfWeek = selectedDate.getDay(); // 0 = Domingo, 6 = Sábado
    const isWeekend = (dayOfWeek === 0 || dayOfWeek === 6);

    if (isWeekend) {
      dateInput.classList.add('border-rose-500', 'bg-rose-50', 'text-rose-900', 'ring-2', 'ring-rose-500');
      dateInput.classList.remove('bg-gray-50', 'border-gray-200', 'text-emerald-900');
      if (warningLabel) warningLabel.classList.remove('hidden');
    } else {
      dateInput.classList.remove('border-rose-500', 'bg-rose-50', 'text-rose-900', 'ring-2', 'ring-rose-500');
      dateInput.classList.add('bg-gray-50', 'border-gray-200', 'text-emerald-900');
      if (warningLabel) warningLabel.classList.add('hidden');
    }

    return isWeekend;
  }

  function onDeliveryDaysInput() {
    const daysInput = document.getElementById('req-deliveryDays');
    const dateInput = document.getElementById('req-deliveryDate');
    if (!daysInput || !dateInput) return;

    const rawVal = daysInput.value;
    if (rawVal === '' || rawVal === null || rawVal === undefined) {
      dateInput.value = '';
      checkDeliveryDateWeekend();
      return;
    }

    let days = parseInt(rawVal, 10);
    if (isNaN(days) || days < 0) {
      days = 0;
      daysInput.value = '0';
    }

    const today = new Date();
    today.setHours(0, 0, 0, 0);

    const targetDate = new Date(today.getFullYear(), today.getMonth(), today.getDate() + days);
    targetDate.setHours(0, 0, 0, 0);

    const yyyy = targetDate.getFullYear();
    const mm = String(targetDate.getMonth() + 1).padStart(2, '0');
    const dd = String(targetDate.getDate()).padStart(2, '0');
    dateInput.value = `${yyyy}-${mm}-${dd}`;

    checkDeliveryDateWeekend();
  }

  function onDeliveryDateChange() {
    const daysInput = document.getElementById('req-deliveryDays');
    const dateInput = document.getElementById('req-deliveryDate');
    if (!daysInput || !dateInput) return;

    const dateVal = dateInput.value;
    if (!dateVal) {
      daysInput.value = '';
      checkDeliveryDateWeekend();
      return;
    }

    const parts = dateVal.split('-').map(Number);
    if (parts.length !== 3 || isNaN(parts[0]) || isNaN(parts[1]) || isNaN(parts[2])) {
      daysInput.value = '';
      checkDeliveryDateWeekend();
      return;
    }

    const selectedDate = new Date(parts[0], parts[1] - 1, parts[2]);
    selectedDate.setHours(0, 0, 0, 0);

    const today = new Date();
    today.setHours(0, 0, 0, 0);

    const diffTime = selectedDate.getTime() - today.getTime();
    const diffDays = Math.round(diffTime / (1000 * 60 * 60 * 24));

    daysInput.value = diffDays >= 0 ? diffDays : 0;

    checkDeliveryDateWeekend();
  }

