            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          </div>
          <input type="text" id="modalFilterQuery" oninput="executePatientFilter()" onkeyup="if(event.key==='Enter') executePatientFilter()" placeholder="Digite o nome, CPF, código ou telefone do paciente..." class="w-full pl-10 pr-24 py-2.5 bg-white border border-gray-200 rounded-2xl text-xs font-semibold text-gray-900 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 shadow-2xs outline-none transition-all placeholder:text-gray-400">
          <button type="button" onclick="executePatientFilter()" class="absolute right-1.5 top-1.5 bottom-1.5 px-3 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl font-bold text-xs transition-all flex items-center gap-1 cursor-pointer shadow-xs">
            <span>Buscar</span>
          </button>
        </div>

        <!-- Seletor de Campo -->
        <div class="flex items-center gap-2">
