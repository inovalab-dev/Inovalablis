  // --- SUBMETER FORMULÁRIO PRINCIPAL ---
  async function handleFormSubmit(e) {
    e.preventDefault();
    const form = document.getElementById('requisitionMainForm');
    
    // Atualizar campo oculto de exames com o estado atual
    const hiddenExamsInput = document.getElementById('req-examsJson');
    if (hiddenExamsInput) {
      hiddenExamsInput.value = JSON.stringify(currentRequisitionExams || []);
    }

    const formData = new FormData(form);
    const data = {};
    formData.forEach((val, key) => data[key] = val);

    const validation = validateFullRequisition();
    if (!validation.isValid) {
      if (validation.firstMissing === 'exam') {
        switchRequisitionStep(2, true);
      } else {
        switchRequisitionStep(1, true);
      }
      showStep1ValidationError(validation.errors, validation.firstMissing);
      return;
    }

    try {
      const response = await fetch('/admin/requisicoes/add-ajax', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      const res = await response.json();
      if (res.success) {
        closeRequisitionFormModal();
        showSuccessRequisitionModal(res.requisitionCode || res.id, data.patientName || '');
      } else {
        showStep1ValidationError([{ field: 'Aviso do Sistema', msg: res.error || 'Verifique os dados da requisição.' }], null);
      }
    } catch (err) {
      console.error(err);
      showStep1ValidationError([{ field: 'Erro', msg: 'Erro na comunicação ao salvar requisição.' }], null);
    }
  }

