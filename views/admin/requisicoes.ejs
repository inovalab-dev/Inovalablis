        </button>

        <button type="button" onclick="openPatientRegisterModal()" class="px-4 py-2.5 bg-amber-50 hover:bg-amber-100 text-amber-800 border border-amber-200 rounded-2xl font-bold text-xs uppercase tracking-wider transition-all cursor-pointer">
