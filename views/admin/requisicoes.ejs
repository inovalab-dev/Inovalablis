            <th class="pb-2 px-3 w-32">CPF</th>
            <th class="pb-2 px-3 w-32">Nascimento / Idade</th>
            <th class="pb-2 px-3 w-32">Contato / Fone</th>
            <th class="pb-2 px-3 w-28">Cidade</th>
            <th class="pb-2 px-3 w-24 text-center">Ação</th>
          </tr>
        </thead>
        <tbody id="modalPatientsTbody">
