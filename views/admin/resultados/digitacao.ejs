            <div><span class="inline-block w-28 text-slate-600">Material:</span> <span id="laudo-material" class="font-bold text-slate-900">Soro</span></div>
            <div><span class="inline-block w-28 text-slate-600">Método  :</span> <span id="laudo-metodo" class="font-bold text-slate-900">Colorimétrico</span></div>
