<%- include('../../partials/header') %>

<div class="p-4 sm:p-6 lg:p-8 max-w-[98vw] xl:max-w-[96vw] mx-auto w-full flex-1">
  <!-- Cabeçalho Principal -->
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-6">
    <div>
      <div class="flex items-center gap-2 text-xs text-brand-neutral/60 font-mono uppercase tracking-wider mb-1">
        <span>Resultados</span>
        <span>•</span>
        <span class="text-brand-gold font-bold">Módulo de Liberação de Resultados</span>
      </div>
      <h1 class="text-2xl font-black text-[#284701] flex items-center gap-2">
        <span>📋</span> Liberação de Resultados
      </h1>
      <p class="text-xs text-brand-neutral/70 mt-1">
        Lançamento de resultados, conferência técnica, impressão e liberação de laudos laboratoriais.
      </p>
    </div>

    <!-- Badges de Estatísticas Globais -->
    <div class="flex flex-wrap items-center gap-2 sm:gap-2.5">
      <div class="bg-white px-3.5 py-2 rounded-xl border border-gray-200 shadow-2xs text-center min-w-24">
        <span class="text-[10px] font-bold text-gray-400 uppercase tracking-wider block">Requisições</span>
        <span id="stat-total" class="text-base font-black text-[#284701]">0</span>
      </div>
      <div class="bg-white px-3.5 py-2 rounded-xl border border-gray-200 shadow-2xs text-center min-w-24">
        <span class="text-[10px] font-bold text-amber-600 uppercase tracking-wider block">📦 Lote Criado</span>
        <span id="stat-lote" class="text-base font-black text-amber-600">0</span>
      </div>
      <div class="bg-white px-3.5 py-2 rounded-xl border border-gray-200 shadow-2xs text-center min-w-24">
        <span class="text-[10px] font-bold text-blue-600 uppercase tracking-wider block">✏️ Em Digitação</span>
        <span id="stat-digitacao" class="text-base font-black text-blue-600">0</span>
      </div>
      <div class="bg-white px-3.5 py-2 rounded-xl border border-gray-200 shadow-2xs text-center min-w-24">
        <span class="text-[10px] font-bold text-indigo-600 uppercase tracking-wider block">🔍 Conferidos</span>
        <span id="stat-conferidos" class="text-base font-black text-indigo-600">0</span>
      </div>
      <div class="bg-white px-3.5 py-2 rounded-xl border border-gray-200 shadow-2xs text-center min-w-24">
        <span class="text-[10px] font-bold text-emerald-600 uppercase tracking-wider block">✅ Liberados</span>
        <span id="stat-liberados" class="text-base font-black text-emerald-600">0</span>
      </div>
    </div>
  </div>

  <!-- Painel de Filtros e Controles Avançados -->
  <div class="bg-white rounded-2xl border border-slate-200/90 p-4 sm:p-5 shadow-sm mb-6 space-y-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-3">
      <!-- Filtro 1: Busca Livre (Código / Paciente / CPF) -->
      <div class="xl:col-span-2">
        <label for="filter-search" class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1 font-mono">
          Código / Paciente / CPF
        </label>
        <div class="relative">
          <input
            type="text"
            id="filter-search"
            placeholder="Ex: 21264, Aaron, 00001001..."
            class="w-full pl-9 pr-3 py-2 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#284701]/20 focus:border-[#284701] transition-all"
          />
          <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </div>
      </div>

      <!-- Filtro 2: Médico -->
      <div>
        <label for="filter-doctor" class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1 font-mono">
          Médico
        </label>
        <select
          id="filter-doctor"
          class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#284701]/20 focus:border-[#284701] transition-all bg-white"
        >
          <option value="">Todos os Médicos</option>
          <% (medicos || []).forEach(m => { %>
            <option value="<%= m.name || m.nome %>"><%= m.name || m.nome %></option>
          <% }); %>
        </select>
      </div>

      <!-- Filtro 3: Convênio -->
      <div>
        <label for="filter-convenio" class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1 font-mono">
          Convênio
        </label>
        <select
          id="filter-convenio"
          class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#284701]/20 focus:border-[#284701] transition-all bg-white"
        >
          <option value="">Todos os Convênios</option>
          <% (convenios || []).forEach(c => { %>
            <option value="<%= c.name || c.nome %>"><%= c.name || c.nome %></option>
          <% }); %>
        </select>
      </div>

      <!-- Filtro 4: Ordenação -->
      <div>
        <label for="filter-sort" class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1 font-mono">
          Ordenação
        </label>
        <select
          id="filter-sort"
          class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#284701]/20 focus:border-[#284701] transition-all bg-white font-medium text-slate-700"
        >
          <option value="mais_recentes" selected>Mais Recentes</option>
          <option value="mais_antigas">Mais Antigas</option>
          <option value="em_atraso">Em Atraso Primeiro</option>
          <option value="proximo_atraso">Próximos de Atraso</option>
        </select>
      </div>

      <!-- Filtro 5: Itens Por Página -->
      <div>
        <label for="filter-limit" class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1 font-mono">
          Exibir por Página
        </label>
        <select
          id="filter-limit"
          class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#284701]/20 focus:border-[#284701] transition-all bg-white font-bold text-[#284701]"
        >
          <option value="10">10 requisições</option>
          <option value="25">25 requisições</option>
          <option value="50" selected>50 requisições (padrão)</option>
          <option value="100">100 requisições</option>
          <option value="200">200 requisições</option>
          <option value="todos">Todas</option>
        </select>
      </div>
    </div>

    <!-- Toggles / Flags e Ações secundárias -->
    <div class="flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-slate-100">
      <div class="flex flex-wrap items-center gap-4">
        <!-- Flag Urgentes -->
        <label class="inline-flex items-center gap-2 cursor-pointer select-none">
          <input type="checkbox" id="filter-urgent" class="w-4 h-4 rounded text-red-600 focus:ring-red-500 border-slate-300">
          <span class="text-xs font-bold text-slate-700 flex items-center gap-1">
            <span>🚨</span> Apenas Requisições Urgentes
          </span>
        </label>

        <!-- Flag Apenas Lote Criado -->
        <label class="inline-flex items-center gap-2 cursor-pointer select-none">
          <input type="checkbox" id="filter-lote-only" class="w-4 h-4 rounded text-[#284701] focus:ring-[#284701] border-slate-300">
          <span class="text-xs font-bold text-slate-700 flex items-center gap-1">
            <span>📦</span> Com Exames em Lote Criado
          </span>
        </label>
      </div>

      <div class="flex items-center gap-2">
        <button
          type="button"
          id="btn-clear-filters"
          class="px-3 py-1.5 text-xs font-bold text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-lg transition-colors flex items-center gap-1"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
          Limpar Filtros
        </button>
      </div>
    </div>
  </div>

  <!-- Tabela / Lista de Requisições -->
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm overflow-hidden mb-6">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-slate-50/80 border-b border-slate-200 text-[10.5px] font-mono font-bold text-slate-500 uppercase tracking-wider">
            <th class="py-2.5 px-3">Requisição</th>
            <th class="py-2.5 px-3">Data</th>
            <th class="py-2.5 px-3">Paciente</th>
            <th class="py-2.5 px-3">Idade</th>
            <th class="py-2.5 px-3">Solicitante</th>
            <th class="py-2.5 px-3">Convênio</th>
            <th class="py-2.5 px-3">Prazo</th>
            <th class="py-2.5 px-3">Status</th>
            <th class="py-2.5 px-3 text-right">Ação</th>
          </tr>
        </thead>
        <tbody id="requisitions-tbody" class="divide-y divide-slate-100 text-xs">
          <!-- Linhas renderizadas via JS para performance e paginação instantânea -->
        </tbody>
      </table>
    </div>

    <!-- Mensagem de Lista Vazia -->
    <div id="empty-state" class="hidden py-12 text-center">
      <div class="w-12 h-12 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-3 text-slate-400 text-xl">
        🔍
      </div>
      <h3 class="text-sm font-bold text-slate-700">Nenhuma requisição encontrada</h3>
      <p class="text-xs text-slate-500 mt-1">Tente ajustar os filtros acima para encontrar a requisição desejada.</p>
    </div>

    <!-- Rodapé de Paginação -->
    <div class="px-4 py-3 bg-slate-50/60 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-600">
      <div id="pagination-info" class="font-mono text-slate-500">
        Exibindo 0 de 0 requisições
      </div>

      <div class="flex items-center gap-1.5" id="pagination-controls">
        <button
          id="btn-prev-page"
          disabled
          class="px-2.5 py-1.5 rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-100 disabled:opacity-40 disabled:cursor-not-allowed font-medium transition-colors"
        >
          ← Anterior
        </button>
        <div id="pagination-pages" class="flex items-center gap-1">
          <!-- Números de páginas -->
        </div>
        <button
          id="btn-next-page"
          disabled
          class="px-2.5 py-1.5 rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-100 disabled:opacity-40 disabled:cursor-not-allowed font-medium transition-colors"
        >
          Próxima →
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ========================================================= -->
<!-- WORKSPACE DE DIGITAÇÃO DE RESULTADOS (MODAL FULLSCREEN)   -->
<!-- ========================================================= -->
<div
  id="typing-modal"
  class="fixed inset-0 z-50 bg-slate-900/80 backdrop-blur-xs hidden flex items-center justify-center p-1 sm:p-3 overflow-hidden"
>
  <div class="bg-white w-full max-w-7xl rounded-2xl shadow-2xl border border-slate-200 flex flex-col h-[98vh] max-h-[960px] my-auto overflow-hidden">
    
    <!-- HEADER DO LAUDO / REQUISIÇÃO -->
    <div class="bg-slate-900 text-white p-3.5 sm:p-4 border-b border-slate-800 shrink-0">
      <div class="flex items-center justify-between gap-4">
        <div class="flex items-center gap-2">
          <span class="p-1.5 bg-brand-gold/20 text-brand-gold rounded-lg font-bold text-base">⌨️</span>
          <div>
            <h2 class="text-base font-black text-white flex items-center gap-2">
              Digitação de Resultado
            </h2>
            <p class="text-[11px] text-slate-400">
              Lançamento, conferência e liberação de exames
            </p>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <!-- Hidden File Input for XML -->
          <input
            type="file"
            id="xml-file-input"
            accept=".xml,text/xml"
            class="hidden"
            onchange="handleXmlFileImport(event)"
          />

          <button
            type="button"
            onclick="closeTypingModal()"
            class="text-slate-400 hover:text-white p-1.5 hover:bg-white/10 rounded-xl transition-colors text-lg font-bold"
            title="Fechar Modal (Esc)"
          >
            ✕
          </button>
        </div>
      </div>

      <!-- Barra de Dados da Requisição / Paciente (Estilo LIS) -->
      <div class="mt-2 bg-slate-800/90 p-2.5 rounded-xl border border-slate-700/80 text-xs font-mono text-slate-200 space-y-1.5">
        <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-12 gap-2 items-center">
          <div class="md:col-span-2">
            <span class="text-slate-400 font-bold">Requisição:</span>
            <strong id="m-req-code" class="text-brand-gold font-mono font-black text-sm">#00000000</strong>
          </div>
          <div class="md:col-span-6 flex items-center gap-1.5 truncate">
            <span class="text-slate-400 font-bold shrink-0">Paciente:</span>
            <strong id="m-patient-name" class="text-white font-bold text-sm truncate">-</strong>
          </div>
          <div class="md:col-span-4 font-mono text-slate-300 truncate">
            <span id="m-patient-details">Nasc: - | Idade: - | Sexo: -</span>
          </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-12 gap-2 items-center border-t border-slate-700/60 pt-1 text-[11px]">
          <div class="md:col-span-6 truncate">
            <span class="text-slate-400 font-bold">Médico:</span>
            <span id="m-doctor" class="text-slate-200 font-medium">-</span>
          </div>
          <div class="md:col-span-6 truncate">
            <span class="text-slate-400 font-bold">Convênio:</span>
            <span id="m-convenio" class="text-slate-200 font-medium">-</span>
          </div>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-12 gap-2 items-center border-t border-slate-700/60 pt-1 text-[11px]">
          <div class="md:col-span-5 truncate">
            <span class="text-slate-400 font-bold">Exame:</span>
            <strong id="m-active-title" class="text-white font-black text-xs">Selecione um exame</strong>
          </div>
          <div class="md:col-span-2">
            <span class="text-slate-400 font-bold">Situação:</span>
            <span id="m-active-status-badge" class="px-2 py-0.5 font-mono font-bold text-[10px] rounded bg-slate-700 text-slate-200">Sem resultado</span>
          </div>
          <div class="md:col-span-2 truncate">
            <span class="text-slate-400 font-bold">Material:</span>
            <span id="m-active-material-header" class="text-slate-200 font-mono">Sangue</span>
          </div>
          <div class="md:col-span-3 truncate">
            <span class="text-slate-400 font-bold">Coleta:</span>
            <span id="m-coleta-status" class="text-emerald-400 font-bold font-mono">-</span>
          </div>
        </div>
      </div>
    </div>

    <!-- CORPO DO WORKSPACE (SIDEBAR DE EXAMES + PAINEL DE DIGITAÇÃO) -->
    <div class="flex-1 flex flex-col md:flex-row min-h-0 overflow-hidden bg-slate-50">
      
      <!-- SIDEBAR ESQUERDA: LISTA DE EXAMES DA REQUISIÇÃO -->
      <div class="w-full md:w-72 lg:w-80 bg-white border-r border-slate-200 flex flex-col shrink-0 overflow-hidden">
        <div class="p-3 bg-slate-100/80 border-b border-slate-200 flex items-center justify-between">
          <span class="text-xs font-mono font-bold text-slate-600 uppercase tracking-wider flex items-center gap-1">
            <span>🔬</span> Exames da Requisição
          </span>
          <span id="m-exam-count-badge" class="px-2 py-0.5 bg-slate-200 text-slate-700 font-mono font-bold text-[10px] rounded-full">
            0 exames
          </span>
        </div>

        <div id="m-exams-list" class="flex-1 overflow-y-auto divide-y divide-slate-100 p-2 space-y-1">
          <!-- Renderizado via JS -->
        </div>

        <div class="p-3 bg-slate-50 border-t border-slate-200">
          <button
            id="btn-preview-all"
            type="button"
            onclick="previewAllExamsOfRequisition()"
            disabled
            class="w-full py-2 px-3 bg-slate-900 text-white text-xs font-bold rounded-xl transition-all flex items-center justify-center gap-2 shadow-sm font-mono opacity-50 cursor-not-allowed"
            title="Disponível apenas após pelo menos 1 exame ser digitado ou liberado"
          >
            <span>👁️</span> Visualizar Todos
          </button>
        </div>
      </div>

      <!-- PAINEL DIREITO: LAUDO INTERATIVO EM TEMPO REAL (EDITÁVEL NA TELA) -->
      <div class="flex-1 flex flex-col min-h-0 overflow-hidden p-3 sm:p-4 space-y-2.5">
        
        <!-- Banner de Título do Exame Ativo -->
        <div class="bg-white rounded-xl border border-slate-200/90 p-3 shadow-2xs flex flex-col sm:flex-row sm:items-center justify-between gap-3 shrink-0">
          <div class="flex items-center gap-2 flex-wrap">
            <span id="m-active-code" class="px-2.5 py-1 bg-slate-900 text-brand-gold font-mono font-black text-xs rounded-lg">
              -
            </span>
            <div class="flex items-center gap-2 flex-wrap">
              <h3 id="m-active-title" class="text-base font-black text-slate-900">
                Selecione um exame
              </h3>
              <span id="m-active-status-badge" class="px-2.5 py-1 text-xs font-mono font-bold rounded-lg bg-slate-100 text-slate-700 border border-slate-200">
                Pendente
              </span>
            </div>
          </div>
        </div>

        <!-- Hidden inputs preserving model structure -->
        <input type="hidden" id="f-modelo-laudo" value="Padrão LIS InovaLab" />

        <!-- FOLHA DO LAUDO AO VIVO - EDITÁVEL E VISUALIZÁVEL -->
        <div class="flex-1 min-h-0 overflow-y-auto bg-slate-200/70 rounded-xl p-3 sm:p-5 border border-slate-300 shadow-inner flex justify-center">
          
          <div id="laudo-editor-paper-container" class="bg-white text-slate-900 p-4 sm:p-6 shadow-md border border-slate-300 w-full max-w-2xl font-mono text-xs leading-snug space-y-3 rounded-lg">
            
            <!-- MODO EDIÇÃO (FOLHA DO LAUDO AO VIVO) -->
            <div id="exam-edit-view" class="space-y-3.5 font-mono">
              <!-- BANNER HEADER DO EXAME -->
              <div class="bg-slate-200 border border-slate-400 py-1.5 px-3 text-center font-bold text-sm text-slate-950 uppercase tracking-wider rounded-xs font-mono" id="laudo-sheet-exam-title">
                LIPASE
              </div>

              <!-- DADOS TÉCNICOS (MATERIAL, MÉTODO, EQUIPAMENTO) -->
              <div id="laudo-block-tech" class="text-[10.5px] space-y-1 text-slate-800 border-b border-slate-200 pb-2 font-mono">
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                  <div class="flex items-center gap-1">
                    <span class="text-slate-600 font-medium shrink-0 laudo-label">Material:</span>
                    <input
                      type="text"
                      id="f-material"
                      placeholder="Ex: Soro"
                      class="w-full px-2 py-0.5 text-xs font-bold text-slate-900 bg-slate-50 border border-slate-300 focus:border-[#284701] focus:bg-white rounded font-mono"
                    />
                  </div>
                  <div class="flex items-center gap-1">
                    <span class="text-slate-600 font-medium shrink-0 laudo-label">Método:</span>
                    <input
                      type="text"
                      id="f-method"
                      placeholder="Ex: Colorimétrico"
                      class="w-full px-2 py-0.5 text-xs font-bold text-slate-900 bg-slate-50 border border-slate-300 focus:border-[#284701] focus:bg-white rounded font-mono"
                    />
                  </div>
                  <div class="flex items-center gap-1">
                    <span class="text-slate-600 font-medium shrink-0 laudo-label">Equipamento:</span>
                    <input
                      type="text"
                      id="f-equipment"
                      placeholder="Ex: Urit 8021A"
                      value="Urit 8021A - Automatizado"
                      class="w-full px-2 py-0.5 text-xs font-bold text-slate-900 bg-slate-50 border border-slate-300 focus:border-[#284701] focus:bg-white rounded font-mono"
                    />
                  </div>
                </div>
              </div>

              <!-- 1. BLOCO DE RESULTADO DO EXAME COM CAMPO DE UNIDADE DE MEDIDA -->
              <div id="laudo-block-result" class="space-y-2 bg-slate-50/90 p-3 border border-slate-200 rounded-xs font-mono">
                <div class="text-[11px] font-bold text-slate-900 uppercase border-b border-slate-200 pb-1 laudo-label">
                  Resultado do Exame:
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-12 gap-2.5 items-start">
                  <div class="sm:col-span-8 space-y-1">
                    <label for="f-result" class="text-[10.5px] font-bold text-slate-700 block laudo-label">Valor Obtido / Resultado:</label>
                    <textarea
                      id="f-result"
                      rows="2"
                      placeholder="Informe o resultado do exame (ex: 72, NORMAL, NEGATIVO)..."
                      class="w-full p-2 text-sm font-black text-slate-950 bg-white border border-slate-300 focus:border-[#284701] rounded font-mono tracking-wide shadow-2xs leading-snug"
                    ></textarea>
                  </div>
                  <div class="sm:col-span-4 space-y-1">
                    <label for="f-unit" class="text-[10.5px] font-bold text-slate-700 block laudo-label">Unidade de Medida:</label>
                    <input
                      type="text"
                      id="f-unit"
                      placeholder="Ex: mg/dL, U/L, %"
                      class="w-full p-2 text-xs font-bold text-slate-900 bg-white border border-slate-300 focus:border-[#284701] rounded font-mono shadow-2xs"
                    />
                  </div>
                </div>
              </div>

              <!-- 2. VALORES DE REFERÊNCIA (POSICIONADO LOGO ABAIXO DO RESULTADO) -->
              <div id="laudo-block-ref" class="p-3 bg-white border border-slate-200 rounded-xs font-mono">
                <div class="font-bold text-[11px] text-slate-900 mb-1 border-b border-slate-200 pb-0.5 laudo-label">Valores de Referência:</div>
                <textarea
                  id="f-ref-value"
                  rows="4"
                  placeholder="Valores de referência predefinidos no modelo de exame..."
                  class="w-full p-2 text-[10.5px] font-mono leading-relaxed text-slate-800 bg-slate-50 border border-slate-300 focus:border-[#284701] focus:bg-white rounded"
                ></textarea>
