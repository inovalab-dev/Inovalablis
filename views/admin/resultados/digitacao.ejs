      <div id="laudo-paper-container" class="bg-white text-slate-900 p-8 sm:p-12 shadow-lg border border-slate-300 w-full max-w-3xl font-mono text-sm leading-relaxed space-y-6">

        <!-- HEADER BANNER DO EXAME -->
        <div class="bg-slate-300 text-slate-900 py-2 px-4 text-center font-bold tracking-widest text-base sm:text-lg border-y border-slate-400 uppercase font-mono" id="laudo-exam-title">
