                <div>Coleta: <strong id="laudo-data-coleta">31/07/26 12:37</strong></div>
                <div>Exame liberado por: <strong id="laudo-liberado-por">Maria Gabriela</strong></div>
                <div>Cód. Seg.: <span id="laudo-cod-seg" class="font-mono text-[9px]">30b0159888103142783ca35ff8ea92ad</span></div>
              </div>

            </div>

          </div>

        </div>

        <!-- RODAPÉ DE AÇÕES E STATUS -->
        <div class="pt-2 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-3">
          <div class="flex items-center gap-2 w-full sm:w-auto">
