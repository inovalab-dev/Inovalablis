        class="px-2 py-1 bg-slate-100 hover:bg-slate-200 text-slate-800 border border-slate-300 rounded flex items-center gap-1 font-bold shrink-0"
        title="Adicionar Gráfico de Histórico"
      >
        <span class="font-black text-red-600">[bar]</span> Gráfico
      </button>

      <button
        type="button"
        onclick="addLisComponent('imagem')"
        class="px-2 py-1 bg-slate-100 hover:bg-slate-200 text-slate-800 border border-slate-300 rounded flex items-center gap-1 font-bold shrink-0"
        title="Adicionar Logotipo / Imagem"
      >
        <span class="font-black text-amber-700">[img]</span> Imagem
      </button>

      <div class="h-4 w-px bg-slate-300 mx-1 shrink-0"></div>

      <button
        type="button"
        onclick="deleteSelectedLisComponent()"
        class="px-2 py-1 bg-red-50 hover:bg-red-100 text-red-700 border border-red-200 rounded flex items-center gap-1 font-bold shrink-0"
        title="Excluir elemento selecionado"
      >
        <span>🗑️</span> Excluir
      </button>

      <button
        type="button"
        onclick="centerSelectedLisComponent()"
        class="px-2 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-300 rounded flex items-center gap-1 font-bold shrink-0"
        title="Centralizar elemento na página"
      >
        <span>↔️</span> Centralizar
      </button>
    </div>

    <!-- ÁREA PRINCIPAL: CANVAS DE DESENHO (ESQUERDA) VS PROPRIEDADES (DIREITA) -->
    <div class="flex-1 flex overflow-hidden">

      <!-- PAINEL DA ESQUERDA: CANVAS COM RÉGUAS CENTIMÉTRICAS (DESENHO WYSIWYG) -->
      <div class="flex-1 bg-slate-300 flex flex-col overflow-auto relative p-3 items-center justify-start select-none" onclick="deselectLisComponentIfPaper(event)">
        
        <!-- CONTAINER DA RÉGUA SUPERIOR + FOLHA -->
        <div class="flex flex-col items-center">
          
          <!-- RÉGUA SUPERIOR (HORIZONTAL 0 A 20cm) -->
          <div class="w-[680px] h-6 bg-amber-50/90 border border-slate-400 flex items-end justify-between px-2 font-mono text-[9px] text-slate-600 font-bold select-none border-b-0">
            <span>0</span><span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span><span>8</span><span>9</span><span>10</span><span>11</span><span>12</span><span>13</span><span>14</span><span>15</span><span>16</span><span>17</span><span>18</span><span>19</span><span>20</span>
          </div>

          <div class="flex">
            <!-- RÉGUA LATERAL (VERTICAL 0 A 28cm) -->
            <div class="w-6 h-[880px] bg-amber-50/90 border border-slate-400 flex flex-col items-end justify-between py-2 pr-1 font-mono text-[9px] text-slate-600 font-bold select-none border-r-0 shrink-0">
              <span>0</span><span>2</span><span>4</span><span>6</span><span>8</span><span>10</span><span>12</span><span>14</span><span>16</span><span>18</span><span>20</span><span>22</span><span>24</span><span>26</span><span>28</span>
            </div>

            <!-- FOLHA DO LAUDO (CANVAS DE ARRASTE DOS COMPONENTES) -->
            <div
              id="lis-canvas-paper"
              onclick="deselectLisComponentIfPaper(event)"
              class="w-[680px] h-[880px] bg-white border border-slate-400 shadow-xl relative overflow-hidden font-mono text-xs text-slate-900"
              style="background-image: radial-gradient(#cbd5e1 0.75px, transparent 0.75px); background-size: 10px 10px;"
            >
              <!-- MARGENS E LINHAS DE GUIA DO CORPO -->
              <div class="absolute inset-x-5 top-5 bottom-5 border border-dashed border-slate-300 pointer-events-none"></div>
              <div class="absolute inset-x-5 top-8 border-b border-red-300/80 pointer-events-none text-[8px] text-red-400 font-mono">
                Corpo (Página: 1)
              </div>

              <!-- ELEMENTOS DO CANVAS (DESENHADOS DINAMICAMENTE VIA JS) -->
              <div id="lis-canvas-elements-container" class="absolute inset-0"></div>
            </div>
          </div>
        </div>

      </div>

      <!-- PAINEL DA DIREITA: PAINEL DE PROPRIEDADES (PROPERTIES INSPECTOR) -->
      <div class="w-80 sm:w-96 bg-white border-l border-slate-300 flex flex-col overflow-y-auto shrink-0 shadow-lg font-mono text-xs">
        
        <!-- CABEÇALHO DE PROPRIEDADES -->
        <div class="bg-slate-200 border-b border-slate-300 px-3 py-2 font-bold text-slate-800 text-xs flex items-center justify-between shrink-0">
          <span>Propriedades</span>
          <span id="lis-selected-comp-badge" class="px-2 py-0.5 bg-indigo-900 text-white font-mono text-[10px] rounded">Nenhum</span>
        </div>

        <!-- TABELA GRID DE PROPRIEDADES (EXACTAMENTE IGUAL AO LIS) -->
        <div class="flex-1 p-0">
          <table class="w-full text-left border-collapse border-b border-slate-200">
            <thead>
              <tr class="bg-slate-100 text-slate-600 text-[11px] font-bold border-b border-slate-300">
                <th class="py-1.5 px-3 border-r border-slate-300 w-1/2">Propriedade</th>
                <th class="py-1.5 px-3 w-1/2">Valor</th>
              </tr>
            </thead>
            <tbody id="lis-properties-grid-body" class="divide-y divide-slate-200 text-xs">
              <!-- Preenchido via JS quando um componente for selecionado -->
              <tr>
                <td colspan="2" class="p-4 text-center text-slate-400 italic">
                  Clique em um elemento na folha para editar suas propriedades.
                </td>
              </tr>
            </tbody>
          </table>
        </div>

      </div>

    </div>

    <!-- RODAPÉ DE STATUS DO LIS (CAMPOS DE LABORATÓRIO EXTERNO) -->
    <div class="bg-slate-200 border-t border-slate-300 px-3 py-2 flex flex-wrap items-center justify-between gap-2 text-xs font-mono shrink-0">
      <div class="flex items-center gap-4 text-slate-700 text-[11px]">
        <span class="font-bold text-slate-900">Campos de laboratório externo</span>
        <div>Exame: <strong id="lis-footer-exam-code" class="text-indigo-900">G</strong></div>
        <div>Versão: <strong class="text-slate-900">24540</strong></div>
      </div>
      <div class="text-[11px] text-slate-500 font-semibold">
        Página 1 de 1
      </div>
    </div>

  </div>
</div>

<script>
  // =========================================================
  // MOTOR COMPLETO DE CONFIGURAÇÃO DE LAYOUT DO LIS (WYSIWYG)
  // =========================================================
  let lisComponents = [];
  let selectedLisCompIndex = null;
  let isDraggingLisComp = false;
  let dragOffsetX = 0;
  let dragOffsetY = 0;

  // Componentes padrões de um exame (ex: Glicose / Lipase)
  function getDefaultLisComponents(examCode) {
    const code = examCode || 'LIPASE';
    return [
      {
        id: 'comp_title',
        nome: 'TituloExame',
        componente: 'Texto',
        texto: code.toUpperCase(),
        esquerda: 220,
        topo: 40,
        largura: 240,
        altura: 30,
        fonte: 'Courier New',
        tamanho: '14px',
        negrito: true,
        maiusculas: true,
        alinhamento: 'center',
        corFonte: '#0f172a',
        corFundo: '#e2e8f0',
        imprimir: true,
        opaco: true
      },
      {
        id: 'comp_tech',
        nome: 'DadosTecnicos',
        componente: 'Expressão',
        texto: 'Material: Soro\nMétodo  : Colorimétrico\nEquipamento: Urit 8021A - Automatizado',
        esquerda: 40,
        topo: 85,
        largura: 300,
        altura: 70,
        fonte: 'Courier New',
        tamanho: '11px',
        negrito: false,
        maiusculas: false,
        alinhamento: 'left',
        corFonte: '#1e293b',
        corFundo: 'transparent',
        imprimir: true,
        opaco: false
      },
      {
        id: 'comp_ref',
        nome: 'ValoresReferencia',
        componente: 'Val. Referência',
        texto: 'Valores de Referência:\n{{referencia}}',
        esquerda: 350,
        topo: 85,
        largura: 290,
        altura: 120,
        fonte: 'Courier New',
        tamanho: '11px',
        negrito: false,
        maiusculas: false,
        alinhamento: 'left',
        corFonte: '#1e293b',
        corFundo: '#f8fafc',
        imprimir: true,
        opaco: true
      },
      {
        id: 'comp_result',
        nome: 'ResultadoExame',
        componente: 'Campo Variável',
        texto: 'Resultado: 72 U/L',
        esquerda: 40,
        topo: 225,
        largura: 600,
        altura: 45,
        fonte: 'Courier New',
        tamanho: '16px',
        negrito: true,
        maiusculas: false,
        alinhamento: 'left',
        corFonte: '#020617',
        corFundo: '#f1f5f9',
        imprimir: true,
        opaco: true
      },
      {
        id: 'comp_obs',
        nome: 'Observacoes',
        componente: 'Texto',
        texto: 'Observações:\nAmostra coletada e identificada pelo Hospital Municipal de Cambará.',
        esquerda: 40,
        topo: 290,
        largura: 600,
        altura: 60,
        fonte: 'Courier New',
        tamanho: '11px',
        negrito: false,
        maiusculas: false,
        alinhamento: 'left',
        corFonte: '#334155',
        corFundo: 'transparent',
        imprimir: true,
        opaco: false
      },
      {
        id: 'comp_chart',
        nome: 'GraficoHistorico',
        componente: 'Gráfico',
        texto: '[Gráfico de Resultados Anteriores do Paciente]',
        esquerda: 40,
        topo: 370,
        largura: 320,
        altura: 120,
        fonte: 'Courier New',
        tamanho: '10px',
        negrito: false,
        maiusculas: false,
        alinhamento: 'center',
        corFonte: '#475569',
        corFundo: '#ffffff',
        imprimir: true,
        opaco: true
      }
    ];
  }

  let activeLisProviderKey = 'interno';

  function openLisLayoutModal(providerKey = 'interno') {
    activeLisProviderKey = providerKey || 'interno';
    const activeCodeEl = document.getElementById('m-active-code');
    const examCode = (activeCodeEl && activeCodeEl.textContent.trim() !== '-') 
      ? activeCodeEl.textContent.trim() 
      : 'GLICOSE DE JEJUM';

    document.getElementById('lis-modal-exam-title').textContent = examCode;
    document.getElementById('lis-footer-exam-code').textContent = examCode;

    const selectEl = document.getElementById('lis-provider-select');
    if (selectEl) selectEl.value = activeLisProviderKey;

    loadLisLayoutModel(examCode, activeLisProviderKey);

    const modal = document.getElementById('modal-lis-layout-editor');
    if (modal) modal.classList.remove('hidden');
  }

  function switchLisProviderModel(providerKey) {
    activeLisProviderKey = providerKey || 'interno';
    const activeCodeEl = document.getElementById('m-active-code');
    const examCode = (activeCodeEl && activeCodeEl.textContent.trim() !== '-') 
      ? activeCodeEl.textContent.trim() 
      : 'GLICOSE DE JEJUM';

    loadLisLayoutModel(examCode, activeLisProviderKey);

    const provNames = { interno: 'Interno', alvaro: 'Álvaro', pardini: 'Pardini' };
    showToast(`Carregado layout do modelo ${provNames[activeLisProviderKey] || 'Interno'}`, 'info');
  }

  function closeLisLayoutModal() {
    const modal = document.getElementById('modal-lis-layout-editor');
    if (modal) modal.classList.add('hidden');
  }

  function renderLisCanvas() {
    const container = document.getElementById('lis-canvas-elements-container');
    if (!container) return;

    container.innerHTML = lisComponents.map((comp, idx) => {
      const isSelected = selectedLisCompIndex === idx;
      const borderStyle = isSelected ? 'border-2 border-indigo-600 shadow-md ring-2 ring-indigo-400/50 z-20' : 'border border-slate-400/70 hover:border-slate-600 z-10';
      
      const handles = isSelected ? `
        <div onmousedown="onStartResizeLisComp(event, ${idx}, 'nw')" class="absolute -top-1.5 -left-1.5 w-3.5 h-3.5 bg-indigo-600 border-2 border-white rounded-full cursor-nwse-resize z-30 hover:scale-125 transition-transform" title="Redimensionar Canto Superior Esquerdo"></div>
        <div onmousedown="onStartResizeLisComp(event, ${idx}, 'top')" class="absolute -top-1.5 left-1/2 -translate-x-1/2 w-3.5 h-3.5 bg-indigo-600 border-2 border-white rounded-full cursor-ns-resize z-30 hover:scale-125 transition-transform" title="Redimensionar Altura Superior"></div>
        <div onmousedown="onStartResizeLisComp(event, ${idx}, 'ne')" class="absolute -top-1.5 -right-1.5 w-3.5 h-3.5 bg-indigo-600 border-2 border-white rounded-full cursor-nesw-resize z-30 hover:scale-125 transition-transform" title="Redimensionar Canto Superior Direito"></div>
        <div onmousedown="onStartResizeLisComp(event, ${idx}, 'right')" class="absolute top-1/2 -right-1.5 -translate-y-1/2 w-3.5 h-3.5 bg-indigo-600 border-2 border-white rounded-full cursor-ew-resize z-30 hover:scale-125 transition-transform" title="Redimensionar Largura (Direita)"></div>
        <div onmousedown="onStartResizeLisComp(event, ${idx}, 'se')" class="absolute -bottom-1.5 -right-1.5 w-3.5 h-3.5 bg-indigo-600 border-2 border-white rounded-full cursor-nwse-resize z-30 hover:scale-125 transition-transform" title="Redimensionar Canto Inferior Direito"></div>
        <div onmousedown="onStartResizeLisComp(event, ${idx}, 'bottom')" class="absolute -bottom-1.5 left-1/2 -translate-x-1/2 w-3.5 h-3.5 bg-indigo-600 border-2 border-white rounded-full cursor-ns-resize z-30 hover:scale-125 transition-transform" title="Redimensionar Altura (Inferior)"></div>
        <div onmousedown="onStartResizeLisComp(event, ${idx}, 'sw')" class="absolute -bottom-1.5 -left-1.5 w-3.5 h-3.5 bg-indigo-600 border-2 border-white rounded-full cursor-nesw-resize z-30 hover:scale-125 transition-transform" title="Redimensionar Canto Inferior Esquerdo"></div>
        <div onmousedown="onStartResizeLisComp(event, ${idx}, 'left')" class="absolute top-1/2 -left-1.5 -translate-y-1/2 w-3.5 h-3.5 bg-indigo-600 border-2 border-white rounded-full cursor-ew-resize z-30 hover:scale-125 transition-transform" title="Redimensionar Largura (Esquerda)"></div>
      ` : '';

      const textTransform = comp.maiusculas ? 'uppercase' : 'none';
      const fontWeight = comp.negrito ? 'bold' : 'normal';

      // Se for Resultado Simples ou possuir unidade de medida concatenada
      let displayText = comp.texto;
      if (comp.componente === 'Resultado Simples' || comp.unidade) {
        const valStr = comp.texto || '{{resultado}}';
        const unitStr = comp.unidade ? ` ${comp.unidade}` : '';
        displayText = `${valStr}${unitStr}`;
      }

      return `
        <div
          id="lis-element-${idx}"
          onmousedown="onStartDragLisComp(event, ${idx})"
          onclick="selectLisComponent(${idx})"
          class="absolute p-2 cursor-move flex items-center justify-${comp.alinhamento === 'center' ? 'center' : comp.alinhamento === 'right' ? 'end' : 'start'} ${borderStyle} transition-shadow"
          style="
            left: ${comp.esquerda}px;
            top: ${comp.topo}px;
            width: ${comp.largura}px;
            height: ${comp.altura}px;
            font-family: '${comp.fonte}', monospace;
            font-size: ${comp.tamanho};
            font-weight: ${fontWeight};
            text-transform: ${textTransform};
            color: ${comp.corFonte};
            background-color: ${comp.corFundo};
            white-space: pre-wrap;
          "
        >
          <span>${escapeLisHtml(displayText)}</span>
          ${handles}
        </div>
      `;
    }).join('');

    renderLisPropertiesGrid();
  }

  function escapeLisHtml(str) {
    if (str === null || str === undefined) return '';
    return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function selectLisComponent(index) {
    selectedLisCompIndex = index;
    const comp = lisComponents[index];
    if (comp) {
      document.getElementById('lis-alert-comp-name').textContent = comp.nome || ('campo' + (index + 1));
    }
    renderLisCanvas();
  }

  function renderLisPropertiesGrid() {
    const gridBody = document.getElementById('lis-properties-grid-body');
    const badge = document.getElementById('lis-selected-comp-badge');
    if (!gridBody) return;

    if (selectedLisCompIndex === null || !lisComponents[selectedLisCompIndex]) {
      if (badge) badge.textContent = 'Nenhum';
      gridBody.innerHTML = `
        <tr>
          <td colspan="2" class="p-4 text-center text-slate-400 italic">
            Clique em um elemento na folha para editar suas propriedades.
          </td>
        </tr>
      `;
      return;
    }

    const comp = lisComponents[selectedLisCompIndex];
    if (badge) badge.textContent = comp.nome || 'Componente';

    gridBody.innerHTML = `
      <tr class="hover:bg-slate-50">
        <td class="py-1 px-2 border-r border-slate-200 text-slate-600 font-bold">componente</td>
        <td class="py-1 px-2 font-bold text-indigo-900">${comp.componente}</td>
      </tr>
      <tr class="hover:bg-slate-50">
        <td class="py-1 px-2 border-r border-slate-200 text-slate-600 font-bold">nome</td>
        <td class="py-1 px-2">
          <input type="text" value="${comp.nome}" onchange="updateLisCompProp('nome', this.value)" class="w-full px-1 py-0.5 border border-slate-300 rounded font-mono text-xs"/>
        </td>
      </tr>
      <tr class="hover:bg-slate-50">
        <td class="py-1 px-2 border-r border-slate-200 text-slate-600 font-bold">texto / expressão</td>
        <td class="py-1 px-2">
          <textarea rows="2" onchange="updateLisCompProp('texto', this.value)" class="w-full px-1 py-0.5 border border-slate-300 rounded font-mono text-xs">${comp.texto}</textarea>
        </td>
      </tr>
      <tr class="hover:bg-slate-50 bg-emerald-50/50">
        <td class="py-1 px-2 border-r border-slate-200 text-emerald-900 font-bold">unidade de medida</td>
        <td class="py-1 px-2">
          <input type="text" value="${comp.unidade || ''}" placeholder="Ex: mg/dL, g/dL, %" onchange="updateLisCompProp('unidade', this.value)" class="w-full px-1 py-0.5 border border-emerald-300 rounded font-mono text-xs"/>
        </td>
      </tr>
      <tr class="hover:bg-slate-50">
        <td class="py-1 px-2 border-r border-slate-200 text-slate-600 font-bold">esquerda (X)</td>
        <td class="py-1 px-2">
          <input type="number" value="${comp.esquerda}" onchange="updateLisCompProp('esquerda', parseInt(this.value)||0)" class="w-20 px-1 py-0.5 border border-slate-300 rounded font-mono text-xs"/>
        </td>
      </tr>
      <tr class="hover:bg-slate-50">
        <td class="py-1 px-2 border-r border-slate-200 text-slate-600 font-bold">topo (Y)</td>
        <td class="py-1 px-2">
          <input type="number" value="${comp.topo}" onchange="updateLisCompProp('topo', parseInt(this.value)||0)" class="w-20 px-1 py-0.5 border border-slate-300 rounded font-mono text-xs"/>
        </td>
      </tr>
      <tr class="hover:bg-slate-50">
        <td class="py-1 px-2 border-r border-slate-200 text-slate-600 font-bold">largura (W)</td>
        <td class="py-1 px-2">
          <input type="number" value="${comp.largura}" onchange="updateLisCompProp('largura', parseInt(this.value)||0)" class="w-20 px-1 py-0.5 border border-slate-300 rounded font-mono text-xs"/>
        </td>
      </tr>
      <tr class="hover:bg-slate-50">
        <td class="py-1 px-2 border-r border-slate-200 text-slate-600 font-bold">altura (H)</td>
        <td class="py-1 px-2">
          <input type="number" value="${comp.altura}" onchange="updateLisCompProp('altura', parseInt(this.value)||0)" class="w-20 px-1 py-0.5 border border-slate-300 rounded font-mono text-xs"/>
        </td>
      </tr>
      <tr class="hover:bg-slate-50">
        <td class="py-1 px-2 border-r border-slate-200 text-slate-600 font-bold">fonte</td>
        <td class="py-1 px-2">
          <select onchange="updateLisCompProp('fonte', this.value)" class="w-full px-1 py-0.5 border border-slate-300 rounded text-xs font-mono">
            <option value="Courier New" ${comp.fonte === 'Courier New' ? 'selected' : ''}>Courier New</option>
            <option value="Arial" ${comp.fonte === 'Arial' ? 'selected' : ''}>Arial</option>
            <option value="Times New Roman" ${comp.fonte === 'Times New Roman' ? 'selected' : ''}>Times New Roman</option>
            <option value="Monospace" ${comp.fonte === 'Monospace' ? 'selected' : ''}>Monospace</option>
          </select>
        </td>
      </tr>
      <tr class="hover:bg-slate-50">
        <td class="py-1 px-2 border-r border-slate-200 text-slate-600 font-bold">tamanho fonte</td>
        <td class="py-1 px-2">
          <select onchange="updateLisCompProp('tamanho', this.value)" class="w-full px-1 py-0.5 border border-slate-300 rounded text-xs font-mono">
            <option value="9px" ${comp.tamanho === '9px' ? 'selected' : ''}>9px</option>
            <option value="10px" ${comp.tamanho === '10px' ? 'selected' : ''}>10px</option>
            <option value="11px" ${comp.tamanho === '11px' ? 'selected' : ''}>11px</option>
            <option value="12px" ${comp.tamanho === '12px' ? 'selected' : ''}>12px</option>
            <option value="14px" ${comp.tamanho === '14px' ? 'selected' : ''}>14px</option>
            <option value="16px" ${comp.tamanho === '16px' ? 'selected' : ''}>16px</option>
            <option value="18px" ${comp.tamanho === '18px' ? 'selected' : ''}>18px</option>
            <option value="20px" ${comp.tamanho === '20px' ? 'selected' : ''}>20px</option>
          </select>
        </td>
      </tr>
      <tr class="hover:bg-slate-50">
        <td class="py-1 px-2 border-r border-slate-200 text-slate-600 font-bold">negrito</td>
        <td class="py-1 px-2">
          <input type="checkbox" ${comp.negrito ? 'checked' : ''} onchange="updateLisCompProp('negrito', this.checked)" class="rounded"/>
        </td>
      </tr>
      <tr class="hover:bg-slate-50">
        <td class="py-1 px-2 border-r border-slate-200 text-slate-600 font-bold">maiúsculas</td>
        <td class="py-1 px-2">
          <input type="checkbox" ${comp.maiusculas ? 'checked' : ''} onchange="updateLisCompProp('maiusculas', this.checked)" class="rounded"/>
        </td>
      </tr>
      <tr class="hover:bg-slate-50">
        <td class="py-1 px-2 border-r border-slate-200 text-slate-600 font-bold">alinhamento</td>
        <td class="py-1 px-2">
          <select onchange="updateLisCompProp('alinhamento', this.value)" class="w-full px-1 py-0.5 border border-slate-300 rounded text-xs font-mono">
            <option value="left" ${comp.alinhamento === 'left' ? 'selected' : ''}>Esquerda</option>
            <option value="center" ${comp.alinhamento === 'center' ? 'selected' : ''}>Centro</option>
            <option value="right" ${comp.alinhamento === 'right' ? 'selected' : ''}>Direita</option>
          </select>
        </td>
      </tr>
      <tr class="hover:bg-slate-50">
        <td class="py-1 px-2 border-r border-slate-200 text-slate-600 font-bold">cor da fonte</td>
        <td class="py-1 px-2 flex items-center gap-1">
          <input type="color" value="${comp.corFonte && comp.corFonte.startsWith('#') ? comp.corFonte : '#000000'}" onchange="updateLisCompProp('corFonte', this.value)" class="w-6 h-6 border rounded cursor-pointer"/>
          <span class="text-[10px] text-slate-500 font-mono">${comp.corFonte}</span>
        </td>
      </tr>
      <tr class="hover:bg-slate-50">
        <td class="py-1 px-2 border-r border-slate-200 text-slate-600 font-bold">cor de fundo</td>
        <td class="py-1 px-2">
          <select onchange="updateLisCompProp('corFundo', this.value)" class="w-full px-1 py-0.5 border border-slate-300 rounded text-xs font-mono">
            <option value="transparent" ${comp.corFundo === 'transparent' ? 'selected' : ''}>Transparente</option>
            <option value="#ffffff" ${comp.corFundo === '#ffffff' ? 'selected' : ''}>Branca</option>
            <option value="#f8fafc" ${comp.corFundo === '#f8fafc' ? 'selected' : ''}>Cinza Claro</option>
            <option value="#e2e8f0" ${comp.corFundo === '#e2e8f0' ? 'selected' : ''}>Cinza Médio</option>
          </select>
        </td>
      </tr>
      <tr class="hover:bg-slate-50">
        <td class="py-1 px-2 border-r border-slate-200 text-slate-600 font-bold">imprimir</td>
        <td class="py-1 px-2">
          <span class="font-bold text-emerald-700">Sim</span>
        </td>
      </tr>
    `;
  }

  function updateLisCompProp(prop, val) {
    if (selectedLisCompIndex === null || !lisComponents[selectedLisCompIndex]) return;
    lisComponents[selectedLisCompIndex][prop] = val;
    renderLisCanvas();
  }

  // DESELECIONAR AO CLICAR FORA DE QUALQUER COMPONENTE NO CANVAS
  function deselectLisComponentIfPaper(e) {
    if (e && e.target && e.target.closest && e.target.closest('[id^="lis-element-"]')) {
      return;
    }
    selectLisComponent(null);
  }

  // EVENTOS DE ARRASTAR COMPONENTES NO CANVAS
  function onStartDragLisComp(e, index) {
    if (e && e.stopPropagation) e.stopPropagation();
    selectLisComponent(index);
    isDraggingLisComp = true;

    const paper = document.getElementById('lis-canvas-paper');
    if (!paper) return;

    const paperRect = paper.getBoundingClientRect();
    const comp = lisComponents[index];

    dragOffsetX = e.clientX - (paperRect.left + comp.esquerda);
    dragOffsetY = e.clientY - (paperRect.top + comp.topo);

    document.addEventListener('mousemove', onMouseMoveLisDrag);
    document.addEventListener('mouseup', onMouseUpLisDrag);
  }

  function onMouseMoveLisDrag(e) {
    if (!isDraggingLisComp || selectedLisCompIndex === null) return;
    const paper = document.getElementById('lis-canvas-paper');
    if (!paper) return;

    const paperRect = paper.getBoundingClientRect();
    let newX = Math.round((e.clientX - paperRect.left - dragOffsetX) / 5) * 5;
    let newY = Math.round((e.clientY - paperRect.top - dragOffsetY) / 5) * 5;

    newX = Math.max(0, Math.min(newX, 680 - lisComponents[selectedLisCompIndex].largura));
    newY = Math.max(0, Math.min(newY, 880 - lisComponents[selectedLisCompIndex].altura));

    lisComponents[selectedLisCompIndex].esquerda = newX;
    lisComponents[selectedLisCompIndex].topo = newY;

    renderLisCanvas();
  }

  function onMouseUpLisDrag() {
    isDraggingLisComp = false;
    document.removeEventListener('mousemove', onMouseMoveLisDrag);
    document.removeEventListener('mouseup', onMouseUpLisDrag);
  }

  // EVENTOS DE REDIMENSIONAR COMPONENTES NO CANVAS (PUXANDO PELAS BORDAS/CANTOS)
  let isResizingLisComp = false;
  let resizeHandleType = null;
  let resizeInitX = 0;
  let resizeInitY = 0;
  let resizeInitW = 0;
  let resizeInitH = 0;
  let resizeInitLeft = 0;
  let resizeInitTop = 0;

  function onStartResizeLisComp(e, index, handle) {
    e.stopPropagation();
    e.preventDefault();
    selectLisComponent(index);

    isResizingLisComp = true;
    resizeHandleType = handle;
    resizeInitX = e.clientX;
    resizeInitY = e.clientY;

    const comp = lisComponents[index];
    resizeInitW = comp.largura;
    resizeInitH = comp.altura;
    resizeInitLeft = comp.esquerda;
    resizeInitTop = comp.topo;

    document.addEventListener('mousemove', onMouseMoveLisResize);
    document.addEventListener('mouseup', onMouseUpLisResize);
  }

  function onMouseMoveLisResize(e) {
    if (!isResizingLisComp || selectedLisCompIndex === null) return;
    const comp = lisComponents[selectedLisCompIndex];
    if (!comp) return;

    const dx = e.clientX - resizeInitX;
    const dy = e.clientY - resizeInitY;

    let newW = resizeInitW;
    let newH = resizeInitH;
    let newX = resizeInitLeft;
    let newY = resizeInitTop;

    if (resizeHandleType.includes('right')) {
      newW = Math.max(20, Math.round((resizeInitW + dx) / 5) * 5);
    }
    if (resizeHandleType.includes('left')) {
      const wRaw = resizeInitW - dx;
      newW = Math.max(20, Math.round(wRaw / 5) * 5);
      newX = resizeInitLeft + (resizeInitW - newW);
    }
    if (resizeHandleType.includes('bottom') || resizeHandleType === 'se' || resizeHandleType === 'sw') {
      newH = Math.max(15, Math.round((resizeInitH + dy) / 5) * 5);
    }
    if (resizeHandleType.includes('top') || resizeHandleType === 'ne' || resizeHandleType === 'nw') {
      const hRaw = resizeInitH - dy;
      newH = Math.max(15, Math.round(hRaw / 5) * 5);
      newY = resizeInitTop + (resizeInitH - newH);
    }

    comp.largura = newW;
    comp.altura = newH;
    comp.esquerda = newX;
    comp.topo = newY;

    renderLisCanvas();
  }

  function onMouseUpLisResize() {
    isResizingLisComp = false;
    resizeHandleType = null;
    document.removeEventListener('mousemove', onMouseMoveLisResize);
    document.removeEventListener('mouseup', onMouseUpLisResize);
  }

  function addLisComponent(type) {
    const id = 'comp_' + Date.now();
    const count = lisComponents.length + 1;
    let label = 'NovoTexto' + count;
    let defaultText = 'Novo Campo';
    let compType = 'Texto';

    if (type === 'variavel') {
      label = 'CampoVariavel' + count;
      defaultText = '{{resultado}}';
      compType = 'Campo Variável';
    } else if (type === 'resultado_simples') {
      label = 'ResultadoSimples' + count;
      defaultText = '{{resultado}}';
      compType = 'Resultado Simples';
    } else if (type === 'dinamico') {
      label = 'Expressao' + count;
      defaultText = 'Expressão: [Normal]';
      compType = 'Expressão';
    } else if (type === 'linha') {
      label = 'LinhaDivisoria' + count;
      defaultText = '------------------------------------------------------------';
      compType = 'Linha';
    } else if (type === 'caixa') {
      label = 'Moldura' + count;
      defaultText = '';
      compType = 'Retângulo';
    } else if (type === 'referencia') {
      label = 'ValoresRef' + count;
      defaultText = 'Valores de Referência:\nNormal: 10 a 50';
      compType = 'Val. Referência';
    } else if (type === 'grafico') {
      label = 'Grafico' + count;
      defaultText = '[Gráfico de Evolução]';
      compType = 'Gráfico';
    } else if (type === 'imagem') {
      label = 'Logotipo' + count;
      defaultText = '[LOGOTIPO / CHANCELA]';
      compType = 'Imagem';
    }

    const newComp = {
      id: id,
      nome: label,
      componente: compType,
      texto: defaultText,
      esquerda: 60,
      topo: 100 + (count * 20),
      largura: 250,
      altura: 40,
      fonte: 'Courier New',
      tamanho: '11px',
      negrito: false,
      maiusculas: false,
      alinhamento: 'left',
      corFonte: '#0f172a',
      corFundo: type === 'caixa' ? '#f1f5f9' : 'transparent',
      unidade: type === 'resultado_simples' ? 'mg/dL' : '',
      imprimir: true,
      opaco: type === 'caixa'
    };

    lisComponents.push(newComp);
    selectLisComponent(lisComponents.length - 1);
    showToast(`Componente "${label}" adicionado ao layout!`, 'success');
  }

  function deleteSelectedLisComponent() {
    if (selectedLisCompIndex === null) {
      showToast('Selecione um elemento para excluir.', 'warning');
      return;
    }
    const comp = lisComponents[selectedLisCompIndex];
    lisComponents.splice(selectedLisCompIndex, 1);
    selectedLisCompIndex = null;
    renderLisCanvas();
    showToast(`Elemento "${comp.nome}" removido.`, 'info');
  }

  function centerSelectedLisComponent() {
    if (selectedLisCompIndex === null || !lisComponents[selectedLisCompIndex]) return;
    const comp = lisComponents[selectedLisCompIndex];
    comp.esquerda = Math.round((680 - comp.largura) / 2);
    renderLisCanvas();
    showToast('Elemento centralizado.', 'info');
  }

  // PERSISTÊNCIA DO MODELO LIS POR ORIGEM (INTERNO, ÁLVARO, PARDINI)
  function saveLisLayoutModel() {
    const activeCodeEl = document.getElementById('m-active-code');
    const examCode = (activeCodeEl && activeCodeEl.textContent.trim() !== '-') 
      ? activeCodeEl.textContent.trim() 
      : 'GLICOSE DE JEJUM';

    const providerKey = activeLisProviderKey || 'interno';
    const provNames = { interno: 'Interno', alvaro: 'Álvaro', pardini: 'Pardini' };
    
    // Salvar sob a chave específica da origem/provedor
    localStorage.setItem(`lis_layout_${examCode}_${providerKey}`, JSON.stringify(lisComponents));
    
    // Se for o modelo interno, salvar também sob a chave fallback geral
    if (providerKey === 'interno') {
      localStorage.setItem(`lis_layout_${examCode}`, JSON.stringify(lisComponents));
    }

    showToast(`Modelo de layout WYSIWYG (${provNames[providerKey]}) salvo para "${examCode}"!`, 'success');
  }

  function loadLisLayoutModel(examCode, providerKey = 'interno') {
    const targetProvider = providerKey || activeLisProviderKey || 'interno';
    let saved = localStorage.getItem(`lis_layout_${examCode}_${targetProvider}`);

    // Fallback: se não houver layout específico do apoio, tenta o layout interno ou base
    if (!saved && targetProvider !== 'interno') {
      saved = localStorage.getItem(`lis_layout_${examCode}_interno`);
    }
    if (!saved) {
      saved = localStorage.getItem(`lis_layout_${examCode}`);
    }

    if (saved) {
      try {
        lisComponents = JSON.parse(saved);
      } catch (e) {
        lisComponents = getDefaultLisComponents(examCode);
      }
    } else {
      lisComponents = getDefaultLisComponents(examCode);
    }
    selectedLisCompIndex = 0;
    renderLisCanvas();
  }

  function resetLisLayoutModel() {
    const activeCodeEl = document.getElementById('m-active-code');
    const examCode = (activeCodeEl && activeCodeEl.textContent.trim() !== '-') 
      ? activeCodeEl.textContent.trim() 
      : 'GLICOSE DE JEJUM';

    const providerKey = activeLisProviderKey || 'interno';
    const provNames = { interno: 'Interno', alvaro: 'Álvaro', pardini: 'Pardini' };

    localStorage.removeItem(`lis_layout_${examCode}_${providerKey}`);
    if (providerKey === 'interno') {
      localStorage.removeItem(`lis_layout_${examCode}`);
    }

    lisComponents = getDefaultLisComponents(examCode);
    selectedLisCompIndex = 0;
    renderLisCanvas();
    showToast(`Layout (${provNames[providerKey]}) restaurado para os componentes originais.`, 'info');
  }

  // ATALHO DE TECLADO: EXCLUIR ELEMENTO COM TECLA DEL OU BACKSPACE QUANDO SELECIONADO
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Delete' || e.key === 'Del' || (e.key === 'Backspace' && !['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement?.tagName) && !document.activeElement?.isContentEditable)) {
      const modal = document.getElementById('modal-lis-layout-editor');
      if (!modal || modal.classList.contains('hidden')) return;

      const active = document.activeElement;
      if (active && (active.tagName === 'INPUT' || active.tagName === 'TEXTAREA' || active.tagName === 'SELECT' || active.isContentEditable)) {
        return;
      }

      if (selectedLisCompIndex !== null && typeof lisComponents[selectedLisCompIndex] !== 'undefined') {
        e.preventDefault();
        deleteSelectedLisComponent();
      }
    }
  });
</script>

