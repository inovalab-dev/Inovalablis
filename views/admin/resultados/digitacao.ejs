  function renderLaudoWithCreatedModel(containerEl, data) {
    if (!containerEl) return;
    
    // 1. Gerar a Estrutura Fixa JSON do Laudo
    const laudoJson = buildStandardLaudoJson(data);
    window.activeLaudoJson = laudoJson;

    const mainExam = laudoJson.exames[0] || {};
    const examCode = mainExam.codigo || 'EXAME';

    // Paciente & Recomendações
    const patientName = laudoJson.paciente.nome;
    const doctor = laudoJson.paciente.medico;
    const convenio = laudoJson.paciente.convenio;
    const reqCode = laudoJson.paciente.requisicaoCode;
    const dataColeta = laudoJson.paciente.dataRequisicao;
    const liberadoPor = data?.liberadoPor || 'Dr. Alysson Silva (Resp. Técnico)';
    const hash = data?.hash || '30b0159888103142783ca35ff8ea92ad';

    containerEl.className = "bg-white text-slate-900 p-6 sm:p-10 shadow-xl border border-slate-300 w-full max-w-3xl min-h-[850px] font-mono text-xs leading-normal relative rounded-lg select-none";

    let examesHtml = laudoJson.exames.map(ex => {
      const hasInterpretation = Boolean(ex.interpretacao && String(ex.interpretacao).trim());
      const hasObservacao = Boolean(ex.observacao && String(ex.observacao).trim());

      return `
        <div class="mb-6 font-mono">
          <!-- TÍTULO DO EXAME EM FAIXA DESTAQUE -->
          <div class="bg-slate-200 border border-slate-400 py-1.5 px-3 text-center font-bold text-sm text-slate-950 uppercase tracking-wider mb-3 rounded-xs">
            ${escapeLisHtml(ex.titulo)}
          </div>

          <!-- DADOS TÉCNICOS E CABEÇALHO DO EXAME -->
          <div class="text-[10.5px] space-y-0.5 text-slate-800 border-b border-slate-200 pb-2 mb-3">
            <div class="flex flex-wrap gap-x-6 gap-y-1">
              <div><span class="text-slate-600 font-medium">Material:</span> <strong class="text-slate-900">${escapeLisHtml(ex.material)}</strong></div>
              <div><span class="text-slate-600 font-medium">Método:</span> <strong class="text-slate-900">${escapeLisHtml(ex.metodo)}</strong></div>
              ${ex.equipamento ? `<div><span class="text-slate-600 font-medium">Equipamento:</span> <strong class="text-slate-900">${escapeLisHtml(ex.equipamento)}</strong></div>` : ''}
            </div>
          </div>

          <!-- 1. BLOCO DE RESULTADO(S) -->
          <div class="space-y-2 bg-slate-50/90 p-3 border border-slate-200 rounded-xs mb-3">
            ${ex.linhas.map(l => {
              const rawParam = String(l.PARAMETRO || l.part1 || 'Resultado').trim();
              const isGenericParam = rawParam.toUpperCase() === 'RESULTADO' || rawParam.toUpperCase() === 'VALOR OBTIDO';
              let paramDisplay = isGenericParam 
                ? 'Resultado...:' 
                : (rawParam.endsWith('...') ? rawParam + ':' : (rawParam.endsWith(':') ? rawParam.replace(/:$/, '...:') : rawParam + '...:'));

              let valStr = String(l.resultado !== undefined && l.resultado !== null ? l.resultado : '').trim();
              let unitStr = (l.unidade || ex.unidade || ex.unit || (document.getElementById('f-unit') ? document.getElementById('f-unit').value : '')).trim();
              if (!unitStr) {
                unitStr = extractUnitFromText(ex.valorReferencia || ex.resultadoText || ex.resultado || '') || '';
              }
              if (unitStr && valStr.toLowerCase().endsWith(unitStr.toLowerCase())) {
                unitStr = '';
              }

              return `
              <div class="flex items-baseline gap-2 text-xs font-mono border-b border-dashed border-slate-200 pb-1.5 last:border-0 last:pb-0">
                <span class="font-bold text-slate-900 text-xs">${escapeLisHtml(paramDisplay)}</span>
                <span class="font-extrabold text-slate-950 text-sm tracking-wide">
                  ${escapeLisHtml(valStr)}${unitStr ? ` <span class="not-italic text-xs font-bold text-slate-800 ml-1">${escapeLisHtml(unitStr)}</span>` : ''}
                </span>
              </div>
              `;
            }).join('')}
