            <option value="transparent" ${comp.corFundo === 'transparent' ? 'selected' : ''}>Transparente</option>
            <option value="#ffffff" ${comp.corFundo === '#ffffff' ? 'selected' : ''}>Branca</option>
            <option value="#f8fafc" ${comp.corFundo === '#f8fafc' ? 'selected' : ''}>Cinza Claro</option>
