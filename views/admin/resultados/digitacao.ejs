    setTxt('m-active-code', ex.code || 'EXAME');
    setTxt('m-active-title', (ex.code ? ex.code + ' - ' : '') + (ex.name || 'Nome do Exame'));

    const catEx = findCatalogExam(ex.code || ex.codigo || examCode, ex.name || ex.titulo || ex.desc);

    const sheetTitleEl = document.getElementById('laudo-sheet-exam-title');
    if (sheetTitleEl) {
      const customTitle = ex.tituloLaudo || (catEx && (catEx.tituloLaudo || catEx.name)) || ex.name || ex.code || 'EXAME';
      sheetTitleEl.textContent = customTitle.toUpperCase();
