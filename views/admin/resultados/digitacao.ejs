    const examCode = (activeCodeEl && activeCodeEl.textContent.trim() !== '-') 
      ? activeCodeEl.textContent.trim() 
      : 'GLICOSE DE JEJUM';

    document.getElementById('lis-modal-exam-title').textContent = examCode;
    document.getElementById('lis-footer-exam-code').textContent = examCode;

    const selectEl = document.getElementById('lis-provider-select');
    if (selectEl) selectEl.value = activeLisProviderKey;

    loadLisLayoutModel(examCode, activeLisProviderKey);

    const modal = document.getElementById('modal-lis-layout-editor');
    if (modal) modal.classList.remove('hidden');
  }

  function switchLisProviderModel(providerKey) {
    activeLisProviderKey = providerKey || 'interno';
    const activeCodeEl = document.getElementById('m-active-code');
    const examCode = (activeCodeEl && activeCodeEl.textContent.trim() !== '-') 
      ? activeCodeEl.textContent.trim() 
      : 'GLICOSE DE JEJUM';

    loadLisLayoutModel(examCode, activeLisProviderKey);

    const provNames = { interno: 'Interno', alvaro: 'Álvaro', pardini: 'Pardini' };
    showToast(`Carregado layout do modelo ${provNames[activeLisProviderKey] || 'Interno'}`, 'info');
  }

  function closeLisLayoutModal() {
    const modal = document.getElementById('modal-lis-layout-editor');
    if (modal) modal.classList.add('hidden');
  }

  function renderLisCanvas() {
    const container = document.getElementById('lis-canvas-elements-container');
    if (!container) return;

    container.innerHTML = lisComponents.map((comp, idx) => {
      const isSelected = selectedLisCompIndex === idx;
      const borderStyle = isSelected ? 'border-2 border-indigo-600 shadow-md ring-2 ring-indigo-400/50 z-20' : 'border border-slate-400/70 hover:border-slate-600 z-10';
      
      const handles = isSelected ? `
        <div onmousedown="onStartResizeLisComp(event, ${idx}, 'nw')" class="absolute -top-1.5 -left-1.5 w-3.5 h-3.5 bg-indigo-600 border-2 border-white rounded-full cursor-nwse-resize z-30 hover:scale-125 transition-transform" title="Redimensionar Canto Superior Esquerdo"></div>
        <div onmousedown="onStartResizeLisComp(event, ${idx}, 'top')" class="absolute -top-1.5 left-1/2 -translate-x-1/2 w-3.5 h-3.5 bg-indigo-600 border-2 border-white rounded-full cursor-ns-resize z-30 hover:scale-125 transition-transform" title="Redimensionar Altura Superior"></div>
        <div onmousedown="onStartResizeLisComp(event, ${idx}, 'ne')" class="absolute -top-1.5 -right-1.5 w-3.5 h-3.5 bg-indigo-600 border-2 border-white rounded-full cursor-nesw-resize z-30 hover:scale-125 transition-transform" title="Redimensionar Canto Superior Direito"></div>
        <div onmousedown="onStartResizeLisComp(event, ${idx}, 'right')" class="absolute top-1/2 -right-1.5 -translate-y-1/2 w-3.5 h-3.5 bg-indigo-600 border-2 border-white rounded-full cursor-ew-resize z-30 hover:scale-125 transition-transform" title="Redimensionar Largura (Direita)"></div>
        <div onmousedown="onStartResizeLisComp(event, ${idx}, 'se')" class="absolute -bottom-1.5 -right-1.5 w-3.5 h-3.5 bg-indigo-600 border-2 border-white rounded-full cursor-nwse-resize z-30 hover:scale-125 transition-transform" title="Redimensionar Canto Inferior Direito"></div>
        <div onmousedown="onStartResizeLisComp(event, ${idx}, 'bottom')" class="absolute -bottom-1.5 left-1/2 -translate-x-1/2 w-3.5 h-3.5 bg-indigo-600 border-2 border-white rounded-full cursor-ns-resize z-30 hover:scale-125 transition-transform" title="Redimensionar Altura (Inferior)"></div>
        <div onmousedown="onStartResizeLisComp(event, ${idx}, 'sw')" class="absolute -bottom-1.5 -left-1.5 w-3.5 h-3.5 bg-indigo-600 border-2 border-white rounded-full cursor-nesw-resize z-30 hover:scale-125 transition-transform" title="Redimensionar Canto Inferior Esquerdo"></div>
        <div onmousedown="onStartResizeLisComp(event, ${idx}, 'left')" class="absolute top-1/2 -left-1.5 -translate-y-1/2 w-3.5 h-3.5 bg-indigo-600 border-2 border-white rounded-full cursor-ew-resize z-30 hover:scale-125 transition-transform" title="Redimensionar Largura (Esquerda)"></div>
      ` : '';

      const textTransform = comp.maiusculas ? 'uppercase' : 'none';
      const fontWeight = comp.negrito ? 'bold' : 'normal';

      // Se for Resultado Simples ou possuir unidade de medida concatenada
      let displayText = comp.texto;
      if (comp.componente === 'Resultado Simples' || comp.unidade) {
        const valStr = comp.texto || '{{resultado}}';
        const unitStr = comp.unidade ? ` ${comp.unidade}` : '';
        displayText = `${valStr}${unitStr}`;
      }

      return `
        <div
          id="lis-element-${idx}"
          onmousedown="onStartDragLisComp(event, ${idx})"
          onclick="selectLisComponent(${idx})"
          class="absolute p-2 cursor-move flex items-center justify-${comp.alinhamento === 'center' ? 'center' : comp.alinhamento === 'right' ? 'end' : 'start'} ${borderStyle} transition-shadow"
          style="
            left: ${comp.esquerda}px;
            top: ${comp.topo}px;
            width: ${comp.largura}px;
            height: ${comp.altura}px;
            font-family: '${comp.fonte}', monospace;
            font-size: ${comp.tamanho};
            font-weight: ${fontWeight};
            text-transform: ${textTransform};
            color: ${comp.corFonte};
            background-color: ${comp.corFundo};
            white-space: pre-wrap;
          "
        >
          <span>${escapeLisHtml(displayText)}</span>
          ${handles}
        </div>
      `;
    }).join('');

    renderLisPropertiesGrid();
  }

  function escapeLisHtml(str) {
    if (!str) return '';
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function selectLisComponent(index) {
