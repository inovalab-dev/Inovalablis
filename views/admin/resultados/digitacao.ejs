  function buildStandardLaudoJson(data) {
    const d = data || {};

    // Se a entrada já for um objeto padronizado com 'paciente' e 'exames'
    if (d.paciente && Array.isArray(d.exames)) {
      return {
        paciente: {
          nome: d.paciente.nome || d.paciente.patientName || document.getElementById('m-patient-name')?.textContent || 'Paciente',
          idade: d.paciente.idade || d.paciente.patientAge || 'N/I',
          medico: d.paciente.medico || d.paciente.doctor || document.getElementById('m-doctor')?.textContent || 'Não Informado',
          convenio: d.paciente.convenio || document.getElementById('m-convenio')?.textContent || 'Particular',
          procedencia: d.paciente.procedencia || 'Coleta',
          dataRequisicao: d.paciente.dataRequisicao || d.paciente.dataColeta || new Date().toLocaleDateString('pt-BR'),
          dataEmissao: d.paciente.dataEmissao || new Date().toLocaleDateString('pt-BR'),
          requisicaoCode: String(d.paciente.requisicaoCode || d.paciente.requisitionCode || d.paciente.reqCode || document.getElementById('m-req-code')?.textContent || '').replace('#', '') || String(selectedReqId || '00000')
        },
        exames: d.exames.map(ex => {
          const code = ex.codigo || ex.code || 'EXAME';
          const catEx = findCatalogExam(code, ex.titulo || ex.examTitle || ex.desc || ex.name);
          const title = (ex.titulo || ex.examTitle || ex.desc || ex.name || (catEx && (catEx.tituloLaudo || catEx.name)) || code).toUpperCase();
          let rawRes = ex.resultadoText !== undefined ? ex.resultadoText : (ex.result !== undefined ? ex.result : (ex.resultado !== undefined ? ex.resultado : ''));
          if (!rawRes || !String(rawRes).trim()) rawRes = 'Sem resultado';

          const isCurrentActive = (activeExamCode && String(code).toUpperCase() === String(activeExamCode).toUpperCase()) || d.exames.length === 1;
          const currentInputRef = isCurrentActive ? document.getElementById('f-ref-value')?.value : '';
          const refVal = ex.valorReferencia || extractExamReferenceValue(ex, catEx, currentInputRef);

          const manualUnit = isCurrentActive 
            ? (document.getElementById('f-unit')?.value || ex.unidade || ex.unit || '') 
            : (ex.unidade || ex.unit || document.getElementById('f-unit')?.value || '');
          const unitFromRef = extractUnitFromText(refVal) || extractUnitFromText(rawRes);

          const currentInputUnit = String(manualUnit).trim() 
            || (ex.unidade && String(ex.unidade).trim())
            || (ex.unit && String(ex.unit).trim())
            || (ex.linhas && ex.linhas[0] && ex.linhas[0].unidade && String(ex.linhas[0].unidade).trim()) 
            || (catEx && (catEx.unidade || catEx.unit)) 
            || unitFromRef 
            || '';

          let linhas = [];
          if (Array.isArray(ex.linhas) && ex.linhas.length > 0) {
            linhas = ex.linhas.map(l => {
              const param = l.PARAMETRO || (l.part1 ? String(l.part1).replace(/:\s*$/, '') : 'Resultado');
              const valRaw = l.resultado !== undefined ? l.resultado : l.value;
              const strVal = String(valRaw !== undefined && valRaw !== null ? valRaw : '').trim();
              return {
                PARAMETRO: param,
                resultado: strVal,
                unidade: l.unidade || l.unit || currentInputUnit
              };
            });
          } else {
            const rawLines = String(rawRes).split(/[|\n]/).filter(l => l.trim().length > 0);
            linhas = rawLines.map(lineStr => {
              if (lineStr.includes(':')) {
                const parts = lineStr.split(':');
                const p1 = parts[0].trim();
                const rest = parts.slice(1).join(':').trim();
                const restTokens = rest.split(/\s+/);
                const valStr = restTokens[0] || '';
                const unit = restTokens.slice(1).join(' ') || '';
                return { PARAMETRO: p1, resultado: valStr || rest, unidade: unit || currentInputUnit };
              } else {
                const tokens = lineStr.trim().split(/\s+/);
                const valStr = tokens[0] || lineStr;
                const unit = tokens.slice(1).join(' ') || '';
                return { PARAMETRO: 'Resultado', resultado: valStr, unidade: unit || currentInputUnit };
              }
            });
          }

          linhas.forEach(l => {
            if (!l.unidade || !l.unidade.trim()) {
              l.unidade = currentInputUnit;
            }
          });

          return {
            codigo: code,
            titulo: title,
            situacao: (ex.situacao || ex.status || 'DIGITADO').toUpperCase(),
            liberado: Boolean(ex.liberado || (ex.situacao || ex.status) === 'LIBERADO'),
            material: ex.material || (catEx && (catEx.materialLaudo || catEx.material)) || 'Soro',
            metodo: ex.metodo || (catEx && (catEx.metodoLaudo || catEx.metodo)) || 'Colorimétrico',
            equipamento: ex.equipamento || (catEx && (catEx.equipment || catEx.equipamento)) || '',
            interpretacao: ex.interpretacao || ex.interpretation || '',
            observacao: ex.observacao || ex.observations || '',
            valorReferencia: refVal,
            unidade: currentInputUnit,
            unit: currentInputUnit,
            linhas: linhas
          };
        })
      };
    }

    const activeCodeEl = document.getElementById('m-active-code');
    const defaultCode = d.examCode || d.code || (activeCodeEl && activeCodeEl.textContent.trim() !== '-' ? activeCodeEl.textContent.trim() : 'EXAME');
    const defaultTitle = (d.examTitle || d.desc || d.code || defaultCode || 'EXAME').toUpperCase();

    // Dados do Paciente e Requerimento
    let patientName = d.patientName || document.getElementById('m-patient-name')?.textContent || 'Paciente';
    if (!patientName.trim() || patientName === '-') patientName = 'Paciente';

    let doctor = d.doctor || document.getElementById('m-doctor')?.textContent || 'Médico Não Informado';
    if (!doctor.trim() || doctor === '-') doctor = 'Médico Não Informado';

    let convenio = d.convenio || document.getElementById('m-convenio')?.textContent || 'Particular';
    if (!convenio.trim() || convenio === '-') convenio = 'Particular';

    let reqCode = d.reqCode || document.getElementById('m-req-code')?.textContent || '#' + (selectedReqId || '00000');
    if (!reqCode.trim() || reqCode === '-') reqCode = '#' + (selectedReqId || '00000');

    const nowStr = new Date().toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' });
    const dataColeta = d.dataResultado || nowStr;

    // Se d.exames for um array (ex: importação multi-exame do XML ou requisição completa), iterar sobre eles
    const examesInput = Array.isArray(d.exames) && d.exames.length > 0 ? d.exames : [d];

    const examesFormatados = examesInput.map(ex => {
      const code = ex.codigo || ex.code || ex.examCode || defaultCode;
      const catEx = findCatalogExam(code, ex.titulo || ex.examTitle || ex.desc || ex.name);
      const title = (ex.titulo || ex.examTitle || ex.desc || ex.name || (catEx && (catEx.tituloLaudo || catEx.name)) || defaultTitle).toUpperCase();

      let rawRes = ex.resultadoText !== undefined ? ex.resultadoText : (ex.result !== undefined ? ex.result : (ex.resultado !== undefined ? ex.resultado : ''));
      if (!rawRes && activeExamCode && String(code).toUpperCase() === String(activeExamCode).toUpperCase()) {
        rawRes = document.getElementById('f-result')?.value || '';
      }
      if (!rawRes || !String(rawRes).trim()) rawRes = 'Sem resultado';

      const statusStr = (ex.status || ex.situacao || (activeExamCode && String(code).toUpperCase() === String(activeExamCode).toUpperCase() ? document.getElementById('f-status')?.value : 'Digitado') || 'DIGITADO').toUpperCase();
      const isLiberado = statusStr === 'LIBERADO';

      const isCurrentActive = (activeExamCode && String(code).toUpperCase() === String(activeExamCode).toUpperCase()) || examesInput.length === 1;
      const currentInputRef = isCurrentActive ? document.getElementById('f-ref-value')?.value : '';
      const refVal = extractExamReferenceValue(ex, catEx, currentInputRef);

      // Extração inteligente de unidade de medida (se não preenchida manualmente)
      const manualUnit = isCurrentActive 
        ? (document.getElementById('f-unit')?.value || ex.unidade || ex.unit || '') 
        : (ex.unidade || ex.unit || document.getElementById('f-unit')?.value || '');
      const unitFromRef = extractUnitFromText(refVal) || extractUnitFromText(rawRes);

      const currentInputUnit = String(manualUnit).trim() 
        || (ex.unidade && String(ex.unidade).trim())
        || (ex.unit && String(ex.unit).trim())
        || (ex.linhas && ex.linhas[0] && ex.linhas[0].unidade && String(ex.linhas[0].unidade).trim()) 
        || (catEx && (catEx.unidade || catEx.unit)) 
        || unitFromRef 
        || '';

      // Transformar a string de resultado em linhas estruturadas [ { PARAMETRO, resultado, unidade } ]
      let linhas = [];
      if (Array.isArray(ex.linhas) && ex.linhas.length > 0) {
        linhas = ex.linhas.map(l => {
          const param = l.PARAMETRO || (l.part1 ? String(l.part1).replace(/:\s*$/, '') : 'Resultado');
          const valRaw = l.resultado !== undefined ? l.resultado : l.value;
          const strVal = String(valRaw !== undefined && valRaw !== null ? valRaw : '').trim();
          return {
            PARAMETRO: param,
            resultado: strVal,
            unidade: l.unidade || l.unit || currentInputUnit
          };
        });
      } else {
        const rawLines = String(rawRes).split(/[|\n]/).filter(l => l.trim().length > 0);
        linhas = rawLines.map(lineStr => {
          if (lineStr.includes(':')) {
            const parts = lineStr.split(':');
            const p1 = parts[0].trim();
            const rest = parts.slice(1).join(':').trim();
            const restTokens = rest.split(/\s+/);
            const valStr = restTokens[0] || '';
            const unit = restTokens.slice(1).join(' ') || '';
            return {
              PARAMETRO: p1,
              resultado: valStr,
              unidade: unit || currentInputUnit
            };
          } else {
            const tokens = lineStr.trim().split(/\s+/);
            const valStr = tokens[0] || lineStr;
            const unit = tokens.slice(1).join(' ') || '';
            return {
              PARAMETRO: 'Resultado',
              resultado: valStr,
              unidade: unit || currentInputUnit
            };
          }
        });
      }

      linhas.forEach(l => {
        if (!l.unidade || !l.unidade.trim()) {
          l.unidade = currentInputUnit;
        }
      });

      return {
        codigo: code,
        titulo: title,
        situacao: statusStr,
        liberado: isLiberado,
        material: ex.material || (isCurrentActive ? document.getElementById('f-material')?.value : '') || (catEx && (catEx.materialLaudo || catEx.material)) || 'Soro',
        metodo: ex.metodo || ex.method || (isCurrentActive ? document.getElementById('f-method')?.value : '') || (catEx && (catEx.metodoLaudo || catEx.metodo)) || 'Colorimétrico',
        equipamento: ex.equipamento || ex.equipment || (isCurrentActive ? document.getElementById('f-equipment')?.value : '') || (catEx && (catEx.equipment || catEx.equipamento)) || '',
        interpretacao: ex.interpretacao || ex.interpretation || (isCurrentActive ? document.getElementById('f-interpretation')?.value : '') || '',
        observacao: ex.observacao || ex.observations || (isCurrentActive ? document.getElementById('f-observations')?.value : '') || '',
        valorReferencia: refVal,
        linhas: linhas
      };
    });

    return {
      paciente: {
        nome: patientName,
        idade: d.idade || 'N/I',
        medico: doctor,
        convenio: convenio,
        procedencia: d.procedencia || 'Coleta',
        dataRequisicao: dataColeta.split(' ')[0] || new Date().toLocaleDateString('pt-BR'),
        dataEmissao: dataColeta.split(' ')[0] || new Date().toLocaleDateString('pt-BR'),
        requisicaoCode: String(reqCode || '').replace('#', '')
      },
      exames: examesFormatados
    };
  }

