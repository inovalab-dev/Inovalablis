    if (!window.activeLaudoJson) {
      showToast('Nenhum JSON ativo no momento.', 'error');
      return;
    }
    const str = JSON.stringify(window.activeLaudoJson, null, 2);
    navigator.clipboard.writeText(str).then(() => {
      showToast('Estrutura JSON do Laudo copiada para a área de transferência!', 'success');
    }).catch(() => {
      console.log(str);
      alert('Estrutura JSON enviada para o console do navegador.');
    });
