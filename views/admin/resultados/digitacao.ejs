<!-- CONTAINER DE NOTIFICAÇÕES (TOASTS) -->
<div id="toast-container" class="fixed bottom-5 right-5 z-[99999] flex flex-col gap-2 pointer-events-none"></div>

<!-- SCRIPT DE LÓGICA E PAGINAÇÃO CLIENT-SIDE -->
<script>
  window.TRIAGEM_REQUISITIONS = <%- JSON.stringify(requisitions || []) %>;
  window.TRIAGEM_EXAMS = <%- JSON.stringify(exams || []) %>;

  let currentPage = 1;
  let itemsPerPage = 50;
  let filteredRequisitions = [];
  let selectedReqId = null;
  let activeExamCode = null;

  document.addEventListener('DOMContentLoaded', () => {
    initFilters();
    applyFiltersAndRender();
  });

  function initFilters() {
    document.getElementById('filter-search').addEventListener('input', () => { currentPage = 1; applyFiltersAndRender(); });
    document.getElementById('filter-doctor').addEventListener('change', () => { currentPage = 1; applyFiltersAndRender(); });
    document.getElementById('filter-convenio').addEventListener('change', () => { currentPage = 1; applyFiltersAndRender(); });
    document.getElementById('filter-sort').addEventListener('change', () => { currentPage = 1; applyFiltersAndRender(); });
    document.getElementById('filter-limit').addEventListener('change', (e) => {
      currentPage = 1;
      itemsPerPage = e.target.value === 'todos' ? 999999 : parseInt(e.target.value) || 50;
      applyFiltersAndRender();
    });
    document.getElementById('filter-urgent').addEventListener('change', () => { currentPage = 1; applyFiltersAndRender(); });
    document.getElementById('filter-lote-only').addEventListener('change', () => { currentPage = 1; applyFiltersAndRender(); });

    document.getElementById('btn-clear-filters').addEventListener('click', () => {
      document.getElementById('filter-search').value = '';
      document.getElementById('filter-doctor').value = '';
      document.getElementById('filter-convenio').value = '';
      document.getElementById('filter-sort').value = 'mais_recentes';
      document.getElementById('filter-limit').value = '50';
      document.getElementById('filter-urgent').checked = false;
      document.getElementById('filter-lote-only').checked = true;
      currentPage = 1;
      itemsPerPage = 50;
      applyFiltersAndRender();
    });

    document.getElementById('btn-prev-page').addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        renderTable();
      }
    });

    document.getElementById('btn-next-page').addEventListener('click', () => {
      const totalPages = Math.ceil(filteredRequisitions.length / itemsPerPage);
      if (currentPage < totalPages) {
        currentPage++;
        renderTable();
      }
    });

    // Tecla ESC para fechar modal
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeTypingModal();
    });
  }

  function isExamInLote(e) {
    if (!e) return false;
    const st = String(e.status || '').trim().toLowerCase();
    const lst = String(e.loteStatus || '').trim().toLowerCase();
    return st === 'lote criado' || lst === 'lote criado' || lst === 'gerado' || !!e.loteCode || !!e.idLote;
  }

  function applyFiltersAndRender() {
    const allReqs = window.TRIAGEM_REQUISITIONS || [];
    const query = (document.getElementById('filter-search').value || '').toLowerCase().trim();
    const doctor = (document.getElementById('filter-doctor').value || '').trim();
    const convenio = (document.getElementById('filter-convenio').value || '').trim();
    const sort = document.getElementById('filter-sort').value;
    const isUrgentOnly = document.getElementById('filter-urgent').checked;
    const isLoteOnly = document.getElementById('filter-lote-only').checked;

    // Estatísticas globais
    let totalReqs = allReqs.length;
    let countLote = 0;
    let countDigitacao = 0;
    let countConferidos = 0;
    let countLiberados = 0;

    allReqs.forEach(req => {
      const reqExams = req.exams || [];
      const hasLoteExam = reqExams.some(e => isExamInLote(e));
      if (req.status === 'Lote criado' || hasLoteExam) countLote++;
      if (req.status === 'Em Digitação' || reqExams.some(e => e.status === 'Digitado')) countDigitacao++;
      if (req.status === 'Conferido' || reqExams.some(e => e.status === 'Conferido')) countConferidos++;
      if (req.status === 'Liberado' || (reqExams.length > 0 && reqExams.every(e => e.status === 'Liberado'))) countLiberados++;
    });

    document.getElementById('stat-total').textContent = totalReqs;
    document.getElementById('stat-lote').textContent = countLote;
    document.getElementById('stat-digitacao').textContent = countDigitacao;
    document.getElementById('stat-conferidos').textContent = countConferidos;
    document.getElementById('stat-liberados').textContent = countLiberados;

    // Filtrar
    filteredRequisitions = allReqs.filter(req => {
      const reqCode = String(req.requisitionCode || req.id || '').toLowerCase();
      const pName = String(req.patientName || '').toLowerCase();
      const pCpf = String(req.patientCpf || '').toLowerCase();
      const reqExams = req.exams || [];
      const examNames = reqExams.map(e => (e.name || '') + ' ' + (e.code || '')).join(' ').toLowerCase();

      const matchesQuery = !query || reqCode.includes(query) || pName.includes(query) || pCpf.includes(query) || examNames.includes(query);
      const matchesDoctor = !doctor || (req.doctorName || '').includes(doctor);
      const matchesConvenio = !convenio || (req.convenio || '').includes(convenio);
      const matchesUrgent = !isUrgentOnly || (req.isUrgent || req.situacao === 'Urgente');
      const matchesLote = !isLoteOnly || (req.status === 'Lote criado' || reqExams.some(e => isExamInLote(e)));

      return matchesQuery && matchesDoctor && matchesConvenio && matchesUrgent && matchesLote;
    });

    // Ordenação
    filteredRequisitions.sort((a, b) => {
      const dateA = new Date(a.createdAt || a.updatedAt || 0).getTime();
      const dateB = new Date(b.createdAt || b.updatedAt || 0).getTime();

      if (sort === 'mais_antigas') return dateA - dateB;
      if (sort === 'em_atraso') {
        const isAtrasoA = a.deliveryDate && new Date(a.deliveryDate).getTime() < Date.now();
        const isAtrasoB = b.deliveryDate && new Date(b.deliveryDate).getTime() < Date.now();
        if (isAtrasoA && !isAtrasoB) return -1;
        if (!isAtrasoA && isAtrasoB) return 1;
      }
      return dateB - dateA; // padrão: mais recentes
    });

    renderTable();
  }

  function renderTable() {
    const tbody = document.getElementById('requisitions-tbody');
    const emptyState = document.getElementById('empty-state');
    tbody.innerHTML = '';

    if (filteredRequisitions.length === 0) {
      emptyState.classList.remove('hidden');
      document.getElementById('pagination-info').textContent = 'Exibindo 0 de 0 requisições';
      document.getElementById('btn-prev-page').disabled = true;
      document.getElementById('btn-next-page').disabled = true;
      document.getElementById('pagination-pages').innerHTML = '';
      return;
    }

    emptyState.classList.add('hidden');

    const totalPages = Math.ceil(filteredRequisitions.length / itemsPerPage);
    if (currentPage > totalPages) currentPage = totalPages;

    const startIdx = (currentPage - 1) * itemsPerPage;
    const endIdx = Math.min(startIdx + itemsPerPage, filteredRequisitions.length);
    const pageItems = filteredRequisitions.slice(startIdx, endIdx);

    pageItems.forEach(req => {
      const tr = document.createElement('tr');
      tr.className = 'hover:bg-slate-50/80 transition-colors cursor-pointer border-b border-slate-100';
      tr.onclick = (e) => {
        if (!e.target.closest('button')) openTypingModal(req.id || req.requisitionCode);
      };

      const reqExams = req.exams || [];
      const urgentBadge = (req.isUrgent || req.situacao === 'Urgente') 
        ? '<span class="px-1.5 py-0.5 bg-red-100 text-red-800 text-[9.5px] font-bold rounded uppercase font-mono ml-1">Urgente</span>'
        : '';

      // Badges de Exames
      const examBadgesHtml = reqExams.map(e => {
        let stClass = 'bg-slate-100 text-slate-700 border-slate-200';
        if (isExamInLote(e)) stClass = 'bg-amber-100 text-amber-800 border-amber-300 font-bold';
        if (e.status === 'Digitado') stClass = 'bg-blue-100 text-blue-800 border-blue-300';
        if (e.status === 'Conferido') stClass = 'bg-indigo-100 text-indigo-800 border-indigo-300 font-bold';
        if (e.status === 'Liberado') stClass = 'bg-emerald-100 text-emerald-800 border-emerald-300 font-bold';

        return `<span class="px-2 py-0.5 text-[10px] rounded-md border font-mono ${stClass}" title="${e.name || e.code}">
          ${e.code}: ${e.status || 'Pendente'}
        </span>`;
      }).join(' ');

      tr.innerHTML = `
        <td class="py-3 px-4">
          <div class="font-mono font-black text-[#284701] text-sm flex items-center">
            #${req.requisitionCode || req.id} ${urgentBadge}
          </div>
          <div class="text-[10.5px] text-slate-400 font-mono mt-0.5">
            ${req.createdAt || 'Data N/I'}
          </div>
        </td>
        <td class="py-3 px-4">
          <div class="font-bold text-slate-800 text-xs">${req.patientName || 'Paciente Não Informado'}</div>
          <div class="text-[10.5px] text-slate-500 font-mono">
            ${req.patientAge || ''} • ${req.patientSex || 'N/I'} ${req.patientBirthDate ? '• ' + req.patientBirthDate : ''}
          </div>
        </td>
        <td class="py-3 px-4">
          <div class="font-medium text-slate-700 text-xs">${req.doctorName || 'Dr(a). Não Informado'}</div>
          <div class="text-[10.5px] text-brand-gold font-semibold font-mono">${req.convenio || 'Particular'}</div>
        </td>
        <td class="py-3 px-4">
          <div class="font-mono text-slate-700 font-bold text-xs">${req.deliveryDate || 'Hoje'} ${req.deliveryTime || ''}</div>
          <span class="px-2 py-0.5 text-[10px] font-bold rounded-full bg-slate-100 text-slate-700 inline-block mt-0.5">
            ${req.status || 'Pendente'}
          </span>
        </td>
        <td class="py-3 px-4 max-w-xs">
          <div class="flex flex-wrap gap-1">
            ${examBadgesHtml || '<span class="text-slate-400 italic">Nenhum exame</span>'}
          </div>
        </td>
        <td class="py-3 px-4 text-right">
          <button
            type="button"
            onclick="openTypingModal('${req.id || req.requisitionCode}')"
            class="px-3 py-1.5 bg-[#284701] hover:bg-[#1f3701] text-white text-xs font-bold rounded-xl transition-all shadow-2xs hover:shadow flex items-center gap-1 ml-auto"
          >
            <span>⌨️</span> Digitar
          </button>
        </td>
      `;

      tbody.appendChild(tr);
    });

    // Atualizar Paginação UI
    document.getElementById('pagination-info').textContent = `Exibindo ${startIdx + 1} a ${endIdx} de ${filteredRequisitions.length} requisições`;
    document.getElementById('btn-prev-page').disabled = currentPage === 1;
    document.getElementById('btn-next-page').disabled = currentPage === totalPages;

    const pagesContainer = document.getElementById('pagination-pages');
    pagesContainer.innerHTML = '';

    for (let p = 1; p <= totalPages; p++) {
      if (totalPages > 7 && Math.abs(p - currentPage) > 2 && p !== 1 && p !== totalPages) continue;

      const pageBtn = document.createElement('button');
      pageBtn.className = `w-7 h-7 rounded-lg text-xs font-bold transition-all ${
        p === currentPage
          ? 'bg-[#284701] text-white shadow-2xs'
          : 'text-slate-600 hover:bg-slate-100 border border-slate-200'
      }`;
      pageBtn.textContent = p;
      pageBtn.onclick = () => { currentPage = p; renderTable(); };
      pagesContainer.appendChild(pageBtn);
    }
  }

  // ==========================================
  // LÓGICA DO MODAL DE DIGITAÇÃO DE RESULTADOS
  // ==========================================
  function openTypingModal(reqId) {
    const allReqs = window.TRIAGEM_REQUISITIONS || [];
    const req = allReqs.find(r => (r.id || r.requisitionCode) === reqId || r.id === reqId);
    if (!req) return showToast('Requisição não encontrada.', 'error');

    selectedReqId = req.id || req.requisitionCode;

    // Preencher Header do Modal
    document.getElementById('m-req-code').textContent = '#' + (req.requisitionCode || req.id);
    document.getElementById('m-patient-name').textContent = req.patientName || 'Paciente';
    document.getElementById('m-patient-details').textContent = `Nasc: ${req.patientBirthDate || 'N/I'} | Idade: ${req.patientAge || 'N/I'} | Sexo: ${req.patientSex || 'N/I'}`;
    document.getElementById('m-doctor').textContent = req.doctorName || 'Não Informado';
    document.getElementById('m-convenio').textContent = req.convenio || 'Particular';
    document.getElementById('m-coleta-status').textContent = `${req.createdAt || ''} [${req.status || 'Lote criado'}]`;

    // Renderizar Lista de Exames da Requisição
    const reqExams = req.exams || [];
    document.getElementById('m-exam-count-badge').textContent = `${reqExams.length} exames`;
    const examsList = document.getElementById('m-exams-list');
    examsList.innerHTML = '';

    if (reqExams.length === 0) {
      examsList.innerHTML = '<div class="p-4 text-center text-xs text-slate-400">Nenhum exame cadastrado nesta requisição.</div>';
    } else {
      reqExams.forEach((ex, idx) => {
        const itemBtn = document.createElement('button');
        itemBtn.type = 'button';
        itemBtn.className = `w-full text-left p-3 rounded-xl transition-all border ${
          idx === 0
            ? 'bg-brand-gold/10 border-brand-gold/40 text-slate-900 font-bold'
            : 'bg-white border-slate-200 text-slate-700 hover:bg-slate-50'
        } exam-item-btn`;
        itemBtn.dataset.code = ex.code || ex.codigo;

        let badgeClass = 'bg-slate-100 text-slate-600';
        if (isExamInLote(ex)) badgeClass = 'bg-amber-100 text-amber-800 font-bold';
        if (ex.status === 'Digitado') badgeClass = 'bg-blue-100 text-blue-800 font-bold';
        if (ex.status === 'Conferido') badgeClass = 'bg-indigo-100 text-indigo-800 font-bold';
        if (ex.status === 'Liberado') badgeClass = 'bg-emerald-100 text-emerald-800 font-bold';

        itemBtn.innerHTML = `
          <div class="flex items-center justify-between mb-1">
            <span class="font-mono font-bold text-xs text-slate-900">${ex.code}</span>
            <span class="px-2 py-0.5 text-[9.5px] rounded border ${badgeClass}">
              ${ex.status || 'Pendente'}
            </span>
          </div>
          <div class="text-xs font-semibold truncate text-slate-800">${ex.name || 'Exame'}</div>
          <div class="text-[10px] text-slate-400 font-mono mt-0.5">${ex.material || 'Sangue'}</div>
        `;

        itemBtn.onclick = () => selectExamInModal(ex.code || ex.codigo);
        examsList.appendChild(itemBtn);
      });

      // Selecionar o primeiro exame por padrão
      selectExamInModal(reqExams[0].code || reqExams[0].codigo);
    }

    document.getElementById('typing-modal').classList.remove('hidden');
  }

  function closeTypingModal() {
    document.getElementById('typing-modal').classList.add('hidden');
    selectedReqId = null;
    activeExamCode = null;
  }

  function selectExamInModal(examCode) {
    activeExamCode = examCode;
    const allReqs = window.TRIAGEM_REQUISITIONS || [];
    const req = allReqs.find(r => (r.id || r.requisitionCode) === selectedReqId || r.id === selectedReqId);
    if (!req) return;

    const ex = (req.exams || []).find(e => (e.code || e.codigo) === examCode);
    if (!ex) return;

    // Atualizar classe ativa na sidebar
    document.querySelectorAll('.exam-item-btn').forEach(btn => {
      if (btn.dataset.code === examCode) {
        btn.classList.add('bg-brand-gold/10', 'border-brand-gold/40', 'font-bold');
        btn.classList.remove('bg-white', 'border-slate-200');
      } else {
        btn.classList.remove('bg-brand-gold/10', 'border-brand-gold/40', 'font-bold');
        btn.classList.add('bg-white', 'border-slate-200');
      }
    });

    // Preencher campos do formulário com verificação segura contra elementos nulos
    const setVal = (id, val) => { const el = document.getElementById(id); if (el) el.value = val; };
    const setTxt = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = val; };

    setTxt('m-active-code', ex.code || 'EXAME');
    setTxt('m-active-title', (ex.code ? ex.code + ' - ' : '') + (ex.name || 'Nome do Exame'));
    setTxt('m-active-status-badge', ex.status || 'Pendente');

    const sheetTitleEl = document.getElementById('laudo-sheet-exam-title');
    if (sheetTitleEl) {
      sheetTitleEl.textContent = (ex.name || ex.code || 'EXAME').toUpperCase();
    }

    setVal('f-material', ex.material || 'Soro');
    setVal('f-method', ex.method || ex.metodo || 'Colorimétrico');
    setVal('f-result', ex.result || ex.resultado || '');
    setVal('f-ref-value', ex.referenceValue || ex.valorReferencia || 'Até 1 ano.........: 0 a 29 U/L\nDe 1 a 12 anos....: 10 a 37 U/L\nDe 13 a 18 anos...: 11 a 46 U/L\nAcima de 18 anos..: 13 a 60 U/L');
    setVal('f-interpretation', ex.interpretation || ex.interpretacao || '');
    setVal('f-observations', ex.observations || ex.observacoes || 'Amostra coletada e identificada pelo Hospital Municipal de Cambará.');
    setVal('f-status', ex.status || 'Digitado');

    // Carregar configurações de modelo personalizadas salvas para este exame
    loadExamModelTemplate(ex.code || examCode);
  }

  function fillQuickTemplate(type) {
    const resultInput = document.getElementById('f-result');
    if (type === 'Negativo') resultInput.value = 'Resultado: NEGATIVO';
    else if (type === 'Positivo') resultInput.value = 'Resultado: POSITIVO';
    else if (type === 'Normal') resultInput.value = 'Resultado: NORMAL';
  }

  async function saveActiveExam(targetStatus) {
    if (!selectedReqId || !activeExamCode) {
      return showToast('Selecione uma requisição e um exame.', 'error');
    }

    const payload = {
      requisitionId: selectedReqId,
      examCode: activeExamCode,
      result: document.getElementById('f-result')?.value || '',
      referenceValue: document.getElementById('f-ref-value')?.value || '',
      method: document.getElementById('f-method')?.value || '',
      material: document.getElementById('f-material')?.value || '',
      interpretation: document.getElementById('f-interpretation')?.value || '',
      observations: document.getElementById('f-observations')?.value || '',
      status: targetStatus || document.getElementById('f-status')?.value || 'Digitado'
    };

    try {
      const resp = await fetch('/admin/resultados/salvar-exame', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const data = await resp.json();
      if (data.success) {
        showToast(data.message || 'Exame salvo com sucesso!', 'success');

        // Atualizar estado local em memória
        const req = (window.TRIAGEM_REQUISITIONS || []).find(r => (r.id || r.requisitionCode) === selectedReqId || r.id === selectedReqId);
        if (req && Array.isArray(req.exams)) {
          const ex = req.exams.find(e => (e.code || e.codigo) === activeExamCode);
          if (ex) {
            ex.result = payload.result;
            ex.referenceValue = payload.referenceValue;
            ex.method = payload.method;
            ex.material = payload.material;
            ex.interpretation = payload.interpretation;
            ex.observations = payload.observations;
            ex.status = payload.status;
          }
          if (data.requisitionStatus) req.status = data.requisitionStatus;
        }

        // Reabrir modal para atualizar visuais
        openTypingModal(selectedReqId);
        applyFiltersAndRender();

        // Se a ação for de liberação, abrir automaticamente o laudo gerado utilizando o modelo criado
        if (targetStatus === 'Liberado') {
          openLaudoPreviewModal();
        }
      } else {
        showToast(data.message || 'Erro ao salvar exame.', 'error');
      }
    } catch (err) {
      console.error(err);
      showToast('Erro de comunicação com o servidor.', 'error');
    }
  }

  async function bulkActionReq(action) {
    if (!selectedReqId) return;

    const actionText = action === 'conferir_todos' ? 'conferir todos os exames' : 'liberar todos os laudos';
    if (!confirm(`Deseja realmente ${actionText} desta requisição?`)) return;

    try {
      const resp = await fetch('/admin/resultados/salvar-requisicao-completa', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ requisitionId: selectedReqId, action })
      });

      const data = await resp.json();
      if (data.success) {
        showToast(data.message || 'Requisição atualizada!', 'success');

        const req = (window.TRIAGEM_REQUISITIONS || []).find(r => (r.id || r.requisitionCode) === selectedReqId || r.id === selectedReqId);
        if (req && Array.isArray(req.exams)) {
          req.exams.forEach(ex => {
            ex.status = action === 'conferir_todos' ? 'Conferido' : 'Liberado';
          });
          req.status = action === 'conferir_todos' ? 'Conferido' : 'Liberado';
        }

        openTypingModal(selectedReqId);
        applyFiltersAndRender();
      } else {
        showToast(data.message || 'Erro ao atualizar requisição.', 'error');
      }
    } catch (err) {
      console.error(err);
      showToast('Erro de comunicação ao atualizar requisição.', 'error');
