    setVal('f-equipment', ex.equipment || ex.equipamento || (catEx && (catEx.equipment || catEx.equipamento)) || 'Urit 8021A - Automatizado');
    setVal('f-result', ex.result || ex.resultado || '');

    const refVal = extractExamReferenceValue(ex, catEx);
    setVal('f-ref-value', refVal);

    const extractedUnit = extractUnitFromText(refVal) || extractUnitFromText(ex.result || ex.resultado);
    const unitVal = ex.unidade || ex.unit || (ex.linhas && ex.linhas[0] && ex.linhas[0].unidade) || (catEx && (catEx.unidade || catEx.unit)) || extractedUnit || '';
