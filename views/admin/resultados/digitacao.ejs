<!-- SCRIPT DE LÓGICA E PAGINAÇÃO CLIENT-SIDE -->
<script>
  window.TRIAGEM_REQUISITIONS = <%- JSON.stringify(requisitions || []) %>;
  window.TRIAGEM_EXAMS = <%- JSON.stringify(exams || []) %>;
  window.EXAMS_CATALOG = window.TRIAGEM_EXAMS;

  let currentPage = 1;
  let itemsPerPage = 50;
  let filteredRequisitions = [];
  let selectedReqId = null;
  let activeExamCode = null;

  document.addEventListener('DOMContentLoaded', () => {
    initFilters();

    const urlParams = new URLSearchParams(window.location.search);
    const reqQuery = urlParams.get('req') || urlParams.get('codigo') || urlParams.get('search');
    if (reqQuery) {
      const searchInput = document.getElementById('filter-search');
      if (searchInput) searchInput.value = reqQuery;
    }

    applyFiltersAndRender();

    if (reqQuery) {
      const match = (window.TRIAGEM_REQUISITIONS || []).find(r => 
        String(r.requisitionCode || r.id || '').toLowerCase() === reqQuery.toLowerCase()
      );
      if (match) {
        openTypingModal(match.id || match.requisitionCode);
      }
    }
  });

  function initFilters() {
    document.getElementById('filter-search').addEventListener('input', () => { currentPage = 1; applyFiltersAndRender(); });
    document.getElementById('filter-doctor').addEventListener('change', () => { currentPage = 1; applyFiltersAndRender(); });
    document.getElementById('filter-convenio').addEventListener('change', () => { currentPage = 1; applyFiltersAndRender(); });
    document.getElementById('filter-sort').addEventListener('change', () => { currentPage = 1; applyFiltersAndRender(); });
    document.getElementById('filter-limit').addEventListener('change', (e) => {
      currentPage = 1;
      itemsPerPage = e.target.value === 'todos' ? 999999 : parseInt(e.target.value) || 50;
      applyFiltersAndRender();
    });
    document.getElementById('filter-urgent').addEventListener('change', () => { currentPage = 1; applyFiltersAndRender(); });
    document.getElementById('filter-lote-only').addEventListener('change', () => { currentPage = 1; applyFiltersAndRender(); });

    document.getElementById('btn-clear-filters').addEventListener('click', () => {
      document.getElementById('filter-search').value = '';
      document.getElementById('filter-doctor').value = '';
      document.getElementById('filter-convenio').value = '';
      document.getElementById('filter-sort').value = 'mais_recentes';
      document.getElementById('filter-limit').value = '50';
      document.getElementById('filter-urgent').checked = false;
      document.getElementById('filter-lote-only').checked = false;
      currentPage = 1;
      itemsPerPage = 50;
      applyFiltersAndRender();
    });

    document.getElementById('btn-prev-page').addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        renderTable();
      }
    });

    document.getElementById('btn-next-page').addEventListener('click', () => {
      const totalPages = Math.ceil(filteredRequisitions.length / itemsPerPage);
      if (currentPage < totalPages) {
        currentPage++;
        renderTable();
      }
    });

    // Tecla ESC para fechar modal
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeTypingModal();
    });
  }

  function isExamInLote(e) {
    if (!e) return false;
    const st = String(e.status || '').trim().toLowerCase();
    const lst = String(e.loteStatus || '').trim().toLowerCase();
    return st === 'lote criado' || lst === 'lote criado' || lst === 'gerado' || !!e.loteCode || !!e.idLote;
  }

  function applyFiltersAndRender() {
    const allReqs = window.TRIAGEM_REQUISITIONS || [];
    const query = (document.getElementById('filter-search').value || '').toLowerCase().trim();
    const doctor = (document.getElementById('filter-doctor').value || '').trim();
    const convenio = (document.getElementById('filter-convenio').value || '').trim();
    const sort = document.getElementById('filter-sort').value;
    const isUrgentOnly = document.getElementById('filter-urgent').checked;
    const isLoteOnly = document.getElementById('filter-lote-only').checked;

    // Estatísticas globais
    let totalReqs = allReqs.length;
    let countLote = 0;
    let countDigitacao = 0;
    let countConferidos = 0;
    let countLiberados = 0;

    allReqs.forEach(req => {
      const reqExams = req.exams || [];
      const hasLoteExam = reqExams.some(e => isExamInLote(e));
      if (req.status === 'Lote criado' || hasLoteExam) countLote++;
      if (req.status === 'Em Digitação' || reqExams.some(e => e.status === 'Digitado')) countDigitacao++;
      if (req.status === 'Conferido' || reqExams.some(e => e.status === 'Conferido')) countConferidos++;
      if (req.status === 'Liberado' || (reqExams.length > 0 && reqExams.every(e => e.status === 'Liberado'))) countLiberados++;
    });

    document.getElementById('stat-total').textContent = totalReqs;
    document.getElementById('stat-lote').textContent = countLote;
    document.getElementById('stat-digitacao').textContent = countDigitacao;
    document.getElementById('stat-conferidos').textContent = countConferidos;
    document.getElementById('stat-liberados').textContent = countLiberados;

    // Filtrar
    filteredRequisitions = allReqs.filter(req => {
      const reqCode = String(req.requisitionCode || req.id || '').toLowerCase();
      const pName = String(req.patientName || '').toLowerCase();
      const pCpf = String(req.patientCpf || '').toLowerCase();
      const reqExams = req.exams || [];
      const examNames = reqExams.map(e => (e.name || '') + ' ' + (e.code || '')).join(' ').toLowerCase();

      const matchesQuery = !query || reqCode.includes(query) || pName.includes(query) || pCpf.includes(query) || examNames.includes(query);
      const matchesDoctor = !doctor || (req.doctorName || '').includes(doctor);
      const matchesConvenio = !convenio || (req.convenio || '').includes(convenio);
      const matchesUrgent = !isUrgentOnly || (req.isUrgent || req.situacao === 'Urgente');
      const matchesLote = !isLoteOnly || (req.status === 'Lote criado' || reqExams.some(e => isExamInLote(e)));

      return matchesQuery && matchesDoctor && matchesConvenio && matchesUrgent && matchesLote;
    });

    // Ordenação
    filteredRequisitions.sort((a, b) => {
      const dateA = new Date(a.createdAt || a.updatedAt || 0).getTime();
      const dateB = new Date(b.createdAt || b.updatedAt || 0).getTime();

      if (sort === 'mais_antigas') return dateA - dateB;
      if (sort === 'em_atraso') {
        const isAtrasoA = a.deliveryDate && new Date(a.deliveryDate).getTime() < Date.now();
        const isAtrasoB = b.deliveryDate && new Date(b.deliveryDate).getTime() < Date.now();
        if (isAtrasoA && !isAtrasoB) return -1;
        if (!isAtrasoA && isAtrasoB) return 1;
      }
      return dateB - dateA; // padrão: mais recentes
    });

    renderTable();
  }

  function renderTable() {
    const tbody = document.getElementById('requisitions-tbody');
    const emptyState = document.getElementById('empty-state');
    tbody.innerHTML = '';

    if (filteredRequisitions.length === 0) {
      emptyState.classList.remove('hidden');
      document.getElementById('pagination-info').textContent = 'Exibindo 0 de 0 requisições';
      document.getElementById('btn-prev-page').disabled = true;
      document.getElementById('btn-next-page').disabled = true;
      document.getElementById('pagination-pages').innerHTML = '';
      return;
    }

    emptyState.classList.add('hidden');

    const totalPages = Math.ceil(filteredRequisitions.length / itemsPerPage);
    if (currentPage > totalPages) currentPage = totalPages;

    const startIdx = (currentPage - 1) * itemsPerPage;
    const endIdx = Math.min(startIdx + itemsPerPage, filteredRequisitions.length);
    const pageItems = filteredRequisitions.slice(startIdx, endIdx);

    pageItems.forEach(req => {
      const tr = document.createElement('tr');
      tr.className = 'hover:bg-slate-50/80 transition-colors cursor-pointer border-b border-slate-100';
      tr.onclick = (e) => {
        if (!e.target.closest('button')) openTypingModal(req.id || req.requisitionCode);
      };

      const urgentBadge = (req.isUrgent || req.situacao === 'Urgente') 
        ? '<span class="px-1.5 py-0.5 bg-red-100 text-red-800 text-[9px] font-bold rounded uppercase font-mono ml-1">Urgente</span>'
        : '';

      let reqStatusBadgeClass = 'bg-slate-100 text-slate-700 border-slate-200';
      const stLower = String(req.status || '').toLowerCase();
      if (stLower === 'conferido' || stLower === 'liberado' || stLower === 'pronto') {
        reqStatusBadgeClass = 'bg-emerald-100 text-emerald-800 border-emerald-300 font-bold';
      } else if (stLower === 'em digitação' || stLower === 'digitado') {
        reqStatusBadgeClass = 'bg-blue-100 text-blue-800 border-blue-300 font-bold';
      } else if (stLower === 'coletado' || stLower === 'processando' || stLower === 'em execução') {
        reqStatusBadgeClass = 'bg-amber-100 text-amber-800 border-amber-300 font-bold';
      }

      // Formatadores para exibição compacta
      const formattedDate = (str) => {
        if (!str) return 'N/I';
        if (typeof str === 'string' && str.includes('/')) {
          const parts = str.split(',');
          if (parts.length === 2) {
            const timeParts = parts[1].trim().split(':');
            if (timeParts.length >= 2) return `${parts[0].trim()} ${timeParts[0]}:${timeParts[1]}`;
          }
          return str.trim();
        }
        try {
          const d = new Date(str);
          if (!isNaN(d.getTime())) {
            const day = String(d.getDate()).padStart(2, '0');
            const month = String(d.getMonth() + 1).padStart(2, '0');
            const year = d.getFullYear();
            const hours = String(d.getHours()).padStart(2, '0');
            const mins = String(d.getMinutes()).padStart(2, '0');
            return `${day}/${month}/${year} ${hours}:${mins}`;
          }
        } catch(e) {}
        return String(str);
      };

      const convenioFormatted = (req.convenioCode && String(req.convenioCode).trim() !== '') 
        ? `${req.convenioCode} - ${req.convenio || 'Particular'}` 
        : (req.convenio || 'Particular');

      const prazoFormatted = `${req.deliveryDate || 'Hoje'}${req.deliveryTime ? ' ' + req.deliveryTime : ''}`;

      // Regras de Habilitação dos Botões (Liberar & Visualizar)
      // Liberar: Disponível quando o status da requisição for Coletado, Não Enviado ou Processando (ou Em Execução)
      const reqStatusTrimmed = String(req.status || '').toLowerCase().trim();
      const allowedLiberarStatuses = ['coletado', 'não enviado', 'nao enviado', 'processando', 'em execução'];
      const isLiberarClickable = allowedLiberarStatuses.includes(reqStatusTrimmed);

      // Visualizar: Disponível sempre que houver ao menos 1 exame digitado ou liberado/conferido
      const reqExamsList = req.exams || [];
      const hasTypedOrReleasedExam = reqExamsList.some(e => {
        const eSt = String(e.status || '').toLowerCase().trim();
        const hasResultVal = (e.result && String(e.result).trim() !== '') || (e.resultado && String(e.resultado).trim() !== '');
        return ['digitado', 'conferido', 'liberado', 'pronto', 'concluído', 'laudado'].includes(eSt) || hasResultVal;
      });
      const isReqReleasedOrConferido = ['conferido', 'liberado', 'pronto', 'concluído', 'laudado'].includes(reqStatusTrimmed);
      const isVisualizarClickable = isReqReleasedOrConferido || hasTypedOrReleasedExam;

      tr.innerHTML = `
        <td class="py-2 px-3 whitespace-nowrap font-mono font-black text-[#284701] text-xs">
          #${req.requisitionCode || req.id} ${urgentBadge}
        </td>
        <td class="py-2 px-3 whitespace-nowrap font-mono text-slate-600 text-xs">
          ${formattedDate(req.createdAt)}
        </td>
        <td class="py-2 px-3 font-bold text-slate-800 text-xs whitespace-nowrap">
          ${req.patientName || 'Paciente Não Informado'}
        </td>
        <td class="py-2 px-3 whitespace-nowrap font-mono text-slate-600 text-xs">
          ${req.patientAge || 'N/I'}
        </td>
        <td class="py-2 px-3 text-slate-700 text-xs whitespace-nowrap">
          ${req.doctorName || req.responsibleName || 'Dr(a). Não Informado'}
        </td>
        <td class="py-2 px-3 whitespace-nowrap text-brand-gold font-semibold font-mono text-xs">
          ${convenioFormatted}
        </td>
        <td class="py-2 px-3 whitespace-nowrap font-mono text-slate-700 font-medium text-xs">
          ${prazoFormatted}
        </td>
        <td class="py-2 px-3 whitespace-nowrap">
          <span class="px-2 py-0.5 text-[10px] rounded-full border inline-block ${reqStatusBadgeClass}">
            ${req.status || 'Pendente'}
          </span>
        </td>
        <td class="py-2 px-3 text-right whitespace-nowrap">
          <div class="flex items-center justify-end gap-1.5">
            <!-- Botão Visualizar -->
            ${isVisualizarClickable ? `
              <button
                type="button"
                onclick="openRequisitionPdfModal('${req.requisitionCode || req.id}')"
                class="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-white text-xs font-bold rounded-lg transition-all shadow-2xs hover:shadow inline-flex items-center gap-1 cursor-pointer"
                title="Visualizar laudo em PDF"
              >
                <span>👁️</span> Visualizar
              </button>
            ` : `
              <button
                type="button"
                disabled
                class="px-2.5 py-1 bg-slate-100 text-slate-400 text-xs font-bold rounded-lg border border-slate-200 opacity-60 cursor-not-allowed inline-flex items-center gap-1"
                title="Visualização indisponível (nenhum exame digitado ou liberado)"
              >
                <span>👁️</span> Visualizar
              </button>
            `}

            <!-- Botão Liberar -->
            ${isLiberarClickable ? `
              <button
                type="button"
                onclick="openTypingModal('${req.id || req.requisitionCode}')"
                class="px-2.5 py-1 bg-[#284701] hover:bg-[#1f3701] text-white text-xs font-bold rounded-lg transition-all shadow-2xs hover:shadow inline-flex items-center gap-1 cursor-pointer"
                title="Abrir para digitação e liberação"
              >
                <span>⌨️</span> Liberar
              </button>
            ` : `
              <button
                type="button"
                disabled
                class="px-2.5 py-1 bg-slate-100 text-slate-400 text-xs font-bold rounded-lg border border-slate-200 opacity-60 cursor-not-allowed inline-flex items-center gap-1"
                title="Liberação indisponível para o status atual (${req.status || 'Pendente'})"
              >
                <span>🔒</span> Liberar
              </button>
            `}
          </div>
        </td>
      `;

      tbody.appendChild(tr);
    });

    // Atualizar Paginação UI
    document.getElementById('pagination-info').textContent = `Exibindo ${startIdx + 1} a ${endIdx} de ${filteredRequisitions.length} requisições`;
    document.getElementById('btn-prev-page').disabled = currentPage === 1;
    document.getElementById('btn-next-page').disabled = currentPage === totalPages;

    const pagesContainer = document.getElementById('pagination-pages');
    pagesContainer.innerHTML = '';

    for (let p = 1; p <= totalPages; p++) {
      if (totalPages > 7 && Math.abs(p - currentPage) > 2 && p !== 1 && p !== totalPages) continue;

      const pageBtn = document.createElement('button');
      pageBtn.className = `w-7 h-7 rounded-lg text-xs font-bold transition-all ${
        p === currentPage
          ? 'bg-[#284701] text-white shadow-2xs'
          : 'text-slate-600 hover:bg-slate-100 border border-slate-200'
      }`;
      pageBtn.textContent = p;
      pageBtn.onclick = () => { currentPage = p; renderTable(); };
      pagesContainer.appendChild(pageBtn);
    }
  }

  // ==========================================
  // LÓGICA DO MODAL DE DIGITAÇÃO DE RESULTADOS
  // ==========================================
  function openTypingModal(reqId, initialExamCode) {
    const allReqs = window.TRIAGEM_REQUISITIONS || [];
    const req = allReqs.find(r => (r.id || r.requisitionCode) === reqId || r.id === reqId);
    if (!req) return showToast('Requisição não encontrada.', 'error');

    selectedReqId = req.id || req.requisitionCode;

    // Preencher Header do Modal
    document.getElementById('m-req-code').textContent = '#' + (req.requisitionCode || req.id);
    document.getElementById('m-patient-name').textContent = req.patientName || 'Paciente';
    document.getElementById('m-patient-details').textContent = `Nasc: ${req.patientBirthDate || 'N/I'} | Idade: ${req.patientAge || 'N/I'} | Sexo: ${req.patientSex || 'N/I'}`;
    document.getElementById('m-doctor').textContent = req.doctorName || 'Não Informado';
    document.getElementById('m-convenio').textContent = req.convenio || 'Particular';
    document.getElementById('m-coleta-status').textContent = `${req.createdAt || ''} [${req.status || 'Lote criado'}]`;

    // Renderizar Lista de Exames da Requisição
    const reqExams = req.exams || [];
    document.getElementById('m-exam-count-badge').textContent = `${reqExams.length} exames`;
    updatePreviewAllButtonState(req);

    const examsList = document.getElementById('m-exams-list');
    examsList.innerHTML = '';

    if (reqExams.length === 0) {
      examsList.innerHTML = '<div class="p-4 text-center text-xs text-slate-400">Nenhum exame cadastrado nesta requisição.</div>';
    } else {
      reqExams.forEach((ex) => {
        const itemBtn = document.createElement('div');
        const codeVal = ex.code || ex.codigo;
        itemBtn.className = `w-full text-left p-3 rounded-xl transition-all border exam-item-btn bg-white border-slate-200 text-slate-700 hover:bg-slate-50 cursor-pointer flex flex-col justify-between`;
        itemBtn.dataset.code = codeVal;

        let badgeClass = 'bg-slate-100 text-slate-600 border-slate-200';
        if (isExamInLote(ex)) badgeClass = 'bg-amber-100 text-amber-800 border-amber-300 font-bold';
        if (ex.status === 'Digitado') badgeClass = 'bg-blue-100 text-blue-800 border-blue-300 font-bold';
        if (ex.status === 'Conferido') badgeClass = 'bg-indigo-100 text-indigo-800 border-indigo-300 font-bold';
        if (ex.status === 'Liberado') badgeClass = 'bg-emerald-100 text-emerald-800 border-emerald-300 font-bold';

        itemBtn.innerHTML = `
          <div class="flex items-center justify-between mb-1" onclick="selectExamInModal('${codeVal}')">
            <span class="font-mono font-bold text-xs text-slate-900">${codeVal}</span>
            <span class="px-2 py-0.5 text-[9.5px] rounded border ${badgeClass}">
              ${ex.status || 'Pendente'}
            </span>
          </div>
          <div class="text-xs font-semibold truncate text-slate-800 mb-1" onclick="selectExamInModal('${codeVal}')">${ex.name || 'Exame'}</div>
          <div class="text-[10px] text-slate-400 font-mono pt-1 border-t border-slate-100 flex items-center justify-between">
            <span class="truncate">${ex.material || 'Sangue'}</span>
          </div>
        `;

        itemBtn.onclick = () => {
          selectExamInModal(codeVal);
        };
        examsList.appendChild(itemBtn);
      });

      // Selecionar o exame desejado ou o primeiro
      let codeToSelect = initialExamCode;
      if (!codeToSelect || !reqExams.some(e => (e.code || e.codigo) === codeToSelect)) {
        codeToSelect = reqExams[0].code || reqExams[0].codigo;
      }
      selectExamInModal(codeToSelect);
    }

    document.getElementById('typing-modal').classList.remove('hidden');
  }

  // Helper para buscar modelo/cadastro do exame no catálogo
  function findCatalogExam(code, name) {
    const catalog = window.TRIAGEM_EXAMS || window.EXAMS_CATALOG || [];
    if (!catalog || catalog.length === 0) return null;
    const targetCode = String(code || '').trim().toUpperCase();
    const targetName = String(name || '').trim().toUpperCase();

    if (targetCode) {
      const byCode = catalog.find(c => {
        if (!c) return false;
        const cCode = String(c.code || c.codigo || c.jalisCode || c.id || '').trim().toUpperCase();
        return cCode === targetCode;
      });
      if (byCode) return byCode;
    }

    if (targetName) {
      const byName = catalog.find(c => {
        if (!c) return false;
        const cName = String(c.name || c.tituloLaudo || c.desc || c.titulo || '').trim().toUpperCase();
        return cName === targetName || (cName && targetName && (cName.includes(targetName) || targetName.includes(cName)));
      });
      if (byName) return byName;
    }

    return null;
  }

  // Helper para extrair unidade de medida de referências e resultados
  function extractUnitFromText(text) {
    if (!text) return '';
    const str = String(text);
    const regex = /(?:mg|µg|ug|ng|pg|g|U|IU|mUI|UI|mEq|mmol|umol|µmol|fL)\/(?:dL|mL|L|mm³|mm3|uL|µL|L)|mm³|mm3|%|uL|µL|U\/L|UI\/L|mUI\/mL|UI\/mL|U\/mL|mg\/dL|g\/dL|µg\/dL|ug\/dL|ng\/dL|pg\/mL|ng\/mL|mEq\/L|mmol\/L|10\^[0-9]\/[uµ]L/i;
    const match = str.match(regex);
    return match ? match[0].trim() : '';
  }

  // Helper para extrair valor de referência com fallback completo ao modelo cadastrado
  function extractExamReferenceValue(ex, catEx, currentInputValue) {
    let val = (typeof currentInputValue === 'string' && currentInputValue.trim()) ? currentInputValue.trim() : '';
    if (!val && ex) {
      val = (typeof ex.valorReferenciaLaudo === 'string' && ex.valorReferenciaLaudo.trim()) ? ex.valorReferenciaLaudo.trim() :
            (typeof ex.valorReferencia === 'string' && ex.valorReferencia.trim()) ? ex.valorReferencia.trim() :
            (typeof ex.referenceValue === 'string' && ex.referenceValue.trim()) ? ex.referenceValue.trim() :
            (typeof ex.referencia === 'string' && ex.referencia.trim()) ? ex.referencia.trim() : '';
    }
    if (!val && catEx) {
      val = (typeof catEx.valorReferenciaLaudo === 'string' && catEx.valorReferenciaLaudo.trim()) ? catEx.valorReferenciaLaudo.trim() :
            (typeof catEx.valorReferencia === 'string' && catEx.valorReferencia.trim()) ? catEx.valorReferencia.trim() :
            (typeof catEx.referenceValue === 'string' && catEx.referenceValue.trim()) ? catEx.referenceValue.trim() :
            (typeof catEx.referencia === 'string' && catEx.referencia.trim()) ? catEx.referencia.trim() :
            (typeof catEx.valRef === 'string' && catEx.valRef.trim()) ? catEx.valRef.trim() : '';
    }
    return val;
  }

  // Helper para verificar se o exame já foi editado/preenchido/digitado
  function isExamEdited(ex, codeVal) {
    if (!ex && !codeVal) return false;
    const targetCode = codeVal || ex?.code || ex?.codigo;
    const isCurrentActive = activeExamCode && String(targetCode).toUpperCase() === String(activeExamCode).toUpperCase();
    
    let res = '';
    let status = 'Pendente';

    if (isCurrentActive) {
      res = (document.getElementById('f-result')?.value || ex?.result || ex?.resultado || '').trim();
      status = document.getElementById('f-status')?.value || ex?.status || 'Pendente';
    } else {
      res = (ex?.result || ex?.resultado || '').trim();
      status = ex?.status || 'Pendente';
    }

    const stUpper = String(status || '').trim().toUpperCase();
    const validStatuses = ['DIGITADO', 'CONFERIDO', 'LIBERADO', 'EDITADO', 'PRONTO', 'CONCLUÍDO', 'CONCLUIDO'];

    if (validStatuses.includes(stUpper)) {
      return true;
    }

    if (res && res.length > 0 && res !== 'Sem resultado') {
      return true;
    }

    if (ex && (ex.edited || ex.digitado || ex.conferido || ex.liberado)) {
      return true;
    }

    return false;
  }

  function updatePreviewAllButtonState(req) {
    const btn = document.getElementById('btn-preview-all');
    if (!btn) return;
    const reqExams = req?.exams || [];
    const hasDigitado = reqExams.some(ex => isExamEdited(ex, ex.code || ex.codigo));

    if (hasDigitado) {
      btn.disabled = false;
      btn.classList.remove('opacity-50', 'cursor-not-allowed');
      btn.classList.add('hover:bg-slate-800', 'cursor-pointer');
      btn.title = 'Visualizar laudo completo com todos os exames da requisição';
    } else {
      btn.disabled = true;
      btn.classList.add('opacity-50', 'cursor-not-allowed');
      btn.classList.remove('hover:bg-slate-800', 'cursor-pointer');
      btn.title = 'Disponível apenas após pelo menos 1 exame ser digitado ou liberado';
    }
  }

  function previewAllExamsOfRequisition() {
    const allReqs = window.TRIAGEM_REQUISITIONS || [];
    const req = allReqs.find(r => 
      String(r.id || r.requisitionCode || '') === String(selectedReqId || '') || 
      String(r.id || '') === String(selectedReqId || '') || 
      String(r.requisitionCode || '') === String(selectedReqId || '')
    );

    let reqExams = req?.exams || [];
    if (reqExams.length === 0 && activeExamCode) {
      reqExams = [{ code: activeExamCode, name: document.getElementById('m-active-title')?.textContent?.trim() || activeExamCode }];
    }

    let editedExams = reqExams.filter(ex => isExamEdited(ex, ex.code || ex.codigo));
    if (editedExams.length === 0 && reqExams.length > 0) {
      editedExams = reqExams;
    }

    if (editedExams.length === 0) {
      showToast('Pelo menos 1 exame da requisição precisa estar digitado ou liberado para visualizar o laudo.', 'warning');
      return;
    }

    const patientName = document.getElementById('m-patient-name')?.textContent || req?.patientName || 'Paciente';
    const doctor = document.getElementById('m-doctor')?.textContent || req?.doctorName || 'Médico Não Informado';
    const convenio = document.getElementById('m-convenio')?.textContent || req?.convenio || 'Particular';
    const reqCode = document.getElementById('m-req-code')?.textContent || req?.requisitionCode || '#' + (selectedReqId || '00000');
    const patientAge = req?.patientAge || document.getElementById('m-patient-age')?.textContent || 'N/I';
    const dataColeta = req?.dataColeta || req?.createdAt || new Date().toLocaleDateString('pt-BR');

    const formattedExams = editedExams.map(ex => {
      const code = ex.code || ex.codigo;
      const catEx = findCatalogExam(code, ex.name || ex.titulo || ex.desc);
      const isCurrentActive = activeExamCode && String(code).toUpperCase() === String(activeExamCode).toUpperCase();
      const currentInputRef = isCurrentActive ? document.getElementById('f-ref-value')?.value : '';
      const refVal = extractExamReferenceValue(ex, catEx, currentInputRef);

      const resText = (isCurrentActive ? document.getElementById('f-result')?.value : (ex.result || ex.resultado || '')) || 'Sem resultado';
      const unitVal = (isCurrentActive ? document.getElementById('f-unit')?.value : (ex.unidade || ex.unit)) || (catEx && (catEx.unidade || catEx.unit)) || '';
      const metodo = (isCurrentActive ? document.getElementById('f-method')?.value : (ex.metodo || ex.method)) || (catEx && (catEx.metodoLaudo || catEx.metodo)) || 'Colorimétrico';
      const material = (isCurrentActive ? document.getElementById('f-material')?.value : ex.material) || (catEx && (catEx.materialLaudo || catEx.material)) || 'Soro';
      const eq = (isCurrentActive ? document.getElementById('f-equipment')?.value : (ex.equipamento || ex.equipment)) || (catEx && (catEx.equipment || catEx.equipamento)) || '';
      const obs = (isCurrentActive ? document.getElementById('f-observations')?.value : (ex.observacao || ex.observations)) || '';
      const st = isCurrentActive ? document.getElementById('f-status')?.value : (ex.status || ex.situacao || 'Digitado');

      return {
        codigo: code,
        titulo: ex.name || ex.titulo || (catEx && (catEx.tituloLaudo || catEx.name)) || document.getElementById('m-active-title')?.textContent || code,
        resultadoText: String(resText).trim() || 'Sem resultado',
        resultado: String(resText).trim() || 'Sem resultado',
        unidade: unitVal,
        unit: unitVal,
        valorReferencia: refVal,
        metodo: metodo,
        material: material,
        equipamento: eq,
        observacao: obs,
        situacao: st || 'Digitado'
      };
    });

    populateAndOpenLaudoPreview({
      paciente: {
        nome: patientName,
        idade: patientAge,
        medico: doctor,
        convenio: convenio,
        requisicaoCode: reqCode,
        dataRequisicao: dataColeta
      },
      isFullReport: true,
      exames: formattedExams
    });
  }

  function closeTypingModal() {
    document.getElementById('typing-modal').classList.add('hidden');
    selectedReqId = null;
    activeExamCode = null;
  }

  function toggleExamFormReadOnly(isReadOnly) {
    const fieldIds = ['f-material', 'f-method', 'f-equipment', 'f-ref-value', 'f-result', 'f-unit', 'f-interpretation', 'f-observations', 'f-modelo-laudo'];
    fieldIds.forEach(id => {
      const el = document.getElementById(id);
      if (el) {
        el.readOnly = isReadOnly;
        if (el.tagName === 'SELECT') {
          el.disabled = isReadOnly;
        }
        if (isReadOnly) {
          el.classList.add('bg-slate-100', 'text-slate-600', 'cursor-not-allowed', 'select-none');
          el.classList.remove('bg-white', 'bg-slate-50');
        } else {
          el.classList.remove('bg-slate-100', 'text-slate-600', 'cursor-not-allowed', 'select-none');
          if (id === 'f-result' || id === 'f-unit') {
            el.classList.add('bg-white');
          } else {
            el.classList.add('bg-slate-50');
          }
        }
      }
    });

    const quickBtns = document.querySelectorAll('.quick-template-btn');
    quickBtns.forEach(btn => {
      btn.disabled = isReadOnly;
      if (isReadOnly) {
        btn.classList.add('opacity-40', 'pointer-events-none');
      } else {
        btn.classList.remove('opacity-40', 'pointer-events-none');
      }
    });
  }

  function updateExamActionButtonsAndStatus(status) {
    const isConferido = (status === 'Conferido' || status === 'Liberado');
    const isDigitado = (status === 'Digitado');

    const statusTextEl = document.getElementById('m-active-status-text');
    if (statusTextEl) statusTextEl.textContent = status || 'Pendente';

    // 1. Alternar modo de apenas leitura / edição
    toggleExamFormReadOnly(isConferido);

    // 2. Atualizar Badge de Status no Banner do Exame
    const badgeEl = document.getElementById('m-active-status-badge');
    if (badgeEl) {
      if (isConferido) {
        badgeEl.className = 'px-2.5 py-1 text-xs font-bold rounded-lg bg-indigo-100 text-indigo-900 border border-indigo-300 flex items-center gap-1';
        badgeEl.innerHTML = '🔒 Conferido (Modo Visualização)';
      } else if (isDigitado) {
        badgeEl.className = 'px-2.5 py-1 text-xs font-bold rounded-lg bg-blue-100 text-blue-900 border border-blue-300 flex items-center gap-1';
        badgeEl.innerHTML = '📝 Digitado (Modo Edição)';
      } else {
        badgeEl.className = 'px-2.5 py-1 text-xs font-bold rounded-lg bg-slate-100 text-slate-700 border border-slate-300 flex items-center gap-1';
        badgeEl.innerHTML = '⏳ Pendente';
      }
    }

    // 3. Atualizar botões de ação
    const btnDigitado = document.getElementById('btn-action-digitado');
    const lblDigitado = document.getElementById('lbl-action-digitado');
    const btnRevertDigitado = document.getElementById('btn-revert-digitado');
    const btnConferir = document.getElementById('btn-action-conferir');
    const lblConferir = document.getElementById('lbl-action-conferir');
    const iconConferir = btnConferir ? btnConferir.querySelector('span:first-child') : null;

    if (isConferido) {
      // Exame Conferido -> Modo Visualização
      // Botão Digitado oculta, Botão "Desmarcar Digitado" fica visível para permitir reverter tudo
      // Botão "Conferir Exame" vira "Desmarcar Conferido" (para voltar para Digitado e destravar edição)
      if (btnDigitado) btnDigitado.classList.add('hidden');
      if (btnRevertDigitado) {
        btnRevertDigitado.classList.remove('hidden');
        btnRevertDigitado.onclick = () => saveActiveExam('Pendente');
        btnRevertDigitado.innerHTML = '<span>↩️</span> Desmarcar Digitado';
      }

      if (btnConferir) {
        btnConferir.className = 'px-3.5 py-2 bg-amber-600 hover:bg-amber-700 text-white text-xs font-bold rounded-xl transition-colors flex items-center gap-1.5 shadow-md cursor-pointer';
        btnConferir.onclick = () => saveActiveExam('Digitado');
        btnConferir.title = "Desmarcar conferência do exame e liberar para edição";
        if (lblConferir) lblConferir.textContent = 'Desmarcar Conferido';
        if (iconConferir) iconConferir.textContent = '🔓';
      }
    } else if (isDigitado) {
      // Exame Digitado -> Modo Edição
      if (btnDigitado) {
        btnDigitado.classList.remove('hidden');
        btnDigitado.onclick = () => saveActiveExam('Digitado');
        if (lblDigitado) lblDigitado.textContent = 'Salvar (Digitado)';
      }
      if (btnRevertDigitado) {
        btnRevertDigitado.classList.remove('hidden');
        btnRevertDigitado.onclick = () => saveActiveExam('Pendente');
