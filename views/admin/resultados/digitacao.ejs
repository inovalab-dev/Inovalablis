  function buildStandardLaudoJson(data) {
    const d = data || {};

    // Se a entrada já for um objeto padronizado com 'paciente' e 'exames'
    if (d.paciente && Array.isArray(d.exames)) {
      return {
        paciente: {
          nome: d.paciente.nome || 'Sandro Ortiz',
          idade: d.paciente.idade || '51 Anos',
          medico: d.paciente.medico || 'Luís Guilherme de Souza Costa',
          convenio: d.paciente.convenio || 'Hospital Municipal de Cambará',
          procedencia: d.paciente.procedencia || 'Coleta Hospit',
          dataRequisicao: d.paciente.dataRequisicao || '31/07/2026',
          dataEmissao: d.paciente.dataEmissao || '31/07/2026',
          requisicaoCode: d.paciente.requisicaoCode || '00033225'
        },
        exames: d.exames.map(ex => {
          return {
            codigo: ex.codigo || ex.code || 'GLI',
            titulo: (ex.titulo || ex.examTitle || ex.desc || ex.name || 'EXAME').toUpperCase(),
            situacao: (ex.situacao || ex.status || 'CONFERIDO').toUpperCase(),
            liberado: Boolean(ex.liberado),
            material: ex.material || 'Soro',
            metodo: ex.metodo || 'Colorimétrico',
            equipamento: ex.equipamento || 'Urit 8021A - Automatizado',
            observacao: ex.observacao || '...',
            valorReferencia: ex.valorReferencia || '...',
            linhas: Array.isArray(ex.linhas) && ex.linhas.length > 0 ? ex.linhas : [
              { part1: 'RESULTADO:', resultado: ex.resultado || '102', unidade: ex.unidade || 'mg/dL' }
            ]
          };
        })
      };
    }

    const activeCodeEl = document.getElementById('m-active-code');
    const defaultCode = d.examCode || d.code || (activeCodeEl && activeCodeEl.textContent.trim() !== '-' ? activeCodeEl.textContent.trim() : 'LIPASE');
    const defaultTitle = (d.examTitle || d.desc || d.code || defaultCode || 'EXAME').toUpperCase();

    // Dados do Paciente e Requerimento
    const patientName = d.patientName || document.getElementById('m-patient-name')?.textContent || 'Sandro Ortiz';
    const doctor = d.doctor || document.getElementById('m-doctor')?.textContent || 'Luís Guilherme de Souza Costa';
    const convenio = d.convenio || document.getElementById('m-convenio')?.textContent || 'Hospital Municipal de Cambará';
    const reqCode = d.reqCode || document.getElementById('m-req-code')?.textContent || '#00033225';
    const nowStr = new Date().toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' });
    const dataColeta = d.dataResultado || nowStr;

    // Se d.exames for um array (ex: importação multi-exame do XML ou requisição completa), iterar sobre eles
    const examesInput = Array.isArray(d.exames) && d.exames.length > 0 ? d.exames : [d];

    const examesFormatados = examesInput.map(ex => {
      const code = ex.codigo || ex.code || defaultCode;
      const title = (ex.titulo || ex.examTitle || ex.desc || ex.name || defaultTitle).toUpperCase();
      const rawRes = ex.resultadoText || ex.result || ex.resultado || document.getElementById('f-result')?.value || '72 U/L';
      const statusStr = (ex.status || ex.situacao || document.getElementById('f-status')?.value || 'CONFERIDO').toUpperCase();
      const isLiberado = statusStr === 'LIBERADO';

      // Transformar a string de resultado em linhas estruturadas [ { part1, resultado, unidade } ]
      let linhas = [];
      if (Array.isArray(ex.linhas) && ex.linhas.length > 0) {
        linhas = ex.linhas;
      } else {
        const rawLines = String(rawRes).split('\n').filter(l => l.trim().length > 0);
        linhas = rawLines.map(lineStr => {
          if (lineStr.includes(':')) {
            const parts = lineStr.split(':');
            const p1 = parts[0].trim() + ' :';
            const rest = parts.slice(1).join(':').trim();
            const restTokens = rest.split(/\s+/);
            const valNum = restTokens[0] || '';
            const unit = restTokens.slice(1).join(' ') || '';
            return {
              part1: p1,
              resultado: valNum,
              unidade: unit
            };
          } else {
            const tokens = lineStr.trim().split(/\s+/);
            const valNum = tokens[0] || lineStr;
            const unit = tokens.slice(1).join(' ') || '';
            return {
              part1: 'RESULTADO:',
              resultado: valNum,
              unidade: unit
            };
          }
        });
      }

      return {
        codigo: code,
        titulo: title,
        situacao: statusStr,
        liberado: isLiberado,
        material: ex.material || document.getElementById('f-material')?.value || 'Soro',
        metodo: ex.metodo || ex.method || document.getElementById('f-method')?.value || 'Colorimétrico',
        equipamento: ex.equipamento || document.getElementById('f-equipment')?.value || 'Urit 8021A - Automatizado',
        observacao: ex.observacao || ex.observations || document.getElementById('f-observations')?.value || 'Amostra coletada e identificada pelo Hospital Municipal de Cambará.',
