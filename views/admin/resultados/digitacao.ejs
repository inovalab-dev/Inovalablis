<%- include('../../partials/header') %>

<div class="p-4 sm:p-6 lg:p-8 max-w-[98vw] xl:max-w-[96vw] mx-auto w-full flex-1">
  <!-- Cabeçalho Principal -->
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-6">
    <div>
      <div class="flex items-center gap-2 text-xs text-brand-neutral/60 font-mono uppercase tracking-wider mb-1">
        <span>Resultados</span>
        <span>•</span>
        <span class="text-brand-gold font-bold">Módulo de Digitação & Laudos</span>
      </div>
      <h1 class="text-2xl font-black text-[#284701] flex items-center gap-2">
        <span>⌨️</span> Digitação de Resultados
      </h1>
      <p class="text-xs text-brand-neutral/70 mt-1">
        Lançamento de resultados, conferência técnica, impressão e liberação de laudos laboratoriais.
      </p>
    </div>

    <!-- Badges de Estatísticas Globais -->
    <div class="flex flex-wrap items-center gap-2 sm:gap-2.5">
      <div class="bg-white px-3.5 py-2 rounded-xl border border-gray-200 shadow-2xs text-center min-w-24">
        <span class="text-[10px] font-bold text-gray-400 uppercase tracking-wider block">Requisições</span>
        <span id="stat-total" class="text-base font-black text-[#284701]">0</span>
      </div>
      <div class="bg-white px-3.5 py-2 rounded-xl border border-gray-200 shadow-2xs text-center min-w-24">
        <span class="text-[10px] font-bold text-amber-600 uppercase tracking-wider block">📦 Lote Criado</span>
        <span id="stat-lote" class="text-base font-black text-amber-600">0</span>
      </div>
      <div class="bg-white px-3.5 py-2 rounded-xl border border-gray-200 shadow-2xs text-center min-w-24">
        <span class="text-[10px] font-bold text-blue-600 uppercase tracking-wider block">✏️ Em Digitação</span>
        <span id="stat-digitacao" class="text-base font-black text-blue-600">0</span>
      </div>
      <div class="bg-white px-3.5 py-2 rounded-xl border border-gray-200 shadow-2xs text-center min-w-24">
        <span class="text-[10px] font-bold text-indigo-600 uppercase tracking-wider block">🔍 Conferidos</span>
        <span id="stat-conferidos" class="text-base font-black text-indigo-600">0</span>
      </div>
      <div class="bg-white px-3.5 py-2 rounded-xl border border-gray-200 shadow-2xs text-center min-w-24">
        <span class="text-[10px] font-bold text-emerald-600 uppercase tracking-wider block">✅ Liberados</span>
        <span id="stat-liberados" class="text-base font-black text-emerald-600">0</span>
      </div>
    </div>
  </div>

  <!-- Painel de Filtros e Controles Avançados -->
  <div class="bg-white rounded-2xl border border-slate-200/90 p-4 sm:p-5 shadow-sm mb-6 space-y-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-3">
      <!-- Filtro 1: Busca Livre (Código / Paciente / CPF) -->
      <div class="xl:col-span-2">
        <label for="filter-search" class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1 font-mono">
          Código / Paciente / CPF
        </label>
        <div class="relative">
          <input
            type="text"
            id="filter-search"
            placeholder="Ex: 21264, Aaron, 00001001..."
            class="w-full pl-9 pr-3 py-2 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#284701]/20 focus:border-[#284701] transition-all"
          />
          <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </div>
      </div>

      <!-- Filtro 2: Médico -->
      <div>
        <label for="filter-doctor" class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1 font-mono">
          Médico
        </label>
        <select
          id="filter-doctor"
          class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#284701]/20 focus:border-[#284701] transition-all bg-white"
        >
          <option value="">Todos os Médicos</option>
          <% (medicos || []).forEach(m => { %>
            <option value="<%= m.name || m.nome %>"><%= m.name || m.nome %></option>
          <% }); %>
        </select>
      </div>

      <!-- Filtro 3: Convênio -->
      <div>
        <label for="filter-convenio" class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1 font-mono">
          Convênio
        </label>
        <select
          id="filter-convenio"
          class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#284701]/20 focus:border-[#284701] transition-all bg-white"
        >
          <option value="">Todos os Convênios</option>
          <% (convenios || []).forEach(c => { %>
            <option value="<%= c.name || c.nome %>"><%= c.name || c.nome %></option>
          <% }); %>
        </select>
      </div>

      <!-- Filtro 4: Ordenação -->
      <div>
        <label for="filter-sort" class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1 font-mono">
          Ordenação
        </label>
        <select
          id="filter-sort"
          class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#284701]/20 focus:border-[#284701] transition-all bg-white font-medium text-slate-700"
        >
          <option value="mais_recentes" selected>Mais Recentes</option>
          <option value="mais_antigas">Mais Antigas</option>
          <option value="em_atraso">Em Atraso Primeiro</option>
          <option value="proximo_atraso">Próximos de Atraso</option>
        </select>
      </div>

      <!-- Filtro 5: Itens Por Página -->
      <div>
        <label for="filter-limit" class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1 font-mono">
          Exibir por Página
        </label>
        <select
          id="filter-limit"
          class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#284701]/20 focus:border-[#284701] transition-all bg-white font-bold text-[#284701]"
        >
          <option value="10">10 requisições</option>
          <option value="25">25 requisições</option>
          <option value="50" selected>50 requisições (padrão)</option>
          <option value="100">100 requisições</option>
          <option value="200">200 requisições</option>
          <option value="todos">Todas</option>
        </select>
      </div>
    </div>

    <!-- Toggles / Flags e Ações secundárias -->
    <div class="flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-slate-100">
      <div class="flex flex-wrap items-center gap-4">
        <!-- Flag Urgentes -->
        <label class="inline-flex items-center gap-2 cursor-pointer select-none">
          <input type="checkbox" id="filter-urgent" class="w-4 h-4 rounded text-red-600 focus:ring-red-500 border-slate-300">
          <span class="text-xs font-bold text-slate-700 flex items-center gap-1">
            <span>🚨</span> Apenas Requisições Urgentes
          </span>
        </label>

        <!-- Flag Apenas Lote Criado -->
        <label class="inline-flex items-center gap-2 cursor-pointer select-none">
          <input type="checkbox" id="filter-lote-only" checked class="w-4 h-4 rounded text-[#284701] focus:ring-[#284701] border-slate-300">
          <span class="text-xs font-bold text-slate-700 flex items-center gap-1">
            <span>📦</span> Com Exames em Lote Criado
          </span>
        </label>
      </div>

      <div class="flex items-center gap-2">
        <button
          type="button"
          id="btn-clear-filters"
          class="px-3 py-1.5 text-xs font-bold text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-lg transition-colors flex items-center gap-1"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
          Limpar Filtros
        </button>
      </div>
    </div>
  </div>

  <!-- Tabela / Lista de Requisições -->
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm overflow-hidden mb-6">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-slate-50/80 border-b border-slate-200 text-[11px] font-mono font-bold text-slate-500 uppercase tracking-wider">
            <th class="py-3 px-4">Requisição / Data</th>
            <th class="py-3 px-4">Paciente</th>
            <th class="py-3 px-4">Médico / Convênio</th>
            <th class="py-3 px-4">Prazo / Situação</th>
            <th class="py-3 px-4">Exames & Status</th>
            <th class="py-3 px-4 text-right">Ação</th>
          </tr>
        </thead>
        <tbody id="requisitions-tbody" class="divide-y divide-slate-100 text-xs">
          <!-- Linhas renderizadas via JS para performance e paginação instantânea -->
        </tbody>
      </table>
    </div>

    <!-- Mensagem de Lista Vazia -->
    <div id="empty-state" class="hidden py-12 text-center">
      <div class="w-12 h-12 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-3 text-slate-400 text-xl">
        🔍
      </div>
      <h3 class="text-sm font-bold text-slate-700">Nenhuma requisição encontrada</h3>
      <p class="text-xs text-slate-500 mt-1">Tente ajustar os filtros acima para encontrar a requisição desejada.</p>
    </div>

    <!-- Rodapé de Paginação -->
    <div class="px-4 py-3 bg-slate-50/60 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-600">
      <div id="pagination-info" class="font-mono text-slate-500">
        Exibindo 0 de 0 requisições
      </div>

      <div class="flex items-center gap-1.5" id="pagination-controls">
        <button
          id="btn-prev-page"
          disabled
          class="px-2.5 py-1.5 rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-100 disabled:opacity-40 disabled:cursor-not-allowed font-medium transition-colors"
        >
          ← Anterior
        </button>
        <div id="pagination-pages" class="flex items-center gap-1">
          <!-- Números de páginas -->
        </div>
        <button
          id="btn-next-page"
          disabled
          class="px-2.5 py-1.5 rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-100 disabled:opacity-40 disabled:cursor-not-allowed font-medium transition-colors"
        >
          Próxima →
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ========================================================= -->
<!-- WORKSPACE DE DIGITAÇÃO DE RESULTADOS (MODAL FULLSCREEN)   -->
<!-- ========================================================= -->
<div
  id="typing-modal"
  class="fixed inset-0 z-50 bg-slate-900/80 backdrop-blur-xs hidden flex items-center justify-center p-2 sm:p-4 overflow-y-auto"
>
  <div class="bg-white w-full max-w-7xl rounded-2xl shadow-2xl border border-slate-200 flex flex-col max-h-[95vh] overflow-hidden">
    
    <!-- HEADER DO LAUDO / REQUISIÇÃO (Inspirado na imagem, mantendo nosso Style CSS) -->
    <div class="bg-slate-900 text-white p-4 sm:p-5 border-b border-slate-800 shrink-0">
      <div class="flex items-start justify-between gap-4 mb-3">
        <div class="flex items-center gap-2">
          <span class="p-2 bg-brand-gold/20 text-brand-gold rounded-xl font-bold text-lg">⌨️</span>
          <div>
            <h2 class="text-lg font-black text-white flex items-center gap-2">
              Digitação de Resultado
            </h2>
            <p class="text-xs text-slate-400">
              Lançamento, conferência e liberação individual ou em lote
            </p>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <!-- Hidden File Input for XML -->
          <input
            type="file"
            id="xml-file-input"
            accept=".xml,text/xml"
            class="hidden"
            onchange="handleXmlFileImport(event)"
          />

          <!-- Botão Importar XML Direct File / Modal -->
          <button
            type="button"
            onclick="openXmlModalOrTrigger()"
            class="px-3.5 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold rounded-xl transition-all shadow-sm flex items-center gap-1.5 border border-emerald-400/30"
            title="Importar XML do Laboratório de Apoio (AOL)"
          >
            <span>📥</span> Importar XML Resultado
          </button>

          <button
            type="button"
            onclick="closeTypingModal()"
            class="text-slate-400 hover:text-white p-1.5 hover:bg-white/10 rounded-xl transition-colors text-lg"
            title="Fechar Modal (Esc)"
          >
            ✕
          </button>
        </div>
      </div>

      <!-- Barra de Dados da Requisição / Paciente -->
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3 bg-white/5 p-3 rounded-xl border border-white/10 text-xs">
        <div>
          <span class="text-[10px] uppercase font-mono font-bold text-slate-400 block">Requisição</span>
          <span id="m-req-code" class="font-mono font-black text-brand-gold text-sm">#00000000</span>
        </div>
        <div class="col-span-2">
          <span class="text-[10px] uppercase font-mono font-bold text-slate-400 block">Paciente</span>
          <span id="m-patient-name" class="font-bold text-white text-sm block truncate">-</span>
          <span id="m-patient-details" class="text-[10.5px] text-slate-300 font-mono block">
            Nasc: - | Idade: - | Sexo: -
          </span>
        </div>
        <div>
          <span class="text-[10px] uppercase font-mono font-bold text-slate-400 block">Médico</span>
          <span id="m-doctor" class="font-medium text-slate-200 block truncate">-</span>
        </div>
        <div>
          <span class="text-[10px] uppercase font-mono font-bold text-slate-400 block">Convênio</span>
          <span id="m-convenio" class="font-medium text-slate-200 block truncate">-</span>
        </div>
        <div>
          <span class="text-[10px] uppercase font-mono font-bold text-slate-400 block">Coleta / Status</span>
          <span id="m-coleta-status" class="font-bold text-emerald-400 block">-</span>
        </div>
      </div>
    </div>

    <!-- CORPO DO WORKSPACE (SIDEBAR DE EXAMES + PAINEL DE DIGITAÇÃO) -->
    <div class="flex-1 flex flex-col md:flex-row min-h-0 overflow-hidden bg-slate-50">
      
      <!-- SIDEBAR ESQUERDA: LISTA DE EXAMES DA REQUISIÇÃO -->
      <div class="w-full md:w-72 lg:w-80 bg-white border-r border-slate-200 flex flex-col shrink-0 overflow-hidden">
        <div class="p-3 bg-slate-100/80 border-b border-slate-200 flex items-center justify-between">
          <span class="text-xs font-mono font-bold text-slate-600 uppercase tracking-wider flex items-center gap-1">
            <span>🔬</span> Exames da Requisição
          </span>
          <span id="m-exam-count-badge" class="px-2 py-0.5 bg-slate-200 text-slate-700 font-mono font-bold text-[10px] rounded-full">
            0 exames
          </span>
        </div>

        <div id="m-exams-list" class="flex-1 overflow-y-auto divide-y divide-slate-100 p-2 space-y-1">
          <!-- Renderizado via JS -->
        </div>

        <div class="p-3 bg-slate-50 border-t border-slate-200 space-y-2">
          <button
            type="button"
            onclick="bulkActionReq('conferir_todos')"
            class="w-full py-1.5 px-3 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-xs font-bold rounded-xl border border-indigo-200 transition-colors flex items-center justify-center gap-1.5"
          >
            <span>🔍</span> Conferir Todos
          </button>
          <button
            type="button"
            onclick="bulkActionReq('liberar_todos')"
            class="w-full py-1.5 px-3 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl transition-colors flex items-center justify-center gap-1.5 shadow-2xs"
          >
            <span>✅</span> Liberar Todos
          </button>
        </div>
      </div>

      <!-- PAINEL DIREITO: LAUDO INTERATIVO EM TEMPO REAL (EDITÁVEL NA TELA) -->
      <div class="flex-1 flex flex-col overflow-y-auto p-3 sm:p-5 space-y-3">
        
        <!-- Banner de Título do Exame Ativo & Ações Rápidas -->
        <div class="bg-white rounded-xl border border-slate-200/90 p-3 shadow-2xs flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <div class="flex items-center gap-2 mb-0.5">
              <span id="m-active-code" class="px-2 py-0.5 bg-slate-900 text-brand-gold font-mono font-black text-xs rounded-md">
                -
              </span>
              <span id="m-active-status-badge" class="px-2 py-0.5 bg-slate-100 text-slate-700 font-mono font-bold text-[10px] rounded-md border border-slate-200">
                Pendente
              </span>
            </div>
            <h3 id="m-active-title" class="text-base font-black text-slate-900">
              Selecione um exame
            </h3>
          </div>

          <!-- Modelos Rápidos de Preenchimento & Customizador de Modelo -->
          <div class="flex items-center gap-1.5 flex-wrap">
            <span class="text-[10.5px] font-bold text-slate-400 font-mono uppercase">Preencher:</span>
            <button
              type="button"
              onclick="fillQuickTemplate('Negativo')"
              class="px-2 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-lg transition-colors border border-slate-200"
            >
              Negativo
            </button>
            <button
              type="button"
              onclick="fillQuickTemplate('Positivo')"
              class="px-2 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-lg transition-colors border border-slate-200"
            >
              Positivo
            </button>
            <button
              type="button"
              onclick="fillQuickTemplate('Normal')"
              class="px-2 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-lg transition-colors border border-slate-200"
            >
              Normal
            </button>

            <span class="text-slate-300">|</span>

            <button
              type="button"
              onclick="toggleModelEditorToolbar()"
              class="px-2.5 py-1 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-xs font-bold rounded-lg transition-colors border border-indigo-200 flex items-center gap-1"
              title="Personalizar tamanhos de fonte, estilos, ordem e campos do modelo"
            >
              <span>🎨</span> Customizar Modelo
            </button>

            <button
              type="button"
              onclick="openLisLayoutModal()"
              class="px-2.5 py-1 bg-amber-500 hover:bg-amber-600 text-slate-950 font-black text-xs rounded-lg transition-all shadow-sm flex items-center gap-1 font-mono border border-amber-400"
              title="Abrir Editor WYSIWYG Estilo LIS (Arrastar componentes, réguas e grade de propriedades)"
            >
              <span>⚙️</span> Configuração de Layout
            </button>

            <button
              type="button"
              onclick="printLaudoDocument()"
              class="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-white text-xs font-bold rounded-lg transition-colors flex items-center gap-1 shadow-2xs"
            >
              <span>🖨️</span> Imprimir
            </button>
          </div>
        </div>

        <!-- BARRA DE FERRAMENTAS DO CUSTOMIZADOR DE MODELO (EXPANDÍVEL) -->
        <div id="model-editor-toolbar" class="bg-indigo-950 text-white rounded-xl p-3 border border-indigo-900 shadow-md space-y-3 hidden no-print">
          <div class="flex flex-wrap items-center justify-between gap-2 border-b border-indigo-800/80 pb-2">
            <div class="flex items-center gap-2">
              <span class="text-sm">🎨</span>
              <h4 class="text-xs font-black uppercase tracking-wide text-indigo-200 font-mono">
                Editor de Modelo de Laudo (<span id="editor-exam-code" class="text-brand-gold">LIPASE</span>)
              </h4>
            </div>
            <div class="flex items-center gap-2">
              <button
                type="button"
                onclick="saveExamModelTemplate()"
                class="px-3 py-1 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold rounded-lg transition-all shadow-sm flex items-center gap-1 font-mono"
              >
                <span>💾</span> Salvar Como Modelo do Exame
              </button>
              <button
                type="button"
                onclick="resetExamModelTemplate()"
                class="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold rounded-lg transition-all font-mono"
                title="Restaurar tamanho e layout originais"
              >
                🔄 Restaurar Padrão
              </button>
            </div>
          </div>

          <!-- CONTROLES DE FONTE E ESTILOS -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 text-xs">
            <!-- Fonte Geral da Folha -->
            <div class="space-y-1">
              <label class="text-[10.5px] font-bold text-indigo-300 uppercase font-mono block">Fonte Geral (Folha):</label>
              <select id="cfg-font-size-body" onchange="applyModelFormatting()" class="w-full px-2 py-1 bg-indigo-900 border border-indigo-700 rounded text-xs text-white font-mono focus:outline-none">
                <option value="10px">10px (Muito Pequena)</option>
                <option value="11px">11px (Compacta)</option>
                <option value="12px" selected>12px (Padrão)</option>
                <option value="13px">13px (Média)</option>
                <option value="14px">14px (Grande)</option>
                <option value="16px">16px (Extra Grande)</option>
              </select>
            </div>

            <!-- Fonte do Resultado -->
            <div class="space-y-1">
              <label class="text-[10.5px] font-bold text-indigo-300 uppercase font-mono block">Fonte do Resultado:</label>
              <select id="cfg-font-size-result" onchange="applyModelFormatting()" class="w-full px-2 py-1 bg-indigo-900 border border-indigo-700 rounded text-xs text-white font-mono focus:outline-none">
                <option value="12px">12px (Compacto)</option>
                <option value="14px">14px (Médio)</option>
                <option value="16px" selected>16px (Padrão)</option>
                <option value="18px">18px (Destaque)</option>
                <option value="20px">20px (Grande)</option>
                <option value="24px">24px (Muito Grande)</option>
              </select>
            </div>

            <!-- Fonte de Val. Referência -->
            <div class="space-y-1">
              <label class="text-[10.5px] font-bold text-indigo-300 uppercase font-mono block">Fonte Val. Referência:</label>
