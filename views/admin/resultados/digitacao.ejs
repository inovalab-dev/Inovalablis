        <div class="text-slate-700 font-mono text-[11px]" id="xml-preview-details"></div>
      </div>
    </div>

    <!-- Modal Footer -->
    <div class="p-4 bg-slate-50 border-t border-slate-200 flex items-center justify-between">
      <button
        type="button"
