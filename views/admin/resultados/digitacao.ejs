  function populateAndOpenLaudoPreview(data) {
    const d = data || {};
    const paperContainer = document.getElementById('laudo-paper-container');
    if (paperContainer) {
      renderLaudoWithCreatedModel(paperContainer, d);
    }
    document.getElementById('laudo-preview-modal').classList.remove('hidden');
  }

  function openLaudoPreviewModal() {
    const activeCodeEl = document.getElementById('m-active-code');
    const activeTitleEl = document.getElementById('m-active-title');
    const examCode = (activeCodeEl && activeCodeEl.textContent.trim() !== '-') ? activeCodeEl.textContent.trim() : 'LIPASE';
    const examTitle = (activeTitleEl && activeTitleEl.textContent.trim() !== 'Selecione um exame') ? activeTitleEl.textContent.trim() : 'LIPASE';
    const result = document.getElementById('f-result') ? document.getElementById('f-result').value : '72 U/L';
    const valRef = document.getElementById('f-ref-value') ? document.getElementById('f-ref-value').value : '';
    const metodo = document.getElementById('f-method') ? document.getElementById('f-method').value : 'Colorimétrico';
    const material = document.getElementById('f-material') ? document.getElementById('f-material').value : 'Soro';
    const obs = document.getElementById('f-observations') ? document.getElementById('f-observations').value : 'Amostra coletada e identificada pelo Hospital Municipal de Cambará.';
    const eq = document.getElementById('f-equipment') ? document.getElementById('f-equipment').value : 'Urit 8021A - Automatizado';
    const interp = document.getElementById('f-interpretation') ? document.getElementById('f-interpretation').value : '';

    populateAndOpenLaudoPreview({
      examCode: examCode,
      examTitle: examTitle,
      resultadoText: result || '72 U/L',
      valorReferencia: valRef,
      metodo: metodo || 'Colorimétrico',
      material: material || 'Soro',
      equipamento: eq || 'Urit 8021A - Automatizado',
      observacao: obs || 'Amostra coletada e identificada pelo Hospital Municipal de Cambará.',
      interpretation: interp
    });
  }

  function closeLaudoPreviewModal() {
    document.getElementById('laudo-preview-modal').classList.add('hidden');
  }

  function printLaudoDocument() {
    window.print();
  }

  // ==========================================
  // MOTOR DE EDICAO E CUSTOMIZACAO DE MODELO DE LAUDO
  // ==========================================
  let isBoldLabels = true;
  let isUppercaseLabels = false;
  let currentCustomFields = [];

  function toggleModelEditorToolbar() {
    const toolbar = document.getElementById('model-editor-toolbar');
    if (!toolbar) return;
    toolbar.classList.toggle('hidden');
    
    const activeCodeEl = document.getElementById('m-active-code');
    const examCode = activeCodeEl ? activeCodeEl.textContent.trim() : 'DEFAULT';
    const editorExamCode = document.getElementById('editor-exam-code');
    if (editorExamCode) editorExamCode.textContent = (examCode && examCode !== '-') ? examCode : 'DEFAULT';

    loadExamModelTemplate(examCode);
  }

  function applyModelFormatting() {
    const bodySize = document.getElementById('cfg-font-size-body')?.value || '12px';
    const resultSize = document.getElementById('cfg-font-size-result')?.value || '16px';
    const refSize = document.getElementById('cfg-font-size-ref')?.value || '11px';

    const paperContainer = document.getElementById('laudo-paper-container');
    if (paperContainer) {
      paperContainer.style.fontSize = bodySize;
    }

    const resultInput = document.getElementById('f-result');
    if (resultInput) {
      resultInput.style.fontSize = resultSize;
    }

    const refInput = document.getElementById('f-ref-value');
    if (refInput) {
      refInput.style.fontSize = refSize;
    }

    // Aplica negrito e caixa alta aos rótulos .laudo-label
    const labels = document.querySelectorAll('.laudo-label');
    labels.forEach(lbl => {
      lbl.style.fontWeight = isBoldLabels ? 'bold' : 'normal';
      lbl.style.textTransform = isUppercaseLabels ? 'uppercase' : 'none';
    });

    const btnBold = document.getElementById('btn-toggle-bold');
    if (btnBold) {
      btnBold.className = isBoldLabels 
        ? "px-2.5 py-1 bg-brand-gold text-slate-950 font-black text-xs rounded border border-yellow-400 transition-colors"
        : "px-2.5 py-1 bg-indigo-900 text-indigo-300 font-normal text-xs rounded border border-indigo-700 transition-colors";
    }

    const btnUpper = document.getElementById('btn-toggle-uppercase');
    if (btnUpper) {
      btnUpper.className = isUppercaseLabels
        ? "px-2.5 py-1 bg-brand-gold text-slate-950 font-black text-xs rounded border border-yellow-400 transition-colors"
        : "px-2.5 py-1 bg-indigo-900 text-indigo-300 font-normal text-xs rounded border border-indigo-700 transition-colors";
    }
  }

  function toggleBoldFormatting() {
    isBoldLabels = !isBoldLabels;
    applyModelFormatting();
  }

  function toggleUppercaseFormatting() {
    isUppercaseLabels = !isUppercaseLabels;
    applyModelFormatting();
  }

  // REORDENAÇÃO DE BLOCOS DA FOLHA
  function moveSectionUp(sectionId) {
    const el = document.getElementById(sectionId);
    if (!el || !el.previousElementSibling) return;
    el.parentNode.insertBefore(el, el.previousElementSibling);
    showToast('Posição da seção alterada.', 'info');
  }

  function moveSectionDown(sectionId) {
    const el = document.getElementById(sectionId);
    if (!el || !el.nextElementSibling) return;
    el.parentNode.insertBefore(el.nextElementSibling, el);
    showToast('Posição da seção alterada.', 'info');
  }

  // ADICIONAR E REMOVER CAMPOS CUSTOMIZADOS
  function addNewCustomFieldPrompt() {
    const label = prompt('Digite o nome do novo campo para o laudo (Ex: Jejum Declarado, Responsável Técnico, Nota de Coleta):');
    if (!label || !label.trim()) return;

    const id = 'custom_f_' + Date.now();
    currentCustomFields.push({
      id: id,
      label: label.trim(),
      value: ''
    });

    renderCustomFields();
    applyModelFormatting();
    showToast(`Campo "${label}" adicionado ao laudo!`, 'success');
  }

  function removeCustomField(id) {
    currentCustomFields = currentCustomFields.filter(f => f.id !== id);
    renderCustomFields();
    showToast('Campo removido do laudo.', 'info');
  }

  function renderCustomFields() {
    const container = document.getElementById('laudo-block-custom-fields');
    if (!container) return;

    if (currentCustomFields.length === 0) {
      container.classList.add('hidden');
      container.innerHTML = '';
      return;
    }

    container.classList.remove('hidden');
    container.innerHTML = currentCustomFields.map(field => `
      <div class="relative bg-indigo-50/50 p-2 rounded border border-indigo-100 group">
        <div class="flex items-center justify-between mb-0.5">
          <label for="${field.id}" class="font-bold text-slate-900 text-[11px] laudo-label">${field.label}:</label>
          <button
            type="button"
            onclick="removeCustomField('${field.id}')"
            class="text-[10px] text-red-500 hover:text-red-700 font-bold px-1 rounded no-print"
            title="Remover este campo do modelo"
          >
            ❌ Remover
          </button>
        </div>
        <textarea
          id="${field.id}"
          rows="1"
          placeholder="Digite ${field.label.toLowerCase()}..."
          class="w-full p-1.5 text-[11px] font-mono text-slate-800 bg-white border border-slate-300 focus:border-[#284701] rounded"
        >${field.value || ''}</textarea>
      </div>
    `).join('');
  }

  // PERSISTÊNCIA DO MODELO POR EXAME
  function getActiveExamCode() {
    const activeCodeEl = document.getElementById('m-active-code');
    const code = activeCodeEl ? activeCodeEl.textContent.trim() : 'DEFAULT';
    return (code && code !== '-') ? code : 'DEFAULT';
  }

  function saveExamModelTemplate() {
    const examCode = getActiveExamCode();
    
    currentCustomFields.forEach(f => {
      const inputEl = document.getElementById(f.id);
      if (inputEl) f.value = inputEl.value;
    });

    const wrapper = document.getElementById('laudo-blocks-wrapper');
    const blockOrder = wrapper ? Array.from(wrapper.children).map(child => child.id) : [];

    const templateConfig = {
      examCode: examCode,
      bodyFontSize: document.getElementById('cfg-font-size-body')?.value || '12px',
      resultFontSize: document.getElementById('cfg-font-size-result')?.value || '16px',
      refFontSize: document.getElementById('cfg-font-size-ref')?.value || '11px',
      isBoldLabels: isBoldLabels,
      isUppercaseLabels: isUppercaseLabels,
      customFields: currentCustomFields,
      blockOrder: blockOrder
    };

    localStorage.setItem(`laudo_template_${examCode}`, JSON.stringify(templateConfig));
    showToast(`Modelo e layout salvos com sucesso para o exame "${examCode}"!`, 'success');
  }

  function loadExamModelTemplate(examCode) {
    const targetCode = examCode || getActiveExamCode();
    const saved = localStorage.getItem(`laudo_template_${targetCode}`);
    if (!saved) return;

    try {
      const config = JSON.parse(saved);
      if (config.bodyFontSize && document.getElementById('cfg-font-size-body')) document.getElementById('cfg-font-size-body').value = config.bodyFontSize;
      if (config.resultFontSize && document.getElementById('cfg-font-size-result')) document.getElementById('cfg-font-size-result').value = config.resultFontSize;
      if (config.refFontSize && document.getElementById('cfg-font-size-ref')) document.getElementById('cfg-font-size-ref').value = config.refFontSize;
      
      if (typeof config.isBoldLabels === 'boolean') isBoldLabels = config.isBoldLabels;
      if (typeof config.isUppercaseLabels === 'boolean') isUppercaseLabels = config.isUppercaseLabels;

      if (Array.isArray(config.customFields)) {
        currentCustomFields = config.customFields;
        renderCustomFields();
      }

      if (Array.isArray(config.blockOrder) && config.blockOrder.length > 0) {
        const wrapper = document.getElementById('laudo-blocks-wrapper');
        if (wrapper) {
          config.blockOrder.forEach(blockId => {
            const blockEl = document.getElementById(blockId);
            if (blockEl) wrapper.appendChild(blockEl);
          });
        }
      }

      applyModelFormatting();
    } catch (err) {
      console.error('Erro ao carregar modelo salvo:', err);
    }
  }

  function resetExamModelTemplate() {
    const examCode = getActiveExamCode();
    localStorage.removeItem(`laudo_template_${examCode}`);
    
    if (document.getElementById('cfg-font-size-body')) document.getElementById('cfg-font-size-body').value = '12px';
    if (document.getElementById('cfg-font-size-result')) document.getElementById('cfg-font-size-result').value = '16px';
    if (document.getElementById('cfg-font-size-ref')) document.getElementById('cfg-font-size-ref').value = '11px';
    isBoldLabels = true;
    isUppercaseLabels = false;
    currentCustomFields = [];
    renderCustomFields();

    const wrapper = document.getElementById('laudo-blocks-wrapper');
    if (wrapper) {
      ['laudo-block-tech', 'laudo-block-result', 'laudo-block-notes', 'laudo-block-custom-fields', 'laudo-block-footer'].forEach(bId => {
        const el = document.getElementById(bId);
        if (el) wrapper.appendChild(el);
      });
    }

    applyModelFormatting();
    showToast(`Modelo do exame "${examCode}" restaurado para o padrão original.`, 'info');
  }
</script>

