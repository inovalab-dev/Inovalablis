        linhas: linhas
      };
    });

    return {
      paciente: {
        nome: patientName,
        idade: d.idade || '51 Anos',
        medico: doctor,
        convenio: convenio,
        procedencia: d.procedencia || 'Coleta Hospit',
        dataRequisicao: dataColeta.split(' ')[0] || '31/07/2026',
        dataEmissao: dataColeta.split(' ')[0] || '31/07/2026',
        requisicaoCode: reqCode.replace('#', '')
      },
      exames: examesFormatados
    };
  }

