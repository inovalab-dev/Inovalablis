  function processJsonLaudoImport() {
    const jsonStr = document.getElementById('modal-json-text').value.trim();
    if (!jsonStr) {
      showToast('Por favor, cole o JSON do laudo.', 'error');
      return;
    }

    try {
      const parsed = JSON.parse(jsonStr);
      closeJsonImportModal();
      
      const paperContainer = document.getElementById('laudo-paper-container');
      if (paperContainer) {
        renderLaudoWithCreatedModel(paperContainer, parsed);
      }
      document.getElementById('laudo-preview-modal').classList.remove('hidden');
      showToast('Laudo preenchido com sucesso a partir do JSON!', 'success');
    } catch (err) {
      console.error(err);
      showToast('Sintaxe JSON inválida. Verifique vírgulas ou aspas.', 'error');
