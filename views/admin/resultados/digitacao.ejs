    const req = allReqs.find(r => (r.id || r.requisitionCode) === selectedReqId || r.id === selectedReqId);
    if (!req) return;

    const ex = (req.exams || []).find(e => (e.code || e.codigo) === examCode);
    if (!ex) return;

    // Atualizar classe ativa na sidebar esquerda com destaque visual claro
    document.querySelectorAll('.exam-item-btn').forEach(btn => {
      if (btn.dataset.code === examCode) {
        btn.className = 'w-full text-left p-3 rounded-xl transition-all border-2 bg-emerald-50/90 border-[#284701] text-slate-900 font-bold shadow-xs border-l-4 border-l-[#284701] exam-item-btn';
