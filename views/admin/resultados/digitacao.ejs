  async function saveActiveExam(targetStatus) {
    if (!selectedReqId || !activeExamCode) {
      return showToast('Selecione uma requisição e um exame.', 'error');
    }

    const unitInputVal = document.getElementById('f-unit')?.value || '';

    const payload = {
      requisitionId: selectedReqId,
      examCode: activeExamCode,
      result: document.getElementById('f-result')?.value || '',
      unit: unitInputVal,
      unidade: unitInputVal,
      referenceValue: document.getElementById('f-ref-value')?.value || '',
      method: document.getElementById('f-method')?.value || '',
      material: document.getElementById('f-material')?.value || '',
      equipment: document.getElementById('f-equipment')?.value || '',
      equipamento: document.getElementById('f-equipment')?.value || '',
      interpretation: document.getElementById('f-interpretation')?.value || '',
      observations: document.getElementById('f-observations')?.value || '',
      modeloLaudo: document.getElementById('f-modelo-laudo')?.value || 'Padrão LIS InovaLab',
      status: targetStatus || document.getElementById('f-status')?.value || 'Digitado'
    };

    try {
      const resp = await fetch('/admin/resultados/salvar-exame', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const data = await resp.json();
      if (data.success) {
        showToast(data.message || 'Exame salvo com sucesso!', 'success');

        // Atualizar estado local em memória
        const req = (window.TRIAGEM_REQUISITIONS || []).find(r => (r.id || r.requisitionCode) === selectedReqId || r.id === selectedReqId);
        if (req && Array.isArray(req.exams)) {
          const ex = req.exams.find(e => (e.code || e.codigo) === activeExamCode);
          if (ex) {
            ex.result = payload.result;
            ex.resultado = payload.result;
            ex.unit = payload.unit;
            ex.unidade = payload.unidade;
            ex.referenceValue = payload.referenceValue;
            ex.method = payload.method;
            ex.material = payload.material;
            ex.equipment = payload.equipment;
            ex.equipamento = payload.equipamento;
            ex.interpretation = payload.interpretation;
            ex.observations = payload.observations;
            ex.modeloLaudo = payload.modeloLaudo;
            ex.status = payload.status;
            ex.linhas = [{
              PARAMETRO: 'RESULTADO',
              resultado: payload.result,
              unidade: payload.unidade
            }];
          }
          if (data.requisitionStatus) req.status = data.requisitionStatus;
        }

        // Reabrir modal para atualizar visuais
        openTypingModal(selectedReqId, activeExamCode);
        applyFiltersAndRender();

        // Atualizar estado do botão Visualizar Todos
        updatePreviewAllButtonState(req);
      } else {
        showToast(data.message || 'Erro ao salvar exame.', 'error');
      }
    } catch (err) {
      console.error(err);
      showToast('Erro de comunicação com o servidor.', 'error');
    }
  }

  async function bulkActionReq(action) {
    if (!selectedReqId) return;

    const actionText = action === 'conferir_todos' ? 'conferir todos os exames' : 'liberar todos os laudos';
    if (!confirm(`Deseja realmente ${actionText} desta requisição?`)) return;

    try {
      const resp = await fetch('/admin/resultados/salvar-requisicao-completa', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ requisitionId: selectedReqId, action })
      });

      const data = await resp.json();
      if (data.success) {
        showToast(data.message || 'Requisição atualizada!', 'success');

        const req = (window.TRIAGEM_REQUISITIONS || []).find(r => (r.id || r.requisitionCode) === selectedReqId || r.id === selectedReqId);
        if (req && Array.isArray(req.exams)) {
          req.exams.forEach(ex => {
            ex.status = action === 'conferir_todos' ? 'Conferido' : 'Liberado';
          });
          req.status = action === 'conferir_todos' ? 'Conferido' : 'Liberado';
        }

        openTypingModal(selectedReqId);
        applyFiltersAndRender();
      } else {
        showToast(data.message || 'Erro ao atualizar requisição.', 'error');
      }
    } catch (err) {
      console.error(err);
      showToast('Erro de comunicação ao atualizar requisição.', 'error');
    }
  }

  function showToast(message, type = 'success') {
    const container = document.getElementById('toast-container');
    const toast = document.createElement('div');
    const bgClass = type === 'error' ? 'bg-red-600 text-white' : 'bg-emerald-700 text-white';

    toast.className = `px-4 py-3 rounded-xl shadow-lg text-xs font-bold flex items-center gap-2 transition-all duration-300 transform translate-y-2 opacity-0 pointer-events-auto ${bgClass}`;
    toast.innerHTML = `
      <span>${type === 'error' ? '⚠️' : '✅'}</span>
      <span>${message}</span>
    `;

    container.appendChild(toast);

    requestAnimationFrame(() => {
      toast.classList.remove('translate-y-2', 'opacity-0');
    });

    setTimeout(() => {
      toast.classList.add('translate-y-2', 'opacity-0');
      setTimeout(() => toast.remove(), 300);
    }, 2500);
  }

  // ==========================================
  // IMPORTAÇÃO E PROCESSAMENTO DE XML (AOL)
  // ==========================================
  function openXmlModalOrTrigger() {
    document.getElementById('modal-xml-text').value = '';
    document.getElementById('modal-xml-file').value = '';
    document.getElementById('xml-parse-preview').classList.add('hidden');
    document.getElementById('import-xml-modal').classList.remove('hidden');
  }

  function closeXmlModal() {
    document.getElementById('import-xml-modal').classList.add('hidden');
  }

  function handleXmlFileImport(event) {
    const file = event.target.files && event.target.files[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = function(e) {
      const xmlString = e.target.result;
      processXmlContent(xmlString);
    };
    reader.readAsText(file);
  }

  function processXmlImport() {
    const fileInput = document.getElementById('modal-xml-file');
    const textArea = document.getElementById('modal-xml-text');

    if (fileInput.files && fileInput.files[0]) {
      const reader = new FileReader();
      reader.onload = function(e) {
        processXmlContent(e.target.result);
      };
      reader.readAsText(fileInput.files[0]);
    } else if (textArea.value.trim()) {
      processXmlContent(textArea.value.trim());
    } else {
      showToast('Selecione um arquivo XML ou cole o conteúdo no campo de texto.', 'error');
    }
  }

  function cleanXmlString(str) {
    if (!str) return '';
    let cleaned = String(str).trim();
    // Remove BOM
    cleaned = cleaned.replace(/^\uFEFF/, '');
    // Fix unescaped & characters in XML text or attributes
    cleaned = cleaned.replace(/&(?!amp;|lt;|gt;|quot;|apos;|#\d+;|#x[0-9a-fA-F]+;)/g, '&amp;');
    return cleaned;
  }

  function parseXmlString(rawXmlString) {
    const xmlString = cleanXmlString(rawXmlString);
    if (!xmlString) {
      throw new Error("O conteúdo XML está vazio.");
    }

    const parser = new DOMParser();
    let xmlDoc = null;

    try {
      xmlDoc = parser.parseFromString(xmlString, "text/xml");
      const parserError = xmlDoc.getElementsByTagName("parsererror");
      if (parserError.length > 0) {
        xmlDoc = null;
      }
    } catch (e) {
      xmlDoc = null;
    }

    // Fallback para parser HTML em caso de imperfeições no XML
    if (!xmlDoc) {
      try {
        xmlDoc = parser.parseFromString(xmlString, "text/html");
      } catch (e) {
        throw new Error("Erro na estrutura do XML fornecido.");
      }
    }

    if (!xmlDoc) {
      throw new Error("Erro na estrutura do XML fornecido.");
    }

    // Helpers para buscar nós independentemente do tipo de parser
    function findNode(parent, selector) {
      if (!parent) return null;
      return parent.querySelector(selector) || parent.querySelector(selector.toLowerCase());
    }

    function findNodes(parent, selector) {
      if (!parent) return [];
      const res = parent.querySelectorAll(selector);
      if (res.length > 0) return Array.from(res);
      return Array.from(parent.querySelectorAll(selector.toLowerCase()));
    }

    // 1. Cadastros -> Materiais
    const materiaisMap = {};
    const materiaisNodes = findNodes(xmlDoc, "cadastros > materiais > material, cadastros materiais material, material");
    materiaisNodes.forEach(m => {
      const code = m.getAttribute("codigo");
      const desc = m.getAttribute("descricao");
      if (code) materiaisMap[code] = desc;
    });

    // 2. Cadastros -> Exames (Valores de referência etc)
    const examesCadastrados = {};
    const cadastrosNode = findNode(xmlDoc, "cadastros");
    if (cadastrosNode) {
      const exameCadNodes = findNodes(cadastrosNode, "exame");
      exameCadNodes.forEach(e => {
        const code = e.getAttribute("codigo");
        const desc = e.getAttribute("descricao");
        const valRefNode = findNode(e, "valorreferencia");
        const valRef = valRefNode ? valRefNode.textContent.trim() : "";
        if (code) {
          examesCadastrados[code] = { code, desc, valRef };
        }
      });
    }

    // 3. Solicitacao
    const solicitacaoNode = findNode(xmlDoc, "solicitacao");
    if (!solicitacaoNode) {
      throw new Error("Tag <solicitacao> não encontrada no XML fornecido.");
    }

    const codigolis = solicitacaoNode.getAttribute("codigo_lis") || solicitacaoNode.getAttribute("codigolis") || "";
    const codigoAol = solicitacaoNode.getAttribute("codigo_aol") || solicitacaoNode.getAttribute("codigo") || "";
    const pacienteCode = solicitacaoNode.getAttribute("paciente") || "";

    // Amostras (materiais por amostra)
    const amostrasMap = {};
    const amostraNodes = findNodes(solicitacaoNode, "amostras > amostra, amostras amostra, amostra");
    amostraNodes.forEach(a => {
      const codigoAmostra = a.getAttribute("codigo");
      const desc = a.getAttribute("descricao");
      const matCode = a.getAttribute("material");
      const matDesc = materiaisMap[matCode] || desc || "";
      amostrasMap[codigoAmostra] = { codigoAmostra, desc, matCode, matDesc };
    });

    // Exames e Resultados
    const examesResultados = [];
    const exameNodes = findNodes(solicitacaoNode, "exame");
    exameNodes.forEach(exNode => {
      const code = exNode.getAttribute("codigo");
      const metodo = exNode.getAttribute("metodo") || "";
      const obs = exNode.getAttribute("observacao") || "";
      const isNormal = exNode.getAttribute("normal") === "S";
      const dataResultado = exNode.getAttribute("dataresultado") || "";

      // Resultados individuais
      const resultadoNodes = findNodes(exNode, "resultado");
      const resultadosList = [];
      resultadoNodes.forEach(rNode => {
        const resText = rNode.getAttribute("resultado") || rNode.textContent.trim();
        const amostraId = rNode.getAttribute("amostra");
        const idLis = rNode.getAttribute("id_lis");
        resultadosList.push({ resText, amostraId, idLis });
      });

      // Cad cadastrado
      const cadEx = examesCadastrados[code] || {};
      
      // Material resolvido
      let materialFinal = "";
      if (resultadosList.length > 0 && amostrasMap[resultadosList[0].amostraId]) {
        materialFinal = amostrasMap[resultadosList[0].amostraId].matDesc;
      }

      // Prepara resultado formatado em texto
      const resTextCombined = resultadosList.map(r => r.resText).filter(Boolean).join("\n") || (isNormal ? "Resultado: NORMAL" : "");

      examesResultados.push({
        code,
        desc: cadEx.desc || code,
        metodo,
        observacao: obs,
        valorReferencia: cadEx.valRef || "",
        material: materialFinal,
        resultadoText: resTextCombined,
        dataResultado,
        isNormal
      });
    });

    // Local CNES
    const localCnesNode = findNode(solicitacaoNode, "local-cnes");
    const localCnes = localCnesNode ? localCnesNode.textContent.trim() : "";

    return {
      codigolis,
      codigoAol,
      pacienteCode,
      examesResultados,
      localCnes
    };
  }

  async function processXmlContent(xmlString) {
    try {
      const parsedData = parseXmlString(xmlString);

      if (!parsedData.examesResultados || parsedData.examesResultados.length === 0) {
        return showToast('Nenhum exame ou resultado encontrado no XML.', 'error');
      }

      // Tenta encontrar a requisição ativa ou correspondente ao codigolis
      let targetReq = null;
      if (selectedReqId) {
        targetReq = (window.TRIAGEM_REQUISITIONS || []).find(r => String(r.id || r.requisitionCode) === String(selectedReqId));
      }

      if (!targetReq && parsedData.codigolis) {
        targetReq = (window.TRIAGEM_REQUISITIONS || []).find(r => 
          String(r.requisitionCode || r.id).includes(parsedData.codigolis) || 
          parsedData.codigolis.includes(String(r.requisitionCode || r.id))
        );
      }

      const reqIdToUse = targetReq ? (targetReq.id || targetReq.requisitionCode) : selectedReqId;

      // Monta lista de exames atualizados a enviar para o backend
      const updatedExamsList = [];

      parsedData.examesResultados.forEach(xmlEx => {
        let matchedEx = null;
        if (targetReq && Array.isArray(targetReq.exams)) {
          matchedEx = targetReq.exams.find(e => (e.code || e.codigo) === xmlEx.code);
        }

        const examCode = matchedEx ? (matchedEx.code || matchedEx.codigo) : (xmlEx.code || activeExamCode);

        if (matchedEx) {
          matchedEx.result = xmlEx.resultadoText;
          if (xmlEx.valorReferencia) matchedEx.referenceValue = xmlEx.valorReferencia;
          if (xmlEx.metodo) matchedEx.method = xmlEx.metodo;
          if (xmlEx.material) matchedEx.material = xmlEx.material;
          if (xmlEx.observacao) matchedEx.observations = xmlEx.observacao;
          matchedEx.interpretation = xmlEx.localCnes ? `Local: ${xmlEx.localCnes}` : (matchedEx.interpretation || '');
          matchedEx.status = 'Conferido';
        }

        if (examCode) {
          updatedExamsList.push({
            code: examCode,
            result: xmlEx.resultadoText,
            referenceValue: xmlEx.valorReferencia || '',
            method: xmlEx.metodo || '',
            material: xmlEx.material || '',
            observations: xmlEx.observacao || '',
            interpretation: xmlEx.localCnes ? `Local: ${xmlEx.localCnes}` : '',
            status: 'Conferido'
          });
        }
      });

      // Atualiza formulário na tela se houver exame ativo
      const firstEx = parsedData.examesResultados[0];
      if (firstEx) {
        const setVal = (id, val) => { const el = document.getElementById(id); if (el) el.value = val; };
        setVal('f-result', firstEx.resultadoText || '');
        if (firstEx.valorReferencia) setVal('f-ref-value', firstEx.valorReferencia);
        if (firstEx.metodo) setVal('f-method', firstEx.metodo);
        if (firstEx.material) setVal('f-material', firstEx.material);
        if (firstEx.observacao) setVal('f-observations', firstEx.observacao);
        if (firstEx.localCnes) setVal('f-interpretation', `Local: ${firstEx.localCnes}`);
        setVal('f-status', 'Conferido');
      }

      // Envia os exames para persistência no backend
      if (reqIdToUse && updatedExamsList.length > 0) {
        await fetch('/admin/resultados/salvar-requisicao-completa', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            requisitionId: reqIdToUse,
            exams: updatedExamsList
          })
        });
      }

      closeXmlModal();
      showToast(`XML importado e salvo com sucesso! (${parsedData.examesResultados.length} exame(s))`, 'success');

      // Atualizar interface
      if (selectedReqId) {
        openTypingModal(selectedReqId);
      }
      applyFiltersAndRender();

      // Abre a visualização formatada do Laudo gerado
      if (firstEx) {
        populateAndOpenLaudoPreview({
          examTitle: firstEx.desc || firstEx.code || 'LIPASE',
          resultadoText: firstEx.resultadoText || '72 U/L',
          valorReferencia: firstEx.valorReferencia,
          metodo: firstEx.metodo || 'Colorimétrico',
          material: firstEx.material || 'Soro',
          observacao: firstEx.observacao || 'Amostra coletada e identificada pelo Hospital Municipal de Cambará.',
          dataResultado: firstEx.dataResultado
        });
      }

    } catch (err) {
      console.error(err);
      showToast(err.message || 'Erro ao processar o XML de resultado.', 'error');
    }
  }

