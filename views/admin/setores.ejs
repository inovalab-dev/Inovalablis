<%- include('../partials/header', { page: 'admin-setores' }) %>

<div class="p-4 sm:p-6 lg:p-8 max-w-[98vw] xl:max-w-[96vw] mx-auto w-full flex-1 space-y-6">

  <!-- Cabeçalho Principal da Tela (Padrão InovaLab / LIS) -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 text-xs text-brand-neutral/60 font-mono uppercase tracking-wider mb-1">
        <a href="/admin" class="hover:text-brand-neutralDark transition-colors">Administração</a>
        <span>•</span>
        <span>Cadastros</span>
        <span>•</span>
        <span class="text-emerald-700 font-bold">Setores</span>
      </div>
      
      <div class="flex items-center gap-3">
        <!-- Ícone do Cadastro de Setores -->
        <div class="w-11 h-11 rounded-2xl bg-white border border-gray-200 shadow-sm flex items-center justify-center shrink-0 relative">
          <svg class="w-6 h-6 text-emerald-700" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5m0 0v-5a2 2 0 012-2h2a2 2 0 012 2v5m-6 0h6M9 7h1m-1 4h1m4-4h1m-1 4h1"/>
          </svg>
          <div class="absolute -bottom-1 -right-1 w-5 h-5 bg-emerald-600 rounded-lg text-white font-black text-xs flex items-center justify-center border-2 border-white shadow-xs">
            +
          </div>
        </div>
        <div>
          <h1 class="text-2xl font-black text-brand-neutralDark tracking-tight">
            Cadastro de Setores
          </h1>
          <p class="text-xs text-brand-neutral/70">
            Cadastre e gerencie os setores e departamentos do laboratório (Ex: Hematologia, Bioquímica, Imunologia...)
          </p>
        </div>
      </div>
    </div>

    <!-- Botão Principal de Ação -->
    <div class="flex items-center gap-3">
      <button type="button" onclick="openNewSetorModal()" class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs uppercase tracking-wider rounded-xl shadow-lg shadow-emerald-600/20 transition-all active:scale-95 cursor-pointer flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
        <span>+ Novo Setor</span>
      </button>
    </div>
  </div>

  <!-- Cards de Métricas / Resumo dos Setores -->
  <% 
    const totalSetores = setores.length;
  %>
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 sm:gap-4">
    <div class="bg-white p-4 rounded-2xl border border-gray-200 shadow-2xs flex items-center justify-between">
      <div>
        <p class="text-[11px] font-bold text-gray-500 uppercase font-mono tracking-wider">Total Registrados</p>
        <p class="text-2xl font-black text-slate-800 font-mono mt-0.5"><%= totalSetores %></p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-600 text-lg">🏢</div>
    </div>

    <div class="bg-white p-4 rounded-2xl border border-gray-200 shadow-2xs flex items-center justify-between">
      <div>
        <p class="text-[11px] font-bold text-emerald-600 uppercase font-mono tracking-wider">Status do Cadastro</p>
        <p class="text-2xl font-black text-emerald-700 font-mono mt-0.5">Ativo</p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-600 text-lg">✅</div>
    </div>

    <div class="bg-white p-4 rounded-2xl border border-gray-200 shadow-2xs flex items-center justify-between">
      <div>
        <p class="text-[11px] font-bold text-blue-600 uppercase font-mono tracking-wider">Próximo Código</p>
        <p class="text-2xl font-black text-blue-700 font-mono mt-0.5">
          <% 
            let maxCod = 0;
            setores.forEach(s => {
              const num = parseInt(s.codigo, 10);
              if (!isNaN(num) && num > maxCod) maxCod = num;
            });
          %>
          <%= maxCod + 1 %>
        </p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center text-blue-600 text-lg">🏷️</div>
    </div>
  </div>

  <!-- TABELA / LISTA PRINCIPAL DE SETORES -->
  <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
    
    <!-- Barra Superior de Pesquisa e Filtros -->
    <div class="p-4 bg-slate-50/80 border-b border-gray-200 flex flex-col md:flex-row items-center justify-between gap-3">
      
      <div class="flex items-center gap-2 w-full md:w-auto">
        <span class="text-sm font-black text-slate-800 uppercase tracking-wide shrink-0">Lista de Setores</span>
        <span id="setoresCounterBadge" class="px-2.5 py-0.5 bg-emerald-100 text-emerald-800 rounded-full text-xs font-bold font-mono">
          <%= totalSetores %> cadastrados
        </span>
      </div>

      <!-- Campo de Busca -->
      <div class="flex items-center gap-2.5 w-full md:w-auto">
        <div class="relative w-full sm:w-80">
          <input type="text" id="searchSetoresInput" onkeyup="filterSetoresTable()" placeholder="Buscar por código ou descrição..." class="w-full pl-8 pr-3 py-1.5 bg-white border border-gray-300 rounded-xl text-xs outline-none focus:ring-2 focus:ring-emerald-500 shadow-2xs">
          <span class="absolute left-2.5 top-2 text-gray-400 text-xs">🔍</span>
        </div>
      </div>

    </div>

    <!-- Tabela de Setores -->
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-gray-100/90 border-b border-gray-200 text-[10px] font-black text-gray-500 uppercase font-mono tracking-wider">
            <th class="p-3 w-28 text-center">Código</th>
            <th class="p-3">Descrição do Setor</th>
            <th class="p-3 w-28 text-center">Sigla</th>
            <th class="p-3 w-32 text-center">Ações</th>
          </tr>
        </thead>
        <tbody id="setoresTableBody" class="divide-y divide-gray-100 text-xs font-medium">
          <% if (setores.length === 0) { %>
            <tr>
              <td colspan="4" class="p-8 text-center text-gray-400 font-sans italic">
                Nenhum setor cadastrado até o momento.
              </td>
            </tr>
          <% } else { %>
            <% setores.forEach(s => { %>
              <tr class="setor-row hover:bg-emerald-50/40 transition-colors" data-search="<%= ((s.codigo || '') + ' ' + (s.descricao || s.nome || '') + ' ' + (s.sigla || '')).toLowerCase() %>">
                <td class="p-3 text-center font-mono font-bold text-slate-700 bg-slate-50/50">
                  #<%= s.codigo || '' %>
                </td>
                <td class="p-3">
                  <div class="font-bold text-slate-800 text-sm"><%= s.descricao || s.nome || '-' %></div>
                </td>
                <td class="p-3 text-center">
                  <% if (s.sigla) { %>
                    <span class="px-2 py-0.5 bg-slate-100 text-slate-800 font-mono font-black border border-slate-200 rounded-md text-[11px]">
                      <%= s.sigla %>
                    </span>
                  <% } else { %>
                    <span class="text-gray-400 font-mono">-</span>
                  <% } %>
                </td>
                <td class="p-3 text-center">
                  <div class="flex items-center justify-center gap-1.5">
                    <button type="button" onclick="editSetor('<%= s.id %>')" title="Editar Setor" class="px-2 py-1 bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-200 rounded-lg font-bold text-xs transition-all flex items-center gap-1 cursor-pointer">
                      ✏️ Editar
                    </button>
                    <button type="button" onclick="deleteSetor('<%= s.id %>', '<%= (s.descricao || s.nome || '').replace(/'/g, "\\'") %>')" title="Excluir Setor" class="px-2 py-1 bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 rounded-lg font-bold text-xs transition-all flex items-center gap-1 cursor-pointer">
                      🗑️
                    </button>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>

  </div>

</div>

<!-- MODAL DE CADASTRO / EDIÇÃO DE SETOR -->
<div id="setorModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 flex items-center justify-center p-4 hidden">
  <div class="bg-white w-full max-w-lg rounded-2xl shadow-2xl border border-gray-200 overflow-hidden transform transition-all flex flex-col max-h-[90vh]">
    
    <!-- Modal Header -->
    <div class="p-4 bg-slate-900 text-white flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="text-xl">🏢</span>
        <h3 id="setorModalTitle" class="text-sm font-extrabold uppercase font-mono tracking-wider text-brand-gold">
          Cadastrar Novo Setor
        </h3>
      </div>
      <button type="button" onclick="closeSetorModal()" class="text-white/70 hover:text-white text-xl font-bold p-1 cursor-pointer">&times;</button>
    </div>

    <!-- Form Container -->
    <form id="setorForm" action="/admin/setores/save" method="POST" class="p-6 space-y-4 overflow-y-auto flex-1">
      <input type="hidden" name="id" id="set-id" value="">

      <!-- Código (Sequencial) -->
      <div class="space-y-1">
        <label for="set-codigo" class="block text-xs font-extrabold text-slate-700 uppercase font-mono">
          Código Sequencial: <span class="text-rose-500">*</span>
        </label>
        <input type="text" name="codigo" id="set-codigo" required readonly class="w-full px-3 py-2 bg-slate-100 border border-slate-300 rounded-xl text-xs font-bold font-mono text-slate-700 outline-none cursor-not-allowed">
        <p class="text-[10px] text-gray-500">O código sequencial é gerado automaticamente pelo sistema.</p>
      </div>

      <!-- Descrição -->
      <div class="space-y-1">
        <label for="set-descricao" class="block text-xs font-extrabold text-slate-700 uppercase font-mono">
          Descrição do Setor: <span class="text-rose-500">*</span>
        </label>
        <input type="text" name="descricao" id="set-descricao" required placeholder="Ex: Hematologia, Bioquímica, Parasitologia..." class="w-full px-3 py-2 bg-white border border-gray-300 rounded-xl text-xs font-bold text-slate-800 outline-none focus:ring-2 focus:ring-emerald-500">
        <p class="text-[10px] text-gray-500">Informe o nome do setor ou departamento do laboratório.</p>
      </div>

      <!-- Sigla -->
      <div class="space-y-1">
        <label for="set-sigla" class="block text-xs font-extrabold text-slate-700 uppercase font-mono">
          Sigla / Código Reduzido:
        </label>
        <input type="text" name="sigla" id="set-sigla" placeholder="Ex: HEM, BIO, IMU, URO..." class="w-full px-3 py-2 bg-white border border-gray-300 rounded-xl text-xs font-bold text-slate-800 uppercase font-mono outline-none focus:ring-2 focus:ring-emerald-500">
        <p class="text-[10px] text-gray-500">Sigla ou identificador abreviado do setor (Ex: HEM, BIO, TOX...).</p>
      </div>

      <!-- Footer Actions inside Modal -->
      <div class="pt-4 border-t border-gray-100 flex items-center justify-end gap-3">
        <button type="button" onclick="closeSetorModal()" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold text-xs rounded-xl uppercase font-mono transition-all cursor-pointer">
          Cancelar
        </button>
        <button type="submit" class="px-5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-xs rounded-xl uppercase font-mono tracking-wider shadow-md shadow-emerald-600/20 transition-all active:scale-95 cursor-pointer">
          💾 Salvar Setor
        </button>
      </div>
    </form>

  </div>
</div>

<script>
  let setoresList = <%- JSON.stringify(setores) %>;

  function openNewSetorModal() {
    document.getElementById('setorForm').reset();
    document.getElementById('set-id').value = '';
    document.getElementById('set-sigla').value = '';
    
    // Gerar próximo código sequencial
    let maxCod = 0;
    setoresList.forEach(s => {
      const num = parseInt(s.codigo, 10);
      if (!isNaN(num) && num > maxCod) maxCod = num;
    });
    document.getElementById('set-codigo').value = String(maxCod + 1);

    document.getElementById('setorModalTitle').innerText = 'Cadastrar Novo Setor';
    document.getElementById('setorModal').classList.remove('hidden');
    setTimeout(() => document.getElementById('set-descricao').focus(), 100);
  }

  function closeSetorModal() {
    document.getElementById('setorModal').classList.add('hidden');
  }

  function editSetor(id) {
    const item = setoresList.find(s => String(s.id) === String(id));
    if (!item) return;

    document.getElementById('set-id').value = item.id;
    document.getElementById('set-codigo').value = item.codigo;
    document.getElementById('set-descricao').value = item.descricao;
    document.getElementById('set-sigla').value = item.sigla || '';

    document.getElementById('setorModalTitle').innerText = 'Editar Setor #' + item.codigo;
    document.getElementById('setorModal').classList.remove('hidden');
    setTimeout(() => document.getElementById('set-descricao').focus(), 100);
  }

  function deleteSetor(id, desc) {
    if (confirm('Tem certeza que deseja excluir o setor "' + desc + '"?')) {
      fetch('/admin/setores/delete/' + encodeURIComponent(id), {
        method: 'POST',
        headers: { 'Accept': 'application/json' }
      }).then(res => {
        if (res.ok) {
          window.location.reload();
        } else {
          window.location.href = '/admin/setores/delete/' + encodeURIComponent(id);
        }
      }).catch(() => {
        window.location.href = '/admin/setores/delete/' + encodeURIComponent(id);
      });
    }
  }

  function filterSetoresTable() {
    const query = document.getElementById('searchSetoresInput').value.toLowerCase().trim();
    const rows = document.querySelectorAll('.setor-row');
    let visibleCount = 0;

    rows.forEach(row => {
      const text = row.getAttribute('data-search') || '';
      if (!query || text.includes(query)) {
        row.classList.remove('hidden');
        visibleCount++;
      } else {
        row.classList.add('hidden');
      }
    });

    const badge = document.getElementById('setoresCounterBadge');
    if (badge) {
      badge.innerText = visibleCount + ' exibidos';
    }
  }
</script>

<%- include('../partials/footer') %>
