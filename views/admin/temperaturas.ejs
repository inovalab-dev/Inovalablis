<!-- MODAL 1: REGISTRAR LEITURA DE TEMPERATURA -->
<div id="readingModal" class="fixed inset-0 bg-brand-dark/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
  <div class="bg-white border border-brand-light/15 rounded-2xl overflow-hidden max-w-md w-full animate-fade-in shadow-2xl">
    <div class="p-5 bg-brand-softBg/30 border-b border-brand-light/15 flex justify-between items-center">
      <h3 class="text-xs font-mono text-brand-dark uppercase tracking-widest font-extrabold">🌡️ Registrar Medição de Temperatura</h3>
      <button onclick="closeReadingModal()" class="text-gray-400 hover:text-brand-dark font-bold text-lg">&times;</button>
    </div>

    <form action="/admin/temperaturas/add-reading" method="POST" class="p-6 space-y-4 bg-white">
      <input type="hidden" name="eqId" id="modal-reading-eq-id" />
      
      <div>
        <span class="text-xs font-bold font-mono text-gray-400 uppercase block mb-1">Equipamento Selecionado:</span>
        <div id="modal-reading-eq-name" class="text-sm text-brand-dark font-extrabold font-sans">-</div>
        <div id="modal-reading-limits" class="text-[10px] font-mono font-bold text-brand-gold mt-0.5">Faixa de Segurança: 2.0°C a 8.0°C</div>
      </div>

      <div>
        <label class="block text-xs font-bold font-mono text-gray-600 uppercase mb-1">Temperatura Lida (°C) <span class="text-brand-gold">*</span></label>
        <input type="number" step="0.1" name="temp" required autofocus placeholder="Ex: 4.2" class="w-full px-4 py-3 bg-white border border-brand-light/25 rounded-xl text-lg font-bold font-mono text-brand-dark focus:outline-none focus:ring-1 focus:ring-brand-gold focus:border-brand-gold text-center" />
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-bold font-mono text-gray-600 uppercase mb-1">Data da Leitura</label>
          <input type="text" name="date" id="modal-reading-date" class="w-full px-4 py-2.5 bg-white border border-brand-light/25 rounded-xl text-xs font-mono text-brand-dark" />
        </div>
        <div>
          <label class="block text-xs font-bold font-mono text-gray-600 uppercase mb-1">Horário</label>
          <input type="text" name="time" id="modal-reading-time" class="w-full px-4 py-2.5 bg-white border border-brand-light/25 rounded-xl text-xs font-mono text-brand-dark" />
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold font-mono text-gray-600 uppercase mb-1">Operador Residente</label>
        <input type="text" name="responsible" required value="<%= locals.user ? user.name : 'Operador Técnico' %>" class="w-full px-4 py-2.5 bg-white border border-brand-light/25 rounded-xl text-xs font-mono text-brand-dark" />
      </div>

      <div>
        <label class="block text-xs font-bold font-mono text-gray-600 uppercase mb-1">Método de Captura</label>
        <select name="method" class="w-full px-4 py-2.5 bg-white border border-brand-light/25 rounded-xl text-xs font-mono text-brand-dark">
          <option value="Manual">Termômetro Digital Manual (Máximo/Mínimo)</option>
          <option value="IoT">Sensor de Telemetria Integrado</option>
          <option value="Calibrador">Termômetro Padrão RBC (Calibração)</option>
        </select>
      </div>

      <div>
        <label class="block text-xs font-bold font-mono text-gray-600 uppercase mb-1">Observações Operacionais</label>
        <textarea name="notes" rows="2" placeholder="Ex: Equipamento limpo, leituras estáveis." class="w-full px-4 py-2 bg-white border border-brand-light/25 rounded-xl text-xs text-brand-dark focus:outline-none focus:ring-1 focus:ring-brand-gold focus:border-brand-gold"></textarea>
      </div>

      <!-- COMPROVAÇÃO VISUAL (FOTO DA LEITURA / CÂMERA DO CELULAR) -->
      <div class="space-y-2">
        <label class="block text-xs font-bold font-mono text-gray-600 uppercase">Comprovação Visual (Foto) <span class="text-gray-400 font-sans font-medium">(Opcional)</span></label>
        
        <div class="flex gap-2">
          <!-- Botão de Upload / Câmera Nativa -->
          <button type="button" onclick="document.getElementById('reading-photo-file').click()" class="flex-1 py-2 px-3 border border-brand-light/25 bg-white hover:bg-gray-50 text-brand-dark rounded-xl text-xs font-bold font-mono flex items-center justify-center gap-1.5 shadow-sm transition-all">
            <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            Câmera / Arquivo
          </button>
          
          <!-- Botão de Webcam ao vivo (Se suportado) -->
          <button type="button" id="btn-open-webcam" onclick="startWebcamCapture()" class="flex-1 py-2 px-3 border border-brand-light/25 bg-white hover:bg-gray-50 text-brand-dark rounded-xl text-xs font-bold font-mono flex items-center justify-center gap-1.5 shadow-sm transition-all">
            <svg class="w-4 h-4 text-brand-gold shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
            Webcam ao Vivo
          </button>
        </div>

        <!-- Inputs Escondidos -->
        <input type="file" id="reading-photo-file" accept="image/*" capture="environment" class="hidden" onchange="processPhotoFile(this)" />
        <input type="hidden" name="photo" id="modal-reading-photo-base64" />

        <!-- Preview Container -->
        <div id="photo-preview-container" class="hidden relative rounded-xl overflow-hidden border border-brand-light/20 bg-gray-50 aspect-video mt-2 group">
          <img id="photo-preview-img" src="" class="w-full h-full object-cover" />
          <button type="button" onclick="clearCapturedPhoto()" class="absolute top-2 right-2 p-1.5 bg-black/60 hover:bg-black/80 text-white rounded-full transition-all">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
          <div class="absolute bottom-0 inset-x-0 bg-black/60 p-2 text-[10px] text-white font-mono text-center">Foto anexada com sucesso!</div>
        </div>

        <!-- Area de Webcam Live (oculta inicialmente) -->
        <div id="webcam-capture-area" class="hidden relative rounded-xl overflow-hidden border border-brand-light/20 bg-black aspect-video mt-2">
          <video id="webcam-preview-video" autoplay playsinline class="w-full h-full object-cover"></video>
          <div class="absolute bottom-2 inset-x-0 flex justify-center gap-2">
            <button type="button" onclick="capturePhotoFromWebcam()" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-[10px] font-mono font-bold uppercase tracking-wider transition-all shadow">
              📸 Tirar Foto
            </button>
            <button type="button" onclick="stopWebcamCapture()" class="px-3 py-1.5 bg-red-600 hover:bg-red-700 text-white rounded-lg text-[10px] font-mono font-bold uppercase tracking-wider transition-all shadow">
              Cancelar
            </button>
          </div>
        </div>
      </div>

      <div class="flex justify-end gap-3 border-t border-brand-light/15 pt-4">
        <button type="button" onclick="closeReadingModal()" class="px-4 py-2 bg-white hover:bg-gray-50 text-brand-dark border border-brand-light/25 rounded-xl text-xs font-mono uppercase tracking-wider transition-all shadow-sm">Cancelar</button>
        <button type="submit" class="px-4 py-2 bg-brand-gold text-black font-bold rounded-xl text-xs font-mono uppercase tracking-wider transition-all shadow-md">Gravar Leitura</button>
      </div>
    </form>
  </div>
</div>

<!-- MODAL PARA VISUALIZAR FOTO ANEXADA -->
<div id="viewPhotoModal" class="fixed inset-0 bg-brand-dark/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
  <div class="bg-white border border-brand-light/15 rounded-2xl overflow-hidden max-w-lg w-full animate-fade-in shadow-2xl">
    <div class="p-5 bg-brand-softBg/30 border-b border-brand-light/15 flex justify-between items-center">
      <div>
        <h3 id="view-photo-title" class="text-xs font-mono text-brand-dark uppercase tracking-widest font-extrabold">📸 Comprovação Visual</h3>
        <p id="view-photo-subtitle" class="text-[10px] text-gray-500 font-mono mt-0.5">-</p>
      </div>
      <button onclick="closeViewPhotoModal()" class="text-gray-400 hover:text-brand-dark font-bold text-lg">&times;</button>
