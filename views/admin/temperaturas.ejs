<!-- Scripts de Interatividade -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  // Carrega lista de equipamentos para manipulação via JS no frontend
  const dbEquipments = <%- JSON.stringify(items) %>;
  let selectedEquipment = null;
  let activeFichaChart = null;

  // Gerenciamento de Abas Principais
  function switchTab(tabId) {
    // Ocultar todas
    document.getElementById('tab-monitoramento').classList.add('hidden');
    document.getElementById('tab-dashboard').classList.add('hidden');
    document.getElementById('tab-graficos').classList.add('hidden');
    document.getElementById('tab-cadastro').classList.add('hidden');
    document.getElementById('tab-ficha').classList.add('hidden');

    // Desativar botões
    document.getElementById('btn-tab-monitoramento').className = "px-6 py-3 border-b-2 font-mono text-xs uppercase tracking-wider font-bold transition-all border-transparent text-gray-500 hover:text-emerald-600 hover:border-emerald-300 whitespace-nowrap";
    document.getElementById('btn-tab-dashboard').className = "px-6 py-3 border-b-2 font-mono text-xs uppercase tracking-wider font-bold transition-all border-transparent text-gray-500 hover:text-emerald-600 hover:border-emerald-300 whitespace-nowrap";
    document.getElementById('btn-tab-graficos').className = "px-6 py-3 border-b-2 font-mono text-xs uppercase tracking-wider font-bold transition-all border-transparent text-gray-500 hover:text-emerald-600 hover:border-emerald-300 whitespace-nowrap";
    document.getElementById('btn-tab-cadastro').className = "px-6 py-3 border-b-2 font-mono text-xs uppercase tracking-wider font-bold transition-all border-transparent text-gray-500 hover:text-emerald-600 hover:border-emerald-300 whitespace-nowrap";
    document.getElementById('btn-tab-ficha').className = "hidden px-6 py-3 border-b-2 font-mono text-xs uppercase tracking-wider font-bold transition-all border-transparent text-gray-500 hover:text-emerald-600 hover:border-emerald-300 whitespace-nowrap";

    // Exibir a selecionada
    document.getElementById(tabId).classList.remove('hidden');

    // Ativar botão correspondente
    if (tabId === 'tab-monitoramento') {
      document.getElementById('btn-tab-monitoramento').className = "px-6 py-3 border-b-2 font-mono text-xs uppercase tracking-wider font-bold transition-all text-emerald-600 border-emerald-500 whitespace-nowrap";
    } else if (tabId === 'tab-dashboard') {
      document.getElementById('btn-tab-dashboard').className = "px-6 py-3 border-b-2 font-mono text-xs uppercase tracking-wider font-bold transition-all text-emerald-600 border-emerald-500 whitespace-nowrap";
    } else if (tabId === 'tab-graficos') {
      document.getElementById('btn-tab-graficos').className = "px-6 py-3 border-b-2 font-mono text-xs uppercase tracking-wider font-bold transition-all text-emerald-600 border-emerald-500 whitespace-nowrap";
      renderAllEvolutionCharts();
    } else if (tabId === 'tab-cadastro') {
      document.getElementById('btn-tab-cadastro').className = "px-6 py-3 border-b-2 font-mono text-xs uppercase tracking-wider font-bold transition-all text-emerald-600 border-emerald-500 whitespace-nowrap";
    } else if (tabId === 'tab-ficha') {
      const btn = document.getElementById('btn-tab-ficha');
      btn.classList.remove('hidden');
      btn.className = "px-6 py-3 border-b-2 font-mono text-xs uppercase tracking-wider font-bold transition-all text-emerald-600 border-emerald-500 whitespace-nowrap";
    }
  }

  // Modais - Controle de exibição e valores padrão
