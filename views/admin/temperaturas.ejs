  // --- FUNÇÕES DE CAPTURA E PROCESSAMENTO DE FOTO ---
  let webcamStream = null;

  function processPhotoFile(input) {
    if (input.files && input.files[0]) {
      const file = input.files[0];
      const reader = new FileReader();
      
      reader.onload = function(e) {
        resizeAndSetPhoto(e.target.result);
      };
      
      reader.readAsDataURL(file);
    }
  }

  function resizeAndSetPhoto(dataUrl) {
    const img = new Image();
    img.src = dataUrl;
    img.onload = function() {
      // Manter o JSON leve: redimensionar para no máximo 600px de largura/altura
      const maxDim = 600;
      let width = img.width;
      let height = img.height;
      
      if (width > maxDim || height > maxDim) {
        if (width > height) {
          height = Math.round((height * maxDim) / width);
          width = maxDim;
        } else {
          width = Math.round((width * maxDim) / height);
          height = maxDim;
        }
      }
      
      const canvas = document.createElement('canvas');
      canvas.width = width;
      canvas.height = height;
      const ctx = canvas.getContext('2d');
      ctx.drawImage(img, 0, 0, width, height);
      
      // Obter string Base64 compactada em JPEG de 70% de qualidade
      const compressedBase64 = canvas.toDataURL('image/jpeg', 0.7);
      
      // Definir valor no input hidden do form
      document.getElementById('modal-reading-photo-base64').value = compressedBase64;
      
      // Mostrar elemento de preview
      const previewImg = document.getElementById('photo-preview-img');
      previewImg.src = compressedBase64;
      document.getElementById('photo-preview-container').classList.remove('hidden');
      
      // Encerrar webcam se estiver aberta
      stopWebcamCapture();
    };
  }

  function startWebcamCapture() {
    const webcamArea = document.getElementById('webcam-capture-area');
    const video = document.getElementById('webcam-preview-video');
    const previewContainer = document.getElementById('photo-preview-container');
    
    // Esconde preview anterior se houver
    previewContainer.classList.add('hidden');
    webcamArea.classList.remove('hidden');
    
    // Tenta primeiro acessar a câmera traseira do celular ("environment")
    navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } })
      .then(stream => {
        webcamStream = stream;
        video.srcObject = stream;
        video.play();
      })
      .catch(err => {
        console.warn("Câmera traseira falhou, tentando qualquer câmera disponível...", err);
        navigator.mediaDevices.getUserMedia({ video: true })
          .then(stream => {
            webcamStream = stream;
            video.srcObject = stream;
            video.play();
          })
          .catch(fallbackErr => {
            console.error("Nenhuma câmera encontrada:", fallbackErr);
            alert("Não foi possível acessar a câmera do seu dispositivo.");
            stopWebcamCapture();
          });
      });
  }

  function stopWebcamCapture() {
    const webcamArea = document.getElementById('webcam-capture-area');
    const video = document.getElementById('webcam-preview-video');
    
    if (webcamStream) {
      webcamStream.getTracks().forEach(track => track.stop());
      webcamStream = null;
    }
    
    video.srcObject = null;
    webcamArea.classList.add('hidden');
  }

  function capturePhotoFromWebcam() {
    const video = document.getElementById('webcam-preview-video');
    if (!video.srcObject) return;
    
    const canvas = document.createElement('canvas');
    canvas.width = video.videoWidth || 640;
    canvas.height = video.videoHeight || 480;
    const ctx = canvas.getContext('2d');
    
    // Captura o frame atual do vídeo
    ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
    
    const dataUrl = canvas.toDataURL('image/jpeg', 0.9);
    resizeAndSetPhoto(dataUrl);
    
    stopWebcamCapture();
  }

