<%- include('../partials/header') %>

<div class="p-6 max-w-7xl mx-auto space-y-6">
  <!-- Cabeçalho -->
  <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-b border-brand-light/15 pb-6">
    <div>
      <div class="flex items-center gap-2 text-xs font-mono text-brand-gold uppercase tracking-wider mb-1 font-bold">
        <span>Gestão de Qualidade</span>
        <span>•</span>
        <span>RDC 302/ANVISA</span>
      </div>
      <h1 class="text-3xl font-extrabold font-sans tracking-tight text-brand-dark flex items-center gap-3 animate-fade-in">
        <svg class="w-8 h-8 text-brand-gold shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
        Monitoramento Ambiental & Temperaturas
      </h1>
      <p class="text-sm text-gray-500 mt-1">Sistemas de armazenamento térmico e controle de umidade regulamentados.</p>
    </div>

    <div class="flex flex-wrap gap-2 shrink-0">
      <button onclick="switchTab('tab-cadastro')" class="px-4 py-2.5 bg-white border border-brand-light/25 hover:bg-brand-softBg/50 text-brand-dark rounded-xl text-xs font-bold font-mono uppercase tracking-wider transition-all flex items-center gap-2 shadow-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
        Novo Equipamento
      </button>
      <button onclick="switchTab('tab-graficos')" class="px-4 py-2.5 bg-white border border-brand-light/25 hover:bg-brand-softBg/50 text-brand-dark rounded-xl text-xs font-bold font-mono uppercase tracking-wider transition-all flex items-center gap-2 shadow-sm">
        <svg class="w-4 h-4 text-brand-gold shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11 3.055A9.003 9.003 0 1020.945 13H11V3.055z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z" />
        </svg>
        Painel de Gráficos
      </button>
      <button onclick="switchTab('tab-dashboard')" class="px-4 py-2.5 bg-brand-gold hover:bg-[#b8945a] text-black rounded-xl text-xs font-bold font-mono uppercase tracking-wider transition-all flex items-center gap-2 shadow-md">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
        Dashboard Consolidado
      </button>
    </div>
  </div>

  <!-- Alertas de Sucesso/Erro -->
  <% if (typeof req !== 'undefined' && req.query.success) { %>
    <div class="p-4 bg-emerald-50 border border-emerald-200 rounded-2xl flex items-center gap-3 text-emerald-800 text-xs font-mono uppercase tracking-wider shadow-sm">
      <svg class="w-5 h-5 shrink-0 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      <span class="font-bold">
        <% if (req.query.success === 'added') { %>Equipamento cadastrado com sucesso!<% } %>
        <% if (req.query.success === 'edited') { %>Dados do equipamento atualizados!<% } %>
        <% if (req.query.success === 'deleted') { %>Equipamento removido com sucesso.<% } %>
        <% if (req.query.success === 'reading') { %>Leitura registrada com sucesso. Status atualizado!<% } %>
        <% if (req.query.success === 'occurrence') { %>Ocorrência registrada e equipe notificada!<% } %>
        <% if (req.query.success === 'resolved') { %>Ocorrência resolvida e plano de ação arquivado!<% } %>
        <% if (req.query.success === 'maintenance') { %>Manutenção cadastrada com sucesso!<% } %>
        <% if (req.query.success === 'checklist') { %>Checklist diário atualizado e assinado digitalmente!<% } %>
        <% if (req.query.success === 'document') { %>Documento técnico anexado com sucesso!<% } %>
      </span>
    </div>
  <% } %>

  <!-- Abas Superiores -->
  <div class="flex border-b border-brand-light/15 gap-1 overflow-x-auto scrollbar-thin pb-px">
    <button id="btn-tab-monitoramento" onclick="switchTab('tab-monitoramento')" class="px-6 py-3 border-b-2 font-mono text-xs uppercase tracking-wider font-bold transition-all text-emerald-600 border-emerald-500 whitespace-nowrap">
      🌡️ Monitoramento em Tempo Real
    </button>
    <button id="btn-tab-dashboard" onclick="switchTab('tab-dashboard')" class="px-6 py-3 border-b-2 font-mono text-xs uppercase tracking-wider font-bold transition-all border-transparent text-gray-500 hover:text-emerald-600 hover:border-emerald-300 whitespace-nowrap">
      📊 Dashboard Consolidado
    </button>
    <button id="btn-tab-graficos" onclick="switchTab('tab-graficos')" class="px-6 py-3 border-b-2 font-mono text-xs uppercase tracking-wider font-bold transition-all border-transparent text-gray-500 hover:text-emerald-600 hover:border-emerald-300 whitespace-nowrap">
      📈 Evolução de Temperaturas
    </button>
    <button id="btn-tab-cadastro" onclick="switchTab('tab-cadastro')" class="px-6 py-3 border-b-2 font-mono text-xs uppercase tracking-wider font-bold transition-all border-transparent text-gray-500 hover:text-emerald-600 hover:border-emerald-300 whitespace-nowrap">
      ⚙️ Cadastro de Equipamento
    </button>
    <button id="btn-tab-ficha" onclick="switchTab('tab-ficha')" class="hidden px-6 py-3 border-b-2 font-mono text-xs uppercase tracking-wider font-bold transition-all border-transparent text-gray-500 hover:text-emerald-600 hover:border-emerald-300 whitespace-nowrap">
      📋 Ficha do Equipamento
    </button>
  </div>

  <!-- CONTEÚDO DAS ABAS -->

  <!-- ABA 1: MONITORAMENTO EM TEMPO REAL -->
  <div id="tab-monitoramento" class="space-y-6">
    <!-- Cards de Resumo -->
    <div class="grid grid-cols-2 lg:grid-cols-5 gap-4">
      <% 
        let totalEq = items.length;
        let dentroFaixa = items.filter(e => e.status.includes('Dentro')).length;
        let atencao = items.filter(e => e.status.includes('Atenção') || e.status.includes('Aviso')).length;
        let foraFaixa = items.filter(e => e.status.includes('Fora')).length;
        let ocorrenciasMes = items.reduce((acc, curr) => acc + (curr.occurrences ? curr.occurrences.length : 0), 0);
      %>
      <div class="p-4 bg-white border border-brand-light/15 shadow-sm rounded-2xl flex flex-col justify-between">
        <span class="text-[10px] font-bold font-mono text-gray-400 uppercase tracking-widest block mb-2">Total Equipamentos</span>
        <div class="flex items-baseline gap-2">
          <span class="text-3xl font-extrabold font-sans text-brand-dark"><%= totalEq %></span>
          <span class="text-xs text-gray-400">ativos</span>
        </div>
      </div>
      <div class="p-4 bg-emerald-50/50 border border-emerald-500/15 shadow-sm rounded-2xl flex flex-col justify-between">
        <span class="text-[10px] font-bold font-mono text-emerald-700 uppercase tracking-widest block mb-2">🟢 Dentro da Faixa</span>
        <div class="flex items-baseline gap-2">
          <span class="text-3xl font-extrabold font-sans text-emerald-700"><%= dentroFaixa %></span>
          <span class="text-xs text-emerald-600/80"><%= totalEq > 0 ? Math.round((dentroFaixa/totalEq)*100) : 0 %>%</span>
        </div>
      </div>
      <div class="p-4 bg-amber-50/50 border border-amber-500/15 shadow-sm rounded-2xl flex flex-col justify-between">
        <span class="text-[10px] font-bold font-mono text-amber-700 uppercase tracking-widest block mb-2">🟡 Atenção / Limites</span>
        <div class="flex items-baseline gap-2">
          <span class="text-3xl font-extrabold font-sans text-amber-700"><%= atencao %></span>
          <span class="text-xs text-amber-600/80"><%= totalEq > 0 ? Math.round((atencao/totalEq)*100) : 0 %>%</span>
        </div>
      </div>
      <div class="p-4 bg-rose-50/50 border border-rose-500/15 shadow-sm rounded-2xl flex flex-col justify-between">
        <span class="text-[10px] font-bold font-mono text-rose-700 uppercase tracking-widest block mb-2">🔴 Fora da Faixa</span>
        <div class="flex items-baseline gap-2">
          <span class="text-3xl font-extrabold font-sans text-rose-700"><%= foraFaixa %></span>
          <span class="text-xs text-rose-600/80"><%= totalEq > 0 ? Math.round((foraFaixa/totalEq)*100) : 0 %>%</span>
        </div>
      </div>
      <div class="col-span-2 lg:col-span-1 p-4 bg-amber-50/20 border border-brand-gold/15 shadow-sm rounded-2xl flex flex-col justify-between">
        <span class="text-[10px] font-bold font-mono text-amber-800 uppercase tracking-widest block mb-2">⚠ Ocorrências Ativas</span>
        <div class="flex items-baseline gap-2">
          <span class="text-3xl font-extrabold font-sans text-amber-800">
            <%= items.reduce((acc, curr) => acc + (curr.occurrences ? curr.occurrences.filter(o => o.status === 'Aberta').length : 0), 0) %>
          </span>
          <span class="text-xs text-amber-700/80">pendentes</span>
        </div>
      </div>
    </div>

    <!-- Lista de Equipamentos -->
    <div class="bg-white border border-brand-light/15 shadow-sm rounded-2xl overflow-hidden">
      <div class="p-4 bg-brand-softBg/30 border-b border-brand-light/15 flex justify-between items-center">
        <h3 class="text-sm font-bold font-mono uppercase text-brand-dark tracking-wider flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-brand-gold"></span>
          Equipamentos sob Monitoramento Ativo
        </h3>
        <span class="text-[11px] font-mono text-gray-400">Atualizado agora há pouco</span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-brand-light/15 bg-brand-neutralLight/45">
              <th class="p-4 text-xs font-bold font-mono text-gray-500 uppercase">Equipamento</th>
              <th class="p-4 text-xs font-bold font-mono text-gray-500 uppercase">Código</th>
              <th class="p-4 text-xs font-bold font-mono text-gray-500 uppercase">Localização / Setor</th>
              <th class="p-4 text-xs font-bold font-mono text-gray-500 uppercase text-center">Limites Seguro</th>
              <th class="p-4 text-xs font-bold font-mono text-gray-500 uppercase text-center">Última Temperatura</th>
              <th class="p-4 text-xs font-bold font-mono text-gray-500 uppercase text-center">Status</th>
              <th class="p-4 text-xs font-bold font-mono text-gray-500 uppercase text-right">Ações</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-brand-light/10">
            <% if (items.length === 0) { %>
              <tr>
                <td colspan="7" class="p-8 text-center text-sm text-gray-400 font-mono bg-white">
                  Nenhum equipamento cadastrado para monitoramento de temperatura.
                </td>
              </tr>
            <% } else { %>
              <% items.forEach(function(eq) { %>
                <tr class="hover:bg-brand-softBg/20 transition-colors bg-white">
                  <td class="p-4">
                    <div class="flex items-center gap-3">
                      <div class="w-10 h-10 rounded-xl bg-brand-softBg/50 flex items-center justify-center text-lg shadow-inner">
                        <% if (eq.type === 'Geladeira') { %>❄️<% } else if (eq.type === 'Freezer') { %>🥶<% } else if (eq.type === 'Ultra Freezer') { %>🧪<% } else { %>🌡️<% } %>
                      </div>
                      <div>
                        <div class="font-bold text-brand-dark text-sm"><%= eq.name %></div>
                        <div class="text-[11px] font-mono text-gray-400"><%= eq.type %> • <%= eq.brand %> <%= eq.model %></div>
                      </div>
                    </div>
                  </td>
                  <td class="p-4 font-mono text-xs text-gray-500 font-bold"><%= eq.code %></td>
                  <td class="p-4">
                    <div class="text-xs text-gray-700 font-medium"><%= eq.location %></div>
                    <div class="text-[10px] font-mono text-gray-400 uppercase font-bold"><%= eq.sector %></div>
                  </td>
                  <td class="p-4 text-center font-mono text-xs">
                    <span class="px-2.5 py-1 rounded-lg bg-gray-50 border border-gray-200 text-gray-700 font-semibold">
                      <%= eq.minTemp %>°C a <%= eq.maxTemp %>°C
                    </span>
                  </td>
                  <td class="p-4 text-center">
                    <div class="inline-block px-3 py-1.5 rounded-xl text-sm font-bold font-mono border <%= eq.status.includes('Dentro') ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : eq.status.includes('Atenção') ? 'bg-amber-50 text-amber-700 border-amber-200' : 'bg-rose-50 text-rose-700 border-rose-200' %>">
                      <%= eq.currentTemp %> °C
                    </div>
                    <div class="text-[10px] font-mono text-gray-400 mt-1">Registrado às <%= eq.lastReadingTime %></div>
                  </td>
                  <td class="p-4 text-center">
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-mono font-bold border <%= eq.status.includes('Dentro') ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : eq.status.includes('Atenção') ? 'bg-amber-50 text-amber-700 border-amber-200' : 'bg-rose-50 text-rose-700 border-rose-200' %>">
                      <%= eq.status %>
                    </span>
                  </td>
                  <td class="p-4 text-right whitespace-nowrap">
                    <div class="flex items-center justify-end gap-2">
                      <button onclick="openReadingModal('<%= eq.id %>', '<%= eq.name %>', '<%= eq.minTemp %>', '<%= eq.maxTemp %>')" class="px-3 py-1.5 bg-white hover:bg-gray-50 text-brand-dark border border-brand-light/25 rounded-lg text-xs font-mono font-bold uppercase tracking-wider transition-all shadow-sm">
                        + Leitura
                      </button>
                      <button onclick="viewEquipmentFicha('<%= eq.id %>')" class="px-3 py-1.5 bg-brand-gold hover:bg-[#b8945a] text-black rounded-lg text-xs font-mono font-bold uppercase tracking-wider transition-all shadow-sm">
                        Ver Ficha
                      </button>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- ABA 2: DASHBOARD CONSOLIDADO -->
  <div id="tab-dashboard" class="hidden space-y-6">
    <!-- Painel de Relatórios Consolidados -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <div class="p-6 bg-white border border-brand-light/15 shadow-sm rounded-2xl flex flex-col justify-between">
        <div>
          <span class="text-xs font-bold font-mono text-brand-gold uppercase tracking-wider block mb-1">Métricas de Qualidade</span>
          <h3 class="text-lg font-bold text-brand-dark mb-4">Índice de Estabilidade Térmica</h3>
          <p class="text-sm text-gray-500 mb-6 font-medium">Média de horas que as geladeiras e ambientes permaneceram dentro dos limites regulamentares este mês.</p>
        </div>
        <div class="space-y-4">
          <div>
            <div class="flex justify-between text-xs font-mono mb-1">
              <span class="text-gray-600 font-bold">Geladeiras de Reagentes</span>
              <span class="text-emerald-600 font-bold">98.2%</span>
            </div>
            <div class="w-full bg-gray-100 h-2 rounded-full overflow-hidden">
              <div class="bg-emerald-500 h-full rounded-full" style="width: 98.2%"></div>
            </div>
          </div>
          <div>
            <div class="flex justify-between text-xs font-mono mb-1">
              <span class="text-gray-600 font-bold">Conservadoras de Vacinas</span>
              <span class="text-emerald-600 font-bold">100%</span>
            </div>
            <div class="w-full bg-gray-100 h-2 rounded-full overflow-hidden">
              <div class="bg-emerald-500 h-full rounded-full" style="width: 100%"></div>
            </div>
          </div>
          <div>
            <div class="flex justify-between text-xs font-mono mb-1">
              <span class="text-gray-600 font-bold">Sala Técnica & Equipamentos</span>
              <span class="text-rose-600 font-bold">81.4%</span>
            </div>
            <div class="w-full bg-gray-100 h-2 rounded-full overflow-hidden">
              <div class="bg-rose-500 h-full rounded-full" style="width: 81.4%"></div>
            </div>
          </div>
        </div>
      </div>

      <div class="p-6 bg-white border border-brand-light/15 shadow-sm rounded-2xl lg:col-span-2">
        <div class="flex justify-between items-center mb-4">
          <div>
            <span class="text-xs font-bold font-mono text-brand-gold uppercase tracking-wider block mb-1">Histórico Mensal</span>
            <h3 class="text-lg font-bold text-brand-dark">Leituras Gerais & Não Conformidades</h3>
          </div>
          <select class="p-2 bg-white border border-brand-light/25 rounded-xl text-xs font-mono text-brand-dark focus:outline-none focus:ring-1 focus:ring-brand-gold focus:border-brand-gold">
            <option value="julho">Julho 2026</option>
            <option value="junho">Junho 2026</option>
          </select>
        </div>

        <div class="h-64 flex items-end justify-between gap-2 pt-6">
          <!-- Colunas de Gráfico Simuladas via HTML Puro para Alta Performance e sem dependências pesadas -->
          <div class="flex-1 flex flex-col items-center gap-2">
            <div class="w-full bg-gray-50 hover:bg-brand-softBg/20 transition-all rounded-t-lg relative group flex flex-col justify-end border border-brand-light/10" style="height: 100%">
              <div class="bg-emerald-500 h-[92%] rounded-t-lg"></div>
              <span class="absolute top-1 left-1/2 -translate-x-1/2 bg-brand-dark text-[10px] font-mono text-emerald-400 px-1.5 py-0.5 rounded opacity-0 group-hover:opacity-100 transition-opacity font-bold shadow-md">92%</span>
            </div>
            <span class="text-[10px] font-mono font-bold text-gray-400">Semana 1</span>
          </div>
          <div class="flex-1 flex flex-col items-center gap-2">
            <div class="w-full bg-gray-50 hover:bg-brand-softBg/20 transition-all rounded-t-lg relative group flex flex-col justify-end border border-brand-light/10" style="height: 100%">
              <div class="bg-emerald-500 h-[96%] rounded-t-lg"></div>
              <span class="absolute top-1 left-1/2 -translate-x-1/2 bg-brand-dark text-[10px] font-mono text-emerald-400 px-1.5 py-0.5 rounded opacity-0 group-hover:opacity-100 transition-opacity font-bold shadow-md">96%</span>
            </div>
            <span class="text-[10px] font-mono font-bold text-gray-400">Semana 2</span>
          </div>
          <div class="flex-1 flex flex-col items-center gap-2">
            <div class="w-full bg-gray-50 hover:bg-brand-softBg/20 transition-all rounded-t-lg relative group flex flex-col justify-end border border-brand-light/10" style="height: 100%">
              <div class="bg-amber-500 h-[88%] rounded-t-lg"></div>
              <span class="absolute top-1 left-1/2 -translate-x-1/2 bg-brand-dark text-[10px] font-mono text-amber-400 px-1.5 py-0.5 rounded opacity-0 group-hover:opacity-100 transition-opacity font-bold shadow-md">88%</span>
            </div>
            <span class="text-[10px] font-mono font-bold text-gray-400">Semana 3</span>
          </div>
          <div class="flex-1 flex flex-col items-center gap-2">
            <div class="w-full bg-gray-50 hover:bg-brand-softBg/20 transition-all rounded-t-lg relative group flex flex-col justify-end border border-brand-light/10" style="height: 100%">
              <div class="bg-emerald-500 h-[99%] rounded-t-lg"></div>
              <span class="absolute top-1 left-1/2 -translate-x-1/2 bg-brand-dark text-[10px] font-mono text-emerald-400 px-1.5 py-0.5 rounded opacity-0 group-hover:opacity-100 transition-opacity font-bold shadow-md">99%</span>
            </div>
            <span class="text-[10px] font-mono font-bold text-gray-400">Semana 4</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Ocorrências Recentes Consolidadas -->
    <div class="bg-white border border-brand-light/15 shadow-sm rounded-2xl overflow-hidden">
      <div class="p-4 bg-brand-softBg/30 border-b border-brand-light/15 flex justify-between items-center">
        <h3 class="text-sm font-bold font-mono uppercase text-brand-dark tracking-wider">Histórico de Ocorrências e Desvios Técnicos</h3>
        <span class="text-[11px] font-mono text-gray-400">Auditável pela Vigilância Sanitária</span>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left">
          <thead>
            <tr class="border-b border-brand-light/15 bg-brand-neutralLight/45">
              <th class="p-4 text-xs font-bold font-mono text-gray-500 uppercase">Equipamento</th>
              <th class="p-4 text-xs font-bold font-mono text-gray-500 uppercase">Data Desvio</th>
              <th class="p-4 text-xs font-bold font-mono text-gray-500 uppercase text-center">Temp. Crítica</th>
              <th class="p-4 text-xs font-bold font-mono text-gray-500 uppercase">Descrição da Ocorrência</th>
              <th class="p-4 text-xs font-bold font-mono text-gray-500 uppercase">Status</th>
              <th class="p-4 text-xs font-bold font-mono text-gray-500 uppercase text-right">Responsável</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-brand-light/10 text-xs font-mono bg-white">
            <% 
              let hasOcs = false;
              items.forEach(function(eq) { 
                if (eq.occurrences && eq.occurrences.length > 0) {
                  hasOcs = true;
                  eq.occurrences.forEach(function(occ, idx) {
            %>
                    <tr class="hover:bg-brand-softBg/20 transition-colors bg-white">
                      <td class="p-4 font-bold text-brand-dark"><%= eq.name %></td>
                      <td class="p-4 text-gray-700 font-semibold"><%= occ.date %></td>
                      <td class="p-4 text-center text-rose-600 font-bold"><%= occ.temp %>°C</td>
                      <td class="p-4 text-gray-600">
                        <div class="font-bold text-brand-dark/90"><%= occ.reason %></div>
                        <div class="text-[11px] text-gray-500 font-sans mt-0.5"><%= occ.description %></div>
                        <% if (occ.status === 'Fechada') { %>
                          <div class="text-[11px] text-emerald-700 font-bold font-sans mt-1">✓ <b>Resolução:</b> <%= occ.result %> (T. fora: <%= occ.timeOutside %>)</div>
                        <% } %>
                      </td>
                      <td class="p-4">
                        <span class="px-2 py-0.5 rounded text-[10px] font-bold border <%= occ.status === 'Fechada' ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 'bg-rose-50 text-rose-700 border-rose-200' %>">
                          <%= occ.status %>
                        </span>
                      </td>
                      <td class="p-4 text-right text-gray-700 font-medium"><%= occ.identifiedBy %></td>
                    </tr>
            <% 
                  });
                }
              }); 
              if (!hasOcs) {
            %>
              <tr>
                <td colspan="6" class="p-8 text-center text-sm text-gray-400 font-mono">
                  Nenhuma ocorrência ou desvio térmico registrado.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- ABA NOVA: EVOLUÇÃO DE TEMPERATURAS (GRAFICOS DE CADA AMBIENTE OU EQUIPAMENTO) -->
  <div id="tab-graficos" class="hidden space-y-6">
    <!-- Cabeçalho do Painel de Evolução -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 bg-white p-6 border border-brand-light/15 rounded-2xl shadow-sm">
      <div>
        <h2 class="text-lg font-bold text-brand-dark flex items-center gap-2">
          📈 Evolução de Temperaturas por Equipamento/Ambiente
        </h2>
        <p class="text-xs text-gray-500 mt-1 font-medium">Análise visual cronológica de estabilidade térmica. Ideal para relatórios de auditoria e controle de qualidade RDC 302.</p>
      </div>
      <div class="flex items-center gap-2">
        <label class="text-xs font-bold font-mono text-gray-500 uppercase">Período:</label>
        <div class="flex gap-1 bg-gray-100 p-1 rounded-xl border border-brand-light/10">
          <button onclick="setEvolutionPeriod('diario')" id="btn-ev-diario" class="px-3 py-1.5 rounded-lg text-[10px] font-mono font-bold uppercase tracking-wider transition-all bg-brand-gold text-black">Leituras Recentes</button>
          <button onclick="setEvolutionPeriod('semanal')" id="btn-ev-semanal" class="px-3 py-1.5 rounded-lg text-[10px] font-mono font-bold uppercase tracking-wider transition-all text-gray-500 hover:text-brand-dark">Semanal</button>
          <button onclick="setEvolutionPeriod('mensal')" id="btn-ev-mensal" class="px-3 py-1.5 rounded-lg text-[10px] font-mono font-bold uppercase tracking-wider transition-all text-gray-500 hover:text-brand-dark">Mensal</button>
        </div>
      </div>
    </div>

    <!-- Grid de Gráficos -->
    <div id="evolution-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6 animate-fade-in">
      <% if (items.length === 0) { %>
        <div class="col-span-full p-8 text-center text-sm text-gray-400 font-mono bg-white border border-brand-light/15 rounded-2xl shadow-sm">
          Nenhum equipamento cadastrado para exibir gráficos.
        </div>
      <% } else { %>
        <% items.forEach(function(eq) { %>
          <div class="bg-white border border-brand-light/15 shadow-sm rounded-2xl p-6 flex flex-col justify-between hover:border-brand-gold/30 transition-all duration-300">
            <!-- Cabeçalho do Card -->
            <div class="flex justify-between items-start border-b border-brand-light/10 pb-4 mb-4">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-brand-softBg/50 flex items-center justify-center text-lg shadow-inner">
                  <% if (eq.type === 'Geladeira') { %>❄️<% } else if (eq.type === 'Freezer') { %>🥶<% } else if (eq.type === 'Ultra Freezer') { %>🧪<% } else { %>🌡️<% } %>
                </div>
                <div>
                  <h4 class="font-bold text-brand-dark text-sm"><%= eq.name %></h4>
                  <p class="text-[11px] font-mono text-gray-400 font-medium"><%= eq.code %> • <%= eq.type %></p>
                </div>
              </div>
              <div class="text-right">
                <div class="text-lg font-extrabold font-mono text-brand-dark"><%= eq.currentTemp %>°C</div>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[9px] font-mono font-bold border <%= eq.status.includes('Dentro') ? 'bg-emerald-50 text-emerald-700 border-emerald-100' : eq.status.includes('Atenção') ? 'bg-amber-50 text-amber-700 border-amber-100' : 'bg-rose-50 text-rose-700 border-rose-100' %>">
                  <%= eq.status %>
                </span>
              </div>
            </div>

            <!-- Canvas do Gráfico -->
            <div class="relative w-full bg-gray-50/30 rounded-xl p-3 border border-brand-light/5 mb-4" style="height: 220px;">
              <canvas id="evolutionChart-<%= eq.id %>" class="w-full h-full"></canvas>
            </div>

            <!-- Rodapé e Métricas Rápidas -->
            <div class="flex justify-between items-center bg-brand-softBg/20 rounded-xl p-3 border border-brand-light/10">
              <div class="grid grid-cols-2 gap-x-4 gap-y-1 text-[10px] font-mono text-gray-500">
                <div><span class="font-bold text-gray-400">FAIXA:</span> <%= eq.minTemp %> a <%= eq.maxTemp %>°C</div>
                <div><span class="font-bold text-gray-400 font-sans">SETOR:</span> <%= eq.sector %></div>
                <div><span class="font-bold text-gray-400">MÍN/MÁX:</span> <span id="ev-stat-minmax-<%= eq.id %>" class="font-bold text-brand-dark">—</span></div>
                <div><span class="font-bold text-gray-400">ESTABILIDADE:</span> <span id="ev-stat-status-<%= eq.id %>" class="font-bold text-brand-dark">—</span></div>
              </div>
              <button onclick="viewEquipmentFicha('<%= eq.id %>')" class="px-3 py-1.5 bg-brand-gold hover:bg-[#b8945a] text-black rounded-lg text-[10px] font-mono font-bold uppercase tracking-wider transition-all shadow-sm">
                Ficha Técnica
              </button>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>
  </div>

  <!-- ABA 3: CADASTRO DE EQUIPAMENTO -->
  <div id="tab-cadastro" class="hidden">
    <div class="bg-white border border-brand-light/15 shadow-sm rounded-2xl overflow-hidden max-w-2xl mx-auto animate-fade-in">
      <div class="p-5 bg-brand-softBg/30 border-b border-brand-light/15">
        <h3 class="text-sm font-bold font-mono uppercase text-brand-gold tracking-wider flex items-center gap-2">
          ⚙️ Novo Equipamento ou Ambiente de Conservação
        </h3>
        <p class="text-xs text-gray-500 mt-1">Garante o correto controle do patrimônio e vinculação a sensores IoT ou planilhas de leitura.</p>
      </div>

      <form action="/admin/temperaturas/add-equipamento" method="POST" class="p-6 space-y-4 bg-white">
        <div class="grid grid-cols-2 gap-4">
          <div class="col-span-2">
            <label class="block text-xs font-bold font-mono text-gray-600 uppercase mb-1">Nome do Equipamento / Ambiente <span class="text-brand-gold">*</span></label>
            <input type="text" name="name" required placeholder="Ex: Geladeira de Reagentes Biomol 02" class="w-full px-4 py-2.5 bg-white border border-brand-light/25 rounded-xl text-sm text-brand-dark placeholder-gray-400 focus:outline-none focus:ring-1 focus:ring-brand-gold focus:border-brand-gold" />
          </div>

          <div>
            <label class="block text-xs font-bold font-mono text-gray-600 uppercase mb-1">Código Identificador <span class="text-brand-gold">*</span></label>
            <input type="text" name="code" required placeholder="Ex: GEL-BIO-02" class="w-full px-4 py-2.5 bg-white border border-brand-light/25 rounded-xl text-sm text-brand-dark placeholder-gray-400 focus:outline-none focus:ring-1 focus:ring-brand-gold focus:border-brand-gold" />
          </div>

          <div>
            <label class="block text-xs font-bold font-mono text-gray-600 uppercase mb-1">Tipo de Conservação</label>
            <select name="type" class="w-full px-4 py-2.5 bg-white border border-brand-light/25 rounded-xl text-sm text-brand-dark focus:outline-none focus:ring-1 focus:ring-brand-gold focus:border-brand-gold">
              <option value="Geladeira">Geladeira (2°C a 8°C)</option>
              <option value="Freezer">Freezer (-20°C)</option>
              <option value="Ultra Freezer">Ultra Freezer (-80°C)</option>
              <option value="Ambiente">Ambiente Climatizado (15°C a 25°C)</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-bold font-mono text-gray-600 uppercase mb-1">Marca</label>
            <input type="text" name="brand" placeholder="Ex: Consul / Metalfrio" class="w-full px-4 py-2.5 bg-white border border-brand-light/25 rounded-xl text-sm text-brand-dark placeholder-gray-400 focus:outline-none focus:ring-1 focus:ring-brand-gold focus:border-brand-gold" />
          </div>

          <div>
            <label class="block text-xs font-bold font-mono text-gray-600 uppercase mb-1">Modelo</label>
            <input type="text" name="model" placeholder="Ex: MedSafe Pro" class="w-full px-4 py-2.5 bg-white border border-brand-light/25 rounded-xl text-sm text-brand-dark placeholder-gray-400 focus:outline-none focus:ring-1 focus:ring-brand-gold focus:border-brand-gold" />
          </div>

          <div>
            <label class="block text-xs font-bold font-mono text-gray-600 uppercase mb-1">Número de Série</label>
            <input type="text" name="serialNumber" placeholder="Ex: SN-8821A" class="w-full px-4 py-2.5 bg-white border border-brand-light/25 rounded-xl text-sm text-brand-dark placeholder-gray-400 focus:outline-none focus:ring-1 focus:ring-brand-gold focus:border-brand-gold" />
          </div>

          <div>
            <label class="block text-xs font-bold font-mono text-gray-600 uppercase mb-1">Patrimônio</label>
            <input type="text" name="patrimony" placeholder="Ex: PAT-1092" class="w-full px-4 py-2.5 bg-white border border-brand-light/25 rounded-xl text-sm text-brand-dark placeholder-gray-400 focus:outline-none focus:ring-1 focus:ring-brand-gold focus:border-brand-gold" />
          </div>

          <div>
            <label class="block text-xs font-bold font-mono text-gray-600 uppercase mb-1">Setor Responsável</label>
            <input type="text" name="sector" placeholder="Ex: Bioquímica / Vacinação" class="w-full px-4 py-2.5 bg-white border border-brand-light/25 rounded-xl text-sm text-brand-dark placeholder-gray-400 focus:outline-none focus:ring-1 focus:ring-brand-gold focus:border-brand-gold" />
          </div>

          <div>
            <label class="block text-xs font-bold font-mono text-gray-600 uppercase mb-1">Localização Física</label>
            <input type="text" name="location" placeholder="Ex: Sala de Triagem de Amostras" class="w-full px-4 py-2.5 bg-white border border-brand-light/25 rounded-xl text-sm text-brand-dark placeholder-gray-400 focus:outline-none focus:ring-1 focus:ring-brand-gold focus:border-brand-gold" />
          </div>

          <div>
            <label class="block text-xs font-bold font-mono text-gray-600 uppercase mb-1">Responsável Técnico</label>
            <input type="text" name="responsible" placeholder="Ex: Dra. Letícia Ramos" class="w-full px-4 py-2.5 bg-white border border-brand-light/25 rounded-xl text-sm text-brand-dark placeholder-gray-400 focus:outline-none focus:ring-1 focus:ring-brand-gold focus:border-brand-gold" />
          </div>

          <div>
            <label class="block text-xs font-bold font-mono text-gray-600 uppercase mb-1">Sensor IoT Vinculado</label>
            <input type="text" name="sensor" placeholder="Ex: Sensor #A0982-Temp" class="w-full px-4 py-2.5 bg-white border border-brand-light/25 rounded-xl text-sm text-brand-dark placeholder-gray-400 focus:outline-none focus:ring-1 focus:ring-brand-gold focus:border-brand-gold" />
          </div>
        </div>

        <div class="grid grid-cols-3 gap-4 border-t border-brand-light/15 pt-4 bg-white">
          <div>
            <label class="block text-xs font-bold font-mono text-gray-600 uppercase mb-1">Temp. Mínima (°C)</label>
            <input type="number" step="0.1" name="minTemp" value="2.0" class="w-full px-4 py-2.5 bg-white border border-brand-light/25 rounded-xl text-sm text-brand-dark focus:outline-none focus:ring-1 focus:ring-brand-gold focus:border-brand-gold" />
          </div>
          <div>
            <label class="block text-xs font-bold font-mono text-gray-600 uppercase mb-1">Temp. Máxima (°C)</label>
            <input type="number" step="0.1" name="maxTemp" value="8.0" class="w-full px-4 py-2.5 bg-white border border-brand-light/25 rounded-xl text-sm text-brand-dark focus:outline-none focus:ring-1 focus:ring-brand-gold focus:border-brand-gold" />
          </div>
          <div>
            <label class="block text-xs font-bold font-mono text-gray-600 uppercase mb-1">Temp. Atual (°C)</label>
            <input type="number" step="0.1" name="currentTemp" value="4.5" class="w-full px-4 py-2.5 bg-white border border-brand-light/25 rounded-xl text-sm text-brand-dark focus:outline-none focus:ring-1 focus:ring-brand-gold focus:border-brand-gold" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold font-mono text-gray-600 uppercase mb-1">Insumos e Conteúdo Armazenado</label>
          <textarea name="content" rows="2" placeholder="Descreva os reagentes, vacinas ou controles armazenados para fins de auditoria de impacto em caso de quebra de temperatura." class="w-full px-4 py-3 bg-white border border-brand-light/25 rounded-xl text-sm text-brand-dark placeholder-gray-400 focus:outline-none focus:ring-1 focus:ring-brand-gold focus:border-brand-gold"></textarea>
        </div>

        <div class="flex justify-end gap-3 border-t border-brand-light/15 pt-4 bg-white">
          <button type="button" onclick="switchTab('tab-monitoramento')" class="px-5 py-2.5 bg-gray-100 hover:bg-gray-200 text-brand-dark font-mono text-xs uppercase tracking-wider rounded-xl transition-all font-bold">
            Cancelar
          </button>
          <button type="submit" class="px-5 py-2.5 bg-brand-gold hover:bg-[#b8945a] text-black font-bold rounded-xl text-xs font-mono uppercase tracking-wider transition-all shadow-sm">
            Salvar Equipamento
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ABA 4: FICHA DETALHADA DO EQUIPAMENTO (SELECIONADO) -->
  <div id="tab-ficha" class="hidden space-y-6">
    <div class="flex justify-between items-center bg-white p-4 rounded-2xl border border-brand-light/15 shadow-sm">
      <div class="flex items-center gap-3">
        <div id="ficha-icon" class="text-2xl w-12 h-12 bg-brand-softBg/50 rounded-xl flex items-center justify-center">❄️</div>
        <div>
          <h2 id="ficha-eq-name" class="text-xl font-extrabold text-brand-dark">Nome do Equipamento</h2>
          <p id="ficha-eq-code" class="text-xs font-mono text-gray-400 font-bold">Código do Equipamento</p>
        </div>
      </div>
      <div class="flex gap-2">
        <button onclick="switchTab('tab-monitoramento')" class="px-4 py-2 bg-white border border-brand-light/25 rounded-xl text-xs text-brand-dark font-mono font-bold hover:bg-gray-50 shadow-sm transition-all">
          ← Voltar para Lista
        </button>
        <button onclick="openAddReadingFromFicha()" class="px-4 py-2 bg-brand-gold text-black rounded-xl text-xs font-bold font-mono hover:bg-[#b8945a] shadow-md transition-all">
          + Nova Leitura
        </button>
      </div>
    </div>

    <!-- Abas Internas da Ficha -->
    <div class="flex border-b border-brand-light/15 gap-1 overflow-x-auto">
      <button onclick="switchFichaSubTab('subtab-geral')" id="btn-subtab-geral" class="px-4 py-2 border-b-2 border-brand-gold text-brand-gold font-mono text-[11px] uppercase tracking-wider font-bold transition-all whitespace-nowrap">
        📋 Geral
      </button>
      <button onclick="switchFichaSubTab('subtab-leituras')" id="btn-subtab-leituras" class="px-4 py-2 border-b-2 border-transparent text-gray-400 hover:text-brand-dark hover:border-brand-light/30 font-mono text-[11px] uppercase tracking-wider font-bold transition-all whitespace-nowrap">
        🌡️ Leituras
      </button>
      <button onclick="switchFichaSubTab('subtab-grafico')" id="btn-subtab-grafico" class="px-4 py-2 border-b-2 border-transparent text-gray-400 hover:text-brand-dark hover:border-brand-light/30 font-mono text-[11px] uppercase tracking-wider font-bold transition-all whitespace-nowrap">
        📈 Gráficos
      </button>
      <button onclick="switchFichaSubTab('subtab-ocorrencias')" id="btn-subtab-ocorrencias" class="px-4 py-2 border-b-2 border-transparent text-gray-400 hover:text-brand-dark hover:border-brand-light/30 font-mono text-[11px] uppercase tracking-wider font-bold transition-all whitespace-nowrap">
        ⚠️ Ocorrências
      </button>
      <button onclick="switchFichaSubTab('subtab-checklist')" id="btn-subtab-checklist" class="px-4 py-2 border-b-2 border-transparent text-gray-400 hover:text-brand-dark hover:border-brand-light/30 font-mono text-[11px] uppercase tracking-wider font-bold transition-all whitespace-nowrap">
        📝 Checklist
      </button>
      <button onclick="switchFichaSubTab('subtab-manutencao')" id="btn-subtab-manutencao" class="px-4 py-2 border-b-2 border-transparent text-gray-400 hover:text-brand-dark hover:border-brand-light/30 font-mono text-[11px] uppercase tracking-wider font-bold transition-all whitespace-nowrap">
        🔧 Manutenções
      </button>
      <button onclick="switchFichaSubTab('subtab-documentos')" id="btn-subtab-documentos" class="px-4 py-2 border-b-2 border-transparent text-gray-400 hover:text-brand-dark hover:border-brand-light/30 font-mono text-[11px] uppercase tracking-wider font-bold transition-all whitespace-nowrap">
        📁 Documentos
      </button>
      <button onclick="switchFichaSubTab('subtab-timeline')" id="btn-subtab-timeline" class="px-4 py-2 border-b-2 border-transparent text-gray-400 hover:text-brand-dark hover:border-brand-light/30 font-mono text-[11px] uppercase tracking-wider font-bold transition-all whitespace-nowrap">
        🕒 Histórico
      </button>
    </div>

    <!-- CONTEÚDO DAS SUBABAS DA FICHA -->

    <!-- SUBABA 1: INFORMAÇÕES GERAIS -->
    <div id="subtab-geral" class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="md:col-span-2 bg-white border border-brand-light/15 p-6 rounded-2xl space-y-6 shadow-sm">
        <h3 class="text-sm font-bold font-mono text-brand-gold uppercase tracking-wider">Ficha Técnica de Identificação</h3>
        <div class="grid grid-cols-2 gap-4 text-xs font-mono">
          <div>
            <span class="text-gray-400 font-bold block">Código Patrimonial:</span>
            <span id="f-patrimony" class="text-brand-dark font-extrabold text-sm">-</span>
          </div>
          <div>
            <span class="text-gray-400 font-bold block">Número de Série:</span>
            <span id="f-serial" class="text-brand-dark font-extrabold text-sm">-</span>
          </div>
          <div>
            <span class="text-gray-400 font-bold block">Fabricante / Marca:</span>
            <span id="f-brand" class="text-brand-dark font-extrabold text-sm">-</span>
          </div>
          <div>
            <span class="text-gray-400 font-bold block">Modelo Técnico:</span>
            <span id="f-model" class="text-brand-dark font-extrabold text-sm">-</span>
          </div>
          <div>
            <span class="text-gray-400 font-bold block">Setor de Operação:</span>
            <span id="f-sector" class="text-brand-dark font-extrabold text-sm">-</span>
          </div>
          <div>
            <span class="text-gray-400 font-bold block">Localização Física:</span>
            <span id="f-location" class="text-brand-dark font-extrabold text-sm">-</span>
          </div>
          <div>
            <span class="text-gray-400 font-bold block">Responsável pelo Controle:</span>
            <span id="f-responsible" class="text-brand-dark font-extrabold text-sm">-</span>
          </div>
          <div>
            <span class="text-gray-400 font-bold block">Sensor de Telemetria IoT:</span>
            <span id="f-sensor" class="text-brand-dark font-extrabold text-sm">-</span>
          </div>
        </div>

        <div class="border-t border-brand-light/15 pt-4">
          <span class="text-xs font-mono text-gray-400 font-bold uppercase block mb-1">Insumos e Materiais Guardados neste Equipamento:</span>
          <p id="f-content" class="text-sm text-gray-700 italic font-sans font-medium">Nenhum insumo declarado.</p>
        </div>
      </div>

      <!-- Card Lateral de Faixas Térmicas -->
      <div class="bg-white border border-brand-light/15 p-6 rounded-2xl flex flex-col justify-between space-y-6 shadow-sm">
        <div>
          <span class="text-xs font-bold font-mono text-brand-gold uppercase tracking-wider block mb-2">Segurança Térmica</span>
          <h4 class="text-sm font-bold text-brand-dark mb-4">Limites Operacionais de Temperatura</h4>
          <div class="grid grid-cols-2 gap-4 text-center">
            <div class="p-3 bg-brand-softBg/50 border border-brand-light/10 rounded-xl">
              <span class="text-[10px] font-bold font-mono text-gray-400 uppercase block">Mínima Admitida</span>
              <span id="f-min-temp" class="text-lg font-bold font-mono text-sky-600">0.0°C</span>
            </div>
            <div class="p-3 bg-brand-softBg/50 border border-brand-light/10 rounded-xl">
              <span class="text-[10px] font-bold font-mono text-gray-400 uppercase block">Máxima Admitida</span>
              <span id="f-max-temp" class="text-lg font-bold font-mono text-rose-600">0.0°C</span>
            </div>
          </div>
        </div>

        <div class="p-4 bg-brand-softBg/30 border border-brand-light/10 rounded-xl space-y-2">
          <div class="flex justify-between text-xs font-mono">
            <span class="text-gray-500 font-bold">Temperatura Atual:</span>
            <span id="f-curr-temp" class="text-brand-dark font-extrabold">0.0°C</span>
          </div>
          <div class="flex justify-between text-xs font-mono">
            <span class="text-gray-500 font-bold">Última Leitura:</span>
            <span id="f-last-time" class="text-gray-700 font-bold">-</span>
          </div>
          <div class="flex justify-between text-xs font-mono">
            <span class="text-gray-500 font-bold">Faixa de Operação:</span>
            <span id="f-status-badge" class="text-emerald-700 font-bold">-</span>
          </div>
        </div>

        <!-- Botão para Deletar ou Editar Equipamento -->
        <div class="flex gap-2 pt-2 border-t border-brand-light/15">
          <button onclick="openEditEquipmentModal()" class="flex-1 py-2 bg-white border border-brand-light/25 rounded-xl text-xs font-mono font-bold text-brand-dark hover:bg-gray-50 text-center uppercase tracking-wider shadow-sm">
            Editar Ficha
          </button>
          <form id="delete-eq-form" action="/admin/temperaturas/delete-equipamento" method="POST" onsubmit="return confirm('Deseja realmente remover este equipamento do monitoramento permanente?');" class="flex-1">
            <input type="hidden" name="id" id="delete-eq-id" />
            <button type="submit" class="w-full py-2 bg-rose-50 border border-rose-200 rounded-xl text-xs font-mono font-bold text-rose-700 hover:bg-rose-100 text-center uppercase tracking-wider">
              Excluir
            </button>
          </form>
        </div>
      </div>
    </div>

    <!-- SUBABA 2: LEITURAS -->
    <div id="subtab-leituras" class="hidden space-y-4">
      <div class="flex justify-between items-center">
