  // Gráficos - Renderização dinâmica via Chart.js
  function renderFichaChart(period) {
    if (!selectedEquipment) return;
    
    const ctx = document.getElementById('fichaChart').getContext('2d');
    
    if (activeFichaChart) {
      activeFichaChart.destroy();
    }

    // Gerar labels e dados com base no período e leituras do equipamento
    let labels = [];
    let temps = [];
    const minLine = [];
    const maxLine = [];

    const minT = selectedEquipment.minTemp;
    const maxT = selectedEquipment.maxTemp;

    if (period === 'diario') {
      // Usar leituras reais recentes ou sementes dinâmicas baseadas nas últimas leituras
      const readings = (selectedEquipment.readings || []).slice(0, 10).reverse();
      if (readings.length > 0) {
        readings.forEach(r => {
          labels.push(r.time || '—');
          temps.push(r.temp);
          minLine.push(minT);
          maxLine.push(maxT);
        });
      } else {
        // Mock se vazio
        labels = ["08:00", "10:00", "12:00", "14:00", "16:00", "18:00"];
        temps = [4.2, 4.5, 5.0, 4.8, 4.1, 4.3];
        labels.forEach(() => { minLine.push(minT); maxLine.push(maxT); });
      }
    } else if (period === 'semanal') {
      labels = ["Seg", "Ter", "Qua", "Qui", "Sex", "Sáb", "Dom"];
      temps = [4.1, 4.3, 4.2, 4.8, 5.2, 4.5, 4.1];
      // Ajuste se freezer
      if (selectedEquipment.type.includes('Freezer')) {
        temps = [-21.2, -22.0, -21.8, -19.5, -20.4, -22.1, -21.9];
      }
      labels.forEach(() => { minLine.push(minT); maxLine.push(maxT); });
    } else if (period === 'mensal') {
      labels = ["Semana 1", "Semana 2", "Semana 3", "Semana 4"];
      temps = [4.3, 4.2, 4.7, 4.1];
      if (selectedEquipment.type.includes('Freezer')) {
        temps = [-21.5, -22.0, -21.1, -22.2];
      }
      labels.forEach(() => { minLine.push(minT); maxLine.push(maxT); });
    }

    activeFichaChart = new Chart(ctx, {
      type: 'line',
      data: {
        labels: labels,
        datasets: [
          {
            label: 'Temperatura Registrada (°C)',
            data: temps,
            borderColor: '#DAA520', // Dourado
            backgroundColor: 'rgba(218, 165, 32, 0.05)',
            borderWidth: 3,
            tension: 0.3,
            fill: true,
            pointBackgroundColor: '#DAA520',
            pointRadius: 4
          },
          {
            label: 'Limite Mínimo Seguro',
            data: minLine,
            borderColor: 'rgba(56, 189, 248, 0.5)', // Azul
            borderWidth: 1.5,
            borderDash: [5, 5],
            pointRadius: 0,
            fill: false
          },
          {
            label: 'Limite Máximo Seguro',
            data: maxLine,
            borderColor: 'rgba(244, 63, 94, 0.5)', // Vermelho
            borderWidth: 1.5,
            borderDash: [5, 5],
            pointRadius: 0,
            fill: false
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            labels: {
              color: '#374151', // text-gray-700
              font: { family: 'JetBrains Mono', size: 10 }
            }
          }
        },
        scales: {
          x: {
            grid: { color: 'rgba(0, 0, 0, 0.05)' },
            ticks: { color: '#6b7280', font: { family: 'JetBrains Mono', size: 10 } }
          },
          y: {
            grid: { color: 'rgba(0, 0, 0, 0.05)' },
            ticks: { color: '#6b7280', font: { family: 'JetBrains Mono', size: 10 } }
          }
        }
      }
    });
  }

  // Lógica de Gráficos do Painel de Evolução (Todos os Equipamentos)
  let activeEvolutionCharts = {};
  let currentEvolutionPeriod = 'diario';

  function setEvolutionPeriod(period) {
    currentEvolutionPeriod = period;
    
    // Atualizar estado ativo dos botões de período
    const periods = ['diario', 'semanal', 'mensal'];
    periods.forEach(p => {
      const btn = document.getElementById('btn-ev-' + p);
      if (btn) {
        if (p === period) {
          btn.className = "px-3 py-1.5 rounded-lg text-[10px] font-mono font-bold uppercase tracking-wider transition-all bg-brand-gold text-black";
        } else {
          btn.className = "px-3 py-1.5 rounded-lg text-[10px] font-mono font-bold uppercase tracking-wider transition-all text-gray-500 hover:text-brand-dark";
        }
      }
    });

    renderAllEvolutionCharts();
  }

  function renderAllEvolutionCharts() {
    dbEquipments.forEach(eq => {
      const canvasId = 'evolutionChart-' + eq.id;
      const canvas = document.getElementById(canvasId);
      if (!canvas) return;

      const ctx = canvas.getContext('2d');

      // Destruir gráfico anterior se existir
      if (activeEvolutionCharts[eq.id]) {
        activeEvolutionCharts[eq.id].destroy();
      }

      let labels = [];
      let temps = [];
      const minLine = [];
      const maxLine = [];

      const minT = parseFloat(eq.minTemp);
      const maxT = parseFloat(eq.maxTemp);

      if (currentEvolutionPeriod === 'diario') {
        const readings = (eq.readings || []).slice(0, 10).reverse();
        if (readings.length > 0) {
          readings.forEach(r => {
            labels.push(r.time || '—');
            temps.push(parseFloat(r.temp));
            minLine.push(minT);
            maxLine.push(maxT);
          });
        } else {
          labels = ["08:00", "10:00", "12:00", "14:00", "16:00", "18:00"];
          temps = [
            parseFloat(eq.currentTemp) - 0.3,
            parseFloat(eq.currentTemp) + 0.1,
            parseFloat(eq.currentTemp) + 0.5,
            parseFloat(eq.currentTemp) + 0.2,
            parseFloat(eq.currentTemp) - 0.4,
            parseFloat(eq.currentTemp)
          ];
          labels.forEach(() => { minLine.push(minT); maxLine.push(maxT); });
        }
      } else if (currentEvolutionPeriod === 'semanal') {
        labels = ["Seg", "Ter", "Qua", "Qui", "Sex", "Sáb", "Dom"];
        temps = [
          minT + 1.2,
          minT + 1.8,
          minT + 1.5,
          minT + 2.1,
          minT + 2.5,
          minT + 1.9,
          minT + 1.4
        ];
        if (eq.type.includes('Freezer')) {
          temps = [
            parseFloat(eq.currentTemp) - 0.5,
            parseFloat(eq.currentTemp) - 1.2,
            parseFloat(eq.currentTemp) + 0.3,
            parseFloat(eq.currentTemp) - 0.8,
            parseFloat(eq.currentTemp) + 1.1,
            parseFloat(eq.currentTemp) - 0.4,
            parseFloat(eq.currentTemp)
          ];
        }
        labels.forEach(() => { minLine.push(minT); maxLine.push(maxT); });
      } else if (currentEvolutionPeriod === 'mensal') {
        labels = ["Semana 1", "Semana 2", "Semana 3", "Semana 4"];
        temps = [minT + 1.5, minT + 1.3, minT + 2.2, minT + 1.4];
        if (eq.type.includes('Freezer')) {
          temps = [
            parseFloat(eq.currentTemp) - 0.5,
            parseFloat(eq.currentTemp) + 0.8,
            parseFloat(eq.currentTemp) - 0.3,
            parseFloat(eq.currentTemp)
          ];
        }
        labels.forEach(() => { minLine.push(minT); maxLine.push(maxT); });
      }

      // Filtrar leituras válidas para as estatísticas
      const validTemps = temps.filter(t => !isNaN(t));
      const minVal = validTemps.length > 0 ? Math.min(...validTemps) : 0;
      const maxVal = validTemps.length > 0 ? Math.max(...validTemps) : 0;
      
      const statMinMax = document.getElementById('ev-stat-minmax-' + eq.id);
      if (statMinMax) {
        statMinMax.innerText = `${minVal.toFixed(1)}°C / ${maxVal.toFixed(1)}°C`;
      }

      // Estabilidade das leituras
      let stableCount = 0;
      validTemps.forEach(t => {
        if (t >= minT && t <= maxT) stableCount++;
      });
      const stabilityPct = validTemps.length > 0 ? Math.round((stableCount / validTemps.length) * 100) : 100;
      
      const statStatus = document.getElementById('ev-stat-status-' + eq.id);
      if (statStatus) {
        statStatus.innerText = `${stabilityPct}% Estável`;
        if (stabilityPct >= 95) {
          statStatus.className = "font-bold text-emerald-600";
        } else if (stabilityPct >= 80) {
          statStatus.className = "font-bold text-amber-600";
        } else {
          statStatus.className = "font-bold text-rose-600";
        }
      }

      // Instanciação do Gráfico
      activeEvolutionCharts[eq.id] = new Chart(ctx, {
        type: 'line',
        data: {
          labels: labels,
          datasets: [
            {
              label: 'Temperatura Lida (°C)',
              data: temps,
              borderColor: '#DAA520', // Brand gold
              backgroundColor: 'rgba(218, 165, 32, 0.05)',
              borderWidth: 2.5,
              tension: 0.3,
              fill: true,
              pointBackgroundColor: '#DAA520',
              pointRadius: 3
            },
            {
              label: 'Limite Mínimo',
              data: minLine,
              borderColor: 'rgba(56, 189, 248, 0.55)', // Azul
              borderWidth: 1.2,
              borderDash: [4, 4],
              pointRadius: 0,
              fill: false
            },
            {
              label: 'Limite Máximo',
              data: maxLine,
              borderColor: 'rgba(244, 63, 94, 0.55)', // Vermelho
              borderWidth: 1.2,
              borderDash: [4, 4],
              pointRadius: 0,
              fill: false
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              display: true,
              position: 'top',
              labels: {
                color: '#374151', // text-gray-700
                font: { family: 'Inter, sans-serif', size: 9 },
                boxWidth: 10,
                padding: 4
              }
            },
            tooltip: {
              callbacks: {
                label: function(context) {
                  return ` ${context.parsed.y.toFixed(1)} °C`;
                }
              }
            }
          },
          scales: {
            x: {
              grid: { color: 'rgba(0, 0, 0, 0.04)' },
              ticks: { color: '#6b7280', font: { family: 'JetBrains Mono', size: 9 } }
            },
            y: {
              grid: { color: 'rgba(0, 0, 0, 0.04)' },
              ticks: { color: '#6b7280', font: { family: 'JetBrains Mono', size: 9 } }
            }
          }
        }
      });
    });
  }

  // Ocorrência - Resolver Ocorrência Modal
  function openResolveOccModal(eqId, occIdx, reason, details) {
    document.getElementById('resolve-eq-id').value = eqId;
    document.getElementById('resolve-occ-idx').value = occIdx;
    document.getElementById('resolve-occ-reason').innerText = reason;
    document.getElementById('resolve-occ-details').innerText = details;
    document.getElementById('resolveOccModal').classList.remove('hidden');
  }

  function closeResolveOccModal() {
    document.getElementById('resolveOccModal').classList.add('hidden');
  }

  // Ocorrência Manual Modal
  function openOccurrenceModal() {
    if (!selectedEquipment) return;
    document.getElementById('modal-occ-eq-id').value = selectedEquipment.id;
    document.getElementById('modal-occ-temp').value = selectedEquipment.currentTemp;
    document.getElementById('modal-occ-date').value = new Date().toLocaleDateString('pt-BR');
    document.getElementById('occModal').classList.remove('hidden');
  }

  function closeOccurrenceModal() {
    document.getElementById('occModal').classList.add('hidden');
  }

  // Manutenção Modal
  function openMaintenanceModal() {
    if (!selectedEquipment) return;
    document.getElementById('modal-maint-eq-id').value = selectedEquipment.id;
    document.getElementById('modal-maint-date').value = new Date().toLocaleDateString('pt-BR');
    document.getElementById('maintModal').classList.remove('hidden');
  }

  function closeMaintenanceModal() {
    document.getElementById('maintModal').classList.add('hidden');
  }

  // Documento Modal
  function openDocumentModal() {
    if (!selectedEquipment) return;
    document.getElementById('modal-doc-eq-id').value = selectedEquipment.id;
    document.getElementById('modal-doc-date').value = new Date().toLocaleDateString('pt-BR');
    document.getElementById('docModal').classList.remove('hidden');
  }

  function closeDocumentModal() {
    document.getElementById('docModal').classList.add('hidden');
  }

  // Editar Equipamento Ficha Modal
  function openEditEquipmentModal() {
    if (!selectedEquipment) return;
    
    const eq = selectedEquipment;
    document.getElementById('edit-eq-id').value = eq.id;
    document.getElementById('edit-eq-name').value = eq.name;
    document.getElementById('edit-eq-code').value = eq.code;
    document.getElementById('edit-eq-type').value = eq.type;
    document.getElementById('edit-eq-brand').value = eq.brand || '';
    document.getElementById('edit-eq-model').value = eq.model || '';
    document.getElementById('edit-eq-serial').value = eq.serialNumber || '';
    document.getElementById('edit-eq-patrimony').value = eq.patrimony || '';
    document.getElementById('edit-eq-sector').value = eq.sector || '';
    document.getElementById('edit-eq-location').value = eq.location || '';
    document.getElementById('edit-eq-responsible').value = eq.responsible || '';
    document.getElementById('edit-eq-sensor').value = eq.sensor || '';
    document.getElementById('edit-eq-min-temp').value = eq.minTemp;
    document.getElementById('edit-eq-max-temp').value = eq.maxTemp;
    document.getElementById('edit-eq-content').value = eq.content || '';

    document.getElementById('editEquipmentModal').classList.remove('hidden');
  }

  function closeEditEquipmentModal() {
    document.getElementById('editEquipmentModal').classList.add('hidden');
  }

  // Verificar se há redirecionamento para abrir ficha específica
  window.addEventListener('DOMContentLoaded', () => {
    const urlParams = new URLSearchParams(window.location.search);
    const eqId = urlParams.get('eqId');
    if (eqId) {
      viewEquipmentFicha(eqId);
    }
  });
</script>

