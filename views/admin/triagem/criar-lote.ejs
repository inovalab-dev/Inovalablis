        <!-- Lista de Exames (SEM COLLAPSE - SEMPRE VISÍVEL) -->
        <div class="p-3 space-y-2 bg-white">
          ${examsListHtml}
        </div>
      </div>
    `;
  }

  // Toggle Checkboxes do Paciente
  function togglePatientExamsCheckboxes(patientCb, reqId, lab) {
    const card = patientCb.closest('.patient-lote-card');
    if (!card) return;
    const isChecked = patientCb.checked;
    const examCbs = card.querySelectorAll(`.exam-lote-checkbox[data-lab="${lab}"]:not([disabled])`);
    examCbs.forEach(cb => { cb.checked = isChecked; });
  }

  // Selecionar Todos da Coluna
  function selectAllColumn(lab) {
    const container = document.getElementById(`container-pacientes-${lab}`);
    if (!container) return;
    const patientCbs = container.querySelectorAll('.patient-lote-checkbox');
    const examCbs = container.querySelectorAll(`.exam-lote-checkbox[data-lab="${lab}"]:not([disabled])`);
    
    // Toggle state: if all are checked, uncheck; otherwise check all
    const allChecked = Array.from(examCbs).every(cb => cb.checked);
    patientCbs.forEach(cb => { cb.checked = !allChecked; });
    examCbs.forEach(cb => { cb.checked = !allChecked; });

    showToast(allChecked ? `Exames do ${lab.toUpperCase()} desmarcados.` : `Todos exames do ${lab.toUpperCase()} selecionados.`, 'info');
  }

  // Filtrar Lotes por Busca ou Estado
  function filterLotes() {
    const query = (document.getElementById('searchInput')?.value || '').toLowerCase().trim();
    const filterLoteVal = document.getElementById('loteFilterSelect')?.value || 'todos';

    const cards = document.querySelectorAll('.patient-lote-card');
    cards.forEach(card => {
      const searchData = card.dataset.search || '';
      const matchesSearch = query === '' || searchData.includes(query);

      let matchesLoteFilter = true;
      const examCbs = card.querySelectorAll('.exam-lote-checkbox');
      const hasDisabled = Array.from(examCbs).some(cb => cb.disabled);

      if (filterLoteVal === 'sem_lote') {
        matchesLoteFilter = Array.from(examCbs).some(cb => !cb.disabled);
      } else if (filterLoteVal === 'com_lote') {
        matchesLoteFilter = hasDisabled;
      }

      if (matchesSearch && matchesLoteFilter) {
        card.style.display = '';
      } else {
        card.style.display = 'none';
      }
    });
  }

  // Trigger Gerar Lote Modal
  function triggerGerarLote(lab) {
    currentTargetLab = lab;
    currentSelectedItems = [];

    const container = document.getElementById(`container-pacientes-${lab}`);
    if (!container) return;

    const checkedExams = container.querySelectorAll(`.exam-lote-checkbox[data-lab="${lab}"]:checked:not([disabled])`);
    
    if (checkedExams.length === 0) {
      showAlertDialog('Nenhum Exame Selecionado', `Por favor, selecione ao menos um exame pendente do laboratório ${lab.toUpperCase()} para gerar o lote.`);
      return;
    }

    const patientMap = new Map();

    checkedExams.forEach(cb => {
      const reqId = cb.dataset.reqId;
      const examCode = cb.dataset.examCode;
      
      currentSelectedItems.push({ requisitionId: reqId, examCode: examCode });

      const card = cb.closest('.patient-lote-card');
      const patientName = card ? (card.querySelector('h3')?.textContent || 'Paciente') : 'Paciente';

      if (!patientMap.has(reqId)) {
        patientMap.set(reqId, { patientName, reqId, exams: [] });
      }
      patientMap.get(reqId).exams.push(examCode);
    });

    const isAlvaro = lab === 'alvaro';
    const labName = isAlvaro ? 'Laboratório Álvaro (Apoio External)' : 'Laboratório Pardini (Apoio External)';

    document.getElementById('modal-lote-lab-name').textContent = labName;
    document.getElementById('modal-lote-pacientes-count').textContent = patientMap.size;
    document.getElementById('modal-lote-exames-count').textContent = currentSelectedItems.length;

    const itemsListContainer = document.getElementById('modal-lote-items-list');
    itemsListContainer.innerHTML = '';

    patientMap.forEach(pData => {
      itemsListContainer.innerHTML += `
        <div class="p-2 bg-slate-50 border border-slate-200 rounded-lg flex items-center justify-between text-xs">
          <div>
            <span class="font-extrabold text-slate-900">${pData.patientName}</span>
            <span class="text-slate-500 text-[10px]"> (#${pData.reqId})</span>
          </div>
          <span class="font-bold text-amber-700 bg-amber-50 px-2 py-0.5 rounded border border-amber-200 text-[10px]">
            ${pData.exams.length} ${pData.exams.length === 1 ? 'exame' : 'exames'} (${pData.exams.join(', ')})
          </span>
        </div>
      `;
    });

    document.getElementById('modal-gerar-lote').classList.remove('hidden');
  }

  function closeLoteModal() {
    document.getElementById('modal-gerar-lote').classList.add('hidden');
  }

  // Processar Criação do Lote
  function processGerarLote(andPrint) {
    if (!currentTargetLab || currentSelectedItems.length === 0) return;

    fetch('/admin/triagem/gerar-lote', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        lab: currentTargetLab,
        items: currentSelectedItems
      })
    })
    .then(res => res.json())
    .then(resData => {
      if (resData.success) {
        closeLoteModal();
        showToast(`Lote ${resData.batchCode} gerado com sucesso para ${resData.lab}!`, 'success');

        // Atualizar estado local de exames
        const requisitions = window.TRIAGEM_REQUISITIONS || [];
        const affectedReqs = new Set();
        currentSelectedItems.forEach(item => {
          const req = requisitions.find(r => (r.requisitionCode || r.id) === item.requisitionId || r.id === item.requisitionId);
          if (req && Array.isArray(req.exams)) {
            const ex = req.exams.find(e => (e.code || e.codigo) === item.examCode);
            if (ex) {
              ex.idLote = resData.batchCode;
              ex.loteCode = resData.batchCode;
              ex.loteStatus = 'Lote criado';
              ex.status = 'Lote criado';
            }
            affectedReqs.add(req);
          }
        });

        affectedReqs.forEach(req => {
          if (req && Array.isArray(req.exams) && req.exams.length > 0) {
            const allInLote = req.exams.every(e => 
              e.status === 'Lote criado' || e.loteStatus === 'Lote criado' || e.loteStatus === 'Gerado' || !!e.loteCode || !!e.idLote
            );
            if (allInLote) {
              req.status = 'Lote criado';
              req.loteStatus = 'Lote criado';
            }
          }
        });

        renderCriarLoteScreen();

        if (andPrint) {
          printLoteManifest(resData.batchCode, resData.lab, currentSelectedItems);
        }
      } else {
        showToast(resData.message || 'Erro ao gerar lote.', 'error');
      }
    })
    .catch(err => {
      console.error('Erro ao gerar lote:', err);
      showToast('Erro ao comunicar com o servidor.', 'error');
    });
  }

