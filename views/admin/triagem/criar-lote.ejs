<!-- Floating Toast Container -->
<div id="toast-container" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 max-w-sm pointer-events-none"></div>

<!-- Client Logic JS -->
<script>
  let currentXmlText = '';

  function escapeXmlAttr(str) {
    return String(str || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&apos;');
  }

  function formatPatientBirthDate(bdate) {
    if (!bdate) return '1991-01-01';
    if (/^\d{4}-\d{2}-\d{2}$/.test(bdate)) return bdate;
    const d = new Date(bdate);
    if (isNaN(d.getTime())) {
      const parts = String(bdate).split('/');
      if (parts.length === 3) {
        return `${parts[2]}-${parts[1].padStart(2, '0')}-${parts[0].padStart(2, '0')}`;
      }
      return '1991-01-01';
    }
    const year = d.getFullYear();
    const month = String(d.getMonth() + 1).padStart(2, '0');
    const day = String(d.getDate()).padStart(2, '0');
    return `${year}-${month}-${day}`;
  }

  function formatPatientSexo(sex) {
    if (!sex) return 'F';
    const s = String(sex).trim().toUpperCase();
    if (s.startsWith('F') || s.includes('FEM')) return 'F';
    if (s.startsWith('M') || s.includes('MASC')) return 'M';
    return 'F';
  }

  function formatPatientCpf(cpf) {
    if (!cpf) return '345.678.901-22';
    const str = String(cpf).trim();
    return str || '345.678.901-22';
  }

  function openXmlAlvaroModal(defaultTab) {
    const btnAlvaro = document.getElementById('btn-criar-lote-alvaro');
    if (btnAlvaro && btnAlvaro.disabled) {
      showToast('Nenhuma requisição triada para o Apoio Álvaro para criar o lote.', 'error');
      return;
    }

    const modal = document.getElementById('modal-xml-alvaro');
    const container = document.getElementById('container-pacientes-alvaro');
    
    let selectedReqIds = new Set();
    if (container) {
      const checkedExams = container.querySelectorAll('.exam-lote-checkbox[data-lab="alvaro"]:checked:not([disabled])');
      checkedExams.forEach(cb => {
        if (cb.dataset.reqId) selectedReqIds.add(cb.dataset.reqId);
      });
    }

    const requisitions = window.TRIAGEM_REQUISITIONS || [];
    const patientsList = window.TRIAGEM_PATIENTS || [];
    let selectedReqs = requisitions.filter(r => selectedReqIds.has(String(r.requisitionCode || r.id)) || selectedReqIds.has(String(r.id)));

    if (selectedReqs.length === 0) {
      selectedReqs = requisitions.filter(r => {
        const isRTriado = String(r.status || '').trim().toLowerCase().includes('triad') || r.triado === true || String(r.triado) === 'true';
        const triados = (r.exams || []).filter(e => {
          const eStatus = String(e.status || '').trim().toLowerCase();
          return isRTriado || eStatus.includes('triad') || e.triado === true || String(e.triado) === 'true';
        });
        return triados.some(e => getExamDestinationLab(e) === 'alvaro');
      });
    }

    const patientMap = new Map();
    selectedReqs.forEach(req => {
      const matched = patientsList.find(p => {
        if (req.patientId && (p.id === req.patientId || p.code === String(req.patientId).replace(/^PAC-/, ''))) return true;
        if (req.patientCode && (String(p.code) === String(req.patientCode) || p.id === 'PAC-' + req.patientCode || p.id === req.patientCode)) return true;
        if (req.patientName && p.name && p.name.trim().toLowerCase() === req.patientName.trim().toLowerCase()) return true;
        return false;
      }) || {};

      const code = String(matched.code || (req.patientCode ? String(req.patientCode).replace(/^PAC-/, '') : '') || (req.patientId ? String(req.patientId).replace(/^PAC-/, '') : '') || '3');
      
      if (!patientMap.has(code)) {
        const datanasc = formatPatientBirthDate(matched.birthDate || req.patientBirthDate || req.birthDate || req.dataNasc);
        const nome = (matched.name || req.patientName || req.nome || 'Ana Paula Mendes').trim();
        const nomeSocial = (matched.socialName || matched.name || req.patientSocialName || req.nomeSocial || req.patientName || 'Ana Paula Mendes').trim();
        const sexo = formatPatientSexo(matched.gender || matched.biologicalSex || req.patientSex || req.patientGender || req.sexo);
        const cpf = formatPatientCpf(matched.cpf || req.patientCpf || req.cpf);
        const email = (matched.email || req.patientEmail || req.email || 'ana.mendes@email.com').trim();

        patientMap.set(code, {
          codigolis: code,
          datanasc,
          nome,
          nomeSocial,
          sexo,
          cpf,
          email
        });
      }
    });

    let patientsXml = '';
    if (patientMap.size > 0) {
      patientsXml = Array.from(patientMap.values()).map(p => {
        return `            <paciente codigolis="${escapeXmlAttr(p.codigolis)}" datanasc="${escapeXmlAttr(p.datanasc)}" nome="${escapeXmlAttr(p.nome)}" nomeSocial="${escapeXmlAttr(p.nomeSocial)}" sexo="${escapeXmlAttr(p.sexo)}" cpf="${escapeXmlAttr(p.cpf)}" email="${escapeXmlAttr(p.email)}"/>`;
      }).join('\n');
    } else {
      patientsXml = `            <paciente codigolis="3" datanasc="1994-11-03" nome="Ana Paula Mendes" nomeSocial="Ana Paula Mendes" sexo="F" cpf="345.678.901-22" email="ana.mendes@email.com"/>`;
    }

    // Processamento Dinâmico dos Médicos das Requisições
    const medicosList = window.TRIAGEM_MEDICOS || [];
    const medicoMap = new Map();

    selectedReqs.forEach(req => {
      let rawName = (req.doctorName || '').trim();
      let rawCrm = (req.doctorCrm || '').trim();
      let rawUf = (req.doctorUf || 'PR').trim();

      // Busca correspondência no cadastro de médicos
      let matched = null;
      if (rawName) {
        matched = medicosList.find(m => m.nome && m.nome.toLowerCase() === rawName.toLowerCase());
      }
      if (!matched && rawCrm) {
        matched = medicosList.find(m => m.numero && String(m.numero).trim() === rawCrm);
      }
      if (!matched && rawName) {
        matched = medicosList.find(m => m.nome && (rawName.toLowerCase().includes(m.nome.toLowerCase()) || m.nome.toLowerCase().includes(rawName.toLowerCase())));
      }

      let finalName = matched ? matched.nome : rawName;
      let finalCrmNum = matched ? matched.numero : rawCrm;
      let finalUf = matched ? matched.uf : rawUf;

      // Limpeza se houver sufixos "(CRM 12345/PR)" no nome do médico
      if (finalName && finalName.includes('(') && finalName.includes(')')) {
        const crmMatch = finalName.match(/\((?:CRM|CRO|CRBM|CRN|CRV)?\s*([\d\.\-]+)\/([A-Z]{2})\)/i);
        if (crmMatch) {
          if (!finalCrmNum) finalCrmNum = crmMatch[1];
          if (!finalUf) finalUf = crmMatch[2];
        }
        finalName = finalName.replace(/\s*\([^)]*\)/, '').trim();
      }

      if (!finalName) finalName = 'Dr. Fernando Ribeiro';
      if (!finalCrmNum) finalCrmNum = '45678';
      if (!finalUf) finalUf = 'PR';

      const crmString = `${finalCrmNum}-${finalUf}`;
      const key = `${crmString}_${finalName}`;

      if (!medicoMap.has(key)) {
        medicoMap.set(key, {
          crm: crmString,
          nome: finalName
        });
      }
    });

    let medicosXml = '';
    if (medicoMap.size > 0) {
      medicosXml = Array.from(medicoMap.values()).map(m => {
        return `            <medico crm="${escapeXmlAttr(m.crm)}" nome="${escapeXmlAttr(m.nome)}"/>`;
      }).join('\n');
    } else {
      medicosXml = `            <medico crm="45678-PR" nome="Dr. Fernando Ribeiro"/>`;
    }

    function formatReqData(req) {
      if (req.createdAt) {
        const match = String(req.createdAt).match(/(\d{2})\/(\d{2})\/(\d{4})(?:,\s*(\d{2}):(\d{2}))?/);
        if (match) {
          const [, d, m, y, h = '00', min = '00'] = match;
          return `${y}-${m}-${d}-${h}:${min}`;
        }
        const dt = new Date(req.createdAt);
        if (!isNaN(dt.getTime())) {
          const y = dt.getFullYear();
          const m = String(dt.getMonth() + 1).padStart(2, '0');
          const d = String(dt.getDate()).padStart(2, '0');
          const h = String(dt.getHours()).padStart(2, '0');
          const min = String(dt.getMinutes()).padStart(2, '0');
          return `${y}-${m}-${d}-${h}:${min}`;
        }
      }
      if (req.fatura) {
        const match = String(req.fatura).match(/(\d{2})\/(\d{2})\/(\d{4})/);
        if (match) {
          const [, d, m, y] = match;
          const horaStr = req.hora || '08:00';
          const [h = '08', min = '00'] = horaStr.split(':');
          return `${y}-${m}-${d}-${h.padStart(2, '0')}:${min.padStart(2, '0')}`;
        }
      }
      const now = new Date();
      const y = now.getFullYear();
      const m = String(now.getMonth() + 1).padStart(2, '0');
      const d = String(now.getDate()).padStart(2, '0');
      const h = String(now.getHours()).padStart(2, '0');
      const min = String(now.getMinutes()).padStart(2, '0');
      return `${y}-${m}-${d}-${h}:${min}`;
    }

    function formatReqDataColeta(req) {
      let raw = req.collectedAt || req.dataColeta || req.triadoAt || req.updatedAt || req.createdAt;
      let dt;
      if (raw) {
        if (typeof raw === 'string' && raw.includes('/')) {
          const match = raw.match(/(\d{2})\/(\d{2})\/(\d{4})(?:,\s*(\d{2}):(\d{2})(?::(\d{2}))?)?/);
          if (match) {
            const [, d, m, y, h = '00', min = '00', s = '00'] = match;
            dt = new Date(`${y}-${m}-${d}T${h}:${min}:${s}`);
          }
        }
        if (!dt || isNaN(dt.getTime())) {
          dt = new Date(raw);
        }
      }
      if (!dt || isNaN(dt.getTime())) dt = new Date();

      const y = dt.getFullYear();
      const m = String(dt.getMonth() + 1).padStart(2, '0');
      const d = String(dt.getDate()).padStart(2, '0');
      const h = String(dt.getHours()).padStart(2, '0');
      const min = String(dt.getMinutes()).padStart(2, '0');
      const sec = String(dt.getSeconds()).padStart(2, '0');
      const ms = String(dt.getMilliseconds()).padStart(3, '0');

      return `${y}-${m}-${d}T${h}:${min}:${sec}.${ms}-03:00`;
    }

    let solicitacoesXml = '';
    if (selectedReqs.length > 0) {
      solicitacoesXml = selectedReqs.map(req => {
    const codigolis = buildReqCodigolis(req);
        
        const patientList = window.TRIAGEM_PATIENTS || [];
        const rawPName = (req.patientName || '').trim().toLowerCase();
        const matchedP = patientList.find(p => p.nome && p.nome.toLowerCase() === rawPName);
        const codigopaciente = String((matchedP && matchedP.codigo) || req.patientCode || req.patientId || '1').replace(/^PAC-/, '');

        let rawName = (req.doctorName || '').trim();
        let rawCrm = (req.doctorCrm || '').trim();
        let rawUf = (req.doctorUf || 'PR').trim();

        let matchedMed = null;
        if (rawName) {
          matchedMed = medicosList.find(m => m.nome && m.nome.toLowerCase() === rawName.toLowerCase());
        }
        if (!matchedMed && rawCrm) {
          matchedMed = medicosList.find(m => m.numero && String(m.numero).trim() === rawCrm);
        }
        if (!matchedMed && rawName) {
          matchedMed = medicosList.find(m => m.nome && (rawName.toLowerCase().includes(m.nome.toLowerCase()) || m.nome.toLowerCase().includes(rawName.toLowerCase())));
        }

        let finalCrmNum = matchedMed ? matchedMed.numero : rawCrm;
        let finalUf = matchedMed ? matchedMed.uf : rawUf;

        if (rawName && rawName.includes('(') && rawName.includes(')')) {
          const crmMatch = rawName.match(/\((?:CRM|CRO|CRBM|CRN|CRV)?\s*([\d\.\-]+)\/([A-Z]{2})\)/i);
          if (crmMatch) {
            if (!finalCrmNum) finalCrmNum = crmMatch[1];
            if (!finalUf) finalUf = crmMatch[2];
          }
        }

        if (!finalCrmNum) finalCrmNum = '45678';
        if (!finalUf) finalUf = 'PR';
        const doctorCrmStr = `${finalCrmNum}-${finalUf}`;

        const dataStr = formatReqData(req);
        const dataColetaStr = formatReqDataColeta(req);
        const postoDeColeta = "MATRIZ";

        let examesXml = '';
        if (Array.isArray(req.exams) && req.exams.length > 0) {
          examesXml = req.exams.map(ex => {
            const supportInfo = getSupportLabExamInfo(ex, 'alvaro');
            const matInfo = getSupportLabMaterialInfo(ex, 'alvaro');

            const exCode = supportInfo.code;
            const exDesc = matInfo.desc;
            const exMaterialCode = matInfo.code;

            return `            <amostra descricao="${escapeXmlAttr(exDesc)}" codigoBarras="" material="${escapeXmlAttr(exMaterialCode)}">
                <exame codigo="${escapeXmlAttr(exCode)}" dadosadicionais="" urgente="false"/>
            </amostra>`;
          }).join('\n');
        } else {
          examesXml = `            <amostra descricao="Soro" codigoBarras="" material="543">
                <exame codigo="TSH04" dadosadicionais="" urgente="false"/>
            </amostra>`;
        }

        return `        <solicitacao codigolis="${escapeXmlAttr(codigolis)}" codigopaciente="${escapeXmlAttr(codigopaciente)}" crm="${escapeXmlAttr(doctorCrmStr)}" data="${escapeXmlAttr(dataStr)}" dataColeta="${escapeXmlAttr(dataColetaStr)}" postoDeColeta="${postoDeColeta}">
${examesXml}
        </solicitacao>`;
      }).join('\n');
    } else {
      solicitacoesXml = `        <solicitacao codigolis="010000100112" codigopaciente="1" crm="45678-PR" data="2026-07-30-03:00" dataColeta="2026-07-30T00:00:00.000-03:00" postoDeColeta="MATRIZ">
            <amostra descricao="Soro" codigoBarras="" material="543">
                <exame codigo="TSH04" dadosadicionais="" urgente="false"/>
            </amostra>
        </solicitacao>`;
    }

    const idAgente = "<%= (configAlvaro && configAlvaro.idAgente) || '193762' %>";
    const nomeLis = "<%= (configAlvaro && configAlvaro.nomeLis) || 'InovalabLis' %>";
    const senha = "<%= (configAlvaro && configAlvaro.senha) || '4353cd' %>";
    const chave = "<%= (configAlvaro && configAlvaro.chave) || '581abd3154b1e858' %>";
    const entidade = "<%= (configAlvaro && configAlvaro.entidade) || '19816' %>";

    const datahoraIso = new Date().toISOString();

    currentXmlText = `<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<solicitacoes datahora="${datahoraIso}" idagente="${idAgente}" lis="${nomeLis}" operador="NOME-OPERADOR" senha="${senha}" versao="20170918">
    <entidade chave="${chave}" codigo="${entidade}">
        <pacientes>
${patientsXml}
        </pacientes>
        <medicos>
${medicosXml}
        </medicos>
${solicitacoesXml}
    </entidade>
</solicitacoes>`;

    const codeEl = document.getElementById('xml-code-alvaro');
    if (codeEl) {
      codeEl.textContent = currentXmlText;
    }

    // Gerar comando cURL formatado para exibição acima do XML
    const urlAmbiente = (window.CONFIG_ALVARO && window.CONFIG_ALVARO.urlAmbiente) ? window.CONFIG_ALVARO.urlAmbiente : 'http://webservice.alvaro.com.br/webserviceaol/rest/homologacao';
    const curlCommand = `curl --location --request PUT '${urlAmbiente}' \\\n--header 'Content-Type: application/xml' \\\n--data-raw '${currentXmlText.replace(/'/g, "'\\''")}'`;
    
    const curlEl = document.getElementById('curl-code-alvaro');
    if (curlEl) {
      curlEl.value = curlCommand;
    }

    // Gerar e preencher Response XML padrão de amostra com base nas requisições selecionadas
    const respArea = document.getElementById('alvaro-api-response-text');
    if (respArea) {
      respArea.value = generateDefaultAlvaroResponseXml(selectedReqs);
      processAndRenderAlvaroResponseXml();
    }

    // Ocultar botões de ver etiqueta e imprimir antes de criar o lote
    setEtiquetasButtonsVisible(false);

    switchAlvaroModalTab(defaultTab || 'status');

    if (modal) modal.classList.remove('hidden');

    // Transmitir e criar o lote no Álvaro automaticamente ao abrir a janela
    sendAlvaroXmlToApoio();
  }

  function setEtiquetasButtonsVisible(visible) {
    const btnIds = [
      'btn-ver-etiquetas-api',
      'btn-imprimir-etiquetas-api',
      'btn-ver-etiquetas-tab2',
      'btn-imprimir-etiquetas-tab2',
      'btn-footer-ver-etiquetas',
      'btn-footer-imprimir-etiquetas'
    ];
    btnIds.forEach(id => {
      const el = document.getElementById(id);
      if (el) {
        if (visible) {
          el.classList.remove('hidden');
        } else {
          el.classList.add('hidden');
        }
