      else if (tabName === 'request') statusEl.textContent = 'Comando cURL e Response XML';
      else statusEl.textContent = 'Etiquetas Extraídas do Response API';
    }
  }

  function parseAlvaroResponseXml(xmlString) {
    const result = {
      isSuccess: false,
      solicitacoes: [],
      errorMessage: '',
      rawXml: xmlString || ''
    };

    if (!xmlString) return result;

    try {
      const parser = new DOMParser();
      const xmlDoc = parser.parseFromString(xmlString, 'text/xml');

      const solNodes = Array.from(xmlDoc.getElementsByTagName('solicitacao'));
      if (solNodes.length > 0) {
        solNodes.forEach(node => {
          const idLis = node.getAttribute('idLis') || node.getAttribute('id_lis') || node.getAttribute('codigolis') || '';
          const idAlvaro = node.getAttribute('idAlvaro') || node.getAttribute('id_alvaro') || '';
          const baseBarras = node.getAttribute('baseBarras') || node.getAttribute('base_barras') || '';
          const incluidoAttr = (node.getAttribute('incluido') || '').toLowerCase().trim();
          const informacao = node.getAttribute('informacao') || node.getAttribute('info') || node.textContent || '';

          const isIncluido = incluidoAttr === 'true' || incluidoAttr === '1';

          result.solicitacoes.push({
            idLis,
            idAlvaro,
            baseBarras,
            incluido: isIncluido,
            informacao: informacao ? informacao.trim() : ''
          });
        });

        // O lote só é considerado criado com sucesso se 'incluido="true"' em pelo menos uma solicitação e sem erro fatal
        result.isSuccess = result.solicitacoes.length > 0 && result.solicitacoes.every(s => s.incluido);

        if (!result.isSuccess) {
          const firstErr = result.solicitacoes.find(s => !s.incluido && s.informacao) || result.solicitacoes[0];
          if (firstErr && firstErr.informacao) {
            result.errorMessage = firstErr.informacao;
          } else {
            result.errorMessage = 'A solicitação de lote foi rejeitada ou não incluída pelo Apoio Álvaro (incluido=false).';
          }
        }
      } else {
        const erroNode = xmlDoc.getElementsByTagName('erro')[0] || xmlDoc.getElementsByTagName('error')[0];
        if (erroNode) {
          result.errorMessage = erroNode.textContent.trim();
        } else if (xmlString.includes('incluido="false"')) {
          result.isSuccess = false;
          const matchInfo = xmlString.match(/informacao="([^"]+)"/i);
          result.errorMessage = matchInfo ? matchInfo[1] : 'O lote não foi incluído pelo Apoio Álvaro.';
        } else if (xmlString.includes('incluido="true"')) {
          result.isSuccess = true;
        }
      }
    } catch (e) {
      console.warn('Erro ao parsear XML de resposta do Álvaro:', e);
      result.errorMessage = 'XML de resposta em formato inesperado.';
    }

    return result;
  }

