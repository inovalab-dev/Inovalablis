  // Toast System
  function showToast(message, type = 'info') {
    const container = document.getElementById('toast-container');
    if (!container) return;

    const bgColors = {
      success: 'bg-emerald-900 border-emerald-700 text-emerald-100',
      error: 'bg-red-900 border-red-700 text-red-100',
      info: 'bg-slate-900 border-slate-700 text-slate-100'
    };

    const toast = document.createElement('div');
    toast.className = `p-3.5 rounded-xl border shadow-xl text-xs font-bold font-mono transition-all duration-300 transform translate-y-2 pointer-events-auto ${bgColors[type] || bgColors.info}`;
    toast.textContent = message;

    container.appendChild(toast);

    setTimeout(() => {
      toast.classList.add('opacity-0', 'translate-y-4');
      setTimeout(() => toast.remove(), 300);
    }, 4000);
  }

  // Functions for 'Ver Etiquetas' Modal
  let currentExtractedLayouts = [];

  function openVerEtiquetasModal() {
    const respTextarea = document.getElementById('alvaro-api-response-text');
    const respInput = document.getElementById('xml-response-alvaro-input');
    
    let xmlString = (respTextarea && respTextarea.value) ? respTextarea.value.trim() : '';
    let sourceLabel = "Response API (Geral)";

    if (!xmlString && respInput && respInput.value) {
      xmlString = respInput.value.trim();
      sourceLabel = "Response API (Aba 2)";
    }

    if (!xmlString) {
      const selectedReqs = Array.from(document.querySelectorAll('.req-checkbox:checked')).map(cb => cb.value);
      xmlString = generateDefaultAlvaroResponseXml(selectedReqs);
      sourceLabel = "Amostra / Preview Local";
    }

    const container = document.getElementById('ver-etiquetas-container');
    const badgeCount = document.getElementById('ver-etiquetas-badge-count');
    const sourceLabelEl = document.getElementById('ver-etiquetas-source-label');

    if (sourceLabelEl) sourceLabelEl.textContent = sourceLabel;

    currentExtractedLayouts = [];

    try {
      const parser = new DOMParser();
      const xmlDoc = parser.parseFromString(xmlString, 'text/xml');

      // Procurar por todas as tags <layoutetiqueta> e <layout>
      const layoutEtiquetaNodes = Array.from(xmlDoc.getElementsByTagName('layoutetiqueta'));
      const layoutNodes = Array.from(xmlDoc.getElementsByTagName('layout'));

      const allLayoutNodes = [...layoutEtiquetaNodes];
      layoutNodes.forEach(node => {
        if (!allLayoutNodes.includes(node)) {
          allLayoutNodes.push(node);
        }
      });

      if (allLayoutNodes.length === 0) {
        // Fallback por Regex se DOMParser não encontrar ou o XML estiver sem namespace limpo
        const regexTag = /<(layoutetiqueta|layout)[^>]*>([\s\S]*?)<\/\1>/gi;
        let match;
        let idx = 1;
        while ((match = regexTag.exec(xmlString)) !== null) {
          const rawContent = match[2].trim();
          if (rawContent) {
            currentExtractedLayouts.push({
              index: idx++,
              tagName: match[1],
              content: rawContent,
              idLis: '',
              idAlvaro: '',
              barcode: '789123456789',
              material: 'MATERIAL',
              patientName: 'PACIENTE'
            });
          }
        }
      } else {
        allLayoutNodes.forEach((node, i) => {
          const rawContent = (node.textContent || '').trim();
          const tagName = node.tagName.toLowerCase();

          let parentNode = node.parentNode;
          let idLis = '';
          let idAlvaro = '';
          let barcode = '';
          let material = '';
          let patientName = '';

          if (parentNode) {
            const getTagVal = (t) => {
              const el = parentNode.getElementsByTagName(t)[0];
              return el ? el.textContent.trim() : '';
            };
            const getAttrVal = (attr) => parentNode.getAttribute(attr) || '';

            idLis = getTagVal('id_lis') || getTagVal('idlis') || getAttrVal('id_lis') || getAttrVal('idlis');
            idAlvaro = getTagVal('id_alvaro') || getTagVal('idalvaro') || getAttrVal('id_alvaro') || getAttrVal('idalvaro');
            barcode = getTagVal('codigo_barras') || getTagVal('codigobarras') || getAttrVal('codigo_barras') || getAttrVal('codigobarras');
            material = getTagVal('material') || getTagVal('descricao_material') || getAttrVal('material');
          }

          if (rawContent) {
            const matchName = rawContent.match(/A1,1,0,1,1,1,N,"([^"]+)"/);
            if (matchName) patientName = matchName[1];

            const matchBar = rawContent.match(/B\d+,\d+,\d+,\d+,\d+,\d+,\d+,N,"([^"]+)"/);
            if (matchBar && !barcode) barcode = matchBar[1];
          }

          currentExtractedLayouts.push({
            index: i + 1,
            tagName,
            content: rawContent,
            idLis: idLis || `REQ-${i+1}`,
            idAlvaro: idAlvaro || `ALV-${i+1}`,
            barcode: barcode || '789123456789',
            material: material || 'SORO/MATERIAL',
            patientName: patientName || 'PACIENTE'
          });
        });
      }

      if (badgeCount) badgeCount.textContent = `${currentExtractedLayouts.length} Encontrada(s)`;

      if (currentExtractedLayouts.length === 0) {
        container.innerHTML = `
          <div class="p-8 text-center bg-slate-950 border border-dashed border-slate-800 rounded-2xl space-y-2">
            <div class="text-3xl">⚠️</div>
            <p class="text-amber-400 font-bold text-sm">Nenhuma tag &lt;layoutetiqueta&gt; ou &lt;layout&gt; encontrada</p>
            <p class="text-xs text-slate-400 font-mono">Verifique se o XML de resposta contém as tags de etiqueta do Apoio Álvaro.</p>
          </div>
        `;
      } else {
        container.innerHTML = currentExtractedLayouts.map((item, idx) => `
          <div class="bg-slate-950 border border-slate-800 rounded-2xl p-4 space-y-3">
            <div class="flex items-center justify-between border-b border-slate-800 pb-2 flex-wrap gap-2">
              <div class="flex items-center gap-2">
                <span class="text-xs font-bold text-amber-400 font-mono">Etiqueta #${item.index}</span>
                <span class="text-[10px] font-mono bg-slate-800 text-slate-300 px-2 py-0.5 rounded-md border border-slate-700">&lt;${escapeXmlAttr(item.tagName)}&gt;</span>
                ${item.idLis ? `<span class="text-[10px] font-mono bg-sky-500/20 text-sky-300 px-2 py-0.5 rounded-md border border-sky-500/30">Req: ${escapeXmlAttr(item.idLis)}</span>` : ''}
                ${item.idAlvaro ? `<span class="text-[10px] font-mono bg-amber-500/20 text-amber-300 px-2 py-0.5 rounded-md border border-amber-500/30">Álvaro: ${escapeXmlAttr(item.idAlvaro)}</span>` : ''}
              </div>
              <div class="flex items-center gap-2">
                <button 
                  type="button" 
                  onclick="printAlvaroLabels(currentExtractedLayouts[${idx}].content)" 
                  class="px-3 py-1 bg-amber-500 hover:bg-amber-600 text-slate-950 text-xs font-black rounded-xl shadow-md transition-all cursor-pointer flex items-center gap-1 shrink-0"
                  title="Enviar esta etiqueta para impressora ZDesigner ZD230-203dpi ZPL via REST"
                >
                  <span>🖨️</span> Imprimir
                </button>
                <button 
                  type="button" 
                  onclick="copySingleExtractedLayout(${idx})" 
                  class="px-3 py-1 bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 text-xs font-mono font-bold rounded-xl border border-amber-500/30 transition-all cursor-pointer flex items-center gap-1 shrink-0"
                >
                  <span>📋</span> Copiar EPL
                </button>
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <!-- Simulated Label Graphic -->
              <div class="bg-white rounded-xl p-3 border-2 border-dashed border-slate-400 text-slate-950 font-mono text-xs shadow-md space-y-1.5 select-none flex flex-col justify-between min-h-[130px]">
                <div class="font-black text-xs sm:text-sm uppercase tracking-tight text-slate-950 truncate border-b border-slate-300 pb-0.5">
                  ${escapeXmlAttr(item.patientName || 'PACIENTE AVISO')}
                </div>
                <div class="py-1 flex justify-center items-center bg-white overflow-hidden">
                  <svg id="ver-barcode-svg-${idx}" class="h-9 w-full max-w-[240px]"></svg>
                </div>
                <div class="flex justify-between items-center text-[10px] font-bold border-t border-slate-300 pt-0.5 text-slate-800">
                  <span>${escapeXmlAttr(item.material)}</span>
                  <span class="font-black text-slate-950">${escapeXmlAttr(item.idAlvaro)}</span>
                </div>
              </div>

              <!-- EPL Content Textarea -->
              <div class="space-y-1">
                <label class="text-[10px] font-mono font-bold text-slate-400 uppercase">Comando EPL2 (&lt;${escapeXmlAttr(item.tagName)}&gt;):</label>
                <textarea readonly class="w-full h-[120px] p-3 bg-slate-900 border border-slate-800 rounded-xl font-mono text-[11px] text-emerald-400 focus:outline-none selection:bg-amber-500 selection:text-slate-950 leading-relaxed cursor-text resize-none">${escapeXmlAttr(item.content)}</textarea>
              </div>
            </div>
          </div>
        `).join('');

        setTimeout(() => {
          currentExtractedLayouts.forEach((item, idx) => {
            try {
              if (window.JsBarcode) {
                JsBarcode("#ver-barcode-svg-" + idx, item.barcode || "789123456789", {
                  format: "CODE128",
                  width: 1.5,
                  height: 32,
                  displayValue: false,
                  margin: 0
                });
              }
            } catch(e) {
              console.error('Erro ao renderizar código de barras:', e);
            }
          });
        }, 50);
      }

    } catch(err) {
      console.error('Erro ao extrair etiquetas:', err);
      if (container) {
        container.innerHTML = `<div class="p-4 bg-rose-500/10 border border-rose-500/30 text-rose-300 font-mono text-xs rounded-xl">Erro ao extrair etiquetas do XML: ${err.message}</div>`;
      }
    }

    document.getElementById('modal-ver-etiquetas').classList.remove('hidden');
  }

  function closeVerEtiquetasModal() {
    document.getElementById('modal-ver-etiquetas').classList.add('hidden');
  }

  function copySingleExtractedLayout(idx) {
    if (currentExtractedLayouts[idx]) {
      navigator.clipboard.writeText(currentExtractedLayouts[idx].content).then(() => {
        showToast('Layout da etiqueta #' + (idx + 1) + ' copiado!', 'success');
      }).catch(err => {
        showToast('Erro ao copiar layout.', 'error');
      });
    }
  }

  function copyAllExtractedLayouts() {
    if (!currentExtractedLayouts || currentExtractedLayouts.length === 0) {
      showToast('Nenhum layout disponível para copiar.', 'error');
      return;
    }
    const fullText = currentExtractedLayouts.map((item, i) => `/* --- ETIQUETA #${i+1} (<${item.tagName}>) --- */\n${item.content}`).join('\n\n');
    navigator.clipboard.writeText(fullText).then(() => {
      showToast(`${currentExtractedLayouts.length} layout(s) copiado(s) para a área de transferência!`, 'success');
    }).catch(err => {
      showToast('Erro ao copiar layouts.', 'error');
    });
  }

  // Modal Alert Dialog
  function showAlertDialog(title, message) {
    document.getElementById('alert-dialog-title').textContent = title;
    document.getElementById('alert-dialog-message').textContent = message;
    document.getElementById('alert-dialog-modal').classList.remove('hidden');
  }

  function closeAlertDialog() {
    document.getElementById('alert-dialog-modal').classList.add('hidden');
  }

  // Inicializar quando o DOM estiver pronto
  document.addEventListener('DOMContentLoaded', () => {
    renderCriarLoteScreen();
  });
</script>

