  function switchAlvaroModalTab(tabName) {
    const tabStatus = document.getElementById('tab-alvaro-status');
    const tabReq = document.getElementById('tab-alvaro-request');
    const tabResp = document.getElementById('tab-alvaro-response');

    const viewStatus = document.getElementById('view-alvaro-status');
