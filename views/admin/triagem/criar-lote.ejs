            <amostra codigoBarras="${barcode}" descricao="${escapeXmlAttr(matInfo.desc)}" descricaoAcondicionamento="R" descricaoMaterial="${escapeXmlAttr(matInfo.desc.toUpperCase())}" idAcondicionamento="26" idAmostra="0" idAmostraExecutor="${barcode}" idDestino="54" identificacao="" lote="LT0A34873393" material="${escapeXmlAttr(matInfo.code)}" mnemonico="ALP.R.2" sequencia="0" volume="${vMinVal}.0">
                ${exListXml}
