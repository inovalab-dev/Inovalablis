      container.innerHTML = `<div class="col-span-full p-8 text-center text-slate-500 font-mono text-xs border border-dashed border-slate-800 rounded-2xl">Nenhum Response XML fornecido.</div>`;
      return;
    }

    try {
      const parser = new DOMParser();
      const xmlDoc = parser.parseFromString(xmlStr, "text/xml");
      
      const solicitacaoNodes = xmlDoc.getElementsByTagName("solicitacao");
      
      for (let i = 0; i < solicitacaoNodes.length; i++) {
        const solNode = solicitacaoNodes[i];
        const idLis = solNode.getAttribute("idLis") || '000000';
        const idAlvaro = solNode.getAttribute("idAlvaro") || solNode.getAttribute("baseBarras") || '000000000';
        
        const amostraNodes = solNode.getElementsByTagName("amostra");
        if (amostraNodes && amostraNodes.length > 0) {
