  function formatEplLayoutClient(rawEtiqueta) {
    if (!rawEtiqueta) return '';
    let str = String(rawEtiqueta).trim();

    // Remove CDATA or XML wrapper tags if present
    str = str.replace(/^<!\[CDATA\[/i, '').replace(/\]\]>$/i, '').trim();

    // Unescape XML entities
    str = str
      .replace(/&quot;/g, '"')
      .replace(/&apos;/g, "'")
      .replace(/&lt;/g, '<')
      .replace(/&gt;/g, '>')
      .replace(/&amp;/g, '&');

    // Convert literal "\r\n" or "\n" sequence strings into real line breaks
    if (str.includes('\\r') || str.includes('\\n')) {
      str = str.replace(/\\r\\n/g, '\r\n').replace(/\\r/g, '\r').replace(/\\n/g, '\n');
    }

    // Split into lines and clean whitespace on each EPL command line
    const lines = str.split(/\r?\n/).map(line => line.trim()).filter(line => line.length > 0);

    // Rejoin with standard CRLF (\r\n) for thermal printer REST API
    let formatted = lines.join('\r\n');
    if (formatted && !formatted.endsWith('\r\n')) {
      formatted += '\r\n';
    }

    return formatted;
  }

  function getReceivedXmlLabelLayouts() {
    const layouts = [];

    // 1. Tentar das etiquetas já extraídas no modal (currentExtractedLayouts)
    if (typeof currentExtractedLayouts !== 'undefined' && currentExtractedLayouts && currentExtractedLayouts.length > 0) {
      currentExtractedLayouts.forEach(item => {
        if (item.content && item.content.trim()) {
          layouts.push(item.content.trim());
        }
      });
    }

    // 2. Tentar das etiquetas do response XML parseado (currentParsedAlvaroLabels)
    if (layouts.length === 0 && typeof currentParsedAlvaroLabels !== 'undefined' && currentParsedAlvaroLabels && currentParsedAlvaroLabels.length > 0) {
      currentParsedAlvaroLabels.forEach(item => {
        const val = (item.layoutEpl || item.content || item.epl || item.rawEpl || '').trim();
        if (val) {
          layouts.push(val);
        }
      });
    }

    // 3. Se ainda não tiver, fazer regex/DOM parse no text contido na textarea do Response XML
    if (layouts.length === 0) {
      const respTextarea = document.getElementById('alvaro-api-response-text');
      const respInput = document.getElementById('xml-response-alvaro-input');
      const xmlString = (respTextarea && respTextarea.value ? respTextarea.value : (respInput ? respInput.value : '')).trim();

      if (xmlString) {
        try {
          const parser = new DOMParser();
          const xmlDoc = parser.parseFromString(xmlString, 'text/xml');
          const layoutEtiquetaNodes = Array.from(xmlDoc.getElementsByTagName('layoutetiqueta'));
          const layoutNodes = Array.from(xmlDoc.getElementsByTagName('layout'));
          const allNodes = [...layoutEtiquetaNodes];
          layoutNodes.forEach(node => {
            if (!allNodes.includes(node)) allNodes.push(node);
          });

          allNodes.forEach(node => {
            const txt = (node.textContent || '').trim();
            if (txt) layouts.push(txt);
          });
        } catch (e) {
          console.warn('Erro ao parsear XML para extrair etiquetas:', e);
        }

        if (layouts.length === 0) {
          const regexTag = /<(layoutetiqueta|layout)[^>]*>([\s\S]*?)<\/\1>/gi;
          let match;
          while ((match = regexTag.exec(xmlString)) !== null) {
            const content = match[2].trim();
            if (content) layouts.push(content);
          }
        }
      }
    }

    return layouts;
  }

  async function printAlvaroLabels(singleEtiquetaContent = null) {
    let labelsToPrint = [];

    if (singleEtiquetaContent && typeof singleEtiquetaContent === 'string' && singleEtiquetaContent.trim()) {
      labelsToPrint = [singleEtiquetaContent.trim()];
    } else {
      labelsToPrint = getReceivedXmlLabelLayouts();
    }

    if (labelsToPrint.length === 0) {
      showToast('Nenhuma etiqueta (layout) encontrada no XML de resposta do lote.', 'error');
      return;
    }

    const impressoraNome = "ZDesigner ZD230-203dpi ZPL";
    const printIp = "186.237.152.170";
    const printPorta = "8085";

    showToast(`Enviando ${labelsToPrint.length} etiqueta(s) via REST para ${impressoraNome}...`, 'info');

    let successCount = 0;

    for (let i = 0; i < labelsToPrint.length; i++) {
      const rawEtiquetaStr = labelsToPrint[i];
      const etiquetaStr = formatEplLayoutClient(rawEtiquetaStr);

      console.log(`[PRINT REST REQUEST] Impressora: "${impressoraNome}"`);
      console.log(`[PRINT REST REQUEST] Etiqueta #${i+1} layout retornado (formatado):\n${etiquetaStr}`);

      // 1. Envio REST via Proxy do Servidor
      try {
        const res = await fetch('/api/impressoras/imprimir', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            impressora: impressoraNome,
            etiqueta: etiquetaStr,
            ip: printIp,
            porta: printPorta
          })
        });

        const data = await res.json();
        console.log(`[REST PRINT PROXY] Resposta #${i+1}:`, data);
        if (data && data.success) successCount++;
      } catch (err) {
        console.warn(`[REST PRINT PROXY] Erro no servidor:`, err.message);
      }

      // 2. Envio REST direto no cliente (CURL endpoint http://186.237.152.170:8085/imprimir)
      try {
        await fetch(`http://${printIp}:${printPorta}/imprimir`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            impressora: impressoraNome,
            etiqueta: etiquetaStr
          })
        });
        console.log(`[REST PRINT DIRECT] Sucesso enviando para http://${printIp}:${printPorta}/imprimir`);
      } catch (directErr) {
        console.log(`[REST PRINT DIRECT] Tentativa direta client-side:`, directErr.message);
      }
    }

    showToast(`Etiqueta(s) enviada(s) para a impressora ${impressoraNome} (${printIp}:${printPorta})!`, 'success');
  }

