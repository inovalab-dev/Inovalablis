<%- include('../../partials/header', { page: 'admin-triagem-criar-lote' }) %>
<script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>

<!-- Serialized Data for Client JS -->
<script>
  window.CATALOG_EXAMS = <%- JSON.stringify(exams || []) %>;
  window.RECIPIENTES = <%- JSON.stringify(recipientes || []) %>;
  window.SETORES = <%- JSON.stringify(setores || []) %>;
  window.SUPPORT_LABS = <%- JSON.stringify(labs || []) %>;
  window.TRIAGEM_REQUISITIONS = <%- JSON.stringify(requisitions || []) %>;
  window.TRIAGEM_PATIENTS = <%- JSON.stringify(patients || []) %>;
  window.TRIAGEM_MEDICOS = <%- JSON.stringify(medicos || []) %>;
  window.CONFIG_ALVARO = <%- JSON.stringify(configAlvaro || {}) %>;
</script>

<div class="p-4 sm:p-6 lg:p-8 max-w-[98vw] xl:max-w-[96vw] mx-auto w-full flex-1 space-y-6">

  <!-- Header Breadcrumbs & Title -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 text-xs text-slate-500 font-mono uppercase tracking-wider mb-1">
        <a href="/admin" class="hover:text-slate-800 transition-colors">Administração</a>
        <span>•</span>
        <a href="/admin/triagem/amostras" class="hover:text-slate-800 transition-colors">Triagem</a>
        <span>•</span>
        <span class="text-amber-800 font-bold">Criar Lote</span>
      </div>

      <div class="flex items-center gap-3">
        <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-amber-500/20 to-purple-500/20 border border-amber-300 shadow-xs flex items-center justify-center shrink-0 text-amber-900 font-black text-xl">
          📦
        </div>
        <div>
          <h1 class="text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2">
            Criar Lote de Envio Externo
            <span class="text-xs font-mono font-bold bg-amber-100 text-amber-800 px-2.5 py-0.5 rounded-full uppercase border border-amber-200">Apoio Álvaro & Pardini</span>
          </h1>
          <p class="text-xs text-slate-500">
            Agrupamento de pacientes e exames já triados para geração de lote e envio aos laboratórios de apoio.
          </p>
        </div>
      </div>
    </div>

    <!-- Quick Action Buttons -->
    <div class="flex flex-wrap items-center gap-3">
      <button type="button" onclick="openXmlAlvaroModal('response')" class="px-4 py-2.5 bg-amber-500 hover:bg-amber-600 text-slate-950 font-extrabold text-xs rounded-xl shadow-2xs transition-all flex items-center gap-2 cursor-pointer">
        <span>🏷️</span> Response & Etiquetas Álvaro
      </button>
      <a href="/admin/triagem/amostras" class="px-4 py-2.5 bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 font-bold text-xs rounded-xl shadow-2xs transition-all flex items-center gap-2">
        <span>⬅️</span> Voltar para Triagem
      </a>
      <button type="button" onclick="window.location.reload()" class="px-4 py-2.5 bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs rounded-xl shadow-2xs transition-all flex items-center gap-2 cursor-pointer">
        <span>🔄</span> Atualizar Dados
      </button>
    </div>
  </div>

  <!-- Global Metrics Header Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    
    <div class="bg-white p-4 rounded-2xl border border-slate-200/90 shadow-2xs flex items-center justify-between">
      <div>
        <p class="text-[11px] font-bold text-slate-500 uppercase font-mono tracking-wider">Total Pacientes Triados</p>
        <p id="stat-total-pacientes" class="text-2xl font-black text-slate-900 font-mono mt-0.5">0</p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-slate-100 flex items-center justify-center text-slate-700 font-bold text-lg">🩺</div>
    </div>

    <div class="bg-amber-50/60 p-4 rounded-2xl border border-amber-200/80 shadow-2xs flex items-center justify-between">
      <div>
        <p class="text-[11px] font-bold text-amber-800 uppercase font-mono tracking-wider">Pacientes Álvaro</p>
        <p id="stat-alvaro-pacientes" class="text-2xl font-black text-amber-900 font-mono mt-0.5">0</p>
        <p class="text-[10px] text-amber-700/80 font-mono font-bold mt-0.5"><span id="stat-alvaro-exames">0</span> exames triados</p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-amber-100 border border-amber-300 flex items-center justify-center text-amber-800 font-bold text-lg">🟡</div>
    </div>

    <div class="bg-purple-50/60 p-4 rounded-2xl border border-purple-200/80 shadow-2xs flex items-center justify-between">
      <div>
        <p class="text-[11px] font-bold text-purple-800 uppercase font-mono tracking-wider">Pacientes Pardini</p>
        <p id="stat-pardini-pacientes" class="text-2xl font-black text-purple-900 font-mono mt-0.5">0</p>
        <p class="text-[10px] text-purple-700/80 font-mono font-bold mt-0.5"><span id="stat-pardini-exames">0</span> exames triados</p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-purple-100 border border-purple-300 flex items-center justify-center text-purple-800 font-bold text-lg">🟣</div>
    </div>

    <div class="bg-emerald-50/60 p-4 rounded-2xl border border-emerald-200/80 shadow-2xs flex items-center justify-between">
      <div>
        <p class="text-[11px] font-bold text-emerald-800 uppercase font-mono tracking-wider">Lotes em Aberto</p>
        <p id="stat-lotes-pendentes" class="text-2xl font-black text-emerald-900 font-mono mt-0.5">2</p>
        <p class="text-[10px] text-emerald-700/80 font-mono font-bold mt-0.5">Prontos p/ geração</p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-emerald-100 border border-emerald-300 flex items-center justify-center text-emerald-800 font-bold text-lg">📋</div>
    </div>

  </div>

  <!-- Search & Filtering Bar -->
  <div class="bg-white p-4 rounded-2xl border border-slate-200/90 shadow-2xs flex flex-col sm:flex-row items-center justify-between gap-3">
    <div class="relative flex-1 w-full">
      <input 
        type="text" 
        id="searchInput" 
        oninput="filterLotes()" 
        placeholder="Pesquisar por Paciente, CPF, Código de Requisição (#REQ-...) ou Nome do Exame..." 
        class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl font-bold text-xs text-slate-800 outline-none focus:ring-2 focus:ring-amber-500 transition-all"
      >
      <span class="absolute left-3.5 top-3 text-slate-400 text-sm">🔍</span>
    </div>

    <div class="flex items-center gap-2 text-xs font-mono font-bold text-slate-500 shrink-0">
      <span>Filtrar Lote:</span>
      <select id="loteFilterSelect" onchange="filterLotes()" class="bg-slate-50 border border-slate-200 text-slate-800 text-xs rounded-xl px-3 py-2 font-bold outline-none focus:ring-2 focus:ring-amber-500 cursor-pointer">
        <option value="todos" selected>Exibir Todos Pendentes</option>
        <option value="sem_lote">Sem Lote Gerado</option>
        <option value="com_lote">Com Lote Gerado</option>
      </select>
    </div>
  </div>

  <!-- Main 2-Column Layout: Álvaro & Pardini -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">

    <!-- ==================== COLUNA ÁLVARO ==================== -->
    <div class="bg-amber-50/30 rounded-2xl border border-amber-200/90 p-4 shadow-sm space-y-4">
      
      <!-- Header Coluna Álvaro -->
      <div class="bg-amber-500/10 border border-amber-300/80 rounded-xl p-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-xl bg-amber-500 text-white font-black text-sm flex items-center justify-center shadow-xs">
            Á
          </div>
          <div>
            <h2 class="text-base font-black text-amber-950 flex items-center gap-2">
              Laboratório Álvaro
              <span id="badge-count-alvaro" class="text-[10px] font-mono font-extrabold bg-amber-200/80 text-amber-900 px-2 py-0.5 rounded-md border border-amber-300">
                0 pacientes
              </span>
            </h2>
            <p class="text-[11px] text-amber-800/80 font-medium">Exames triados destinados ao Apoio Álvaro</p>
          </div>
        </div>

        <div class="flex items-center gap-2 shrink-0">
          <button 
            type="button" 
            onclick="selectAllColumn('alvaro')" 
            class="px-3 py-1.5 bg-amber-100 hover:bg-amber-200 text-amber-900 font-bold text-[11px] rounded-lg border border-amber-300 transition-all cursor-pointer flex items-center gap-1"
          >
            <span>☑️</span> Sel. Todos
          </button>
          <button 
            type="button" 
            id="btn-criar-lote-alvaro"
            onclick="openXmlAlvaroModal()" 
            class="px-4 py-2 bg-amber-600 hover:bg-amber-700 active:bg-amber-800 text-white font-extrabold text-xs rounded-xl shadow-xs transition-all cursor-pointer flex items-center gap-1.5 disabled:opacity-50 disabled:cursor-not-allowed disabled:pointer-events-none"
          >
            <span>📦</span> Criar Lote Álvaro
          </button>
        </div>
      </div>

      <!-- Container de Pacientes Álvaro (Sem Collapse) -->
      <div id="container-pacientes-alvaro" class="space-y-4 min-h-[250px]">
        <!-- Populado dinamicamente pelo JS -->
      </div>

      <!-- Empty State Álvaro -->
      <div id="empty-alvaro" class="hidden py-12 text-center bg-white rounded-2xl border border-dashed border-amber-200 p-6">
        <div class="text-3xl mb-2">🟡</div>
        <p class="text-xs font-bold text-amber-900">Nenhum exame triado para o Laboratório Álvaro</p>
        <p class="text-[11px] text-amber-700/70 mt-1">Realize a triagem das amostras para que os exames apareçam nesta coluna.</p>
      </div>

    </div>

    <!-- ==================== COLUNA PARDINI ==================== -->
    <div class="bg-purple-50/30 rounded-2xl border border-purple-200/90 p-4 shadow-sm space-y-4">
      
      <!-- Header Coluna Pardini -->
      <div class="bg-purple-500/10 border border-purple-300/80 rounded-xl p-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-xl bg-purple-600 text-white font-black text-sm flex items-center justify-center shadow-xs">
            P
          </div>
          <div>
            <h2 class="text-base font-black text-purple-950 flex items-center gap-2">
              Laboratório Pardini
              <span id="badge-count-pardini" class="text-[10px] font-mono font-extrabold bg-purple-200/80 text-purple-900 px-2 py-0.5 rounded-md border border-purple-300">
                0 pacientes
              </span>
            </h2>
            <p class="text-[11px] text-purple-800/80 font-medium">Exames triados destinados ao Apoio Pardini</p>
          </div>
        </div>

        <div class="flex items-center gap-2 shrink-0">
          <button 
            type="button" 
            onclick="selectAllColumn('pardini')" 
            class="px-3 py-1.5 bg-purple-100 hover:bg-purple-200 text-purple-900 font-bold text-[11px] rounded-lg border border-purple-300 transition-all cursor-pointer flex items-center gap-1"
          >
            <span>☑️</span> Sel. Todos
          </button>
          <button 
            type="button" 
            id="btn-criar-lote-pardini"
            onclick="triggerGerarLote('pardini')" 
            class="px-4 py-2 bg-purple-700 hover:bg-purple-800 active:bg-purple-900 text-white font-extrabold text-xs rounded-xl shadow-xs transition-all cursor-pointer flex items-center gap-1.5 disabled:opacity-50 disabled:cursor-not-allowed disabled:pointer-events-none"
          >
            <span>📦</span> Gerar Lote Pardini
          </button>
        </div>
      </div>

      <!-- Container de Pacientes Pardini (Sem Collapse) -->
      <div id="container-pacientes-pardini" class="space-y-4 min-h-[250px]">
        <!-- Populado dinamicamente pelo JS -->
      </div>

      <!-- Empty State Pardini -->
      <div id="empty-pardini" class="hidden py-12 text-center bg-white rounded-2xl border border-dashed border-purple-200 p-6">
        <div class="text-3xl mb-2">🟣</div>
        <p class="text-xs font-bold text-purple-900">Nenhum exame triado para o Laboratório Pardini</p>
        <p class="text-[11px] text-purple-700/70 mt-1">Realize a triagem das amostras para que os exames apareçam nesta coluna.</p>
      </div>

    </div>

  </div>

</div>

<!-- Modal de Confirmação e Impressão do Lote -->
<div id="modal-gerar-lote" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 flex items-center justify-center p-4 hidden">
  <div class="bg-white rounded-3xl border border-slate-200 shadow-2xl w-full max-w-2xl overflow-hidden animate-in fade-in zoom-in duration-200">
    
    <div id="modal-lote-header" class="p-5 bg-slate-900 text-white flex items-center justify-between">
      <div class="flex items-center gap-3">
        <span class="text-2xl">📦</span>
        <div>
          <h3 id="modal-lote-title" class="font-extrabold text-base tracking-tight">Confirmar Lote de Envio</h3>
          <p id="modal-lote-subtitle" class="text-xs text-slate-300 font-mono">Revisão e confirmação de exames triados</p>
        </div>
      </div>
      <button type="button" onclick="closeLoteModal()" class="text-slate-400 hover:text-white text-xl font-bold p-1 cursor-pointer">✕</button>
    </div>

    <div class="p-6 space-y-4 max-h-[70vh] overflow-y-auto">
      
      <div id="modal-lote-summary" class="p-4 bg-slate-50 border border-slate-200 rounded-2xl flex flex-col sm:flex-row justify-between gap-3 text-xs">
        <div>
          <p class="font-bold text-slate-500 uppercase tracking-wider text-[10px]">Laboratório de Destino</p>
          <p id="modal-lote-lab-name" class="font-extrabold text-slate-900 text-sm mt-0.5">-</p>
        </div>
        <div>
          <p class="font-bold text-slate-500 uppercase tracking-wider text-[10px]">Total de Pacientes</p>
          <p id="modal-lote-pacientes-count" class="font-extrabold text-slate-900 text-sm mt-0.5">0</p>
        </div>
        <div>
          <p class="font-bold text-slate-500 uppercase tracking-wider text-[10px]">Total de Exames</p>
          <p id="modal-lote-exames-count" class="font-extrabold text-amber-700 text-sm mt-0.5">0</p>
        </div>
      </div>

      <div>
        <h4 class="text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Relação de Pacientes e Exames do Lote:</h4>
        <div id="modal-lote-items-list" class="space-y-2 border border-slate-200 rounded-xl p-3 bg-white font-mono text-xs max-h-60 overflow-y-auto">
          <!-- Item list injected by JS -->
        </div>
      </div>

    </div>

    <div class="p-5 bg-slate-50 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-3">
      <button type="button" onclick="closeLoteModal()" class="w-full sm:w-auto px-4 py-2.5 bg-white border border-slate-300 hover:bg-slate-100 text-slate-700 font-bold text-xs rounded-xl cursor-pointer">
        Cancelar
      </button>

      <div class="flex items-center gap-2 w-full sm:w-auto">
        <button type="button" id="btn-confirmar-gerar-lote" onclick="processGerarLote(false)" class="w-full sm:w-auto px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-xs rounded-xl shadow-xs transition-all cursor-pointer flex items-center justify-center gap-2">
          <span>✅</span> Gerar Lote
        </button>
        <button type="button" onclick="processGerarLote(true)" class="w-full sm:w-auto px-5 py-2.5 bg-slate-900 hover:bg-slate-800 text-white font-extrabold text-xs rounded-xl shadow-xs transition-all cursor-pointer flex items-center justify-center gap-2">
          <span>🖨️</span> Gerar e Imprimir
        </button>
      </div>
    </div>

  </div>
</div>

<!-- Modal Alert/Toast Dialog -->
<div id="alert-dialog-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 flex items-center justify-center p-4 hidden">
  <div class="bg-white rounded-3xl border border-slate-200 shadow-2xl w-full max-w-md overflow-hidden p-6 text-center space-y-4">
    <div id="alert-dialog-icon" class="text-4xl">⚠️</div>
    <h3 id="alert-dialog-title" class="text-base font-extrabold text-slate-900">Atenção</h3>
    <p id="alert-dialog-message" class="text-xs text-slate-600 leading-relaxed font-medium"></p>
    <button type="button" onclick="closeAlertDialog()" class="px-6 py-2.5 bg-slate-900 hover:bg-slate-800 text-white font-extrabold text-xs rounded-xl shadow-xs cursor-pointer w-full">
      Entender e Fechar
    </button>
  </div>
</div>

<!-- Modal Request & Response XML / Etiquetas Álvaro -->
<div id="modal-xml-alvaro" class="fixed inset-0 bg-slate-900/80 backdrop-blur-xs z-50 flex items-center justify-center p-4 hidden">
  <div class="bg-slate-900 border border-slate-700 rounded-3xl shadow-2xl w-full max-w-4xl overflow-hidden animate-in fade-in zoom-in duration-200 flex flex-col max-h-[90vh]">
    
    <!-- Header -->
    <div class="p-5 bg-slate-950 border-b border-slate-800 text-white flex items-center justify-between shrink-0">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-amber-500/20 border border-amber-500/40 text-amber-400 font-bold flex items-center justify-center text-xl shrink-0">
          🏷️
        </div>
        <div>
          <h3 class="font-black text-base text-white tracking-tight flex items-center gap-2">
            WebService & Etiquetas — Apoio Álvaro
            <span class="text-[10px] font-mono font-bold bg-amber-500/20 text-amber-300 px-2.5 py-0.5 rounded-full border border-amber-500/30 uppercase">WebService Apoio</span>
          </h3>
          <p class="text-xs text-slate-400 font-mono">Solicitação de exames e geração de etiquetas com código de barras</p>
        </div>
      </div>
      <button type="button" onclick="closeXmlAlvaroModal()" class="text-slate-400 hover:text-white text-xl font-bold p-1 cursor-pointer transition-colors">✕</button>
    </div>

    <!-- Tab Bar -->
    <div class="flex border-b border-slate-800 bg-slate-950 px-5 gap-4 shrink-0 overflow-x-auto">
      <button type="button" id="tab-alvaro-status" onclick="switchAlvaroModalTab('status')" class="py-3 text-xs font-bold border-b-2 border-amber-400 text-amber-300 flex items-center gap-2 cursor-pointer transition-all shrink-0">
        <span>📊 1. Status do Lote</span>
      </button>
      <button type="button" id="tab-alvaro-request" onclick="switchAlvaroModalTab('request')" class="py-3 text-xs font-bold border-b-2 border-transparent text-slate-400 hover:text-slate-200 flex items-center gap-2 cursor-pointer transition-all shrink-0">
        <span>📜 2. Request & Response XML</span>
      </button>
      <button type="button" id="tab-alvaro-response" onclick="switchAlvaroModalTab('response')" class="py-3 text-xs font-bold border-b-2 border-transparent text-slate-400 hover:text-slate-200 flex items-center gap-2 cursor-pointer transition-all shrink-0">
        <span>🏷️ 3. Layouts de Etiquetas</span>
      </button>
    </div>

    <!-- Body Container -->
    <div class="p-6 space-y-4 overflow-y-auto bg-slate-900 flex-1">
      
      <!-- VIEW TAB 1: STATUS DO LOTE -->
      <div id="view-alvaro-status" class="space-y-4">
        <div id="alvaro-status-summary-container" class="space-y-4">
          <!-- Estado Inicial / Loading -->
          <div class="p-6 bg-slate-950 border border-slate-800 rounded-2xl flex items-center gap-4">
            <div class="w-12 h-12 rounded-2xl bg-amber-500/20 text-amber-400 font-bold flex items-center justify-center text-2xl shrink-0 animate-pulse">
              ⏳
            </div>
            <div>
              <h4 class="font-extrabold text-base text-slate-100">Transmitindo Lote para o WebService Álvaro...</h4>
              <p class="text-xs text-slate-400 mt-1">Conectando e enviando os dados dos exames triados para inclusão no apoio.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- VIEW TAB 2: REQUEST & RESPONSE XML -->
      <div id="view-alvaro-request" class="space-y-4 hidden">
        <div class="p-3.5 bg-amber-500/10 border border-amber-500/30 rounded-2xl text-xs text-amber-200/90 flex items-start gap-3">
          <span class="text-lg shrink-0">💡</span>
          <div>
            <p class="font-bold text-amber-300">Dados da Transmissão ao WebService Álvaro</p>
            <p class="mt-0.5 text-[11px] leading-relaxed text-slate-300">
              Comando cURL gerado e payload de resposta em formato XML retornado pela API do Apoio Álvaro (Entidade: <strong><%= (configAlvaro && configAlvaro.entidade) || '19816' %></strong>, Agente: <strong><%= (configAlvaro && configAlvaro.idAgente) || '193762' %></strong>).
            </p>
          </div>
        </div>

        <!-- CAMPO COMANDO cURL (COLLAPSED BY DEFAULT) -->
        <details class="group bg-slate-950/80 border border-slate-800 rounded-2xl overflow-hidden">
          <summary class="p-3.5 text-xs font-bold text-amber-300 font-mono flex items-center justify-between cursor-pointer select-none">
            <span class="flex items-center gap-2">
              <span>💻</span> Comando cURL de Envio (PUT WebService)
            </span>
            <div class="flex items-center gap-2">
              <button 
                type="button" 
                onclick="event.stopPropagation(); copyCurlAlvaroToClipboard()" 
                class="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 active:bg-slate-600 text-amber-300 border border-slate-700 font-mono font-bold text-[11px] rounded-lg transition-all cursor-pointer flex items-center gap-1"
              >
                <span>📋</span> Copiar cURL
              </button>
              <span class="text-[10px] text-slate-500 font-mono group-open:rotate-180 transition-transform">▼</span>
            </div>
          </summary>
          <div class="p-3.5 border-t border-slate-800 space-y-2">
            <textarea 
              id="curl-code-alvaro" 
              rows="3" 
              readonly 
              class="w-full p-3 bg-slate-900 border border-slate-800 rounded-xl font-mono text-xs text-amber-200/90 focus:outline-none selection:bg-amber-500 selection:text-slate-950 leading-relaxed cursor-text resize-none"
              placeholder="Comando cURL gerado..."
            ></textarea>
          </div>
        </details>

        <!-- Response Container do WebService Álvaro (COLLAPSED BY DEFAULT) -->
        <details id="alvaro-api-response-box" class="group bg-slate-950 border border-slate-800 rounded-2xl overflow-hidden">
          <summary class="p-3.5 text-xs font-bold font-mono uppercase tracking-wider text-slate-200 flex items-center justify-between cursor-pointer select-none">
            <div class="flex items-center gap-2">
              <span>📬</span> Resposta Retornada pelo WebService Álvaro
              <span id="alvaro-api-status-badge" class="px-2 py-0.5 rounded-md text-[10px] font-mono font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
                HTTP 200 OK
              </span>
            </div>
            <div class="flex items-center gap-2">
              <span id="alvaro-api-endpoint-url" class="text-[10px] font-mono text-slate-400 truncate max-w-[200px]"></span>
              <span class="text-[10px] text-slate-500 font-mono group-open:rotate-180 transition-transform">▼</span>
            </div>
          </summary>
          <div class="p-3.5 border-t border-slate-800 space-y-2">
            <textarea id="alvaro-api-response-text" rows="7" readonly class="w-full p-3 bg-slate-900 border border-slate-800 rounded-xl font-mono text-xs text-sky-300 focus:outline-none selection:bg-amber-500 selection:text-slate-950 leading-relaxed" placeholder="Aguardando envio do lote..."></textarea>
          </div>
        </details>
      </div>

      <!-- VIEW TAB 3: LAYOUTS DE ETIQUETAS -->
      <div id="view-alvaro-response" class="space-y-4 hidden">
        <div class="flex items-center justify-between gap-3 p-1">
          <div class="text-xs text-slate-300 font-mono flex items-center gap-2">
            <span>🏷️</span> Layouts de Etiquetas extraídos do XML de resposta:
          </div>
          <button 
            type="button" 
            onclick="copyAllAlvaroEpl()" 
            class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-white font-bold text-xs rounded-xl border border-slate-700 transition-all cursor-pointer flex items-center gap-1.5"
          >
            <span>📋</span> Copiar EPLs
          </button>
        </div>

        <!-- Etiquetas Output Container -->
        <div id="container-etiquetas-alvaro" class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Etiquetas cards populated dynamically -->
        </div>
      </div>

    </div>

    <!-- Footer -->
    <div class="p-5 bg-slate-950 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-3 shrink-0">
      <div class="text-[11px] text-slate-400 font-mono">
        Status: <span id="alvaro-modal-status" class="text-amber-400 font-bold">Iniciando Inclusão...</span>
      </div>
      <div class="flex items-center gap-2 w-full sm:w-auto justify-end flex-wrap">
        <button 
          type="button" 
          onclick="closeXmlAlvaroModal()" 
          class="px-5 py-2 bg-slate-800 hover:bg-slate-700 text-white font-bold text-xs rounded-xl border border-slate-700 transition-all cursor-pointer"
        >
          Fechar
