  function getReceivedXmlLabelLayouts() {
    const respTextarea = document.getElementById('alvaro-api-response-text');
    const respInput = document.getElementById('xml-response-alvaro-input');
    const xmlString = (respTextarea && respTextarea.value) || (respInput && respInput.value) || '';
    if (!xmlString) return [];
    
    const layouts = [];
    const regexTag = /<(layoutetiqueta|layout)[^>]*>([\s\S]*?)<\/\1>/gi;
    let match;
    while ((match = regexTag.exec(xmlString)) !== null) {
      if (match[2] && match[2].trim()) {
        layouts.push(match[2].trim());
      }
    }
    return layouts;
  }

  async function sendAlvaroXmlToApoio() {
    if (!currentXmlText) {
      renderAlvaroStatusSummary({
        loading: false,
        isSuccess: false,
        errorMessage: "Nenhum Request XML gerado para envio."
      });
      return;
    }

    const statusEl = document.getElementById('alvaro-modal-status');
    renderAlvaroStatusSummary({ loading: true });

    if (statusEl) {
      statusEl.textContent = 'Enviando requisição PUT ao WebService Álvaro...';
      statusEl.className = 'text-sky-400 font-bold';
    }

    try {
      const res = await fetch('/api/lab-externo/alvaro/criar-lote', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({ xml: currentXmlText })
      });

      const data = await res.json();
      
      const responseBox = document.getElementById('alvaro-api-response-box');
      const responseTextEl = document.getElementById('alvaro-api-response-text');
      const responseStatusBadge = document.getElementById('alvaro-api-status-badge');
      const responseUrlEl = document.getElementById('alvaro-api-endpoint-url');
      const respInputArea = document.getElementById('alvaro-api-response-text');

      const responseXmlStr = data.responseXml || (data.message ? `<erro>${data.message}</erro>` : '<resposta_vazia/>');

      if (responseBox) responseBox.classList.remove('hidden');
      if (responseTextEl) responseTextEl.value = responseXmlStr;
      if (responseUrlEl) responseUrlEl.textContent = `Endpoint: ${data.url || ''}`;

      if (responseStatusBadge) {
        if (data.statusCode >= 200 && data.statusCode < 300) {
          responseStatusBadge.textContent = `HTTP ${data.statusCode} OK`;
          responseStatusBadge.className = "px-2 py-0.5 rounded-md text-[10px] font-mono font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30";
        } else {
          responseStatusBadge.textContent = `HTTP ${data.statusCode || 500} ERRO`;
          responseStatusBadge.className = "px-2 py-0.5 rounded-md text-[10px] font-mono font-bold bg-rose-500/20 text-rose-400 border border-rose-500/30";
        }
      }

      if (respInputArea) {
        respInputArea.value = responseXmlStr;
      }

      // Processar e renderizar etiquetas na aba 3
      processAndRenderAlvaroResponseXml();

      // Parse do XML de resposta para verificar se incluido === "true"
      const parsedRes = parseAlvaroResponseXml(responseXmlStr);

      // Se o lote foi incluído com sucesso, atualizar o id do lote e status dos exames
      if (parsedRes.isSuccess) {
        const requisitions = window.TRIAGEM_REQUISITIONS || [];
        parsedRes.solicitacoes.forEach(sol => {
          if (!sol.incluido) return;
          const idLisStr = String(sol.idLis || '').trim();
          const idAlvaroStr = String(sol.idAlvaro || sol.baseBarras || '').trim();

          const targetReq = requisitions.find(r => isMatchingRequisition(r, idLisStr));

          if (targetReq && Array.isArray(targetReq.exams)) {
            targetReq.exams.forEach(ex => {
              if (ex.triagemDestination === 'alvaro' || !ex.triagemDestination) {
                ex.idLote = idAlvaroStr;
                ex.loteCode = idAlvaroStr;
                ex.loteId = idAlvaroStr;
                ex.status = 'Lote criado';
                ex.loteStatus = 'Lote criado';
                ex.loteAt = new Date().toISOString();
              }
            });
            const allInLote = targetReq.exams.every(e => 
              e.status === 'Lote criado' || e.loteStatus === 'Lote criado' || e.loteStatus === 'Gerado' || !!e.loteCode || !!e.idLote
            );
            if (allInLote) {
              targetReq.status = 'Lote criado';
              targetReq.loteStatus = 'Lote criado';
            }
          }
        });

        // Atualizar lista na tela principal
        if (typeof renderCriarLoteScreen === 'function') {
          renderCriarLoteScreen();
        }

        // Salvar persistência no backend
        fetch('/admin/triagem/confirmar-lote-alvaro', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ solicitacoes: parsedRes.solicitacoes })
        })
        .then(r => r.json())
        .then(resData => {
          if (resData.success) {
            console.log(`Lote confirmado e persistido no servidor para ${resData.updatedCount} exames.`);
          }
        })
        .catch(err => console.error('Erro ao persistir lote no servidor:', err));
      }

      // Atualizar aba 1 (Status do Lote)
      renderAlvaroStatusSummary({
        loading: false,
        isSuccess: parsedRes.isSuccess,
        errorMessage: parsedRes.errorMessage,
        solicitacoes: parsedRes.solicitacoes,
        httpStatus: data.statusCode
      });

      if (statusEl) {
        if (parsedRes.isSuccess) {
          statusEl.textContent = `Lote incluído com SUCESSO no Apoio Álvaro (HTTP ${data.statusCode})`;
          statusEl.className = 'text-emerald-400 font-bold';
        } else {
          statusEl.textContent = `Lote NÃO foi incluído no Apoio Álvaro (HTTP ${data.statusCode || 'Erro'})`;
          statusEl.className = 'text-rose-400 font-bold';
        }
      }

    } catch (err) {
      console.error("Erro ao enviar lote ao Álvaro:", err);
      renderAlvaroStatusSummary({
        loading: false,
        isSuccess: false,
        errorMessage: "Erro de comunicação com o servidor ao transmitir lote: " + err.message
      });
      if (statusEl) {
        statusEl.textContent = 'Erro na transmissão do lote';
        statusEl.className = 'text-rose-400 font-bold';
      }
    }
  }

