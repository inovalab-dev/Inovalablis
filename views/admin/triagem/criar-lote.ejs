  let currentTargetLab = null;
  let currentSelectedItems = [];

  // Helper para determinar laboratório padrão ou triado de um exame
  function getExamDestinationLab(ex) {
    if (ex.triagemDestination) {
      const dest = String(ex.triagemDestination).toLowerCase();
      if (dest.includes('alvaro') || dest.includes('álvaro')) return 'alvaro';
      if (dest.includes('pardini') || dest.includes('hermes') || dest.includes('hpardini')) return 'pardini';
      if (dest.includes('interno') || dest.includes('proprio') || dest.includes('próprio')) return 'interno';
    }

    const catalogExams = window.CATALOG_EXAMS || [];
    const code = String(ex.code || ex.codigo || '').trim().toLowerCase();
    const name = String(ex.name || ex.nome || ex.exame || '').trim().toLowerCase();
    
    const catExam = catalogExams.find(c => {
      const cCode = String(c.code || c.codigo || '').trim().toLowerCase();
      const cName = String(c.name || c.nome || c.exame || '').trim().toLowerCase();
      return (code && cCode && code === cCode) || (name && cName && name === cName);
    });

    if (catExam && catExam.supportLab) {
      const labStr = String(catExam.supportLab).toLowerCase();
      if (labStr.includes('alvaro') || labStr.includes('álvaro')) return 'alvaro';
      if (labStr.includes('pardini') || labStr.includes('hermes') || labStr.includes('hpardini')) return 'pardini';
      if (labStr.includes('interno') || labStr.includes('proprio') || labStr.includes('próprio')) return 'interno';
    }

    if (ex.supportLab) {
      const labStr = String(ex.supportLab).toLowerCase();
      if (labStr.includes('alvaro') || labStr.includes('álvaro')) return 'alvaro';
      if (labStr.includes('pardini') || labStr.includes('hermes') || labStr.includes('hpardini')) return 'pardini';
      if (labStr.includes('interno') || labStr.includes('proprio') || labStr.includes('próprio')) return 'interno';
    }

    return 'interno';
  }

  // Obter custos
  function getExamCost(ex, lab) {
    let cost = null;
    const catalogExams = window.CATALOG_EXAMS || [];
    const code = String(ex.code || ex.codigo || '').trim().toLowerCase();
    const name = String(ex.name || ex.nome || ex.exame || '').trim().toLowerCase();
    const catExam = catalogExams.find(c => {
      const cCode = String(c.code || c.codigo || '').trim().toLowerCase();
      const cName = String(c.name || c.nome || c.exame || '').trim().toLowerCase();
      return (code && cCode && code === cCode) || (name && cName && name === cName);
    });

    if (catExam) {
      if (lab === 'alvaro') cost = catExam.priceAlvaro || catExam.custoAlvaro;
      if (lab === 'pardini') cost = catExam.pricePardini || catExam.custoPardini;
    }

    if (!cost) {
      if (lab === 'alvaro') cost = ex.custoAlvaro || ex.valorAlvaro;
      if (lab === 'pardini') cost = ex.custoPardini || ex.valorPardini;
    }

    return cost ? String(cost).replace('.', ',') : '0,00';
  }

  // Helper para obter Código e Nome do Exame no Laboratório de Apoio selecionado
  function getSupportLabExamInfo(ex, lab = 'alvaro') {
    const catalogExams = window.CATALOG_EXAMS || [];
    const catExam = catalogExams.find(c => 
      (c.code && String(c.code).toLowerCase() === String(ex.code || ex.codigo || '').toLowerCase()) ||
      (c.id && String(c.id) === String(ex.code || ex.id || '')) ||
      (c.jalisCode && String(c.jalisCode).toLowerCase() === String(ex.code || '').toLowerCase()) ||
      (c.codigoAlvaro && String(c.codigoAlvaro).toLowerCase() === String(ex.code || '').toLowerCase())
    );

    let supportCode = ex.codigoAlvaro || ex.codigoApoio || '';
    let supportName = ex.nomeApoio || ex.exameApoio || '';

    const targetLabKey = (lab || 'alvaro').toLowerCase(); // 'alvaro' or 'pardini'

    if (catExam) {
      // 1. Check labExternoList inside materiaisColetados
      if (Array.isArray(catExam.materiaisColetados)) {
        for (const mat of catExam.materiaisColetados) {
          if (Array.isArray(mat.labExternoList)) {
            const item = mat.labExternoList.find(l => l.lab && String(l.lab).toLowerCase().includes(targetLabKey));
            if (item) {
              if (item.codigo) supportCode = String(item.codigo).trim();
              if (item.exame) supportName = String(item.exame).trim();
              if (supportCode && supportName) break;
            }
          }
        }
      }

      // 2. Check labExternoList at root of catExam
      if ((!supportCode || !supportName) && Array.isArray(catExam.labExternoList)) {
        const item = catExam.labExternoList.find(l => l.lab && String(l.lab).toLowerCase().includes(targetLabKey));
        if (item) {
          if (!supportCode && item.codigo) supportCode = String(item.codigo).trim();
          if (!supportName && item.exame) supportName = String(item.exame).trim();
        }
      }

      // 3. Check supportLabsData
      if ((!supportCode || !supportName) && catExam.supportLabsData && catExam.supportLabsData[targetLabKey]) {
        const labData = catExam.supportLabsData[targetLabKey];
        if (!supportCode && labData.code) supportCode = String(labData.code).trim();
        if (!supportName && labData.name) supportName = String(labData.name).trim();
      }

      // 4. Check specific fields like codigoAlvaro / codigoPardini
      if (!supportCode) {
        if (targetLabKey.includes('alvaro')) {
          supportCode = catExam.codigoAlvaro || '';
        } else if (targetLabKey.includes('pardini')) {
          supportCode = catExam.codigoPardini || '';
        }
      }
    }

    // Fallbacks diretos para exames conhecidos
    const codeUpper = String(ex.code || ex.codigo || '').toUpperCase();
    const nameUpper = String(ex.name || ex.nome || (catExam && catExam.name) || '').toUpperCase();

    if (codeUpper === 'UREI12' || nameUpper.includes('URÉIA') || nameUpper.includes('UREIA')) {
      supportCode = 'UREIA';
      supportName = 'UREIA';
    } else if (codeUpper === 'TSH04') {
      supportCode = supportCode || 'TSH04';
      supportName = supportName || 'Hormônio Tireoestimulante (TSH)';
    }

    if (!supportCode) supportCode = ex.code || ex.codigo || 'S/COD';
    if (!supportName) supportName = ex.name || ex.nome || ex.exame || (catExam && catExam.name) || 'Exame';

    return { code: supportCode, name: supportName };
  }

  // Helper para obter Código e Descrição do Material do Exame no Cadastro do Exame (Aba Triagem)
  function getSupportLabMaterialInfo(ex, lab = 'alvaro') {
    const targetLabKey = (lab || 'alvaro').toLowerCase();
    const catalogExams = window.CATALOG_EXAMS || [];

    const catExam = catalogExams.find(c => 
      (c.code && String(c.code).toLowerCase() === String(ex.code || ex.codigo || '').toLowerCase()) ||
      (c.id && String(c.id) === String(ex.code || ex.id || '')) ||
      (c.jalisCode && String(c.jalisCode).toLowerCase() === String(ex.code || '').toLowerCase()) ||
      (c.codigoAlvaro && String(c.codigoAlvaro).toLowerCase() === String(ex.code || '').toLowerCase()) ||
      (c.name && String(c.name).trim().toLowerCase() === String(ex.name || ex.nome || ex.exame || '').trim().toLowerCase())
    );

    let matCode = '';
    let matDesc = '';

    function parseMaterialStr(raw) {
      if (!raw) return { code: '', desc: '' };
      const str = String(raw).trim();
      if (!str) return { code: '', desc: '' };

      if (str.includes('-')) {
        const parts = str.split('-');
        const p1 = parts[0].trim();
        const p2 = parts.slice(1).join('-').trim();
        if (/^\d+$/.test(p1) || (p1.length <= 6 && /\d/.test(p1))) {
          return { code: p1, desc: p2 || p1 };
        } else if (/^\d+$/.test(p2)) {
          return { code: p2, desc: p1 || p2 };
        }
        return { code: p1, desc: p2 || p1 };
      } else if (str.includes(':')) {
        const parts = str.split(':');
        const p1 = parts[0].trim();
        const p2 = parts.slice(1).join(':').trim();
        return { code: p1, desc: p2 || p1 };
      }

      if (/^\d+$/.test(str) || (str.length <= 8 && /\d/.test(str))) {
        return { code: str, desc: str };
      }

      return { code: '', desc: str };
    }

    if (catExam) {
      let matchingLabItem = null;

      // 1. Verificar em labExternoList na raiz do cadastro do exame (Aba Triagem)
      if (Array.isArray(catExam.labExternoList)) {
        matchingLabItem = catExam.labExternoList.find(l => l && l.lab && String(l.lab).toLowerCase().includes(targetLabKey));
        if (!matchingLabItem && catExam.labExternoList.some(l => l && l.padrao)) {
          matchingLabItem = catExam.labExternoList.find(l => l && l.padrao);
        }
      }

      // 2. Verificar em materiaisColetados -> labExternoList
      if (!matchingLabItem && Array.isArray(catExam.materiaisColetados)) {
        for (const mat of catExam.materiaisColetados) {
          if (Array.isArray(mat.labExternoList)) {
            matchingLabItem = mat.labExternoList.find(l => l && l.lab && String(l.lab).toLowerCase().includes(targetLabKey));
            if (matchingLabItem) break;
          }
        }
      }

      if (matchingLabItem) {
        if (matchingLabItem.materialCode || matchingLabItem.materialCodigo || matchingLabItem.codigoMaterial) {
          matCode = String(matchingLabItem.materialCode || matchingLabItem.materialCodigo || matchingLabItem.codigoMaterial).trim();
        }
        if (matchingLabItem.materialDesc || matchingLabItem.materialApoio || matchingLabItem.descricaoMaterial) {
          matDesc = String(matchingLabItem.materialDesc || matchingLabItem.materialApoio || matchingLabItem.descricaoMaterial).trim();
        }

        if ((!matCode || !matDesc) && matchingLabItem.material) {
          const parsed = parseMaterialStr(matchingLabItem.material);
          if (!matCode && parsed.code) matCode = parsed.code;
          if (!matDesc && parsed.desc) matDesc = parsed.desc;
        }
      }

      // 3. Verificar em supportLabsData
      if ((!matCode || !matDesc) && catExam.supportLabsData && catExam.supportLabsData[targetLabKey]) {
        const sData = catExam.supportLabsData[targetLabKey];
        if (!matCode) matCode = String(sData.materialCode || sData.materialCodigo || sData.codigoMaterial || '').trim();
        if (!matDesc) matDesc = String(sData.materialDesc || sData.materialApoio || sData.material || '').trim();
        if ((!matCode || !matDesc) && sData.material) {
          const parsed = parseMaterialStr(sData.material);
          if (!matCode && parsed.code) matCode = parsed.code;
          if (!matDesc && parsed.desc) matDesc = parsed.desc;
        }
      }

      // 4. Campos raiz do catExam
      if (!matCode) {
        if (targetLabKey.includes('alvaro')) {
          matCode = catExam.codigoMaterialAlvaro || catExam.materialAlvaroCode || '';
        } else if (targetLabKey.includes('pardini')) {
          matCode = catExam.codigoMaterialPardini || catExam.materialPardiniCode || '';
        }
        if (!matCode) matCode = catExam.materialCode || catExam.materialCodigo || catExam.codigoMaterial || '';
      }
      if (!matDesc) {
        if (targetLabKey.includes('alvaro')) {
          matDesc = catExam.materialAlvaro || '';
        } else if (targetLabKey.includes('pardini')) {
          matDesc = catExam.materialPardini || '';
        }
        if (!matDesc) matDesc = catExam.materialApoio || catExam.materialDesc || catExam.material || '';
      }
    }

    // 5. Verificar objeto de exame na requisição
    if (!matCode) {
      matCode = ex.materialCode || ex.materialCodigo || ex.codigoMaterial || '';
    }
    if (!matDesc) {
      matDesc = ex.materialApoio || ex.materialDesc || ex.material || ex.recipiente || '';
    }

    if (matDesc && !matCode) {
      const parsed = parseMaterialStr(matDesc);
      if (parsed.code) matCode = parsed.code;
      if (parsed.desc && parsed.desc !== matDesc) matDesc = parsed.desc;
    }

    // Default fallbacks
    if (!matCode) {
      matCode = targetLabKey.includes('alvaro') ? '543' : 'SORO';
    }
    if (!matDesc) {
      matDesc = 'Soro';
    }

    return { code: matCode, desc: matDesc };
  }

  // Helper para obter o código do setor (2 dígitos) do cadastro de exames (primeira aba / sub-aba Setores)
  function getExamSetorCode(ex) {
    const defaultSetor = (window.CONFIG_ALVARO && window.CONFIG_ALVARO.setorPadrao) ? window.CONFIG_ALVARO.setorPadrao : '11';
    if (!ex) return defaultSetor.padStart(2, '0').slice(-2);
    const catalogExams = window.CATALOG_EXAMS || [];
    const allSetores = window.SETORES || [];

    const catExam = catalogExams.find(c => 
      (c.code && String(c.code).toLowerCase() === String(ex.code || ex.codigo || '').toLowerCase()) ||
      (c.id && String(c.id) === String(ex.code || ex.id || '')) ||
      (c.jalisCode && String(c.jalisCode).toLowerCase() === String(ex.code || '').toLowerCase()) ||
      (c.codigoAlvaro && String(c.codigoAlvaro).toLowerCase() === String(ex.code || '').toLowerCase()) ||
      (c.name && String(c.name).trim().toLowerCase() === String(ex.name || ex.nome || ex.exame || '').trim().toLowerCase())
    );

    let rawSetorCod = '';
    let rawSetorName = '';

    if (catExam) {
      // 1. Aba 'Setores' do cadastro do exame (sub-aba setores / catExam.setores)
      if (Array.isArray(catExam.setores) && catExam.setores.length > 0) {
        const s0 = catExam.setores[0];
        if (typeof s0 === 'object' && s0 !== null) {
          if (s0.codigo) rawSetorCod = String(s0.codigo);
          if (s0.descricao) rawSetorName = String(s0.descricao);
        } else if (typeof s0 === 'string') {
          rawSetorName = s0;
        }
      }

      // 2. Outros campos no cadastro do exame
      if (!rawSetorCod && !rawSetorName) {
        if (catExam.setor) rawSetorName = String(catExam.setor);
        else if (catExam.category) rawSetorName = String(catExam.category);
        else if (catExam.setorBancada) rawSetorName = String(catExam.setorBancada);
      }
    }

    // 3. Objeto do exame na requisição
    if (!rawSetorCod && !rawSetorName) {
      if (ex.setorCode || ex.codigoSetor) rawSetorCod = String(ex.setorCode || ex.codigoSetor);
      else if (ex.setor) rawSetorName = String(ex.setor);
    }

    // Se temos nome do setor mas não o código numérico, procura na lista global de setores
    if ((!rawSetorCod || isNaN(parseInt(rawSetorCod, 10))) && rawSetorName) {
      const matched = allSetores.find(s => 
        s.descricao && s.descricao.trim().toLowerCase() === rawSetorName.trim().toLowerCase()
      ) || allSetores.find(s => 
        s.descricao && (s.descricao.trim().toLowerCase().includes(rawSetorName.trim().toLowerCase()) || rawSetorName.trim().toLowerCase().includes(s.descricao.trim().toLowerCase()))
      );
      if (matched && matched.codigo) {
        rawSetorCod = String(matched.codigo);
      }
    }

    let numericCode = (rawSetorCod || '').replace(/\D/g, '');
    if (!numericCode) {
      numericCode = defaultSetor;
    }

    return numericCode.padStart(2, '0').slice(-2);
  }

  // Helper para construir o codigolis formatado ("01" + 8 dígitos da req + 2 dígitos do setor)
  function buildReqCodigolis(req, defaultReqNum = 1017) {
    const defaultSetor = (window.CONFIG_ALVARO && window.CONFIG_ALVARO.setorPadrao) ? window.CONFIG_ALVARO.setorPadrao : '11';
    let rawReqCode = String(req ? (req.requisitionCode || req.id || defaultReqNum) : defaultReqNum).trim();
    let reqDigits = rawReqCode.replace(/\D/g, '');
    if (!reqDigits) reqDigits = String(defaultReqNum);
    const reqCodePadded = reqDigits.padStart(8, '0').slice(-8);

    const reqExams = (req && req.exams) ? req.exams : [];
    const firstEx = reqExams[0] || null;
    const sectorCodeStr = firstEx ? getExamSetorCode(firstEx) : defaultSetor.padStart(2, '0').slice(-2);

    return '01' + reqCodePadded + sectorCodeStr;
  }

  // Helper para verificar se a requisição corresponde ao idLis retornado pelo apoio
  function isMatchingRequisition(r, idLisStr) {
    if (!r || !idLisStr) return false;
    const cleanLis = String(idLisStr).trim();
    const reqId = String(r.id || '').trim();
    const reqCode = String(r.requisitionCode || '').trim();
    const reqCodeAlt = String(r.code || '').trim();

    if (reqId === cleanLis || reqCode === cleanLis || reqCodeAlt === cleanLis) return true;

    const lisDigitsOnly = cleanLis.replace(/\D/g, '');
    let extractedReqNum = lisDigitsOnly;
    if (lisDigitsOnly.length >= 10 && lisDigitsOnly.startsWith('01')) {
      extractedReqNum = lisDigitsOnly.slice(2, lisDigitsOnly.length - 2).replace(/^0+/, '');
    }

    const reqNumOnly = (reqCode || reqId || reqCodeAlt).replace(/\D/g, '').replace(/^0+/, '');

    if (extractedReqNum && reqNumOnly && extractedReqNum === reqNumOnly) return true;
    if (reqId && cleanLis.includes(reqId)) return true;
    if (reqCode && cleanLis.includes(reqCode)) return true;

    return false;
  }

  // Renderizar a tela de Criar Lote
  function renderCriarLoteScreen() {
    const requisitions = window.TRIAGEM_REQUISITIONS || [];
    const alvaroContainer = document.getElementById('container-pacientes-alvaro');
    const pardiniContainer = document.getElementById('container-pacientes-pardini');

    if (!alvaroContainer || !pardiniContainer) return;

    alvaroContainer.innerHTML = '';
    pardiniContainer.innerHTML = '';

    let totalTriadosCount = 0;
    let alvaroPatientsCount = 0;
    let alvaroExamsCount = 0;
    let pardiniPatientsCount = 0;
    let pardiniExamsCount = 0;

    requisitions.forEach(req => {
      const reqExams = req.exams || [];
      const reqId = req.requisitionCode || req.id;
      
      // Filtrar apenas exames que foram TRIADOS e ainda PENDENTES de criação de lote
      const isReqTriado = String(req.status || '').trim().toLowerCase().includes('triad') || req.triado === true || String(req.triado) === 'true';
      const triadosExams = reqExams.filter(e => {
        const eStatus = String(e.status || '').trim().toLowerCase();
        const eLoteStatus = String(e.loteStatus || '').trim().toLowerCase();
        const isTriado = isReqTriado || eStatus.includes('triad') || e.triado === true || String(e.triado) === 'true';

        // Exames com lote já criado ou gerado devem sumir da tela de criação de lote
        const hasLoteCriado = eStatus === 'lote criado' || 
                              eLoteStatus === 'lote criado' || 
                              eLoteStatus === 'gerado' || 
                              !!e.idLote || 
                              !!e.loteCode;

        return isTriado && !hasLoteCriado;
      });

      if (triadosExams.length === 0) return; // Apenas exames pendentes de lote!

      totalTriadosCount++;

      // Separar exames por laboratório
      const alvaroExams = triadosExams.filter(e => getExamDestinationLab(e) === 'alvaro');
      const pardiniExams = triadosExams.filter(e => getExamDestinationLab(e) === 'pardini');

      // Se houver exames Álvaro para este paciente
      if (alvaroExams.length > 0) {
        alvaroPatientsCount++;
        alvaroExamsCount += alvaroExams.length;
        const cardHtml = createPatientColumnCard(req, alvaroExams, 'alvaro');
        alvaroContainer.insertAdjacentHTML('beforeend', cardHtml);
      }

      // Se houver exames Pardini para este paciente
      if (pardiniExams.length > 0) {
        pardiniPatientsCount++;
        pardiniExamsCount += pardiniExams.length;
        const cardHtml = createPatientColumnCard(req, pardiniExams, 'pardini');
        pardiniContainer.insertAdjacentHTML('beforeend', cardHtml);
      }
    });

    // Atualizar métricas e badges
    document.getElementById('stat-total-pacientes').textContent = totalTriadosCount;
    document.getElementById('stat-alvaro-pacientes').textContent = alvaroPatientsCount;
    document.getElementById('stat-alvaro-exames').textContent = alvaroExamsCount;
    document.getElementById('stat-pardini-pacientes').textContent = pardiniPatientsCount;
    document.getElementById('stat-pardini-exames').textContent = pardiniExamsCount;

    document.getElementById('badge-count-alvaro').textContent = `${alvaroPatientsCount} ${alvaroPatientsCount === 1 ? 'paciente' : 'pacientes'} (${alvaroExamsCount} exames)`;
    document.getElementById('badge-count-pardini').textContent = `${pardiniPatientsCount} ${pardiniPatientsCount === 1 ? 'paciente' : 'pacientes'} (${pardiniExamsCount} exames)`;

    // Toggle Empty States
    document.getElementById('empty-alvaro').classList.toggle('hidden', alvaroPatientsCount > 0);
    document.getElementById('empty-pardini').classList.toggle('hidden', pardiniPatientsCount > 0);

    // Habilitar / Desabilitar botões de Criar Lote
    const btnAlvaro = document.getElementById('btn-criar-lote-alvaro');
    if (btnAlvaro) {
      if (alvaroPatientsCount === 0 || alvaroExamsCount === 0) {
        btnAlvaro.disabled = true;
        btnAlvaro.classList.add('opacity-50', 'cursor-not-allowed', 'pointer-events-none');
        btnAlvaro.title = 'Nenhuma requisição para criar o lote do Apoio Álvaro';
      } else {
        btnAlvaro.disabled = false;
        btnAlvaro.classList.remove('opacity-50', 'cursor-not-allowed', 'pointer-events-none');
        btnAlvaro.title = 'Criar Lote Álvaro';
      }
    }

    const btnPardini = document.getElementById('btn-criar-lote-pardini');
    if (btnPardini) {
      if (pardiniPatientsCount === 0 || pardiniExamsCount === 0) {
        btnPardini.disabled = true;
        btnPardini.classList.add('opacity-50', 'cursor-not-allowed', 'pointer-events-none');
        btnPardini.title = 'Nenhuma requisição para criar o lote do Apoio Pardini';
      } else {
        btnPardini.disabled = false;
        btnPardini.classList.remove('opacity-50', 'cursor-not-allowed', 'pointer-events-none');
        btnPardini.title = 'Gerar Lote Pardini';
      }
    }

    filterLotes();
  }

  // Criar HTML do Card do Paciente (SEM COLLAPSE - Totalmente Aberto)
  function createPatientColumnCard(req, exams, lab) {
    const reqId = req.requisitionCode || req.id;
    const isAlvaro = lab === 'alvaro';
    const labBadgeClass = isAlvaro 
      ? 'bg-amber-100 text-amber-900 border-amber-300' 
      : 'bg-purple-100 text-purple-900 border-purple-300';
    
    const cardBgClass = isAlvaro ? 'border-amber-200/90 bg-white' : 'border-purple-200/90 bg-white';
    const headerBgClass = isAlvaro ? 'bg-amber-50/60 border-amber-100' : 'bg-purple-50/60 border-purple-100';

    let examsListHtml = '';

    exams.forEach((ex, idx) => {
      const cost = getExamCost(ex, lab);
      const isLoteGerado = ex.status === 'Lote criado' || ex.loteStatus === 'Lote criado' || ex.loteStatus === 'Gerado' || !!ex.loteCode || !!ex.idLote;
      const loteDisplayCode = ex.idLote || ex.loteCode || ex.loteId || 'Criado';
      const supportInfo = getSupportLabExamInfo(ex, lab);
      const matInfo = getSupportLabMaterialInfo(ex, lab);
      const matDisplay = (matInfo.code && matInfo.desc && !matInfo.desc.startsWith(matInfo.code))
        ? `${matInfo.code}-${matInfo.desc}`
        : (matInfo.desc || matInfo.code || 'Geral');
      
      examsListHtml += `
        <div class="p-2.5 rounded-xl border border-slate-100 bg-slate-50/70 hover:bg-white transition-all flex items-center justify-between gap-3 text-xs" data-exam-code="${ex.code || ex.codigo}">
          <div class="flex items-center gap-2 min-w-0">
            <input 
              type="checkbox" 
              class="exam-lote-checkbox w-4 h-4 rounded text-amber-600 focus:ring-amber-500 cursor-pointer shrink-0" 
              data-req-id="${reqId}"
              data-exam-code="${ex.code || ex.codigo}"
              data-lab="${lab}"
              ${isLoteGerado ? 'disabled' : 'checked'}
            >
            <div class="min-w-0">
              <div class="flex items-center gap-1.5 flex-wrap">
                <span class="font-extrabold text-slate-900 font-mono text-[11.5px]">${supportInfo.code} - ${supportInfo.name}</span>
              </div>
              <div class="flex items-center gap-2 mt-0.5 text-[10.5px] text-slate-600 font-mono">
                <span>Recipiente/Material: <strong class="text-slate-800">${matDisplay}</strong></span>
              </div>
            </div>
          </div>

          <div class="shrink-0 flex items-center gap-1">
            ${isLoteGerado ? `
              <span class="px-2 py-0.5 bg-emerald-100 text-emerald-800 font-mono font-bold text-[9.5px] rounded border border-emerald-200" title="Status: Lote criado">
                Lote: ${loteDisplayCode}
              </span>
            ` : `
              <span class="px-2 py-0.5 ${isAlvaro ? 'bg-amber-100 text-amber-800 border-amber-200' : 'bg-purple-100 text-purple-800 border-purple-200'} font-mono font-bold text-[9.5px] rounded border">
                Pendente Lote
              </span>
            `}
          </div>
        </div>
      `;
