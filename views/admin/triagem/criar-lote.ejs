              <p class="text-[10.5px] text-slate-500 font-mono font-medium mt-0.5">
                CPF: ${req.patientCpf || 'N/I'} • Setor: ${req.setor || 'Triagem'} • Coleta: ${req.collectedAt ? new Date(req.collectedAt).toLocaleDateString('pt-BR') : 'Hoje'}
