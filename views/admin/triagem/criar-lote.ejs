    const activeClass = 'py-3 text-xs font-bold border-b-2 border-amber-400 text-amber-300 flex items-center gap-2 cursor-pointer transition-all shrink-0';
    const inactiveClass = 'py-3 text-xs font-bold border-b-2 border-transparent text-slate-400 hover:text-slate-200 flex items-center gap-2 cursor-pointer transition-all shrink-0';

    if (tabStatus) tabStatus.className = tabName === 'status' ? activeClass : inactiveClass;
    if (tabReq) tabReq.className = tabName === 'request' ? activeClass : inactiveClass;
    if (tabResp) tabResp.className = tabName === 'response' ? activeClass : inactiveClass;

    if (viewStatus) viewStatus.classList.toggle('hidden', tabName !== 'status');
    if (viewReq) viewReq.classList.toggle('hidden', tabName !== 'request');
    if (viewResp) viewResp.classList.toggle('hidden', tabName !== 'response');

