            <!-- Sticker Graphic (50x30mm ratio) -->
            <div class="bg-white rounded-xl p-3 border-2 border-dashed border-slate-400 text-slate-950 font-mono text-xs shadow-md space-y-1 select-none w-full relative">
              <div class="font-black text-xs sm:text-sm uppercase tracking-tight text-slate-950 truncate border-b border-slate-300 pb-0.5">
                ${escapeXmlAttr(lbl.patientName)}
              </div>
              
              <div class="flex justify-between items-center text-[10px] font-bold text-slate-800">
                <span>${escapeXmlAttr(lbl.patientDN)}</span>
