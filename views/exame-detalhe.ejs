<%- include('partials/header') %>

<!-- Banner Superior -->
<section class="bg-gradient-to-b from-brand-softBg/60 to-white py-12 border-b border-brand-light/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-3">
    <div class="flex items-center justify-center space-x-2">
      <span class="bg-brand-softBg text-brand-dark font-bold font-mono text-[10px] px-3 py-1 rounded-full uppercase tracking-wider">
        <%= exam.category %>
      </span>
      <span class="text-xs text-brand-gold font-bold font-mono uppercase tracking-wider">
        Código: <%= exam.code || 'IN' + exam.id %>
      </span>
    </div>
    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-brand-dark tracking-tight leading-tight"><%= exam.name %></h1>
    <div class="w-12 h-1 bg-brand-gold mx-auto rounded-full my-4"></div>
    <p class="text-sm text-gray-500 max-w-2xl mx-auto">Instruções de preparo detalhadas, jejum recomendado e prazo de entrega de resultados do Laboratório InovaLab.</p>
  </div>
</section>

<!-- Conteúdo Principal -->
<section class="py-12 bg-brand-neutralLight">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <div class="bg-white rounded-3xl border border-brand-light/15 shadow-sm p-6 sm:p-10 space-y-8">
      
      <!-- Grid de Destaques Rápidos -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pb-6 border-b border-brand-light/10">
        
        <div class="bg-brand-softBg/30 p-5 rounded-2xl border border-brand-light/10 flex flex-col justify-between">
          <span class="text-[10px] font-bold text-brand-dark/70 uppercase tracking-widest font-mono">Requisito de Jejum</span>
          <div class="flex items-center space-x-3 mt-2">
            <div class="p-2.5 bg-brand-dark/5 rounded-xl text-brand-dark">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m0-12.728l.707.707m12.728 12.728l.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z"/></svg>
            </div>
            <span class="text-sm font-bold text-brand-dark"><%= exam.fasting %></span>
          </div>
        </div>

        <div class="bg-brand-softBg/30 p-5 rounded-2xl border border-brand-light/10 flex flex-col justify-between">
          <span class="text-[10px] font-bold text-brand-dark/70 uppercase tracking-widest font-mono">Prazo de Entrega</span>
          <div class="flex items-center space-x-3 mt-2">
            <div class="p-2.5 bg-brand-dark/5 rounded-xl text-brand-dark">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <span class="text-sm font-bold text-brand-dark"><%= exam.timeframe %></span>
          </div>
        </div>

        <div class="bg-brand-softBg/30 p-5 rounded-2xl border border-brand-light/10 flex flex-col justify-between">
          <span class="text-[10px] font-bold text-brand-dark/70 uppercase tracking-widest font-mono">Unidade de Coleta</span>
          <div class="flex items-center space-x-3 mt-2">
            <div class="p-2.5 bg-brand-dark/5 rounded-xl text-brand-dark">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <span class="text-sm font-bold text-brand-dark">Cambará - PR</span>
          </div>
        </div>

      </div>

      <!-- Instruções Detalhadas de Preparo -->
      <div class="space-y-4">
        <h2 class="text-lg font-bold text-brand-dark flex items-center space-x-2">
          <svg class="w-5 h-5 text-brand-gold" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          <span>Instruções Completas de Preparo:</span>
        </h2>
        <div class="bg-brand-softBg/20 p-6 rounded-2xl border border-brand-light/10 leading-relaxed text-gray-600 text-sm font-medium space-y-3">
          <p><%= exam.instructions %></p>
          <p class="text-xs text-gray-400 font-normal">Nota: Seguir rigorosamente as instruções garante a exatidão e confiabilidade do seu resultado de exame. Em caso de dúvidas sobre medicamentos de uso contínuo, converse com a nossa equipe de atendimento antes da coleta.</p>
        </div>
      </div>

      <!-- Por que fazer seus exames no InovaLab? -->
      <div class="space-y-4 pt-4">
        <h2 class="text-lg font-bold text-brand-dark">Por que escolher o InovaLab Cambará?</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="flex items-start space-x-3">
            <svg class="w-5 h-5 text-brand-gold mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            <div>
              <h4 class="text-xs font-bold text-brand-dark uppercase font-mono">Coleta Sem Dor & Humanizada</h4>
              <p class="text-xs text-gray-500 mt-1">Nossa equipe é altamente qualificada e especializada em coleta infantil e de pacientes difíceis.</p>
            </div>
          </div>
          <div class="flex items-start space-x-3">
            <svg class="w-5 h-5 text-brand-gold mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            <div>
              <h4 class="text-xs font-bold text-brand-dark uppercase font-mono">Resultados Online Seguros</h4>
              <p class="text-xs text-gray-500 mt-1">Acesse seus laudos pelo Portal de Resultados, com histórico de exames anteriores para comparação.</p>
            </div>
          </div>
          <div class="flex items-start space-x-3">
            <svg class="w-5 h-5 text-brand-gold mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            <div>
              <h4 class="text-xs font-bold text-brand-dark uppercase font-mono">Selo de Qualidade Exclusivo</h4>
              <p class="text-xs text-gray-500 mt-1">Equipamentos de última geração e processos controlados por rigorosos programas de qualidade nacional.</p>
            </div>
          </div>
          <div class="flex items-start space-x-3">
            <svg class="w-5 h-5 text-brand-gold mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            <div>
              <h4 class="text-xs font-bold text-brand-dark uppercase font-mono">Infraestrutura Premium</h4>
              <p class="text-xs text-gray-500 mt-1">Ambiente climatizado, moderno, limpo, acessível e aconchegante para toda a sua família.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Chamada para Ação -->
      <div class="pt-6 border-t border-brand-light/10 flex flex-col sm:flex-row gap-4 items-center justify-between">
        <a href="/preparo" class="inline-flex items-center space-x-1.5 text-xs font-bold text-brand-dark hover:text-brand-light transition-colors py-3">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
          <span>Voltar para o Guia de Exames</span>
        </a>
        
        <a href="https://wa.me/5543996183406?text=Olá%20InovaLab!%20Gostaria%20de%20agendar%20ou%20tirar%20dúvidas%20sobre%20o%20exame%20<%= encodeURIComponent(exam.name) %>" onclick="trackWhatsAppClick('Exame: <%= exam.name %>')" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3.5 bg-brand-dark hover:bg-brand-light text-white text-sm font-bold rounded-xl transition-all shadow-md hover:shadow-lg space-x-2">
          <svg class="w-5 h-5 text-emerald-400" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.25 8.477 3.517 2.266 2.268 3.512 5.279 3.51 8.484-.006 6.545-5.34 11.884-11.954 11.884-.001 0-.002 0-.003 0-1.996-.001-3.956-.503-5.69-1.457L0 24zM6.59 17.545l.361.215a9.872 9.872 0 0 0 5.031 1.378H12a9.89 9.89 0 0 0 9.885-9.885A9.832 9.832 0 0 0 19 2.899 9.825 9.825 0 0 0 12.008 1.1c-5.451 0-9.887 4.434-9.89 9.884-.001 2.094.547 4.14 1.588 5.944l.236.375-1.003 3.655 3.743-.982zM17.472 14.38c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36-.195 1.871-.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/></svg>
          <span>Agendar no WhatsApp</span>
        </a>
      </div>

    </div>

    <!-- Seção de Exames Relacionados para impulsionar o SEO interno -->
    <div class="mt-12 space-y-4">
      <h3 class="text-sm font-bold text-brand-dark uppercase font-mono tracking-wider">Outros Exames e Orientações:</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <% relatedExams.forEach(rel => { %>
          <a href="/exames/<%= rel.slug %>" onclick="if (typeof trackExamClick === 'function') trackExamClick('<%= rel.name %>');" class="group bg-white p-4 rounded-2xl border border-brand-light/10 hover:border-brand-dark/20 hover:shadow-sm transition-all duration-200 flex justify-between items-center">
            <div>
              <span class="text-[9px] font-bold text-brand-gold uppercase font-mono"><%= rel.category %></span>
              <h4 class="text-xs font-bold text-brand-dark group-hover:text-brand-light transition-colors mt-0.5"><%= rel.name %></h4>
            </div>
            <div class="text-brand-dark/30 group-hover:text-brand-dark transition-colors shrink-0 pl-2">
              <svg class="w-4 h-4 transform group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            </div>
          </a>
        <% }) %>
      </div>
    </div>

  </div>
</section>

<%- include('partials/footer') %>
