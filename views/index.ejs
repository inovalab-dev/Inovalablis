<%- include('partials/header') %>

<!-- Seção HERO Principal -->
<section class="relative overflow-hidden bg-gradient-to-b from-brand-softBg via-brand-neutralLight to-white py-16 lg:py-24 border-b border-brand-light/10">
  <!-- Círculos de Fundo Estilizados -->
  <div class="absolute top-0 right-0 -mr-24 -mt-24 w-96 h-96 rounded-full bg-brand-light/15 blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 -ml-24 -mb-24 w-80 h-80 rounded-full bg-brand-gold/15 blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Lado Esquerdo: Conteúdo Textual -->
      <div class="lg:col-span-7 space-y-6 lg:space-y-8 text-center lg:text-left fade-in">
        <!-- Badge de Destaque -->
        <div class="inline-flex items-center space-x-2 bg-white px-3.5 py-2 rounded-full border border-brand-light/30 shadow-sm">
          <span class="flex h-2.5 w-2.5 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-light opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-brand-dark"></span>
          </span>
          <span class="text-[11px] font-bold text-brand-dark uppercase tracking-wider font-mono">Unidade Cambará-PR | Diagnóstico de Confiança</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-brand-dark tracking-tight leading-tight">
          Laboratório Inovalab <br class="hidden sm:inline">
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-dark via-brand-gold to-brand-dark">cuidando da sua saúde</span>
        </h1>
        
        <p class="text-base sm:text-lg text-gray-600 max-w-2xl mx-auto lg:mx-0 leading-relaxed">
          O InovaLab Cambará reúne tecnologia de ponta, processos rígidos de controle de qualidade e atendimento acolhedor para oferecer os resultados mais rápidos e precisos da região.
        </p>

        <!-- Botões de Ação Rápida -->
        <div class="flex flex-col sm:flex-row justify-center lg:justify-start gap-4 pt-2">
          <a href="/resultados" class="inline-flex items-center justify-center px-6 py-3.5 border border-transparent text-base font-bold rounded-xl shadow-md text-white bg-brand-dark hover:bg-brand-dark/95 hover:scale-[1.01] transition-all duration-200">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            Acessar Resultados Online
          </a>
          <a href="https://wa.me/5543996183406?text=Olá!%20Gostaria%20de%20agendar%20uma%20coleta%20residencial%20com%20o%20InovaLab." target="_blank" class="inline-flex items-center justify-center px-6 py-3.5 border-2 border-brand-light text-base font-bold rounded-xl text-brand-dark bg-white hover:bg-brand-softBg hover:border-brand-dark transition-all duration-200">
            <svg class="w-5 h-5 mr-2 text-brand-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
            Agendar Coleta em Casa
          </a>
        </div>

        <!-- Diferenciais do Laboratório -->
        <div class="pt-8 border-t border-brand-light/20 grid grid-cols-3 gap-4 max-w-lg mx-auto lg:mx-0">
          <div class="text-center lg:text-left">
            <span class="block text-2xl lg:text-3xl font-extrabold text-brand-dark font-mono">100%</span>
            <span class="text-xs text-gray-500 font-medium">Equipamentos Calibrados</span>
          </div>
          <div class="text-center lg:text-left">
            <span class="block text-2xl lg:text-3xl font-extrabold text-brand-dark font-mono">PNCQ</span>
            <span class="text-xs text-gray-500 font-medium">Controle de Qualidade</span>
          </div>
          <div class="text-center lg:text-left">
            <span class="block text-2xl lg:text-3xl font-extrabold text-brand-dark font-mono">4 horas</span>
            <span class="text-xs text-gray-500 font-medium">Laudo de Beta HCG</span>
          </div>
        </div>
      </div>

      <!-- Lado Direito: Área de Login do Paciente / Acesso aos Resultados -->
      <div class="lg:col-span-5 flex justify-center items-center">
        <div class="relative w-full max-w-md bg-white p-6 sm:p-8 rounded-3xl shadow-xl border border-brand-light/20 custom-shadow">
          <!-- Detalhe Dourado Decorativo -->
          <div class="absolute -top-3 -left-3 w-12 h-12 rounded-2xl bg-brand-gold/20 border border-brand-gold/45 -z-10 flex items-center justify-center">
            <span class="text-brand-dark font-serif font-extrabold text-xl">+</span>
          </div>

          <div class="space-y-5">
            <div class="text-center space-y-1">
              <h3 class="text-lg font-bold text-brand-dark font-sans tracking-tight">Área do Paciente</h3>
              <p class="text-xs text-gray-500">Acesse seus exames e laudos online com total segurança</p>
            </div>
            
            <form onsubmit="event.preventDefault(); enviarFormulario();" action="https://inovalab.lab.jalis.net.br/resultado/logar" method="post" id="formLogin" class="login-form space-y-4">
              <!-- Campo Usuário / Protocolo -->
              <div class="space-y-1.5 text-left">
                <label for="usuario" class="block text-xs font-bold text-brand-dark uppercase tracking-wider font-mono">Usuário</label>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
                    </svg>
                  </div>
                  <input type="text" id="usuario" name="usuario" required placeholder="Digite seu Usuário..." 
                         class="w-full pl-10 pr-4 py-3 bg-brand-neutralLight text-brand-dark placeholder-gray-400 rounded-xl border border-brand-light/20 focus:outline-none focus:border-brand-dark focus:ring-1 focus:ring-brand-dark text-sm transition-all">
                </div>
              </div>
              <input type="hidden" name="cfg_codigo" value="inovalab">
              
              <!-- Campo Senha -->
              <div class="space-y-1.5 text-left">
                <label for="password" class="block text-xs font-bold text-brand-dark uppercase tracking-wider font-mono">Senha de Acesso</label>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
                    </svg>
                  </div>
                  <input type="password" id="senha" name="senha" required placeholder="Digite sua senha..." 
                         class="w-full pl-10 pr-4 py-3 bg-brand-neutralLight text-brand-dark placeholder-gray-400 rounded-xl border border-brand-light/20 focus:outline-none focus:border-brand-dark focus:ring-1 focus:ring-brand-dark text-sm transition-all">
                </div>
              </div>

              <!-- Mensagem de erro -->
              <div id="login-error-message" class="hidden bg-red-50 border border-red-200 text-red-700 rounded-xl p-3 text-xs text-center font-sans">
                <div class="flex items-center justify-center space-x-2">
                  <svg class="w-4 h-4 text-red-500 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                  </svg>
                  <span class="error-text font-semibold">Usuário ou senha incorretos.</span>
                </div>
              </div>

              <!-- Botão Entrar -->
              <button type="submit" id="btn-login-submit"
                      class="w-full py-3.5 px-4 bg-brand-dark hover:bg-brand-dark/95 text-white font-bold rounded-xl text-xs uppercase tracking-wider font-mono transition-all hover:scale-[1.01] flex items-center justify-center gap-2 cursor-pointer shadow-md">
                <span id="btn-login-icon">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75" />
                  </svg>
                </span>
                <span id="btn-login-text">Visualizar Resultados</span>
              </button>
            </form>

            <script>
              async function enviarFormulario() {
                const usuario = document.getElementById('usuario').value.trim();
                const senha = document.getElementById('senha').value.trim();
                const errorBox = document.getElementById('login-error-message');
                const btnSubmit = document.getElementById('btn-login-submit');
                const btnText = document.getElementById('btn-login-text');
                const btnIcon = document.getElementById('btn-login-icon');

                if (!usuario || !senha) {
                  alert("Por favor, preencha todos os campos.");
                  return;
                }

                // Ocultar mensagem de erro anterior
                if (errorBox) {
                  errorBox.classList.add('hidden');
                }

                // Desabilitar botão e mostrar loading
                if (btnSubmit) {
                  btnSubmit.disabled = true;
                  btnSubmit.classList.add('opacity-75', 'cursor-not-allowed');
                }
                if (btnText) {
                  btnText.textContent = "Validando Acesso...";
                }
                if (btnIcon) {
                  btnIcon.innerHTML = `<svg class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                  </svg>`;
                }

                // Dispara o evento gtag se estiver definido
                if (typeof gtag === 'function') {
                  gtag('event', 'login_tentativa', {
                    event_category: 'Login',
                    event_label: 'Formulário de resultados online',
                    value: 1
                  });
                }

                try {
                  const response = await fetch('/api/verificar-login', {
                    method: 'POST',
                    headers: {
                      'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ usuario, senha, cfg_codigo: 'inovalab' })
                  });

                  const result = await response.json();

                  if (result.success) {
                    // Login correto ou fallback ativado - Submete o formulário HTML real
                    document.getElementById("formLogin").submit();
                  } else {
                    // Erro de credenciais inválidas
                    if (errorBox) {
                      const errorText = errorBox.querySelector('.error-text');
                      if (errorText) {
                        errorText.textContent = result.message || 'Usuário ou senha incorretos.';
                      }
                      errorBox.classList.remove('hidden');
                    }
                    // Restaurar botão
                    restaurarBotao();
                  }
                } catch (err) {
                  console.error('Erro na validação do login:', err);
                  // Em caso de erro de conexão com nosso server, envia o form de qualquer forma como fallback
                  document.getElementById("formLogin").submit();
                }
              }

              function restaurarBotao() {
                const btnSubmit = document.getElementById('btn-login-submit');
                const btnText = document.getElementById('btn-login-text');
                const btnIcon = document.getElementById('btn-login-icon');

                if (btnSubmit) {
                  btnSubmit.disabled = false;
                  btnSubmit.classList.remove('opacity-75', 'cursor-not-allowed');
                }
                if (btnText) {
                  btnText.textContent = "Visualizar Resultados";
                }
                if (btnIcon) {
                  btnIcon.innerHTML = `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75" />
                  </svg>`;
                }
              }
            </script>

            <div class="bg-brand-softBg/50 rounded-xl p-3 border border-brand-light/10 text-center">
              <p class="text-[10px] text-gray-500 leading-normal">
                Insira o <strong>Usuário</strong> e <strong>Senha</strong> impressos em seu canhoto de atendimento que recebeu no dia da coleta.
              </p>
            </div>

            <div class="pt-4 border-t border-gray-100 text-center space-y-2">
              <p class="text-[10px] text-gray-400">Não possui ou perdeu sua senha de acesso?</p>
              <p class="text-xs font-semibold text-brand-dark">Fale com nossa recepção em Cambará:</p>
              <a href="https://wa.me/5543996183406?text=Olá,%20gostaria%20de%20solicitar%20a%20senha%20de%20acesso%20dos%20meus%20laudos." target="_blank" class="inline-flex items-center text-xs text-emerald-600 hover:text-emerald-700 font-bold">
                <svg class="w-4 h-4 mr-1 text-emerald-600" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.517 2.266 2.27 3.51 5.276 3.508 8.48-.003 6.66-5.338 11.998-11.95 11.998-2.005-.001-3.974-.502-5.716-1.455L0 24zm6.59-4.846c1.6.95 3.588 1.453 5.628 1.454 5.514 0 10.002-4.485 10.005-9.998.002-2.671-1.03-5.181-2.906-7.06C17.502 1.671 14.993.638 12.008.638 6.495.638 2.006 5.122 2.003 10.635c0 1.916.499 3.791 1.448 5.4l-.956 3.493 3.552-.931z"/></svg>
                Solicitar via WhatsApp
              </a>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Seção DIFERENCIAIS INSTITUCIONAIS -->
<section class="py-16 bg-white border-b border-brand-light/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <h2 class="text-xs font-bold tracking-widest text-brand-gold uppercase font-mono">Por que nos escolher?</h2>
      <p class="text-3xl sm:text-4xl font-extrabold text-brand-dark tracking-tight">O padrão de excelência InovaLab</p>
      <div class="w-16 h-1 bg-brand-gold mx-auto rounded-full"></div>
      <p class="text-sm text-gray-500">Combinamos dedicação humana e processos automatizados para criar uma experiência ágil, transparente e livre de erros.</p>
    </div>

    <!-- Grid de Pilares -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Card 1 -->
      <div class="bg-brand-neutralLight rounded-2xl p-6 border border-brand-light/20 custom-shadow hover:scale-[1.01] transition-transform duration-300">
        <div class="w-12 h-12 bg-brand-dark rounded-xl flex items-center justify-center text-white mb-5 shadow-sm">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        </div>
        <h3 class="text-lg font-bold text-brand-dark mb-2">Segurança de Dados e Amostras</h3>
        <p class="text-sm text-gray-500 leading-relaxed">
          Nossos tubos possuem códigos de barra individuais associados à sua identidade digital desde a recepção, eliminando riscos de troca ou erro de triagem clínica.
        </p>
      </div>

      <!-- Card 2 -->
      <div class="bg-brand-neutralLight rounded-2xl p-6 border border-brand-light/20 custom-shadow hover:scale-[1.01] transition-transform duration-300">
        <div class="w-12 h-12 bg-brand-light rounded-xl flex items-center justify-center text-brand-dark mb-5 shadow-sm">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        </div>
        <h3 class="text-lg font-bold text-brand-dark mb-2">Rapidez de Entrega</h3>
        <p class="text-sm text-gray-500 leading-relaxed">
          Com processos de triagem automatizados localmente em Cambará, conseguimos liberar exames básicos de rotina em até 24 horas e laudos de urgência em tempo recorde.
        </p>
      </div>

      <!-- Card 3 -->
      <div class="bg-brand-neutralLight rounded-2xl p-6 border border-brand-light/20 custom-shadow hover:scale-[1.01] transition-transform duration-300">
        <div class="w-12 h-12 bg-brand-dark rounded-xl flex items-center justify-center text-white mb-5 shadow-sm">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <h3 class="text-lg font-bold text-brand-dark mb-2">Atendimento Humanizado</h3>
        <p class="text-sm text-gray-500 leading-relaxed">
          Sabemos que exames geram ansiedade. Nossos profissionais são treinados para coletas indolores de bebês, gestantes e idosos, proporcionando calma e empatia.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Seção EXAMES EM DESTAQUE -->
<section class="py-16 bg-brand-softBg/30 border-b border-brand-light/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-12 gap-4">
      <div>
        <span class="text-xs font-bold tracking-widest text-brand-gold uppercase font-mono block">Alguns de nossos Exames</span>
        <h2 class="text-3xl font-extrabold text-brand-dark tracking-tight mt-1">Exames de Rotina Frequentes</h2>
      </div>
      <a href="/preparo" class="text-sm font-bold text-brand-dark hover:text-brand-light underline decoration-brand-gold decoration-2 underline-offset-4 flex items-center">
        Ver catálogo de exames completo <span class="ml-1 text-base">&rsaquo;</span>
      </a>
    </div>

    <!-- Grid de Destaques (3 exames passados dinamicamente) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <% featuredExams.forEach(exam => { %>
        <div class="bg-white rounded-2xl p-6 border border-brand-light/20 shadow-sm hover:scale-[1.01] transition-transform duration-200 flex flex-col justify-between">
          <div class="space-y-3">
            <div class="flex justify-between items-center">
              <span class="bg-brand-softBg text-brand-dark font-bold font-mono text-[9px] px-2.5 py-1 rounded-full uppercase">
                <%= exam.category %>
              </span>
              <span class="text-xs text-gray-400 font-mono"><%= exam.timeframe %></span>
            </div>
            <h3 class="text-base font-bold text-brand-dark tracking-tight"><%= exam.name %></h3>
            <p class="text-xs text-gray-500 leading-relaxed line-clamp-3"><%= exam.instructions %></p>
          </div>
          
          <div class="mt-6 pt-4 border-t border-brand-light/10 flex items-center justify-end">
            <a href="/preparo" class="w-full text-center text-xs font-bold text-brand-dark bg-brand-softBg py-2.5 rounded-xl hover:bg-brand-dark hover:text-white transition-colors">
              Ver Instruções de Preparo
            </a>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- Seção CHECKUPS PROMOCIONAIS -->
<section class="py-16 bg-white border-b border-brand-light/10 overflow-hidden relative">
  <!-- Subtle design elements -->
  <div class="absolute -left-20 top-1/4 w-72 h-72 rounded-full bg-brand-light/5 blur-3xl pointer-events-none"></div>
  <div class="absolute -right-20 bottom-1/4 w-72 h-72 rounded-full bg-brand-gold/5 blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <span class="text-xs font-bold tracking-widest text-brand-gold uppercase font-mono block">Campanha de Prevenção</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-brand-dark tracking-tight">Checkups Promocionais Exclusivos</h2>
      <div class="w-16 h-1 bg-brand-gold mx-auto rounded-full"></div>
      <p class="text-sm text-gray-500 leading-relaxed">
        Sua saúde não pode esperar. Criamos painéis laboratoriais completos com tarifas super acessíveis para incentivar a medicina preventiva e o seu bem-estar contínuo.
      </p>
    </div>

    <!-- Grid de 4 Cards de Checkups -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <!-- Card 1: Mulher -->
      <div class="bg-brand-neutralLight/40 hover:bg-white rounded-3xl p-5 border border-brand-light/15 hover:border-brand-gold/40 shadow-sm hover:shadow-xl group hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between h-full relative">
        <div class="space-y-4">
          <!-- Image Container -->
          <div class="w-full h-44 rounded-2xl overflow-hidden shadow-sm relative shrink-0">
            <img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=400&q=80" 
                 alt="Checkup Mulher Inova" 
