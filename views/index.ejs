<!-- Corpo Técnico e Especialistas -->
<section class="py-16 bg-brand-neutralLight border-t border-b border-brand-light/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12 space-y-2">
      <span class="text-xs font-bold tracking-widest text-brand-gold uppercase font-mono block">Responsabilidade Técnica</span>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-dark tracking-tight">Nossos Especialistas Clínicos</h2>
      <div class="w-12 h-0.5 bg-brand-dark mx-auto"></div>
      <p class="text-xs text-gray-500">Profissionais altamente gabaritados que assinam e supervisionam cada laudo emitido em nossa bancada de Cambará.</p>
    </div>

    <!-- Carrossel de Especialistas -->
    <div class="relative max-w-6xl mx-auto px-4 sm:px-12">
      <!-- Container do Carrossel -->
      <div class="overflow-hidden">
        <div id="prof-carousel-track" class="flex transition-transform duration-500 ease-in-out">
          <% professionals.forEach(prof => { %>
            <!-- Card do Especialista -->
            <div class="w-full sm:w-1/2 lg:w-1/3 shrink-0 p-3">
              <div class="bg-white rounded-2xl p-6 border border-brand-light/20 shadow-sm flex flex-col h-full hover:border-brand-dark/30 hover:shadow-md transition-all">
                <div class="flex items-center space-x-4 mb-4">
                  <div class="w-16 h-16 rounded-2xl bg-brand-softBg shrink-0 overflow-hidden flex items-center justify-center border border-brand-light/30">
                    <!-- Vetor de Avatar Premium -->
                    <svg class="w-10 h-10 text-brand-dark/40" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                    </svg>
                  </div>
                  <div class="space-y-1 text-left font-sans">
                    <span class="bg-brand-dark text-white font-mono font-bold text-[8px] px-2 py-0.5 rounded-full uppercase inline-block"><%= prof.role %></span>
                    <h3 class="text-sm font-bold text-brand-dark leading-tight"><%= prof.name %></h3>
                    <p class="text-[10px] text-brand-gold font-mono font-semibold"><%= prof.title %></p>
                  </div>
                </div>
                <p class="text-xs text-gray-500 leading-relaxed flex-grow text-left font-sans">
                  <%= prof.description %>
                </p>
              </div>
            </div>
          <% }) %>
        </div>
      </div>

      <!-- Controles (Sempre exibidos para navegação) -->
      <% if (professionals.length > 0) { %>
        <!-- Seta Esquerda -->
        <button id="prof-prev" class="absolute left-0 top-1/2 -translate-y-1/2 -translate-x-1 sm:-translate-x-4 bg-white hover:bg-brand-dark hover:text-white text-brand-dark w-10 h-10 rounded-full border border-brand-light/20 shadow-md flex items-center justify-center transition-all disabled:opacity-30 disabled:pointer-events-none cursor-pointer z-10" aria-label="Anterior">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
          </svg>
        </button>
        <!-- Seta Direita -->
        <button id="prof-next" class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-1 sm:translate-x-4 bg-white hover:bg-brand-dark hover:text-white text-brand-dark w-10 h-10 rounded-full border border-brand-light/20 shadow-md flex items-center justify-center transition-all disabled:opacity-30 disabled:pointer-events-none cursor-pointer z-10" aria-label="Próximo">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
          </svg>
        </button>

        <!-- Indicadores / Dots -->
        <div id="prof-dots" class="flex justify-center space-x-2 mt-6"></div>
      <% } %>
    </div>

    <!-- Script de inicialização e controle do Carrossel -->
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const track = document.getElementById('prof-carousel-track');
        const prevBtn = document.getElementById('prof-prev');
        const nextBtn = document.getElementById('prof-next');
        const dotsContainer = document.getElementById('prof-dots');
        
        if (!track || !prevBtn || !nextBtn) return;
        
        const items = Array.from(track.children);
        const totalItems = items.length;
        let currentIndex = 0;
        
        function getItemsPerPage() {
          if (window.innerWidth >= 1024) return 3; // lg
          if (window.innerWidth >= 640) return 2;  // sm/md
          return 1;                                // mobile
        }
        
        function getMaxIndex() {
          return Math.max(0, totalItems - getItemsPerPage());
        }
        
        function updateCarousel() {
          const itemsPerPage = getItemsPerPage();
          const maxIndex = getMaxIndex();
          
          // Garante que o index atual não ultrapasse o máximo permitido
          if (currentIndex > maxIndex) {
            currentIndex = maxIndex;
          }
          
          const itemWidthPercent = 100 / itemsPerPage;
          const offsetPercent = -currentIndex * itemWidthPercent;
          
          track.style.transform = `translateX(${offsetPercent}%)`;
          
          // Habilita/desabilita botões
          prevBtn.disabled = currentIndex === 0;
          nextBtn.disabled = currentIndex >= maxIndex;
          
          // Oculta setas se todos os itens couberem na tela
          if (maxIndex === 0) {
            prevBtn.classList.add('hidden');
            nextBtn.classList.add('hidden');
          } else {
            prevBtn.classList.remove('hidden');
            nextBtn.classList.remove('hidden');
          }
          
          // Atualiza os dots
          updateDots();
        }
        
        function updateDots() {
          if (!dotsContainer) return;
          dotsContainer.innerHTML = '';
          
          const itemsPerPage = getItemsPerPage();
          const totalDots = Math.max(1, totalItems - itemsPerPage + 1);
          
          // Se tivermos 1 ou menos dots (tudo visível), não precisa mostrar dots
          if (totalDots <= 1) return;
          
          for (let i = 0; i < totalDots; i++) {
            const dot = document.createElement('button');
            dot.className = `w-2 h-2 rounded-full transition-all cursor-pointer ${
              i === currentIndex ? 'bg-brand-dark w-5' : 'bg-brand-light/35 hover:bg-brand-light/60'
            }`;
            dot.setAttribute('aria-label', `Ir para slide ${i + 1}`);
            dot.addEventListener('click', () => {
              currentIndex = i;
              updateCarousel();
            });
            dotsContainer.appendChild(dot);
          }
        }
        
        prevBtn.addEventListener('click', () => {
          if (currentIndex > 0) {
            currentIndex--;
            updateCarousel();
          }
        });
        
        nextBtn.addEventListener('click', () => {
          const maxIndex = getMaxIndex();
          if (currentIndex < maxIndex) {
            currentIndex++;
            updateCarousel();
          }
        });
        
        // Suporte para deslizar (swipe) em dispositivos de toque
        let startX = 0;
        let isDragging = false;
        
        track.addEventListener('touchstart', (e) => {
          startX = e.touches[0].clientX;
          isDragging = true;
        }, { passive: true });
        
        track.addEventListener('touchmove', (e) => {
          if (!isDragging) return;
          const diffX = e.touches[0].clientX - startX;
          if (Math.abs(diffX) > 50) {
            if (diffX > 0 && currentIndex > 0) {
              currentIndex--;
              updateCarousel();
              isDragging = false;
            } else if (diffX < 0 && currentIndex < getMaxIndex()) {
              currentIndex++;
              updateCarousel();
              isDragging = false;
            }
          }
        }, { passive: true });
        
        track.addEventListener('touchend', () => {
          isDragging = false;
        });
        
        // Evento de redimensionamento
        let resizeTimeout;
        window.addEventListener('resize', () => {
          clearTimeout(resizeTimeout);
          resizeTimeout = setTimeout(() => {
            updateCarousel();
          }, 100);
        });
        
        // Inicializa o carrossel
        updateCarousel();
      });
    </script>
  </div>
</section>

