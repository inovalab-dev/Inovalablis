  <script>
    // Controle do menu mobile admin
    const adminMenuBtn = document.getElementById('admin-mobile-menu-btn');
    const adminDropdown = document.getElementById('admin-mobile-dropdown');
    
    if (adminMenuBtn && adminDropdown) {
      adminMenuBtn.addEventListener('click', () => {
        adminDropdown.classList.toggle('hidden');
      });
    }

    // Máscara global para campos de WhatsApp / Telefone / Celular
    function applyPhoneMask(input) {
      if (!input || input.dataset.phoneMaskApplied) return;
      input.dataset.phoneMaskApplied = 'true';
      
      const formatValue = (val) => {
        if (!val) return '';
        let value = val.replace(/\D/g, '');
        if (value.length > 11) value = value.slice(0, 11);
        
        if (value.length > 10) {
          return `(${value.slice(0, 2)}) ${value.slice(2, 7)}-${value.slice(7)}`;
        } else if (value.length > 6) {
          return `(${value.slice(0, 2)}) ${value.slice(2, 6)}-${value.slice(6)}`;
        } else if (value.length > 2) {
          return `(${value.slice(0, 2)}) ${value.slice(2)}`;
        } else if (value.length > 0) {
          return `(${value}`;
        }
        return value;
      };

      // Intercept setter/getter of .value to handle programmatic updates (e.g. element.value = '...')
      const descriptor = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value');
      if (descriptor) {
        Object.defineProperty(input, 'value', {
          get: function() {
            return descriptor.get.call(this);
          },
          set: function(val) {
            const formatted = formatValue(val || '');
            descriptor.set.call(this, formatted);
          },
          configurable: true
        });
      }

      // Format initial value if present
      if (input.value) {
        input.value = formatValue(input.value);
      }

      // Format on user input/typing
      input.addEventListener('input', (e) => {
        const selectionStart = e.target.selectionStart;
        const previousLength = e.target.value.length;
        
        const formatted = formatValue(e.target.value);
        e.target.value = formatted;
        
        const currentLength = formatted.length;
        if (selectionStart !== null && previousLength !== currentLength) {
          const diff = currentLength - previousLength;
          e.target.setSelectionRange(selectionStart + diff, selectionStart + diff);
        }
      });

      // Handle blur and change just to be safe
      input.addEventListener('blur', (e) => {
        e.target.value = formatValue(e.target.value);
      });
      input.addEventListener('change', (e) => {
        e.target.value = formatValue(e.target.value);
      });
    }

    function initPhoneMasks() {
      const selectors = [
        'input[type="tel"]',
        'input[name="phone"]',
        'input[name="patientPhone"]',
        'input[id="patientPhone"]',
        'input[id="form-phone"]',
        'input[id="form-prof-phone"]',
        'input[id="phone-input"]',
        'input[name*="whatsapp"]',
        'input[id*="whatsapp"]'
      ];
      
      const inputs = document.querySelectorAll(selectors.join(', '));
      inputs.forEach(applyPhoneMask);
    }

    // Inicializar na carga inicial
    initPhoneMasks();

    // Monitorar mudanças dinâmicas no DOM (modais e elementos gerados dinamicamente)
    if (typeof MutationObserver !== 'undefined') {
      const observer = new MutationObserver((mutations) => {
        let shouldInit = false;
        mutations.forEach((mutation) => {
          if (mutation.addedNodes && mutation.addedNodes.length > 0) {
            mutation.addedNodes.forEach((node) => {
              if (node.nodeType === 1) { // ELEMENT_NODE
                if (node.matches && node.matches('input') && (node.type === 'tel' || node.name === 'phone' || node.id === 'patientPhone')) {
                  shouldInit = true;
                } else if (node.querySelectorAll) {
                  const selectors = ['input[type="tel"]', 'input[name="phone"]', 'input[name="patientPhone"]', 'input[id="patientPhone"]', 'input[id="form-phone"]', 'input[id="form-prof-phone"]', 'input[id="phone-input"]'];
                  if (node.querySelectorAll(selectors.join(', ')).length > 0) {
                    shouldInit = true;
                  }
                }
              }
            });
          }
        });
        if (shouldInit) {
          initPhoneMasks();
        }
      });
      observer.observe(document.body, { childList: true, subtree: true });
    }

    // Listener global para adicionar spinner nos botões de formulário no modo de salvamento/edição
    document.addEventListener('submit', function(e) {
      const form = e.target;
      if (!form || !(form instanceof HTMLFormElement)) return;
      
      setTimeout(() => {
        if (e.defaultPrevented) return;
        const submitBtn = form.querySelector('button[type="submit"]') || form.querySelector('input[type="submit"]');
        if (submitBtn && !submitBtn.disabled) {
          submitBtn.disabled = true;
          if (submitBtn.tagName.toLowerCase() === 'button') {
            if (!submitBtn.dataset.originalHtml) submitBtn.dataset.originalHtml = submitBtn.innerHTML;
            submitBtn.innerHTML = `
              <svg class="animate-spin h-4 w-4 text-white inline-block mr-1.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              <span>Salvando...</span>
            `;
          } else if (submitBtn.tagName.toLowerCase() === 'input') {
            if (!submitBtn.dataset.originalValue) submitBtn.dataset.originalValue = submitBtn.value;
            submitBtn.value = 'Salvando...';
          }
        }
      }, 10);
    });
  </script>
 </body>
