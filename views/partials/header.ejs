      margin-left: 0 !important;
      padding-left: 0 !important;
      border-left: none !important;
    }
    #admin-sidebar.sidebar-collapsed a, 
    #admin-sidebar.sidebar-collapsed summary {
      justify-content: center !important;
      padding-left: 0.5rem !important;
      padding-right: 0.5rem !important;
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const sidebar = document.getElementById('admin-sidebar');
      const toggleBtn = document.getElementById('admin-sidebar-toggle-btn');
      if (!sidebar || !toggleBtn) return;

      // Restore collapsed state from localStorage
      const isCollapsed = localStorage.getItem('inovalab_sidebar_collapsed') === 'true';
      if (isCollapsed) {
        sidebar.classList.add('sidebar-collapsed');
      }

      toggleBtn.addEventListener('click', () => {
        sidebar.classList.toggle('sidebar-collapsed');
        const collapsedNow = sidebar.classList.contains('sidebar-collapsed');
        localStorage.setItem('inovalab_sidebar_collapsed', collapsedNow ? 'true' : 'false');
      });
    });
  </script>
