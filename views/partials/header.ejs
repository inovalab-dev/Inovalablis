  <!-- Global LIS Keyboard Shortcut Helper Engine -->
  <script>
    window.LIS_SHORTCUTS = <%- JSON.stringify(locals.shortcuts || {}) %>;

    window.getShortcutLabel = function(actionId) {
      const sc = window.LIS_SHORTCUTS && window.LIS_SHORTCUTS[actionId];
      if (!sc || sc.enabled === false) return '';
      const parts = [];
      if (sc.ctrlKey) parts.push('Ctrl');
      if (sc.altKey) parts.push('Alt');
      if (sc.shiftKey) parts.push('Shift');
      
      let keyDisplay = sc.key ? sc.key.toUpperCase() : '';
      if (sc.key === 'Escape') keyDisplay = 'ESC';
      if (sc.key === 'Enter') keyDisplay = 'Enter';
      if (sc.key === ' ') keyDisplay = 'Espaço';
      
      parts.push(keyDisplay);
      return parts.join('+');
    };

    window.matchShortcut = function(e, actionId) {
      const sc = window.LIS_SHORTCUTS && window.LIS_SHORTCUTS[actionId];
      if (!sc || sc.enabled === false) return false;
      
      const isCtrlOrCmd = e.ctrlKey || e.metaKey;
      if (!!sc.ctrlKey !== isCtrlOrCmd) return false;
      if (!!sc.altKey !== e.altKey) return false;
      if (!!sc.shiftKey !== e.shiftKey) return false;

      const key = e.key ? e.key.toLowerCase() : '';
      const targetKey = sc.key ? sc.key.toLowerCase() : '';

      if (targetKey === 'escape' && key === 'escape') return true;
      if (targetKey === 'enter' && key === 'enter') return true;
      return key === targetKey;
    };
  </script>
  
